осится по всей округе. Пораженный охотник сразу же предлагает жирафе подписать контракт, и вот уже Нелли едет покорять каменные джунгли. Со временем она становится знаменитой, но жирафе начинает докучать одиночество. Однажды она знакомится с симпатичным жирафом из зоопарка и несмотря на то, что знает, что у него есть законная «супруга», и агент Нелли против таких романов, начинает встречаться с ним. Любовь и глупость Нелли не позволяют ей сделать карьеру певицы.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"420760","ru":"Ever After High: Dragon Games","en":"Ever After High: Dragon Games","year":"2016","type":"Мультфильм","rating":6.1,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/efi46Wk58PY9CldUphLgKZ8lXOp.jpg","genres":["мультфильм","приключения","комедия","семейный","фэнтези","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"272698","ru":"Rugrats: Tales from the Crib: Three Jacks & A Beanstalk","en":"Rugrats: Tales from the Crib: Three Jacks & A Beanstalk","year":"2006","type":"Мультфильм","rating":6.1,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/wtuM1xCa6bB7VHxCjBThWOht2wO.jpg","genres":["мультфильм","приключения","семейный","фэнтези","комедия","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"108048","ru":"Гвен, Книга песка","en":"Gwen et le livre de sable","year":"1985","type":"Мультфильм","rating":6.1,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/tFWHShVLlTSrsrXCIKhCa9iOkw1.jpg","genres":["фантастика","мультфильм","приключения","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"135305","ru":"Ultraman: The Adventure Begins","en":"Ultraman: The Adventure Begins","year":"1987","type":"Мультфильм","rating":6.1,"votes":12,"poster":"https://image.tm