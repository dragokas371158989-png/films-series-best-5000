b.org/t/p/w342/e8AduLHQoIc3xyWsYdQhv0Fjp06.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iV9sb3Qcm3ReFodicE7jccBR2JK.jpg","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"279051","ru":"Андрей Свислоцкий","en":"Андрей Свислоцкий","year":"1991","type":"Мультфильм","rating":6.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/yBQcEwPHBCRCx60WGUPPvheLC8e.jpg","backdrop":"","genres":["Мультфильм"],"overview":"Странный фильм о повседневной жизни странных людей, которые со стороны выглядят, как все остальные. В фильме полностью отсутствует музыка и слова, только птичьи голоса, шелест","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"379205","ru":"It's Pink But Is It Mink?","en":"It's Pink But Is It Mink?","year":"1975","type":"Мультфильм","rating":6.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/hymQfITnO2xjJN9WuQcIN0GcAMm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jTNR3aAfVyPm4vDsxuUIyBqUvFD.jpg","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"472911","ru":"うる星やつら: 月に吠える","en":"うる星やつら: 月に吠える","year":"1989","type":"Мультфильм","rating":6.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/g5sCqRfokeJKp1wX4rYTk5i0mzA.jpg","backdrop":"","genres":["Мультфильм","Комедия","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1172229","ru":"Де-де-де-де-деконструкция дохлых-дохлых демонов","en":"デッドデッドデーモンズデデデデデストラクション 後章","year":"2024","type":"Мультфильм","rating":6.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/hOM7USa5a3BuW8rGnoUyprJGX4s.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7MwygtqoO4bFp1vPnPsWSjTra8j.jpg","genres":["Мультфильм","Драма","Фантастика"],"overview":"Большой корабль инопланетян завис в небе над Токио за три года до описываемых событий. Односторонняя война Японии с пришельцами нанесла вред только самой стране и её экономике, не причинив ущерба таинственным и, казалось бы, безвредным гостям из космоса. Но противостояние Японии с инопланетянами — лишь фон истории про самых обычных старшеклассниц со своими проблемами, которые живут так, будто ничего не изменилось с появлением пришельцев.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"492715","ru":"Сервамп: Алиса в саду","en":"劇場版 SERVAMP -Alice in the Garden-","year":"2018","type":"Мультфильм","rating":6.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xwqbhB1oSijr6kuvjqEcgQktGUM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wrbfJmfXvzNIb6YzINALose1ExV.jpg","genres":["Мультфильм","Боевик","Комедия","Фэнтези"],"overview":"Сервампы и их связанные договором «Евы» наконец-то возвращаются к своей нормальной жизни, восстанавливаясь после травм, полученных в предыдущих битвах. Однако, когда в середине лета начинает идти снег, одна из Ев, Махиру Широта, подозревает вмешательство вампиров. Обеспокоенный странным явлением, он намеревается снова собрать группу, чтобы попытаться разгадать тайну; однако они внезапно теряют контакт с Мисоно Арисуин, Евой Сервампа Похоти.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"320770","ru":"うる星やつら: 了子の9月のお茶会","en":"うる星やつら: 了子の9月のお茶会","year":"1985","type":"Мультфильм","rating":6.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/2Kxogw0HshSwxwYHyQLCNGDRULR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7DJyY6oDPGMIcRqxDiJZU6XPHEC.jpg","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"234969","ru":"A Waggily Tale","en":"A Waggily Tale","year":"1958","type":"Мультфильм","rating":6.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/seEkgFVqmlC7CLNhuCCu7urvdfn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pjuk79CbCKVOAHZwWEUrE0PgjkA.jpg","genres":["Мультфильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":