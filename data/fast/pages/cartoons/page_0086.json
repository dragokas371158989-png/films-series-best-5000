огочисленные препятствия, Пак достает волшебный меч-кладенец и, добравшись до вершины вулкана, вызывает на бой Дракона. Из жестокого поединка победителем выходит храбрый Пак. Когда же рассеченное тело Дракона падает в пропасть, вновь расцветает выжженная земля.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"16865","ru":"Raisins Sold Out: The California Raisins II","en":"Raisins Sold Out: The California Raisins II","year":"1990","type":"Мультфильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/adSVNeSixRUh5UElMoGcezGpaFt.jpg","genres":["мультфильм","комедия","музыка","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"279990","ru":"The Great Bear Scare","en":"The Great Bear Scare","year":"1983","type":"Мультфильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1Z4wgWOZ9ihgzE6gUORhkUn6nUa.jpg","genres":["семейный","мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}