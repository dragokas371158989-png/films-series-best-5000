tps://image.tmdb.org/t/p/w342/xpbp2aKx9mIwOSD6iyRGwWkSWDm.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"588564","ru":"Бабушкин рецепт","en":"Mary e lo spirito di mezzanotte","year":"2023","type":"Мультфильм","rating":6.7,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/hrFPZzliZC7dO1ypfcEy9tINLz.jpg","genres":["мультфильм","драма","семейный","фэнтези"],"overview":"12-летняя школьница Мэри О`Хара живет в Дублине со своей мамой Скарлетт и с бабушкой. И вот приходит время, когда девочке приходится встретиться с тем фактом, что ее любимая бабушка скоро должна перейти в иной мир. Однажды на улице, где живет Мэри, появляется таинственная молодая женщина с сообщением для ее бабушки. Вскоре выясняется, что незнакомка является призраком матери бабушки, то есть прабабушки Мэри. Она пришла, чтобы помочь своей дочери спокойно проститься с любимыми и благополучно вывести ее из мира живых. Но для этого призраку нужна помощь Мэри и ее матери Скарлетт, которые должны отправиться в захватывающее путешествие в прошлое.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"119608","ru":"Ain't She Tweet","en":"Ain't She Tweet","year":"1952","type":"Мультфильм","rating":6.7,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/4k3lPFbRmkF8gSg2cbst45cHOuS.jpg","genres":["мультфильм","семейный","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"376236","ru":"Nuts!","en":"Nuts!","year":"2016","type":"Мультфильм","rating":6.7,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/rytoWiX1qVM0B1MvfAWwMGulKT6.jpg","genres":["документальный","мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1293461","ru":"D.I.Y. Duck","en":"D.I.Y. Duck","year":"2024","type":"Мультфильм","rating":6.7,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/hDQKUwOYBJFzJv4eHEjH0gi6Ddp.jpg","genres":["мультфильм","комедия","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"40375","ru":"Is This Goodbye, Charlie Brown?","en":"Is This Goodbye, Charlie Brown?","year":"1983","type":"Мультфильм","rating":6.7,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/4XLs5aTKxRjbD7kcUjN3doErNm4.jpg","genres":["мультфильм","комедия","семейный","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"518604","ru":"Принцесса и дракон","en":"Принцесса и дракон","year":"2018","type":"Мультфильм","rating":6.7,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/jB2gQVdsnCctEDp11EfgtjJhSW7.jpg","genres":["мультфильм","фэнтези"],"overview":"Сказка о маленькой царевне Варваре, которая, благодаря волшебной книге, попадает в неведанную Страну чудес. Её ждёт захватывающее путешествие, полное диковинных знакомств и незабываемых приключений в компании нового друга-дракончика.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"38832","ru":"Чудесный лес","en":"Čudesna šuma","year":"1986","type":"Мультфильм","rating":6.7,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/pDJwZ95xUwldHvQuNoLJDmgjslU.jpg","genres":["мультфильм","фэнтези","семейный","музыка"],"overview":"Заснув под Заколдованным Вязом, художник Питер Палитра обнаруживает при пробуждении, что кисточка его стала волшебной, а сам он теперь понимает язык животных. С этого момента начинаются приключения Питера в Чудесном Лесу, где он сразу становится знаменитостью и находит новых друзей: деловитого бобра, бывшего чемпиона медведя, очаровательную лису, веселых ежат и многих других зверей и птиц. А тем временем злой царь Кактус вовсю строит планы по уничтожению Леса. Узнав о появлении человека, предсказанном в старом Пророчестве, тиран приказывает своему помощнику чародею Палочке избавиться от художника. Питеру и его друзьям предстоит спасти Лес от разрушения, столкнуться с Алебардами — зловещими слугами царя Кактуса, и разгадать главный его секрет.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1186402","ru":"Strawberry Shortcake and the Beast of Berry Bog","en":"Strawberry Shortcake and the Beast of Berry Bog","year":"2023","type":"Мультфильм","rating":6.7,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/43SdiZr9z9TqY5liPkY4j7GvJUt.jpg","genres":["мультфильм","семейный","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1171423","ru":"LEGO Парк Юрского Периода: Неофициальный Пересказ","en":"LEGO Jurassic Park: The Unofficial Retelling","year":"2023","type":"Мультфильм","rating":6.7,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/w1i8pXw9NtQqxFWdOg2dU3imgnD.jpg","genres":["мультфильм","комедия","телевизионный фильм"],"overview":"LEGO-версия фильма \"Парк Юрского Периода\"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"415838","ru":"Barbie: Dreamtopia","en":"Barbie: Dreamtopia","year":"2016","type":"Мультфильм","rating":6.7,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/ewsAXj1IbpnAn4bQs3XdsESmm26.jpg","genres":["мультфильм","фэнтези","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"84899","ru":"Реактивный Джонни","en":"Little Johnny Jet","year":"1953","type":"Мультфильм","rating":6.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/vSFNVW8fnQoRG7jFrm1k75Eehab.jpg","genres":["мультфильм","комедия"],"overview":"Мультфильм о приключениях маленького самолетика. Бомбардировщик по имени Джон и его супруга Марии еле сводят концы с концами. Джон никак не может найти работу по специальности, во всех аэропортах ему дают отказ. Но когда он узнает, что Мария ждет ребенка, Джон вынужден уйти на срочную службу в ВВС. У четы самолетов появляется сын — Джон младший. С первых дней жизни в нем живет жажда скорости. По дому малыш рассекает на сверхзвуковой скорости. Когда отец собирается участвовать в гонке самолетов, реактивный Джонни уже ждет его на старте. Он проходит серьезное испытание вместе со взрослыми самолетами.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"235934","ru":"Little Beau Pepé","en":"Little Beau Pepé","year":"1952","type":"Мультфильм","rating":6.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/qe4wXBJZzB4Zte2h264oJszHyUq.jpg","genres":["мультфильм","комедия","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"84888","ru":"Homesteader Droopy","en":"Homesteader Droopy","year":"1954","type":"Мультфильм","rating":6.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/oaTfnn5k1sckvixAWFI0pWJQy5p.jpg","genres":["мультфильм","вестерн","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"87195","ru":"Обалдевший лев","en":"Slap Happy Lion","year":"1947","type":"Мультфильм","rating":6.7,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/qGrzbVgqUYJUTYFMqaowB7f86Fr.jpg","genres":["мультфильм","комедия"],"overview":"Король джунглей, терроризирующий остальных животных, приходит в ужас, увидев мышь.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}