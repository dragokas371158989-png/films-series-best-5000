ится на девчонок и говорит, что ищет свою любимую. Если понравишься ему – кончено! Тебе недолго осталось жить на свете!.. Подборка четырех школьных «страшилок»: «Любовь Мацури», «Любовь Рисы», «Любовь Тёко», «Любовь Юмэко»","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"332172","ru":"クラゲの食堂","en":"クラゲの食堂","year":"2016","type":"Мультфильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/56crvavJ98W1gmfpRyVeeO1kQBA.jpg","genres":["мультфильм","драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"713165","ru":"間の楔 2","en":"間の楔 2","year":"1994","type":"Мультфильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/x1R6dxnNpWBbDaGHKZxJIIYOyHW.jpg","genres":["мультфильм","фантастика","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"867838","ru":"Krishna Balram : Kalvakra Returns","en":"Krishna Balram : Kalvakra Returns","year":"2011","type":"Мультфильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/2fFOa8jZelgHH4ICm8i9Jta5KTw.jpg","genres":["мультфильм","боевик","приключения"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"392603","ru":"Miss Switch to the Rescue","en":"Miss Switch to the Rescue","year":"1982","type":"Мультфильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/1Mf12O4kiDmvrsRobLGo246bM9w.jpg","genres":["мультфильм","фэнтези","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"144415","ru":"The Kids in the Shoe","en":"The Kids in the Shoe","year":"1935","type":"Мультфильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/xLqZ5aewdkweLCTe0DEPPB08Dyp.jpg","genres":["мультфильм","комедия"],"overview":"","source"