2/k5xphWoWMcaGjVP1o0HMttN9PwM.jpg","backdrop":"","genres":["мультфильм","семейный","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"41078","ru":"János Vitéz","en":"János Vitéz","year":"1973","type":"Мультфильм","rating":7.9,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/jXF0nTKA8VupF1l6En4J0LPzTMm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/accAuHmemGmxWFi8FoQQwQUyXMv.jpg","genres":["приключения","мультфильм","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"194148","ru":"Маугли. Ракша","en":"Маугли. Ракша","year":"1967","type":"Мультфильм","rating":7.9,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/tpUzLw9kxGlDIWSY5irvQejE36e.jpg","backdrop":"","genres":["приключения","мультфильм","семейный"],"overview":"Маленький ребёнок попадает в джунгли в волчью семью. Он приглянулся матери волчице Ракше, которая не отдала его тигру людоеду Шерхану. Волки вскормили и воспитали человеческого детёныша, которого назвали Маугли. Но семья живёт в волчьей стае которая, управляется законом джунглей. Совет стаи должен решить будет ли жить Маугли среди зверей или отдать его Шерхану, который хочет получить свою добычу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"405458","ru":"최강전사 미니특공대: 영웅의 탄생","en":"최강전사 미니특공대: 영웅의 탄생","year":"2016","type":"Мультфильм","rating":7.9,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/haJkhyu0AA3TezLS7gKdjwq5MeJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tP3FunhXE3xK4kZwkUm7hpier2W.jpg","genres":["семейный","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"195065","ru":"Маугли. Похищение","en":"Маугли. Похищение","year":"1968","type":"Мультфильм","rating":7.9,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/aEdMT7bL6drgraiX6ewT4sy0tEL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kqK41Gi84F5qQeUe7YCmX7rP9pI.jpg","genres":["приключения","мультфильм","семейный"],"overview":"Маугли — приёмный сын в волчьей семье — растёт и учится в «школе» медведя Балу. Он быстро взрослеет и проявляет способности. После того, как Маугли спас от ловушки слонёнка из семьи слона Хатхи, слух о том, что в волчьей стае живёт человеческий детёныш, дошёл до бандерлогов. Обезьянье племя, обитающее на деревьях, решило сделать Маугли своим вожаком. Они крадут Маугли и переносят его в заброшенный город в джунглях.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"195080","ru":"Маугли. Битва","en":"Маугли. Битва","year":"1970","type":"Мультфильм","rating":7.9,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/3mHMW1PkRGs0Ah4qniIj0utsMZU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vTx0IfQgaP24TItWHEPPf9fHkKY.jpg","genres":["приключения","мультфильм","семейный"],"overview":"Страшная угроза нависла над волчьим племенем и всем живым населяющим джунгли. На родные для Маугли места надвигается огромная стая диких рыжих собак, уничтожающих всё на своём пути. Казалось ничто не может им сопротивляться, но Маугли придумывает как им противостоять.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315520","ru":"ミュウツーの誕生","en":"ミュウツーの誕生","year":"1999","type":"Мультфильм","rating":7.9,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/13ojzcdgxnTeAtHlbXk09zALcbY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eXiYA6xVXuX0I6jHw348bNdr4b9.jpg","genres":["мультфильм","драма","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"506640","ru":"Shopkins: Wild","en":"Shopkins: Wild","year":"2018","type":"Мультфильм","rating":7.9,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/xBFONzKumCg2Iufoh2EhJXBFvAp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aD3a1QIQiyWP6MRDlLXJjWsBspb.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"516052","ru":"銀河英雄伝説 Die 