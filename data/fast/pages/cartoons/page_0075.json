":"","studio":"","country":"","ageRating":""},{"id":"166272","ru":"In-Between","en":"In-Between","year":"2012","type":"Мультфильм","rating":7.8,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/gwrNKKR6wrtNg1rxCFP9IHX0yqb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mgKVaK3Zjrfk1QjvhGCYrHd5fuE.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1294972","ru":"ホウセンカ","en":"ホウセンカ","year":"2025","type":"Мультфильм","rating":7.8,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/fZsog59guqRZ4Q2DqKCiLDLuyjz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q9BznLtUUuHfHzyT3NOKzqM6oxz.jpg","genres":["мультфильм","драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"331429","ru":"喜羊羊与灰太狼之羊年喜羊羊","en":"喜羊羊与灰太狼之羊年喜羊羊","year":"2015","type":"Мультфильм","rating":7.8,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/w4SOcgBLyKJbvypJPOlUJvYcn28.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zXsT2Sb7d4wewDnWOIoj09zRFkJ.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"335173","ru":"トーイ","en":"トーイ","year":"1987","type":"Мультфильм","rating":7.8,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/a6fjHfoQmiJ73QfDQad5sXkh0mL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oCPNCOvPpWoVax7RI65Jpcz8gJE.jpg","genres":["мультфильм","драма","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1051192","ru":"Девушки и танки: Финал. Часть 4","en":"ガールズ＆パンツァー 最終章 第4話","year":"2023","type":"Мультфильм","rating":7.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/weDYR5NauwTYp8tLtkkUSA57cpb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kB2LxJjV62mRf2u9n38Sq6ZJ4l4.jpg","genres":["мультфильм","боевик","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"415282","ru":"チェインクロニクル~ヘクセイタスの閃(ひかり)~ 第１章","en":"チェインクロニクル~ヘクセイタスの閃(ひかり)~ 第１章","year":"2016","type":"Мультфильм","rating":7.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/g3bAypFpIB7MfIaD5IJ1JBgJybT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/v79dQtk5y4Mq41ou1ICLgoIIOSp.jpg","genres":["мультфильм","боевик","приключения","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"128742","ru":"Bride of Resistor","en":"Bride of Resistor","year":"1997","type":"Мультфильм","rating":7.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/cu7ceJDRmIfFDMdOjd0WAJiY9ox.jpg","backdrop":"","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"248372","ru":"The Princess Twins of Legendale","en":"The Princess Twins of Legendale","year":"2013","type":"Мультфильм","rating":7.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/nGyzdjZkR2InuTDdmWatrYUa12B.jpg","backdrop":"","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1383636","ru":"Золушка","en":"Askepote","year":"2025","type":"Мультфильм","rating":7.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/2HP3hFnyQliGCiM1ia4mHglP8AA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/myWVReG4jkdeXFBE7br1SxJGX1R.jpg","genres":["мультфильм","семейный"],"overview":"В королевстве, где сказки живут по строгому сценарию, все идет по плану: бал, хрустальная туфелька, торжественное признание. Но когда туфелька идеально подходит скромной Катерелле, происходит немыслимое — она отказывается выходить замуж за принца. Девушку возмущает сама идея строить судьбу на совпадении размера обуви. Ее отказ запускает цепную реакцию: страницы волшебных хроник начинают переписываться, декорации рушатся, а персонажи теряют свои роли. Разгневанный король Рекс требует вернуть историю в привычное русло, ведь если одна героиня осмелилась ослушаться, другие могут последовать ее примеру. Принцесса-наследница, хранительница порядка, отправляется к Катерелле, чтобы убедить ее исправить ошибку. Однако между ними возникает неожиданная близость — и вместо борьбы за «правильный» финал они решают вместе изменить правила игры.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"280439","ru":"Момоко слышит песню лягушат","en":"もも子、かえるの歌がきこえるよ。","year":"2003","type":"Мультфильм","rating":7.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/6dpaF2XhK2JKAg3e37z26spo56O.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ycKUqNZCvbkE667jk4UHsZgJ1AA.jpg","genres":["мультфильм","драма"],"overview":"Рики и Момоко — близнецы. Но если Рики родился нормальным здоровым мальчиком, то Момоко пришла на свет с серьёзным отклонением. Будучи инвалидом с рождения, она посещает школу для умственно отсталых детей. Бедняжка всегда жалуется на то, что не может ходить в обычную школу вместе с братом, и зачастую её охватывают приступы гнева, но когда Рики начинает напевать её любимую песенку «Хор лягушат», девочка всегда успокаивается. Вскорости в рамках специальной программы по обмену учащимися Момоко получает разрешение раз в неделю посещать школу, где учится её брат. Но, увы, не все ребята готовы мириться с её инвалидностью…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1068525","ru":"妖怪ウォッチ♪ ジバニャンVSコマさん もんげー大決戦だニャン","en":"妖怪ウォッチ♪ ジバニャンVSコマさん もんげー大決戦だニャン","year":"2023","type":"Мультфильм","rating":7.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/eAR0RDV7AzPWaIClfuRftcCldVo.jpg","backdrop":"","genres":["мультфильм","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"249287","ru":"赤い光弾ジリオン 歌姫夜曲","en":"赤い光弾ジリオン 歌姫夜曲","year":"1988","type":"Мультфильм","rating":7.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bV4l7hbYU6kwreyLQaIvmbzeh6C.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Ar0z41ErRQF9JqBG2LYyj8zXujX.jpg","genres":["мультфильм","приключения","фантастика"],"overview