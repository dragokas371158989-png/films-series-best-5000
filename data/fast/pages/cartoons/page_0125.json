ear":"2020","type":"Мультфильм","rating":4.6,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/vIqyumwhOYDQEywRlR0qr2UlzaL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dkMY6uh6G7LUjppDUT3H4gGfKWc.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"266116","ru":"タッチ～Miss Lonely Yesterday あれから、君は・・・～","en":"タッチ～Miss Lonely Yesterday あれから、君は・・・～","year":"1998","type":"Мультфильм","rating":4.6,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/njRym4DIAtIUIsnY0ayYENtfWCo.jpg","backdrop":"","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"454102","ru":"Рождение Эрота","en":"Рождение Эрота","year":"1989","type":"Мультфильм","rating":4.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/u4v4a4o7uwMXKz8kiNaX5wBbf7I.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vwlsEGcbYLGtBWWur4VqPHfCSEj.jpg","genres":["мультфильм"],"overview":"Мультфильм для взрослых, в основе которого лежит вариант древнегреческого мифа от Симонида о рождении бога Любви от Афродиты и Ареса. Несмотря на сопротивление богов-олимпийцев, в мир пришла Любовь. Эроту суждено преобразить мир, придать взаимоотношениям людей новый смысл и значение.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"197225","ru":"My Generation G... G... Gap","en":"My Generation G... G... Gap","year":"2004","type":"Мультфильм","rating":4.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/7zKkO0BUEvqOIhyqXuejuoOzVvk.jpg","backdrop":"","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1214952","ru":"Duck","en":"Duck","year":"2024","type":"Мультфильм","rating":4.6,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/pDDVpC0QpW4O4W5YQB5qgpoWL45.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rYGa33BJac4mjqyJSrt0NNO0XVS.jpg","genres":["драма","ужасы","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"361497","ru":"それいけ!アンパンマン だだんだんとふたごの星","en":"それいけ!アンパンマン だだんだんとふたごの星","year":"2009","type":"Мультфильм","rating":4.6,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/dFkqOHrzmyIlqBxpR07rL7NjsXk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qlYkuUWxrp1vlqcjk00hA1nTZM3.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"71595","ru":"Ёж Ежи","en":"Jeż Jerzy","year":"2011","type":"Мультфильм","rating":4.5,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/h6b4vtVfN3yneXSrarkpvQ1s2Ww.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bjbFQMckWqu4pCBLvl0mUJULsuA.jpg","genres":["мультфильм","комедия"],"overview":"Двое нацистских учёных, чтобы защитить Ежа Ежи, создают его клона.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"260310","ru":"Белка и Стрелка: Лунные приключения","en":"Белка и Стрелка: Лунные приключения","year":"2014","type":"Мультфильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/yfL5VIgWLVi0ICZZXceXpxZUYq3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bAmw3veZOgNbJ0XgeGudDIrQjl2.jpg","genres":["приключения","мультфильм","комедия","семейный"],"overview":"На Земле начали происходить странные и загадочные явления, несущие угрозу для планеты. Их след ведет в космос, на темную сторону Луны. Раскрыть тайну века поручили отряду Казбека. Белка, Стрелка и вся команда веселых и отважных героев отправляются на Луну, чтобы выполнить опасную миссию. Страсть к приключениям, искрометный юмор и великий дух космического братства поддержат в минуту великой опасности и помогут раскрыть всю правду о Луне и ее обитателях.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"21188","ru":"Веселая Коза: Легенды Старой Праги","en":"Kozí příběh – Pověsti staré Prahy","year":"2008","type":"Мультфильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/oCozt2LRQlbgConxfj9E34r7Nv9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a2k6ddlE98hIOz0nKe6TPw102e4.jpg","genres":["мультфильм","комедия"],"overview":"Эта необыкновенная история произошла в средневековой Праге. История о дружбе крестьянина Кубы и его козы. Вместе они приходят в город и встречают девушку Маци, хорошо знающую законы улицы. Куба устраивается на работу часовым мастером и влюбляется в Маци, но своенравной козе это совсем не нравится! Это история о спасении пражских астрономических часов, о любви и дружбе, предательстве и трусости. Главные герои попадут в Мистический дом Фауста, им предстоит встретиться с привидениями и дьявольщиной. Необыкновенные приключения друзей никого не оставят равнодушными!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"459165","ru":"Альфа и Омега 8: Путешествие в медвежье королевство","en":"Alpha and Omega: Journey to Bear Kingdom","year":"2017","type":"Мультфильм","rating":4.5,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/7rS7thHbCPE2tuNf324tUQnVIAQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eqSgrbrterbnnIjj1o5SR1nJvNf.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"194048","ru":"Les joyeux microbes","en":"Les joyeux microbes","year":"1909","type":"Мультфильм","rating":4.5,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/gzxZTqkk630JMMDDc9edc9CbG0E.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w9KYu03gS5GTL9FMNXmgt5FsdVm.jpg","genres":["комедия","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"157450","ru":"Bosko's Dizzy Date","en":"Bosko's Dizzy Date","year":"1932","type":"Мультфильм","rating":4.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/trSLxKEnfwRMufI0VKHQGJgI6Cw.jpg","backdrop":"","genres":["комедия","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"65714","ru":"Смелый большой панда","en":"熊猫总动员","year":"2011","type":"Мультфильм","rating":4.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/tUgg7MSHRYxLAbm0flpAEDMXYJA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6VQcyVgbWGJBTKYq7ZTa8bvtaVk.jpg","genres":["мультфильм","приключения","семейный"],"overview":"Человек против дикой природы! Жизнь обитателей бамбуковой рощи под угрозой. Остановить армию двуногих варваров никому не под силу… Кроме отважного, ловкого, неуязвимого и остроумного Панды. Он окажется в самом сердце веселых приключений и опасных испытаний, чтобы спасти сородичей и стать Царем зверей!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"87073","ru":"Воин Мегамен (фильм)","en":"ロックマンエグゼ 光と闇の遺産（プログラム）","year":"2005","type":"Мультфильм","rating":4.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/mVMJ8mv0vEwrUbKqQ4cLCTmVeMA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rNHVkKwZtoxZg7nHoG7dPtWxULT.jpg","genres":["фантастика","мультфильм","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"470703","ru":"ボディジャック 楽しい幽体離脱","en":"ボディジャック 楽しい幽体離脱","year":"1987","type":"Мультфильм","rating":4.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/6Wa64nFCxt3NJe4aonngUmh1T7Z.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tq7zViUEXnVzMfaYEeVEE0zuZT3.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"520506","ru":"Ошибка Дядюшки Ау","en":"Ошибка Дядюшки Ау","year":"1979","type":"Мультфильм","rating":4.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/toh4XqYIgEnviPetsCK1VDR3YnV.jpg","backdrop":"","genres":["мультфильм","семейный"],"overview":"Главный герой принимает решение ревизовать опись своего имущества по книге, которая была оставлена ему дедушкой. Обнаружив недостачу упомянутого дедом зелёного дерева, Дядюшка Ау намеревается исправить расхождения с описью. Он сажает в кадку семечко из старых колдовских запасов, и, ошибочно прочитав рецепт, поливает его вместо воды супом. В результате, в кадке выросло прожорливое и ненасытное «мясоедяещее» дерево-чудовище, готовое съесть даже самого господина Ау. Но на помощь пришла девочка Римма с баллончиком аэрозоля против мух и тараканов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"37494","ru":"The Wiggles: Space Dancing","en":"The Wiggles: Space Dancing","year":"2003","type":"Мультфильм","rating":4.5,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2Wk298Bc29AuA4bXQhjM1fitOEf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jK8nqfVxh2RTElXtyHBoWcOk6DU.jpg","genres":["семейный","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1297311","ru":"Квантовое превосходство","en":"Quantum Supremacy","year":"2026","type":"Мультфильм","rating":4.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/oLWFcrS1X1qhMj433GpEwM8zYPC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zEsFCfW7c8x2X7q3uLbZYoGka7O.jpg","genres":["фантастика","мультфильм","приключения","боевик"],"overview":"Из-за квантового сбоя технологии и ИИ вышли из-под контроля. Капитан Монро и экипаж его звездолета, осуществляющие рутинное патрулирование, оказываются единственными, кто может предотвратить квантовый апокалипсис. Но чтобы спасти человечество, команде придётся не просто сражаться, им надо понять парадоксальную логику нового врага и найти ключ к спасению Галактики.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1464639","ru":"映画 えんとつ町のプペル 〜約束の時計台〜","en":"映画 えんとつ町のプペル 〜約束の時計台〜","year":"2026","type":"Мультфильм","rating":4.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/jjKlu7fAQrnVGaSnJ4Xzo8T4WCB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rGVqKFmtElzJm2JWlNjAxhwDsrD.jpg","genres":["мультфильм","драма","фэнтези","приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"174815","ru":"Небо и земля: Глава о прошлом","en":"天上天下 - The Past Chapter","year":"2005","type":"Мультфильм","rating":4.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/76Jn2LEzxFjpWrGIR6KjRu6KAuQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/swGuVoY4puQ1NpXLkU7HVHbl2GS.jpg","genres":["мультфильм","боевик","мелодрама"],"overview":"Красивый и захватывающий пролог к основному сериалу, рассказывающий историю взаимоотношений Майи и ее брата, поймете чем так страшна проклятая катана хранившаяся в семье Нацуме, увидите зарождение Наказующих, и далекое прошлое Майи и Шина, а так же увидите много событий которые сильно повлияли на судьбу наших героев.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1373767","ru":"マクロスダイナマイト7","en":"マクロスダイナマイト7","year":"1997","type":"Мультфильм","rating":4.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ugTxTuKB9y5TGf8wJSrXnjsfzgm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zrVH1Y37rP0b6BQWtDv3rvsFVpG.jpg","genres":["мультфильм","боевик","приключения","фантастика","комедия","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"564755","ru":"悪魔島のプリンス 三つ目がとおる","en":"悪魔島のプリンス 三つ目がとおる","year":"1985","type":"Мультфильм","rating":4.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/90w4LzKNFJQmmU4PD7cg7rPBCg4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7gmmkS5U7DSUktlDev8CDs9CPxA.jpg","genres":["мультфильм","комедия","детектив","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}