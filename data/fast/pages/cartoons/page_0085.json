.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/edCSJgt6txtozr256Y3FjPuLPDk.jpg","genres":["драма","мультфильм","приключения"],"overview":"Проверьте по карте: там, где залив Святого Лаврентия напоминает широкую чашу, вдаваясь солёной водой в материк, находится остров Принца Эдуарда. Чинный и благонравный мир фермеров и берёзовых рощ, канадских клёнов и снежной зимы, колыбель первых американских переселенцев. В таких местах время идёт по-особому, порой замедляясь так, что уже сложно сказать, год ли прошёл с приезда Анны в Зелёные Мезонины или десять лет. Фильм представляет собой компиляцию первых шести эпизодов сериала «Энн из Зелёных Мезонинов» (Akage no Anne), в основе которого серия книг Люси Мод Монтгомери о рыжей Энн. Несмотря на то, что монтаж кинотеатральной версии был завершён ещё в 1989 году, в прокат фильм вышел только в 2010 при поддержке музея студии «Гибли».","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"502499","ru":"PP33 -POWER PLANT No.33-","en":"PP33 -POWER PLANT No.33-","year":"2015","type":"Мультфильм","rating":7.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/lZ4BWV3kAtd9bMJWEu4Iuu51445.jpg","genres":["мультфильм","боевик","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"237047","ru":"The Mouse-Merized Cat","en":"The Mouse-Merized Cat","year":"1946","type":"Мультфильм","rating":7.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/7IQFKyGwXneSrvV0miHLOgg6oBo.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1226221","ru":"Danganronpa 3: The End of Kibougamine Gakuen","en":"Danganronpa 3: The End of Kibougamine Gakuen","year":"2016","type":"Мультфильм","rating":7.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xnkq0L0R4EFaKGUVJ3EcchHWJyD.jpg","genres":["мультфильм","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"974397","ru":"Моя чудная семейка","en":"My Freaky Family","year":"2024","type":"Мультфильм","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/wPudEOa1KsFRK4O9ayJNmmaXa0.jpg","genres":["мультфильм","семейный","фэнтези"],"overview":"Бетти — обычная школьница, которая любит гулять с друзьями и играет в музыкальной группе. Но ее большая и дружная семья немного… чудная. Мама, папа и брат обладают магией и творят чудеса. Собака вообще разговаривает и спорит со всеми. Однажды Бетти узнает удивительную тайну. Оказывается, только она может спасти мир от злого колдуна, и для этого ей надо разучить и сыграть старинную песню, ноты которой надежно спрятаны.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"915039","ru":"喜羊羊与灰太狼之筐出未来","en":"喜羊羊与灰太狼之筐出未来","year":"2022","type":"Мультфильм","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/mdgWZ9csH6YSPbk9cZDgNDqm8ZG.jpg","genres":["мультфильм","комедия","боевик"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1053075","ru":"ラブライブ！虹ヶ咲学園スクールアイドル同好会 NEXT SKY","en":"ラブライブ！虹ヶ咲学園スクールアイドル同好会 NEXT SKY","year":"2023","type":"Мультфильм","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/bcEl5C4vvSULfFxLHeTr7FlK7ax.jpg","genres":["мультфильм","музыка"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"779813","ru":"Ван-Пис: Золото. Эпизод 0","en":"ワンピース フィルム ゴールド: Episode 0","year":"2016","type":"Мультфильм","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/k42V0FcZqwBKkOD9HsfgSt8Tg5j.jpg","genres":["мультфильм","комедия"],"overview":"Луффи и его команда разрабатывают план действий перед походом в казино.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""