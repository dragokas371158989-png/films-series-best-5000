израка, вооруженный тесаком, электропилой и прочими малоприятными приспособлениями, и вновь кровь льется ручьями. Возможно, он просто люто ненавидит мюзиклы?..","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"26995","ru":"Franklin's Magic Christmas","en":"Franklin's Magic Christmas","year":"2001","type":"Мультфильм","rating":6.5,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/8UCyVoZAlmfea7RAcpC8pPlP9x2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AiUZpjobTgnJ3AVcEakq6gsXzMp.jpg","genres":["семейный","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"236012","ru":"The Prize Pest","en":"The Prize Pest","year":"1951","type":"Мультфильм","rating":6.5,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/uNGSgLtSkCgnRfmE3rBKIu8aPEh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dXmKwyLf9cnQwS8uqgkHiMGOhPT.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"210823","ru":"Quackodile Tears","en":"Quackodile Tears","year":"1962","type":"Мультфильм","rating":6.5,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/aetgwh0QWNY468Y7mzFWA6B6fad.jpg","backdrop":"https://image.tmdb.org/t/p/w780/llnwu9OqvoHBdDJcoq0UAldSVBX.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"501547","ru":"Chris the Swiss","en":"Chris the Swiss","year":"2018","type":"Мультфильм","rating":6.5,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/7NZo1HHNv7y0ODjNLNZ9TL2qpAX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wHG6USkOBgUtxnBWwNsHlfluIc1.jpg","genres":["мультфильм","документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"86277","ru":"Katy, la oruga","en":"Katy, la oruga","year":"1984","type":"Мультфильм","rating":6.5,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/nW4PXtnuXUzga2Er5suXzZNHR3a.jpg