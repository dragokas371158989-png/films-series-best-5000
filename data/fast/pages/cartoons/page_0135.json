агородных девиц, так и не удалось найти своё место в столице. В душе она знает, что её настоящий дом затерян где-то в землях Дальнего Востока, и ей нужно вернуться туда. Встретив друг друга, Геннадий и Надежда отправляются в великое и опасное приключение — на поиски себя и своего места в мире.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"944703","ru":"劇場版IDOL舞SHOW","en":"劇場版IDOL舞SHOW","year":"2022","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/up3w45xvOy1rw6zxqYNKw00ENq3.jpg","genres":["мультфильм","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1532239","ru":"Chiranjeevi Hanuman: The Eternal","en":"Chiranjeevi Hanuman: The Eternal","year":"2026","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/5PJNeckEmOcMVh8xT4YVjdUf5nj.jpg","genres":["мультфильм","боевик","приключения","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"861574","ru":"Mush-Mush et le petit monde de la forêt","en":"Mush-Mush et le petit monde de la forêt","year":"2021","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/2zXjVQiSZclMQZ6I1Bfjmj8Smv.jpg","genres":["мультфильм","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"804107","ru":"Un tuffo nel blu","en":"Un tuffo nel blu","year":"2021","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/lNDcFxZGWHiz2mQnpiimsd4z7lW.jpg","genres":["музыка","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1061821","ru":"Prends garde à toi !","en":"Prends garde à toi !","year":"2026","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/q4gsi7H0cKEp5LtNUSEsBPidS3K.jpg","genres":["драма","приключения","мультфильм"],"overview":"","source":"tmdb","epis