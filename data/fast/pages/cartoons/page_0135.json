age.tmdb.org/t/p/w342/rNufjR9rmql0PFRAjtZTQhW1krG.jpg","backdrop":"","genres":["Мультфильм","Приключения","Фэнтези"],"overview":"Капитан Геннадий Невельской, отличник Военно-морской академии, из-за своего таланта вместо покорения дальних морей вынужден преподавать морскую науку Цесаревичу, наблюдая, как чужие мечты подменяют его собственные. 14-летней Надежде, юной воспитаннице института благородных девиц, так и не удалось найти своё место в столице. В душе она знает, что её настоящий дом затерян где-то в землях Дальнего Востока, и ей нужно вернуться туда. Встретив друг друга, Геннадий и Надежда отправляются в великое и опасное приключение — на поиски себя и своего места в мире.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"944703","ru":"劇場版IDOL舞SHOW","en":"劇場版IDOL舞SHOW","year":"2022","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/up3w45xvOy1rw6zxqYNKw00ENq3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wYiu3jWNZUzrbMVQSdLUbZobsUS.jpg","genres":["Мультфильм","Музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1532239","ru":"Chiranjeevi Hanuman: The Eternal","en":"Chiranjeevi Hanuman: The Eternal","year":"2026","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/5PJNeckEmOcMVh8xT4YVjdUf5nj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/36GbUxGLMzQstNmWbRetQaPjR1K.jpg","genres":["Мультфильм","Боевик","Приключения","Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"861574","ru":"Mush-Mush et le petit monde de la forêt","en":"Mush-Mush et le petit monde de la forêt","year":"2021","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/2zXjVQiSZclMQZ6I1Bfjmj8Smv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1Xr10Fw7Dgb4Dply5Xrb0HuKV4W.jpg","genres":["Мультфильм","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","co