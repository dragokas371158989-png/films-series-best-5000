":6.1,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/d96SFX22o3dIuZ0qzOLNJ7ErfGP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9PbQNBrQVd9gqGAak9wxNvfZZr9.jpg","genres":["Мультфильм","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"164794","ru":"Now That Summer Is Gone","en":"Now That Summer Is Gone","year":"1938","type":"Мультфильм","rating":6.1,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/5KbEKB5EPwO21OjYv0kiOJ1J3MD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xcdY0EaJaEyKlxbVs6gxSd26rVt.jpg","genres":["Мультфильм","Комедия","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"204036","ru":"Пропавшая грамота","en":"Пропавшая грамота","year":"1945","type":"Мультфильм","rating":6.1,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/iQFsyRUmYIXZcq6VTogRFjdaAUA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k178A5662SEyO0WiI0HtaLTmF40.jpg","genres":["Мультфильм","Фэнтези","Комедия","Семейный"],"overview":"По фантастической повести Н. В. Гоголя. Жарким августом к царице с гетманской грамотой отправляют в столицу казака. По дороге заводит он знакомство с разгульным запорожцем. На привале новый друг рассказал, что продал душу дьяволу и ждёт расплату. Ночью казак не стал ложиться спать, решил посмотреть, что дальше будет. Как стемнело, на место привала пришёл чёрт, увёл лошадь, а с ней и царскую грамоту. Пришлось гонцу искать пропажу в переполненном нечистой силой лесу. На утро распрощался казак со знакомцем и, уже без остановок, помчался в Петербург.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"304599","ru":"Simhall","en":"Simhall","year":"2014","type":"Мультфильм","rating":6.1,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/x8a097h7QHBZt6h7IJT6KH92A3f.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hdoj2O7m1hiFDdamYfmkMSHPswi.jpg","genres":["Комедия","Мультфильм"],"overview":"","source":"tmdb","episode