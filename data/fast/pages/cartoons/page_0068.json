ge.tmdb.org/t/p/w780/4pVb1Ra6AyZKUdw8gye7JOhzVJz.jpg","genres":["боевик","фэнтези","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"565023","ru":"Mickey Mouse Clubhouse: A Goofy Fairy Tale","en":"Mickey Mouse Clubhouse: A Goofy Fairy Tale","year":"2016","type":"Мультфильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/vL45wYvMz5toqMqSsqCZ4t3j0VX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zwus9rsux01eMFz9JN7kP6irpdE.jpg","genres":["мультфильм","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"914172","ru":"The Refrigerator","en":"The Refrigerator","year":"2001","type":"Мультфильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/reOTl1AZ3B2rwbr2BBXA91UDIoa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4Nc1QBp11pgfB1abhe99KGLo0cn.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"136423","ru":"Runaway Ralph","en":"Runaway Ralph","year":"1991","type":"Мультфильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wxovdoRuOXzPn3JPeHJXZT0N62R.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8wrc9XGVX3qB5XM2xaNlykRUDWv.jpg","genres":["семейный","телевизионный фильм","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"155607","ru":"День, когда содрогнулась земля","en":"地球が動いた日","year":"1997","type":"Мультфильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/vLw4XLo3BVA0j19YuLDgDNKnAgw.jpg","backdrop":"","genres":["драма","мультфильм"],"overview":"16 января 1995 г. Такахаси Цуёси, ученик начальной школы Сиокадзе, думает только об учёбе. Он хочет поступить в хороший колледж и затем устроиться в хорошую компанию, поэтому у него часто не остаётся времени на друзей: девочку по имени Михо, напоминающую ему о важности отношений с окружающими, и Кадзу, одноклассника, часто болеющего и пропускающего учёбу. 17 января на его родной город Кобе обрушилось землетрясение интенсивностью 6.9 баллов по шкале Рихтера, унесшее жизни более 6000 человек и оставившее не менее 300.000 человек без крова. Пережив потерю одного из друзей и помогая справиться с бедой другому, Цуёси обнаруживает, что его жизненные приоритеты изменились. Он взрослеет и не может больше отказывать в помощи людям вокруг него.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1370629","ru":"Slugterra: Eastern Caverns","en":"Slugterra: Eastern Caverns","year":"2015","type":"Мультфильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/kgHvUhinHva0DVbeXTf92bBdz9h.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8ijrYbnSUSZ1VwPKw5MyCYCpURf.jpg","genres":["боевик","приключения","мультфильм","комедия","семейный","фэнтези","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"236656","ru":"The Hungry Goat","en":"The Hungry Goat","year":"1943","type":"Мультфильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/pdqnVJ1CgiETfvnPahRbRo2SO0R.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1nm9p0ORef5V6Z73UY1orApk82.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278340","ru":"Lady Fishbourne's Complete Guide to Better Table Manners","en":"Lady Fishbourne's Complete Guide to Better Table Manners","year":"1976","type":"Мультфильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1iDeQpNaCLZKTaXgbN6JMiTtisD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3l7hnq5TDzLSt7QtjV0dbspuyJx.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"914169","ru":"Electromagnetic Radiation","en":"Electromagnetic Radiation","year":"2001","type":"Мультфильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/