f8GSqgdFMS24FiIlgIbUaybCMjh.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"102","ru":"Driven","en":"Driven","year":"1998","type":"Сериал","rating":10.0,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/9vMd3NY8qE6HhC64bjZB6T1NEOY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fAay9Y7fGXinpQOWjRiAN0VZXf4.jpg","genres":["Документальный"],"overview":"Главная героиня Райли Томас - девушка серьезная, привыкшая все держать под контролем и следить за каждым собственным шагом и действиями приближенных. Однако отношения с представителями противоположного пола именно из-за этой черты характера не складываются. Кто бы мог подумать, что вскоре девушка встретит мужчину, который заставит ее отказаться от привычных взглядов на жизнь и покажет, насколько это круто - просто взять и потерять контроль над всем. Настоящая волна неконтролируемой любви накроет пару, но к чему это способно привести? Смогут ли персонажи переступить через черту безумной влюбленности и наладить серьезные отношения?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"152661","ru":"Scott the Woz","en":"Scott the Woz","year":"2021","type":"Сериал","rating":10.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/oRrI0z6mZuBuMkJzcIlGx5BEvgy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9fjNd2Qps16Cmu94nzA2Tz8B20s.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1158406","ru":"シン・ゴジラ対エヴァンゲリオン交響楽","en":"シン・ゴジラ対エヴァンゲリオン交響楽","year":"2017","type":"Фильм","rating":10.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/haEZz0idzhtlhMsor1jm5Zx78dQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2AeWVlHFbfNJFcluIjf0zOwKbT1.jpg","genres":["Музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"260505","ru":"달려라석진","en":"달려라석진","year":"2024","type":"Сериал","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/vpVsnuwAqdjzzqCEPPwXPYuuGnD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oQX8c0Zl5uGSF2hhCqi5h6hnemA.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"128919","ru":"ให้รักพิพากษา","en":"ให้รักพิพากษา","year":"2021","type":"Сериал","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/yittELZuPu4u25HXcYPu4rMK0iq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nV5kKuGplgno30kUxeJB8N8get.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1509968","ru":"We, Brothers","en":"We, Brothers","year":"2025","type":"Фильм","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/h8hsQT3ROv3woYPtov6nbxD7RIH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zJdqm7q96Hw5qpe3gCxQUIEO1JQ.jpg","genres":["Драма","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"79395","ru":"Лус Мария","en":"Luz María","year":"1998","type":"Сериал","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/qzmQRXc5vdPbmPWx0zpw6A7hb5n.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eOvfpuXvXrPKXeisMbO46z5ikao.jpg","genres":[],"overview":"Луc Мария, невинная провинциальная девушка, приезжает с больной матерью Росой в столицу. Они останавливаются в доме Модесты, старинной подруги Росы, которая многие годы работала поваром в резиденции богатой семьи Мендоса. Мать Лусеситы так и не смогла поправиться. Она зовет к своему смертному одру Мигеля Мендоса, главу богатого семейства, который является настоящим отцом Лусеситы. Роза берет с него клятву, что после ее смерти он позаботится о девушке. Мигель берет ее на работу в качестве служанки, так как не может сказать всю правду своей жене Грасиэле, холодной и расчетливой женщине. В доме Мендоса Лусесита знакомится с Густаво, красивым культурным человеком..","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"84781","ru":"ضيعة ضايعة","en":"ضيعة ضايعة","year":"2008","type":"Сериал","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/8XPVQKxbNMTcsYLaOTniE8U3FzP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5hs7Hj9xQGH1EwNpngn3cxTcQbv.jpg","genres":["Комедия","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"606061","ru":"The Keyboard Cowboys: A Look Back at Hackers","en":"The Keyboard Cowboys: A Look Back at Hackers","year":"2015","type":"Фильм","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/aebl0Zp2Y6EmM2SksM40vD3zqJl.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1341771","ru":"Spider-Man!","en":"Spider-Man!","year":"1993","type":"Аниме","rating":10.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/lvXFC3xpMdaIqjFMVEfjpSrelPm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zQ8AxTPiCiS5nnwXpwTBPBHSaa5.jpg","genres":["Боевик","Драма","Аниме"],"overview":"Еще вчера Питер Паркер был обычным школьником, которого все считали неудачником и занудой, но в один прекрасный день с ним происходит чудо. Питера кусает паук-мутант, после чего с нескладным юношей происходит фантастическая метаморфоза! И вскоре Человеку-Пауку придется сразиться с Зеленым Гоблином - терроризирующим город монстром на летающем глайдере. В этой великой битве решится не только их судьба, но и судьбы тысяч жителей города...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302444","ru":"Refill - If Only","en":"Refill - If Only","year":"2021","type":"Сериал","rating":10.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/rYnQ31p7He0boGQ3fIBxNfwn5L8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hmDW14wuhpv6vCjuRUpogSHOTeh.jpg","genres":["Комедия","Драма","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1689693","ru":"