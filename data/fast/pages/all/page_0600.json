":8,"poster":"https://image.tmdb.org/t/p/w342/oRrI0z6mZuBuMkJzcIlGx5BEvgy.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1158406","ru":"シン・ゴジラ対エヴァンゲリオン交響楽","en":"シン・ゴジラ対エヴァンゲリオン交響楽","year":"2017","type":"Фильм","rating":10.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/haEZz0idzhtlhMsor1jm5Zx78dQ.jpg","genres":["музыка"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"260505","ru":"달려라석진","en":"달려라석진","year":"2024","type":"Сериал","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/vpVsnuwAqdjzzqCEPPwXPYuuGnD.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"128919","ru":"ให้รักพิพากษา","en":"ให้รักพิพากษา","year":"2021","type":"Сериал","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/yittELZuPu4u25HXcYPu4rMK0iq.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1509968","ru":"We, Brothers","en":"We, Brothers","year":"2025","type":"Фильм","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/h8hsQT3ROv3woYPtov6nbxD7RIH.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"79395","ru":"Лус Мария","en":"Luz María","year":"1998","type":"Сериал","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/qzmQRXc5vdPbmPWx0zpw6A7hb5n.jpg","genres":[],"overview":"Луc Мария, невинная провинциальная девушка, приезжает с больной матерью Росой в столицу. Они останавливаются в доме Модесты, старинной подруги Росы, которая многие годы работала поваром в резиденции богатой семьи Мендоса. Мать Лусеситы так и не смогла поправиться. Она зовет к своему смертному одру Мигеля Мендоса, главу богатого семейства, который является настоящим отцом Лусеситы. Роза берет с него клятву, что после ее смерти он позаботится о девушке. Мигель берет ее на работу в качестве служанки, так как не может сказать всю правду своей жене Грасиэле, холодной и расчетливой женщине. В доме Мендоса Лусесита знакомится с Густаво, красивым культурным человеком..","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"84781","ru":"ضيعة ضايعة","en":"ضيعة ضايعة","year":"2008","type":"Сериал","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/8XPVQKxbNMTcsYLaOTniE8U3FzP.jpg","genres":["комедия","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"606061","ru":"The Keyboard Cowboys: A Look Back at Hackers","en":"The Keyboard Cowboys: A Look Back at Hackers","year":"2015","type":"Фильм","rating":10.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/aebl0Zp2Y6EmM2SksM40vD3zqJl.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1341771","ru":"Spider-Man!","en":"Spider-Man!","year":"1993","type":"Аниме","rating":10.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/lvXFC3xpMdaIqjFMVEfjpSrelPm.jpg","genres":["боевик","драма","Аниме"],"overview":"Еще вчера Питер Паркер был обычным школьником, которого все считали неудачником и занудой, но в один прекрасный день с ним происходит чудо. Питера кусает паук-мутант, после чего с нескладным юношей происходит фантастическая метаморфоза! И вскоре Человеку-Пауку придется сразиться с Зеленым Гоблином - терроризирующим город монстром на летающем глайдере. В этой великой битве решится не только их судьба, но и судьбы тысяч жителей города...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"302444","ru":"Refill - If Only","en":"Refill - If Only","year":"2021","