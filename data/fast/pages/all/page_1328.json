6M89aj32GxYe8UAI8EO.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"281932","ru":"ErOddity(s)","en":"ErOddity(s)","year":"2014","type":"Фильм","rating":4.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/1c5iW7UuEVDMHkaAw9OCOSKoxOy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mGhNeStcKX6hJjZn2UVzM2nje9M.jpg","genres":["драма","фэнтези","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"567976","ru":"Свингеры 2","en":"Свінгери 2","year":"2019","type":"Фильм","rating":4.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/oKtXh7EmaQnEeK8D2ZdzGjZ1wWq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2aq458PG35UR0bhXIkWH5qX08QC.jpg","genres":["комедия"],"overview":"В любой супружеской паре может настать тот момент, когда в постели уже испробовано всё. У светской львицы Илони и бизнесмена Игоря вроде бы получается делать свою интимную жизнь разнообразной, но Игорь становится все менее энергичным, ему нужна подзарядка, чтобы снова идти в бой. Что они только не пробовали: и ролевые игры, и тантрический секс — ничего не помогает. В поисках нужного средства пара зайдет настолько далеко, настолько будет нужно.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"592495","ru":"Мумия возрождается","en":"Mummy Reborn","year":"2019","type":"Фильм","rating":4.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/iE8rP6zFOlEivL1sa9WPcLB2oZS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zFkJrj7uxgCgEx4JlTPloLCem8f.jpg","genres":["приключения","ужасы"],"overview":"Когда группа подростков, которым отчаянно нужны деньги, решают ограбить местный антикварный магазин, они находят старый деревянный гроб, в котором лежит мумия и древний амулет. Но они не догадываются, что мумия проклята, и пойдет на все, чтобы вернуть амулет истинному хозяину. Воришки должны поторопиться, чтобы вернуть мумию на место и спасти мир, пока не стало слишком поздно.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299545","ru":"Удивительный волшебник из Лапы","en":"The Amazing Wizard of Paws","year":"2015","type":"Фильм","rating":4.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/9FNMJQAOXGAZ5TeBnbvXon7WT7L.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b7Qcq2NteZMRfjaqmQLfzZycYLv.jpg","genres":["семейный","приключения","фэнтези","фантастика"],"overview":"Фильм расскажет о храбром мальчике, который переборол агорафобию с помощью нового друга — говорящего пса. Собака оказалась заколдованным волшебником и герою предстоит снять злые чары, и попутно выиграть конкурс талантов, чтобы спасти отчий дом от злых кредиторов и выплатить долги.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299618","ru":"Fugly!","en":"Fugly!","year":"2014","type":"Фильм","rating":4.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/cfYW2qgCmzE7G5PxLtdZGoxblHQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rlKE5qSM4VINSyCloPDsrWhwjzn.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"462263","ru":"Dawning Of The Dead","en":"Dawning Of The Dead","year":"2017","type":"Фильм","rating":4.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/gXkpGnmo4oeC0ZPXVBIqx04oCcF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/flz6JuGqqFVglY1WAkUwRkQcKHE.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1186274","ru":"Златовласка и три медведя: Смерть и каша","en":"Goldilocks and the Three Bears: Death & Porridge","year":"2024","type":"Фильм","rating":4.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/42C0Yq0TwqMUIWOBPNJ53mwWqyh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qxRRUG0LHrgTYqPS3g2dNrXSccx.jpg","genres":["ужасы","триллер"],"overview":"Златовласка и Три медведя живут в лесном домике. Когда группа друзей вламывается в их жилище, Златовласка — предводительница стаи, решает избавиться от непрошеных гостей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"842721","ru":"Отец мух","en":"Father of Flies","year":"2021","type":"Фильм","rating":4.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/usMvHRj89vx3ZfZ8KYl2MHbreVa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iyE7pjTFDu7dPanw7SqEM0NTWYz.jpg","genres":["ужасы"],"overview":"Маленький мальчик с ужасом обнаруживает, что вместо матери в их доме теперь странная незнакомая женщина, и ему придется столкнуться с пугающими сверхъестественными силами, которые, похоже, обитают внутри неё.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"968351","ru":"Allegoria","en":"Allegoria","year":"2022","type":"Фильм","rating":4.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/b8QfIeN7J0Qs0cyunDg6GDRiBax.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zschsuBSYBpg4JlAxaLRmZt98zJ.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"434574","ru":"Тьма в Гаване","en":"Havana Darkness","year":"2019","type":"Фильм","rating":4.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/yjnsQlZWgp9Wsc9OCbHt4KaNgx6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/JbzTMxvyljNlYfByNmhLKbrbWF.jpg","genres":["триллер"],"overview":"Изучая происхождение таинственной рукописи, якобы написанной самим Эрнестом Хемингуэем, трое друзей оказываются запертыми внутри заброшенного здания, расположенного в самом центре Гаваны. Для того, чтобы найти выход из здания, им придется пройти сквозь лабиринт, напичканный смертельными ловушками. К тому же, кто-то пытается играть с ними в «кошки-мышки», не оставляя времени на раздумье.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"279998","ru":"Алтергейст","en":"Altergeist","year":"2014","type":"Фильм","rating":4.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/zuenYlZu3yvx0SdOoG