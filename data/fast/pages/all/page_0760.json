:"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"303476","ru":"League of Pigs","en":"League of Pigs","year":"2020","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/jfbTRJVJhm4RqDyyjBKOIvaW9S.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1650812","ru":"Giusto Gervasutti - Il Solitario Signore delle Pareti","en":"Giusto Gervasutti - Il Solitario Signore delle Pareti","year":"2009","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/gQyJpfF08mcHynUXUi16el1TuGV.jpg","genres":["документальный"],"overview":"Джусто Джервасутти (1909-1946) был итальянским альпинистом, которого многие считают лучшим альпинистом своего поколения и одним из величайших послевоенных. Свои первые подвиги он совершил в 1930 году и произвел революцию в альпинизме в Западных Альпах, многократно прокладывая и открывая маршруты чрезвычайной сложности, которые и сегодня считаются абсолютными: восточная стена Гранд-Жорасс (вместе со своим другом Боккалаттом), северо-восточный отрог Эгюий-Нуар-де-Пётере, северная стена Гранд-Жорасс, маршрут Джервасутти на Гульермине, восточная стена Монблана-дю-Такуль (где он погиб в 1946 году), а также невероятный список восхождений. Фильм, снятый к столетию со дня рождения Джусто Джервасутти, изображает одинокого и измученного горца, обладающего безупречным чувством морали, сторонника легкого и этичного альпинизма, всегда стремящегося к недостижимому счастью.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"103751","ru":"非诚勿扰","en":"非诚勿扰","year":"2010","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/byyGU3dMbM1qAzNi9nV3oCrxin7.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"197233","ru":"都市男女","en