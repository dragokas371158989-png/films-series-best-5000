ор оно входит в пятёрку рейтинговых программ SBS.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"221468","ru":"Hollywood Squares","en":"Hollywood Squares","year":"1998","type":"Сериал","rating":7.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/vHwgcxGQH8KpgTL4KEV4eG2IAn8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nuHRZ7HyyB3Z8vw7kRQXDz9aDRR.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"89861","ru":"密室大逃脱","en":"密室大逃脱","year":"2019","type":"Сериал","rating":7.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/yq6gJUXCFimaq1V8zvA27R2eODW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/IGYjrwnFCAL2UahS7E1myQE3JT.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"20464","ru":"妙手仁心","en":"妙手仁心","year":"1998","type":"Сериал","rating":7.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/8zwsCXcFb7JsLyEcgdKt83NtGDE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bN9iy2mpfjVcalXQMFycPkyvcAF.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"33088","ru":"Samson en Gert","en":"Samson en Gert","year":"1990","type":"Сериал","rating":7.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/99kGWN0jMMbFoRWs6SVFk1XicLH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oNUblzQC62ra2vSCRIeQyVr1lHv.jpg","genres":["Детский"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"65322","ru":"緊急取調室","en":"緊急取調室","year":"2014","type":"Сериал","rating":7.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/75rzFIK6CgUdwsfungprVkqKA7A.jpg","backdrop":"https://image.tmdb.org/t/p/w780/787V1MSw0yHWkFyNsJWNkifqW21.jpg","genres":["Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"10432","ru":"Adventures in Wonderland","en":"Adventures in Wonderland","year":"199