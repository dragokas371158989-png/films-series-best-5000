s://image.tmdb.org/t/p/w342/pdo0vHZZbxAUlSmpiP6SbeMmiZJ.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"228229","ru":"Sangucheable \"El programa\"","en":"Sangucheable \"El programa\"","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/A9C9xvB4vWDxwNHNaSBMdZWRKSx.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"226439","ru":"Kill Your Lawn","en":"Kill Your Lawn","year":"2023","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/zBdd7Jxki3a68HGCQOLRvgf0a9Q.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"205371","ru":"Captain's Log","en":"Captain's Log","year":"2020","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/tstgd0zRBnwPqRO4VS1B96ezOEQ.jpg","genres":["Ток-шоу","НФ и Фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"155432","ru":"Vägen ut med Lars Lerin","en":"Vägen ut med Lars Lerin","year":"2022","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/gnSzep6iUuXEI3YBxVzYj8tvzTQ.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"101932","ru":"Lightlapse","en":"Lightlapse","year":"2020","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/pwG6VH1Kk4m2rQOkpajMXElOz4i.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1460578","ru":"Насреддин Динет","en":"نصر الدين ديني","year":"1977","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/aTYwDQJeoP6v2LtvLcjfHkxFKDM.jpg","genres":["документальный"],"overview":"Этьен Дине (родился 28 марта 1861 года в Париже — умер 24 декабря 1929 года) — французский художник и литограф. Он является одним из самых ярких представителей ориенталистической живописи начала XIX и XX веков. Получив в 1884 году стипендию, Дине совершил свою первую поездку на юг Алжира, в регион Бу-Саада. Культура Нила оказала на него глубокое влияние, настолько, что он возвращался туда несколько раз, пока в 1900 году не обосновался в своей первой алжирской мастерской в ​​Бискре. В 1905 году он купил дом в Бу-Сааде, чтобы проводить там три четверти года. В 1907 году по его совету в Алжире была построена вилла Абдельтиф по образцу виллы Медичи в Риме. Прожив большую часть своей жизни в Алжире, после принятия ислама он взял себе имя Насреддин Динет. 12 января 1930 года он был похоронен на кладбище Бу-Саада, где в музее, носящем его имя, хранится несколько его работ.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1420669","ru":"Иглотерапевты животных","en":"Tublid loomad","year":"1964","type":"Мультфильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lPC3riTL6bTuZyGSDxMSxbAaBd2.jpg","genres":["мультфильм"],"overview":"Котик защищал курочек от хулигана-щенка, упал с поленницы и сломал лапу. Петушок отправился один в лес, чтобы позвать на помощь доктора-белку.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1401107","ru":"Говорящий родник","en":"Говорящий родник","year":"1986","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/89e1zzfGiSClxMYULlvCphJ4Rll.jpg","genres":["драма"],"overview":"Фильм режиссера Маргариты Касымовой рассказывает о том, как люди умели любить и дорожить этой любовью.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1356838","ru":"Late Night","en":"Late Night","year":"2018","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/oR0YoLh8pk4zTXo33fTAF6Eo3zu.jpg","genres":["криминал"],"overview":"Кэтрин Ньюбери является пионером и легендарным ведущим ночных ток-шоу. Когда ее обвиняют в том, что она «женщина, которая ненавидит женщин», она нанимает Молли. В мужском отделе сценаристов Молли становится первой женщиной. Но таких «косметических» изменений слишком мало для начальства. Грозная Кэтрин также сталкивается с реальностью низких рейтингов и её хотят заменить. Молли, в свою очередь, полна решимости помочь Кэтрин, оживив ее шоу.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"842","ru":"Prime Time","en":"Prime Time","year":"","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fVFjkppgZVeatZpTQax4TshmIuN.jpg","genres":["Новости"],"overview":"В канун Нового 2000-го года, странный человек с оружием захватывает заложников в телевизионной студии центрального телеканала Польши и выдвигает единственное требование: выступить в прямом эфире.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1705862","ru":"Curiosity Killed the Cat","en":"Curiosity Killed the Cat","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/yAmFzFjCKFf3vt3CUQDgfVcji0n.jpg","genres":["триллер","детектив","ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1690422","ru":"The Weapons Dealer","en":"The Weapons Dealer","year":"2021","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1NUcZDLG1D3fLIMMmHRu35IbUhq.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1585780","ru":"Les deux trappeurs","en":"Les deux trappeurs","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p