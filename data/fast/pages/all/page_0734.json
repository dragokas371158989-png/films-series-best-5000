ь нечестным путем.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1440729","ru":"Дочь партизана","en":"Дочь партизана","year":"1937","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/cK8VyT0wvNsAlEQWIMGnqzoJlxS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/49wTDZepE1VUAsYOA69iIGSc81B.jpg","genres":["Военный","Драма"],"overview":"Об участии детей в борьбе с кулаками.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1352673","ru":"Работа над ошибками","en":"Работа над ошибками","year":"1989","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1pgJFOJu8ipDCq2rM0qTQjlyvYI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kMM1odVYEjn3u20hqCPtcnXOIF2.jpg","genres":["Драма"],"overview":"Молодой журналист Андрей Петрушов, посвятивший много времени поискам пропавшей рукописи писателя Пустырева, репрессированного в 1937 году, временно устраивается преподавателем русского языка и литературы в школу...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1709434","ru":"Elovena","en":"Elovena","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/feeKrnHif0kmDE7Xine7MXOYoDF.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1697424","ru":"Platos Rotos","en":"Platos Rotos","year":"2024","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9xHANtv53Qz7Hmr2GlSgnwlhAyQ.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1639397","ru":"Meeting Your Maker","en":"Meeting Your Maker","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1SZy5gSGn3GN1PdBxi7mvmmPwc8.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":