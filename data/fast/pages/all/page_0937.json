ps://image.tmdb.org/t/p/w342/btWx9I2Ii2dOixSn8GKdpvsmR4a.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1095146","ru":"공인섹스중개사","en":"공인섹스중개사","year":"2021","type":"Фильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/ouGkhKeSNEnhz6Tktq74t1bsDt9.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1482791","ru":"Son of the Soil","en":"Son of the Soil","year":"2025","type":"Фильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9hUe4MPJX513MAAQwKX1E5rrYrt.jpg","genres":["боевик","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"308113","ru":"Vinny Ki Kitaab","en":"Vinny Ki Kitaab","year":"2025","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/gWxgPlh2BciJ1O9xcw2V21upj8i.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"507425","ru":"Наачтун: затерянный город майя","en":"Naachtun : La Cité maya oubliée","year":"2016","type":"Фильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rRF5SvhL4BO8oHHIdLH2Q7JOfew.jpg","genres":["документальный","телевизионный фильм"],"overview":"На протяжении двух тысяч лет в Центральной Америке существовали царства, созданные народом майя. Их цивилизация процветала, а затем загадочно исчезла. За несколько сотен лет их храмы, дворцы и астрономические обсерватории были поглощены джунглями, а их история затерялась под покровом зелени. Города, созданные ими были легендами своего времени, как сегодня Париж, Лондон, Нью-Йорк или Лос-Анджелес. Наачтун, расположенный в джунглях на территории современной Гватемалы, был последним великим городом цивилизации майя. Историки до сих пор ищут ответ на вопрос, почему Наачтун сохранился и продолжал процветать еще 200 лет после падения цивилизации майя.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1036978","ru":"Le mythe de la femme noire","en":"Le mythe de la femme noire","year":"2023","type":"Фильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/onRXOjzgTirm6T1MJc1yuHmvVW1.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"540710","ru":"Наследие Ал Карал","en":"アル・カラルの遺産","year":"1993","type":"Мультфильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hgbvSDCBbB1Ys1bbu03HXanaQ7I.jpg","genres":["мультфильм","фантастика"],"overview":"В 26-ом столетии человечество расселилось уже по всему космосу и обнаружило древние реликты внеземной цивилизации. Раскопки и изучение этих реликтов полностью монополизировала корпорация Богэн, поэтому всем остальным приходится довольствоваться только опустошёнными руинами да мелкими находками. Однако благодаря утечке данных из сети Богэн небольшая команда тележурналистов смогла произвести сенсацию, показав кадры настоящего чужого, которого поймала корпорация. Молодая Шана Т, принимающая участие в документальных съёмках о внеземной цивилизации, мечтает встретиться с представителями внеземной расы и выучить их язык. И когда Торюн, чужой запертый в лабораториях Богэн, случайно видит в одной из передач Шану, то хочет непременно встретиться с ней. Похоже, что Шана имеет какую-то связь с древней внеземной цивилизацией. Вот только корпорация Богэн не собирается просто так отпускать Торюна.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1049653","ru":"Билли и Мэнди дурачат луну","en":"CN Invaded Part 5: Billy & Mandy Moon the Moon","year":"2007","type":"Мультфильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/tQshtvJ2nQjKD6qsiErDaq79xbk.jpg","genres":["мультфильм","комедия","фантастика","семейный","телевизионный фильм"],"overview":"23-я серия седьмого сезона \"Ужасных приключений Билли и Мэнди\", действующая в качестве финала основного сериала в порядке производства. Премьера этого специального эпизода состоялась на Cartoon Network как финал специального кроссовера под названием Invaded.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"593054","ru":"Пандора и Акуби","en":"パンドラとアクビ","year":"2019","type":"Мультфильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/UeEHPPGENjU6cUs5sggDtS5ymU.jpg","genres":["мультфильм","боевик","фэнтези","приключения"],"overview":"Аниме про приключения двух боевых девчушек на Диком западе и в снежных горах. Персонаж Акуби - из аниме 1969 года \"Hakushon Daimaou\". Пандора же - персонаж игры \"Monster Strike\".","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"576200","ru":"Поединок","en":"果し合い","year":"2015","type":"Фильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3g9lxBYPB3X9W83NUKsYWZlqzQB.jpg","genres":["телевизионный фильм","драма"],"overview":"По мотивам одноименного произведения Сюхэйя Фудзисавы. Будучи вторым сыном незнатного самурая, Саноскэ Сёдзи не смог официально жениться и всю жизнь прожил нахлебником у своего старшего брата. После смерти брата он чувствует, что родственники тяготятся им. За ним готова ухаживать только внучатая племянница Мия. Но она попала в беду, её хотят выдать замуж за нелюбимого человека. Первый из двух фильмов Сигэмити Сугиты по произведениям Сюхэйя Фудзисавы с Тацуя Накадайем в главной роли. Фильм второй - «Возвращение» (Kikyo, 2019).","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"367178","ru":"Большой «Фитиль» (Киноальманах)","en":"Большой «Фитиль» (Киноальманах)","year":"1964","type":"Мультфильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/ABLhXjoYkXdN3iFO9H8wsX2sS9.jpg","genres":["комедия","мультфильм"],"overview":"Советский полнометражный комедийный сатирический киноальманах, состоящий из восьми новелл - (Дачурка, Влип, Сон в руку, Гудок, В поезде, Увертюра, Расплата, Жалкий жребий), одной интермедии с шимпанзе и мультфильме - (Миллионер) о бульдоге. Снят редакцией всесоюзного сатирического киножурнала «Фитиль» на нескольких киностудиях страны в 1963 году.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1330566","ru":"A.I.","en":"A.I.","year":"2025","type":"Фильм","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hXoXXQn9XFW2F1IKx3LT8PvRW33.jpg","genres":["фантастика","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}