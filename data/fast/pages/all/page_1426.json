overview":"Капитан Геннадий Невельской, отличник Военно-морской академии, из-за своего таланта вместо покорения дальних морей вынужден преподавать морскую науку Цесаревичу, наблюдая, как чужие мечты подменяют его собственные. 14-летней Надежде, юной воспитаннице института благородных девиц, так и не удалось найти своё место в столице. В душе она знает, что её настоящий дом затерян где-то в землях Дальнего Востока, и ей нужно вернуться туда. Встретив друг друга, Геннадий и Надежда отправляются в великое и опасное приключение — на поиски себя и своего места в мире.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1444084","ru":"Herança de Narcisa","en":"Herança de Narcisa","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/kmeGpWrYy679EzRJvu04Sn91j6w.jpg","backdrop":"https://image.tmdb.org/t/p/w780/u4u57qkAW1yKWJsA3YIW8UYoXif.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1418582","ru":"Quinze Dias","en":"Quinze Dias","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/pvtRVMKF4efPjD07Aq5sBuPFhSj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wiIFKSEZkKgmoI1ylsrbqvRxu1S.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1584289","ru":"Tri cima","en":"Tri cima","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/khfNtDHv83Aperf13UMqEq8tbuJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qEGYrIIFZ1M4NUaA4LA9b4LRiC1.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1489030","ru":"Home Entertainment","en":"Home Entertainment","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/8KLcv37Wa90os0KHSGuFUEwZFCg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b