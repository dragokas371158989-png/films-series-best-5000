 с чрезвычайными ситуациями и решать личные проблемы. В Зубова влюблена сельский фельдшер Вера Большаева, что ставит его самого перед непростым вопросом - способен ли он полюбить другую женщину после трагической гибели жены.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"100676","ru":"勇敢的心","en":"勇敢的心","year":"2014","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/pBAIEQ7wnBUFE7mDdu3kZI3pyhq.jpg","genres":["драма","Боевик и Приключения","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"138086","ru":"올드 미스 다이어리","en":"올드 미스 다이어리","year":"2004","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qTVBsOtJoqVXpXwM9MrUzYaGeOy.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"213372","ru":"The Men in Blazers Show","en":"The Men in Blazers Show","year":"2014","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/uzXhRjsDzzIMNlr5CWCCx6Thp6S.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"220871","ru":"O Casarão","en":"O Casarão","year":"1976","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/sxGu1xot9bg5hvq5BIioCoIDESx.jpg","genres":["Мыльная опера","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"103113","ru":"Kender du typen","en":"Kender du typen","year":"2011","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4esgj6ljBRGmg6h3bn11O0L2Sdf.jpg","genres":["семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"71272","ru":"外科风云","en":"外科风云","year":"2017","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4j3TQh6qqYLD9RqyOKHUM9RpHXz.jpg","genres":["драма"],"overview":"","s