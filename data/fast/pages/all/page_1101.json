342/3vTrOzqkJmiSsDOWqIpbwt9SAbl.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"765012","ru":"Master Pieces","en":"Master Pieces","year":"2020","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/wJdxC6PkrPyAZDlcSn2VoELBGX6.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"387500","ru":"Никому не Верь","en":"Corrupt","year":"2015","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qpM8AUuX7CIvXy0q52YDsGju9Ig.jpg","genres":["триллер","телевизионный фильм","криминал"],"overview":"Окружной прокурор, просит помощи у финансита в расследовании убийства ключевого свидетеля.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1028884","ru":"Emergencia","en":"Emergencia","year":"2022","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lY3k1S68VDeVpAG4HMFep8XwKOm.jpg","genres":["телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"395337","ru":"Истинный Робот Геттер против Нового Робота Геттера","en":"真ゲッターロボ対ネオゲッターロボ","year":"2000","type":"Мультфильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/iiuweTcrZlBBD1uj0grM2ScBEYL.jpg","genres":["фантастика","мультфильм","боевик"],"overview":"Выжившая в глубинах земли Империя ящеров, вновь пытается уничтожить человечество и стать единственной расой на планете. И только отважная команда Нео Геттер Робо может остановить их.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"476269","ru":"Грань невинности","en":"夏天19岁的肖像","year":"2017","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/o6pnwisH5SDkB7F81LHR0UB2aDv.jpg","genres":["триллер","детектив"],"overview":"Попав в аварию на мотоцикле, Кан Цяо оказывается в больнице. Изнывая от скуки, парень целыми днями следит за красивой девушкой, которая живёт в доме напротив. Однажды в дождливую ночь он видит, как девушка совершает убийство. Выйдя из больницы, Цяо не может противиться желанию быть ближе к таинственной незнакомке, поэтому он устраивается в фирму, где та работает.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"956859","ru":"Becoming Frederick Douglass","en":"Becoming Frederick Douglass","year":"2022","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/zMqCNqymDRyx1yRAhDlU7CHNI00.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"865628","ru":"Voyeur(s)","en":"Voyeur(s)","year":"2020","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4o6EnPOLbdEJitgHnkNoEzAtOHD.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"767262","ru":"The Stuff","en":"The Stuff","year":"2018","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/hrOLTwssDhBVUAB1qzi9uO007is.jpg","genres":["боевик","комедия","драма"],"overview":"Зимой на Аляске группа людей находит на снегу некую липкую массу, похожую на сгущёнку. Люди пробуют её — она оказывается очень вкусной. Но эта масса обладает одним интересным свойством — она живая. Но такой её особенности люди не придают особого внимания...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"688498","ru":"父と息子の地下アイドル","en":"父と息子の地下アイドル","year":"2020","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lFsnQ5bRWf7OFQFrSjh9ZBNriU0.jpg","genres":["музыка","семейный","драма","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1039502","ru":"Oye Makhna","en":"Oye Makhna","year":"2022","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/nIKKvLUBhjKjl2e1PMtq1R5eDzr.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"906731","ru":"Послуга","en":"Послуга","year":"1983","type":"Мультфильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/nA6TQRk4VtUUgnOK1XgyI3LIzdU.jpg","genres":["мультфильм"],"overview":"Забавная история о жадной курице","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"440676","ru":"Красный пепел: механический мир","en":"RedAsh -GEARWORLD-","year":"2017","type":"Мультфильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/6yHJ7aXE0kGNyJDlaWSYHjEgFqb.jpg","genres":["боевик","мультфильм","фантастика"],"overview":"Футуристический мир. Люди нанорасы, чьи гены содержат наномашины, наделяющие носителей особыми силами, находятся под гнётом обычных людей — чистой расы. Бек, легендарный охотник, обладающий силой «алого пепла», стремится накопить достаточно денег для операции по удалению машин, чтобы присоединиться к чистой расе. Вместе с грубым на вид, но чувствительным механиком Тайгером, они используют машины параллелей, чтобы перемещаться в старый мир и выполнять там опасные задания. © Okito Shigakure","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"117146","ru":"Златовласка и три медведя","en":"Goldilocks and the Three Bears","year":"1991","type":"Мультфильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/hgU5EG73QC6B2GAmD0ZaOyXy8eh.jpg","genres":["мультфильм","семейный","фэнтези"],"overview":"Однажды красавица Златовласка попала в лесной домик трех медведей и подружилась с косолапыми. Но как-то раз ее новые друзья неожиданно пропали, и девушка отправляется на их поиски. Оказалось, что медведи выступают в цирке. Их заставляют веселить публику, а потом держат в железной клетке. Девушка помогает топтыгиным убежать из цирка и возвратиться в их дом в лесу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299444","ru":"Being Franziska van Almsick","en":"Being Franziska van Almsick","year":"2025","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qnzpnHIr5ilEgUT19cb4ncNS4t9.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1687446","ru":"The Comfort Killer","en":"The Comfort Killer","year":"2026","type":"Фильм","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1vKXqfOgliO8u2RIqtmlrVcC1OU.jpg","genres":["комедия","ужасы","триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"80318","ru":"Тысяча витрин","en":"CentoVetrine","year":"2001","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/25v6iDGmIpyG3zndfYdt4KfQgQ9.jpg","genres":["Мыльная опера","драма"],"overview":"В этой теленовелле прослеживается жизнь нескольких семей, работающих в модном торговом центре «Тысяча витрин». Бесконечное разнообразие магазинов, хитроумная паутина взаимоотношений, любовь и ревность, месть и мечты… Ферри – богатейшие владельцы Торгового центра – переживают ряд потрясений, которые переворачивают жизнь семьи вверх тормашками. У отца появляется еще одна дочь, о существовании которой он не подозревал, а приемный сын после долгого отсутствия возвращается, чтобы отомстить. При этом сердце главы семейства пытаются завоевать сразу две женщины… Семья Беттини кажется идеальной, но их детям придётся смириться с тем, что родители разводятся. Восемнадцатилетняя Франческа мечтает стать актрисой и встретить принца своей мечты…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"84121","ru":"超新星运动会","en":"超新星运动会","year":"2018","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/3exKhLmc09Jwtnw37VThZc2F6dK.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"8662