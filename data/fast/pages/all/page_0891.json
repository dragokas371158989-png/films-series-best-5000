000 человек и оставившее не менее 300.000 человек без крова. Пережив потерю одного из друзей и помогая справиться с бедой другому, Цуёси обнаруживает, что его жизненные приоритеты изменились. Он взрослеет и не может больше отказывать в помощи людям вокруг него.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"287182","ru":"Velayate Eshgh","en":"Velayate Eshgh","year":"2000","type":"Сериал","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/uXRxNtoxfCl8YyCUxmxsjJUL3sx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iFrHOTfmIET7jRNryVt6A6ChIHV.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"283491","ru":"Come stanno bene insieme","en":"Come stanno bene insieme","year":"1989","type":"Сериал","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rNbhUIATWCcmQnDSwn1A0pXIYEa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ej2YtYbYF5jZPN1bSJM45ARWV7G.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"303418","ru":"HIStory3-圈套","en":"HIStory3-圈套","year":"2019","type":"Сериал","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/eGDML3aHpCH8UeNeEv1h28RQkWG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m4v0Hc4j229tixsoMtbcZB4WwMQ.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"287073","ru":"الثريا","en":"الثريا","year":"1998","type":"Сериал","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/p1l9ey8sdlroOREqs4VlnqFF2CL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zVGU6L0MO71eqrJroLrzFgiOvJz.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"317915","ru":"Jogo do Amor","en":"Jogo do Amor","year":"1985","type":"Сериал","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7OvQNS8xddROIcOqGegfNnZeDTx.jpg","backdrop":"https://image