а"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1118608","ru":"Crackcoon","en":"Crackcoon","year":"2023","type":"Фильм","rating":3.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/3m75UguqByhZYXJ5pbuXRBV40PO.jpg","genres":["ужасы","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"578498","ru":"Семейная практика","en":"Sohn meines Vaters","year":"2019","type":"Фильм","rating":3.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/iqRQpYOc5TUTTGmLaTWtp0QXo4L.jpg","genres":["драма"],"overview":"У Саймона отношения любви-ненависти со своим отцом. Когда его родители уезжают в отпуск, Саймон начинает соблазнительную игру в кошки-мышки с любовницей своего отца и катастрофически запутывается в липкой семейной сети.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"529011","ru":"Двор Улун","en":"新乌龙院之笑闹江湖","year":"2018","type":"Фильм","rating":3.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/tZSErJ4VuvuM58Gcc0PNGTOiqxw.jpg","genres":["комедия"],"overview":"Чтобы украсть из буддистского монастыря древнюю священную реликвию, двум мошенникам приходится стать монахами и начать учить секретное кунг-фу.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"491020","ru":"Flashburn","en":"Flashburn","year":"2017","type":"Фильм","rating":3.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/v8j9xPt4t5QvuDbc0Hsn1pM1Cb6.jpg","genres":["фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"356631","ru":"Les trois soeurs","en":"Les trois soeurs","year":"2015","type":"Фильм","rating":3.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/lVu5C3g9tcU6F8KhPwvab9cQcNs.jpg","genres":["драма","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"594958","ru":"Ключ времени","en":"Ключ времени","year":"2020","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/jkKOr6Jj078T5FzUUb4ETjNlFGM.jpg","genres":["фэнтези"],"overview":"Бездетные супруги писатель Андрей и художница Ольга удочеряют восьмилетнюю Ксюшу. Директором детского дома, где воспитывалась девочка, оказывается бывшая подруга Андрея Ирена. Она до сих пор страстно любит Андрея и намерена вернуть его любой ценой, пускай для этого придётся разрушить его семейное счастье. Тем временем Андрей сочиняет фантастический роман о темной стороне Петербурга. На страницах его книги город на Неве превращается в фантасмагорический мир, где само время остановилось, а улицы населяют бездушные твари. Внезапно Ксюша попадает в мир «темного Петербурга» из романа Андрея, где встречает таинственного друга Парамона. Героев ждёт немало опасных приключений…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"750602","ru":"Estándar","en":"Estándar","year":"2020","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/yDJCYI9A4Kl6uURwy5ysgave25F.jpg","genres":["комедия","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"737759","ru":"Camp Murder","en":"Camp Murder","year":"2020","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/5cPXVvgucgjj6CifYOair35YDOY.jpg","genres":["драма","ужасы","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"71734","ru":"Kumkum Bhagya","en":"Kumkum Bhagya","year":"2014","type":"Сериал","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/8iOwGJnY59Hre6eAsQCDYhBfinx.jpg","genres":["семейный","драма","Мыльная опера"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","