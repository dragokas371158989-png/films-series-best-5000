":"","country":"","ageRating":""},{"id":"491020","ru":"Flashburn","en":"Flashburn","year":"2017","type":"Фильм","rating":3.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/v8j9xPt4t5QvuDbc0Hsn1pM1Cb6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7qBC3XQmyt4TIkvHOdaG8oKVvA1.jpg","genres":["фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"356631","ru":"Les trois soeurs","en":"Les trois soeurs","year":"2015","type":"Фильм","rating":3.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/lVu5C3g9tcU6F8KhPwvab9cQcNs.jpg","backdrop":"","genres":["драма","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"594958","ru":"Ключ времени","en":"Ключ времени","year":"2020","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/jkKOr6Jj078T5FzUUb4ETjNlFGM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hhi9c55VIQaq9kVP01GNJrIXFEA.jpg","genres":["фэнтези"],"overview":"Бездетные супруги писатель Андрей и художница Ольга удочеряют восьмилетнюю Ксюшу. Директором детского дома, где воспитывалась девочка, оказывается бывшая подруга Андрея Ирена. Она до сих пор страстно любит Андрея и намерена вернуть его любой ценой, пускай для этого придётся разрушить его семейное счастье. Тем временем Андрей сочиняет фантастический роман о темной стороне Петербурга. На страницах его книги город на Неве превращается в фантасмагорический мир, где само время остановилось, а улицы населяют бездушные твари. Внезапно Ксюша попадает в мир «темного Петербурга» из романа Андрея, где встречает таинственного друга Парамона. Героев ждёт немало опасных приключений…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"750602","ru":"Estándar","en":"Estándar","year":"2020","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/yDJCYI9A4Kl6uURwy5ysgave25F.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3uyEyRaKreBo1nQGqhGcOCNMIly.jpg","genres":["комедия","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"737759","ru":"Camp Murder","en":"Camp Murder","year":"2020","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/5cPXVvgucgjj6CifYOair35YDOY.jpg","backdrop":"","genres":["драма","ужасы","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"71734","ru":"Kumkum Bhagya","en":"Kumkum Bhagya","year":"2014","type":"Сериал","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/8iOwGJnY59Hre6eAsQCDYhBfinx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b553YRgZmMIfBB4LfGEgnBt1tFk.jpg","genres":["семейный","драма","Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"435038","ru":"ചായം പൂശിയ വീട്","en":"ചായം പൂശിയ വീട്","year":"2015","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/milQQcApBicb9x4ishCMA5zYz8c.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7ldQNUWn7n0xSR3XG2f0L6sLmCc.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"274915","ru":"Приграничье","en":"The Borderline","year":"2026","type":"Сериал","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/vIkrUPBgQswLuTXQRcXWnf9AeuN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ae7lKRzxW0iQmvZDd2mWGecIwbH.jpg","genres":["криминал","драма"],"overview":"Полицейский из приграничного городка раскрывает незаконную торговлю наркотиками, связную с его другом детства и безжалостным британским преступным синдикатом, который действует в живописном регионе Тысячи островов на границе Канады и США.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1047622","ru":"Laruan","en":"Laruan","year":"2022","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/qYRXXpUPnAQ38yGc0uz0PT