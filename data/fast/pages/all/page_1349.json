tmdb.org/t/p/w342/cpFf6LRdlOCrmWgEhilCicD2j6d.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"892409","ru":"Johnny Test's Ultimate Meatloaf Quest","en":"Johnny Test's Ultimate Meatloaf Quest","year":"2021","type":"Мультфильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/tMSwg1fGNEULf3SXuiLTKoRf74z.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"259712","ru":"Саймон","en":"Simon","year":"2016","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/iJgbUKHZGT6VrCMV05aojPJmCfk.jpg","genres":["триллер","ужасы","драма"],"overview":"Журналистка криминальной хроники проникает в дом убийцы, чтобы добыть доказательства его вины. Но он возвращается раньше и начинается игра в кошки-мышки со смертельным исходом.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"583247","ru":"Хорошая игра","en":"İyi Oyun","year":"2018","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/dPrX8RB8ZU7kksJdXZICQRlOzGl.jpg","genres":["комедия"],"overview":"Кибертурниры пользуются огромной популярностью среди многомиллионной аудитории геймеров всего мира. Главный герой Дженк, после окончания учёбы устраивается работать в интернет-кафе, где играет за другие команды, зарабатывая на этом. Так он помогает больной сестре. Менеджер команды геймеров замечает талантливого парня и предлагает ему стать членом команды и принять участие в большом турнире.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"452746","ru":"Нимфа Салмака","en":"Нимфа Салмака","year":"1992","type":"Мультфильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/7uimh9UALfddlLRVLeBhFg2mMX1.jpg","genres":["мультфильм"],"overview":"Нимфа Салмака вела беззаботную жизнь, но однажды, по воле Эрота она влюбляется в прекрасного юношу. Однако, в ответ получает отказ. И тогда богиня Кибела – владычица гор, лесов и зверей, силой заклинаний решает исполнить желание нимфы…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"699351","ru":"5G Zombies","en":"5G Zombies","year":"2020","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/9NIsRwHdojUsAqPGPAyZmtgF49u.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"340551","ru":"Ралука","en":"Raluca","year":"2014","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/2iwG0HRBf3kYKnPm1Atl68IrLde.jpg","genres":["триллер","криминал","драма"],"overview":"Послужной список Филипа Маролда в полиции подпорчен, и теперь он перебивается частным сыском, выслеживая неверных мужей и жен. Во время очередного (на первый взгляд ординарного) дела, он встречает в баре красивую румынку. Слишком большой любитель женщин, чтобы даже задуматься над случайностью такой встречи, он очертя голову бросается в новую интрижку. Даже не подозревая при этом, куда она его заведет. К сожалению, три превосходных эротических сцены вырезаны из этого эротического триллера и детектива (они есть в допах). Непонятно, чем они жестче тех, которые оставлены. Похоже, Чехия хочет утвердиться в списке стран с тупой цензурой. Замечательна главная героиня. Одна из безусловно «плотских» актрис, типа Вицы Керекеш.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"168861","ru":"青き炎","en":"青き炎","year":"1989","type":"Мультфильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/A9e1JveOGuNTe6bRMY1PXhXjOdn.jpg","genres":["мелодрама","мультфильм","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"290725","ru":"Lazarus: Apocalypse","en":"Lazarus: Apocalypse","year":"2014","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/8OIdlTc4kEpjdjE9Br3b8Zi8Kkf.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"382569","ru":"奔爱","en":"奔爱","year":"2016","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/28jo0AfPjW4vW0pAdmzsLgtbWdC.jpg","genres":["комедия","мелодрама","драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"331600","ru":"Bićemo prvaci sveta","en":"Bićemo prvaci sveta","year":"2015","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/3ZIdX1aANmIPpkoGKP1cEEPmmBd.jpg","genres":["семейный","драма","история"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"362247","ru":"After Eden","en":"After Eden","year":"2015","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/aVDaICAxJwl5UiLBPRakY3dAQ1l.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"214211","ru":"Маргинальная служба","en":"THE MARGINAL SERVICE","year":"2023","type":"Аниме","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/afTqZchdLBhHLvBn4pLJNn2i5lo.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","комедия","Аниме"],"overview":"Во время инопланетного вторжения на выручку человечеству приходит странное существо, внешне выглядящее как человек, но, очевидно, им не являющееся. Так правительство Японии узнаёт, что на Земле вместе с людьми мирно сосуществует инопланетяне. Дав им название «окололюди», власти решают не принимать активных действий, а пока просто понаблюдать. Но спустя несколько лет начинает происходить странное: правительство сталкивается с серьёзными миграционными проблемами, а по стране начинают происходить загадочные террористические акты. Во всём этом хаосе и появляется «Маргинальная служба» — специальное учреждение, призванное не только справляться с угрозой «окололюдей», но и тщательно скрывать правду от простого населения. А вот как оно это будет делать — большая загадка.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1223177","ru":"На тлеющих углях","en":"From Embers","year":"2024","type":"Фильм","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/bkPeyDPMjWgEa4YKshSyLFVpFFS.jpg","genres":["драма","триллер"],"overview":"Мать-одиночка Лили тяжело переживает смерть мужа, Рона, который погиб в результате взрыва в лаборатории. Она растит сына Кевина, который страдает аутизмом, мальчик скучает по отцу и чувствует себя одиноким. Лили и Кевин вынуждены переехать в дом поменьше, она пытается найти работу и получить страховые выплаты за Рона. Но следствие считает, что он покончил с собой, а значит, денег ей не полагается. Лили не верит в версию полиции и начинает собственное расследование, чтобы раскрыть тайну гибели Рона.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1119744","ru":"Fall Guy","en":"Fall Guy","year":"2023","type":"Фильм","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/t9boxUvb1XB0dZ8xZ7eEv6i8eRq.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1080217","ru":"Lagaslas","en":"Lagaslas","year":"2023","type":"Фильм","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/A2XGgTql9BGzeF5Znfn31IIrglu.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"564074","ru":"Убойный отпуск","en":"Killer Vacation","year":"2019","type":"Фильм","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/ur9Vf8h1hsOEMN12YIFN2v76ZHh.jpg","genres":["триллер","телевизионный фильм"],"overview":"Линдси влюбляется в своего начальника и у них начинается роман. Он женат, но клянётся, что давно не живёт с женой и планирует скоро с ней развестись. Чтобы доказать Линдси свою любовь, он предлагает ей поехать с ним на медицинскую конференцию, которая проходит в курортном отеле. Однако, приехав на место, пара замечает, что за ними следят какие-то подозрительные люди.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"735476","ru":"Hollywood.Con","en":"Hollywood.Con","year":"2021","type":"Фильм","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xN2mIDMgQ4o78VTun1FeQpo3QMB.jpg","genres":["боевик","приключения","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"300496","ru":"Nefeli","en":"Nefeli","year":"1980","type":"Фильм","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/4EgkcisexFjGfQmGI0IrVxZUBIv.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"553404","ru":"Piel rota","en":"Piel rota","year":"2014","type":"Фильм","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/kYgEB01zCSCE3ltx6ISBTb67i3N.jpg","genres":["триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"457591","ru":"閨蜜2","en":"閨蜜2","year":"2018","type":"Фильм","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/j64qIV6E1KfJOmzvH1l1fjAhhoM.jpg","genres":["драма","мелодрама","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"290386","ru":"പെരുച്ചാഴി","en":"പെരുച്ചാഴി","year":"2014","type":"Фильм","rating":3.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/yPRrPQKiUK2qtP8BS