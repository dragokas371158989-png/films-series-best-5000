://image.tmdb.org/t/p/w342/155ZMISJkCkTleBKKoNlubt51bB.jpg","backdrop":"","genres":["комедия","семейный","Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"382176","ru":"Yunus Emre: Aşkın Sesi","en":"Yunus Emre: Aşkın Sesi","year":"2014","type":"Фильм","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/yI3B0pq729WCbvoHOpMUOpEhRLz.jpg","backdrop":"","genres":["история","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"276148","ru":"Wolverine Versus Sabretooth","en":"Wolverine Versus Sabretooth","year":"2014","type":"Мультфильм","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/xhhsWTu80RX05uDF3b3R22kyluc.jpg","backdrop":"","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"161452","ru":"The Talking Parcel","en":"The Talking Parcel","year":"1978","type":"Мультфильм","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/j9vfCha8SbR7Jdj2brhmom6Z2r.jpg","backdrop":"","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"136915","ru":"Поймай Тинипин! Королевство эмоций","en":"캐치! 티니핑","year":"2020","type":"Аниме","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/fk3yFUOB9dRF5N5zz1XXuSDESb6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yPLWd31uUImEaeEA7qI28jGTjgR.jpg","genres":["мультфильм","Детский","Аниме"],"overview":"Роми - совсем не обычная девочка, какой кажется на первый взгляд. Она – принцесса волшебного Королевства Эмоций и прибыла с важной миссией на Землю. Дело в том, что сюда сбежали магические существа Тининпины, связанные с разными эмоциями. Добрые и милые непоседы очень любят наводить хаос и суматоху. Чтобы поймать озорных беглецов, Роми должна применить волшебные способности. Но юной героине нужно быть осторожной, ведь в земном городке никто из жителей не верит в магию.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"9168","ru":"Ниндзя-воин Тобикагэ","en":"忍者戦士 飛影","year":"1985","type":"Аниме","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bRWBtbmaTs6ft14UkSQmGfojGBN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1RXu75iWbYxhnVxG1UzTluCGCLj.jpg","genres":["мультфильм","Боевик и Приключения","Аниме"],"overview":"Рассказ в сериале идет от имени нинзя воина Тобикаге. Он рассказывает о жизни молодого парня по имени Джо Майа. По стечению обстоятельств, Джо стал невольным свидетелем битвы между пришельцами из космоса. Бомбардировщики с космической планеты Забум, атакуют и пытаются захватить в плен корабль принцессы с планеты Родарио. Эта принцесса сбежала от императора планеты Забума. Император озлоблен и рассержен, планирует захватить всю Вселенную. Гонки за принцессой продолжаются. Космические бомбардировщики преследуют звездолет принцессы, стреляя по нему. Получив повреждения звездолет, вынужден сделать аварийную посадку на планете Марс. В этом фильме фантастика и мистика переплетены воедино. Наш герой Джо пробирается на космический корабль принцессы….А там так события разворачиваются, что жизнь Джо меняется невероятно.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"19613","ru":"モンタナ・ジョーンズ","en":"モンタナ・ジョーンズ","year":"1994","type":"Аниме","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/7EDquGJ5eYZA5AwErQ4RxVjZLpX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gvpH9WoUYq1xAGoepEtw2AjjEkT.jpg","genres":["мультфильм","комедия","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"240335","ru":"Запах сундука","en":"Sandık Kokusu","year":"2023","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/sXzTcIgXMWIotuymY6Lt1zdztWC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lkB2CrZ1JAau1vy9A6PfMITMotl.jpg","genres":["семейный","драма"],"overview":"В центре сюжета находится Карсу - мощная и увлекательная главная героиня. Она - мать трех прекрасных детей, но не всегда находит с ними общий язык и взаимопонимание, что создает дополнительные сложности их семейной жизни. Волнующая история будет разворачиваться перед зрителями уже в конце осени 2023 года, и мы с нетерпением ожидаем ее премьеры. «Запах сундука» - это не только увлекательное развитие сюжета и запоминающиеся персонажи, но и глубокие семейные ценности, которые затрагивают души всех зрителей. Будьте готовы забыть о реальности и погрузиться в мир эмоций и семейных отношений.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1381273","ru":"Бумажный тигр","en":"Paper Tiger","year":"2026","type":"Фильм","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/9txURTPuB1W85km06SAnrFcOCFF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7MdKguHQw1n5Mfhj0vC5QRkrgj9.jpg","genres":["криминал","драма","триллер"],"overview":"Два брата стремятся к американской мечте, но оказываются втянутыми в опасную схему русской мафии, которая терроризирует их семью, подвергая испытанию их дружбу, поскольку предательство становится возможным.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1497011","ru":"Я убью тебя","en":"아이 킬 유","year":"2025","type":"Фильм","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/oJpCOgb5SrO9VEgLloXaGUVZNdU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t6lyk3hebsNa1lciu9KMDnHSRP.jpg","genres":["боевик"],"overview":"Из-за плачевного финансового положения девушка соглашается стать двойником попавшей в скандал богатой наследницы, с которой они похожи как две капли воды.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1071249","ru":"Собачий побег","en":"വാലാട്ടി","year":"2023","type":"Фильм","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/jx6mR9gj3Yils8aRjVCrUFuGwi3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hSaWQkfHXJ46UM2eDo1YdmptGnk.jpg","genres":["приключения","комедия","драма"],"overview":"Золотистый ретривер Томи и красотка-спаниель Амалу проводят все время вместе, но их владельцы не одобряют роман из-за предрассудков. Не в силах противостоять великой собачьей любви, четвероногая пара сбегает и отправляется в путешествие, полное приключений.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"131659","ru":"제시의 쇼!터뷰","en":"제시의 쇼!터뷰","year":"2020","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/jhrwzMvVLwJo9uWhHS9m3IV8tIi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zi5B3468QjH6jM7D8gQYzPgvMQZ.jpg","genres":["Ток-шоу","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1581366","ru":"Next Room Affair","en":"Next Room Affair","year":"2025","type":"Фильм","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/fZp10EseYrSRN7rR920YK1tht9b.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6TNehXoiTp6I9vovBDslwCVi5cn.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"272681","ru":"岁月有情时","en":"岁月有情时","year":"2026","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ly8KtCEkT57YmMO7ztGkawzVXBy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y0R84gqHuRuGJ0rpf7dRf3QjZJW.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"263139","ru":"Самому себе в 1999 году","en":"致1999年的自己","year":"2025","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/AvX4P29ddg7GXQRUbifKn9D8U6q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1RT69lxNUUExpwdkF90nRN5dQ1b.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1231695","ru":"A metros de distancia","en":"A metros de distancia","year":"2025","type":"Фильм","rating":7.0,"vote