кого поединка победителем выходит храбрый Пак. Когда же рассеченное тело Дракона падает в пропасть, вновь расцветает выжженная земля.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"263897","ru":"Algonquin","en":"Algonquin","year":"2014","type":"Фильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/xKy03mCBssITrT9FOR54AM1g5c5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9TwSJ7mf8Ozy7yY5KDFArsYIyOM.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"16865","ru":"Raisins Sold Out: The California Raisins II","en":"Raisins Sold Out: The California Raisins II","year":"1990","type":"Мультфильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/adSVNeSixRUh5UElMoGcezGpaFt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fnBIX8wixj7aMdsIXPnBLpeSEeG.jpg","genres":["мультфильм","комедия","музыка","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"279990","ru":"The Great Bear Scare","en":"The Great Bear Scare","year":"1983","type":"Мультфильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1Z4wgWOZ9ihgzE6gUORhkUn6nUa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sJfbZ8bIqAJUDbx2pcXYYPnltrM.jpg","genres":["семейный","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"559843","ru":"Loulou","en":"Loulou","year":"2002","type":"Мультфильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/3BGyqoozuwucwfLbGCeM0gi9dIx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dU6L3yEuavEouU7AidUFyPy8gux.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"345205","ru":"Pølse","en":"Pølse","year":"2000","type":"Мультфильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/rCYZ9WTNeUCUMQB0mTorbuGNUz.jpg","backdrop":"https://image.tmd