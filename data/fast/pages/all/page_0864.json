гедию - у неё на глазах убили родителей. В конце концов они встречаются и влюбляются друг в друга. Но их прошлое и настоящее не даёт им покоя.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"90685","ru":"Bandish","en":"Bandish","year":"2019","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/brR9xJaQO6Ys89Pw3jiIKFdoqPP.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"92928","ru":"奇蹟的女兒","en":"奇蹟的女兒","year":"2018","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qfd7NLoVYbLVNzShXLMCzSHFICj.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"70444","ru":"Prinsessia","en":"Prinsessia","year":"2014","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/A7d0dwttPVd82zyRdW2tsXZ7kJV.jpg","genres":["Детский","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"68303","ru":"O Último Programa do Mundo","en":"O Último Programa do Mundo","year":"2013","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/6GgaL3BNoYBCcDCcyI1nWqn62nH.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"89815","ru":"那年，雨不停國","en":"那年，雨不停國","year":"2010","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/2JV1PXnVIK4MSvwRdXayfSNbFsE.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"33984","ru":"Jerseylicious","en":"Jerseylicious","year":"2010","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/hAH1beiKeWp5J6LfxdxgtV3LkCT.jpg","genres":["Р