tps://image.tmdb.org/t/p/w780/gGh7DLooar30FCEOYNnTVdTkjK3.jpg","genres":["мультфильм","драма","мелодрама","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"506643","ru":"劇場版 はいからさんが通る 後編 ～花の東京大ロマン～","en":"劇場版 はいからさんが通る 後編 ～花の東京大ロマン～","year":"2018","type":"Аниме","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/yT2UixDr6ApxrcJsqFlHjRJZEsf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7sYjLC3eBSiwL9upLArmYamPWCC.jpg","genres":["мультфильм","мелодрама","драма","комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"838720","ru":"Неделя в раю","en":"A Week in Paradise","year":"2022","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/dYmlqJeBkO2B9Aa2VCbzETtCS9X.jpg","backdrop":"https://image.tmdb.org/t/p/w780/96Z7daHRkf60AcrqL4Cy0nAbslr.jpg","genres":["мелодрама","комедия"],"overview":"Известная актриса узнаёт из прессы об измене мужа. В поисках утешения она летит на райский остров и знакомится в отеле с обаятельным шеф-поваром. Летняя мелодрама на фоне курорта Карибского моря с Малин Акерман, Конни Нильсен и Филипом Уинчестером.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"982813","ru":"Семь лиц Джейн","en":"The Seven Faces of Jane","year":"2023","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/AiC5auZlZNKxlNO8jlI73b63Bgw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l9kCyXUaCIqW8VnQDkvWorqUacL.jpg","genres":["драма"],"overview":"Мать-одиночка Джейн (Гиллиан Джейкобс) отвозит дочь в летний лагерь и впервые за долгое время остается наедине с собой. Впереди у нее длинная дорога, в которой она познакомится с новыми людьми, встретит старых знакомых, начнет познавать себя и различать, что ей нравится, а что нет. Каждый фрагмент жизни Джейн не похож на другие, одни окрашены в более мрачные тона, другие — окутаны духом вестернов, а третьи и вовсе похожи на мелодраму, но в каждом из них Джейн проходит через кризис идентичности, ища путь к себе настоящей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"776327","ru":"Любовь без памяти","en":"Blackout Love","year":"2022","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/yOoxbjxnzggNNCOtu152jrMpDUS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6WfZAveeI3OHZwtBx7vHhlvrUSZ.jpg","genres":["мелодрама","комедия"],"overview":"Циничная и расчетливая Валерия меняет мужчин, ни секунды не сожалея о расставаниях. Тому же она учит и своих подопечных из волейбольной команды. Но единственный человек, который год назад разбил ее сердце, снова появляется в жизни Валерии. Она решает, что теперь найдет в себе силы отомстить бывшему бойфренду. Или это ей только так кажется?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1069069","ru":"10일간의 애인","en":"10일간의 애인","year":"2023","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/osqXpbKzoyTYAGOEmgtID230p7M.jpg","backdrop":"https://image.tmdb.org/t/p/w780/15RFlhN9WmXadgzHEs93dHHeviE.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"288287","ru":"打噴嚏","en":"打噴嚏","year":"2020","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/1G7DZYsPHAzpnSh97bsnnfAqEth.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qk6khjQUF2B655bfX7NEHyhnHS.jpg","genres":["боевик","комедия","мелодрама","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"740963","ru":"Jump, Darling","en":"Jump, Darling","year":"2022","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/ziQks92PZUAkcxO3tvR3yCIXGXf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5OJnX7xXqHWuvvWaKC8GMPXFIyU.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"631880","ru":"Tyger Tyger","en":"Tyger Tyger","year":"2021","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/5fhlV6jdEd9iqYnE9XUQAAhvw82.jpg","backdrop":"https://image.tmdb.org/t/p/w780/14ATSJsT3KDmHQdZY8FeEMxfPoG.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"532811","ru":"Петсон и Финдус. Финдус переезжает","en":"Pettersson und Findus - Findus zieht um","year":"2018","type":"Мультфильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/8pXr7yT18nfOg2qkNM06RvdOBij.jpg","backdrop":"https://image.tmdb.org/t/p/w780/neN9tgO0E0iZjb5MT8Ph8B4F3Sv.jpg","genres":["семейный","мультфильм"],"overview":"С тех пор, как у Финдуса появился новый матрас, он просыпается каждый день часа в 4 утра и устраивает на этом матрасе скачки, не давая Петсону насладиться утренним сном. Однажды в сердцах Петсон произносит роковую фразу: «Либо ты прекратишь прыгать, либо твоя кровать окажется где-то в другом месте!» А Финдус, вместо того чтобы испугаться, моментально соглашается отделиться от старого фермера. Решив, что это игра, Петсон обустраивает для Финдуса крошечный домик. Однако котенок воспринимает ситуацию куда как серьезно: теперь у него есть не только место для прыжков и игр, свобода и независимость, но и еще… собственный дом, а это вам не абы что. Одним словом, Финдус переезжает — и кажется, что жизнь больше никогда не будет такой, как прежде.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"298581","ru":"Кровь храбрых мужчин","en":"Borgríki II - Blóð hraustra manna","year":"2014","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/9FITP0KQsYXXhAkzhHyJTCQuTmk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m5X8PYxedwhsdtLgr7nKnGlOXUG.jpg","genres":["криминал","триллер","боевик","драма"],"overview":"Бывший главарь мафии Гуннар отстранен от дел, утратил все влияние и мечтает о мести. Сербская мафия контролирует весь наркотрафик в стране, на них работает и продажный начальник наркоконтроля. Но в отдел внутренних расследований приходит молодой амбициозный сотрудник, который собирается всех вывести на чистую воду…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"550476","ru":"Кровь, пот и ужасы","en":"Blood, Sweat and Terrors","year":"2018","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/dfd7xEN3Fgr8U3g7OLk4DUKtY2p.jpg","backdrop":"https://image.tmdb.org/t/p/w780/myxNmLdQy59m0q0PbggKkMEiYC9.jpg","genres":["боевик","ужасы","триллер"],"overview":"Киноальманах, состоящий из девяти пропитанных кровью и адреналином историй, созданных в результате смешения ужасов и ураганного экшена.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"71654","ru":"Beat Shazam","en":"Beat Shazam","year":"2017","type":"Сериал","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/q2U5Iulo8NWWiOiVx0f7VX9o4RM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/r9lklmHeOznXd0WvJHbW47mMMag.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"377007","ru":"不可思异","en":"不可思异","year":"2015","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/royv6PqUojsFNbQntIPrLu4qVhe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ytybVDcBWR1ikme9EFi467CJg64.jpg","genres":["фэнтези","фантастика","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"557130","ru":"Dangerous Matrimony","en":"Dangerous Matrimony","year":"2018","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/m9rPNda9xApMtx3m6rWtwyKeeB1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8SWxF2GKXorlV1EzUCTd0da89CL.jpg","genres":["криминал","драма","детектив","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id