mHrYrAFE8Gr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rsN4OCStm0wtrcAO6TNmbw2rqMM.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_28764","ru":"Касимаси: Девушка встречает девушку","en":"かしまし ~ガール・ミーツ・ガール~","year":"2006","type":"Аниме","rating":4.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/xuDksNqmOcRAXBdFcMhcul0Ihn5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/35IaghRQMnVfeAfhbfNH0iczCN.jpg","genres":["мультфильм","комедия","НФ и Фэнтези","Аниме"],"overview":"Парень по имени Хадзуму (обладатель девичьей наружности, так что иногда его принимали за девушку) признаётся в любви Ясуне — той, которую любит. Но... получает от ворот поворот. Чтобы хоть как-то успокоить своё не на шутку расшалившееся сердечко, он отправляется к горе Касимаяма, месту, где впервые встретил свою любовь, но, заблудившись по пути, кружит по окрестностям до темноты. Уставший Хадзуму садится на землю и, заметив в небе падающую звезду, собирается загадать желание (знаете такой обычай, правда?), как вдруг понимает, что что-то здесь не так... И не мудрено, падающая звезда оказалась терпящим крушение космическим караблём, который дарит Хадзуму свой первый поцелуй, то бишь, врезается в нашего беднягу-героя. Юноша оказался не в пример живучим (благодаря помощи пришельцев), однако катастрофа подвергла его тело реконструкции... Здравствуй Хадзуму-девушка! Тут-то и начинается наша история.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"27867","ru":"Сакура: Война миров. Фильм","en":"サクラ大戦 活動写真","year":"2001","type":"Аниме","rating":4.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/pPyDj6ztLjpqY4beN0R6oogmNYT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1EOru4ITXD2uHMY26lAQkmjh2wP.jpg","genres":["боевик","мультфильм","комедия","фантастика","Аниме"],"overview":"Параллельный мир, Япония, 1926 год. Столица страны, Токио - развитой,построенный на западный манер мегаполис, где практически изжита преступность: ведь на страже спокойствия горожан стоит Отряд Цветов Армии Императорского Трона. Эта мобильная группа состоит из очаровательных девушек со сверхестественными способностями, управляющих шагающими паровыми доспехами - невероятными двуногими танками. Казалось бы, город надежно защищен от любых вторжений и диверсий... Однако неожиданное вторжение темных сил, до поры до времени тщательно маскировавших свое присутствие, ставит под вопрос само существование Отряда, а вместе с ним - миллионов жителей Токио.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1213712","ru":"विक्की विद्या का वो वाला वीडियो","en":"विक्की विद्या का वो वाला वीडियो","year":"2024","type":"Фильм","rating":4.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/77gbFuFUfXx3OWv6pGhOAfHMBpg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/efCflkxZPCHffIaZLuQhclVJcqM.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1311649","ru":"सन ऑफ़ सरदार २","en":"सन ऑफ़ सरदार २","year":"2025","type":"Фильм","rating":4.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/k47tmhqiUsmD6UoyoimHVQAjHx9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yU0Mx95513FmoXG4jWX4UssspQp.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"683044","ru":"Няня по обмену","en":"The Au Pair Nightmare","year":"2020","type":"Фильм","rating":4.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/tRAvwBorRUGaFjwNoEzsDvDvFD5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zabv4gQzxBqfUinWfr90rLyMcAm.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"469113","ru":"Ёжик Бобби: Колючие приключения","en":"Bobby the Hedgehog","year":"2016","type":"Мультфильм","rating":4.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/jbdUfznOa6yAgRZT6xqA3uxbNP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qVQe8L42YOLi3crmRSTO4iKkJME.jpg","genres":["мультфильм","семейный"],"overview":"События картины разворачиваются вокруг очаровательного и харизматичного ежика по имени Бобби. Правда, он забыл абсолютно всё. Проснулся в лесу, не смог ничего припомнить. Отчего могло это приключиться? Теперь его очень беспокоит данный вопрос, на который никто из животных не может найти ответа. И вот теперь маленький колючий герой решает выяснить что же на самом деле произошло и кто он такой. Прежде, чем главному герою откроется тайна о том, что он еж он пройдет через страшные испытания и разнообразные смешные ситуации. Восстановить память как оказалось, довольно не просто, а также вспомнить, кто его семья. Но до открытия тайны далеко, ему придется бегать по мегаполису, лазить по горам и по джунгли. Что же поможет Бобби узнать его тайну? Может он повстречает сородичей, которые ему все поведают? Эти и другие вопросы мы сможем разгадать вместе с главными героями посмотрев мультфильм.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"432285","ru":"Грегуар","en":"Gregoire","year":"2017","type":"Фильм","rating":4.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/b2GVvlmnpih9aRZPMDyooQLHGSU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vwCOInQ7jp3gs3yJLJljJZc2RGv.jpg","genres":["драма"],"overview":"Четверо молодых людей из Форта МакМеррей пытаются разобраться с последствиями своих действий и тем, как они повлияли на их друзей и семьи...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"432826","ru":"Dim the Fluorescents","en":"Dim the Fluorescents","year":"2017","type":"Фильм","rating":4.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/bBMSA1tdF9GN7NGYl1hHvmbsv17.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1PdfrtcOpBNUKnSKG3v0O607JgO.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_75776","ru":"Сказочная девочка","en":"メルヘン・メドヘン","year":"2018","type":"Аниме","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/mtTJ1zlPQdEYVkdsag9NCkSZM1O.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hSRorUSU8DIXuW5gGyUAQ5J8bre.jpg","genres":["мультфильм","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"712863","ru":"Непобедимая","en":"Dhaakad","year":"2022","type":"Фильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/q8rSeXR8SbvUDhfNcmYOVn9h7ip.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eRFcdnYaWKN4W9oROrkO5KuYeQV.jpg","genres":["боевик","триллер"],"overview":"Агни – высококвалифицированный агент разведки, которой предстоит взяться за выполнение очередного сложнейшего и очень опасного задания. На этот раз главная героиня должна будет найти и уничтожить одного одиозного международного преступника. Её цель – торговец людьми и оружием Рудравир. Он продолжает свою деятельность, несмотря на то, что за ним охотятся правительственные организации сразу нескольких государств. Около десяти лет Рудравир практически никак себя не проявлял, но недавно неожиданно для всех решил вновь вернуться в бизнес. Сможет ли Агни осуществить невозможное и уничтожить свою новую цель?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"779003","ru":"Рождественские воры","en":"Ladri di Natale","year":"2021","type":"Мультфильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/vabgb1thXqZVQ70qV0wXKuIsIwf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cPOLJDYmiPlgztkGSD9v9Drg5wb.jpg","genres":["семейный","комедия","криминал","мультфильм"],"overview":"Дети принимают за нянек грабителей, решивших спрятаться от полиции в их доме после неудачного ограбления.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"874219","ru":"A Holiday in Harlem","en":"A Holiday in Harlem","year":"2021","type":"Фильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/3yvhFmOiVSDvBRwe0dyaw7aoWWN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9gWa5dmOODpbIPjHLGOs4rgthzt.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"222071","ru":"Старухи","en":"Старухи","year":"2003","type":"Фильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/wc8lw0EGzC9tHTRmfcU9eY2GbDf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oMikik7EP1F6WJDGOYoS6h7grEx.jpg","genres":["драма"],"overview":"В далеком, богом забытом селе живут несколько старух. Несмотря на нищету тихой деревеньки, они не жалуются на жизнь, не унывают и умирать не собираются. Внезапно в деревню приезжает на постоянное жительство семья узбеков. Приезжие заводят хозяйство и устраивают свою жизнь, но кое-кому в деревне не нравится «засилье инородцев»…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"540122","ru":"Арестант no name","en":"Imprisoned","year":"2019","type":"Фильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/42WFx571KwtpYNCsQRPRr35A0gA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a6ZDd71oe8RL7Nk6Ml19AZrmAiB.jpg","genres":["триллер"],"overview":"Дилан Берк совершил много ошибок в прошлом, но теперь он живет мирной жизнью, зарабатывает на жизнь рыболовством, а его любимая, Мария, управляет кофейней в морском порту. Однако идиллия не может продолжаться вечно: тюремный надзиратель Даниэль Кальвин, чья жена погибла по вине Дилана 25 лет назад, жаждет мести.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"491277","ru":"Говард Лавкрафт и Подводное Королевство","en":"Howard Lovecraft & the Undersea Kingdom","year":"2017","type":"Мультфильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/oHvCi0e7p7yTSZOOJcYmoikykXk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/190ciRd37DTA5QmYq6tTbaRtxNk.jpg","genres":["мультфильм","семейный","фэнтези","приключения","ужасы"],"overview":"Молодому Говарду Лавкрафту предстоит отправиться в Подводное Королевство, чтобы найти все три мистических дневника своего отца и спасти свою семью.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"582759","ru":"Mr. லோக்கல்","en":"Mr. லோக்கல்","year":"2019","type":"Фильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/eGVv8FpUuNkmxYg6eT3usRuqW5T.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a2MQGUzY6ZtiiLFkkjdsrxpOMKl.jpg","genres":["мелодрама","боевик","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"459224","ru":"Dating My Mother","en":"Dating My Mother","year":"2017","type":"Фильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/zLbZEdLFUQrZTnR4qmViGncz5CQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/v5VAVvfS50VjMETF9odJzy8R1ZP.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"318093","ru":"Stinking Heaven","en":"Stinking Heaven","year":"2015","type":"Фильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/fC9K7Oi4eLvzWNZaaeSW7i3bDBs.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8dNZHoDKS3RXVGrJzYQhmzg8tdm.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"184313","ru":"Kozí příběh se sýrem","en":"Kozí příběh se sýrem","year":"2012","type":"Мультфильм","rating":4.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/24Yfu1PZsOApu4WeIV3C6NRG0y3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fVRvMaA4YK7CKWkUG73Zm7U2mrX.jpg","genres":["мультфильм","семейный","комедия","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1075536","ru":"Проститутки","en":"Suki","year":"2023","type":"Фильм","rating":4.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/6z8VVFdWX8nbvRIJkZVDlOUOJWc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1lat0QYutfuLxvLg7prCWHSxYZt.jpg","genres":["драма"],"overview":"Женщина-стриптизерша и жиголо пообещали друг другу, что их работа не сможет разлучить их. Но когда в дело вступают похоть и искушение, они начинают сомневаться в своей клятве.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"862856","ru":"По данным полиции","en":"Selon la police","year":"2022","type":"Фильм","rating":4.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/9VwCiuFyn8ax48G0w8h9tgdSmNi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tXBpiQzmJj7Ch72WfwBE5BMRemi.jpg","genres":["драма"],"overview":"Однажды утром измученный работой полицейский, которого все в участке называют Пинг-Понгом, сжигает свое полицейское удостоверение в туалете и исчезает, никому ничего не сказав. Коллеги ищут его целые сутки, встречают и теряют его в Тулузе и в пригородах. Но с каждым часом судьба подбирается всё ближе. Что ждёт Пинг-Понга и его коллег в конце этого сумбурного дня?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"918177","ru":"10 Truths About Love","en":"10 Truths About Love","year":"2023","type":"Фильм","rating":4.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/61ftDeGj78WVYyYzBlmYVRKeiD1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iHfYFteL7lRjhvZtpL1DsU4dkeU.jpg","genres":["телевизионный фильм","мелодрама","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"538514","ru":"История о камне","en":"紅樓夢","year":"2018","type":"Фильм","rating":4.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/boLjnu1Rye7CkTINbPveR9VmhyV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9kvONvT8XUCf4Qa9Fdgs8Gcv2Vj.jpg","genres":["драма","криминал","мелодрама"],"overview":"После смерти бойфренда, Лин уезжает в Тайбэй, где встречает Джоша, который также недавно приехал и уже нашел работу в баре \"Камень\" в Красном Доме. Постепенно между Лин и Джошем возникают романтические отношения. Однако в Красном Доме их отношения усложняются, с появлением еще двух персонажей - молодого, преуспевающего красавчика Шона и его друга Лиана. Когда Джош попадает в больницу, в Красном Доме происходит пожар и почти уничтожает его. Лин остается без работы, но это меньше всего его волнует, так как его мысли заняты внезапным исчезновением Джоша. Во время поисков своего бойфренда, до Лина доходят неприятные слухи о романтических связях Джоша.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"281455","ru":"Срочно (не) требуется мужчина","en":"Facet (nie)potrzebny od zaraz","year":"2014","type":"Фильм","rating":4.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/jHJA8zKyNCRuQkkxpyLOerjJS6k.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tI33TkqiJ86JQAEYRGFrW5p8NrH.jpg","genres":["драма","комедия","мелодрама"],"overview":"После расставания с изменившим ей парнем 30-летняя женщина возобновляет отношения с шестью бывшими, пытаясь найти любовь всей своей жизни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"6767","ru":"The Chris Rock Show","en":"The Chris Rock Show","year":"1997","type":"Сериал","rating":4.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/lI8tbdQ5qypQjxPNYKigwqKRDoa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s9vEohId4bpuO6xtiseY2OCKRGN.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"433055","ru":"Kuudes kerta","en":"Kuudes kerta","year":"2017","type":"Фильм","rating":4.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/b0qBHTX7Yk8cUnBkIrxGu9sAymc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aLOehh3vfVzMRRMVtcSR9B0tTTh.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"505906","ru":"சீமராஜா","en":"சீமராஜா","year":"2018","type":"Фильм","rating":4.6,"votes":12,"poster":"https://image.tmdb