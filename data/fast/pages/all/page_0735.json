otes":1,"poster":"https://image.tmdb.org/t/p/w342/xXsdD4vFcGPU06OiSFtNNDimx5h.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"153626","ru":"Confessions d'un tueur","en":"Confessions d'un tueur","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wQbjNFDvxR3byjhLbjE4iFojEaN.jpg","backdrop":"","genres":["Криминал","Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"115821","ru":"Oyunlar Holding","en":"Oyunlar Holding","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/y1L3pR2SXVXzzQvJpRv3UV3L2JO.jpg","backdrop":"","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1697139","ru":"Мессали Хадж — жизнь, посвященная служению алжирскому народу","en":"Messali Hadj - Une vie au service du peuple algérien","year":"2006","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/cTCkiTuPNxiGD6QlAc0uGaNP76d.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AtUsJjAANPsmAc1hJrk4i7R9ixG.jpg","genres":["Документальный","История"],"overview":"Жизнь и политическая деятельность Мессали Хаджа (1898–1974), алжирского политика-интернационалиста, сыгравшего новаторскую роль в процессе обретения Алжиром независимости, которую он требовал еще в 1927 году. Первоначально он был секретарем Североафриканской Звезды (ENA), затем в 1937 году основал Алжирскую народную партию (PPA), в 1946 году – Движение за триумф демократических свобод (MTLD), и наконец, в 1954 году – Алжирское национальное движение (MNA). В 1937 году руководство Североафриканской Звезды (ENA) создало свой флаг – зеленый с белой звездой и полумесяцем. Жена Мессали Хаджа, Эмили Бускуант-Мессали, просто сшила этот флаг ENA на швейной машине; позже он стал флагом PPA. В 1943 году Мессали Хадж совместно с руководством партии создал флаг ENA-PPA — зелено-белый с красной звездой и полумесяцем, который впоследствии стал нынешним флагом Народной Демократической Республики Алжир.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1354581","ru":"Преследование","en":"Преследование","year":"1989","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/nmhjLs8JXytHpJasdTFMvtqqipU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uCeFgP3uNb5HnbVLKIBHNDyPmMk.jpg","genres":["История","Драма"],"overview":"Молодой писатель в поисках материала встречает вора, который берёт его под своё крыло.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}