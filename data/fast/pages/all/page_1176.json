ьки, обидевшись на неё и папу за испорченный чертёж и сломанные часы, уезжает в город, а когда вернется – не знает. Папа решает, что они с Маруськой тоже уедут куда глаза глядят. Но девочке не хочется покидать свой дом и маму. И, чтобы потянуть время, она начинает рассказывать папе сказку про то, как мама, еще маленькой девочкой, ради его спасения отправилась в приключение в прошлое, где пережила страшные опасности и встретила удивительных людей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"288403","ru":"스케치","en":"스케치","year":"2014","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/OutRYtkfFM6cQ9yP3RFHfz6z3v.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xW8We0RCFrTXzkpYD0SIJ2NCZ5R.jpg","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1005349","ru":"プロゴルファー猿 甲賀秘境! 影の忍法ゴルファー参上!","en":"プロゴルファー猿 甲賀秘境! 影の忍法ゴルファー参上!","year":"1987","type":"Мультфильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rXtvF0TQmPFCoAjL12Lv2CHCdNh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9vV81NOYiy97KNsk078xYXun1iN.jpg","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"542146","ru":"ගෝල්","en":"ගෝල්","year":"2018","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/i1xGMVRTQDas1fQDGCx9mmFNMnL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5khLIwCBGzTePSgVoTv5gOY8sHx.jpg","genres":["Драма","Семейный","Музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"542804","ru":"いつも月夜に米の飯","en":"いつも月夜に米の飯","year":"2018","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/pBwcnpZ3IdvefCCmNGaOQuXe77p.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pZu4HN786j2g7eI5DiOnu2kXYGp.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{