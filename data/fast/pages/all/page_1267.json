6avHUc7SfBxs3ffpHM7NTxq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5vuQngaGz3wIYgS2D2BpaFAkInW.jpg","genres":["Драма","Боевик"],"overview":"На сцене, где должна была пройти премьера мюзикла, разыгралась драма… Люди шли на праздник — веселый, яркий, а оказались лицом к лицу со смертью. Они, ставшие заложниками, сумевшие пройти страшное испытание, сохранив человеческое достоинство и мужество — обычные люди, ставшие героями…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"8015","ru":"Kaahin Kissii Roz","en":"Kaahin Kissii Roz","year":"2001","type":"Сериал","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/wnh9nTy5V3VNZhXAq0bZEwnt7Zb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cIVjS9OLqsn8rZFmQovr4Hy7dzV.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"882178","ru":"Not Me","en":"Not Me","year":"2018","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/a5DnFbQArwzTYyuwRPEsbwvKE63.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5bqdqLNL1FzcFoDb16Gch6LWkpE.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"369545","ru":"Counter Clockwise","en":"Counter Clockwise","year":"2016","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/dRsCfjxT9t8bUtiIa15hdn3YVcw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/i6PRd0WQNjerjskBO6HIfHd8mZn.jpg","genres":["Комедия","Фантастика","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"579557","ru":"齐天大圣之大闹龙宫","en":"齐天大圣之大闹龙宫","year":"2019","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/yhnAxUvUCIk1DGb0vIlw5Nvi5sC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9NJso6Gy6ZfVzrXY8HtEJEMuYEM.jpg","genres":["Фэнтези","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"331376","ru":"暴走神探","en":"暴走神探","year":"2015","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/m6BKnWosEjjipDPsyQhr5ZVqOcm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2lVr6cbuPb6eabcWvrdxM9UJQRh.jpg","genres":["Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"635993","ru":"Sova över","en":"Sova över","year":"2018","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/f0UhLq50VAojWRL3SBMqxuzq46C.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4snFKtB2ghs3zqYikSum3CbKW4U.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"485591","ru":"An American in Texas","en":"An American in Texas","year":"2017","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/dnlFsEe9GWibKJOGdSMCb4xUsrR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yYtx6bAuXzVevfLpUFA94zYzTFl.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"163656","ru":"Rick & Steve: The Happiest Gay Couple in All the World","en":"Rick & Steve: The Happiest Gay Couple in All the World","year":"2007","type":"Мультфильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/nx7x8Yi2Xy7MqfEiaEj5GpSIKTQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vMQhd0EgeTWuTdhXAyflCnAPeTM.jpg","genres":["Мультфильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1493663","ru":"Одно Чокнутое Лето","en":"脱缰者也","year":"2025","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/g5Pvbjn5S6KwXlz2nDGMcMF8lOQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/25HqnWqd0cCp8E2rUljqEopC8Cs.jpg","genres":["Комедия","Криминал"],"overview":"Лето 1999 года. Ма Фэй - не самый благополучный молодой человек, в прошлом имевший проблемы с законом, а ныне имеющий проблемы, связанные с наличием больших долгов, не смог придумать лучшего решения своих финансовых проблем, чем похищение сына собственной сестры с целью получения выкупа. Подруга Ма Фэя и его старый приятель по ходу действия становятся невольными участниками «банды похитителей». Далее всё усложняется с появлением одного безбашенного бандита-одиночки, который тоже не прочь поживиться выкупом, а также криминальных элементов, которым Ма Фэй должен деньги и у которых иссякло терпение. Конечно, сестра Ма Фэя и остальные родственники не готовы отдавать деньги горе-похитителю и пытаются всё решить мирно. Но в итоге ситуация совсем выходит из-под контроля, превращаясь в трагикомичный абсурд.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1014024","ru":"Эллиот и волшебный амулет","en":"Wickensburg","year":"2022","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/yjNGUFFtg0n6KzR0lhYsRjLbL79.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cgwazv1PxDcOrLdL8im6bOSX5np.jpg","genres":["Приключения","Семейный"],"overview":"После смерти отца Эллиот с матерью переезжают в мрачный городишко Викенсбург, где мальчик тут же знакомится с Уиллоу, считающей себя ведьмой. Она рассказывает о проклятье, которое было наложено на город более древними ведьмами и о злом колдуне, который по возвращении уничтожит его. Распутывание загадки, связанной с этим проклятьем, приводит детей к новому предприятию в Викенсбурге и его странному владельцу — Хексенмейстеру. Им предстоит узнать, что представляют из себя все эти чары, а также спасти город от надвигающейся угрозы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"681020","ru":"Вокруг смерти","en":"Being Dead","year":"2021","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/6HvEL5dzbv29E7ugQP5xWQyLn3w.jpg","backdrop":"","genres":["Драма"],"overview":"Семейная пара учёных решает поехать на побережье, где они когда-то познакомились, чтобы снова разжечь искру в отношениях. Однако, место, где возникла их любовь станет местом, где их постигнет внезапная смерть.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1249421","ru":"即兴谋杀","en":"即兴谋杀","year":"2025","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ckz0MSMog9RClCL4DsMaEYtO3jO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cwp9pdOdIWAg6RkLXqGZ6bZCVVK.jpg","genres":["Детектив","Триллер","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"924584","ru":"Killer Stepmom","en":"Killer Stepmom","year":"2022","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/lppeS3b54CIzWBgBXjCjMOokask.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zp9Qvodeq5MbmLNNwFqNq0TbLxC.jpg","genres":["Триллер","Телевизионный фильм","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"878057","ru":"Die Heimsuchung","en":"Die Heimsuchung","year":"2021","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/sJ52OvRzeprYHwyuesSyCVK41CC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6p9Nun8NyRaPU1lPRm01MlKMCor.jpg","genres":["Триллер","Криминал","Детектив","Драма","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1078280","ru":"老ナルキソス","en":"老ナルキソス","year":"2023","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/vdAGXKoLDDjRx7Bbsh0AnsnGcOI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yjyTQ6fE8aNy8nSlDWmNCmVLIWv.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1009087","ru":"人でなしの恋","en":"人でなしの恋","year":"2022","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/dcPLO7VUs86E4A5lDIcaZ42ASUv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mCbcXb8ftyOTaAwo1xsEysPmS98.jpg","genres":["Драма","Детектив"],"overview":