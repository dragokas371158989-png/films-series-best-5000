61286","ru":"Девушка-свинка","en":"돼지 같은 여자","year":"2015","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xoo1tMDA8G6fuTBl5vudtECyEJZ.jpg","genres":["комедия","мелодрама"],"overview":"Для небольшой деревеньки, некогда известной чудесной рыбалкой, настали трудные времена. Вылов рыбы значительно уменьшился, жители стали покидать эти края. Чун-соп - единственный оставшийся там холостяк. Три одинокие девушки - Чэ-хва, Ми-джа и Ю-джа - начинают психологическую атаку на потенциального жениха.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"558244","ru":"Последнее испытание","en":"Последнее испытание","year":"2018","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/tMFd6avHUc7SfBxs3ffpHM7NTxq.jpg","genres":["драма","боевик"],"overview":"На сцене, где должна была пройти премьера мюзикла, разыгралась драма… Люди шли на праздник — веселый, яркий, а оказались лицом к лицу со смертью. Они, ставшие заложниками, сумевшие пройти страшное испытание, сохранив человеческое достоинство и мужество — обычные люди, ставшие героями…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"8015","ru":"Kaahin Kissii Roz","en":"Kaahin Kissii Roz","year":"2001","type":"Сериал","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/wnh9nTy5V3VNZhXAq0bZEwnt7Zb.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"882178","ru":"Not Me","en":"Not Me","year":"2018","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/a5DnFbQArwzTYyuwRPEsbwvKE63.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"369545","ru":"Counter Clockwise","en":"Counter Clockwise","year":"2016","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/dRsCfjxT9t8bUtiIa15hdn3YVcw.jpg","genres":["комедия","фантастика","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"579557","ru":"齐天大圣之大闹龙宫","en":"齐天大圣之大闹龙宫","year":"2019","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/yhnAxUvUCIk1DGb0vIlw5Nvi5sC.jpg","genres":["фэнтези","боевик"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"331376","ru":"暴走神探","en":"暴走神探","year":"2015","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/m6BKnWosEjjipDPsyQhr5ZVqOcm.jpg","genres":["криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"635993","ru":"Sova över","en":"Sova över","year":"2018","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/f0UhLq50VAojWRL3SBMqxuzq46C.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"485591","ru":"An American in Texas","en":"An American in Texas","year":"2017","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/dnlFsEe9GWibKJOGdSMCb4xUsrR.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"163656","ru":"Rick & Steve: The Happiest Gay Couple in All the World","en":"Rick & Steve: The Happiest Gay Couple in All the World","year":"2007","type":"Мультфильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/nx7x8Yi2Xy7MqfEiaEj5GpSIKTQ.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1493663","ru":"Одно Чокнутое Лето","en":"脱缰者也","year":"2025","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/g5Pvbjn5S6KwXlz2nDGMcMF8lOQ.jpg","genres":["комедия","криминал"],"overview":"Лето 1999 года. Ма Фэй - не самый благополучный молодой человек, в прошлом имевший проблемы с законом, а ныне имеющий проблемы, связанные с наличием больших долгов, не смог придумать лучшего решения своих финансовых проблем, чем похищение сына собственной сестры с целью получения выкупа. Подруга Ма Фэя и его старый приятель по ходу действия становятся невольными участниками «банды похитителей». Далее всё усложняется с появлением одного безбашенного бандита-одиночки, который тоже не прочь поживиться выкупом, а также криминальных элементов, которым Ма Фэй должен деньги и у которых иссякло терпение. Конечно, сестра Ма Фэя и остальные родственники не готовы отдавать деньги горе-похитителю и пытаются всё решить мирно. Но в итоге ситуация совсем выходит из-под контроля, превращаясь в трагикомичный абсурд.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1014024","ru":"Эллиот и волшебный амулет","en":"Wickensburg","year":"2022","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/yjNGUFFtg0n6KzR0lhYsRjLbL79.jpg","genres":["приключения","семейный"],"overview":"После смерти отца Эллиот с матерью переезжают в мрачный городишко Викенсбург, где мальчик тут же знакомится с Уиллоу, считающей себя ведьмой. Она рассказывает о проклятье, которое было наложено на город более древними ведьмами и о злом колдуне, который по возвращении уничтожит его. Распутывание загадки, связанной с этим проклятьем, приводит детей к новому предприятию в Викенсбурге и его странному владельцу — Хексенмейстеру. Им предстоит узнать, что представляют из себя все эти чары, а также спасти город от надвигающейся угрозы.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"681020","ru":"Вокруг смерти","en":"Being Dead","year":"2021","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/6HvEL5dzbv29E7ugQP5xWQyLn3w.jpg","genres":["драма"],"overview":"Семейная пара учёных решает поехать на побережье, где они когда-то познакомились, чтобы снова разжечь искру в отношениях. Однако, место, где возникла их любовь станет местом, где их постигнет внезапная смерть.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1249421","ru":"即兴谋杀","en":"即兴谋杀","year":"2025","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ckz0MSMog9RClCL4DsMaEYtO3jO.jpg","genres":["детектив","триллер","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"924584","ru":"Killer Stepmom","en":"Killer Stepmom","year":"2022","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/lppeS3b54CIzWBgBXjCjMOokask.jpg","genres":["триллер","телевизионный фильм","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"878057","ru":"Die Heimsuchung","en":"Die Heimsuchung","year":"2021","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/sJ52OvRzeprYHwyuesSyCVK41CC.jpg","genres":["триллер","криминал","детектив","драма","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1078280","ru":"老ナルキソス","en":"老ナルキソス","year":"2023","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/vdAGXKoLDDjRx7Bbsh0AnsnGcOI.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1009087","ru":"人でなしの恋","en":"人でなしの恋","year":"2022","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/dcPLO7VUs86E4A5lDIcaZ42ASUv.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","coun