ttps://image.tmdb.org/t/p/w342/9OLR7N0CoHFDhoe3079Lp44KZln.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"292115","ru":"绿林大冒险","en":"绿林大冒险","year":"2013","type":"Мультфильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/wFKeUlodyXNwPenqrsKU1pYQe9B.jpg","genres":["приключения","мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"448783","ru":"Badsville","en":"Badsville","year":"2017","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/41xMf5Wo3WrxlcxSMK2WYnacNHK.jpg","genres":["мелодрама","боевик","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"378442","ru":"Notfilm","en":"Notfilm","year":"2015","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/3Y8ulRCR1kZRh4aZ9uHqWprgoRP.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"296851","ru":"SI-VIS: The Sound of Heroes","en":"SI-VIS: The Sound of Heroes","year":"2025","type":"Аниме","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fbssiB7q1Ek7pcG2W6AWi2UIJdk.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"504503","ru":"Остров возрождения","en":"Остров возрождения","year":"2024","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/ztV8U2dQbVKHyQFSK4c1ehiYnKT.jpg","genres":["боевик","триллер"],"overview":"Лето 1992-го, засекреченный полигон «Бархан» в Аральском море. Полковник Даутов, рискуя жизнью, спасает загадочную женщину с терпящего бедствие судна и оказывается втянут в опасную игру, где прошлое советской науки, перемены новой эпохи и тайны самого острова сливаются в единое целое. Чем дальше он идёт в своём расследовании происходящего, тем ближе к грани между реальностью и тем, что её искажает.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1545652","ru":"Красная маска. Настольная книга супергероя","en":"Handbok för superhjältar","year":"2025","type":"Мультфильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/ujB2hBfgLrALnTHFlON2OcuutbM.jpg","genres":["мультфильм","приключения","семейный"],"overview":"Десятилетняя Лиза переезжает в новый город и сталкивается с травлей одноклассников. Однажды, спасаясь от обидчиков в библиотеке, она находит самую необычную книгу в своей жизни — «Настольную книгу супергероя». В ней говорится, что у каждого есть потенциал и 101 суперспособность можно развить самостоятельно. Воодушевлённая Лиза начинает упорно тренироваться и достигает впечатляющих результатов. Теперь девушка может помогать тем, кто попал в беду. Надев Красную маску, она встаёт на защиту города.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"949425","ru":"Двое мужчин на войне","en":"Two Men at War","year":"2022","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/75IjDujrlhhSZgo8bZ7GKP79iri.jpg","genres":["документальный","история"],"overview":"Пока бушует война между Россией и Украиной, этот документальный фильм Джорджа Стефанопулоса приоткрывает завесу над возвышением двух мужчин в центре — президента России Владимира Путина и президента Украины Владимира Зеленского.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"783880","ru":"Однажды в Техасе","en":"Death in Texas","year":"2022","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dg7T1HlCXeonyNN9NQB5jgwBPGG.jpg","genres":["криминал","драма","боевик"],"overview":"После семи лет заключения Билли Уокер наконец-то выходит из тюрьмы. Дома он узнает, что его мать смертельно больна. Врачи говорят, что жить ей осталось совсем немного и найти донора в такие короткие сроки будет трудно. Билли решает взять ситуацию в свои руки и готов на все, чтобы спасти свою мать. Но для бывшего заключенного есть только один способ быстро найти деньги.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"865930","ru":"Решающие моменты","en":"Defining Moments","year":"2021","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/aFQTykJSTLzZwqVq7WC99oyz8Rq.jpg","genres":["комедия","драма"],"overview":"Фильм рассказывает о переплетающихся историях, в которых решающие моменты изменили жизнь героев раз и навсегда.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"756806","ru":"Панда против пришельцев. План спасения Земли","en":"Panda vs. Aliens","year":"2021","type":"Мультфильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/zfNaILCLnXXJfQPatgC815qaVWp.jpg","genres":["мультфильм","комедия","семейный","фантастика"],"overview":"Что делать, если противный сиреневый пришелец хочет уничтожить твою планету, а на тебя возлагают надежды по ее спасению? Как всем объяснить, что ты всего лишь супергерой из популярного телешоу? Ответ один — никак! Придется собрать волю в пушистый кулак, отбросить все панда-страхи, завести единомышленника в клане врага и разработать план по спасению планеты.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"126544","ru":"萌探探探案","en":"萌探探探案","year":"2021","type":"Сериал","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/epoCnqVnMqohtKnf8QiT1eGaV9A.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"119099","ru":"锦心似玉","en":"锦心似玉","year":"2021","type":"Сериал","rating"