о увлекается играми и игнорирует просьбы родителей помочь по дому и выполнить школьные летние задания. Отец наказывает дочь и конфискует её игровые устройства до начала учебного года. Девочка очень огорчается и перед сном загадывает желание: «Играть всегда без всяких лимитов!». Утром оно сбывается — девочка оказывается внутри игры. Сначала ей всё нравится, но, столкнувшись с трудностями, Злата приходит к выводу, что играть 24 часа напролёт не так приятно, как ей представлялось. Она решает вернуться домой, но это оказывается совсем не просто.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1707985","ru":"Sophie Passmann: Pick Me Girls","en":"Sophie Passmann: Pick Me Girls","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/wq6ReVaOlBPHJvHl34ebUNDvi0B.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1705141","ru":"Sobras de Arte: Estou-Me Nas Tintas","en":"Sobras de Arte: Estou-Me Nas Tintas","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/jT1CUXWDi3W3zsfoc8M8zWMPGfl.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1688667","ru":"INDEPENDIENTE","en":"INDEPENDIENTE","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/jZq7oJsORi2ECxNw60PBUz1aNdc.jpg","genres":["документальный","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1608471","ru":"バカンスは始まったばかり","en":"バカンスは始まったばかり","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/woJRbFkdFtZF5bokq74O2UNB0mW.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1479017"