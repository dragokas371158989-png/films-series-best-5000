es":"","studio":"","country":"","ageRating":""},{"id":"584971","ru":"Party Wagon","en":"Party Wagon","year":"2004","type":"Мультфильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qWOVV7IRNAhP8yVwlyDbAW8M7N5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rQCo8vGkldmYLBNp66OBSt3JnDx.jpg","genres":["Вестерн","Мультфильм","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"703527","ru":"Мобильный Доспех Гандам: Притяжение к Фронту","en":"機動戦士ガンダム MS IGLOO 2 重力戦線","year":"2008","type":"Мультфильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wPlnUwRzhaUabjeS5UjQYSxxwt5.jpg","backdrop":"","genres":["Военный","Мультфильм","Фантастика","Боевик"],"overview":"Вследствие перенаселённости Земли человечество совершило бросок в космос и создало гигантские колонии под названием «Стороны». Спустя годы одна из них, Сторона-3, желая отделиться от Земли, объявила метрополии войну. Провозгласив себя Герцогством Зион, мятежники предприняли массированное наступление. Земляне постепенно сдавали позиции...Этот ОВА-цикл продолжает повествование об Однолетней войне. Новые события, новые герои. IGLOO раскрывает сломанные судьбы простых солдат, участников этого конфликта. Сюжет полон драматизма и пафоса.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"626289","ru":"O Filho do Homem","en":"O Filho do Homem","year":"2019","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/o8X5UcK3rehyxmslzjJuGT9xjWu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jLybhKh0wS0LNQBufvV1VokAMNM.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"579794","ru":"玩轉全家福","en":"玩轉全家福","year":"2019","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lKRVXlb0Rqlb4ovVJg0OBJD4wSC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uP55qqlSBr0smol70JjgoI0CHx9.jpg","genres":[