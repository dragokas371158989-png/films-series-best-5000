ая и робкая девочка со множеством комплексов. Ей трудно заводить новые знакомства, поэтому единственное, чего она желает, возвращаясь в школу после почти полугодового отсутствия из-за аварии, — это не привлекать к себе внимания. Но как это возможно, если в первый же день на неё обращает внимание любимчик класса Юшин Хиросэ, вокруг которого всегда толпятся одноклассники? Хиёри пытается справиться со своей неуверенностью, завести новых друзей и, возможно, даже найти любовь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"397469","ru":"새폴더 2","en":"새폴더 2","year":"2015","type":"Фильм","rating":5.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/tAp9J9WhZSY0zGhq0D9ufk1zj9p.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315587","ru":"Altersglühen - Speed Dating für Senioren","en":"Altersglühen - Speed Dating für Senioren","year":"2014","type":"Фильм","rating":5.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/eqtA01RKOhq7A97TYvYpVC9vCQL.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"510656","ru":"Softness of Bodies","en":"Softness of Bodies","year":"2018","type":"Фильм","rating":5.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/vGEdtG6j2qZwuxEFFTwXYMp8LVA.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1500522","ru":"缉盗","en":"缉盗","year":"2025","type":"Фильм","rating":5.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ui5Ujx256vAI5JbXzeTGVwMkVhs.jpg","genres":["криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"774875","ru":"페이섹스","en":"페이섹스","year":"2020","type":"Фильм","rating":5.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/kJunxwx1To88zE9T5TSH6eFAMY8.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":"