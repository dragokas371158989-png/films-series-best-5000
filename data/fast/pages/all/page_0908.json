:"https://image.tmdb.org/t/p/w780/6AAOeb66yBqpz0baQCRdRlOh9Ix.jpg","genres":["НФ и Фэнтези","Боевик и Приключения","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"550104","ru":"Часы ёкаев: Друзья навсегда","en":"映画 妖怪ウォッチ FOREVER FRIENDS","year":"2018","type":"Аниме","rating":8.3,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/9og4mdprkXaFyMtAjWZOCp4nE4f.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wNTUNmA2hRgHf9yAG5vNPfQeAp.jpg","genres":["мультфильм","фэнтези","приключения","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278753","ru":"Angel's Friends - Tra sogno e realtà","en":"Angel's Friends - Tra sogno e realtà","year":"2011","type":"Мультфильм","rating":8.3,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/tCa1XSy5rglNwvzOol9n6jkGoXt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ftAnoxNz7V0obU0z4Gd0vVWXtXV.jpg","genres":["мелодрама","мультфильм","семейный","фэнтези","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"293629","ru":"Истинные чудотворные рыцари","en":"鎧真伝サムライトルーパー","year":"2026","type":"Аниме","rating":8.3,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/gTJXC84z3pq9VxVGjbStvMP0I2g.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wKILy6ADkaCIbfnam27jWWwlzx9.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"Долгожданное продолжение сериала восемьдесят восьмого года! Сюжет перенесёт нас в современную Японию, в район Синдзюку, где пятеро подростков, возомнивших себя супергероями, облачатся в магические самурайские доспехи и отправятся на битву со злом. Используя свои новые способности, они в ожесточенной схватке столкнутся с силами повелителя демонов Араго, который, как всегда, задумал захватить Землю и уничтожить человечество. Смогут ли они сразить главного злодея и наконец закончить то, что началось больше тридцати лет назад, узнаем уже совсем скоро.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"301513","ru":"Завтрашний Джо 2","en":"あしたのジョー 劇場版","year":"1980","type":"Аниме","rating":8.3,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/kQ8VEBK9BX4W5TpaOEoT5XR1erq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xSTOMYyfgKuQHh2vz7wfOC1Rzps.jpg","genres":["боевик","мультфильм","драма","Аниме"],"overview":"После одного весьма трагичного события Джо Ябуки отчаялся и потерял надежду. Пытаясь забыть о прошлом, главный герой покинул тренажерный зал и ушел странствовать, однако его путешествие подошло к концу, когда он встретил Вольфа Канагуши и Горомаки Гондо, которые непреднамеренно мотивировали Джо вернуться. Согласившись, Ябуки вновь становится на путь бокса, но его начинают мучить вопросы, что находятся в самых глубинах души и которые сдерживают юношу. И именно для этого из Венесуэлы прилетает всемирно известный боксер Карлос Ривера — с целью помочь Джо Ябуки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_26815","ru":"こんにちは アン ~Before Green Gables","en":"こんにちは アン ~Before Green Gables","year":"2009","type":"Аниме","rating":8.3,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/Ae24Axetj86vfHXYbd4J0ifIB7d.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2DKAV3xGKM3q6mZteeixZcbT34Z.jpg","genres":["мультфильм","драма","семейный","Детский","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"2681","ru":"Не в центре","en":"Off Centre","year":"2001","type":"Сериал","rating":8.3,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/imDCSdyfz4X1M1mwCQn5BDVRCea.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oWK7UASNRtuPTCJ7r0dcuUuBRJ2.jpg","genres":["комедия","драма"],"overview":"История двух соседей, которые живут в Нью-Йорке и отчаянно стараются подцепить себе девушек погорячее.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"254476","ru":"Подношение соленой рыбы мастеру","en":"献鱼","year":"2025","type":"Сериал","rating":8.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/yzZOdLIZje5nMemv0f7eZccoBmb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7VxcQrVD2POXg29q5wIFOGD7AY7.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1057663","ru":"Budi Pekerti","en":"Budi Pekerti","year":"2023","type":"Фильм","rating":8.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/hHaYrp6kGhe9akB9AVAkMY43mvH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6DXziVYOFVzARM182ywxnledL1f.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"93550","ru":"奇葩说","en":"奇葩说","year":"2014","type":"Сериал","rating":8.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/ppPd6Zs1XPuXZAnPlfB4NkeN6MV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tVZlhyYF5le9MY9Lmgs2uhSOXVi.jpg","genres":["Ток-шоу","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"606278","ru":"Dosed","en":"Dosed","year":"2019","type":"Фильм","rating":8.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/aAdCbyeeXbUU5ixPuQYNYTS33yU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jLEoTUhoGyAYnYK8zGeR4TFR2fZ.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"85219","ru":"Ювенильная песня","en":"少年歌行","year":"2018","type":"Аниме","rating":8.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/A1RbBXzNWzFdIzBv7Z837mUKitH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yoUKQw05KXX2c2WxqWjzJKguzc9.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","Аниме"],"overview":"Существует легенда о таинственном Золотом гробе. Некогда его переправили из храма Холодной воды в храм Девяти драконов. Никто не знает, что в нём находится и кем он был создан, но согласно поверью тот, кто им завладеет, обретёт невиданные власть и могущество. После загадочной гибели настоятеля храма по близлежащим землям прокатываются волнения. Воины из разных кланов сталкиваются в боях и пытаются выяснить, чьё боевое искусство достойно называться самым высоким. Среди этих распрей запретное демоническое учение снова набирает силу. А козлом отпущения за свалившиеся на обитателей этих мест беды избран молодой монах.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1159596","ru":"Мастерская сатаны","en":"Oficina do Diabo","year":"2025","type":"Фильм","rating":8.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/1FLLIBXhSrqtGlmgmKylBeEIOaJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ezd6Z3Hnuauden7jcvhd1L9GPB6.jpg","genres":["драма","семейный"],"overview":"Эта фирма с незапамятных времён сотрудничает с людьми. Её реклама эффективнее всего, ведь она транслируется напрямую в нашу голову. Чей голос мы слышим в минуты душевных терзаний? Кто ведёт нас за руку по пути к успеху? И какую цену придётся за этот успех заплатить?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"67699","ru":"طاش ما طاش","en":"طاش ما طاش","year":"1993","type":"Сериал","rating":8.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/nNN3uCp36v2NjACs6MlWKauBMwL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aop41hxXTvkDKNJR07d1HwJaUo5.jpg","genres":["комедия","драма"],"overview":"Племянники Дональда приезжают к нему на Хэллоуин, и Дональд решает пошутить над ними. Но ведьма Хейзел помогает мальчикам сыграть шутку с самим дядюшкой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"509250","ru":"Тайное царство: Грибы, определившие наш мир","en":"The Kingdom: How Fungi Made Our World","year":"2018","type":"Фильм","rating":8.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/fxa4qCcvDBk2vZ0cOjjtKziIE0k.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t6vT1RPpkOj6vjCRox3XGIPhGec.jpg","genres":["документальный"],"overview":"Всей сушей правит одно скрытое от глаз царство. Царство грибов. Их можно встретить не только в лесу – они повсюду: на наших ногах, в наших легких, чего бы вы не коснулись и куда бы вы не пошли. Окунитесь в мир неизведанных и могучих древних организмов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"2775","ru":"Tenko","en":"Tenko","year":"1981","type":"Сериал","rating":8.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/2bC9zQiRxZOjAPE5f1X8a26joBB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ehHiR1H0YfB5xu2UWmfNgjsVJVS.jpg","genres":["драма","Война и Политика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"402109","ru":"ಗೋಧಿ ಬಣ್ಣ ಸಾಧಾರಣ ಮೈಕಟ್ಟು","en":"ಗೋಧಿ ಬಣ್ಣ ಸಾಧಾರಣ ಮೈಕಟ್ಟು","year":"2016","type":"Фильм","rating":8.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/4dImTMse7PPFGHPG6GQuwDng9fB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3TYRiNp9OasTVzueGzwUhng0MdJ.jpg","genres":["семейный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1094448","ru":"映画プリキュアオールスターズＦ","en":"映画プリキュアオールスターズＦ","year":"2023","type":"Аниме","rating":8.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/lIw2vkZJllnKvp9xuqZI1BaSVqK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dJToQELvOROvyS24ppR7Mf9H14R.jpg","genres":["мультфильм","боевик","приключения","комедия","семейный","фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1208850","ru":"Битва за Лахад-Дату","en":"Takluk: Lahad Datu","year":"2024","type":"Фильм","rating":8.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/pfYm24JuLhrkwXVqzKVRrSIPBRv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aabJPWLPBPnKQguAsCTpw6lloGx.jpg","genres":["военный","история","триллер","боевик","криминал","драма"],"overview":"Фильм снят на основе реальных событий, произошедших в деревне Кампунге Тандуо, Лахад-Дату, когда террористы захватили мирных жителей."