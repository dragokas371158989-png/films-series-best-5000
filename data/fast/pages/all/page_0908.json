nS5tMXMtckAjaj2xemzol4m.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w9jIdhlDrMcW2VcJ7oKFRAuAxpY.jpg","genres":["драма"],"overview":"Спин-офф сериала Овальный кабинет. В центре сюжета история женщины по имени Рут, которая похищает свою маленькую дочь, чтобы присоединиться к темному и преступному религиозному культу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"639999","ru":"Агент Али. Фильм","en":"Ejen Ali: The Movie","year":"2019","type":"Мультфильм","rating":8.3,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/grJC23HwxFefXtNqR0p6PiEbaka.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xx287dW4k7eirA06lJbv9veJpCS.jpg","genres":["мультфильм","боевик","приключения","семейный","фантастика"],"overview":"Волей случая обычный мальчик Али стал суперагентом МСС, секретной службы, которая призвана защищать от внешних угроз город будущего Киберрай. Но теперь Али не единственный, кто может использовать свою связь с суперкомпьютером СИС, — ведь МСС подключила к нему всех своих агентов. Именно в тот момент, когда он стал сомневаться в своей полезности для коллег и агентства, на него выходит незнакомец, который загадочным образом связан с Али. Мальчик начинает собственное расследование, рискуя нарушить все правила МСС.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"6298","ru":"電撃戦隊チェンジマン","en":"電撃戦隊チェンジマン","year":"1985","type":"Сериал","rating":8.3,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/ttqRe8tNaEWCsWic5fM3mWpbfvQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pVKlcytvXdo55AdKR8VjvORgff1.jpg","genres":["Боевик и Приключения","НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"500244","ru":"The Simone Biles Story: Courage to Soar","en":"The Simone Biles Story: Courage to Soar","year":"2018","type":"Фильм","rating":8.3,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/bcvRmSAhK2ObpCAb64JkEaTMhT0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gpZW1Fb8OhHimTv3SIeD2y9qQWF.jpg","genres":["телевизионный фильм","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"106009","ru":"Numberblocks","en":"Numberblocks","year":"2017","type":"Аниме","rating":8.3,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/vt872bR11jYDRSzTSfLuOmb2SMt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/u9H3GJHNxlQwVeyJDxGGD7Uu9iH.jpg","genres":["Детский","мультфильм","семейный","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_29602","ru":"Мэйджор","en":"メジャー","year":"2004","type":"Аниме","rating":8.3,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/nvVfxP9GiWMXct2ZJOXFF4l7dn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ks0KMwgv05PLZW95H8u1zji9BC5.jpg","genres":["мультфильм","Аниме"],"overview":"Сигэхару Хонда — профессиональный бейсболист Высшей лиги. Его сын Горо — с самого раннего детства решил пойти по стопам отца и стать про-бейсболистом. Это произведение Японского мангаки Мицуды Такуи рассказывает нам о спортивных достижениях Горо-куна, о сложных испытаниях, которые выпадают на его плечи и на его команду и как они все вместе их преодолевают.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_69113","ru":"サイボーグ009 THE CYBORG SOLDIER","en":"サイボーグ009 THE CYBORG SOLDIER","year":"2001","type":"Аниме","rating":8.3,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/8O97sHxuMInR50hrBk7MW1v9ti0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/x8T0dcllXzScXpO5jTi1m4letUY.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"32231","ru":"大秦帝国","en":"大秦帝国","year":"2009","type":"Сериал","rating":8.3,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/zfuObpAXqGEI3FCSTsBw3GKRyOE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4NKo41HuTuP0QAypvu2kTJkZIE8.jpg","genres":["драма","Война и Политика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_312474","ru":"Троецарствие Японии","en":"日本三國","year":"2026","type":"Аниме","rating":8.3,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/uZNEv9JvuO0Ye4BVf92QcInMyG1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/seKQ4siIyJZAt3Xubijt5iXfjvA.jpg","genres":["мультфильм","драма","Война и Политика","Аниме"],"overview":"В конце XXI века Япония пережила крах и раскололась на три враждующих государства: Ямато, Буо и Сэйи. В мире, где технологии откатились к эпохе Мэйдзи, а судьбы решаются мечом, юный чиновник Аотэру Мисуми теряет жену из-за произвола властей. Одержимый целью прекратить бесконечное кровопролитие, он решает воссоединить страну. Аотэру не великий воин, но гениальный стратег. Используя лишь острый ум и дар убеждения, он вступает в опасную политическую игру против тиранов и армий. Это масштабная сага о восхождении \"маленького человека\", решившего переписать историю и стать новым объединителем Японии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"74280","ru":"Hey Duggee","en":"Hey Duggee","year":"2014","type":"Аниме","rating":8.3,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/y0r27LkhX6AZNqo2Q5FUYmwi5wz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rLt2ZvpYJ210QcG6AAzcDzoHxzn.jpg","genres":["мультфильм","Детский","семейный","комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"5744","ru":"特捜戦隊デカレンジャー","en":"特捜戦隊デカレンジャー","year":"2004","type":"Сериал","rating":8.3,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/e9lX8WyJJW2gkfhEAGnpb2QD2Nj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hM4CnVs5wW9SI1TQkMTljsHhUE5.jpg","genres":["НФ и Фэнтези","Боевик и Приключения","комедия","Детский"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"261128","ru":"Вишневый янтарь","en":"樱桃琥珀","year":"2025","type":"