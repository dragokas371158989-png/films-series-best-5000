ronk","year":"1975","type":"Сериал","rating":6.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/b7egp54IjnF0EqyBGGvpVLJQFTG.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"11640","ru":"Bull","en":"Bull","year":"2000","type":"Сериал","rating":6.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/qOdNaleG0ZWC69hneO9yAxNieZM.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"621930","ru":"Unbridled","en":"Unbridled","year":"2019","type":"Фильм","rating":6.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/prQTSPVyvXTznp7kmDmZku7Ko4L.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"776767","ru":"Jeff Koons","en":"Jeff Koons","year":"2017","type":"Фильм","rating":6.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/pBSoiAYcGF29DOK4Wc0SeeiVnwV.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"213424","ru":"四格勇者","en":"四格勇者","year":"2023","type":"Аниме","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/w1jUw4mGSKpy1PybRfHqnwvM762.jpg","genres":["мультфильм","комедия","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"713171","ru":"間の楔","en":"間の楔","year":"1992","type":"Аниме","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/diuGDzHD0tQp6qeVYPlT6kp0Enj.jpg","genres":["мультфильм","фантастика","мелодрама","драма","Аниме"],"overview":"На планете Амой, в Столице Танагура, находится суперкомпьютер Юпитер, захвативший власть над планетой и управляющий теперь всем. Им была создана новая система. Подавляющая часть населения — мужчины, их положение в обществе определяется цветом волос: от золотого/серебряного — элиты, до тёмно-коричневых и чёрных — полукровки, отбросы общества. Блонди держат у себя пэтов — ручных, молодых юношей и девушек для прислуживания и всяческих сексуальных развлечений. Обычно хозяева довольно однозначно относятся к своим игрушкам и не оставляют их у себя надолго, ведь со временем «вещи» надоедают. Но Ясон Минк относится к Рики иначе и отказывается его отпускать даже после неодобрения Юпитера. Рики борется с Ясоном, с обществом, с собой, ему не дают покоя мысли о прошлом, о его банде и бывшем любовнике Гае, но одержимость Ясона настолько сильна, что Рики никак не решит, что же ему делать.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"51096","ru":"סברי מרנן","en":"סברי מרנן","year":"2011","type":"Аниме","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/dTc3ZShvEXH5hQ5EeKTPDqfcr49.jpg","genres":["комедия","семейный","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"96261","ru":"ナイトウィザード The ANIMATION","en":"ナイトウィザード The ANIMATION","year":"2007","type":"Аниме","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/5FaLaKGGUm9hA7T4ul5xPrTY046.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"301693","ru":"Мошенники","en":"Sahtekarlar","year":"2025","type":"Сериал","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/zgVgcthDQ8pYgBkKzi1AaXmmeFO.jpg","genres":["драма","криминал"],"overview":"Главный герой сериала — юрист Эртан, работающий вместе с отцом Кадиром в семейной юридической фирме. Однажды к нему обращается состоятельный и влиятельный клиент — Хидайет Кутман. Много лет назад тот имел тайный роман, о котором никто не знал, и результатом этой связи стала дочь. Теперь мужчина стремится её разыскать, хотя остаётся загадкой, почему он решил заняться поисками именно сейчас. Эртану предстоит сделать выбор: остаться честным или оказаться втянутым в чужие тайные игры и схемы. Ведь мир, где правят деньги и власть, легко может сломить даже самого принципиального человека. Иногда незнание оказывается спасением, а правда, открытая не вовремя, способна разрушить жизнь — как чужую, так и собственную.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"300926","ru":"Анатомия хаоса","en":"Kaosun Anatomisi","year":"2025","type":"Сериал","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/z8mk1BCFDg6IF625t3mJhat5Cyq.jpg","genres":["криминал","драма"],"overview":"Молодой врач, трудящийся в отделении экстренной помощи, сталкивается с трагедией, которая навсегда меняет его жизнь — при загадочных обстоятельствах погибает его сестра. Постепенно он выясняет, что за её смертью стоит могущественная криминальная структура. В поисках истины он выходит на след одного из самых влиятельных мафиозных лидеров. Их столкновение запускает цепь драматических событий, в которых каждое действие главного героя становится шагом по тонкой грани между стремлением к возмездию и верностью собственным нравственным принципам. Эта внутренняя дилемма оказывается для него самым тяжёлым испытанием.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"298893","ru":"Голые","en":"Naked","year":"2025","type":"Сериал","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/4sALwFbEvQNumPbwHVYiU9NGhe.jpg","genres":["драма"],"overview":"Мария, начинающая учительница, встречает Луиса на карнавальной вечеринке. После того, как они оказываются вместе в постели, она начинает с ним роман, не зная, что он — сексоголик. Когда против него подают официальную жалобу на сексуальное насилие, Мария начинает сомневаться в своих чувствах и роли в отношениях с ним. Столкнувшись с последствиями жалобы, она вынуждена разобраться в сложных вопросах согласия, власти и размытых границ в их отношениях.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1313168","ru":"Всегда возможно","en":"Toujours possible","year":"2025","type":"Фильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/qwklLRMLoCq6StEcLkTjmX1fdoM.jpg","genres":["комедия","мелодрама"],"overview":"В свои 55 биолог Габи теряет работу и решает воплотить мечту: родить ребенка. С её эксцентричной матерью и накопленным опытом она почти находит нужного донора, пока не появляется его отец, 56-летний Пьер.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1645579","ru":"Мы обязательно еще увидимся","en":"I'll Be Seeing You","year":"2026","type":"Фильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bJ9BfopBu8ozKqmQeW7wAOc2fCF.jpg","genres":["мелодрама"],"overview":"Эми — типичная карьеристка из большого города. Получив короткий отпуск она отправляется к своей бабушке Вивьен, живущей на Тихоокеанском побережье. Однако спокойного семейного уик-энда не получается. Просто посреди отдыха Эми получает ультиматум от руководства: либо она срочно находит важного клиента и лично привозит подписанный контракт из Калифорнии, либо о вожделенном повышении в должности патентного аналитика можно забыть. Помимо прочего вместо быстрого перелета Эми оказывается за рулем старого развалюхи-фургона. Вместе с ней в путь напрашивается странная компания. Во-первых, ее непоседливая бабушка Вивьен, которая категорически отказывается оставаться дома. Во-вторых, Сьюзен — острая на язык бабушкина подруга, ищущая приключений. И еще Марк, молодой директор санатория. Обычная рабочая поездка быстро катится кувырком, когда фургон отклоняется от намеченного маршрута. Выясняется, что у Вивиана есть свой тайный план...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"698835","ru":"Кураюкаба","en":"クラユカバ","year":"2024","type":"Мультфильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/3bafF6hd3Hl4tUYY6x1gLoc0bjH.jpg","genres":["мультфильм","драма","детектив"],"overview":"Детектив Сотаро жил и иногда тужил, что заказчики исчезают, не оплатив его услуги, но однажды он узнал, что заказчики в своих исчезновениях не виноваты! Виноват некий преступник, но кто он? Это явление? Человек? В фантастическом городке, укрытом промышленным смогом, похищать людей может и не такое. Детектив берётся за дело, чтобы найти пропавших людей! И расследование заводит его на подземный уровень города, где царят свои законы...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"927868","ru":"Загадочная история города Лунъюнь","en":"龙云镇怪谈","year":"2022","type":"Фильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/qxWXo0kTaTtMCWtZylWHTG4dPvG.jpg","genres":["боевик","фэнтези"],"overview":"История города Лунъюнь полнится загадочными и необъяснимыми событиями двадцатилетней давности. Жители уже было начали забывать о произошедшем, но город потрясла череда жестоких убийств молоденьких девушек. Бывший капитан Линь уговаривает начальника полиции выпустить из заточения опасного преступника Цзи Лянь Ина, чтобы помочь расследованию.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1006024","ru":"Кто остановит дождь","en":"青春並不溫柔","year":"2023","type":"Фильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/4N9Fh8yasuXCnnkV8Hsya1auivE.jpg","genres":["драма"],"overview":"В 1994 году студентка присоединяется к забастовке и встречает настоящую подругу. Она начинает понимать, что протестует не только за свободу, но и за дружбу.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1465277","ru":"Охотник на демонов","en":"猎魂人","year":"2025","type":"Фильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/qrLo7ZtwEbBr1lLYzqHpwiXQQve.jpg","genres":["боевик","приключения","фэнтези"],"overview":"Чтобы спасти свою любимую жену Жо, Лан У Цзи отправился в рискованное путешествие, чтобы сразиться с демонами. Неожиданно он попадает в ловушку даоса Бай Юня и превращается в монстра. В критический момент, когда жизнь Лан У Цзи была под угрозой, душа Жо пробудилась, и они объединили усилия, чтобы победить даоса Байюня. После битвы Жо оставила Лан У Цзи на горе Тяньюй и отправилась в опасное путешествие, чтобы найти способ снять проклятие и избавить его от яда.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"110757","ru":"Παρουσιάστε","en":"Παρουσιάστε","year":"2020","type":"Сериал","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/wxQcNrMPnce7S83tWFQGaSF71pZ.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"251980","ru":"情深不悔，再爱难为","en":"情深不悔，再爱难为","year":"2024","type":"Сериал","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/xJiPe7T8LhbiJnWoH9mCY7HmaY8.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1597535","ru":"Breast Friends Forever","en":"Breast Friends Forever","year":"2026","type":"Фильм","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/yPmDphwliH7vOhYssfX9E9J5qOl.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"277544","ru":"Pour le meilleur et à l'aveugle","en":"Pour le meilleur et à l'aveugle","year":"2025","type":"Сериал","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/fCC9Bs2eMnED7giwomB03Ydb59Y.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"