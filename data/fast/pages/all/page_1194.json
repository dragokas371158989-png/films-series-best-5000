":"","studio":"","country":"","ageRating":""},{"id":"846446","ru":"全員切腹","en":"全員切腹","year":"2021","type":"Фильм","rating":5.8,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/sbjjrrOYKiBlaZDyWVUaaTlZVQk.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"658035","ru":"Новогодний поцелуй","en":"New Year's Kiss","year":"2019","type":"Фильм","rating":5.8,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/qxpT6ddGegB4Lzf9Ks9C2V28sQa.jpg","genres":["телевизионный фильм","мелодрама","комедия"],"overview":"Расставшись с парнем и задумавшись о способности состоять в отношениях, Келли случайно сталкивается на улице с Крисом. Но несмотря на усилия обоих, судьба упорно не позволяет им быть вместе.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1022971","ru":"മധുര മനോഹര മോഹം","en":"മധുര മനോഹര മോഹം","year":"2023","type":"Фильм","rating":5.8,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/ektyuao2iG6NXGCSRVxxNcQkXWZ.jpg","genres":["драма","комедия","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"665568","ru":"Чёрная дева: Глава Q","en":"黒い乙女 Q","year":"2019","type":"Фильм","rating":5.8,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/gJIwP3iuXiWOjx9gkTEucRCvBGo.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"406516","ru":"Jeunesse","en":"Jeunesse","year":"2016","type":"Фильм","rating":5.8,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/6jN4xHFFmFZzosdEMgV3qQd4Pn5.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"678521","ru":"Perdiendo mi virginidad","en":"Perdiendo mi virginidad","year":"2019","type":"Фильм","rating":5.8,"votes":10,"poster":"https://image.tmdb