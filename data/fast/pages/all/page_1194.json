rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/w6aIZIGNlGqTvfRaRG1p2FlBXJl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gz0egUOuOk9EWQEMaFUvKewDKU0.jpg","genres":["Ужасы","Триллер"],"overview":"Ведомая призраком своей дочери, мать, охваченная чувством вины, погружается в безумие, находясь в состоянии наркотической лихорадки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1261148","ru":"Пункт назначения. Новая кровь","en":"AlMarhum","year":"2025","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/4I1uM6c0rKtlFhZse43SbUBHalR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/83xeZxAUzv1AEm74lGx0jdbVMAc.jpg","genres":["Ужасы","Триллер"],"overview":"Трагическая смерть господина Мульванто, отца семейства, во вторник Кливон стала началом бедствия для семьи Нури. Говорят, что тот, кто умрет в этот день, пригласит членов своей семьи умереть вместе. Поэтому оставшимся членам семьи было предложено пройти ряд ритуалов, чтобы предотвратить это.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1336762","ru":"打黑","en":"打黑","year":"2024","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/vqzoZS7Sr2SZ5hDbkZV5VG892JZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8AaD80uGeoRoeNuZ2EMd9C6PYLD.jpg","genres":["Боевик","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1039376","ru":"유포자들","en":"유포자들","year":"2022","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/yc3O913QYEz87eeKqOyrlLc31vD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jmJf3GTe7k28pllggcNGziLiClw.jpg","genres":["Триллер","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"808159","ru":"Bisping","en":"Bisping","year":"2021","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/tybqRPpxnaoQiCxFmy3Yz3GoOub.jpg","