7BZzrI3tOB15cZN1qjbMG.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"745960","ru":"Secret Life of a Celebrity Surrogate","en":"Secret Life of a Celebrity Surrogate","year":"2020","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/oADjAYL0TsPDQbgXy1q2ZUtKTbb.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"310759","ru":"La preside","en":"La preside","year":"2026","type":"Сериал","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/6IPH7WaQjMnwZBL9g4IwvOBjdD1.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"208053","ru":"Городок","en":"Городок","year":"1993","type":"Сериал","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/uyxmixyqnTf4LDtLQH5iay70YfF.jpg","genres":["комедия"],"overview":"Если бы инопланетяне спросили «Какие вы, россияне?», можно было бы им смело дать кассету с программой «Городок», и они увидели бы, что мы очень разные — умные и не очень, трезвые и не совсем, добрые и злые, смешные и веселые. Впервые жители «Городка» встретились со зрителями на телеканале «Россия» весной 1993 года. Бессменными авторами, а также исполнителями ролей всех персонажей, населяющих «Городок», являются Илья Олейников и Юрий Стоянов. Создатели программы избрали для себя жанр «маленького кино» на телевизионном экране. В «Городке» превращаются в фарс самые уродливые явления нашей жизни. Доводя их до абсурда, ведущие заставляют телезрителя смеяться над собой. «Что сделалось смешным, не может быть опасным»!","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"579663","ru":"История любви из параллельного мира","en":"パラレルワールド・ラブストーリー","year":"2019","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/kgllWBNb2xzv8Xirt7HErDFyJMg.jpg","genres":["детектив","мелодрама","фэнтези"],"overview":"Окончание университета знаменуется поисками работы. Такая участь не миновала Цуругу Такаси и Миву Томохико. Друзьям достаются места в компании, где осуществляют исследования мозга. В жизни Томохино появляется девушка, и он решает познакомить с ней своего друга. Такаси при виде Цуно Маюко отмечает, что во время учебы, он видел её много раз в поезде. К тому же она вызывала у него симпатию. Когда Цуруга проснулся, увидел готовившую завтрак Цуно Маюко. С момента знакомства все они стали жить вместе. Томохико в скором времени попросту исчез, а Такаси приходится задаваться вопросом, что же реально, а что - нет.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"31141","ru":"Воскрешение ниндзя","en":"魔界転生","year":"1997","type":"Мультфильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/xgdJ7fXy7h4Yf92MCfDepMYglTH.jpg","genres":["мультфильм","приключения","фантастика","фэнтези","история","ужасы"],"overview":"Япония, 1614 год. Сегунат Токугава объявляет христианскую религию вне закона и жестоко расправляется с немногими японскими христианами. Горстка выживших верит в пророчество о спасении. Следуя этому пророчеству, будет рождено Божественное Дитя, которое избавит правоверных от врагов и напастей. Но также сказано, что если спаситель оступится, то переродится Сатаной. Против власти Сегуна выступает Сиро Амакуса, и христиане считают его долгожданным спасителем. Но в темных чертогах вершится кровавое предательство, осуществляется самая жуткая часть пророчества…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"377495","ru":"Доктор Проктор и его машина времени","en":"Doktor Proktors tidsbadekar","year":"2015","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/t1fXQbQ3UhsW8omwuhiu0d6LrvE.jpg","genres":["приключения","семейный","фэнтези","комедия"],"overview":"Страдающий от несчастной любви Доктор Проктор отправляется назад во времени и отчаянно пытается изменить историю. Он хочет расстроить свадьбу своей возлюбленной Джульетты и ужасного Клода Клише, но попадает в ловушку. Лизе и Булле, юным помощникам и соседям доктора, приходится вступить в игру...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"498419","ru":"臥底巨星","en":"臥底巨星","year":"2018","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/4G8u6BebH7CWAng6oB0xH6J2lvd.jpg","genres":["боевик","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"305396","ru":"ガルフォース2 ディストラクション","en":"ガルフォース2 ディストラクション","year":"1987","type":"Мультфильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/52JSwAqgHfrpQ8S5RgQB4hZAD9q.jpg","genres":["боевик","мультфильм","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"601204","ru":"Bellbird","en":"Bellbird","year":"2019","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/pu0oJaERGaKA3KihcnS9umuSz7j.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}