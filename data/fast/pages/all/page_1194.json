5yjLdSxv5BYUz2HSv.jpg","genres":["Телевизионный фильм","Комедия","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"856396","ru":"I nostri fantasmi","en":"I nostri fantasmi","year":"2021","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/w5IJnU7BZzrI3tOB15cZN1qjbMG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fgukbYXbkTFTj6DfO6uiSDUbcX7.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"745960","ru":"Secret Life of a Celebrity Surrogate","en":"Secret Life of a Celebrity Surrogate","year":"2020","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/oADjAYL0TsPDQbgXy1q2ZUtKTbb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k3wCqeb1zGgSV0xbZh32gRU6l0p.jpg","genres":["Триллер","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"310759","ru":"La preside","en":"La preside","year":"2026","type":"Сериал","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/6IPH7WaQjMnwZBL9g4IwvOBjdD1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pVW032NvvX3uCLc77t4REHTTPfp.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"208053","ru":"Городок","en":"Городок","year":"1993","type":"Сериал","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/uyxmixyqnTf4LDtLQH5iay70YfF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1RCmOdH3eR0zpGXvWURhWSo5MQl.jpg","genres":["Комедия"],"overview":"Если бы инопланетяне спросили «Какие вы, россияне?», можно было бы им смело дать кассету с программой «Городок», и они увидели бы, что мы очень разные — умные и не очень, трезвые и не совсем, добрые и злые, смешные и веселые. Впервые жители «Городка» встретились со зрителями на телеканале «Россия» весной 1993 года. Бессменными авторами, а также исполнителями ролей всех персонажей, населяющих «Городок», являются Илья Олейников и Юрий Стоянов. Создатели программы избрали для себя жанр «маленького кино» на телевизионном экране. В «Городке» превращаются в фарс самые уродливые явления нашей жизни. Доводя их до абсурда, ведущие заставляют телезрителя смеяться над собой. «Что сделалось смешным, не может быть опасным»!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}