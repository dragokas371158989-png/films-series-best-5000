ый мир, где человеческий разум в неправильных руках может оказаться взрывоопасным.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"4897","ru":"Kasamh Se","en":"Kasamh Se","year":"2006","type":"Сериал","rating":2.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/a8MQs8tAeA8SXToANt2pHBhoNU0.jpg","genres":["драма","Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"737077","ru":"背徳の海 情炎に溺れて","en":"背徳の海 情炎に溺れて","year":"2014","type":"Фильм","rating":2.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/fIOi7ayd5WOGbM95IHZYRlBPMQ8.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"647941","ru":"Unas Ruinas","en":"Unas Ruinas","year":"2019","type":"Фильм","rating":2.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/iwzzVCjv7bRJIjz4zW17pqXhphx.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"528870","ru":"A Sombra Interior","en":"A Sombra Interior","year":"2018","type":"Фильм","rating":2.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/27XxXRukBzi0o2Y2dAKI698dAOM.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"780292","ru":"妻の秘蜜〜夕暮れてなお〜","en":"妻の秘蜜〜夕暮れてなお〜","year":"2016","type":"Фильм","rating":2.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/zeQhSnMvwXH8Rmdq6CtvO8Dm3Vt.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"927665","ru":"シンデレラ エクスプレス","en":"シンデレラ エクスプレス","year":"1989","type":"Мультфильм","rating":2.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/vfTRIB8FGuN1uTWpTv9uwTBZ7Vu.jpg","genres":["мультфильм","комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"647537","ru":"Vamp","en":"Vamp","year":"2019","type":"Фильм","rating":2.0,"votes":