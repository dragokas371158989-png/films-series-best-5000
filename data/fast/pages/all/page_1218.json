age.tmdb.org/t/p/w342/dxiyNtE3Z3r6uMYPaYZUEpZJKEj.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"326035","ru":"На съёмках 'Клерков'","en":"Shooting Clerks","year":"2016","type":"Фильм","rating":5.6,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/yCguRDonxxYJMj5bxqSswDhNVsw.jpg","genres":["комедия","драма"],"overview":"Биографическая история о 23-летнем продавце Кевине Смите, задумавшем снять независимую комедию о супермаркете. С трудом собрав мизерный бюджет и группу актеров-любителей, Кевин сделал мировой хит, давший старт его долгой кинокарьере.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"370785","ru":"Le Garagiste","en":"Le Garagiste","year":"2015","type":"Фильм","rating":5.6,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ztx6fzEpBwCWhGNr0WEuB81oBKh.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"365970","ru":"극장판 프리파라 모두 모여라! 프리즘☆투어즈","en":"극장판 프리파라 모두 모여라! 프리즘☆투어즈","year":"2015","type":"Мультфильм","rating":5.6,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/t54bfmvslcSs99tlx0gxeSNBAqH.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"281230","ru":"Форт МакКой","en":"Fort McCoy","year":"2014","type":"Фильм","rating":5.6,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/4ok9jMdmjQUKtuTNwX0w0My9wib.jpg","genres":["военный","драма","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"492181","ru":"1921","en":"1921","year":"2018","type":"Фильм","rating":5.5,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/lEOwlojOgtbfdFrMANVwVohOqyY.jpg","genres":["триллер","ужасы"],"overview":"Для молодого парня, в ленте ужасов 1921 жизнь в большом и современном Лондоне, где он жил уже на протяжении последних десятилетий, и встреча с таинственной и прекрасной незнакомкой, в которую он влюбился с первой минуты, стала настоящей неожиданностью. Ведь герой, все время считал, что он может контролировать свои чувства и эмоции. Тем более имея за плечами прекрасное образование, и великолепное воспитание, учитывая, что парень относился к тем мужчинам, с которыми мечтали бы встречаться самые именитые и богатые женщины из высшего сословия, он ни как не ожидал такого в своей судьбе. И эта неожиданная встреча с юной красавицей, полностью перечеркнула все его представления о своем предназначении. С той минуты, герой не находит себе место, постоянно возвращаясь в тот сквер, где он впервые осознал, что ради этой юной девы, он согласен принять любые испытания, лишь бы вновь лицезреть ее милую улыбку и вновь услышать чарующий и манящий голос, который он запомнит на всю оставшуюся жизнь...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1190150","ru":"Двуличный","en":"Kane","year":"2023","type":"Фильм","rating":5.5,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/bNJE3uAxc6DBPpN6djFHvVfEfux.jpg","genres":["криминал","драма","триллер"],"overview":"В австралийском городе Брисбене живет опасный преступник по имени Эйб, который ведет ожесточенную борьбу с бандой, возглавляемой неким Фрэнки. Эйб страдает диссоциативным расстройством личности, и эта особенность придает его деятельности коварность и непредсказуемость. Вторая личность, известная как Кейн, отличается крайней агрессивностью и повышенной возбудимостью. В ближайшие сутки градус конфликта накалится до предела, и это приведет к поистине разрушительным последствиям. Для врагов Эйба настало страшное время — живыми после схватки с Кейном выберутся не все.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"868660","ru":"గుంటూరు కారం","en":"గుంటూరు కారం","year":"2024","type":"Фильм","rating":5.5,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/qvBt4YLy274ZmoMAfVlwmHkjVkq.jpg","genres":["боевик","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"936385","ru":"Серая мгла","en":"Silver Haze","year":"2023","type":"Фильм","rating":5.5,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/3kKRgx31DoqOuAcG2yPKERmWFE5.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"604195","ru":"Фактор Зои","en":"The Zoya Factor","year":"2019","type":"Фильм","rating":5.5,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/ytLpoqycSAhMo5W7eHJyCXn8E2n.jpg","genres":["мелодрама"],"overview":"Взбалмошная копирайтер рекламного агентства невольно убеждает игроков команды сборной Индии по крикету, что она их счастливый талисман, что очень не нравится их избегающему все виды суеверий капитану.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"293880","ru":"Hollidaysburg","en":"Hollidaysburg","year":"2014","type":"Фильм","rating":5.5,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/uTnofanIkLbRQMDbfVbs17bguOh.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"73041","ru":"Готовим вместе с Биллом","en":"Cooking with Bill","year":"2017","type":"Сериал","rating":5.5,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/v3t2sP7g5HCfmXPZMSJiQUxNlEB.jpg","genres":["комедия"],"overview":"В короткометражке продают различного рода кухонные приборы \"Нового поколения\", например электрический ножичек, созданный явно на потеху любителям слэшеров. Основа из бензопилы, куча дополнительных лезвий, торчащих во все стороны... Казалось бы, что могло пойти не так, да? Серия короткометражек Cooking With Bill, выполненная в стиле VHS и наполненная очевидным черным юмором.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1274837","ru":"Миллион","en":"Le Million","year":"2025","type":"Фильм","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/u9OdrWDhUUod0v9eqrVszAEpMl0.jpg","genres":["комедия","криминал"],"overview":"Главный герой — менеджер строительства, которого несправедливо уволил тиран-генеральный директор. Он решает украсть 1 млн евро из сейфа компании. Но когда узнает, что на самом деле ему готовили повышение, приходится исправлять свою ошибку.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"126326","ru":"Американский карантин Бората и разоблачение Бората","en":"Borat's American Lockdown & Debunking Borat","year":"2021","type":"Сериал","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/flEQeImhhciXu77EKMnR7LEVswx.jpg","genres":["комедия","Реалити-шоу"],"overview":"Погрузитесь в реальную драму Саши Барона Коэна в образе Бората Сагдиева, когда он проводит пять дней с двумя сторонниками теорий заговора на пике пандемии Covid-19. В \"Разоблачение Бората\" ведущие мировые эксперты доказывают сторонникам теорий заговора несостоятельность этих теорий.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"105465","ru":"Homemade","en":"Homemade","year":"2020","type":"Сериал","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/26GU1SxoQ70jTdLxje0spWjRo0V.jpg","genres":["драма","документальный","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"838594","ru":"Devil's Island","en":"Devil's Island","year":"2021","type":"Фильм","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/eVamYkW77fGAv2GyFiGYehqj5Ne.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"80794","ru":"Дочь тьмы","en":"滅門慘案之孽殺","year":"1993","type":"Фильм","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/oTKI3V3ohM4cJ4nrbcFJ37OC8qY.jpg","genres":["триллер","ужасы","комедия"],"overview":"В небольшом китайском городе произошло ужасное преступление — убита вся семья, кроме младшей дочери. Ответственному за расследование полицейскому детективу кажется, что тут что‑то не так, хотя у выжившей есть железное алиби.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"327317","ru":"Провокация","en":"Provocazione","year":"1988","type":"Фильм","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/5xryGDSx1fImQbD0Z9BIXCSXftJ.jpg","genres":["драма"],"overview":"В фильме описывается история очень богатой вдовы и ее падчериц. Ванесса, так звали вдову, решила нанять для своих названных дочерей репетитора. И остановила свой выбор на старом знакомом профессоре. Но не прошло много времени, как обычные отношения переросли в сексуальные. Но каково было удивление Ванессы, когда она узнала, что падчерицы тоже «положили глаз» на репетитора.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"399912","ru":"Приготовиться к удару","en":"Brace for Impact","year":"2016","type":"Фильм","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/p5d0yjCZOYB1bQFrgisQEwSfOOM.jpg","genres":["триллер","телевизионный фильм"],"overview":"Когда брат опального следователя Софии Гилхрист погибает в авиакатастрофе, София разрывает протокол и тайно начинает расследование аварии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"414181","ru":"Видеоман","en":"Videomannen","year":"2018","type":"Фильм","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/lCrNhNrZsDZLOAWl5uaK7mANpzx.jpg","genres":["триллер","комедия","драма"],"overview":"В руки коллекционера видеокассет случайно попадает ценный и очень редкий фильм, продав который он сможет решить все свои финансовые проблемы и исполнить давнюю мечту. Вот только кассету воруют прямо из дома и ему приходится искать её по всему городу. Женщина, живущая воспоминаниями о восьмидесятых и страдающая алкоголизмом, постоянно терпит унижения от коллег и руководства на работе, а также пытается наладить отношения с дочерью.Смогут ли два человека, оказавшиеся на обочине жизни, вместе решить все проблемы и изменить судьбы друг друга раз и навсегда?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"66211","ru":"Продолжение следует","en":"투 비 컨티뉴드","year":"2015","type":"Сериал","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/mVeiZaw8bd7om7rSh6NP2xydHN6.jpg","genres":["драма","комедия","НФ и Фэнтези"],"overview":"Романтическая драма для подростков расскажет об айдол-группе, которой неожиданно удается вернуться в прошлое. Арин (Ким Сэ Рон) сыграет ключевую роль в этом возвращении, предоставив парням еще один шанс для успешного дебюта.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"230714","ru":"Quando Eu Era Vivo","en":"Quando Eu Era Vivo","year":"2014","type":"Фильм","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/uIshSnMDLB2IqHlpIAZALwyA9Gc.jpg","genres":["триллер","ужасы","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"285848","ru":"Félix et Meira","en":"Félix et Meira","year":"2015","type":"Фильм","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/ltuJiG2vMK2s4R0ma2LGIho9WeG.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}