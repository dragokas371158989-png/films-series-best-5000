votes":11,"poster":"https://image.tmdb.org/t/p/w342/b5LSrN3pfK2usxKZO3Fu3TCu0GM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zTBTZvs417NsVDZyjJeM6bVRk0t.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"572680","ru":"ഇരുപത്തിയൊന്നാം നൂറ്റാണ്ട്","en":"ഇരുപത്തിയൊന്നാം നൂറ്റാണ്ട്","year":"2019","type":"Фильм","rating":3.7,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/7URrg8LPWUtKSwnmIbLz9q6X9Qm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1GgBjPULXL7q7svfHB4AIeHzUVL.jpg","genres":["боевик","приключения","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"623962","ru":"Великий герцог Корсики","en":"The Grand Duke Of Corsica","year":"2021","type":"Фильм","rating":3.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/hQuu74RtR8pC48Mf1xWRMnhh9F0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wmhAGXyjUUfE4rnW6lX5eYV4bvJ.jpg","genres":["комедия","драма","приключения"],"overview":"В 1221 году молодой парень находится на пути к становлению Франциском Ассизским. Тысячу лет спустя архитектор должен построить мавзолей для умирающего миллиардера. Разделенные веками, жизни этих мужчин навсегда изменятся вследствие пандемии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"551918","ru":"Шангри-Ла: На грани вымирания","en":"Shangri-La: Near Extinction","year":"2018","type":"Фильм","rating":3.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/ZSoqFDcQP01J5iM6abemnSlWFl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aZdntzD3mUYrvOEUcFVJn8MYGCS.jpg","genres":["фантастика"],"overview":"На Земле происходит апокалипсис, в результате которого погибают практически все люди. Большинство из них умирают от чумы или холода, который вызвали искусственно, чтобы победить болезнь. Выжившие под предводительством Варгаса находятся в поисках единственного безопасного места на планете — Шангри-лы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"16622","ru":"Кружка пива","en":"Un bon bock","year":"","type":"Мультфильм","rating":3.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/osv0TcCymlsOucqkZBssSuS4tD.jpg","backdrop":"","genres":["мультфильм"],"overview":"«Кружка пива» — немой короткометражный мультфильм режиссёра Эмиля Рейно. Мультфильм состоит из 700 раскрашенных вручную сцен.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"757895","ru":"König der Raben","en":"König der Raben","year":"2020","type":"Фильм","rating":3.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/reJ8fySTzKTkeLrWh6G53gMvp9A.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8h0N63ZzVxUHAEM7odkfRiEmkFo.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"425371","ru":"Пылеуловитель","en":"Blowtorch","year":"2016","type":"Фильм","rating":3.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/5TQGqcaFpEOjwolUVT28ieXodnH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pU5s1NZsk5YjwKVWsfiznL1jc8g.jpg","genres":["триллер","криминал","драма"],"overview":"Blowtorch - это история Энн Уиллис, матери троих детей, недавно овдовевшей и испытывающей финансовые проблемы, Когда ее старший сын Дэйв убит, Энн не может смириться с тем, что не знает, кто это сделал. Детектив из Нью-Йорка, расследующий это дело, тянет время и она решает взять расследование в свои руки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"502178","ru":"Бунтарка без причины","en":"Wild Honey Pie!","year":"2018","type":"Фильм","rating":3.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/8PSuTuAZcWXzJYhotYxTf0qyUqp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w9YJTebfFlF730XlEXfkTHRn0dq.jpg","genres":["драма","комедия"],"overview":"Герои — умеренно странная пара, которой предстоит дать собственный ответ на извечный вопрос: в чем состоит искусство быть вместе? Она — театральный режиссер и драматург, репетирующий пьесу с маленькой труппой, он — эпизодически работает диджеем; оба живут в доме его матери, из-за чего иногда возникают мелкие конфликты. Но в современной молодой семье уже не кипят оперные страсти, Отелло не собирается душить Дездемону — он только печально поздоровается с соперником или соперницей, предоставив партнеру полную свободу выбора.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"36062","ru":"SpangaS","en":"SpangaS","year":"2007","type":"Сериал","rating":3.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/2bH7QQ7WQfnbt1CWiX8BE5E2V4t.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yVIudr5ZNtFvomu6CdFGKAa3njk.jpg","genres":["комедия","драма","Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"486164","ru":"Ratpocalypse","en":"Ratpocalypse","year":"2015","type":"Фильм","rating":3.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/tAqFsEnFjY4wXvmTpGFyfzce0ho.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fLVJhZrOir0MWSA8U717TKT9mlE.jpg","genres":["фантастика","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"655505","ru":"Beast Within","en":"Beast Within","year":"2019","type":"Фильм","rating":3.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/ouokwtnFmSOABWFINdD5vqt7LAB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xFBnVNGm8e1eQKCjaYcbrxlNhps.jpg","genres":["боевик","криминал","приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"497371","ru":"മൈ സ്റ്റോറി","en":"മൈ സ്റ്റോറി","year":"2018","type":"Фильм","rating":3.7,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/xNuP57kxc5gepfQCwNCkl4Udr2E.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l4ULoBILCOi7N6PoKwCmkkOSFoE.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"325125","ru":"Les Portes du soleil : Algér