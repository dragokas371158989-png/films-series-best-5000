/9vRR5MEYWHsnmnYnUeCQABhwQTG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9XtnOYi22W3L2cMUH958mX2fblT.jpg","genres":["Мелодрама","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1043877","ru":"An Unlikely Angel","en":"An Unlikely Angel","year":"2022","type":"Фильм","rating":6.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/vjpodtffvICnCHoa4O0Z26zh0ov.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8ukIihgFISPtPDlEgzcnHbJYlGK.jpg","genres":["Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"997795","ru":"O Último Animal","en":"O Último Animal","year":"2023","type":"Фильм","rating":6.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/nRCv5BRuDHY2HvfQ43MhjtwIRjB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/DZwmEhBw0F1JpF9bVGcyaMnk7s.jpg","genres":["Боевик","Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"852881","ru":"예쁜 여동생 4","en":"예쁜 여동생 4","year":"2021","type":"Фильм","rating":6.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/bhozm1Mjn1bkfiwukK5EUj3ecfI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zktWfwV8CiNTSbKSqc9r5NpHbji.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"534686","ru":"Господин, его жена и гангстер 3","en":"साहेब बीवी और गैंगस्टर 3","year":"2018","type":"Фильм","rating":6.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/92mhRkrhOiQmtwDXGSkC0ULDS3Q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5EQImn48YFu2Z0Eekq2cSN4i40c.jpg","genres":["Боевик","Драма","Триллер"],"overview":"Продолжение известного индийского криминального фильма, главные герои которого продолжают яростно бороться со своими врагами за власть. В центре повествования вновь находятся Биви и Сахеб, которым снова придётся оказаться в центре заговоров и масштабных конфликтов. Им не впервой ввязываться в рискованные авантюры, и они готовы пойти на любой риск, лишь бы укрепить свою власть в криминальном мире. Биви и Сахеб продолжают строить большие планы относительно своего будущего, и их никто не в силах остановить.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"589536","ru":"Киномеханик","en":"The Projectionist","year":"2019","type":"Фильм","rating":6.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/yHmauvcthoC1rgPDucVvHfHfOf1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5YcXWuO1MjhKVEEUXTkQg4lbpMG.jpg","genres":["Документальный"],"overview":"Большая часть истории нью-йоркского независимого кино прошла на глазах Никa Николау. Он начал карьеру в индустрии в 70-х работая киномехаником в порно кинотеатрах. На его глазах менялись целые эпохи в истории киноиндустрии - с закатом порно, поглощением крупными сетями независимых кинотеатров, закатом и изменением вкусов публики. Сегодня Николау владелец одного из очень немногих по-настоящему независимых бюджетных кинотеатров Нью-Йорка, сражающийся с целой индустрией за возможность показывать людям авторское кино за небольшие деньги.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"424834","ru":"Мёртвая пуля","en":"Dead Bullet","year":"2016","type":"Фильм","rating":6.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/6dnvpyyiYV5MdhC1U6OlPKUVGmM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aL7NyadKB8eVsQqd6eYyupDIgtp.jpg","genres":["Драма","Криминал","Триллер"],"overview":"Картежник, отчаянно пытающийся изменить свою жизнь, решился на ограбление казино. После чего удваивает ставки, и пытается продать украденные фишки безбашенному бандиту. Это самая худшая ставка в его жизни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"665585","ru":"Спой, Мэлоэтта: В поисках ягоды ринка","en":"うたえメロエッタ リンカのみをさがせ","year":"2012","type":"Мультфильм","rating":6.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/lywL9nCOD9JQ2ypKO59xjW3PPi6.jp