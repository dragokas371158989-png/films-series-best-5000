ения, адресованные женщине. В сюжетной линии фильма «Подсматривающего» герой убеждается в мысли, что неизвестный хакер взломал все его электронные устройства и с их помощью осуществляет манипуляции. Теперь Ричард пытается найти людей, которые окажут ему поддержку и помогут выбраться из этой невыносимой и пугающей игры.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1196660","ru":"Haslers","en":"Haslers","year":"2023","type":"Фильм","rating":4.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/f9hYXMRAH9mTyfLINAmPupvFZLs.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rvUxEJgRfT6iMzhkQ4KTcxLpPIv.jpg","genres":["драма","мелодрама","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1427822","ru":"വലത് വശത്തെ കള്ളൻ","en":"വലത് വശത്തെ കള്ളൻ","year":"2026","type":"Фильм","rating":4.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ko4cEKcBHcCNbGok2YxnlD4u16N.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g5uP9JdlWktdBcaj5tZKpWbILqL.jpg","genres":["криминал","триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305062","ru":"Karma","en":"Karma","year":"2025","type":"Сериал","rating":4.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/hhsoEvFlf8R4ivCWEsusaovmkMG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6kLHb8RIxJrKaawzp4Sm0cy4jaY.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"928241","ru":"수퍼모델","en":"수퍼모델","year":"2021","type":"Фильм","rating":4.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/rBrQizyKXhJKR0D3NHkRPKuo0KD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bSL0ASngGtFKwnoHgbYsrNJtiXn.jpg","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"675256","ru":"ClownDoll","en":"ClownDoll","year":"2020","type":"Фильм","rating":4.0,"votes":4,"poster":"https://image.tmdb.org/t