es":6,"poster":"https://image.tmdb.org/t/p/w342/lFPAREvgiIpBbNKk4C2BRfDmdiA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qWVo2pa1PCW8tJfXJJBXFQD2Gu2.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"78907","ru":"小戏骨：红楼梦之刘姥姥进大观园","en":"小戏骨：红楼梦之刘姥姥进大观园","year":"2017","type":"Сериал","rating":9.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/fEfZr0fE6zAlTSdah6cuZj3mguF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hk60iWawUFL3bg0m8vAUf58M87e.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"94723","ru":"Live PD: Wanted","en":"Live PD: Wanted","year":"2019","type":"Сериал","rating":9.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/z7TazmR2225znLaaslSWNbE7Moi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hrpLdic5vpO7GqQpuJqesCwSZJ8.jpg","genres":["криминал","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"3687","ru":"Buffy the Animated Series","en":"Buffy the Animated Series","year":"2008","type":"Сериал","rating":9.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/rZIJX2XsDqxXR3l77KYBaT8eeIe.jpg","backdrop":"","genres":["НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"230246","ru":"Первый порядок","en":"第一序列","year":"2023","type":"Аниме","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/o8MgtP31SOIv63kve45xphfAZiW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bimNEAYulIAJUeY8tswd7LBU0Sd.jpg","genres":["мультфильм","Боевик и Приключения","драма","Аниме"],"overview":"После ядерной зимы в мире появились мутанты, ресурсов осталось мало, и человечество выживает, как может. Было построено множество Крепостей, но на всех их не хватает, поэтому многие всё ещё живут в пустыне, выживая из последних сил и добывая мясо охотой. Жэнь Сяосу и его брат именно так и живут. Хоть они и не родные, но постоянно помогают друг другу. Сяосу должен покинуть дом и отправиться в опасные горы Цзиншань, чтобы обрести хоть какую-то надежду на достойную жизнь...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"252396","ru":"Следуй за своим сердцем","en":"颜心记","year":"2024","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/6TXKEuHtIE2J4ROWYrxAGGMcaSV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ohAtmJrA1XTw1BBd5SHcb2r3XcI.jpg","genres":["детектив","комедия","драма"],"overview":"Цзян Синьбай (Ло Юньси) несколько высокомерен и у него плохая память на лица из-за былой травмы головы, полученной во время спасения девушки. Цзян Синьбай - констебль, \"охотник за головами\". Его отца убили, когда юноше было 18 лет, и теперь он надеется открыть правду о тех событиях. Во время тайного расследования он знакомится с милой и добросердечной девушкой Янь Наньсин (Сун И), которая прекрасно разбирается в лекарственных средствах и владеет боевыми искусствами. В детстве она была похищена. К счастью, какой-то юноша спас ее, но с тех пор Янь Наньсин страдает от странного \"синдрома трансформации\", каждый месяц на несколько дней превращаясь в кого-то другого. Однако Цзян Синьбай с его \"слепотой на лица\" всегда может интуитивно узнать её. Этим двум героям предстоит пройти долгий путь вместе, трижды вступить в брак и раскрыть, наконец, кто же стоит за всеми заговорами и запутанными делами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"157195","ru":"Невероятные путешествия животных","en":"Incredible Animal Journeys","year":"2023","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2eU0hYkTki4VoTCNaEH6UhQjD9r.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6JN7NJHgQpPLfawWPJ0oODevbqD.jpg","genres":["документальный"],"overview":"Люди могут верить, что они величайшие исследователи в мире, но это не так. Миллионы животных мигрируют по всему земному шару каждый день по тропам, которые использовались веками. Присоединяйтесь к Джереми Реннеру, который рассказывает о самом экстремальном приключении.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"293371","ru":"18-летняя прабабушка наводит порядок в семье","en":"十八岁太奶奶驾到，重整家族荣耀","year":"2025","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/gi8OL0rAP1hckftAD6pMjHpLEhG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mKuwkljaP0h9tsOSPXr8YrM1ZGb.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278887","ru":"外道の歌","en":"外道の歌","year":"2024","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/f1Xl7nbCQzTbwdFJEHhHfDPTpvy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jSXZB7OPOfuSs6NdgfVRkmpUcZ.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"137092","ru":"时光音乐会","en":"时光音乐会","year":"2021","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/j6AFu7MLxLM8dOOo0My9CQV9Ctt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bX99sNkMA5BzVVizwJqkLNMxugc.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1567441","ru":"Potopa","en":"Potopa","year":"2025","type":"Фильм","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2NLyWGXQyxJyUuESjeOy3M9dofT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AiohUJHjy1q2OZfH41plACNWGSy.jpg","genres":["драма","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"242332","ru":"広重ぶるう","en":"広重ぶるう","year":"2024","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/sUES1wPfhnNiYzQo9JVzdGoe9Qr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8cmGBwOtSnWQNAQFNJd5UiyTFjn.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRat