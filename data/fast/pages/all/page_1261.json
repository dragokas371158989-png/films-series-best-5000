орой Фудзи. Каждая валькирия — опытный воин, но и у каждой свои проблемы. А начинается повествование с того, что из Европы прибывает новый пилот-ас.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"234586","ru":"Тайны Барби","en":"Barbie Mysteries","year":"2024","type":"Аниме","rating":5.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/zKfE4AevCL8RjfcrhfJZat5vWTb.jpg","genres":["мультфильм","Детский","Аниме"],"overview":"Лучшие подружки Бруклин и Малибу превращают свой подкаст о путешествиях в детективную передачу, разгадывая тайны по всему миру.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"158131","ru":"ユーレイデコ","en":"ユーレイデコ","year":"2022","type":"Аниме","rating":5.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/8UvOpGWKuEUQ5A1NBcvrEIA6BxV.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"138909","ru":"Любимая принца — злодейка","en":"王子の本命は悪役令嬢","year":"2022","type":"Аниме","rating":5.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/q76lLNhLGn0nW6cng2ryH42U35n.jpg","genres":["мультфильм","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"757764","ru":"곗돈","en":"곗돈","year":"2020","type":"Фильм","rating":5.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/rSkAXJxeA2pkCLPZBlNcKu4fusL.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"551478","ru":"Jakarta vs Everybody","en":"Jakarta vs Everybody","year":"2020","type":"Фильм","rating":5.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/9RC0TnP2lGNynDYxBqutjsDTyE0.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"796497","ru":"Meeresleuchten","en":"Meeresleuchten","year":"2021","type":"Фильм","rating":5.1,"votes":7,