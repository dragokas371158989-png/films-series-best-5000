стоит небольшая постройка, внешний вид которой напоминает то ли бар, то ли стриптиз-клуб. На пороге обитает вечно голодный мужчина, а внутри — несколько очаровательных женщин-демонов в обтягивающих нарядах. Каждый, кто заходит внутрь, вынужден стать частью игры. Если ты живешь праведной жизнью, то местные накормят и позволят уйти, а если нет, то тебя, вероятно, ждет ужасная участь. Но однажды женщинам предстоит встретить достойных соперников — в бар заходят настоящие охотники на демонов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1197548","ru":"Not an Artist","en":"Not an Artist","year":"2023","type":"Фильм","rating":2.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/xI3HmqeouNoH5es4sZmVF6VwuW3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lqOehI25Clk1AqGdGKpi6m1SMhE.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1119602","ru":"ع الزيرو","en":"ع الزيرو","year":"2023","type":"Фильм","rating":2.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/xpXYt5IPcBOfRwwiLbktl4dYSdE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xUMEf6jEdSlOHJk569BePjHh8HR.jpg","genres":["Триллер","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1033125","ru":"Rumah Kaliurang","en":"Rumah Kaliurang","year":"2022","type":"Фильм","rating":2.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/8nG7t1rxaD4nhrLqADQGXeX645p.jpg","backdrop":"","genres":["Триллер","Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"640462","ru":"Kill Giggles","en":"Kill Giggles","year":"2020","type":"Фильм","rating":2.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/94Q0Gov1eXzW5L2N2jRTcbg5hPr.jpg","backdrop":"","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}