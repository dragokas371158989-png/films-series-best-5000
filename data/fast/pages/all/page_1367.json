","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"254131","ru":"Тбилиси, я люблю тебя","en":"თბილისო, მე შენ მიყვარხარ","year":"2014","type":"Фильм","rating":2.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/w0wGlBipf2NiJ2IzQ1zRGc9keMT.jpg","genres":["драма","мелодрама"],"overview":"11 грузинских режиссеров и сценаристов «дарят» зрителю 10 новелл, которые происходят в Тбилиси, превознося умение жителей города преодолевать все трудности, ценить красоту, любовь и единство, несмотря на все «взлеты и падения» в Тбилиси, как в наше время, так и десятки лет назад.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"49668","ru":"Bez Bebek","en":"Bez Bebek","year":"2007","type":"Сериал","rating":2.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/tvzZYUdC8PKVpvntE7EPot7ohky.jpg","genres":["Детский","семейный","НФ и Фэнтези","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"837308","ru":"Lea","en":"Lea","year":"2014","type":"Фильм","rating":2.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/wlBWLDhfHUSuq1jc56lp8kuBZaA.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"643216","ru":"Le neveu","en":"Le neveu","year":"2018","type":"Фильм","rating":2.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/vTnlGqJLNVInSYSccPQpoEYMlGO.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}