ry":"","ageRating":""},{"id":"156542","ru":"PinkOver Recipes","en":"PinkOver Recipes","year":"2022","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wkS1LnwqQOi7tR9cfc6TwZwFbP8.jpg","backdrop":"","genres":["Новости"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"106556","ru":"Desconhecido Amor","en":"Desconhecido Amor","year":"2020","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/80SrFtAot0MOr6APrOtaTWfyO9S.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"240195","ru":"Masters of the Universe","en":"Masters of the Universe","year":"1999","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/j4gZwSnxtKEpop4KXiKlU6LGdcC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/x6wdVZwGepta7vMLn7Mn19ZAHeV.jpg","genres":[],"overview":"Адам, 10-летний принц с планеты Этерния, терпит крушение на космическом корабле и попадает на Землю. Спустя 15 лет принц отправляется на родную планету, которая теперь находится под гнётом Скелетора. Чтобы одолеть опасного противника, Адаму предстоит раскрыть своё прошлое, объединить силы с союзниками и стать Хи-Меном — самым могущественным человеком во Вселенной.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"210792","ru":"Influencers","en":"Influencers","year":"2018","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/aBGjrw88pQholfnliqaETYZqMSO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k8po3GqJafWM26ILz2cQL5zKbVK.jpg","genres":["Реалити-шоу"],"overview":"Пара CW и Diane приезжает на юг Франции, чтобы спокойно отпраздновать свою первую годовщину. Но их отпуск меняет направление, когда в отеле появляется популярная британская инфлюэнсерша Charlotte. Ситуация, начавшаяся с простой бытовой неприятности, быстро перерастает в напряжённое соперничество: Charlotte сближается с Diane, а CW всё сильнее теряет контроль над происходящим. На фоне солнечных пейзажей возникает тревожная история о навязчивости, ревности и опасных границах человеческой идентичности.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1588420","ru":"Giving Voice","en":"Giving Voice","year":"2009","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/j65J8hemafXHPKhHrpmSz5RRgZ6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gqNlcoXWTbaOPHeV1VNUaRxEiMx.jpg","genres":["документальный","музыка"],"overview":"Шестеро амбициозных старшеклассников проходят прослушивания для участия в Конкурсе монологов Огаста Уилсона, кульминацией которого станет захватывающий финал на Бродвее.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1489789","ru":"Другие люди","en":"Другие люди","year":"2017","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7CGBUU1QRHvyozfVHCV6sQc7Qoc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xvTPAvnXXZ5ZBDQrDiwbkS3uvgc.jpg","genres":["триллер","семейный","ужасы"],"overview":"Драматический фильм расскажет историю молодого паренька Дэвида, настоящего блудного сына, который по стечению обстоятельств вынужден вернуться домой, чтобы встретиться со своим непростым прошлым.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1489780","ru":"Verdon-Saussois 1983","en":"Verdon-Saussois 1983","year":"1983","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lbFY3YdUM2sdTtocVT2qn4DKKzL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t3WlfWjxE0LhR1VnFdgdY3wiBDo.jpg","genres":["документальный"],"overview":"В 1983 году Французская федерация горного туризма (FFM) организовала знаменательный слет альпинистов в Сосуа и Вердоне, объединив поколения величайших альпинистов того времени, включая Патрика Эдлинже, Жана-Клода Дройера, Джерри Моффата, Жана-Клода Дройера, Роберта Параго, Люсьена Берардини, Рона Фосетта, Жана-Пьера Бувье и других выдающихся личностей. Это событие символизировало становление современного спортивного скалолазания как самостоятельной практики во Франции, освобождение легендарных маршрутов и расцвет фристайла, в частности, под влиянием Дройера и Эдлинджера. Эта встреча стала ключевым моментом для распространения свободной этики и эволюции рейтингов, в то время как Соссуа и Вердон находились на переднем крае высокой глобальной сложности.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1489563","ru":"Вечность","en":"Вечность","year":"2006","type":"Мультфильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/yrGMfhRJ0GLlvv0M6XdagFycoO9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aDaEfbuasJyp9T24gjaaYJWqtb2.jpg","genres":["мультфильм"],"overview":"Ежедневный процесс приготовления яичницы становится притчей о жизни цыпленка после смерти.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1477558","ru":"Dogs","en":"Dogs","year":"2019","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4HBXi7bgewAVBmRcLTvtmh3okAL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b2LoyvjTfZdIScbhrpAfQkrPxns.jpg","genres":["комедия"],"overview":"Шесть личных историй, рассказывающих об эмоциональной связи между людьми и собаками.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}