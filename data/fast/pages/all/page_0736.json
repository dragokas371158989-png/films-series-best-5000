:"2023","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lsJxUC6OWQakihDaxJgtTNIqXFr.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"239952","ru":"Ready for Takeoff: The Road to Safe Skies, Archer","en":"Ready for Takeoff: The Road to Safe Skies, Archer","year":"2023","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/kos62ei3G1XNsQPbJkhvErZIbsF.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"226877","ru":"云冈","en":"云冈","year":"2022","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/uaYU1c6QRXOgbZOG7PP0LpXc49m.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1697421","ru":"ФЛН, жертва во имя истории","en":"FLN, Un Sacrifice Pour l'Histoire","year":"2016","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lbmZhe01sz5zh82PxuVEXNTABiP.jpg","genres":["документальный","история"],"overview":"В 1958 году, в разгар Алжирской войны и за два месяца до чемпионата мира по футболу, Французская футбольная федерация (FFF) 15 апреля обнаружила, что девять её игроков алжирского происхождения тайно покинули Францию, чтобы присоединиться к штаб-квартире Фронта национального освобождения (ФНО) в Тунисе, где базировалось Временное правительство Алжирской Республики (ВПРА). Они решили оставить всё — карьеру, славу, деньги — ради поддержки дела ФНО: независимости алжирского народа. Их дерзкий побег был достоин триллера и попал в заголовки международной прессы. В течение четырёх лет команда ФНО гастролировала по миру и стала знаменосцем народа. ФИФА отказалась признать команду и угрожала санкциями федерациям, игравшим против неё. Тем не менее, команда оставила неизгладимое впечатление, одержав 57 побед, 14 ничьих и 12 поражений в 83 матчах. Ферхат Аббас, президент GPRA, сказал им: «Вы выиграли десять лет для дела независимого Алжира».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1632894","ru":"Raven Crag - Closing The Gap","en":"Raven Crag - Closing The Gap","year":"1985","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/bzci3OsbKyTTjX0FG9pkI7QEtlz.jpg","genres":["документальный"],"overview":"В конце 1970-х и начале 1980-х годов Джилл Лоуренс и Джилл Прайс, члены женского альпинистского клуба Pinnacle Club, совершили первые женские восхождения по сложным маршрутам, заложив основу для развития этого вида спорта в 1980-х годах. В 1984 году в Озерном крае Джилл Прайс и Джилл Лоуренс были запечатлены на видео во время восхождения на маршрут Empire E3 6a на скале Raven Crag в Тирлмире для программы Channel 4 «Lakeland Rock» с Крисом Бонингтоном, показанной на Channel 4 25 мая 1985 года. Это событие стало поворотным моментом в британском женском альпинизме, поскольку на телевидении практически не было женщин, лазающих по сложным спортивным маршрутам.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"214011","ru":"Планета вкусов","en":"Планета вкусов","year":"2012","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/ttd6EgHg3qnGtkGqZ81Yg2pbGcn.jpg","genres":["документальный","Ток-шоу"],"overview":"Гастрономическое путешествие Антона Зайцева представляет собой уникальную смесь документального фильма с элементами телекухни. Ведущий странствует по свету в поисках рецептов особых блюд, которых не найти в обыкновенной кулинарной книге. За время съемок проекта вышло в эфир более 40 фильмов. Ведущий уже испробовал крокодила во Вьетнаме, кенгуру в Австралии, морской огурец в Корее, червивый сыр в Сардинии, рыбу в щелочи (лютефиск) в Норвегии, а также освоил самую высокую в мире тарзанку (Макао, 233 м), в поисках пропитания погружался на глубину 20 м, взмывал на мотопараплане на высоту 400 м и даже охотился на акул с копьем на краю Марианской впадины!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"72481","ru":"The Wall","en":"The Wall","year":"2017","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/zM87M36jBY4l63OFdiRwmSrkfcp.jpg","genres":[],"overview":"Американский стрелок оказывается в ловушке за небольшим куском бетона под прицелом своего противника. Герой ловит вражескую радиочастоту и общается с иракским снайпером. Живым с поля боя уйдет лишь один из них.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1705420","ru":"ในวันฝนโปรย","en":"ในวันฝนโปรย","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qzXK6C4DhlcYuiScuQuTeEuaLR6.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1704960","ru":"Bradley Martyn: The Influencer","en":"Bradley Martyn: The Influencer","year":"2023","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/dqljsxKyWXxBF6xPWWcWtV5dUR2.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1704058","ru":"Semi-Detached","en":"Semi-Detached","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qHnHIlSqTCZqjfsnljf7ciQO305.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1694593","ru":"The Case of the Lipstick Killer","en":"The Case of the Lipstick Killer","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/uRNJgcpGjw6T2B1CW8aqRF7XbfS.jpg","genres":["криминал","драма","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1690849","ru":"Floor 12","en":"Floor 12","year":"2026","type":"Фильм","rating":10.0,"vo