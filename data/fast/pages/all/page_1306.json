votes":23,"poster":"https://image.tmdb.org/t/p/w342/jYfQ2QEK03ruxKQkP3r4yzM4Juu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mRtJoFUCeZVsnIp8oqh2e084YIR.jpg","genres":["драма","криминал"],"overview":"В 1984 году первокурсница Энджи Ван приступает к учебе в университете Сан-Франциско. В общежитии девушка знакомится с богатой соседкой Джанин, и та открывает новенькой мир ночных клубов, выпивки и наркотиков. Когда у Энджи наступают финансовые затруднения, она решает синтезировать в университетской лаборатории набирающий популярность наркотик экстази и впоследствии становится одним из крупнейших его производителей на Западном побережье.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"567691","ru":"Я токсичный","en":"Soy tóxico","year":"2018","type":"Фильм","rating":4.5,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/uYFzoWvszZbANmsIWaqvPHwtZhr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/54nkHaMykk0YpLohG7nBeLvAIbs.jpg","genres":["драма","ужасы","фантастика"],"overview":"2101 год. Всё южное полушарие планеты Земля превратилось в мировую свалку отходов. Человек без имени бороздит пустоши некогда процветающей цивилизации, пока не натыкается на группу мародёров, которые обманным путем завлекают его к себе в лагерь, а затем берут в плен и подвергают чудовищным пыткам…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"330414","ru":"பத்து எண்றதுக்குள்ள","en":"பத்து எண்றதுக்குள்ள","year":"2015","type":"Фильм","rating":4.5,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/jZx7x4JUadJBa8AFZYsc5gN5k8E.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f5uwFqPLnjJWF3xDjFPpfMvWGES.jpg","genres":["боевик","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"863946","ru":"Horror Noire","en":"Horror Noire","year":"2021","type":"Фильм","rating":4.5,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/6fgZhjSUJBkWvr7ScZaWOZ8MKRu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vRDKq3C83pOkbUDC2KxFsSPxRlD.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"499963","ru":"Письма Асперна","en":"The Aspern Papers","year":"2019","type":"Фильм","rating":4.5,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/6dupMfqmhZuNWNLQUN2iOFeLtks.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xXQTg75heULvNjEgdWkwvmoNwoN.jpg","genres":["драма"],"overview":"Действие фильма разворачивается вокруг молодого писателя, который пытается отыскать утерянные письма великого поэта к своей возлюбленной.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"333123","ru":"Кролик Джек","en":"Jackrabbit","year":"2015","type":"Фильм","rating":4.5,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/uTbcoBZeClVyoLfhWXjxjWoPu2i.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cd9lvcw4SBIjNM3BDAFd4VduwW9.jpg","genres":["драма","триллер","фантастика"],"overview":"Матерый хакер и профессионал по компьютерному железу берутся вместе за непростую задачу - расшифровать загадочную флешку, ту единственную вещь, что осталась от их друга. внезапно покончившего жизнь самоубйством. Все ведет к тому, что под мощным шифром в файлах этой флешки хранится страшная тайна, заставившая свести счеты с жизнью...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"343059","ru":"Голливудские приключения","en":"横冲直撞好莱坞","year":"2015","type":"Фильм","rating":4.5,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/vIhDQ6lj0KSGtV9cmAwFQ5GFcmh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6s8Rh0MQbWUVQlrtasZBOOIam9W.jpg","genres":["комедия","боевик"],"overview":"Сяомин (Хуан Сяо Мин) – мужчина правильный до зубовного скрежета. Вся его жизнь подчиняется четкому распорядку, он следит за своим здоровьем и все планирует на годы вперед, но однажды его девушка Ян-Ян (Чжао Вэй), на которой он собирался жениться, сообщает ему, что улетает в Голливуд, где у нее открылись карьерные перспективы. Погоревав, Сяомин решает бороться за любовь и покупает билет до Лос-Анджелеса, но на месте все идет наперекосяк.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"241432","ru":"Дни и ночи","en":"Days and Nights","year":"2014","type":"Фильм","rating":4.5,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/sYnyApQTDpyfdtsj7Yb16FAwpFN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xUWoTRXN1a2N6wFpBClfyBjktvu.jpg","genres":["драма","комедия"],"overview":"Безрассудное желание приводит к беспорядкам в День поминовения, когда семья сталкивается с хрупкой и неустойчивой природой любви.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"542164","ru":"Groupers","en":"Groupers","year":"2019","type":"Фильм","rating":4.5,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/jdtUBpSkaaiH8VKwi6rMPpwgvKc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n6LxemiPrLtIL33BxKIMO1jJkGj.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"328845","ru":"İnşaat 2: On Yılda Bir","en":"İnşaat 2: On Yılda Bir","year":"2014","type":"Фильм","rating":4.5,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/qXG4vldl2EmV6vD2ZbCioiOhfVJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j6gElNs8HUfzb8VsicU6zCvwvGM.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"343829","ru":"Breaking the Bank","en":"Breaking the Bank","year":"2016","type":"Фильм","rating":4.5,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/73NZt2IEd8dZoqmVp7ZJOnw7IUw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l1S51bNvZ06WHC2cDOI6UY2yYF0.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"400456","ru":"Exorcist House of Evil","en":"Exorcist House of Evil","year":"2016","type":"Фильм","rating":4.5,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/1TFODgQcPnqZ2QTn9QHN1gib4Wn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uBQenkKfBsb1uYTXFmrbbug3dD1.jpg","genres":["триллер","ужасы","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1252552","ru":"Дом моделей","en":"Model House","year":"2024","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/slWaOsvj3zKd0XUfLuJDVLOj5n7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wZ0c0MV1tecC5Lp3CPy6ejCCPwc.jpg","genres":["ужасы","триллер"],"overview":"Пять моделей принимают участие в рекламной кампании купальников. Они селятся в доме, куда врываются двое бандитов. Взяв девушек в заложницы, они заставляют их опубликовать ссылку для пожертвований, чтобы собрать 1 миллион долларов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1089765","ru":"Барбер","en":"Barber","year":"2023","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/w8rzw8XgGKkHdnWWLQTtbrS7qMP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6OmzzuGWAa7YgvkbxP6XnvF5VAx.jpg","genres":["криминал","триллер","детектив"],"overview":"Вэл Барбер, частный детектив, нанят богатой вдовой, чтобы найти пропавшую внучку. Действие первоначального расследования исчезновения Сары, проводимого Барбером в Дублине на фоне глобальной пандемии, быстро угасает. Тайны начинают проявляться самым неожиданным образом. Вскоре Барбер оказывается связанным с влиятельными людьми темной морали, полными решимости помешать его расследованию. Откусил ли он больше, чем может прожевать?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"630486","ru":"Night Drive","en":"Night Drive","year":"2021","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/tsU396jRLfx7EyM0inOkoHDjNFg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aZ60voDUxJeRH14DBpO614DowVF.jpg","genres":["триллер","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1054624","ru":"Terror Train 2","en":"Terror Train 2","year":"2022","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/feOlrUtL8OAysMxbpUa1YWtp9qX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rR9oNE6FTwxCKS0hCVhxJuQEEoY.jpg","genres":["ужасы","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1079643","ru":"Devil Beneath","en":"Devil Beneath","year":"2023","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/tS3yHz34uwVniyD5zDUcP0gRoo3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qOsm2JTMECBBnykc1PVUkOGQ6tN.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"454687","ru":"Слон по имени Бенджамин","en":"Benjamin Blümchen","year":"2019","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/x7r5uHoTkoWaGxCho8qQPOdiZ8Y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iXdr34TZKUBCZiFXIEWlxQLAnWl.jpg","genres":["семейный","комедия"],"overview":"Юный Отто хочет провести большую часть школьных каникул со своим другом-слоном Бенджамином. Планы мальчика оказываются под угрозой срыва, когда выясняется, что зоопарк, где живёт Бенджамин, собираются реконструировать.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"346592","ru":"Пистолет за десять центов","en":"10 Cent Pistol","year":"2014","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/eLxk3fmxtfxRCMavwdxP4R6BRzs.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f8oKvYve2XcRKUxP7ep3JenjzRc.jpg","genres":["боевик","криминал","триллер"],"overview":"Двое приятелей-гангстеров после взятия большого куша и отсидки одного из друзей решают забрать свою долю. Но из-за случайно сработавшей сигнализации в дом приезжают копы и всё идет не так, как они задумывали.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"260310","ru":"Белка и Стрелка: Лунные приключения","en":"Белка и Стрелка: Лунные приключения","year":"2014","type":"Мультфильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/yfL5VIgWLVi0ICZZXceXpxZUYq3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bAmw3veZOgNbJ0XgeGudDIrQjl2.jpg","genres":["приключения","мультфильм","комедия","семейный"],"overview":"На Земле начали происходить странные и загадочные явления, несущие угрозу для планеты. Их след ведет в космос, на темную сторону Луны. Раскрыть тайну века поручили отряду Казбека. Белка, Стрелка и вся команда веселых и отважных героев отправляются на Луну, чтобы выполнить опасную миссию. Страсть к приключениям, искрометный юмор и великий дух космического братства поддержат в минуту великой опасности и помогут раскрыть всю правду о Луне и ее обитателях.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"21188","ru":"Веселая Коза: Легенды Старой Праги","en":"Kozí příběh – Pověsti staré Prahy","year":"2008","type":"Мультфильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/oCozt2LRQlbgConxfj9E34r7Nv9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a2k6ddlE98hIOz0nKe6TPw102e4.jpg","genres":["мультфильм","комедия"],"overview":"Эта необыкновенная история произошла в средневековой Праге. История о дружбе крестьянина Кубы и его козы. Вместе они приходят в город и встречают девушку Маци, хорошо знающую законы улицы. Куба устраивается на работу часовым мастером и влюбляется в Маци, но своенравной козе это совсем не нравится! Это история о спасении пражских астрономических часов, о любви и дружбе, предательстве и трусости. Главные герои попадут в Мистический дом Фауста, им предстоит встретиться с привидениями и дьявольщиной. Необыкновенные приключения друзей никого не оставят равнодушными!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"501638","ru":"Каникулы президента","en":"Каникулы президента","year":"2018","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/62sliFNsbpA5KXncInTlca00Gxh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mEHDhl5BfjXHPy9VHiZG7dC7mDy.jpg","genres":["комедия"],"overview":"Устав от рутины, Президент решает отправиться на каникулы в гордом одиночестве, чтобы отдохнуть в Крыму, а заодно свободно пообщаться с народом. Понимая, что остаться инкогнито и улизнуть от заботливых коллег будет сложно, он прибегает к услугам гримера. Но его новый облик точь-в-точь совпадает с наружностью Валерия из N-ска, который скрывается от коллекторов по путевке матери в крымском санатории…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"461767","ru":"Canaries","en":"Canaries","year":"2017","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/i5HvW9WRMhKQJgO3H52lvvnqvHK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mEycZA0RJ1OdeTDWi8Cvjdfyhpc.jpg","genres":["фантастика","комедия","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"612322","ru":"Anniversary Nightmare","en":"Anniversary Nightmare","year":"2019","type":"Фильм","rating":4.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/bf5yGFJjHEHCZAQANkm7YeAPoW9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7BIS7MAWgXFP3UnmIFYBFqrXKzD.jpg","genres":["драма","телевизионный фильм","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}