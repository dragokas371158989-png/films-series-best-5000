eQIhL8QzeFS7.jpg","backdrop":"","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"205493","ru":"Новый Принц Тенниса: Чемпионат мира U-17","en":"新テニスの王子様 U-17 WORLD CUP","year":"2022","type":"Аниме","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/etVlxcNUsJLE4qhJON3VwZSzwFW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/x3kTIGpx66VUTlUsPASyfjAlp98.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Когда восходящую звезду тенниса Рёму Этидзэна выгнали из подготовительного лагеря для юниоров за нарушение правил, он впал в отчаяние. Но удача снова улыбнулась ему, подарив возможность сыграть за команду США. Будет непросто пробиться через их ветеранов, чтобы показать себя, но ещё сложнее будет выйти на корт против своих друзей. Поможет ли Рёма своим новым братьям одержать победу?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"316945","ru":"Unicorn Academy: Secrets Revealed","en":"Unicorn Academy: Secrets Revealed","year":"2026","type":"Аниме","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/7ISVs3g7rjCnhFqnWLdwqxw9Wus.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wySgT9mfmQzJgttiSDuONykUVh5.jpg","genres":["мультфильм","Детский","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305986","ru":"Убийство в доме с часами","en":"時計館の殺人","year":"2026","type":"Сериал","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/a65r9Weu0hVLNA7uZFv1YekXImR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yJfPNIoCASW4g3loGAbd3KiFzBg.jpg","genres":["драма","детектив"],"overview":"В 1989 году действие происходит в старинном особняке, известном как «Дом часов». Молодой редактор Каваминами Такааки приезжает туда вместе с заместителем редактора и группой коллег. Во время спиритического сеанса, целью которого было вызвать дух девушки, по слухам обитающей в особняке, внезапно исчезает ясновидящая — и с её исчезновением начинается череда зловещих и необъяснимых событий.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1321820","ru":"Бхаратанатьям","en":"ഭരതനാട്യം","year":"2024","type":"Фильм","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/roEHh97z7KaigdoWWk3S6SJc0UK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2nKAQpPZsjhYwT1qOYarpggOVXx.jpg","genres":["комедия","драма"],"overview":"Попытки молодого человека сохранить семейную тайну посреди тяжёлых испытаний в районе полном любопытных соседей, приводят к забавным ситуациям, а позднее и к укреплению семьи.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1067000","ru":"В поисках тьмы 1990-1994: Путешествие в культовый хоррор 90-х","en":"In Search of Darkness: 1990-1994","year":"2024","type":"Фильм","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/3qwkM8Neh8MohivOQgVaIoTqp5Q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tF82SarJiwd3F9apXVp28LzYCIu.jpg","genres":["документальный","ужасы"],"overview":"Кинозвезды и эксперты в жанре делятся наблюдениями и опытом, чтобы помочь переосмыслить, деконструировать и пересмотреть \"потерянное\" десятилетие хоррора: 90-е годы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"728212","ru":"Между миром и мной","en":"Between the World and Me","year":"2020","type":"Фильм","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/rHntazEQuvO0wSplvOxf5wNdvFO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qPeRJjrNTHXByMXF0HmxkkeOqig.jpg","genres":["документальный","драма"],"overview":"Фильм, основанный на бестселлере «Между миром и мной» американского писателя Та-Нехиси Коутса. В нем рассказывается о том, как автор рос в центральной части города Балтимора, и о его страхе перед ежедневными проявлениями расизма в сторону чернокожего населения. В фильме исследуется идея Коутса о том, что американское общество структурно поддерживает превосходство белых. Картина включает в себя игровые и анимационные элементы, отрывки из книги (построенной как сборник писем к сыну писателя), архивные съемки, а также кадры из семейной жизни актеров. Кстати, про них: в проекте приняли участие Махершала Али, Анджела Бассет, Опра Уинфри и другие.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"263043","ru":"似锦","en":"似锦","year":"2025","type":"Сериал","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/1PsrKjBhLfbaxb349TEzd1XPSSR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qpARG9aRGsD4SkzpK92xw7cGdTM.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1234951","ru":"王様戦隊キングオージャーVSキョウリュウジャー","en":"王様戦隊キングオージャーVSキョウリュウジャー","year":"2024","type":"Фильм","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/buR0ix3uE2CbL4vUuPbna9bVS7y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/duvMfHRTwgzc7jEBhKAz1xXlDLX.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"695883","ru":"Let's Go Crazy: The Grammy Salute to Prince","en":"Let's Go Crazy: The Grammy Salute to Prince","year":"2020","type":"Фильм","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/4swe0KeDX2rjLT211eFRBSRuqTC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yjqQrh4LaByEGujN2HZomdCb2pA.jpg","genres":["музыка","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"309997","ru":"Prima di noi","en":"Prima di noi","year":"2026","type":"Сериал","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/bHgiRQrKZqjBJ0k1mtc20J3JJTB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ArGavV3eooqiGC8YUUjCjHviDoL.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"20945","ru":"Совершенная красота","en":"Beleza Pura","year":"2008","type":"Сериал","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/jLbQtAZVtUpztZFutF4AaKoz0b7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rfAWkSnZDcozhLMu4aAM69GY5yI.jpg","genres":["Мыльная опера"],"overview":"Все начинается с того, как экономичный вертолет «Carcara», детище авиационного инженера Гильерме Медейруса, падает в Амазонии. Трагедия заставляет Гильерме, эгоиста и бабника, многое переоценить в своей жизни. Незадолго до этого он начинает встречаться с Сонией, и она знакомит его со своими детьми, Клаусом и Доминики. После авиакатастрофы и гибели Сонии Гильерме оказывается с ее детьми на руках и берет на себя заботу о них. Знакомится с Жоаной, когда она приходит в дом Сонии после того, как детектив сообщает ей информацию о матери. Гильерме в это время находится в доме Сонии вместе с ее детьми (от них скрывают, что мать погибла). Жоана приходит и объявляет, что она дочь Сонии. Гильерме отправляет детей погулять и сообщает Жоане, что Сония погибла. Жоана становится его большой любовью…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"445179","ru":"Я думала, что не бывает судьбоносной любви","en":"わたしに運命の恋なんてありえないって思ってた","year":"2017","type":"Фильм","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/nBrixx0zRnOufOaK9oVBUGlTS5f.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uRJb4Ukin4pQeTuyv07TqsBQt72.jpg","genres":["мелодрама"],"overview":"После случая в старшей школе Рико Сирано больше не мечтает о принце. Девушка всё своё время тратит на романтические онлайн-игры, разработкой которых и занимается. Однажды ей предлагают стать консультантом для игры компании TIME IS. Глава этой компании, Курокава Соитиро - мечта любой женщины. Однако он совсем не понимает чувств прекрасной половины человечества, и чтобы игра стала успешной, и чтобы завоевать сердце любимой, Соитиро просит Рико помочь ему понять, чего же на самом деле хотят женщины.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"263814","ru":"Братья. Последняя исповедь","en":"Брати. Остання сповідь","year":"2014","type":"Фильм","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/6mLUMYr7t7WQcGf8itEshd2iumW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iJDT9Cb4HP4nMkmi4ir2q4m7nEU.jpg","genres":["драма"],"overview":"Два брата-гуцула всю жизнь все делили: мать, игрушки, право называться лучшим, одну женщину, одного сына. Но в их жизни произошло событие, после которого они не разговаривали друг с другом на протяжении 40 лет. В их маленький провинциальный городок приезжает писательница, которая читает в местном монастыре лекцию про святых и юродивых. Среди слушателей — пожилой человек, которого зовут Войтко. Писательница постепенно входит в жизнь Войтка и знакомится с его братом. Она становится связующим звеном между двумя братьями, смысл жизни которых — в противоборстве: кто дольше проживет и не потешит второго своей смертью.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"20000","ru":"RTL Samstag Nacht","en":"RTL Samstag Nacht","year":"1993","type":"Сериал","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/scXr2na0psLX8BAZNkvv8FiMIss.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eFaozL7ujKsDEfdPpuHOyeKEik6.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"6054","ru":"洛神","en":"洛神","year":"2002","type":"Сериал","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/vUfEkxsi6fHWVkNjaOv9yBPisse.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t6nYbfIDj96sXvS0INEQmqhAk0r.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"45828","ru":"IS～男でも女でもない性～","en":"IS～男でも女でもない性～","year":"2011","type":"Сериал","rating":7.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/neJaBxDgvta0cx6jCH5XtaBqyKD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g55bd40q8AAB3yDgf40dgkDyxsO.jpg","genres":["драма"],"