poster":"https://image.tmdb.org/t/p/w342/3cv0bQgu9PnH89xms2byU9ld7V2.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"442913","ru":"Nickelodeon's Not So Valentine's Special","en":"Nickelodeon's Not So Valentine's Special","year":"2017","type":"Фильм","rating":7.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/e96r43e8rANqpjJSGTKCFfIDWZq.jpg","genres":["комедия","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"296527","ru":"Позвоните моему агенту: Берлин","en":"Call My Agent Berlin","year":"2025","type":"Сериал","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/wq6Ir1FV9wPPlw6lMiyWVQyiPKH.jpg","genres":["драма","комедия"],"overview":"Добро пожаловать в актерское агентство Stern, где слава и драма идут рука об руку. После внезапной смерти основателя Ричарда Стерна агентство оказывается на грани банкротства, и сотрудники должны срочно привлекать новые таланты, удерживать существующих клиентов и умело размещать их, чтобы спасти собственное будущее. Агентство — сердце сериала: пока по коридорам ходят знаменитости и в каждом эпизоде появляются реальные звезды, агенты ведут скрытую борьбу, используя манипуляции и рискуя всем ради своих клиентов. Предательство, любовь, семья и дружба смешиваются, создавая взрывной коктейль, где границы между работой и личной жизнью стираются. Каждая битва приближает агентство к триумфу или к краху.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"921728","ru":"Аттенборо и Кладбище Мамонтов","en":"Attenborough and the Mammoth Graveyard","year":"2021","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/zJK70Jxl3kkwrAXRKOioSZrloWC.jpg","genres":["документальный","телевизионный фильм"],"overview":"Сэр Дэвид Аттенборо присоединяется к археологическим раскопкам, раскрывающим крупнейшую находку мамонта в Великобритании почти за 20 лет.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"968022","ru":"Marokkaanse bruiloft","en":"Marokkaanse bruiloft","year":"2022","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/bBPsreYOW85GMW5zldguLqR9e2n.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1631346","ru":"Roman Frayssinet : Ô delà","en":"Roman Frayssinet : Ô delà","year":"2026","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/jeFY9hrchhHwZ8cvenu2H0FIvUC.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"332995","ru":"Космонавты: как Россия выиграла космическую гонку","en":"Cosmonauts: How Russia Won the Space Race","year":"2014","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/imM8pUcLJimpQySjY5sneJRSJU3.jpg","genres":["документальный"],"overview":"Все мы (британцы) думаем, что знаем историю космоса, что он был покорён американцами. Но это неправда. Настоящими завоевателями космоса была группа отважных мужчин и женщин с другой стороны Железного занавеса. После десятилетий секретности они, наконец, могут поделиться удивительными историями о том, как рисковали всем, чтобы совершить первые шаги в космос. Сокровищница ранее неизвестных видеоматериалов из русских архивов открывает, как снова и снова Советский союз отодвигает более сложную американскую программу на второе место. Но наряду с триумфами, были также трагедии и катастрофы, которые продолжались до настоящего времени. Это - замечательная, и порой пугающая, история космонавтов...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"168125","ru":"Ein Münchner im Himmel","en":"Ein Münchner im Himmel","year":"1962","type":"Мультфильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/g4mYHtu9zw57Jkv0cPAjj6mSySW.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"632701","ru":"The True Don Quixote","en":"The True Don Quixote","year":"2019","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/oZy6daiVmB8uiOHh0O9w3IsCEUG.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"72249","ru":"スケッチブック ～full color'S～","en":"スケッチブック ～full color'S～","year":"2007","type":"Аниме","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dleyndGM2UEo4LubPpaP4JZFIxk.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"316992","ru":"Вторая мировая война с Томом Хэнксом","en":"World War II with Tom Hanks","year":"2026","type":"Сериал","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/j0DG5uQrgwAubL4ALHMnU65iCOT.jpg","genres":["документальный"],"overview":"В сериале рассматривается Вторая мировая война, начиная с вторжения Германии в Польшу и заканчивая атомной эрой, анализируются ключевые сражения, лидеры военного времени, такие как Черчилль и Рузвельт, и человеческие жертвы тотальной войны.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1588860","ru":"Happy Ending","en":"Happy Ending","year":"2025","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/wpYoYJ4kWLGhSfS3ofn4xEPJbun.jpg","genres":["драма","мелодрама"],"overview":"«Я люблю тебя» - именно этих трёх страшных слов боится вечный холостяк Юди. Самые идеальные отношения для него – это ни к чему не ведущие и ни к чему не обязывающие. Но у его девушки Вишакхи, присосавшейся к нему, как пиявка и по пятам преследующей его, совсем иное мнение об этом. Её Юдик-Чудик, должен 24 часа в сутки находится только рядом с ней. Пытаясь избежать чрезмерной навязчивости ненормальной подружки, Юди берётся за первую попавшуюся работу, в которой он должен написать сценарий для помешанного на ромкомах Армана-джи. Ко всему вдобавок, в писательской индустрии у Юди появляется обаятельная конкурентка Ачал, которая путём афёры, начинает наперебой отбивать у него контракты.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"317555","ru":"Майкл Джексон и его история","en":"Michael Jackson: An American Tragedy","year":"2026","type":"Сериал","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/vSdcBSnBRDY29Tz4We4TlKmjtLA.jpg","genres":["документальный"],"overview":"Сериал не просто пересказывает биографию артиста, а стремится охватить весь спектр его жизни: от невероятного взлета и культурного влияния до противоречий и трагедии, которые продолжают разделять общество и сегодня. Авторы поставили перед собой задачу нарисовать полный и сбалансированный портрет, уходя от однозначных оценок и пытаясь разобраться в хитросплетениях его судьбы, где гениальность соседствовала со скандалами.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1600513","ru":"Терри Джо: миссионерка в Майами","en":"Terri Joe: Missionary in Miami","year":"2026","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/zLBz0HPcial4opOnThYmfW6piOu.jpg","genres":["комедия"],"overview":"В этом диком фарсе красавица с Юга Терри Джо отправляется в Майами, чтобы сбежать от сумасшедших преступников и найти новую церковь, где она сможет искупить свои грехи.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"621735","ru":"Сын-мать","en":"مادر-پسر","year":"2020","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1QtW4ihEFYDGuFvrPKTm353ftpf.jpg","genres":["драма"],"overview":"Вдова Лейла работает на старой иранской фабрике, которая скоро закроется. Женщина одна растит двух детей и едва сводит концы с концами. Спасти Лейлу от финансовых проблем может брак с Каземом, но мужчина ставит условие — 10-летний сын Лейлы должен уйти, потому что по местным законам мальчик не может жить в одном доме с дочерью Казема.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1510769","ru":"29","en":"29","year":"2026","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/aQZ4OxzaYTN7cRN7fALi9BhPucp.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"287429","ru":"三人夫婦","en":"三人夫婦","year":"2025","type":"Сериал","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/uvcp8HUVcEtxCL1lgFYEw6unJop.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"270848","ru":"护宝寻踪","en":"护宝寻踪","year":"2025","type":"Сериал","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/DHdtmiPBKfIrwIhFgn03vjNQc0.jpg","genres":["драма","детектив","Боевик и Приключения"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1542877","ru":"劇場版「暗殺教室」みんなの時間","en":"劇場版「暗殺教室」みんなの時間","year":"2026","type":"Мультфильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dfrZ7VHcurFhLm2Hk6xyjRILc5d.jpg","genres":["мультфильм","комедия","боевик","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1466120","ru":"데드 어게인","en":"데드 어게인","year":"2025","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/iqSmb9ugb8xK6avZ3Wglxue39N8.jpg","genres":["триллер","мелодрам