.tmdb.org/t/p/w342/pwvy97Bli8J5PnCoVNTTjC55Fwi.jpg","backdrop":"","genres":["Ужасы","Триллер"],"overview":"Сестры-близнецы должны встретится лицом к лицу со своим прошлым, когда покушавшийся на них убийца вновь начинает на них охоту.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"917524","ru":"Beck 43 - Ett nytt liv","en":"Beck 43 - Ett nytt liv","year":"2021","type":"Фильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/wsCp36sLUX5ebmfu1xMdeZ3KZHv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k9tBpXVJfQb6gN0HYUsDuL2U2nt.jpg","genres":["Триллер","Драма","Криминал","Детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"915865","ru":"Mrs. Undercover","en":"Mrs. Undercover","year":"2023","type":"Фильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/wEKwOfgo3IMGNNGkDF0WJQtrmIx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6WtF3uB695dm9gksqveDK3RlbDd.jpg","genres":["Боевик","Комедия","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"767066","ru":"The Jinkx & DeLa Holiday Special","en":"The Jinkx & DeLa Holiday Special","year":"2020","type":"Фильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/sJTVGCp3dd9J4qDa6bIcpotzGU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sJUAIiAV7xJe9Uq9eWlcdyrHeNf.jpg","genres":["Музыка","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"824480","ru":"The Wheel","en":"The Wheel","year":"2022","type":"Фильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/mOccoLIEv784KxgJG2qQjIfrKON.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f6UF7GaYqGNwud0Mo3nAD8dTxgv.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"200708","ru":"Весь мир у наших ног","en":"Весь мир у наших ног","year":"2015","type":"Фильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/bpFe8h4iNJhx3WxeR3NFJ70F3fQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cSgqw8FexALj0VgAP8XvoomBc9O.jpg","genres":["Триллер","Боевик"],"overview":"Один вожделенный взгляд приводит к событиям, стремительно погружающим жизнь молодой Алии в криминальную бездну. Но в водовороте страстей, на краю гибели, есть лишь одно спасение – истинная любовь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"508710","ru":"Гурвинек. Волшебная игра","en":"Hurvínek a kouzelné muzeum","year":"2017","type":"Мультфильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/t7Rd4ROm0ju5HyAj1y0Kt4bgArl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vc2mEoorUeSx4ucOMlQ1NDl8U9F.jpg","genres":["Семейный","Мультфильм"],"overview":"Гурвинек — умный и жизнерадостный десятилетний мальчик, страстно желающий только одного — завершить последний уровень невероятно сложной компьютерной игры. Тогда его имя попадет в заветный Зал Славы, задиры из школы наконец-то признают его, и даже рассеянный отец сможет наконец-то им гордиться. Но победа в виртуальной игре становится только началом настоящего путешествия Гурвинека, его верного пса и их невозмутимой соседки в давно забытый мир старинного городского музея игрушек.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"360022","ru":"Поцелуй меня, убей меня","en":"Kiss Me, Kill Me","year":"2015","type":"Фильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/6kmO6GWFs6gD6ppaivscJogZoOg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3oK5bI0RyygJJtp82y7X5YEtIw5.jpg","genres":["Детектив","Криминал","Триллер"],"overview":"Главный герой картины Дасти, наконец, обрел счастье в новом возлюбленном, с которым ему было очень хорошо, их романтические отношения были крайне страстными и пикантными, и это нравилось обоим партнерам. Время от времени молодой человек узнает об изменах своего приятеля и вынужден прощать ему все обиды. Однажды произошло нечто ужасное. Дело в том, что парни серьезно поругались и, перенервничав, Дасти даже потерял сознание. Он всегда был чуткой натурой. Когда он пришел в себя, то обнаружил возле себя своего возлюбленного, который был мертв, его убили. Приехавшая на вызов полиция считает виновным в убийстве конечно Дасти. Как молодому человеку, доказать что он не убивал своего любимого, даже если накануне они в очередной раз поссорились?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"69997","ru":"The Quad","en":"The Quad","year":"2017","type":"Сериал","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/7jtSWAB9hr3Dw6GRlADNh93WHYv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/z66GcQ2r7vsxItwco0pSJHTHMR3.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"632937","ru":"Agnes Joy","en":"Agnes Joy","year":"2019","type":"Фильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/fKOhIRK6JGg6maknmTxU1VR2Kke.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s88Q5gIwVB0bgNyk5ouL0vb4AQl.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"340067","ru":"나의 절친 악당들","en":"나의 절친 악당들","year":"2015","type":"Фильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/1tOITCWrf2zziEaDAQv1SlcEl5f.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mfMOqnhDoicZ7xvj1xyKDEjIE0K.jpg","genres":["Боевик","Комедия","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"346244","ru":"Проклятье клоуна","en":"Badoet","year":"2015","type":"Фильм","rating":5.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/pOOTM5yLTnbOtQYeSOZoMHkp00h.jpg","backdrop":"","genres":["Триллер","Ужасы"],"overview":"Трое друзей пытаются выяснить, кто стоит за убийствами местных детей. Погибшие перед смертью рисовали один и тот же рисунок. Вскоре главные герои сталкиваютс