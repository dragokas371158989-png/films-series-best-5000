побочный эффект, с её размерами приходится считаться.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1014501","ru":"Grotesque","en":"Grotesque","year":"2022","type":"Фильм","rating":3.7,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/eoMsojXOiO18leSgHHOxzYOtG5o.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gRggdawsxvOZaNwS2ZdFGRS1FK9.jpg","genres":["Ужасы","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}