23","ru":"O Canada","en":"O Canada","year":"1997","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/tgQaoAWR1LRVphgMhDUtOnil1G7.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"129651","ru":"超音戦士ボーグマン2 [SECOND] -新世紀2058-","en":"超音戦士ボーグマン2 [SECOND] -新世紀2058-","year":"1993","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/bjBrrc24EYVzFjZ208CUTKgzPpS.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"19923","ru":"Wheel Squad","en":"Wheel Squad","year":"2000","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qnrhZXjxIQ51RFWUOdMgXYwAifz.jpg","genres":["мультфильм","Детский","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"105185","ru":"Ted Sieger's Wildlife","en":"Ted Sieger's Wildlife","year":"1999","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/pSiyhQuqvlVDXAZFFs7MOujWIib.jpg","genres":["мультфильм","Детский","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"6029","ru":"Hot Wheels AcceleRacers - Shorts","en":"Hot Wheels AcceleRacers - Shorts","year":"2005","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/bnP13nx6bgJ5fzqZSlknIaztvQd.jpg","genres":["НФ и Фэнтези","Боевик и Приключения","мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"99212","ru":"Филатов","en":"Филатов","year":"2020","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/pWNrNQKdUsF3lMZo9YIpdaux04b.jpg","genres":["комедия"],"overview":"Доктор Андрей Филатов (Федор Бондарчук) — профессионал и один из лучших гинекологов столицы. Обаятельного и харизматичного врача обожают буквально все окружающие его женщины, однако вот уже тридцать лет он остается верен жене Алисе (Олеся Судзиловская), с которой познакомился еще в студенческие времена. Внезапный уход жены становится для Филатова полной неожиданностью. Пытаясь заполнить образовавшуюся пустоту в своей жизни, гений медицины начинает поиски новых отношений, но вскоре понимает, что Алису, идеальную во всем, никто не сможет заменить, и решает во что бы то ни стало ее вернуть…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"248612","ru":"Звёзды","en":"Звёзды","year":"2024","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/dfNfJ5Nzb7OKpgiiWYToEEXAEie.jpg","genres":["комедия","Ток-шоу","Реалити-шоу"],"overview":"Десять топовых звёзд сойдутся в баттле за звание самой смешной звезды России и приз 20 миллионов рублей. Помогать им будут лучшие юмористические команды страны.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"155307","ru":"Бесит","en":"Бесит","year":"2022","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/yyddKBOPVMg2gA4UyaQfMONhvPE.jpg","genres":["комедия","драма"],"overview":"Сатирический сериал о проблемах, которые волнуют современное общество. Все серии альманаха — самостоятельные истории, снятые разными режиссерами, о странных, раздражающих и даже страшных моментах нашей жизни. Сериал поднимает такие важные темы, как домашнее насилие, чрезмерные родительские амбиции, безумие тик-токеров и их аудитории, требования общества к девушкам и многое другое. Главный критерий темы — актуальность.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1275052","ru":"Hamlet","en":"Hamlet","year":"2024","type":"Фильм","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1BZhswTQ2ClqnQl1zKbpLbqgCsa.jpg","genres":["драма"],"overview":"Гамлет, принц Датский, впадает в отчаяние, когда его овдовевшая мать выходит замуж за его дядю. Явление призрака его отца открывает Гамлету глаза на тайные делишки дяди…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"232590","ru":"Швы","en":"Sutura","year":"2024","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ndgzTFsSsq2bUWYLwmh9F7qkrwP.jpg","genres":["драма"],"overview":"Два врача переступают грань закона - блестящий хирург и подающий надежды ординатор погружаются в криминальный мир, становясь личными врачами опасной преступной группировки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"246156","ru":"Капоэйра","en":"Capoeiras","year":"2025","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/eJLu75YnXj3NeFrZv2ZM0iBf6pY.jpg","genres":["Боевик и Приключения"],"overview":"История, сочетающая в себе элементы экшена, драмы и духовности, повествует о двух молодых капоэйристах, объединённых крепкими узами дружбы и судьбы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"128075","ru":"Призрак","en":"Призрак","year":"2021","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/bbM70FvhjyU8UI9Sw5Es63dQcLi.jpg","genres":["Боевик и Приключения"],"overview":"Его зовут Призрак. Он не помнит кто он и откуда. Он не помнит своего настоящего имени и прошлого. Все, что сохранила его память – лицо напуганной женщины. Единственная зацепка – татуировка с координатами схрона, в котором его ждет оружие, деньги и поддельные паспорта. Призрак узнает свой адрес в Москве и уговаривает случайно встреченную девушку Алену отвезти его туда на машине. А в это время по их следам уже идут хозяева Призрака, которые стремятся любой ценой вернуть себе свою смертельно опасную куклу, которая так внезапно вышла из-под их контроля.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"239702","ru":"Тамбурмажоретки","en":"Trompoppie","year":"2023","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8SWP0JFIgphbFDv6ZbfCKT0bxY.jpg","genres":["драма"],"overview":"Когда талантливая гимнастка Луна получает стипендию в престижной частной школе, она сталкивается с жестоким миром барабанщиков, известных как \"тамбурмажоретки\". После неудачи в ритуале дедовщины начинают происходить загадочные убийства среди чирлидеров.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1016639","ru":"鬼吹灯之精绝古城","en":"鬼吹灯之精绝古城","year":"2022","type":"Фильм","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cpDYNU6fwe4ZJ5tMDjFYWcxVaJL.jpg","genres":["драма","боевик","фэнтези","триллер","приключения"],"overview":"Группа исследователей находит ужасных существ в ходе подземных раскопок. На основе одноименного романа.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"295241","ru":"AIR","en":"AIR","year":"2025","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/uU4zmRjkPXb25qrC8tfs1xFwBCG.jpg","genres":["драма","комедия"],"overview":"1980-е. Продавец кроссовок из фирмы Nike Сонни Ваккаро и соучредитель Nike Фил Найт пытаются подписать контракт с многообещающим спортсменом Майклом Джорданом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"210521","ru":"Сто дней свободы","en":"Сто дней свободы","year":"2020","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/26DnSA7LRSQzHdCNo8i9m3B7lqd.jpg","genres":["Война и Политика","драма"],"overview":"У Петра Авдеича позади десять лет тюрьмы - десять несправедливых лет за контрреволюционную пропаганду. Он вернулся в свой обветшалый дом, на улицу, где все соседи его сторонятся. Но теперь он обрёл главное - свободу, с которой не намерен расставаться ни при каких обстоятельствах. Наступление немецких войск, недоверие внучки и её товарища - ничто не заставит его поменять свои планы, впереди у Авдеича целых сто дней свободы...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"688266","ru":"Shooter","en":"Shooter","year":"2022","type":"Фильм","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/aDbEoU2J0NSBePJsY7HQtKxt2Pl.jpg","genres":["боевик","криминал"],"overview":"Опытный снайпер Бобби, работающий в ФБР, оказывается втянутым в заговор с целью убийства президента. Похоже, что его хотят подставить и «сдать» властям, поэтому ему необходимо как можно быстрее найти и обезвредить настоящего убийцу…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1105203","ru":"Паралимпиадашы","en":"Паралимпиадашы","year":"2022","type":"Фильм","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/e1wFLjn06s2ylZtLXbYVlsCmtO3.jpg","genres":["драма"],"overview":"Максат - молодой и перспективный лыжник, с детства мечтающий завоевать Олимпийское золото. Но из-за жуткой аварии он лишается ноги. Долгое время спортсмен пребывает в депрессии, пока ему не предлагают попробовать свои силы на Паралимпийских играх...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"296951","ru":"Brazzers Exxtra","en":"Brazzers Exxtra","year":"2024","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/9P8wP5amje4nEYWph1DYzbLWunO.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"303911","ru":"Meri Zindagi Hai Tu","en":"Meri Zindagi Hai Tu","year":"2025","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8b03VAX3nKe4MLDaUoxDlofE85b.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"111354","ru":"あざとくて何が悪いの？","en":"あざとくて何が悪いの？","year":"2020","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/huWuJ3iVW69YyhPL2CS8o5M0uFx.jpg","genres":["Ток-шоу","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":"