g":""},{"id":"198466","ru":"スターズこれくしょん！","en":"スターズこれくしょん！","year":"2022","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/krtrzRKlxaUBpKWkAjlbkvZoee6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sw8wL6cWa8KuN44Egkaf1BzmbmC.jpg","genres":["Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"304581","ru":"잔망루피","en":"잔망루피","year":"2025","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ovo95Rb4OfEGqmG8rHKux4Q25KN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mLVQkKgceHfv2wNhrjaGSbExHGw.jpg","genres":["Мультфильм","Детский","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"43782","ru":"Гайарт: Происхождение выживших","en":"創世機士ガイアース","year":"1992","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4kZmAqdvUW3rgBjVexcRUi4e0Es.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yrWJ1ZGSIQAVNXkMgEUX8e5qtMB.jpg","genres":["Мультфильм","Боевик","Драма","Фантастика","Война и политика","Аниме"],"overview":"История началась далеко в будущем, где глобальная катастрофа уменьшила цивилизацию до примитивного государства, хотя большинство технологий были сохранены. Кроме того, война продолжается с участием безумных автоматизированных солдат, в то время как боевые роботы, интеллектуальные роботы воины - единственное, что способно защитить остатки человечества. В особенности одинокий боевой робот Заксон, последний оставшийся в живых после Великого сражения, все еще искренне преследует свою цель - защитить Гайfрт. Он взял с собой мальчика, которого обучил искусству войны. Легенды гласят,что этот мальчик имеет огромное значение в будущем человечества.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"204964","ru":"История любви","en":"Déjate querer","year":"1993","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/d4QfrGFNFEHzcfsDm6wlVPbp93X.jpg","backdrop":"https://image.tmdb.org/t/p/w780/58TgKra21gmqJ77dke2Ys1d0fJe.jpg","genres":["Драма","Аниме"],"overview":"Сериал повествует о жизни Андреса Мачадо – сына богатых родителей. Мать его умерла, отец же второй раз женился на своей красивой и молодой любовнице Ванессе. Андрес, прекращает все связи со своей семьей и, зажив спокойной жизнью, собирается жениться на любимой девушке Джулии. Все в его жизни, казалось бы, наладилось и течет своим чередом, но это до тех пор, пока он не встречает манекенщицу по имени Барбара, полностью поменявшую его жизнь. Андрес, не желая рассказывать Барбаре о том, что он богатый наследник, представляется девушке простым клерком. С этих пор и начинаются трудности для Андреса. Мачадо одновременно встречается с Джулией и Барбарой, пока те не узнают об их невольном соперничестве за него. Андресу приходится принимать серьезное решение, и в выборе между девушками он останавливается на Барбаре, сердце которой необходимо завоевать заново.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"11287","ru":"Plasmo","en":"Plasmo","year":"1997","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/2MQwBqhHRrb002XFL7QxKr5oTFI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kb2FuXGruaPA6ErjOpcifpCyPyY.jpg","genres":["Мультфильм","Аниме"],"overview":"Джимми Дуган — бывший бейсболист, чьи славные дни в Большой Лиге уже миновали. Его приглашают тренером в Женскую Бейсбольную Лигу, созданную в 1943 году, когда все мужчины были на войне. Видя отчаянное стремление и решительность своих подопечных, он забывает о своем пессимизме и обретает уверенность в себе и своей команде.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"85399","ru":"The Reward: Tales of Alethrion","en":"The Reward: Tales of Alethrion","year":"2015","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vq3XRWyQRNLqFlcAzkLJ8W0lPHi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n3ssD31D9cPx87buB4iGVf5IEjI.jpg","genres":["Боевик","Мультфильм","Аниме"],"overview":"Молодой моряк Синбад и его друг Али находят карту к невероятному сокровищу и едут зайцем на борту судна, чтобы добраться до места где это сокровище зарыто. Они в конечном счете убеждают капитана судна изменить курс и помочь им найти сокровище. В пути они сталкиваются лицом к лицу с злым Визирем, гигантской птицей, водоворотами и другими препятствиями.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"85087","ru":"萌鸡小队","en":"萌鸡小队","year":"2017","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/sGYZka0Pp936xDuiUJCrLq9Dsd9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j4CaFbFjQVxLJU2tFiDLALpuslg.jpg","genres":["Мультфильм","Детский","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"128828","ru":"VS騎士ラムネ＆40FRESH","en":"VS騎士ラムネ＆40FRESH","year":"1997","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4xjcXVxrpLNCQEgJBIV3LqNYoxO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/53238ayMKMIGHR0qRtWM4Pyiwwr.jpg","genres":["Боевик","Мультфильм","Комедия","Фантастика","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"89323","ru":"ヤッターマン","en":"ヤッターマン","year":"2008","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/jRRUIrovhMXTEgZUeKUNo5axAt2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hY6p99ZpYtFY20RWKeXxvmQFdhp.jpg","genres":["Мультфильм","Боевик","Комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"47310","ru":"Shelley Duvall's Bedtime Stories","en":"Shelley Duvall's Bedtime Stories","year":"1992","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/fir0N8Xedwh5gvh5QpXKdNAW967.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vc1OwahCMvqU94YBPbcCHXheUDj.jpg","genre