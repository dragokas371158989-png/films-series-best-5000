79LMQWcuO15kt.jpg","genres":["ужасы","триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"928735","ru":"Sonne","en":"Sonne","year":"2022","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/wyfiXDcI6BIiF4rTD6jpthYtNMP.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"881233","ru":"A Fiancé for Christmas","en":"A Fiancé for Christmas","year":"2021","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/pcCyB7ZfMvcI8H9ZMxDmIkQWVNH.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"262642","ru":"Мисс 60","en":"Miss Sixty","year":"2014","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/eYgNRgune5Z90IAZ8wG2NVf3nhW.jpg","genres":["телевизионный фильм","комедия","семейный"],"overview":"Луизе только что стукнуло 60. Несмотря на то, что она талантливый ученый и обладатель всякого рода наград в области молекулярной биологии, начальство с нескрываемой радостью отправляет ее на пенсию. Но что день за днем делать без работы ей, полной энергии женщине, в одной квартире с пожилой мамой? Луиза вспоминает, что 20 лет назад в рамках научного эксперимента она отдала в заморозку свои яйцеклетки. Её страстно поглощает идея стать матерью. Единственное, что нужно для воплощения мечты – это найти достойного донора спермы…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"539827","ru":"Потаскухи или естественно-порочное наслаждение кожи","en":"Les Salopes ou le sucre naturel de la peau","year":"2018","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/kUliSFoSUqUTB7HigXH7b7e2VEZ.jpg","genres":["драма"],"overview":"Профессор-дерматолог решает в одиночку провести научный эксперимент, чтобы обнаружить связь между чувствительностью клеток кожи, любовью и сексуальностью. Однако в процессе внезапно раскрываются тайные стороны её натуры, что приводит к разрушительным последствиям как для её личной жизни, так и для профессиональной карьеры.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"346666","ru":"Притворщики","en":"Pretenders","year":"2019","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/eWPltanYK8ijio8SFgrGCumIEB0.jpg","genres":["драма"],"overview":"Действие разворачивается в Нью-Йорке 80-х годов прошлого столетия. В центре истории — два друга-студента, которым «повезло» влюбиться в одну и ту же девушку. Ребята заканчивают колледж, но любовная история на троих на этом не завершается — напротив, растягивается на целых 10 лет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"463905","ru":"جواب اعتقال","en":"جواب اعتقال","year":"2017","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/3x4AQyeNvzoDMw3DGCMoQMU1Scf.jpg","genres":["боевик","криминал","триллер"],"overview":"Халед Дегви зачислен в одну из террористических группировок, веря, что они сражаются во имя Бога, и когда его брат Ахмад пытается присоединиться к этой группе. Халед отказывается, он пытается остановить его, но тот присоединяется, и однажды возникает спор между Ахмадом и одним из членов этой общины, Ахмеда убивают, а Халид сходит с ума, который ищет мести против группы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"385750","ru":"Рубаха-парень и весельчак","en":"Folk Hero & Funny Guy","year":"2016","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/dLazZ9AiumqJXBpF3x08b5NyOfh.jpg","genres":["комедия","драма","музыка"],"overview":"Успешный музыкант пытается помочь другу-комику, страдающему от неразделенной любви, и нанимает его для своего сольного турне.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"459583","ru":"Клуб сталкеров","en":"The Stalker Club","year":"2017","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/98o5v5Iu9x58X4PwGdRrCKd5BXU.jpg","genres":["телевизионный фильм","детектив","триллер"],"overview":"Молодая девушка и её друзья начинают играть в загадочную игру, которая постепенно становится всё более реалистичной и пугающей. Героиня оказывается мишенью для неизвестного сталкера – чтобы спастись, ей нужно узнать, кто её преследует.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"26834","ru":"TRL","en":"TRL","year":"1998","type":"Сериал","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/kzjtc9bdEvy3ilAlfzq16CgFtuC.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"19105","ru":"Alan Carr: Chatty Man","en":"Alan Carr: Chatty Man","year":"2009","type":"Сериал","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/8GLTQ9uNBr4PwG9ghqhfKdnLKEO.jpg","genres":["Ток-шоу","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"490545","ru":"Der Geschmack von Leben","en":"Der Geschmack von Leben","year":"2017","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/mV5VCP8WS69ho4ds6eAbJ4qcarK.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"368489","ru":"Mørke rum","en":"Mørke rum","year":"2015","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/yikxZh1WlhqSxHS6NBLoDbNTtHs.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"205392","ru":"Strange Frame","en":"Strange Frame","year":"2012","type":"Мультфильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/kuOGun9Nw5WZg5MWynKTQLm5qX4.jpg","genres":["фантастика","мелодрама","боевик","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"459938","ru":"Beauty Mark","en":"Beauty Mark","year":"2017","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/ePTaQrmkUJ9n11BQH7K4BCkX24s.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"320662","ru":"Cam Girlz","en":"Cam Girlz","year":"2015","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/wCydBomUxeVeaKJIBZkNx2OMSBQ.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"306825","ru":"Deadly Daycare","en":"Deadly Daycare","year":"2014","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/wA1fSNt3EHr62m36JzNaPJHyfkW.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"423335","ru":"തോപ്പില്‍ ജോപ്പന്‍","en":"തോപ്പില്‍ ജോപ്പന്‍","year":"2016","type":"Фильм","rating":5.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/qIVko33XkOWk79P6cHHhuLZv9Oj.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_77724","ru":"Любовный треугольник","en":"立花館To Lieあんぐる","year":"2018","type":"Аниме","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/8BdGEsgjkUEm2wM8lVSlhvIC8u3.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Нацуно Ханаби, спустя несколько лет, возвращается в родной город, чтобы поступить в старшую школу. «Теперь у меня новая, прекрасная жизнь», — думала она, но Татибана, общежитие, в котором собиралась жить Ханаби, стало не тем местом, о котором она мечтала. Ей предстоит сделать выбор: подруга детства или загадочная красотка? Станет ли этот любовный треугольник для нее началом новой жизни?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"132318","ru":"Новые капризы Апельсиновой улицы","en":"新きまぐれオレンジ☆ロード ～ そして、あの夏のはじまり","year":"1996","type":"Аниме","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/1Ah5etarzUppjokJMqdUkP3AMCw.jpg","genres":["мультфильм","Аниме"],"overview":"Для главных героев прошло несколько лет. Таинственный телефонный звонок нарушает покой и предупреждает Кёсукэ Касугу об опасности встречных автомобилей, однако юноша не придаёт этому никакого значения. По иронии судьбы он всё-таки попадает под машину. После столкновения с автомобилем юноша из-за своих телепатических способностей отправляется на три года в будущее, в котором он, будучи 22-летним фотографом, отправился в Боснию и пропал там без вести, после чего в Японии был признан погибшим. Молодой человек начинает искать себя из будущего, чтобы вернуться в правильное время. По пути он встречает старую подругу Хикару, которая сейчас является профессиональной и знаменитой танцовщицей. В то же время Мадока впадает в уныние из-за того, что друг детства пропал. В этой истории главные герои пересекутся вновь, и отношения Мадоки и Кёсукэ будут страстными как никогда.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"96926","ru":"バトルスピリッツ 龍虎の拳","en":"バトルスピリッツ 龍虎の拳","year":"1993","type":"Аниме","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/aJpjkgi1Pp7XF0wP9IbTm6zFKxU.jpg","genres":["боевик","мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"641167","ru":"Супер Майки","en":"Onze Jongens in Miami","year":"2020","type":"Фильм","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/e3NC6UetbWeIrueB0poJoSDCswE.jpg","genres":["комедия","музыка"],"overview":"Обаятельный стриптизер Джоррит и его лучший друг Бас направляются из Голландии в Майами, чтобы открыть свой стриптиз-клуб. Они начинают строительство, которое сопровождается весельем и горячими танцами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"665761","ru":"Миньян","en":"Minyan","year":"2020","type":"Фильм","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/kbihQtYEe7V6u5WZ1H9WfMk3ln1.jpg","genres":["драма"],"overview":"Конец 1980-х, нью-йоркский Бруклин. Юноша Дэвид, обучающийся в строгой ортодоксальной ешиве, помогает дедушке обустроиться в доме престарелых в их русско-еврейском районе (кстати, в этом американском фильме немного говорят и на русском языке, а также на идиш и иврите) и параллельно неожиданно находит себе сообщество по интересам — знакомится с двумя геями постарше из Ист-Виллиджа, которые и помогают ему открыть себя. Тем временем в Нью-Йорке начинается эпидемия ВИЧ.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"847463","ru":"Рождественский шанс","en":"A Chance for Christmas","year":"2021","type":"Фильм","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/rChX9Fhqk8RuHK73sylP3PnOML.jpg","genres":["телевизионный фильм","мелодрама","фэнтези","комедия"],"overview":"Кристине наконец выпадает шанс получить прибыльное спонсорство от бренда своей мечты, если она наберёт два миллиона просмотров на своих видео. Однако внезапно она попадает во временную петлю, и чтобы выбраться из неё, Кристине нужно расставить приоритеты в своей жизни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1000683","ru":"Schock","en":"Schock","year":"2023","type":"Фильм","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/6bJQKYWUaJrddMVZwEmj3oaaETa.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1504382","ru":"Sweet Revenge","en":"Sweet Revenge","year":"2025","type":"Фильм","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/us8m2EhaFBbqGnSAOZvfwQM0EtH.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"668013","ru":"Tahara","en":"Tahara","year":"2020","type":"Фильм","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/822pR9FSkNPuUZeEesjozfUrLAO.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"34037","ru":"Волшебный Пудинг","en":"The Magic Pudding","year":"2000","type":"Мультфильм","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/5bifqYXdl6xbHpmOWn6lYp9xKgQ.jpg","genres":["мультфильм","музыка","семейный"],"overview":"Узнав однажды, что его родители живы и живут где-то далеко-далеко, медвежонок отправляется на их поиски. Во время путешествия его ждут забавные и порой опасные приключения, знакомства с добрыми друзьями - пингвином Сэмом, морячком Биллом, волшебным пудингом Альбертом, а также a со злодеями Опоссумом и Вамбатом и многими-многими другими. Несмотря на все трудности, маленький коала никогда не забывает о цели своего путешествия, в конце которого его ждет счастливая встреча с родителями...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"442285","ru":"Le Rempart des Béguines","en":"Le Rempart des Béguines","year":"1972","type":"Фильм","rating":5.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/ppKLGOs4usWfakdZxi3UZfhX3QQ.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1326443","ru":"Предыдущая сохранённая версия","en":"不都合な記憶","year":"2024","type":"Фильм","rating":5.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/oD55ugIFIxSZlxCb8Ny8P68F6EA.jpg","genres":["триллер","мелодрама","фантастика"],"overview":"Действие фильма происходит в 2200 году, когда миграция людей в космос и передовые технологии позволяют манипулировать памятью. Наоки и Маюми, живущие в роскошной плавучей резиденции в космосе, на первый взгляд кажутся идеальной парой, которой любой мог бы восхищаться. Однако их истинная природа - это искаженная любовь мужа, Наоки, который стремится отомстить своей жене и превращает ее в андроида, чтобы воссоздавать свой собственный идеал.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"800409","ru":"Зарница","en":"Зарница","year":"2021","type":"Фильм","rating":5.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/w8MEGx1xLq58Ud1MllhNy0UKixe.jpg","genres":["драма"],"overview":"16-летняя Алиса, бойкая и талантливая девочка, попадает в кадетский корпус для парней и девушек и влюбляется в своего одноклассника Андрея. Но Андрей не терпит конкуренции, и Алисе придется сделать выбор: победа в военных состязаниях или любовь парня.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"589973","ru":"Герой СамСам","en":"SamSam","year":"2020","type":"Мультфильм","rating":5.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/qFutgs7KShzOYVSfZSkmOUvoF9P.jpg","genres":["мультфильм","семейный","фантастика","приключения","комедия"],"overview":"СамПланета в опасности! На родную обитель знаменитого СамСама напали Мрачуны — инопланетные жуки, которые распространяют по всей Вселенной… грусть. Чтобы победить полчища Мрачунов, герою на помощь придет его давняя подруга по переписке с соседней планеты.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"612995","ru":"Gledelig jul","en":"Gledelig jul","year":"2020","type":"Фильм","rating":5.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/mNvlAijXVyGjZUmffpSkmGfaPA9.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1077328","ru":"Fuks²","en":"Fuks²","year":"2024","type":"Фильм","rating":5.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/r3yxvHMcIsefxh1iELl1EtjNlI5.jpg","genres":["комедия","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"639414","ru":"डॉली किट्टी और वो चमकते सितारे","en":"डॉली किट्टी और वो चमकते सितारे","year":"2020","type":"Фильм","rating":5.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/u2zXyprTj1Z09WO