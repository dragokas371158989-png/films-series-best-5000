 город Хайдарабад. Кто бы мог подумать, что в этом мегаполисе Кальян Синх изменит своим принципам и станет вести себя, как оборотень в погонах?! В кратчайшие сроки полицейскому удаётся заработать внушительное состояние, полностью потеряв доверие и уважение со стороны жителей города. Но вскоре оказывается, что Синх чётко спланировал все свои действия для достижения какой-то более масштабной цели.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"471492","ru":"Сегодня тоже актриса","en":"여배우는 오늘도","year":"2017","type":"Фильм","rating":6.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/YzXyzhszXVvt6b0y3jWr7CyNy9.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"495748","ru":"Ask for Jane","en":"Ask for Jane","year":"2019","type":"Фильм","rating":6.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/3XsIhwleMWvaaxGvltMmnxybjjN.jpg","genres":["драма","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"248080","ru":"喜羊羊与灰太狼之喜气羊羊过蛇年","en":"喜羊羊与灰太狼之喜气羊羊过蛇年","year":"2013","type":"Мультфильм","rating":6.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/kuNETzfM0KRGtts0HWPpCKCHNes.jpg","genres":["мультфильм","семейный","приключения","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"367960","ru":"The Spymasters: CIA in the Crosshairs","en":"The Spymasters: CIA in the Crosshairs","year":"2015","type":"Фильм","rating":6.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/uILhPFwkz6dIthqt6TBFNGiCBXm.jpg","genres":["военный","драма","документальный","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"450654","ru":"Out of the Shadows","en":"Out of the Shadows","year":"2017","type":"Фильм","rating":6.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/62jQD0UP8uJO05dukPwLdWndG81.jpg","genres":["ужасы","триллер"],"