sXsKKEXm9v.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ct4nosIUdH0yMQhGg3tv3tZkohC.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1181865","ru":"二手杰作","en":"二手杰作","year":"2023","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/4nnaovllxETxPv88w1MgCmHMRbJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kzNMp34EbB2dVzLzsLbBEk8Umry.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"790233","ru":"Trafficked: A Parent's Worst Nightmare","en":"Trafficked: A Parent's Worst Nightmare","year":"2021","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/zu6oJbB8cjA25vnlNKrq7QPJqSv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sQA5XfsHJm91M4ULstpw21LrFlq.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"258456","ru":"Без корней","en":"Köksüz","year":"2013","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/wNBwJNRkg3UnhyxHu26MxXNdyVA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k7vIIpnnajDM7GcLpJ7p9ObEQf.jpg","genres":["драма"],"overview":"В семье случается несчастье. Отец внезапно умирает. Роль его должна взять на себя старшая дочь Фериде, поскольку мать Нурджан находится в беспомощном состоянии. Еще у Фериде есть младший брат Илькер и совсем маленькая сестра Озге, которых тоже надо кормить, одевать и воспитывать. По истечении некоторого времени, вся семья уже воспринимает Фериде в роли отца. Отношения в семье постепенно начинают рушиться для каждого члена семьи. Брат Фериде начинает постепенно отдаляться от семьи. В связи с этим, младшая сестренка чувствует себя очень одиноко. Мать относится к Фериде так, как-будто она потеряла не мужа, а дочь. Тогда Фериде решается на отчаянный поступок, который должен сделать жизнь каждого значительно лучше","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"351217","ru":"Шальные пули","en":"Stray Bullets","year":"2017","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/rPfUyf0IuHJnbDfLtIPtWfNvTRe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/krsTB8W745tVNHvptJ6uapb8EJi.jpg","genres":["криминал","драма","триллер"],"overview":"В пригороде Нью-Йорка пара подростков планирует посвятить день уборке в трейлере отца. Но когда мальчики оказываются в трейлере, то понимают, что в нём пытаются скрыться три беглых преступника.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"72870","ru":"Синбад","en":"Sinbad","year":"1992","type":"Мультфильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/7sXyuaop1axHVfim6Y43sRzawPN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mdUkuPpEZts0Mkf2ttJRZBcDdrW.jpg","genres":["мультфильм","приключения","семейный","фэнтези"],"overview":"На долю легендарного Синдбада-морехода выпало немало приключений. Но сколько бы опасностей не стояло на пути - Синдбад преодолеет их все, чтобы достичь своей цели.Храбрый мореплаватель Синдбад и его верный слуга Хабиб оказываются на борту корабля капитана Азиза, поездка, за которую Синдбад потратил всё состояние своего отца. Они приближаются к неизведанному острову, к которому Синдбад просит капитана приблизиться, надеясь, на то что на нём неисчислимые богатства. Синдбад, Хабиб и два других моряка плывут в лодке на остров, который имеет странный вид: он плоский и голый, без травы, деревьев или песка. Остров сотрясается и два моряка возвращаются на корабль капитана Азиза, оставляя Синдбада и Хабиба позади. Остров раскрывает себя как плавник гигантского морского монстра, который уплывает. Корабль капитана Азиза тоже уходит, оставляя Синдбада и Хабиба посреди океана.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"262682","ru":"Петсон и Финдус. Маленький мучитель – большая дружба","en":"Pettersson und Findus - Kleiner Quälgeist, große Freundschaft","year":"2014","type":"Мультфильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/p1SOVe5RVYTMI7xPKx8vp7WRLxA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hsz5A3h5yUnbqhc0RJhXYDbVVhm.jpg","genres":["семейный","комедия","мультфильм"],"overview":"Старик Петсон живет в небольшом красном доме. Постоянных хлопот у него достаточно: дрова порубить, порыбачить, присмотреть за домашними курами и разработать какое-нибудь изобретение. Однако временами Петсону бывает одиноко. И вот у старика появляется котик, который однажды начинает говорить. Тут-то между ними и начинается большая дружба.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"396538","ru":"Сражение","en":"Бій","year":"1986","type":"Мультфильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/e9uyEXMBSTADCqnmjJ4Hj0yHw7n.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dtM2KlgOF6JBcEVOoJ87qdV5Dzb.jpg","genres":["мультфильм","боевик"],"overview":"Мужчина убивает дизайнера игрушек и крадет его последний товар. Продукт, мини-армия, укомплектованная оружием, затем ведет войну с убийцей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"5266","ru":"University Challenge","en":"University Challenge","year":"1962","type":"Сериал","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/yDLoEEFW3D6XSyT8UynTghc1Dyw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xyQzudpyxNGdFlvSWw4cKZQ41L.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"529694","ru":"Benched","en":"Benched","year":"2018","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/lw8p6onVjgDIAnLiutqNk8j37Iy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1D4f2uzKygtnDNLWKiPeFTSRD6v.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"354034","r