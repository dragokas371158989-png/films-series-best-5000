,"backdrop":"https://image.tmdb.org/t/p/w780/1n51RpkKadsne3qru2fzQp21LIA.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"446353","ru":"Forever Now","en":"Forever Now","year":"2017","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/quRnw8eH45N2y0O989wsHppS2Wj.jpg","backdrop":"","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"401609","ru":"Sexo salvaje","en":"Sexo salvaje","year":"2015","type":"Фильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/hSVcKx54q2uTfxYRRhzTtqnJm6L.jpg","backdrop":"","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"578763","ru":"武者・騎士・コマンド SDガンダム緊急出撃","en":"武者・騎士・コマンド SDガンダム緊急出撃","year":"1991","type":"Мультфильм","rating":5.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/uStToahCy2wyoGEErjiZd52kOyB.jpg","backdrop":"","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"34210","ru":"Охотники за чародеями","en":"爆れつハンター","year":"1995","type":"Аниме","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6KFn9urQO0JDXcSNHyCeaHLfUxr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o7F9KAbj7c5XO3mjAWbhwclRrb2.jpg","genres":["мультфильм","НФ и Фэнтези","комедия","Боевик и Приключения","Аниме"],"overview":"Фэнтези - мир, континент Спунер. Власть в мире принадлежит чародеям - существам, с рождения наделенным умением творить волшебство. Пользуясь своими талантами, чародеи игнорируют правительства и законы. Чтобы держать магов в узде, таинственное существо по имени Большая Мама собирает команду талантливых, но не прирожденных магов. Им даются большие полномочия и приказ - не допустить Конца Света. Однако эти пять воинов сами могут кому угодно устроить Конец Света.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1053059","ru":"Холодная дорога","en":"Cold Road - Eiskalte Rache","year":"2024","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/vIl9DwIcTu88XmseZ2W4idm6PXx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/raZXXe1Pj4K42uS9aJkZQvbcill.jpg","genres":["триллер","боевик"],"overview":"Чтобы попрощаться со своей умирающей матерью, Трейси отправляется со своей собакой в ​​двенадцатичасовое путешествие по замерзшему шоссе на крайний север Канады. Но путешествие превращается в кошмар, когда её внезапно преследует грузовик и за ней охотится загадочный водитель.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1129557","ru":"Лобби","en":"로비","year":"2025","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/9fFSXOoqiUi7bhEs1jt24SsPmpx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n9dnPIb1PYJtAJeX9X8phyibJoI.jpg","genres":["комедия","драма"],"overview":"Руководитель компании, которая специализируется на исследованиях и сталкивается с финансовыми трудностями, решает использовать грязные методы, чтобы выиграть государственный тендер.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"924341","ru":"Прощай, Петрушка","en":"Goodbye, Petrushka","year":"2022","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6gk3v50w3SaGgRmHNVSWaSdjfnm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tl8tdPzoMyoAUq0iuhIlWOplvfI.jpg","genres":["комедия","мелодрама","драма"],"overview":"Клэр - студентка колледжа, которая оказалась на перепутье в жизни. По сути, над ней издеваются на уроке драматургии её учитель и одноклассники, и ей не дают шанса стать самостоятельной. Сердитая и подавленная, Клэр столкнулась с Тибо, чемпионом по конькобежному спорту из Франции, которого недавно вынудил уйти в отставку какой-то администратор. Клэр думает, что между ней и Тибо пробежала искра, но он исчезает в мгновение ока. Расстроенная до предела лучшая подруга Клэр, Джулия, уговорила её переехать с Джулией во Францию для того, чтобы начать всё сначала. Тогда, может быть, если звезды сойдутся, она столкнётся с Тибо. Итак, план прост: переехать во Францию, работать помощницей по хозяйству, познакомиться со знаменитой тетей Джулии-кукольницей, чтобы помочь ей с ее шедевром кукольного театра, и, возможно, влюбиться.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"933336","ru":"Второй шанс на любовь","en":"A Second Chance at Love","year":"2022","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/5yASwcJhPEN0q99jYVcr4pdfZEx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rON4JT1RI4ZDyThlsIuOqBr0NHi.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"Брак Алиши и Арнольда на первый взгляд кажется идеальным. Однако, Арнольд хочет детей, а Алиша — нет. Она решает заняться личной жизнью своих разведенных родителей и регистрирует их на сайте знакомств.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1181952","ru":"刀尖","en":"刀尖","year":"2023","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/84ArHAPWQYVoFCFBTUgVROxwqhK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q7uNVJCQEdpQXhA2bvXzBya1jz1.jpg","genres":["боевик","драма","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"695396","ru":"Love Spreads","en":"Love Spreads","year":"2021","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/m6jZmJmaotVIuQvCuR7ORrnW3EB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3tIyRjmQs6osKcLmQf68LZTDn3Q.jpg","genres":["комедия","драма","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"934027","ru":"Coffee Wars","en":"Coffee Wars","year":"2023","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/jUFyMJqKU6Izip7Hx4rzRnR9jIW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jhKNqPSoWMaAAIio8z1s7tuNLmB.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"913854","ru":"Framing Agnes","en":"Framing Agnes","year":"2022","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/fgF6uUZ6Xus8dKBTWk49DICdq03.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f7zrgyGgdrSQgPEzgn9GlJEoGw.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1282417","ru":"الهوى سلطان","en":"الهوى سلطان","year":"2024","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/vJ9598K1QL8nTYzWgKyw80e6snX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3zUc5KC2qQAqyeuFT9XrX1mJtlM.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"987911","ru":"Piranha Women","en":"Piranha Women","year":"2022","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/c8evzzICXGXuwd6Tx0ealM7ORuU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/faBecyV2MHGdgaTm5qSGjJzRRCN.jpg","genres":["ужасы","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"724735","ru":"In Berlin wächst kein Orangenbaum","en":"In Berlin wächst kein Orangenbaum","year":"2020","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/mjjpev5dtVXcGuc6iSIw1HZiRWn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iWjbsSPE7Z2W0SGU7YTYz5cepJp.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"435145","ru":"Дело \"Кингс Бэй\"","en":"Kings Bay","year":"2017","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6nrgcWDm46IuLkLQxODbDSNVUrX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3d2vAGut5ZrIbhxNasdsU1KZ74g.jpg","genres":["триллер"],"overview":"Страдающая алкоголизмом пожилая журналистка крупной норвежской газеты получает от анонимного источника материалы, которые возможно могут пролить свет на трагические события на шахте Кинс Бэй, ставшие причиной одного из крупнейших политических скандалов в истории Норвегии. Но действительно ли за всем стоит политика? Или все же причина куда более прозаична? Это и решает выяснить Гарриета Гансен, начав своё журналистское расследование, которое быстро привлекает к себе внимание таинственной спец.службы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"496324","ru":"Рекрут Саджан Сингх","en":"ਸੱਜਣ ਸਿੰਘ ਰੰਗਰੂਟ","year":"2018","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/zlOvO4fgun0b5B7AxPnPVV2TCVt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mp7ryCvT7zCmDH2VcfME3OHF9Z9.jpg","genres":["боевик","драма","военный"],"overview":"Действие фильма разворачивается в самый разгар Первой мировой войны. Сюжет картины закручивается вокруг полка сикхов, родиной которых является индийский штат Пенджаб. Представители этого этнического меньшинства совсем не пользовались уважением со стороны британских военных, считавших сикхов людьми второго сорта. Саджан Сингх сражается на передовой на западном фронте. Постепенно главный герой начинает осознавать, что ему и его однополчанам не стоит так рисковать своими жизнями ради людей, которые их эксплуатируют. Ему постоянно приходится сталкиваться с необходимостью делать тяжёлый с точки зрения морали выбор, ведь, несмотря на всю абсурдность этой войны, он должен защищать себя и своих товарищей до последней капли крови…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"601536","ru":"Вдыхая жизнь","en":"Udahnut život","year":"2019","type":"Мультфильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/lztYVEXmbTOQllySDfJUvl6bwad.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8PCKGbrk69ZBiZeYdQLdI94YrrK.jpg","genres":["мультфильм","фэнтези","драма"],"overview":"Фильм о связи девушки с жизненной силой природы. Она использует свой талант к таксидермии, чтобы «возрождать» животных в их естественной среде обитания.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"338399","ru":"ジヌよさらば ～かむろば村へ～","en":"ジヌよさらば ～かむろば村へ～","year":"2015","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/oHmukFeoJe4tSt1e5bHjnby7po6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jWXlxgDrWfm4QO8hw9PFNN2uldS.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"578663","ru":"九月の恋と出会うまで","en":"九月の恋と出会うまで","year":"2019","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/abg5jMjbvIhnsXuLaP9mQ1Yhwa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/z5mHov1cDy3xbElhlWr2AUE2RXs.jpg","genres":["детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"627064","ru":"Real","en":"Real","year":"2019","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/qeIgzcCW4wBsdy9Fv824XDmi56r.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hqByiNd1gabtv94oF5OdiiwrL09.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"554476","ru":"古宅","en":"古宅","year":"2018","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/3xG4rL8vMOvX405Xu8aqdA823Uj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xcfY3jEW4vQE8UDciaNw16Z5B85.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"349200","ru":"ஜீரோ","en":"ஜீரோ","year":"2016","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/61X7qmMTKVgggLoGZS0OycK4XTc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2GR6YWvCdtjt1gHiaJcAJAArV5A.jpg","genres":["фэнтези","ужасы","триллер"],"overview":"","source":"