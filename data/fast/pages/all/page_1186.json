ear":"2024","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/cDNaEw5peNrEHpcPcsjPyMMxZuV.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1107979","ru":"Ancika: Dia yang Bersamaku 1995","en":"Ancika: Dia yang Bersamaku 1995","year":"2024","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/dLsAyZFzx37W1JUqd11JUl4KpZj.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"845318","ru":"Snatched from Mommy","en":"Snatched from Mommy","year":"2021","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/aN7CRysEb8dw6d6YsZYg4NcT8ph.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"795295","ru":"오! 마이 고스트","en":"오! 마이 고스트","year":"2022","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/4V27PCQ0mlVkyJ7cmL7yzHwH5lz.jpg","genres":["детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"6765","ru":"Пеппер Деннис","en":"Pepper Dennis","year":"2006","type":"Сериал","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/pUQWnp3rDclN4oHLJ99iA1voRcw.jpg","genres":["драма","комедия"],"overview":"Пеппер Деннис — честолюбивая репортерша, которая мечтает стать ведущей вечерних новостей Чикаго с самым высоким рейтингом. Ее повседневная жизнь осложняется тем, что к ней приезжает испорченная, нуждающаяся и одинокая сестра Кэти. Но хуже всего то, что некий парень Чарли Бэбкок, с которым Пеппер проснулась однажды утром, неожиданно появился на ее работе, получил работу ее мечты и фактически стал ее боссом. Она пытается презирать его, но Чарли умен, красив и забавен. Пеппер получает необходимую поддержку от своих близких друзей, гримера Кимми и оператора Чика, который тайно влюблен в Пеппер.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"452103","ru":"Меняющий игру","en":"遊戲規則","year":"2017","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/zplswvIvMQEj2NWWGbiFz9jVS27.jpg","genres":["боевик","криминал","драма"],"overview":"После провала операции лидер радикальной студенческой организации Ли Цзыхао сидит в шанхайской тюрьме. В этой же тюрьме сидит и молодой бандит Фан Цзе, который однажды оттуда сбегает. Во время побега Цзе случайно вламывается в камеру к Цзыхао, парни бегут вместе, а после Цзыхао исчезает. Но их пути расходятся не на долго — вскоре беглец спасает Цзе и его сводную сестру от нападения конкурирующей бандитской группировки, после чего Цзе представляет Цзыхао своему крёстному отцу и главе банды мистеру Тану. Бывший радикал и глава преступного мира в прошлом были далеко не друзьями.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"442987","ru":"Наш завтрашний рис","en":"僕らのごはんは明日で待ってる","year":"2017","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/mvlf8drQekYlNuH3ZMtwU3omcM6.jpg","genres":["драма","мелодрама"],"overview":"История любви парня и девушки со старшей школы на протяжении 7 лет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"357995","ru":"Экзорцизм: пещера шамана","en":"퇴마; 무녀굴","year":"2015","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/xP473sjaIIhFmZ5nEEVDUW2nF7K.jpg","genres":["ужасы"],"overview":"Раньше Гым-Джу жила совершенно обычной жизнью, в которой не было места пугающим странностям или чему-то подобному. Она и не подозревала, что однажды всё изменится. Постепенно девушка начала замечать за собой разные странности. Необъяснимые явления, которые с ней происходят, вынуждают Гым-Джу обратиться к профессионалу. Чтобы выяснить причину происходящего, героиня приходит на приём к Джину-Мёну – известному в Южной Корее экзорцисту и уважаемому психологу. Она не сразу решилась на этот визит, но потом не пожалела, что пришла. Вместе со своим помощником Джин-Гваном мужчина проводит несколько специфических обрядов, которые помогают ему выяснить, что в теле пациентки обитает некая сущность из потустороннего мира. Столь необычное соседство и стало причиной ряда изменений, происходящих с Гым-Джу. Если не изгнать злое существо в кратчайшие сроки, то оно полностью подавит личность Гым. Однако сделать это будет невероятно сложно и опасно, решатся ли герои на необычный шаг?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"297636","ru":"Жизнь ради футбола","en":"Landauer - Der Präsident","year":"2014","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/zYCMrrWYOJRFcKZAbqVhu7huhaW.jpg","genres":["драма","телевизионный фильм"],"overview":"Курт Ландауэр собирается покинуть Германию накануне Второй мировой войны, но когда он видит свою большую любовь, футбольный клуб «Бавария», лежащий в руинах, он решает рискнуть, остаться и возродить клуб.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"41429","ru":"Belonging","en":"Belonging","year":"2004","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/asLhSXTOzeSEoxGXifrosWOlqmY.jpg","genres":["драма","мелодрама","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"451203","ru":"Le verità","en":"Le verità","year":"2017","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/bqB1MbnzUgD88tHzfGtztI1q4q3.jpg","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"426850","ru":"鬼談百景","en":"鬼談百景","year":"2016","type":"Фильм","rating":5.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/pqbQYbcorV47t8S0O0wNJO2B5h4.jpg","genres":["ужасы","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRat