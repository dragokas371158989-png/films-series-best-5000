s":"","studio":"","country":"","ageRating":""},{"id":"821404","ru":"Все, кто её любил","en":"All Who Loved Her","year":"2021","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/eUXjn7RlffHoSmKLm8bSqio39Op.jpg","backdrop":"","genres":["детектив","драма","триллер"],"overview":"Рианна Энгерс последние девять лет одержима жестоким убийством Гвен Андерсон. Оно и понятно: ее брат Ник сел в тюрьму за это преступление. Теперь, когда Ник вышел на свободу, ему нужна ее помощь в поисках настоящего убийцы всегда улыбчивой и счастливой Гвен. Но Рианна не рада возвращению Ника: она расцвела без своего деспотичного и харизматичного брата и не желает лишаться этого. Накануне выпускного и следующего этапа в отношениях Рианна понимает, что ей есть что терять, когда старший брат тянет ее обратно в прошлое.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"989955","ru":"Les raisins de la misère","en":"Les raisins de la misère","year":"2021","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/hcvj7kVOwU33wzFvB8VUO3bO8rz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s4C67V3UOIlbUWF0pQumukud444.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"891749","ru":"개구리","en":"개구리","year":"2020","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/AcfFwVmWrUJkIfdiOdezeP7KD2M.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pV58QHvMWqICRsvjlY99R4jTJFY.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"723301","ru":"남매의 세계","en":"남매의 세계","year":"2020","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/deO1ggpmQg3Rb1lhYFbyP2wBZ2d.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7F4PP8L8hu8gSJiRjjORNtQVWqz.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRa