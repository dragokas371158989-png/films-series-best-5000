ating":""},{"id":"267433","ru":"NOW: In the Wings on a World Stage","en":"NOW: In the Wings on a World Stage","year":"2014","type":"Фильм","rating":6.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/dtaM2VqY9esKiBLOEoTSARndZa8.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"272014","ru":"Bomb Girls: Facing the Enemy","en":"Bomb Girls: Facing the Enemy","year":"2014","type":"Фильм","rating":6.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/vauRWAX6rwLoBW9tx8pPaw2MFbC.jpg","genres":["драма","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"196369","ru":"Четыре человека и ложь каждого","en":"4人はそれぞれウソをつく","year":"2022","type":"Аниме","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/rEIMwIJlwxY9SP4IIdxTDEdOHQ4.jpg","genres":["мультфильм","комедия","НФ и Фэнтези","Аниме"],"overview":"На первый взгляд эти девушки могут показаться обычными школьницами, но на самом деле одна космический пилот, другая ниндзя без клана, третья имеет сверхъестественные способности, а четвёртая вообще переодетый парень…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_91848","ru":"number24","en":"number24","year":"2020","type":"Аниме","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/s0Ph6walJ6E6DhYuUdLN8O6li8R.jpg","genres":["мультфильм","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_72520","ru":"Под юбкой скрывался зверь","en":"スカートの中はケダモノでした。","year":"2017","type":"Аниме","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/5o2TArFnXPzBvLdH97AOnJCfwW0.jpg","genres":["мультфильм","Аниме"],"overview":"Щизука Коминами — студентка колледжа и тихий интроверт — приходит на групповое свидание, но с трудом вписывается в атмосферу, пока с ней не заговаривает красивая старшекурсница по имени Рё. В результате девушки уходят со свидания вместе, и Щизука решает переночевать в доме новой подруги, но там происходит неожиданное: Рё целует Щизуку и укладывает её в постель. Поначалу Щизука думает, что её новая прекрасная знакомая — просто активная лесбиянка, но вскоре обнаруживает внезапную правду: Рё оказывается переодетым в женскую одежду парнем.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1028318","ru":"Монстр и маги синих морей","en":"山海经之再见怪兽","year":"2022","type":"Мультфильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/kmDgAbOZYQCLU71uvVED1YFLnRZ.jpg","genres":["мультфильм","фэнтези","приключения"],"overview":"Пустота Куньлуня, скрытая в горах и морях, вскормила бесчисленное количество существ. Медицинский центр Куньлунь здесь обладает превосходными медицинскими навыками, но есть болезнь, от которой нет лекарства уже тысячи лет — Хэй Линг. Врач Бай Цзэ отдал все свои силы борьбе с Хэй Лин, но подумал, что разорил весь Большой остров, и был выслан из больницы. Семь лет спустя медицинские навыки Бай Цзэ продвинулись как на дрожжах, но он ослеплен другими и не может заниматься медициной.Он хочет использовать больницу, чтобы быть избранным, чтобы отомстить за свой позор, но в сложившихся обстоятельствах он ступает на необитаемый большой остров с Сяо И, мальчиком-единорогом с низкой самооценкой, на пути искупления. Кризис Хэй Линг неизбежен.Смогут ли они разгадать тайну Хэй Линга и спасти все вещи и мир, и могут ли они зажечь свет в сердцах всех живых существ в Куньлуне?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"913850","ru":"Мы встретились в виртуальной реальности","en":"We Met in Virtual Reality","year":"2022","type":"Мультфильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/yOWjw5Z7dqxX4TCr2nFCKpiDraH.jpg","genres":["документальный","мультфильм"],"overview":"Инновационный документальный фильм, снятый в виртуальной реальности, рассказывает о сообществе популярной онлайн-платформы VRChat. Пользователи под причудливыми аватарами знакомятся друг с другом и заводят отношения, которые нередко выходят за рамки видеоигры. Для многих она стала территорией свободы, самовыражения, принятия. Здесь стираются социальные и географические границы, теряют силу все комплексы и условности. Это нециничный взгляд на цифровой мир, где виртуальное переплетается с настоящим и искренним.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1148817","ru":"Вина: Прежде чем пройдут 7 дней","en":"Vina: Sebelum 7 Hari","year":"2024","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/j1xUlKVa8rS1c2mi0cZsjUSJ6G4.jpg","genres":["криминал","ужасы","драма","детектив","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1046183","ru":"I Am കാതലൻ","en":"I Am കാതലൻ","year":"2024","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/9BmQI8BstBeTXAs09uldXiuRZQw.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1075969","ru":"Moonrise","en":"Moonrise","year":"2022","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/nOMQMIphDZuOoAkrktd22dJJnmv.jpg","genres":["драма","музыка","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1101158","ru":"Home, Not Alone","en":"Home, Not Alone","year":"2023","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/AzYPjb05MIBsbwjMoSqHFlnQtd.jpg","genres":["триллер","детектив","телевизионный фильм","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"582902","ru":"Мой друг дельфин Эхо","en":"Dolphin Kick","year":"2019","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/xXQ2qPnVuog6iXgLuumR67kOgpl.jpg","genres":["приключения","семейный"],"overview":"Отдыхая со своей семьей на тропическом острове на Багамах, 10-ти летний Люк знакомится с дружелюбным и игривым дельфином Эхо. Дельфин становится верным другом Люка, с которым он проводит всё своё свободное время, ныряя в волнах и играя целыми днями напролёт. Однажды дельфин Эхо оказывается в опасности. Люк со своей сестрой разрабатывают план, чтобы спасти их нового друга дельфина.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"643413","ru":"Ип Ман и четыре царя","en":"叶问之九龙城寨","year":"2019","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/fdF5ZXpTDW2ZV5VlHWdnfD917sX.jpg","genres":["боевик","драма"],"overview":"1950 год. Время, когда Гонконг ещё был под правлением Англии. Китайские и британские злодеи объединились, и в Гонконге процветают игорный бизнес, продажа наркотиков и работорговля. Однажды доблестный и известный мастер боевых искусств Ип Ман перешёл дорогу этим преступникам, и стал жертвой коварного плана, по которому он попал в тюрьму и его должны будут расстрелять. Сможет ли Ип Ман пробиться сквозь толпы бандитов и добраться до истины? Ответ кроется в этом фильме.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"542590","ru":"Харадзюку","en":"Harajuku","year":"2018","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/f4FaLNfwpZF46a5hRYfnWlqsMVN.jpg","genres":["драма"],"overview":"Вильве – девочка-подросток с голубыми волосами, у которой есть единственная цель в жизни – вырваться из грустного, серого Осло и перебраться в город мечты Токио. Она не ходит в школу, болтается с друзьями и живёт в мире фантазий. Накануне Рождества её встречают сотрудники социальной службы и возвращают к реальности: с матерью произошёл несчастный случай, и теперь она должна встретиться со своим отцом, которого не видела 15 лет.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"472918","ru":"Wiro Sableng: Pendekar Kapak Maut Naga Geni 212","en":"Wiro Sableng: Pendekar Kapak Maut Naga Geni 212","year":"2018","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/kt4Clr3qq4NIXU6ijhDaoXOQqOn.jpg","genres":["боевик","комедия","приключения"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"392898","ru":"Sun Belt Express","en":"Sun Belt Express","year":"2015","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/lwlX0azMBuh0qN2c6Yey2MuYop5.jpg","genres":["семейный","комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"247049","ru":"Лев и Бык","en":"Лев и Бык","year":"1984","type":"Мультфильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/jtC6rIr56z7FqTLcZll4iSyp7wo.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"427768","ru":"This Is Your Life Donald Duck","en":"This Is Your Life Donald Duck","year":"1960","type":"Мультфильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/lokRpFpLgL3Jk7xZPL0VsOzxWzn.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"272108","ru":"淫獣エイリアン","en":"淫獣エイリアン","year":"1997","type":"Мультфильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/iRel9pEZjbGafxFV9lz2b0lmtxD.jpg","genres":["мультфильм","ужасы","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"361519","ru":"കോഹിനൂര്‍","en":"കോഹിനൂര്‍","year":"2015","type":"Фильм","rating":6.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/k02EEiY5f3DRegoiIDAll2De6UB.jpg","genres":["комедия","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"26444","ru":"Сначала","en":"D.C.～ダ・カーポ～","year":"2003","type":"Аниме","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/yaDB7CTZA8PatqVmPnfwBynA9SI.jpg","genres":["мультфильм","драма","Аниме"],"overview":"Главный герой аниме уже совсем не неудачник. Он способен прямо высказывать своё мнение, принимать разумные, взвешенные решения, может и прикрикнуть. Но девушек он всё-таки несколько стесняется, скорее всего, по причине неопытности.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_78464","ru":"Я и 23 раба","en":"奴隷区 The Animation","year":"2018","type":"Аниме","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/zNVz4OMER51g6TQzy7cgQZymn70.jpg","genres":["мультфильм","криминал","драма","Аниме"],"overview":"В жизни Эйи Аракавы было всё, но она всё равно изо дня в день испытывала чувство невыносимой скуки. Сколько бы её ни упрекали за чёрствость, она продолжала вести себя, словно ничего не произошло. Снедаемая чувством неудержимого любопытства, девушка согласилась на встречу с двумя молодыми людьми, которые якобы состоят в гомосексуальных отношениях, только потому, что не смогла представить, как кто-то бросил её подругу ради другого парня. Так, неожиданно для себя, Эйя познакомилась с Югой Отой - молодым человеком, одержимым одной единственной мыслью - иметь рабов. Не теряя времени даром, юноша предложил ей рисковую затею с известным в узких кругах устройством SCM, которое влияет на человеческое сознание, и она согласилась стать его союзником в игре, попирающей своим существованием все мыслимые моральные устои. Так началась их история.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_33728","ru":"Магический Покан","en":"錬金3級 まじかる?ぽか〜ん","year":"2006","type":"Аниме","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/l09DBGlfomCZzD5jyMkj0CaE1Jw.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Вампирша Патира, ведьма Юма, оборотень Лиру и андроид Айко — принцессы из загробного мира. В поисках нового дома они прибывают в мир людей. Пытаясь адаптироваться к новой реальности, девушки сталкиваются с множеством нестандартных ситуаций.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_69289","ru":"キラキラ☆プリキュアアラモード","en":"キラキラ☆プリキュアアラモード","year":"2017","type":"Аниме","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/eWfUP7xkusKasH2YDUVdiL1N2ZF.jpg","genres":["НФ и Фэнтези","мультфильм","Боевик и Приключения","комедия","семейный","Детский","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_44422","ru":"幽幻怪社","en":"幽幻怪社","year":"1994","type":"Аниме","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/j3aDAyB9ffwaQDR524iPWwAHnis.jpg","genres":["мультфильм","комедия","детектив","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_68055","ru":"Домовладелица в период полового созревания","en":"大家さんは思春期！","year":"2016","type":"Аниме","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/z7GMEG7c6kbT9IvkKG9s7ve59DG.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"249766","ru":"Wake Up, Girls！七人のアイドル","en":"Wake Up, Girls！七人のアイドル","year":"2014","type":"Аниме","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/4y39alsdWQlKeBkwSODc51xulY8.jpg","genres":["му