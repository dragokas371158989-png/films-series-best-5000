нить пол, но не мог признаться в этом ни семье, ни знакомым. Пока мужчина украдкой носит женское бельё и страдает. Но после смерти друга детства и знакомства с его мужем Тай-Хун чувствует, что скоро в его жизни наступят перемены.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"532794","ru":"성판17: 남자들의 17가지 성적 판타지","en":"성판17: 남자들의 17가지 성적 판타지","year":"2017","type":"Фильм","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/86cLgLKNkHUUyHsgvWCpuh10JLZ.jpg","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"202007","ru":"Alpine Antics","en":"Alpine Antics","year":"1936","type":"Мультфильм","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/dYIKDmWM4EYetpDN8HvXHzab7T.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"429892","ru":"음란 과외","en":"음란 과외","year":"2016","type":"Фильм","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/gUlnwBFBq3LzCnj6RFA1VhQCyu7.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"401909","ru":"レインツリーの国","en":"レインツリーの国","year":"2015","type":"Фильм","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/cy4PefoTCDVnNPkcS8PY4qVuctE.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"37049","ru":"The Mouse and His Child","en":"The Mouse and His Child","year":"1977","type":"Мультфильм","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/6NEExXlGqwsIhw30eVKzLG0BPYo.jpg","genres":["мультфильм","приключения","фэнтези","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","a