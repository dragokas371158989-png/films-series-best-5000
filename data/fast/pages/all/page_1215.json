олгая, нелёгкая, но полная приключений дорога. Не обошлось, конечно, вез коварного похищения и радостного освобождения. Снегопаху, Танку и другим мудрым собачкам удалось перехитрить жадного и глупого вора. Стоит ли удивляться, что многие детишки попросили у Санта-Клауса в подарок на Рождество… славного бездомного пса!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"13577","ru":"Annie Oakley","en":"Annie Oakley","year":"1954","type":"Сериал","rating":5.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/4VdzIUm8bYpQHM1eyzXEyZRhfgd.jpg","genres":["вестерн","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"58581","ru":"Antiques Road Trip","en":"Antiques Road Trip","year":"2010","type":"Сериал","rating":5.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/bBgXyvuk58eDKyUuyFw0rw9mNLa.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"461846","ru":"야한누나들","en":"야한누나들","year":"2016","type":"Фильм","rating":5.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/3mwXIPhQ7ldyj8DPkc47Dckd1Db.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"525150","ru":"パンク侍、斬られて候","en":"パンク侍、斬られて候","year":"2018","type":"Фильм","rating":5.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/gcOd6vz2h0drbQthF7EbmRfSDHn.jpg","genres":["боевик","комедия","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"516713","ru":"Reuni Z","en":"Reuni Z","year":"2018","type":"Фильм","rating":5.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/fqc5Fhg4F8dba41GPAnSTsRIc8z.jpg","genres":["комедия","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"355522","ru":"アンフェア the end","en":"アンフェア the end","year":"2015","type":"Фильм","rating":5.6,"votes":9,"poster":"https://image