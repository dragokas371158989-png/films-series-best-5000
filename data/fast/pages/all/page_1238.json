db.org/t/p/w342/2WGMYaWjSGDYjHpdX8FHndmzRQK.jpg","backdrop":"","genres":["детектив","триллер","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"334718","ru":"Serce, Serduszko","en":"Serce, Serduszko","year":"2014","type":"Фильм","rating":5.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/gqd6a9YGe0KnASc3NJEpv1PsGzV.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"284447","ru":"Учитель Ёваёва","en":"よわよわ先生","year":"2026","type":"Аниме","rating":5.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/pz9w8OFhS8vYoqDaYjmbvgtm6GM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dKA8y1HxEq09M11p896hBkZsku1.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Хиёри, новая учительница в средней школе, производит ужасающее первое впечатление и быстро получает от учеников прозвище «Страшительница». Однако на самом деле она совсем не пугающая, а наоборот — нежная, неуклюжая и хрупкая женщина! Абикура, один из её учеников, очарован контрастом между её устрашающим внешним видом и милой личностью, поэтому он решает всеми силами её оберегать. Эта трогательная романтическая комедия, с теплом и юмором и милейшей главной героиней, покажет нам в до боли знакомом сюжете по настоящему неожиданный поворот.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305995","ru":"What's in the Box?","en":"What's in the Box?","year":"2025","type":"Сериал","rating":5.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/riwRl7TPRH8OqMmleaPGtL1VBDC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aaxT7Dh43Mzirgb9lPQZyQ1A41Y.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"741020","ru":"Obsession: Stalked by My Lover","en":"Obsession: Stalked by My Lover","year":"2020","type":"Фильм","rating":5.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/nFX9mJTN0ZUU3