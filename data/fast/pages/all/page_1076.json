:3,"poster":"https://image.tmdb.org/t/p/w342/c5jE1EuDpGn5725xvn2QNcuYcaP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nXarJLj1Z4ZSiBqXpmLNrqczMiv.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299159","ru":"Bróker Marcsi","en":"Bróker Marcsi","year":"2025","type":"Сериал","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/n2mcVV7iJ6ooHxQWQy9bvdwtAOw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9VMGXUyPKvXMQ8LRXKSTsUHjqL5.jpg","genres":["Драма","Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"135809","ru":"Любовь возвращается с любовью","en":"Amor com Amor Se Paga","year":"1984","type":"Сериал","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/gsJf1DufI9y19iQTsr1VwEgMtvY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xWseqrivYZuoSmFfdHCBwa0XhP7.jpg","genres":["Комедия","Мыльная опера"],"overview":"В маленьком вымышленном городе Монте-Санто живёт Ноно Коррейя, вдовец, неврастеник и раздражительный человек, немного загадочный, граничащий с трагикомизмом. Он полный задира: от запирает холодильник навесным замками, несколько раз в неделю выключает свет в доме и даже заставляет своих детей Томаса и Элизу питаться не очень вкусными продуктами. Но старый мужчина не только далёк от того, чтобы быть бедным, он самый богатый человек в городе: он арендует несколько домов, пряча в своем доме сокровище, которое никто не знает, где оно находится, даже его дети. Обратной стороной Ноно Коррейя является дядя Роман, который приезжает в город, не раскрывая никому своего прошлого. Личность этого человека великодушна, сладко говорит и предлагает всем ромашковый чай. Его учения известны по всему городу, но люди боятся его правильных слов. Некоторые считают его святым, другие колдуном.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1658653","ru":"消失的人","en":"消失的人","year":"2026","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/xRqCkGHiT3j9UBl5uruMhInCEGP.jpg","backdrop":"","genres":["Детектив","Триллер","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"893165","ru":"Manoranjan","en":"Manoranjan","year":"2022","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/iSg4HjbOhyXanD3VygCR9NMMuUq.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"411607","ru":"Самурай Татара","en":"たたら侍","year":"2017","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/rjcwtDipWm1ac4SVaxV35MguIWi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/A41UJNMidwusiKvz5YN9467OAt5.jpg","genres":["Боевик","Комедия","Драма","История","Военный"],"overview":"Япония, XVI век. Когда в стране идёт гражданская война, тот, кто контролирует деревни оружейников и сталеваров — всегда при оружии. Устав от того, что мародёры постоянно потрошат родной металлургический посёлок, молодой кузнец Госукэ решает отказаться от карьеры мастера-оружейника и пойти простым самураем в армию Оды Нобунаги. Впервые оказавшись на поле боя, парень вдруг понимает: времена холодного оружия прошли, настало время делать пушки и мушкеты.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1019476","ru":"High Noon on the Waterfront","en":"High Noon on the Waterfront","year":"2022","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/cNoHWIpbTR8Ro9AfG2wo23sWQCh.jpg","backdrop":"","genres":["Документальный","История"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1662858","ru":"EB","en":"EB","year":"2026","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/aUUQXiiGA3LFHHemf3UgHVF4y5C.jpg","backdrop":"","genres":["Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"386825","ru":"Без утешения","en":"Lost Solace","year":"2018","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/ndAEtuw1q6U6R3CJtk7NBxZnvrZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Emr0UTWXk3O6Hi1dTctuOWfdew.jpg","genres":["Триллер","Фантастика"],"overview":"Спенс Катлер — психопат. Он никогда не знал сочувствия или вины. Тем не менее, судьбоносная встреча с новым препаратом собирается дать ему дозу слишком большой реальности, и он берет умопомрачительное путешествие по психоделическому шоссе сознания, чтобы встретиться лицом к лицу с его собственной моралью и его собственной искривленной душой. Препарат розовая голубка попавший в кровь полностью меняет сознание. Именно на него и подсел наш красавчик, и теперь он остался без своих прежних чувств и утешения которое мог бы получить если бы не стал жертвой эксперимента. Теперь Спенс остро нуждается в новой дозе, ведь жизнь которая пришла на смену старой ему очень даже нужна. Разобраться в себе, изменить судьбу, да многое из того что ранее было недоступно теперь перед ним как на ладони, ведь под действием розовой голубки он начинает чувствовать.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"885366","ru":"Де гроші","en":"Де гроші","year":"2021","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/boFK6Z64RTFkFlDHeWZmk4ct4i1.jpg","backdrop":"","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"717268","ru":"疯魔神丐苏乞儿","en":"疯魔神丐苏乞儿","year":"2020","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/c5o2BxZLnrIohs87w5J0KJNrrKZ.jpg","backdrop":"","genres":["Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"421927","ru":"31 октября","en":"31st October","year":"2016","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/oy8AgSHYTOcoLZlcRmPzSjidQI0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o6VU840x7V6ijeUqXxrxiDRHnDe.jpg","genres":["Боевик","Драма","История"],"overview":"Действие фильма начинает разворачиваться 31 октября 1984 года. На тогдашнего премьер-министра Индии Индиру Ганди осуществили покушение, которое обернулось смертью политика. Ситуация очень необычная, ведь с женщиной расправились охранники, которые должны были любой ценой защищать её от бандитов. Вскоре выяснилось, что телохранители Индиры были сикхами. Когда информация об этом просочилась в СМИ, большая часть населения Индии горячо возненавидела сикхов. Начались беспорядки, в ходе которых было убито много представителей этой народности. В результате развернувшейся охоты на сикхов пострадал Давиндер Сингх. Жизнь мужчины оказалась сломана, а большая часть родственников погибла в ходе беспорядков…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"471619","ru":"Крылья Рин","en":"リーンの翼","year":"2005","type":"Мультфильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/cAYKtH46sob3VZdSI199Q2PvaaV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/84W3Tg3Cb63jzyVW3zlvqtOQc12.jpg","genres":["Мультфильм"],"overview":"Судзуки усиленно разыскивался Американской армией и полицией, поскольку его недоделанные друзья, развлекаясь запусканием ханаби с тротилом, разнесли к чёрту американскую военную базу. Судзуки же, с**баться не успел. И вот улепётывая со всех ног по-пляжу от разъярённой американской военщины явилось ему виденье чудное. Разверзлись хляби морские, и снизошёл на них свет божественный и увидел отрок-дебилоид, как крейсер военный поднялся из пучин морских. А на корме (зад корабля), махая ему белым платочком, стояла дева прекрасная, аки Шибасаки Коу, тока моложе лет на 5 и молвила она ему: \"Узкоглазая я, одной крови мы с тобой Маугли, ты и я. Спаси меня, потому как красотка я и отдамся тебе сразу, да плюс с баблом у меня всё хорошо, не прогадаешь Судзуки-дурачок\". И бросился сей Судзуки в догонку за крейсером, подхлёстываемый гормонами юношескими и алчностью стариковской.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"444544","ru":"Клиника для мигрантов","en":"Clínica de Migrantes: Life, Liberty, and the Pursuit of Happiness","year":"2016","type":"Фильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/fP6TVuNp3ZqgB786ZHeN2oD9jCU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zgMaQXdXyugzHHml0Q7TExauj7u.jpg","genres":["Документальный"],"overview":"Впечатляющий рассказ о волонтерской клинике, в которой врачи лечат иммигрантов без документов и страховки – как обычных пациентов. Фильм показывает реальных героев иммигрантских дебатов и ставит важный вопрос – способна ли Америка удовлетворить базовые потребности 11 миллионов нелегальных иммигрантов. Когда у работяг и их семей без страхового полиса возникают проблемы со здоровьем, требующие срочной госпитализации, чуть ли не за обычный аспирин им могут начислить больше тысячи долларов. Клиника Puentes de Salud в Южной Филадельфии и подобные ей медицинские центры по всей стране пытаются самостоятельно решать эту острую проблему, оказывая помощь всем нуждающимся. Несмотря на ограниченное финансирование и другие препятствия, каждый год пациентами неутомимых врачей становятся более 10 000 людей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"506812","ru":"Фил на грани","en":"The Ledge End of Phil","year":"2014","type":"Мультфильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/sxxlNyO2z74ca78kOCe3OI7TwH7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/A30WntMSYIhBzPfewLYlXsOsoHl.jpg","genres":["Мультфильм","Драма"],"overview":"История про тревожного бухгалтера Фила, который случайно оказывается на высоком уступе снаружи своего офиса и не может вернуться обратно. Застряв между безопасностью своего кабинета и шумом большого города вокруг, Фил должен сделать решительный шаг или остаться взаперти навсегда.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"431398","ru":"Как один мужик двух генералов прокормил","en":"Как один мужик двух генералов прокормил","year":"1965","type":"Мультфильм","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/9FtSXtZVbv6TSqM5k4paoAeRJvA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6Gynzsp2yrEpEom7WhRwpHIyKPx.jpg","genres":["Мультфильм"],"overview":"Экранизация сказки Салтыкова-Щедрина о том, как два генерала и мужик чудом оказались на необитаемом острове, как мужик терпеливо ухаживал за ленивыми генералами, кормил их и одевал, сам довольствуясь крохами с их стола.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"22902","ru":"The Life Of Riley","en":"The Life Of Riley","year":"1953","type":"Сериал","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/tYnX6Fw3X0kdmIc9LwPq8N544QR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4L5Au79IA9q4kUj4PWy28ZhqEi7.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"8426","ru":"MTV Roadies","en":"MTV Roadies","year":"2003","type":"Сериал","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/rxuX0kszEyVJLDVIZLiZHOcM65y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2kEe8kiXc0cJUdmwIjnhXwxIEPL.jpg","genres":["Реалити-шоу","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"70938","ru":"花咲舞が黙ってない","en":"花咲舞が黙ってない","year":"2014","type":"Сериал","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/rCIzKW0ubyfYjFLtAtyOLJykl17.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bBp7FtuIWczMZzVzMAqgNKDNlBN.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"91791","ru":"少女コマンドーIZUMI","en":"少女コマンドーIZUMI","year":"1987","type":"Сериал","rating":6.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/k8AN7L35uA6eEhVZZ1