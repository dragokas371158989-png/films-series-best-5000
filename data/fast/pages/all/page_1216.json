g":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/eruMQXriVRu2EK4wQcw86ZO0Ufn.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"763223","ru":"８日で死んだ怪獣の１２日の物語 －劇場版－","en":"８日で死んだ怪獣の１２日の物語 －劇場版－","year":"2020","type":"Фильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/mh6CMdvqYFqoZVxjb9YYJeA8rga.jpg","genres":["фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"632880","ru":"Virgo and the Sparklings","en":"Virgo and the Sparklings","year":"2023","type":"Фильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6y5ttQee7RAhQLdZGCSkvNEhDm4.jpg","genres":["приключения","драма","фэнтези","мелодрама","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"721813","ru":"Love by Accident","en":"Love by Accident","year":"2020","type":"Фильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/adm3cbQeChlzcpntCQplQIXORTT.jpg","genres":["драма","мелодрама","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"597419","ru":"Жертва алхимика","en":"劇場版 誰ガ為のアルケミスト","year":"2019","type":"Мультфильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/A3TdCQthRxZFmE1xzgNGA8dQvJX.jpg","genres":["мультфильм","приключения","фэнтези","фантастика"],"overview":"События разворачиваются на континенте под названием Вавилон, на котором однажды была открыта алхимия. Но эта наука, к сожалению, привела к войне между семью нациями, существовавшими на континенте, где каждая пыталась использовать Вавилонскую башню в качестве инструмента для достижения победы. Осознавая тот факт, что человечеству грозит полное уничтожение, семь наций были вынуждены заключить мир, согласно которому было запрещено использовать алхимию.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"155765","ru":"Саюки: Реквием","en":"幻想魔伝 最遊記 Requiem 選ばれざる者への鎮魂歌","year":"2001","type":"Мультфильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/1cuH781YuKfA6p3PXPLh5gveEzT.jpg","genres":["боевик","приключения","мультфильм"],"overview":"Еще одна история о том, что спасение девушек до добра не доводит... Монах Санзо спасает девушку от монстра и она, в качестве благодарности, приглашает его со спутниками переночевать в особняке, где она живет вместе с наставником. Но за радушным приемом кроется смертельная ловушка, истоки которой лежат в далеком прошлом Санзо...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"432057","ru":"Лиричная волшебница Наноха 3: Отражение","en":"魔法少女リリカルなのは Reflection","year":"2017","type":"Мультфильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/ifnaCaG37qeygihwKNnykWluAQW.jpg","genres":["фэнтези","мультфильм","боевик","фантастика"],"overview":"Исследователи — муж и жена Флориан — остались со своими дочерьми Амитией и Кирие на умирающей планете Элтория в надежде найти способ возродить её. Однако этой мечте, похоже, не суждено было сбыться, так как отец семейства Гранц Флориан заболел. Вопреки воле своей старшей сестры, Кирие отправляется за помощью в далёкий альтернативный мир вместе со своей подругой детства Ирис. Они прибывают на Землю в Японию, чтобы найти ключ к возрождению своей планеты. На Земле они встречаются с Нанохой, Фейт и Хаятэ.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"256838","ru":"Звезда Пушистландии","en":"綿の国星","year":"1984","type":"Мультфильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/e0OrhIrYQtVYpbNvjNwT6JrRMw2.jpg","genres":["мультфильм","фэнтези","мелодрама"],"overview":"Кошки существуют рядом с людьми очень давно. Пушистые, мягкие, каждая со своим характером, они радуют нас своим присутствием. А как сами кошки видят нас и друг друга? Об этом и рассказывается в этой истории - о маленькой белой прелести, персидской кошечке.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"517800","ru":"Капитан семи морей","en":"Käpt'n Sharky","year":"2018","type":"Мультфильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/323pjTPhJNU9EdExejrfKmTFvAp.jpg","genres":["мультфильм","семейный"],"overview":"Капитан Шарки может и маленького роста, но он твердо верит, что он самый грозный пират семи морей. Он и его корабль готовы отправиться в свое первое плавание и всё, что нужно Шарки — компас и настоящая команда. На борту судна случайно оказываются сразу два пассажира: примерный и воспитанный мальчик Мики и бойкая девочка Бонни — дочь Адмирала. Вместе эту разношерстную компанию ждут захватывающие приключения!","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"73812","ru":"Las Estrellas","en":"Las Estrellas","year":"2017","type":"Сериал","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/SNTwmyVHvBKLvrbeJ3vCjGD5va.jpg","genres":["комедия","семейный","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"10959","ru":"Later... with Jools Holland","en":"Later... with Jools Holland","year":"1992","type":"Сериал","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/d5CQAazlyahqsJlb7WLBvhmHOYE.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"37757","ru":"MasterChef Greece","en":"MasterChef Greece","year":"2010","type":"Сериал","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/h0MR8xGqddeeJHgqDuW14jW25ov.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"