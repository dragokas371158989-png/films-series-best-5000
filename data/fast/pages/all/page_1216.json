otes":8,"poster":"https://image.tmdb.org/t/p/w342/4aacoOexGlp0Avxt9d6jfgNZstS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/99RLzn3X4auakToeIMsmGGS3MM8.jpg","genres":["ужасы","триллер","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"114612","ru":"Storybook Classics - Robin Hood","en":"Storybook Classics - Robin Hood","year":"1985","type":"Мультфильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/rVdzBRqJsBbZWJ0hIN1DbatxVtD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dcfMq6fiEYRaUGZw1mTDT8OUGQ5.jpg","genres":["приключения","мультфильм","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"261194","ru":"五湖四海","en":"五湖四海","year":"1992","type":"Фильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/or9sHBsZtNgccu81Ge52hxWyCuw.jpg","backdrop":"","genres":["боевик","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"533721","ru":"The Stories: The Making of 'Rogue One: A Star Wars Story'","en":"The Stories: The Making of 'Rogue One: A Star Wars Story'","year":"2017","type":"Фильм","rating":5.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/xuI27etRYWk7vP0aCUTTnIfnpC4.jpg","backdrop":"","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"96042","ru":"Ведущие звёзды","en":"スケートリーディング☆スターズ","year":"2021","type":"Аниме","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/hjyo9xKqRL1nM4uChDpSPejDOVa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xBLmMc7b1alduvPe7U52nQaeBWK.jpg","genres":["мультфильм","драма","комедия","Аниме"],"overview":"Кэнсэй Маэсима, юный и талантливый фигурист, уходит из спорта после поражения от руки своего соперника, Лео Синодзаки. С тех пор Маэсима пользуется своими выдающимися рефлексами, чтобы помогать в различных спортивных кружках своей школы, но так и не находит ничего, чему мог бы посвятить своё время. Однажды он узнаёт, что Синодзаки также решил оставить одиночное фигурное катание и уйти в командный вид спорта под названием \"скейтлидинг\". Вскоре после этого к Маэсиме обращается юноша по имени Хаято Сасугай, чтобы пригласить парня в свою команду по скейтлидингу. Что ждёт Маэсиму в мире нового, незнакомого ему спорта, и сможет ли он наконец-то взять верх над Синодзаки?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"34820","ru":"Приключения Джинга","en":"王ドロボウ JING","year":"2002","type":"Аниме","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/2u5mbQDXvLGUvDkh39K6ECKxmcc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a7kHO279f3NbEDTFP7ANs6jnzAO.jpg","genres":["мультфильм","Боевик и Приключения","комедия","Аниме"],"overview":"Берегите кошельки! Настал и ваш черед познакомиться с Джингом - достойным последователем Робин Гуда! Благородный юный вор недаром заслужил прозвище «Король Бандитов»: во всей Вселенной не найдется сокровища, которое Джинг не смог бы умыкнуть!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"289356","ru":"Речные заводи","en":"北方謙三 水滸伝","year":"2026","type":"Сериал","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/v4bjh9L5zY7CvMp366E3MiTowNo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wLWWernPegV5XTNs59O6zU9wJqx.jpg","genres":["драма"],"overview":"В начале XII века, на закате династии Северная Сун, Китай погружен в коррупцию и безразличие власти. Низкопоставленный чиновник Соуко восстает против несправедливости и пишет манифест «Тайтэн Гёдо», призывающий к реформам. Его союзник Ро Чишин отправляется искать сторонников. К делу присоединяются мастер боевых искусств Оушин, копейщик Ринчу и офицер Ёси. В это же время лидер повстанцев Чоу Гай готовит собственное выступление. Вскоре они объединяются и создают крепость на болоте Ляншань. Однако им противостоит мощный режим Сун, поддерживаемый армиями и тайной организацией «Сэйренджи» во главе с безжалостным чиновником Ли Фу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"308051","ru":"Голубые небеса","en":"Blue Skies","year":"2026","type":"Сериал","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/pui0mhQ3ZutkpeSDGA0UN771ioy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4D8Cdj4I9hdqMyYHyRRF3A44xdQ.jpg","genres":["драма","криминал"],"overview":"Экс-офицер военной полиции Джоди Ларсен возвращается в парк Кристал Ридж. Раскрывая преступления в глуши и налаживая связь с отцом, она находит неожиданного союзника. Им становится бродячий лабрадор Блу, чье чутье в условиях дикого заповедника оказывается надежнее любых полицейских инструкций.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1245398","ru":"Первые ведьмы. Потомство","en":"Äkta skräck","year":"2024","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/bPMs08M4a4szc5IYsxPrb78yx5r.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l7UYtsMGay7gjHtqJrAI2SZXIWZ.jpg","genres":["ужасы"],"overview":"Популярные блогерши отправляются на место самой массовой в истории казни ведьм. В XVII веке местный викарий проводил здесь самосуд над женщинами, считая, что они потомки самых первых ведьм. Но одна из жертв действительно была ведьмой и, умирая, прокляла священника и здешние земли. Прибыв на место, девушки сталкиваются с жуткими и необъяснимыми явлениями. Чтобы остановить зло, им нужно разгадать тайну первых ведьм.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1076957","ru":"Новые истории Франца","en":"Neue Geschichten vom Franz","year":"2023","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/rQyVn3JVgLkYLg8qiU9axO8col6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o84EzL5ggojZkFkZI7ExCbDkTRd.jpg","genres":["семейный","приключения"],"overview":"Летние каникулы Франца начинаются неудачно, ведь два его лучших друга больше не разговаривают друг с другом. Однако неудачи не делают парня унылым, ведь вот уже снова начинается захватывающее приключение. Все начинается с загадочного похищения сокровищ, которое становится поворотным моментом в жизни друзей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"934358","ru":"Анка","en":"Anka","year":"2022","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/mF0tx550p3ViekKX7pfSXKzkXnd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oaRpElP2J8wgwcDoAstymeiR4Yg.jpg","genres":["боевик","драма"],"overview":"Мурат, потерявший семью в результате несчастного случая в детстве, становится известным в автогонках, борясь со своей травмой на протяжении многих лет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1030598","ru":"כאילו אין מחר","en":"כאילו אין מחר","year":"2022","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/84Ub8u6mu0taZPTBJVHdbwyQtLA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8c1jBGplle95WftDN56h9N4q2q7.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1008640","ru":"黄金大逃狱","en":"黄金大逃狱","year":"2022","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/u5ml4gox6r4WJ7Xn5ZAkgLC1VZw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m61YN7oUmrdEetwjdPN3tXQtx9S.jpg","genres":["криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"951189","ru":"Kapinynas","en":"Kapinynas","year":"2022","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/ajHTU7ObS1nhskW1fUwIW5iX0Y2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cAzjcBAUUysmMNasciIJxgbmD7L.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1583798","ru":"Merge","en":"Merge","year":"2025","type":"Фильм","rating":5.6,"vote