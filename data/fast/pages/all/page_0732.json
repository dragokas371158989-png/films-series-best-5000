иал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/mbQg3R7423hNDPmMtmhhhoT6KML.jpg","genres":["драма","комедия","Реалити-шоу","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"281177","ru":"Extraordinary World With Jeff Corwin","en":"Extraordinary World With Jeff Corwin","year":"2025","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3435qbBMA0YnHpZsXdhTkYE7oty.jpg","genres":["документальный","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"228218","ru":"Studio Bar Barras","en":"Studio Bar Barras","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/cHSonOoJTqZ1BJ4zJn7edka5PRw.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"130703","ru":"Mystères d'épaves","en":"Mystères d'épaves","year":"2020","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/AvEqYb85QahpVjdFpksEBqsbOPY.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1599432","ru":"Ragtime","en":"Ragtime","year":"1927","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/8JlBvpmqeNrmUoszoAE6OWcghIt.jpg","genres":["драма"],"overview":"На сшитом из лоскутков полотне жизни Нью-Йорка начала двадцатого века прослеживаются судьбы нескольких людей с акцентированием внимания на чернокожем герое, одержимо стремящемся добиться справедливости.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1505384","ru":"Дмитрий Кантемир","en":"Dimitrie Cantemir","year":"1974","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/43cv3x3DdY47BzPC9GRCfFODkB3.jpg","genres":["история","военный"],"overview":"Фильм о жизни Дмитрия Кантемира и молдавского народа с ноября 1710 - июль 1711 годов. Турецкие войска готовятся к войне с Россией. Султан вверил ему престол Молдавии. Кантемир тайно установил связи с Петром I и заключил с ним военно - политический договор, по которому Россия брала Молдавию под свой протекторат, обязывалась помочь изгнать турок и восстановить прежние границы молдавского государства.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1427982","ru":"Обвал","en":"Փլուզում","year":"1959","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/aIEDsXDh2cgEB3NQF8iI1q1EGHO.jpg","genres":["драма"],"overview":"Далёкий полустанок в горах. Только гудки поездов напоминают о большом мире... Здесь строится тоннель. Начальник стройки Тигран считает необходимым форсировать проходку тоннеля, чтобы сдать его до начала дождей. Дожди приводят к обвалам, что парализует движение на железной дороге.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1385271","ru":"With This Ring","en":"With This Ring","year":"1925","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/roJs0leXKxnhs8gnkuIcBvjeZnF.jpg","genres":["драма"],"overview":"Три подруги поклялись, что в течение года выйдут замуж. Но каждой из них придется столкнуться со своими проблемами: Триста не может забыть своего бывшего парня, Вивиан втайне влюблена в отца своего сына, ну а Амайя изо всех сил пытается разрушить несчастливый брак своего бывшего возлюбленного. Они все начинают год полные надежд… но вот получится ли у них взойти под венец?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"228205","ru":"Bravos del Menu","en":"Bravos del Menu","year":"2016","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/dRDqQvw35XKwV0Cp15VFdtM9mEi.jpg","genres":[],"overview":"Люк — экс-чемпион по родео, раздумывающий над возвращением в спорт. София — выпускница колледжа, получившая заманчивое предложение о работе в сфере искусства в Нью-Йорке. В то время как молодые люди пытаются сделать нелегкий выбор между чувствами и мечтами, жизнь сталкивает их со стариком Айрой. Воспоминания нового друга о его полувековых отношениях с женой вдохновляют Софию и Люка на главные решения в их жизни. Два поколения, две истории, вечная любовь.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"111310","ru":"Mountain Vets","en":"Mountain Vets","year":"2019","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/zScT3Qu7p0HWEJSn5TNNrwjrZ0j.jpg","genres":["документальный"],"overview":"Шпионка на службе у северян, Гэйл Лавлэсс, влюбляется в офицера армии Конфедерации. Сможет ли их любовь преодолеть разногласия целой страны, охваченной Гражданской войной, или же им не суждено быть вместе?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"98254","ru":"Игры животных","en":"Animals at Play","year":"2019","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9k3qSNH1eVu93lquMRg2GmerGpb.jpg","genres":["документальный"],"overview":"Во всём мире природы молодые животные проводят большую часть своего времени в игре. От кошек, обожающих погоню, до шимпанзе, умеющих решать головоломки. Новые исследования показывают, что игра лежит в основе почти всего, чему учатся животные. Игра - это гораздо больше, чем просто веселье. Она имеет фундаментальное значение для развития животного, а в некоторых случаях и для его выживания.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"86828","ru":"Badesalz - Comedy Stories","en":"Badesalz - Comedy Stories","year":"1999","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/vJWBShJxz9n3mh2JTwXvsdDs2QX.jpg","genres":[],"overview":"Главная сюжетная линия — захват власти на Земле инопланетянами; но прежде чем захватить власть, они желают проверить, что же произойдёт на Земле, если простому смертному даровать необыкновенные способности. Объектом их внимания становится заурядный учитель, которого они наделяют необычным даром.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}