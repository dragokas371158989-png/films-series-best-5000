mdb.org/t/p/w342/vzR2kbSxyoyT3KShzWiBbcB3BwV.jpg","genres":["фантастика","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"139563","ru":"Кремлевские курсанты","en":"Кремлевские курсанты","year":"2009","type":"Сериал","rating":3.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/zszqXCj1MVkNGIi5IVjLflLouTL.jpg","genres":["комедия","драма"],"overview":"Пролетело время, закончилась учеба в Суворовском училище, и, казалось, что пути юных друзей-суворовцев разойдутся. Но неожиданно трое старых друзей — Илья Сухомлин, Степан Перепечко и Алексей Сырников — встречаются в Московском высшем военном командном училище на вступительных экзаменах. Ребята поступают в Училище вместе со вчерашними школьниками и теми, у кого за плечами служба в Вооруженных Силах России. Происходит деление курсантов на «кадетов», «школьников» и «служивых». Друзей по Суворовскому училищу ждет неожиданный сюрприз: в училище несколько позднее поступает их бывший лидер — Макаров.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"826048","ru":"Blue Call","en":"Blue Call","year":"2021","type":"Фильм","rating":3.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/sOvkpcdGgJnIwl7d8YcUuQ2d4bQ.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"785008","ru":"И даже после этого","en":"Even After Everything","year":"2018","type":"Фильм","rating":3.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/nJuNiuvWYDkbkUvhneHdtcXKFC2.jpg","genres":["драма"],"overview":"Жизнь богатой домохозяйки на восточном побережье переворачивается с ног на голову из-за визита шурина. Она вынуждена бороться с проблемами в браке и бросить вызов своему статусу кво.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"7562","ru":"Q&A","en":"Q&A","year":"2008","type":"Сериал","rating":3.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fkO0LWXU6R21J3GUIbzCZc