еление курсантов на «кадетов», «школьников» и «служивых». Друзей по Суворовскому училищу ждет неожиданный сюрприз: в училище несколько позднее поступает их бывший лидер — Макаров.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"826048","ru":"Blue Call","en":"Blue Call","year":"2021","type":"Фильм","rating":3.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/sOvkpcdGgJnIwl7d8YcUuQ2d4bQ.jpg","backdrop":"","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"785008","ru":"И даже после этого","en":"Even After Everything","year":"2018","type":"Фильм","rating":3.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/nJuNiuvWYDkbkUvhneHdtcXKFC2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hrxx5xFUfxvn2YBYXdhlJogJXhu.jpg","genres":["драма"],"overview":"Жизнь богатой домохозяйки на восточном побережье переворачивается с ног на голову из-за визита шурина. Она вынуждена бороться с проблемами в браке и бросить вызов своему статусу кво.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"7562","ru":"Q&A","en":"Q&A","year":"2008","type":"Сериал","rating":3.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fkO0LWXU6R21J3GUIbzCZclZObp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lpSZ7gr51W0ZEhV7m4VF7AUfJ0w.jpg","genres":["Новости","Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"594902","ru":"Dominant Species","en":"Dominant Species","year":"2019","type":"Фильм","rating":3.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/u5SeOb4cpHFoW3Y1Zc1P8AEOEpG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/17eS4WVcWMyy17802CIxrXNgshh.jpg","genres":["фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"700563","ru":"어린 처제 2","en":"어린 처제 2","year":"2018","type":"Фильм","rating":3.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/8vDkLLp8jsgHYztPgUU7qZ5