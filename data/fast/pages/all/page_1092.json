о, что большая часть описанных им событий, не имеет никакого отношения к действительности, этот фильм возымел своё действие. Благодаря удачной пропагандистской уловке алкобароны всё-таки добились желаемого результата…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"507317","ru":"Португалка","en":"A Portuguesa","year":"2019","type":"Фильм","rating":6.5,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/ymj6AmTxlgiW0UZkvNSzxsnN6Bs.jpg","genres":["драма","история"],"overview":"Его дом - война. Ее дом - Португалия. И все же молодая жена лорда фон Кеттена намерена сделать жилище своего мужа, негостеприимный замок на скале в северной Италии, своим домом. В течение одиннадцати долгих лет, пока он отсутствует, она строит здесь свою жизнь.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"550189","ru":"ไบค์แมน ศักรินทร์ ตูดหมึก","en":"ไบค์แมน ศักรินทร์ ตูดหมึก","year":"2018","type":"Фильм","rating":6.5,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/mNOt6BCTBqYNLEIrZNfIqLusPBs.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"610438","ru":"殺さない彼と死なない彼女","en":"殺さない彼と死なない彼女","year":"2019","type":"Фильм","rating":6.5,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/4bcoki3T0lSSMwMZBaXX7cce3zD.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"617646","ru":"ప్రతీ రోజు పండగే","en":"ప్రతీ రోజు పండగే","year":"2019","type":"Фильм","rating":6.5,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/p9EvfAQ62ecQR7OljTorTX6X9R9.jpg","genres":["семейный","мелодрама","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"560082","ru":"El rey","en":"El rey","year":"2018","type":"Фильм","rating":6.5,"votes":14,"p