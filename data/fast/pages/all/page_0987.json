"votes":10,"poster":"https://image.tmdb.org/t/p/w342/j2t4J5qKvxN2UmPjggKiaaHbGE9.jpg","genres":["криминал","драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"926929","ru":"Costa Concordia - Chronik einer Katastrophe","en":"Costa Concordia - Chronik einer Katastrophe","year":"2022","type":"Фильм","rating":7.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/h6I4xpBeWw4YsNAxaIIiu0uB5Jj.jpg","genres":["документальный","история"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"665453","ru":"Oeconomia","en":"Oeconomia","year":"2020","type":"Фильм","rating":7.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/hLHkFKlgy6XzfNU7qZn0q0jqGs4.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"86198","ru":"Звёздная высота","en":"Alto Astral","year":"2014","type":"Сериал","rating":7.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/6flUqHApZNmvylLqpZLMYAcg187.jpg","genres":["Мыльная опера","драма"],"overview":"Каике и Марк всегда были соперниками, которые соревновались в профессиональной и личной жизни, несмотря на то, что являлись родными братьями. Каике был уникальным человеком благодаря своему дару ясновидения. Он рисовал портреты людей, которых только предстояло встретить в будущем. Для определения диагноза медику было достаточно настроиться на энергетику пациента. Марк старался подходить ко всему рассудительно и педантично, делая все возможное, чтобы клиника отца досталась в наследство именно ему. Лаура любила свою профессию журналистки, помогала во всем двоим братьям и дедушке, которые были самыми важными людьми в ее жизни. Знакомство с братьями стало новым этапом, который мог привести к непредсказуемым последствиям. Девушка не могла себе объяснить степень и глубину чувств к каждому из поклонников, которые были совершенно разными.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"8308","ru":"Expeditie Robinson","en":"Expeditie Robinson","year":"2000","type":"Сериал","rating":7.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/AaDIUjd35r4bBeqb1hY025tgkn5.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"90916","ru":"Ének a csodaszarvasról","en":"Ének a csodaszarvasról","year":"2002","type":"Мультфильм","rating":7.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/mROFpsktTdhP7GUUHvA0Nw0lIit.jpg","genres":["мультфильм","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"364257","ru":"Queen Mimi","en":"Queen Mimi","year":"2016","type":"Фильм","rating":7.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/5ntWsPBXIPauj4LGAa9DyIpUZix.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"567580","ru":"Weil du mir gehörst","en":"Weil du mir gehörst","year":"2019","type":"Фильм","rating":7.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/j8RvHlnbeDGd3iwfkYrEVgw8Llp.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"616828","ru":"Puppy Swap: Love Unleashed","en":"Puppy Swap: Love Unleashed","year":"2019","type":"Фильм","rating":7.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/uayocSRtvhBk7PDYy70o14PidjQ.jpg","genres":["мелодрама","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"518565","ru":"My Daddy is in Heaven","en":"My Daddy is in Heaven","year":"2018","type":"Фильм","rating":7.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/OE4TnIt46fFXjQ81mubrD2bWwL.jpg","genres":["драм