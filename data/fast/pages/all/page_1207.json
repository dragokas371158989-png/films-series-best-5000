":"https://image.tmdb.org/t/p/w342/xZAxSiL5csPIe6Q1V8pbwz69U5m.jpg","genres":["комедия","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"960803","ru":"Todo es Gila","en":"Todo es Gila","year":"2022","type":"Фильм","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/gF5hL4QStKwjpwm41QyQHUGO1Fo.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"75298","ru":"Лови, лови","en":"Pega Pega","year":"2017","type":"Сериал","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/fuD9U4mmRZCxRlezvu3GgZlvILe.jpg","genres":["Мыльная опера","комедия"],"overview":"Романтическая комедия об ограблении роскошного отеля Carioca Palace в Рио-де-Жанейро и последствиях этого события для жизни каждого из участников, будь они гости, подозреваемые или сотрудники. Владелец отеля, Педриньо Гимарайнш, унаследовал семейный отель и никогда не рассматривал его как бизнес, а рассматривал его как способ тратить и разбазаривать деньги. Плейбой злоупотребил всеми прелестями и ушёл в загул, оставив в стороне владение самого отеля. Как следствие этого, роскошный отель Carioca Palace теряет свой престиж и все свои доходы. Находясь на грани банкротства, Педриньо, намереваясь жить в Соединенных Штатах в компании своего дворецкого Нелито и внучки Луизы, продает отель Эрику Рибейро, одному из самых уважаемых бизнесменов Бразилии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"537530","ru":"Мой брат, моя любовь","en":"Glaubenberg","year":"2018","type":"Фильм","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/nXTSy0nO03SvXTL3Q73nakHJxba.jpg","genres":["драма"],"overview":"Любовь, которую 16-летняя Лена испытывает к своему брату Ною, — это больше, чем сестринская любовь. Она так одержима братом, что не может сдержать своих чувств. В отчаянной попытке сдержать свои чувства она уходит в себя.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"336191","ru":"Преступление в Лозере","en":"Crime en Lozère","year":"2014","type":"Фильм","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/x0lLHtxDLFOcgibGcyn3okvoieP.jpg","genres":["детектив","криминал","телевизионный фильм"],"overview":"Тело местного влиятельного фермера с ножом в сердце найдено в пещере Ларзак. Улики указывают на молодого пастуха Жюльена Казаня, у которого с жертвой были напряженные отношения, и недавно между ними произошла публичная ссора. Отпечатки на орудии преступления точно принадлежат ему, но у него есть алиби, подтвержденное свидетелем…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"23325","ru":"Наш Чарли","en":"Unser Charly","year":"1995","type":"Сериал","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/kp2FfrHfgvKN2azjsTr9vswTkJw.jpg","genres":["комедия","семейный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"28680","ru":"Тэ Чжо Ён","en":"대조영","year":"2006","type":"Сериал","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/65UTcWuCoDtbXAM66rryVuSEoyj.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"250","ru":"Шоу Дика Пауэлла","en":"The Dick Powell Show","year":"1961","type":"Сериал","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/cRxsaRZGU9h8XJVrCacPyAXns.jpg","genres":["драма","комедия","Ток-шоу"],"overview":"Шоу Дика Пауэлла - американский сериал антология, который проходил на NBC, в основном спонсируемая компанией Reynolds Metals. Он был устроен давней кинозвездой Диком Пауэллом до его смерти, а затем рядом гостей, пока сериал не закончился.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"409276","ru":"착한 여비서의 목적","en":"착한 여비서의 목적","year":"2016","type":"Фильм","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/zXLx1o1x8u5ZbV7jpCJwWMg