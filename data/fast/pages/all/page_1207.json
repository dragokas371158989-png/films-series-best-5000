":6,"poster":"https://image.tmdb.org/t/p/w342/76Y1sSFpVHNHoyKV7ZTeUTucE1z.jpg","genres":["комедия","история"],"overview":"Экранизация новеллы, основанной на реальной жизни феодала в Японии периода Эдо. Однажды Наонори Мацудайра, феодал замка Химэдзи, получил указ сёгуна о необходимости переезда из Химэдзи в Оита. Мало того, что его клан ожидают огромные затраты в материальном плане, руководить переездом назначили местного библиотекаря-затворника, Харуносукэ Катагири. Так начинается невиданный по своим масштабам проект, который может поставить под угрозу само существование клана Мацудайра.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"63474","ru":"On the Spot","en":"On the Spot","year":"2014","type":"Сериал","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/yoOASMAW8trjPJCwJhooPiLeLCB.jpg","genres":["комедия","Ток-шоу","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"534179","ru":"엄마친구들","en":"엄마친구들","year":"2017","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/n2koZwS6eqOWihxQ1OyEgdiJJya.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"458085","ru":"아내를 바꾸다","en":"아내를 바꾸다","year":"2017","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/iqnq8JOQj1VJ73vwJuO0J1lmnG3.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"784272","ru":"Lughead","en":"Lughead","year":"2019","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/zCv5G0NxHB1fXDIfAm5J7KvrtWR.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}