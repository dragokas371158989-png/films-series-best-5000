орию.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"701856","ru":"Битва бессмертных. Код","en":"Wu Xia 2 the Code","year":"2019","type":"Фильм","rating":4.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/9J46DJAM9REREVUv04Np5p8aPFD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hiCGB2xGdxb7VR8HQJueM3GZFLu.jpg","genres":["боевик","фантастика"],"overview":"Когда код, который может спасти мир, тайно вводится члену клана \"5 Элементов\", судьба человечества и мира теперь зависит от его борьбы за выживание.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"745499","ru":"Iceland is Best","en":"Iceland is Best","year":"2020","type":"Фильм","rating":4.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/qHXqydQu3XJHJmU5lo2l1gIi9IC.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"335117","ru":"맛있는 택배","en":"맛있는 택배","year":"2015","type":"Фильм","rating":4.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/pbU2UBygdGERFZkGLRXXYlj4aVz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/narlvb3rgIPkTjK5yCJRqcHlFnS.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"721785","ru":"Lulu","en":"Lulu","year":"2014","type":"Фильм","rating":4.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/cDcII1Re0qS6q2NhMHQbhzYhRUR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aLDrKEUntCtrcQHLLQsjqoEG1nK.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"301470","ru":"モルダイバー","en":"モルダイバー","year":"1993","type":"Мультфильм","rating":4.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/2mxbtWlWLpoLiViJl5ox9nRyP34.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b1CEejB82HcpoPdtHWAHOPWboJH.jpg","genres":["боевик","мультфильм","комедия","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country