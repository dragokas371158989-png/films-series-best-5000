isodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"161931","ru":"Bosko the Musketeer","en":"Bosko the Musketeer","year":"1933","type":"Мультфильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/hhYdguufiwOAjYuPrukclpj8cNX.jpg","genres":["мультфильм","семейный","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1001054","ru":"Бездельницы","en":"Fainéant.es","year":"2024","type":"Фильм","rating":5.7,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fEyTHwEtU7sLow0stZQ6YVGXgEW.jpg","genres":["драма","комедия"],"overview":"Две молодые подруги — Нина и Джул — вынуждены покинуть землю, на которой они жили в сквоте. Не отчаявшись, они садятся в старый грузовичок и отправляются в путешествие по Франции навстречу приключениям и новым знакомствам. Их дорога полна взлётов и падений, разногласий и перемирий, но главное — крепкой дружбы, которая помогает справляться с трудностями мира, где многие выбирают свободу, альтернативный образ жизни и поддержку друг друга, а не корпоративную рутину.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"290230","ru":"Santita","en":"Santita","year":"2026","type":"Сериал","rating":5.7,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/v3kDHO5LFIvzqmOYNDPzwXnfMyq.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1440049","ru":"Preschool","en":"Preschool","year":"2026","type":"Фильм","rating":5.7,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/o6JYj1sZDdLgKb6GW39AfGfrGhw.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1483055","ru":"Piep*zyć Mickiewicza 3","en":"Piep*zyć Mickiewicza 3","year":"2026","type":"Фильм","rating":5.7,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/aQ1bKtjlmdPIDhbYr