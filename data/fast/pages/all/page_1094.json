гает ему творить музыку.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"71528","ru":"Drop the Mic","en":"Drop the Mic","year":"2017","type":"Сериал","rating":6.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/iOgPg0GVMcx8CPdc1NlUoWg5mtC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vu0T40EGPRH4HW44ch8fAuXgZSF.jpg","genres":["Реалити-шоу","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"5439","ru":"Eurotrash","en":"Eurotrash","year":"1993","type":"Сериал","rating":6.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/fMiz6Dy91DZyDzsKvO6Sxwz3NkT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mP5pKgLQAtsefa4K02faT7GOOSg.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"68298","ru":"Danse avec les stars","en":"Danse avec les stars","year":"2011","type":"Сериал","rating":6.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/awub6gcLdqR1Mt0Mc6UGn3H6SFR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/csmtBeWDB4aPPEjEka8X6KURlfY.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"470133","ru":"திருட்டுப்பயலே 2","en":"திருட்டுப்பயலே 2","year":"2017","type":"Фильм","rating":6.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/snwOxyhly7D6MaYcRRcINeAYPIY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vXV7h05Uco1b8l82aILbVUZoA8R.jpg","genres":["триллер","боевик","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"511752","ru":"ഇര","en":"ഇര","year":"2018","type":"Фильм","rating":6.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/lBZYBYe58ibftmEgTDpZCYDDen1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qpDWO2bHuHXVBWNFAax2dMSExHD.jpg","genres":["криминал","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"576314","ru":"Weil 