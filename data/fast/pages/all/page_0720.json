. Телефонные разговоры становятся самой важной частью её дня, во время них девушка забывает обо всём на свете. И вот Серёжа говорит ей, что скоро получит отпуск. Эта мысль вселяет в Катю надежду на скорую встречу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1462200","ru":"Brother Sister Keeper","en":"Brother Sister Keeper","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/14fXkPq21l9QkkSCzhmR2PeRpAP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s1Vu0EDKKI2i5JwmsGItQ9IrfJC.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1460988","ru":"There Is Only One Way to Hold a Knife","en":"There Is Only One Way to Hold a Knife","year":"2023","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/eIz2uQXrdHSz77DbCesGPJ9HC9i.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wuYJ9d7Ly3kO41rKdYzpKfh9uKs.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1458390","ru":"Salvation History: A Sock Puppet Journey","en":"Salvation History: A Sock Puppet Journey","year":"2022","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/zphqNcUUcdYxyrNh0hgFRps0XLQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jnduoO6JZcq5j9opPrw6SP0xHLr.jpg","genres":["История","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1457825","ru":"Gunfight at The High Noon Saloon","en":"Gunfight at The High Noon Saloon","year":"2024","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fvF3q1BzlJV5JUfTmch82vmrVc7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pPNBYpKxrRpAnLstS9lkwFdMQYS.jpg","genres":["Вестерн","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1456710","ru":"Bochd","en":"Bochd","year":"2023","t