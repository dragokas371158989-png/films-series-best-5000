/image.tmdb.org/t/p/w342/nhWlip1s5YzhRFKGlHABGJrBhZn.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_46227","ru":"Герои забытых времен","en":"蒼い世界の中心で","year":"2012","type":"Аниме","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/tz0XyKP5tVGdrliCfNt4ssTUCoP.jpg","genres":["Боевик и Приключения","НФ и Фэнтези","мультфильм","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"685309","ru":"Sex and the Future","en":"Sex and the Future","year":"2020","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/hHtJhevKKC3ZNPslcojfLMecYjo.jpg","genres":["комедия","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"267458","ru":"Час призраков 2","en":"ตีสาม คืนสาม 3D","year":"2014","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/jIRjsy7mJCfXTUqQ4ONdQJgHFPP.jpg","genres":["триллер","ужасы"],"overview":"«Третья ночь». Он был крутым парнем, который держал в страхе весь район. После его гибели, кто-то начал клеиться к его красавице жене. Какое безрассудство! Ведь он был так ревнив при жизни. На третью ночь после смерти он вернулся!","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"400252","ru":"Доказательства правды","en":"Evidence of Truth","year":"2016","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/fLxa6227CBx78nNGdn5gleSt5u1.jpg","genres":["детектив","криминал","триллер","драма","телевизионный фильм"],"overview":"Эксперт-криминалист начинает подозревать, что её муж — серийный убийца, которого разыскивает полиция. Она и её бывший парень, а также детектив полиции, начинают идти по следу, но оказываются в смертельной опасности...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"313755","ru":"Черный принц","en":"The Black Prince","year":"2017","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/ulrxkxWFvBN2QnFxmypVAXBOOVj.jpg","genres":["история","драма"],"overview":"Это история отношений королевы Виктории и последнего короля Пенджаба, Махараджи Далипа Сингха. Когда умер его отец, мальчик принял христианство и переехал в Англию. Однако спустя много лет перед ним встал вопрос - продолжать жить на чужбине, или попробовать поднять сикхов на восстание и вернуть себе трон. Он верит в то, что пророчество великого гуру ему поможет, но вера иногда подводит даже королей.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"514222","ru":"Surprise Me!","en":"Surprise Me!","year":"2019","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/yf4ki6seKF9qoLCboCUfa0ntjO8.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"339077","ru":"Lovemilla","en":"Lovemilla","year":"2015","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/vzvF2Xm1sekqYu0hwfYgYBtWn8d.jpg","genres":["фантастика","комедия","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"295111","ru":"Chrieg","en":"Chrieg","year":"2014","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/z2ZLuyj2O3npj2lxBUmzP7uxr10.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"411041","ru":"ID2: Shadwell Army","en":"ID2: Shadwell Army","year":"2016","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/qVMdkwgBuZt6bDiEYhyRNm471LZ.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"263487","ru":"வடகறி","en":"வடகறி","year":"2014","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/n59O292K35Q5WAuqwaVwv7BkWm7.jpg","genres":["мелодрама","комедия","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"67054","ru":"Невинные ангелы","en":"アンジュ・ヴィエルジュ","year":"2016","type":"Аниме","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/sYMWLlLs3WBFm6sttEApY0JupX8.jpg","genres":["Боевик и Приключения","мультфильм","НФ и Фэнтези","Аниме"],"overview":"Джефферсон Пирс живёт с тайной. Когда-то он был супергероем Чёрной Молнией. Управляя молниями, он спасал людей и сражался с преступниками. Но впоследствии Пирс отказался от маски. Теперь он - отец двух дочек и директор школы, которая служит прибежищем для трудных подростков. Но когда в городе появляется новая опасная банда, Чёрная Молния вынужден вновь вернуться в мир.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_44883","ru":"Святой рыцарь","en":"ホーリーナイト","year":"2012","type":"Аниме","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/nbwIp2gdfWofIyu3qk1vH5Sy5qK.jpg","genres":["Боевик и Приключения","драма","мультфильм","НФ и Фэнтези","Аниме"],"overview":"История рассказывает о сироте Синте Мидзумуре. Он ученик миссионерской школы в Токио и ведёт размеренный образ жизни. И так неспеша проходило бы его время, но в школе появилась новая ученица. Лилит Кисимото — очаровательная румынская красотка, имеющая весьма необычную родословную. У неё в роду были вампиры, и поэтому она представляет собой смесь человека и вампира. А вот Синта — прямая её противоположность, ибо он охотник на вампиров, и его миссия — полностью искоренить это зло. Но вот незадача, Синта влюбляется в Лилит. С этого момента и начинаются их приключения.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1150478","ru":"Орел","en":"ఈగల్","year":"2024","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/mjQN27x0Dfkmsi3SRRkAIatOr2p.jpg","genres":["боевик","триллер"],"overview":"Сахадев Варма по прозвищу Орел, известный профессиональный убийца, отправляется на задание по пресечению незаконной торговли оружием, выдавая себя за хлопковода в Талаконе и перехватывая все незаконные сделки с оружием оттуда. Журналистка Налини пишет новостной репортаж о Сахадеве, чей редкий хлопок пользуется устойчивым спросом в зарубежных странах. Из-за новостного репортажа ее допрашивают агенты RAW, и она узнает о личности Сахадева, что побуждает ее начать журналистское расследование.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"764842","ru":"Мыслить как убийца","en":"스트리밍","year":"2025","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/yyFYasuBuHqS4EoaNmbLhGdvr80.jpg","genres":["триллер","детектив","криминал"],"overview":"Самый рейтинговый стример начинает терять популярность. Чтобы спасти положение, он решает в прямом эфире устроить расследование серии нераскрытых убийств. Собирая улики, парень приближается к раскрытию личности убийцы.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"677176","ru":"За чертой закона","en":"Broken Law","year":"2020","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/4x2ewZDsvTxLAnVlhBqvkjx2MwC.jpg","genres":["драма"],"overview":"Дэйв Конноли – уважаемый полицейский, но его верность закону проходит серьёзную проверку, когда его брат Джо, бывший заключенный, попадает в отчаянное положение и нуждается в его помощи.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"817772","ru":"Lust: A Seven Deadly Sins Story","en":"Lust: A Seven Deadly Sins Story","year":"2