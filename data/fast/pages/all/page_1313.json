ckdrop":"https://image.tmdb.org/t/p/w780/2QerJOQmmWcINcM1S1sNkDxjXkj.jpg","genres":["фантастика","мелодрама","триллер"],"overview":"В неизведанном будущем две ожесточенные души встречаются и противостоят друг другу тем, что они сделали и кем стали.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1058689","ru":"Моё животное","en":"My Animal","year":"2023","type":"Фильм","rating":4.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/qp0fLOf30L2pUA5gxEp0ZoUHPg2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cAUfKOD49fzODK4EXalEA1ANg0P.jpg","genres":["ужасы","мелодрама","фэнтези"],"overview":"Девушка-подросток Хизер живёт с родителями и младшими братьями в канадской глуши и мечтает стать вратарём местной мужской хоккейной команды. Однажды она знакомится с фигуристкой Джонни, и жизнь внезапно начинает играть новыми красками. Девушка проводит вечера с подругой и её компанией, но передавшаяся ей от отца особенность может стоить новым друзьям жизни — в полночь Хизер превращается в волка.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"393478","ru":"Hayat Öpücüğü","en":"Hayat Öpücüğü","year":"2015","type":"Фильм","rating":4.4,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/f3xIkogsxCJa9NrdGiMxBL6wsfI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/81edqW990HaocWlWGl0tHBWos9F.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"182981","ru":"Nude Area","en":"Nude Area","year":"2014","type":"Фильм","rating":4.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/qfnt11d8JyjQnyChAalt7QHayoh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cgK4CheVfQ9mAatjgjhWVzGLprp.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"489705","ru":"Смерть по прибытии","en":"Dead on Arrival","year":"2018","type":"Фильм","rating":4.4,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/vZMn84gTMCXngo80o05GHcnH7cm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vOF1FDmQGcUvOtD5fJ67Jlg6rms.jpg","genres":["триллер"],"overview":"Представитель фармацевтической компании приезжает в маленький городок, чтобы подписать контракт на продажу вакцины, но попадает в круговорот бандитских разборок, коррупции и полицейского произвола.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"25493","ru":"The Breastford Wives","en":"The Breastford Wives","year":"2007","type":"Фильм","rating":4.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/tEx2073cwxiN9niVVEvaZikbTMB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mUzcDkZ3ePNy4MlqR0JoeGnbztN.jpg","genres":["комедия","драма","фантастика","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"376575","ru":"48 часов, чтобы жить","en":"48 Hours to Live","year":"2016","type":"Фильм","rating":4.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/87tmBJac7Rl4EpCkURXkxqL7x2d.jpg","backdrop":"","genres":["криминал","музыка","триллер"],"overview":"В фильме переплетаются черный детектив, танцы и мистика. Преследуемый с обеих сторон закона герой-одиночка возвращается домой из реабилитационного центра, чтобы раскрыть убийство сестры, и оказывается впутанным в игру клубного мира Лос-Анджелеса.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"582148","ru":"Mamma + Mamma","en":"Mamma + Mamma","year":"2018","type":"Фильм","rating":4.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/1dwHgwOH4cylCzapKlT2kDZvmhu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tVnhEDh1izNJGPT7LsBjNFX0A4w.jpg","genres":["мелодрама","драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"258353","ru":"The Good Mistress","en":"The Good Mistress","year":"2014","type":"Фильм","rating":4.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/wjxgjoppoMP2AyJoWJZ5hyULKtE.jpg","backdrop":"","genres":["триллер","телевизионный фильм","криминал","детектив","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"776506","ru":"Пылающий мир","en":"The Blazing World","year":"2021","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/s18H9aU7yT91U2XPAc2a3UxldA7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yJpGFmoVsDKrVcXSyGf5HTx9i98.jpg","genres":["ужасы","фэнтези","приключения","драма"],"overview":"С тех пор, как Маргарет исполнилось шесть лет, ее преследуют воспоминания о том, как ее сестра тонет во время ссоры между их родителями. Став молодой женщиной, она все глубже погружается в свою извращенную внутреннюю жизнь и в конечном итоге оказывается на грани самоубийства. Пройдя эпическое путешествие по самым дымным и страшным коридорам своего воображения, она пытается изгнать своих внутренних демонов, что подталкивают ее все ближе и ближе к краю.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"661437","ru":"Похищение в эфире","en":"The Lead","year":"2020","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/m9ZWrxoznoMFBW1mlj8NA0f17er.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xpJIxYTx2PlQzpWUPUUNqRCOhgy.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"829577","ru":"The Siege of Robin Hood","en":"The Siege of Robin Hood","year":"2022","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/zetKhTVOuScOavtqi2sQT14vcyR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vf9NYIcXyrqf4A6NUI4QXKFQUL5.jpg","genres":["приключения","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"532163","ru":"7 осколков во времени","en":"7 Splinters in Time","year":"2018","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/bMLUM7GtjfL