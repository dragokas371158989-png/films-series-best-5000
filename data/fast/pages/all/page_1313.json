ешение — предложить группе должников поучаствовать в конкурсе «Айдолы Косиэна» и попытаться выиграть призовой фонд, который покроет все их долги за раз. Бедолагам ничего не остаётся, кроме как согласиться на условия и принять участие в этом непростом и масштабном конкурсе, в котором сосредоточится огромное количество как зрителей, так и участников из разных префектур.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"859163","ru":"형부를 탐하다","en":"형부를 탐하다","year":"2019","type":"Фильм","rating":4.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lHnM5FBes34pvNs3XCz62YJi7ys.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hhGoqjEw8vaSXsPbzIfDGUQy72N.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"455942","ru":"Aarambame Attagasam","en":"Aarambame Attagasam","year":"2017","type":"Фильм","rating":4.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rlrqP9JZUzyTf8MJTSXhSLyAAAl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tqDdgM2JTb1kWjnooyv5WGtQR5i.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"418515","ru":"Bir Gün Bir Çocuk","en":"Bir Gün Bir Çocuk","year":"2016","type":"Фильм","rating":4.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/6QdZN04275HGS5HDqX8klmXh8QR.jpg","backdrop":"","genres":["семейный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"982783","ru":"Stand Out: An LGBTQ+ Celebration","en":"Stand Out: An LGBTQ+ Celebration","year":"2022","type":"Фильм","rating":4.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/pflwbz4m4YCwS5wb0wXCk2lDkgU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/868lYxYHDCHEP19t4fDTun2GeGz.jpg","genres":["комедия","документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"336294","ru":"Американская Подопытная свинка: Буке