geRating":""},{"id":"473353","ru":"劇場版 屍囚獄 起ノ篇","en":"劇場版 屍囚獄 起ノ篇","year":"2017","type":"Фильм","rating":3.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/splPcNfltRjx4vmOPPcIgUwU8Z7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e3KqLfdiy8lpCQoVmgSdiHU7YsV.jpg","genres":["Ужасы","Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}