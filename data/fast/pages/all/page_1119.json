/gWSZQTOhAAGFVaWPci1xH5EdtWN.jpg","genres":["мультфильм","фэнтези","комедия","мелодрама","приключения","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"329155","ru":"Sister Code","en":"Sister Code","year":"2015","type":"Фильм","rating":6.3,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/xPbpgD995s3yxVjFC2BZy2SqDgZ.jpg","backdrop":"","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"691209","ru":"Friend","en":"Friend","year":"2014","type":"Фильм","rating":6.3,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/uD3iFzw159EGNnQDk62YIvQSRA4.jpg","backdrop":"","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_279731","ru":"Твоя форма","en":"ユア・フォルマ","year":"2025","type":"Аниме","rating":6.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/wS1t8dpoAAjytnnrsBshr2DHq1E.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iYXJ0FklzUDt58WnURoGU3hTYiq.jpg","genres":["мультфильм","детектив","НФ и Фэнтези","Аниме"],"overview":"Альтернативная реальность. Для спасения человечества от опасного вируса учёные изобретают особую технологию, известную как «умные нити». Благодаря ей теперь можно записывать все воспоминания и эмоции людей и хранить их бесконечно долго, чем и пользуются в своей работе правоохранительные органы. Цифровой следователь Этика Хиэда особенно преуспела в искусстве извлечения информации из этих нитей. Однажды её напарником назначают андроида Харольда Люкрафта с дерзким характером, что не очень радует Этику, но приказы не обсуждаются. Тандему предстоит заняться важным расследованием, столкнуться с корпоративным заговором и попытаться спасти человечество от новой технологической инфекции, поражающей мозг.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_256109","ru":"Божественная книга","en":"神統記","year":"2025","type":"Аниме","rating":6.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/z2XzPh3mOk4bdFlJOT7ZFm6OTr3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4gcAg5Y47J4BPgrTHRTpoEolQmd.jpg","genres":["Боевик и Приключения","НФ и Фэнтези","драма","мультфильм","Аниме"],"overview":"Кай живёт в период непрекращающихся войн между людьми и полулюдьми. Сражения уже давно стали для него привычным делом, и вместе с воинами из своей деревни он день за днём отстаивает её покой. Но силы людей уже на исходе. Близкие товарищи Кая погибают в боях один за другим, и он ничего не может с этим поделать. Как вдруг... в его голове возникают воспоминания, которых быть не должно. Ему является невиданный мир, в котором люди достигли высокого технологического прогресса. И теперь ему предстоит решить, как распорядиться обретёнными знаниями, чтобы помочь человечеству выстоять против превосходящих сил врага.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_284448","ru":"Домашний репетитор герцогини","en":"公女殿下の家庭教師","year":"2025","type":"Аниме","rating":6.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/dNX2wB1dBnNA76Vpj1ZyKOeUbi1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jOOQ8JHCbgiPrTVGV3RnHEAIFQP.jpg","genres":["мультфильм","НФ и Фэнтези","Аниме"],"overview":"Аллен провалил экзамен на придворного мага, и даже денег на дорогу домой у него нет. Так что теперь он ищет работу. И вдруг — вот удача! — ему предлагают стать домашним репетитором для дочери герцога, юной герцогини. Дело выглядит сомнительным, но вряд ли ученица окажется более непутёвой, чем прежняя... Если не учитывать тот факт, что она вообще не владеет магией! Однако нестандартные уроки Аллена мало-помалу меняют жизнь девочки...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_80464","ru":"Холмс из Киото","en":"京都寺町三条のホームズ","year":"2018","type":"Аниме","rating":6.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/lfpi0aWD5IwMtbGAWPZ2QzL0tuS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/juSdnxGR64fma152dE5DGXt0FVS.jpg","genres":["мультфильм","детектив","Аниме"],"overview":"В торговом районе Киото Терамачи Санджо расположен антикварный магазинчик. Старшеклассница Маширо Аой сталкивается с Ягаширой Киётакой, сыном владельца магазина, и начинает работать у них. Вместе с Киётакой, которого кличут «Холмсом Терамачи Санджо», они расследуют странные дела, которые им поручают самые разные клиенты.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"513567","ru":"機動戦士SDガンダム Mk-III","en":"機動戦士SDガンダム Mk-III","year":"1990","type":"Аниме","rating":6.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/ghfoY6ZzdkM16xJ8mC37MftHs9M.jpg","backdrop":"","genres":["мультфильм","комедия","фантастика","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1477448","ru":"К Хэллоуину приготовиться","en":"Haul Out the Halloween","year":"2025","type":"Фильм","rating":6.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/jbPRLRliQFZJumIjzuQ6qsODnKm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/WVCy8tL18tDQ9oxnqgbW9nmumZ.jpg","genres":["комедия","телевизионный фильм"],"overview":"Новые соседи, помешанные на Хэллоуине, вдохновляют жителей Эвергрин-Лейн использовать самые жуткие костюмы и декорации, чтобы стать Эверскрим-Лейн.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1357886","ru":"Django Undisputed","en":"Django Undisputed","year":"2024","type":"Фильм","rating":6.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/porcUhC4jqFt72TaxbjOQo2lTzL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nvdLEfAWcfTNn45SpwBnLGBmOR1.jpg","genres":["вестерн"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1012286","ru":"Santa Bootcamp","en":"Santa Bootcamp","year":"2022","type":"Фильм","rating":6.3,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/c7jXCoxqB3LSfEUx34UseSfn4pC.jpg","backdrop":"https