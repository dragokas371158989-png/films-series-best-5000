егодняшнего дня и боится быть собой, потому и прячется за масками своих персонажей. Но метаморфозы, которые вскоре начинают происходить с Лориком, полностью меняют его мировоззрение, отношение к жизни и к людям. Теперь его главная цель - спасти маленькую больную девочку Асю...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"975743","ru":"逮捕しちゃうぞ イン アメリカ","en":"逮捕しちゃうぞ イン アメリカ","year":"2002","type":"Мультфильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/po1d2ha9MfyVB1koxIQ1dkn0Cxf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k6n68QDZuO53OB7fzWmsShlT4xU.jpg","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"798894","ru":"悪魔が来りて笛を吹く","en":"悪魔が来りて笛を吹く","year":"2018","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fWUvtcyvGpmuhkBrcX55IlVS9Mb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nLPtXWIKGZqr2iF4feKNcA7CDLA.jpg","genres":["Драма","Ужасы","Детектив","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"426537","ru":"Alan Bennett's Diaries","en":"Alan Bennett's Diaries","year":"2016","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/cLMgoef1RePXbWiIOnYfGWuHMl5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yJHtpP2sHJzaJ3SsdsmxsiuS5f9.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"658767","ru":"Intercourse","en":"Intercourse","year":"2019","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/uDR6esmRBE5Cc9j8OFOGzaA0Zfb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8HcLg6rjizgA0VM4hYcYEhPchMu.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"689751","ru":"Capitán Escudo","en":"Capitán Escudo","year":"2018","type":"Мультфильм","rating":6.0,"votes":1,"poster":"https://im