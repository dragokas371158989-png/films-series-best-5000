все люди испытывают их. Окружающие думают, что на «Снежную Королеву» наложено злое проклятье. Сама она не верит в подобные глупости и просто ждет, что же в дальнейшем преподнесет ей судьба.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"472446","ru":"Kristina von Schweden - Die wilde Königin","en":"Kristina von Schweden - Die wilde Königin","year":"2015","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/mbBEYSSnOgW7ipLPAhEUhgij5E.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zKitEF8MON8vbmmS7XVzU4GHG23.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"564284","ru":"赛尔号大电影1：寻找凤凰神兽","en":"赛尔号大电影1：寻找凤凰神兽","year":"2011","type":"Мультфильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/oh5Iflio2KuxrNC9Ynks3OoiRPj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gth1L32eDYd36vFz0rcINhVeIW0.jpg","genres":["Мультфильм","Приключения","Фэнтези","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"783786","ru":"お江戸のキャンディー2 ロワゾー・ドゥ・パラディ (天国の鳥) 編","en":"お江戸のキャンディー2 ロワゾー・ドゥ・パラディ (天国の鳥) 編","year":"2017","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/2PeoGfh7DcvVq4LWtjoYvhJUUDp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jeHgGaSM7uX8mn74acetnClYKPt.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"462924","ru":"Spice It Up","en":"Spice It Up","year":"2019","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fu68U6ALwPjEgXDtQklKA1eoFvl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sIdpo9jRRQOLiEM2JHUxRVQyz08.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}