:"","country":"","ageRating":""},{"id":"828948","ru":"こちらあみ子","en":"こちらあみ子","year":"2022","type":"Фильм","rating":7.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/l4Flbo07SsidWlh0NWeCdlJBRb2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jsA43zcQf1kUWGGEYDW3IzoA5qh.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"2033","ru":"Зоопарк в обувной коробке","en":"Shoebox Zoo","year":"2004","type":"Сериал","rating":7.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/hMGO9iOA5Vm8QEa4dGOzN6zWgE5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hmu5f2Psxg10l2tamUYfTWplLTJ.jpg","genres":["Фантастика","Драма","Боевик"],"overview":"На свой 11-й день рождения девочка Марни получает от таинственного старьевщика из антикварной лавки необычный подарок — игрушечных животных в обувной коробке. С этого момента в ее жизни начинают происходить самые настоящие чудеса. Однажды эти животные оживают и рассказывают Марни свою тайну: когда-то они были учениками великого мага, но попытались украсть волшебную Книгу Запретных Знаний и были за это заколдованы учителем. Теперь помочь животным может только Марни, но для этого ей придется найти ту самую волшебную книгу и избежать ловушек злого Толедо-оборотня, который давно мечтает найти этих заколдованных зверей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"21865","ru":"Санта против Снеговика","en":"Santa vs. the Snowman","year":"2002","type":"Мультфильм","rating":7.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/y2xHNOeqsP0V6zi5KVAocBoQZwI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y6QX7e0icgEAnuSe3y0KOTlCoCz.jpg","genres":["Мультфильм","Комедия","Семейный"],"overview":"Одним морозным днем симпатичный Снеговик забредает в Деревню Санты. В окне мастерской, где делают подарки, он видит сверкающую новую флейту. Не устояв перед соблазном, Снеговик крадёт ее. Это на первый взгляд несущественное происшествие оборачивается гигантской битвой за Рождество, в которой Снеговик со своими подручными выступают против Санты и его армии эльфов. Цель Снеговика — отвоевать у почтенного пожилого джентльмена в красном сегмент эксклюзивно принадлежащего ему мирового рынка доставки рождественских подарков.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"75480","ru":"灵魂摆渡","en":"灵魂摆渡","year":"2014","type":"Сериал","rating":7.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/m6KcWXw2mLRj5oV612YuvzWjFmm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1tbSyMxIEgi9LgeVKUp05Nmy5PP.jpg","genres":["Детектив","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"81772","ru":"Oteckovia","en":"Oteckovia","year":"2018","type":"Сериал","rating":7.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/r1hDy1wJ52NEilfcSzs0ocHEJZl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uu52dx6l1yFN7f60GPhgQFPfOvT.jpg","genres":["Семейный","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"4226","ru":"London's Burning","en":"London's Burning","year":"1986","type":"Сериал","rating":7.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/2k4lU0JDzLRlj2yaKRUaKT0RrXg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bM2MULXsfdB6tHyxu4W81NcP5EQ.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"625777","ru":"The Queens","en":"The Queens","year":"2019","type":"Фильм","rating":7.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/5rbZULs1ZoJVuC9kEHky4xJufD4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4upPCFbIisSOhTOJBWIJfmCBIHu.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"457902","ru":"Edgar Allan Poe: Buried Alive","en":"Edgar Allan Poe: Buried Alive","year":"2017","type":"Фильм","rating":7.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/dunEyPAQDCj8F