":""},{"id":"1069910","ru":"Despatch","en":"Despatch","year":"2024","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ez8TcpGjmUj4gNzh4zG7oMqCW8C.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y4eA7NRzNkQssbhdRH0WxTFQ9y5.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"347616","ru":"Grace and Grit","en":"Grace and Grit","year":"2021","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/cWzEWc7pa9gW5X2prxoXeF8pDfJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jHcn85pI9YvIjaCUwfudmBwASO.jpg","genres":["драма","комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"993249","ru":"ჩემი ოთახი","en":"ჩემი ოთახი","year":"2022","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/pe2IOpKReAeGnb17mNXW51OT4jy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/At5a3ZxhNN98Ue7d2wHd5RpxZkK.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"702608","ru":"Sleepaway Slasher","en":"Sleepaway Slasher","year":"2020","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/nSNqH0hi9wKLdRL1sXEJ71qAyW3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j76NwzsQiGsqoaO0QzvwpYfcpEB.jpg","genres":["ужасы","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"514801","ru":"Veneza","en":"Veneza","year":"2021","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/1gKl7CcugzxsrnSLAm4Pr8O6jnb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rl4VqJLu7d74i3aiMbypD4sEf2l.jpg","genres":["драма","комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"627077","ru":"Breve Miragem de Sol","en":"Breve Miragem de Sol","year":"2020","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/8XbMT03REyCOcFFZRf4J3XcOjaQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b59cjLTPXQKEZo3Qxr5NfYgchy4.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"204407","ru":"Лес любви","en":"Bosco d'amore","year":"1981","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/jNV46xSIONTEvIAWon6NnveH7eG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fjcX01h7VNUhhNjhFBthH7sTp2z.jpg","genres":["драма","мелодрама"],"overview":"Племянник кардинала Пьетро Боккамацца влюблен в Аньолеллу, девушку из гораздо более скромной семьи. Вопреки запрету родных, влюбленные бегут из замка, но рыщущие повсюду банды разбойников и отряды наемников разлучают их. Прежде, чем вновь обрести друг друга, влюбленным предстоит претерпеть множество страданий на дорогах страны, в которой властвуют война и чума. И пусть в конце пути их ждет счастливая встреча, молодым людям уже никогда не стать прежними.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"83592","ru":"Поймёшь ли ты шутку?","en":"Verstehen Sie Spaß?","year":"1980","type":"Сериал","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/iqDCXu80qwdjS5QpV0xey85MEX8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6vYbbSHsWhJpUclJMSNgO5vzQ9i.jpg","genres":["Реалити-шоу"],"overview":"Это развлекательное шоу , намеренное приводить людей в затруднительное положение, и это снимается скрытой камерой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"365359","ru":"Объезды","en":"Detours","year":"2016","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/wJ1AjWNHZbsRQzmiyNYbipaYOvc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/miZXbQIeK3d6ExIMFagh9hPxW7J.jpg","genres":["комедия","драма"],"overview":"Незамужняя жительница Нью-Йорка вынуждена переехать во Флориду; она едет на юг с овдовевшим отцом и прахом матери в банке из-под кофе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"307087","ru":"Призрак и кит","en":"The Ghost and the Whale","year":"2014","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/qMuGWqsMhPwAfcdIhuIu32sTAls.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zXP2ioMJRhewGsK5pbh2eR9WtVW.jpg","genres":["триллер","драма","детектив"],"overview":"Фильм рассказывает историю Джозефа, страдающего биполярным расстройством человека, который однажды ушел в море вместе со своей любимой, а вернулся обратно, в свой сонный городок, уже один. Его супруга Аннабель бесследно исчезла, и судьба ее остается неизвестной. Год спустя известный журналист Эд Хейл приезжает в город, чтобы попытаться проникнуть в тайны истории, приключившейся с Джозефом. Однако герой впал в тяжелое состояние психоза, в котором истеричная мания чередуется с меланхолией. Часто он находит убежище лишь в обществе своего единственного друга — Серого Кита. Чтобы разобраться в здешних обычаях и нравах, Эд прибегает к помощи местного жителя — жаждущего стать писателем Митча. А тем временем, отсидев десять лет в тюрьме, возвращается домой Джек, наиболее жестокий из братьев жены Джозефа, с большим желанием отомстить. Эд и Джозеф должны как можно скорее отыскать правду в темном деле исчезновения Аннабель, чтобы представить ее Джеку, прежде чем тот похоронит их обоих.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"308551","ru":"Сектор 17","en":"Toplu Taşıma 17","year":"2019","type":"Фильм","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/mAna3gXGfofxJrDzWTakHa6svlg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/d1fc8ON4OWZyd4yAhsCWsPKgYQN.jpg","genres":["боевик"],"overview":"2026 год. Европа опустошена неизвестным вирусом, который превратил огромную часть населения в зомби. Группа солдат сопротивления пытаются спасти молодую девушку, которая является последней надеждой на создание антивируса.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"62992","ru":"DAS!","en":"DAS!","year":"1991","type":"Сериал","rating":4.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/yMg0l6hxCnR94Fcl1F1IEkmG26V.jpg","backdrop":"","genres":["Ток-шоу","Новости"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}