es":"","status":"","studio":"","country":"","ageRating":""},{"id":"461834","ru":"Batman Is Just Not That Into You","en":"Batman Is Just Not That Into You","year":"2017","type":"Мультфильм","rating":5.9,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/cg4FZqcjuv7XVJEMa5beCNIf1y9.jpg","genres":["семейный","мультфильм","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"372142","ru":"شد أجزاء","en":"شد أجزاء","year":"2015","type":"Фильм","rating":5.9,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/oqUb4CDC70aQqGCcYwRgwrWVTzm.jpg","genres":["боевик","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_128118","ru":"Безумное погружение: Потерянное Дитя","en":"ディープインサニティ ザ・ロストチャイルド","year":"2021","type":"Аниме","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/fhrvT77ICBIzH3lgYpMy5RW5D70.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","Аниме"],"overview":"В недалёком будущем на человечество обрушилась эпидемия так называемого Синдрома Рэндольфа - болезни, вызывающей коматозное состояние. Примерно в то же время в Антарктиде обнаружили колоссальный пещерный комплекс Эсайлем, каким-то образом связанный с Синдромом Рэндольфа. Кроме того, в Эсайлеме обитают удивительные существа и залегают запасы неизвестных ранее полезных ископаемых. В поисках новых ресурсов и лекарства от болезни люди начинают исследовать Эсайлем. Среди них - Даниэль Кай Сигурэ.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_218563","ru":"Хулиганки Рокудо","en":"六道の悪女たち","year":"2023","type":"Аниме","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/jRA696ttiD4pUt4NYFX1vNTGGVQ.jpg","genres":["мультфильм","Аниме"],"overview":"Скромнягу Рокудо судьба занесла в школу «Амори», кишащую бандитами и хулиганами. Сам бы он с ними не сладил, но на помощь пришёл подарок дедушки — колдовство, притягивающие к нему плохих девчонок.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_248086","ru":"Идолмастер: Блестящие цвета","en":"アイドルマスター シャイニーカラーズ","year":"2024","type":"Аниме","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/plv79G8KMsN4U8keajQKva3aSCy.jpg","genres":["мультфильм","драма","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_96196","ru":"Новый мастер кулинарии","en":"真・中華一番!","year":"2019","type":"Аниме","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/p6X1rdYJeKjV2K1eH91HJJ5atgi.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"История расскажет о величайшем турнире поваров Китая, куда гении ножей и поварешек сотнями стягиваются, дабы определить лучшего.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"469211","ru":"Коколорс","en":"COCOLORS","year":"2017","type":"Аниме","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/aVWKiSHhYVEXnSFs7P2NahgfAYq.jpg","genres":["мультфильм","фантастика","Аниме"],"overview":"В этом мире царит бесконечный дождь. Тут мрачная мгла наполняет небо и покрывает землю. Человечество, испугавшись пепла, что пожирает человеческую плоть, не находит другого решения, кроме как спрятаться под защитными масками и костюмами. И вот, одевшись в свои скафандры, люди бегут глубоко в подполье. Это история детей, растущих в бесцветном мире под названием Коколорс.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_50071","ru":"Ай Май Ми","en":"あいまいみー","year":"2013","type":"Аниме","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/1hVJnWV0ghfhN3TLKFUxkYn9S2i.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"476934","ru":"Sex & Violence with Machspeed","en":"Sex & Violence with Machspeed","year":"2015","type":"Аниме","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/w9rlfiD8yeFbhnRB7Pp29lNOJVd.jpg","genres":["мультфильм","боевик","комедия","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1370424","ru":"Он наблюдает за тобой","en":"He's Watching You","year":"2026","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/lGrxMTGzoO120uuHuYxwbv5Ypcw.jpg","genres":["ужасы","триллер"],"overview":"Тихий городок всколыхнула череда жестоких преступлений. Виной тому – маньяк из местных легенд, облачённый в красное пальто и жуткую маску. Одновременно с этим подросток находит коллекцию странных видеокассет, способных пролить свет на личность печально известного серийного убийцы.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"261617","ru":"Проклятия","en":"Las maldiciones","year":"2025","type":"Сериал","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/x1nTOgqSWOSqAttI2QhJCK2NDAN.jpg","genres":["детектив","драма"],"overview":"Дочь губернатора исчезает в решающий момент его карьеры. Разрываясь между амбициями и семейными тайнами, он должен выбрать между политикой и безопасностью своего ребенка.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1359236","ru":"Украсьте залы на Черри Лейн","en":"Deck the Halls on Cherry Lane","year":"2024","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/hlhoZwNZgq9L1Jip9BVvLtGDbdw.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"В 1966 году Дэвид мечтал провести тихое и незаметное Рождество, но его планы летят к чертям, когда соседка Стефани внезапно объявляет, что выиграла конкурс и будет вести прямую трансляцию рождественского шоу Томми Сондерса… из его дома. В 1981 году на Черри Лейн разворачивается новая история: Джон и Лиззи готовятся к своему последнему Рождеству в этом уютном месте. В 2000 году на Черри Лейн Мэтт и Ребекка — лучшие друзья с детства — вдруг начинают видеть друг друга в новом свете. Три эпохи, три истории и одно волшебство Рождества на Черри Лейн, где каждый находит то, что по-настоящему ценно.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1084637","ru":"Sister Dating Swap","en":"Sister Dating Swap","year":"2023","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/wH0Qay02tayjRFBTlCDC7l4qUeZ.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1547913","ru":"A Keller Christmas Vacation","en":"A Keller Christmas Vacation","year":"2025","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/4RiHKqA8d36YKvkbfl0YCcPLgt1.jpg","genres":["семейный","телевизионный фильм","комедия","приключения"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1241476","ru":"来福大酒店","en":"来福大酒店","year":"2024","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/yywxMg2eP6S2YBMFct3Af8frVrO.jpg","genres":["семейный","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"496348","ru":"Ghoomketu","en":"Ghoomketu","year":"2020","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/xoxGcPUSQM8uSyLDqy5jEPk4tXV.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"620637","ru":"துக்ளக் தர்பார்","en":"துக்ளக் தர்பார்","year":"2021","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/Ajxa9eE4vojurvYqSmRQVLSh6bt.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"475351","ru":"Тролль: История с хвостом","en":"Troll: The Tale of a Tail","year":"2018","type":"Мультфильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/zhn7gnGhkf5aSbXaRdLcsSAmWym.jpg","genres":["мультфильм","приключения","семейный"],"overview":"Далеко-далеко, в дремучем лесу есть маленькое королевство троллей. Случилась беда, во время забега сильнейших король Гром попал в капкан и обратился в камень. На трон взошёл его злой брат… Юный принц Трим (сын короля Грома) может спасти своего отца и всё королевство, но для этого он должен отправиться в опасное путешествие в мир людей.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"449858","ru":"Cobain","en":"Cobain","year":"2018","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/mXwxTHHoqrOijGJ1OrweWOrl1Gb.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"570587","ru":"黑暗迷宫","en":"黑暗迷宫","year":"2018","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/ilju5NjTb6l1IIpT2u2ST6TNg5r.jpg","genres":["криминал","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"411052","ru":"暗色天堂","en":"暗色天堂","year":"2016","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/sD4KIlhF90pGJftYeVdJRvbZte6.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"398455","ru":"To Keep the Light","en":"To Keep the Light","year":"2016","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/ob2ZEONKi2olYndsdVkjMueneOa.jpg","ge