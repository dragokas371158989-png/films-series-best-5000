го парня, для которого она становится проводником, способом прикосновения к недоступному для него звуку, и незаметно для себя из фонового статиста вдруг превращается в главную героиню своей собственной истории.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1696236","ru":"మరీచిక","en":"మరీచిక","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/4Frhm74pTez19R2n3KJerHPl0FW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6OK3XhunlgLkHmrqZfxqxpIoTft.jpg","genres":["Мелодрама","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}