ступать в университет. Юля вносит диссонанс в спокойную жизнь героев сериала, и конечно, ни один из ребят не остается равнодушным к новой замечательной соседке.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"67356","ru":"Másfélmillió lépés Magyarországon","en":"Másfélmillió lépés Magyarországon","year":"1981","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rxFY5vgn5fudXK95xqmwFDatQxb.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"66841","ru":"Il pianeta dei dinosauri","en":"Il pianeta dei dinosauri","year":"1993","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wdqt2nQ9pGSBYgcg3bKXE33CFjn.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"66148","ru":"How The Earth Works","en":"How The Earth Works","year":"2013","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hBrv1jK43XcccXUeRchjcWRFdIz.jpg","genres":["документальный","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"58757","ru":"Criminal Mindscape","en":"Criminal Mindscape","year":"","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/44e2mYp1Vk35suzgFJHMlB6KSzr.jpg","genres":["криминал","драма","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"43741","ru":"Vic and Bob's Afternoon Delights","en":"Vic and Bob's Afternoon Delights","year":"2011","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/kOu55xQmX2oYHGScfbbT8wRMDKA.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1575","ru":"Lost","en":"Lost","year":"2001","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/58IGb9