":["документальный","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1704221","ru":"Scratch And Whine","en":"Scratch And Whine","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/e8FGmxyO78Yhlzo4E1r7GqFwd0y.jpg","genres":["ужасы","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1476994","ru":"Распаковка","en":"Распаковка","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/apAoGjfSXuV7Pj4DUw8Tpsx1ksS.jpg","genres":["комедия"],"overview":"Популярный блогер Влад пытается привлечь внимание к своему концерту оригинальным способом — выставляет на торги самого себя. Лот тут же достается сыну богатого бизнесмена. Теперь Влад обязан развлекать Борю целую неделю. Все попытки разорвать контракт упираются в огромные штрафы, и тогда Влад решает как следует разозлить Борю и сделать из его жизни видеоблог. В ответ Боря устраивает ему все новые и новые испытания.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1696198","ru":"Little Nightmares - Broken Promises","en":"Little Nightmares - Broken Promises","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/uErVDkCtGOGiowk5aRxoYMXNFPf.jpg","genres":["драма","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1707626","ru":"梦寻苏毗女儿国","en":"梦寻苏毗女儿国","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/gVpbdNdiUXmoXJhnfkx0VjSLVn1.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1701861","ru":"Tahle párty je DEAD","en":"Tahle párty je DEAD","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/j04NnQyN2hnjcNI0vA93rEaf2bJ.jpg","genres":["комедия","ужасы"],"overview":"","sourc