ашенная команда открыто соревнуются со старомодным преступным синдикатом Индо, чтобы захватить ванкуверскую сцену наркотиков и оружия.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"515914","ru":"Hellhole","en":"Hellhole","year":"2019","type":"Фильм","rating":3.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/kmKeNAHZ38xtFUEcaz2rGZPW2In.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1tSd3gUYylnfOj48qlZaOwohixs.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"323429","ru":"The Nymphets","en":"The Nymphets","year":"2015","type":"Фильм","rating":3.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/3QO414mr8AEUXQoKeYF0IcztPjF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vBLrva1d6TUB9LDf2chzQUPM37H.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"370800","ru":"மொட்ட சிவா கெட்ட சிவா","en":"மொட்ட சிவா கெட்ட சிவா","year":"2017","type":"Фильм","rating":3.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/3NhIZvqe5w7GsPG6YV4wrDFEQHe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nOjTkRT9GiPHvFCViWcjkAu6Z0q.jpg","genres":["Боевик","Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"555137","ru":"ആനക്കള്ളൻ","en":"ആനക്കള്ളൻ","year":"2018","type":"Фильм","rating":3.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/b8swjymdf6xa8m302CJ9pvJw1y9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jiDu4NYZMmO5sQL1RQQlRMzjkrn.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"419471","ru":"The Unbidden","en":"The Unbidden","year":"2016","type":"Фильм","rating":3.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/s0SyBTmPE3bdxFnZyEdacNagDz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1Vhj2IjWaQmXxcgr7Rxi94lSUf1.jpg","genres":["Триллер","Ужасы","Детектив"],"overview"