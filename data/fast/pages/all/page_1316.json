fjb1qxUq8z6w1tiGcs0Ks.jpg","backdrop":"","genres":["фэнтези","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1151861","ru":"火の鳥 エデンの花","en":"火の鳥 エデンの花","year":"2023","type":"Мультфильм","rating":4.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/75KCk7e9g4yKtGTci90fhQuKQrG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/etvGXroryuzCo0mQOB7WS76slUu.jpg","genres":["мультфильм","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1296682","ru":"Agentes Muito Especiais","en":"Agentes Muito Especiais","year":"2026","type":"Фильм","rating":4.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/lOnODWkmfV3PQDsBYrAdoL2SBT0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mgG2553nDqcULgfEVLiS73n9B1l.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"187334","ru":"Акварион: Гимн триумфу","en":"劇場版アクエリオン -壱発逆転篇-","year":"2007","type":"Мультфильм","rating":4.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/aW97fR83Kw2hVfWeF4C4Pbbp3Ez.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cQPqfw6FtbbcawekdXZJbsZElkN.jpg","genres":["боевик","мелодрама","мультфильм","фантастика"],"overview":"Этот фильм разбит на две части и представляет из себя альтернативную историю первого сезона сериала с дополнительной аркой, в которой герои получают задание изучить цветы. Сюжет полнометражного фильма имеет несколько отличий от оригинальной TV-серии: Сириус гибнет в самом начале истории, детство Аполло проходит иначе, и большее внимание уделяется событиям 12000-летней давности, в частности, смерти Аполлониуса и сложной судьбе прошлой инкарнации Рейки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"311620","ru":"Застрявшие во времени","en":"Frozen in Time","year":"2014","type":"Мультфильм","rating":4.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/f567S5aYP3POuTsgENHB0CWSTdJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/avHi7r32ZFNWaBps5h9vsLZRQ1D.jpg","genres":["мультфильм","семейный"],"overview":"Случилось, что в канун Рождества, Пети и Эрик Портл забрались в мастерскую своего дедушки, несмотря на то, что родители строго-настрого запрещали им это делать. Там они испортили необыкновенные часы, способные останавливать время. И в тот же миг они стали проживать этот день заново. Но, то что сперва казалось забавным, быстро надоело. Теперь им предстоит разобраться от чего они застряли в этом дне. Может причина в их плохом поведении и еще не поздно все исправить. Ведь иначе, Рождество никогда не наступит.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"73953","ru":"Paixão","en":"Paixão","year":"2017","type":"Сериал","rating":4.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/aJtoBVayILbOHgaeSHlkkqRWQNm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t9bqKlU2ACrImM64Z0d56eALSt9.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"266674","ru":"ലണ്ടന്‍ ബ്രിഡ്ജ്","en":"ലണ്ടന്‍ ബ്രിഡ്ജ്","year":"2014","type":"Фильм","rating":4.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/mvKSFaXqauJGcsykQj3EXhVznM2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sj7RwfVDluWGSYGcZcHWF08cEfc.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}