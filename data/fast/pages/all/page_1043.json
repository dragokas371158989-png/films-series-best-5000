342/nPF3WNHOvn0A1nIe2cBawcLHX6y.jpg","backdrop":"","genres":["мультфильм"],"overview":"История озорной обезьянки, которую из джунглей Африки привезли в цивилизованный город, где ей пришлось сменить несколько хозяев. Но настоящая обезьянка никогда не забудет свои джунгли...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448846","ru":"我的青春期","en":"我的青春期","year":"2015","type":"Фильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wmuCoAJDfdTRNcr8BJANtK97lg5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l3Mv4xKacuhYXx1LosfOu0y4OSc.jpg","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448413","ru":"Опасная шалость","en":"Опасная шалость","year":"1954","type":"Мультфильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/zljEeqKJjeLaghYZgBmMVMHnDYF.jpg","backdrop":"","genres":["мультфильм"],"overview":"Фильм-предостережение от опасных шалостей. Два мальчика забираются в легковую машину и нечаянно включают мотор. Никем не управляемая машина мчится вперед. В догонку отправляется милиционер. На мотоцикле он достигает машину и спасает мальчиков от неминуемой катастрофы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"584087","ru":"فزاع","en":"فزاع","year":"2015","type":"Фильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3QR9FNCK3wxRLY9fhKVE7cK0Iz9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wNQFbLfU2ukdCHYqan6GCgxYsvo.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"525741","ru":"No More Heroes 1.5","en":"No More Heroes 1.5","year":"2012","type":"Мультфильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/emwCxzTzTTI1E4i85o3SYojIQTo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eoLjEj5qoB64RK6NFoY4UCIdGEN.jpg","genres":["боевик","мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"714259","ru":"Ловушка для Бамбра","en":"Ловушка для Бамбра","year":"1991","type":"Мультфильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/x3ERvLcwYcCg54gPwcRyBWWtOz3.jpg","backdrop":"","genres":["мультфильм"],"overview":"Коварный и злой Охотник Кочерыжка похищает Кота для того, чтобы обменять его на Бамбра. Бамбр соглашается на обмен и сдаётся в плен охотнику. Но верные друзья — Отшельник, Мышь и Птица — не бросают товарища в беде и спасают Кота.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448009","ru":"Зай и Чик","en":"Зай и Чик","year":"1952","type":"Мультфильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/vo6yOYhBbDgyEwvhbAqeDAneSGe.jpg","backdrop":"","genres":["мультфильм"],"overview":"Поучительный мультфильм для малышей о том, как важно соблюдать правила дорожного движения. Дело происходит в городе игрушек. Двое ватных зайчат — братья Зай и Чик — получают от Петрушки приглашение выступить в концерте. По дороге в театр озорной и непослушный Чик множество раз нарушает правила дорожного движения — играет в мяч на проезжей части, перебегает улицу на красный свет, пытается проехать на буфере троллейбуса… И, конечно, вместо концерта попадает под машину. Добрый доктор Айболит приходит на помощь и пришивает Чику оторванную лапку. Но помочь пострадавшим людям совсем не так просто...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"482886","ru":"Dive Olly Dive and the Octopus Rescue","en":"Dive Olly Dive and the Octopus Rescue","year":"2016","type":"Мультфильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fGfw1Ws9HLbf6QJcHiegs1t0q0p.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rBtBNAClJMGs58N7gwdajcZyicQ.jpg","genres":["мультфильм","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448791","ru":"Медведь - липовая нога","en":"Медведь - липовая нога","year":"1984","type":"Мультфильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/dmv31E4x5gVh7A8XgCuDAzDdgin.jpg","backdrop":"","genres":["мультфильм"],"overview":"На сюжет русской народной сказки. Медведь залез на пасеку и, отбиваясь от пчёл, попал лапой в улей-колоду. Поскольку ни он сам, ни лесные звери снять её не смогли, пришлось косолапому воришке идти за помощью к людям. Ночью медведь пришёл к избе, где жили мужик с женой — хозяева пасеки, стал заглядывать в окошки. Хозяева испугались и завалили дверь, придвинув всю домашнюю утварь. На рассвете вышли, а во дворе медведь спит. Мужик с женой отпилили дно улья и освободили медведя.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"483033","ru":"Nikki","en":"Nikki","year":"2000","type":"Мультфильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/sRirgwjD59g2Du2exLTMtdzmDtR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6aCHIRKHYn2HzqdxVfeaX6S7L34.jpg","genres":["семейный","мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"295662","ru":"VeggieTales: Beauty and the Beet","en":"VeggieTales: Beauty and the Beet","year":"2014","type":"Мультфильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4uygKXC8lw9SqNQR8hmQUKC153I.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jpTYjP5VK1KVBZhbENO5kCXv8M1.jpg","genres":["мультфильм","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"568907","ru":"Wild Kratts: A Creature Christmas","en":"Wild Kratts: A Creature Christmas","year":"2015","type":"Мультфильм","rating":7.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xCibWxPyQ2m7hWpswVQFu1jEIno.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nX3Z8BYlCrncx5naC9CKzJxOItC.jpg","genres":["мультфильм","семейный","комедия","приключения","боевик"],"overview":"","source":"tmdb","episodes":"","studio