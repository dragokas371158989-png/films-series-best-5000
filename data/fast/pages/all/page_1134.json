ountry":"","ageRating":""},{"id":"826861","ru":"Huonot naiset","en":"Huonot naiset","year":"2022","type":"Фильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/piCkwYBZZPqxnIFc1pRGyAiiAXL.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1367344","ru":"Wanita Ahli Neraka","en":"Wanita Ahli Neraka","year":"2024","type":"Фильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/xqseSM4tNA7nwnDjcFmjFW91uAH.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1237424","ru":"Confessions of a Cam Girl","en":"Confessions of a Cam Girl","year":"2024","type":"Фильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ynJtbMM8Tm4jTifTCuqjAwPXLcf.jpg","genres":["драма","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"62488","ru":"Последний трек в Берлине","en":"Letzte Spur Berlin","year":"2012","type":"Сериал","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/zPNBkX3afuYN1jK5acGX9DBwsmi.jpg","genres":["криминал","драма"],"overview":"Управление по делам пропавших без вести берлинской полиции занимается поиском пропавших без вести. Опрашивая их семью и тех, кто видел их в последний раз, полиция пытается выяснить причины их исчезновения. Очень часто им удается обнаружить пропавшего более или менее целым и невредимым.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"444191","ru":"Любовь по договору","en":"合約男女","year":"2017","type":"Фильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/50NBi6pRhLtgg6ilnmKruGQISY4.jpg","genres":["комедия","драма","мелодрама"],"overview":"Карьеристка Катрина возглавляет крупную страховую компанию. После разрыва с изменившим ей партнером, женщина больше не верит в романтическую любовь, но все ещё хочет ребёнка. Для этого она решает использовать в качестве донора спермы простого курьера, который регулярно появляется в её офисе. Спортивного и красивого парня по имени Бо, бывшего десантника, фаната винтажных мотоциклов. Вот только в процессе суеты вокруг донорства Бо и Катрина постепенно понимают, что их отношения давно вышли за рамки утвержденного контракта.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"62455","ru":"Птичья песня","en":"鳥の歌","year":"2007","type":"Мультфильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/qfezAZyYCzWIB2LWp5PQ7ZDtJj1.jpg","genres":["мультфильм"],"overview":"Мальчик возвращался домой и вдруг заметил незнакомую ему дорогу. Он никогда прежде не замечал этой улицы и решил проверить, куда она ведет. Пока он шел, начался ливень, и незнакомая девочка в красном пустила его в дом – переждать дождь. Мальчик влюбился. А девочка пообещала ему, что они обязательно встретятся снова... Однако назавтра он не сумел найти дорогу туда, где прятался от дождя, и где ждала его девочка в красном. Много лет прошло, мальчик вырос и уже почти состарился... но девочка из дождя его детства все-таки дождалась его возвращения.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"222480","ru":"Вымышленные летательные аппараты","en":"空想の空飛ぶ機械達","year":"2002","type":"Мультфильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/A2VBbRtIuZKh9Rtpv1OcYzsVk9z.jpg","genres":["мультфильм"],"overview":"Рассказ о летательных аппаратах, о которых фантазировали люди в XIX веке.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"242967","ru":"Тройная страховка","en":"Trouble Indemnity","year":"1950","type":"Мультфильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/9fTjYiP1sPkKaCZ6RnTBNvmYyUl.jpg","genres":["мультфильм"],"overview":"Семейный мультфильм о злоключения мистера Магу, подслеповатого старика, который вечно попадает в переделки из-за своего зрения. Но герой не отчаивается, более того, он даже не подозревает, какой опасности подвергает себя, занимаясь привычными делами. Однажды к Магу наведывается страховой агент в надежде навязать клиенту свои услуги. Возмещение убытков за собственные оплошности не интересует мистера Магу, но чтобы содрать с него денег, агент прикидывается бывшим сокурсником мужчины. Он говорит, что они с Магу вместе учились в колледже, просто мало общались.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"182121","ru":"Рождество божьих коровок","en":"Lepatriinude jõulud","year":"2001","type":"Мультфильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/brpoU0pjnRWNGlQ4rklgv7fvBrO.jpg","genres":["семейный","мультфильм"],"overview":"Божьи коровки нашли себе приют на елке — и в канун Рождества очутились в теплом гостеприимном доме, куда эта самая елочка «в гости пришла и много-много радости принесла».","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"486435","ru":"Кунг-фу воин","en":"豆福传","year":"2017","type":"Мультфильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/aegLMTFLEKBIgHE4ptC5bntXnmh.jpg","genres":["мультфильм","семейный"],"overview":"Когда-то давно Великий учитель сделал обычные бобы разумными, научил их боевому искусству бессмертных, а сам вознёсся на небо. Несколько лет спустя немногие следуют заветам учителя и практикуют искусство бессмертных, потому что, говорят, от этого сходят с ума, и за тобой могут прийти тёмные чудовища. Несмотря на увещевания свой подруги Дусян, Тофу упорно занимается, поэтому горожане и сдают его в местный дурдом, где он встречает одного из мастеров, про которого читал в книге.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"24475