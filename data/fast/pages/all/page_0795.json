ешек – «куриного бога». Если смотреть через дырочку в камешке, то мир становится сказочным и прекрасным. С этим сокровищем и отправляется Сережа путешествовать, встречаясь с самыми разными людьми, пока его не находят воспитатели.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1504390","ru":"Santa Inocencia","en":"Santa Inocencia","year":"","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/jF5WBLFQWdpQ2LZ3WJCueVsedn3.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1502779","ru":"The Moldy Peaches Documentary","en":"The Moldy Peaches Documentary","year":"2009","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/vKYYONKYiQSW4xpTS5UpCgJJKOy.jpg","genres":["документальный","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1498958","ru":"La Conquête De La Meije","en":"La Conquête De La Meije","year":"1986","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3AWcu1rdiUA4mZlpSvRspYJEbTx.jpg","genres":["документальный","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1496143","ru":"Les Naufragés Du Mont Blanc","en":"Les Naufragés Du Mont Blanc","year":"2002","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4iKDWqzyI1h0PGTQel2ETlKoIn0.jpg","genres":["история","документальный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1494936","ru":"Nomades De La Verticale","en":"Nomades De La Verticale","year":"1988","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/x0wJaN3Br41tnjPOuk6ypDrTQHc.jpg","genres":["документальный","приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1480855","ru":"Phoebe Bridgers @ Brooklyn S