tes":11,"poster":"https://image.tmdb.org/t/p/w342/ZMGGA7Ai1vUsPwqI1WYkQzh0Wu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oObptMiK18ApYHD0EQy2OgCmuu8.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"102916","ru":"The New Adventures of Peter Rabbit","en":"The New Adventures of Peter Rabbit","year":"1995","type":"Мультфильм","rating":5.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/p78OiYTelVEp5oDRoVPKlKUyVJh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eE9TWFMc0c6DnoawXGd21CauPyb.jpg","genres":["музыка","мультфильм","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"322525","ru":"Laddie: The Man Behind the Movies","en":"Laddie: The Man Behind the Movies","year":"2017","type":"Фильм","rating":5.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/in4tn7sdKX2sqTQ9yfVmuMV9yHu.jpg","backdrop":"","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_104852","ru":"Сага Гортензии","en":"オルタンシア・サーガ","year":"2021","type":"Аниме","rating":5.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/viTXVPXj3dMV29rIOeW4Dj5PuNh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/31K0B6Z8XMsuLGQSMXsNcFg2XXV.jpg","genres":["мультфильм","детектив","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"Это история о кровопролитной войне и хаосе. Три года назад король был предан и убит одним из своих слуг, который захватил власть в королевстве. Но тот не учёл, что истинная наследница престола достигла своего совершеннолетия. И это позволит ей взойти на престол. Прячась в обличье мужчины, она и её верные спутники начинают тернистый и опасный путь ради спасения своей родины.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_65980","ru":"Принц страйда: Альтернатива","en":"プリンス・オブ・ストライド オルタナティブ","year":"2016","type":"Аниме","rating":5.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/3Wg8rzlX187rFsdkhuI5CqtGvzE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gGvwD29yi7y6mQMHpjaZkSOUwhh.jpg","genres":["мультфильм","Аниме"],"overview":"Страйд — экстремальный вид спорта, правила которого максимально просты: шесть игроков из одной команды должны передавать эстафету друг другу из города в город. Команды из множества школ по всей Японии соревнуются за главный приз — победу в конкурсе под названием «Конец лета». Старшеклассники академии Хонан, Такэру Фудживара и Нана Сакурай, приходят в клуб по страйду с целью возобновить его деятельность, для чего им не хватает заветного — одного участника, чтобы принять участие в соревнованиях. Они просят Рику Ягами, одного из лучших спортсменов школы и вообще парня крепкого, присоединиться к ним, однако тот резко отказывается, заявляя, что страйд — последнее, чем бы он хотел заняться. Так или иначе, вскоре упрямого юношу удается зачислить в списки команды. Теперь их цель — «Конец лета»!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_34808","ru":"Инуками!","en":"いぬかみっ!","year":"2006","type":"Аниме","rating":5.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/fYJelXjN5DSJewfkfLb5sskcPYA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a7hX2rTvQrV62EWez5V3M1N6cpX.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"247029","ru":"Superflat Monogram","en":"Superflat Monogram","year":"2003","type":"Аниме","rating":5.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/4u3KomeLDVr0xYJhGIqjFzaMuC2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sDG5pFg4IQjxMSKIXNtIJ4Y1imD.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"234001","ru":"猿正宗","en":"猿正宗","year":"1930","type":"Аниме","rating":5.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/AskF15jutZQM3f0dl5LSgxFHQmU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/71rZFB8XgBrnSlKgOWkNVAFr0b7.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"664498","ru":"В поисках счастья","en":"She's in Portland","year":"2020","type":"Фильм","rating":5.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/prplfJq3YN9gHlvZZgS5Ly2LYWX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kPgjvYbcoFWieLxR8ikULXMmOqE.jpg","genres":["драма"],"overview":"Уэс и Люк друзья с колледжа, которые к 30 годам столкнулись с кризисом среднего возраста. Уэс давно женат и пытается завести ребенка со своей женой, но не уверен, что это то, что он хочет. Люк пребывает в депрессии, потому что никак не может забыть свою первую любовь. Друзья решают отправиться в Портленд, чтобы найти ту самую девушку Люка, которая кажется ему единственной любовью. Их путешествие оборачивается незабываемым приключением в поисках счастья.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"680286","ru":"Плохой колдун","en":"Bad Witch","year":"2020","type":"Фильм","rating":5.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/4hhWcnmceb6TupwlnU4xiPB5uTM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/A6yoRt08f8SrqAWAHkM4OLKzqgx.jpg","genres":["ужасы","комедия"],"overview":"Зандер - молодой колдун, который когда-то злоупотреблял тёмной магией, что привело к настоящей катастрофе. Пытаясь очистить свою совесть, Зандер становится другом застенчивого подростка Роланда и помогает ему решить проблемы с девушками, хулиганами и другими кошмарами школьной жизни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"685833","ru":"목공소에서 생긴 일","en":"목공소에서 생긴 일","year":"2020","type":"Фильм","rating":5.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/bMhxD4DKRJM1dydluvsS5aL2Tci.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8K9w7juIRSEFM49ASyU2ROf30nP.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","st