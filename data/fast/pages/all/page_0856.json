rg/t/p/w780/arGsmUU6DCwPTRrpbZnDmP3myRH.jpg","genres":["Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"34691","ru":"Титания","en":"TYTANIA -タイタニア-","year":"2008","type":"Аниме","rating":9.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/eHSyo4l4ujiDd73UatZjztOBTyH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bJv81ECe4tRQzxX1oMVSjVLINMf.jpg","genres":["Мультфильм","Аниме"],"overview":"В далёком будущем человечество освоило Вселенную и заселило множество планет. Мир и спокойствие обеспечивает военная мощь Титании — аристократического рода, который держит в страхе остатки свободных королевств и даже императора. Сама Империя существует лишь благодаря боевым кораблям Титании. Во главе этого рода стоят опытные полководцы и политические деятели. Они привыкли побеждать, поэтому таким ударом для них оказывается неожиданное сопротивление флота маленькой Эурии, которым руководит никому не известный адмирал Фан Хьюлик. И вот на смену недавней стабильности приходит угроза восстаний…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"36359","ru":"機神大戦 ギガンティック・フォーミュラ","en":"機神大戦 ギガンティック・フォーミュラ","year":"2007","type":"Аниме","rating":9.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/379mUwHICxWLYQccl3hgyanLX20.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iKJ71uRpl1roELxjSzRTvB2Qkpu.jpg","genres":["Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"105472","ru":"22/7 計算中","en":"22/7 計算中","year":"2018","type":"Аниме","rating":9.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/yLsbFybnQwJU0GLXEHWTvw6WTLc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5H5hxFtQ088YdqwonoznmopHnO9.jpg","genres":["Мультфильм","Комедия","Ток-шоу","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"118797","ru":"星游记","en":"星游记","year":"2011","type":"Аниме","rating":9.7,"votes":3,"p