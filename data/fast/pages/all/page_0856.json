. IIIRAM помогает герою обрести уверенность в себе, но методы вымышленного друга довольно сомнительны, а его советы чаще всего неэтичны. Жизнь героя резко меняется, когда тот попадает в мир профессионального киберспорта: первые деньги, новые знакомства и шанс добиться внимания девушки, о которой он раньше даже не мечтал.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"104288","ru":"The Best of WWE","en":"The Best of WWE","year":"2020","type":"Сериал","rating":9.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/d1Zd34719o0OXmJk8UyzCt5QeGP.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"261939","ru":"仮面ライダーギーツ","en":"仮面ライダーギーツ","year":"2022","type":"Сериал","rating":9.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/zZY7AqCUrz0KkwRVtHzgYG3Vb3n.jpg","genres":["Боевик и Приключения","Детский","драма","НФ и Фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"240884","ru":"宗师列传","en":"宗师列传","year":"2023","type":"Сериал","rating":9.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/5LbISPKOJ9I78hA38X1FCp962ZN.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1476450","ru":"Bayo","en":"Bayo","year":"2025","type":"Фильм","rating":9.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/pNClIec4AsWkZmMBqqYXMPO0nzd.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"241506","ru":"It's Okay to Not Be Okay","en":"It's Okay to Not Be Okay","year":"2025","type":"Сериал","rating":9.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/7rQ7E7u0y8VJgnUeDT6oF1J32Gu.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","s