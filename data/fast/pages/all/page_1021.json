tps://image.tmdb.org/t/p/w780/nM9TysLUDIlHJt4YvoLpHhmXpXo.jpg","genres":["Мультфильм","Военный","Боевик","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"495583","ru":"They Shall Not Perish: The Story of Near East Relief","en":"They Shall Not Perish: The Story of Near East Relief","year":"2017","type":"Фильм","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/5ZKpwKn3UiRkIsP1fTHTtg7tXuY.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"75535","ru":"Super Atragon","en":"Super Atragon","year":"1995","type":"Мультфильм","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/pfy70QpZEV0J5kcuzVqsSBR5QkC.jpg","backdrop":"","genres":["Мультфильм","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"486113","ru":"Premier voyage","en":"Premier voyage","year":"2007","type":"Мультфильм","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/sNVumvUepIKRVnAoRSRpFXSUL9n.jpg","backdrop":"","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"122468","ru":"Мир героев СД Гандам","en":"SDガンダムワールド ヒーローズ","year":"2021","type":"Аниме","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/7erAYO2Uj6aKYO3BkcESbGFEs4t.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dhDH1jmGPbuMwoUf1E3muSwhiFt.jpg","genres":["Мультфильм","Аниме"],"overview":"На месте падения появляется потерявший память Укунь Гандам Импульс. За случившемся последовала череда безумных событий, которые распространились и на другой мир. В это время Чжугэ Лян Гандам Свобода прочитал по звёздам, что близится гибель мира. Вместе со своим другом Лю Бэем Гандам Единорог они решают спасти мир от катастрофы. Для этого ребята отправляются в путь вместе с Укунем. Что же он подумает о героях каждого мира? Сумеет ли юнец спасти мир от катастрофы? Начинается новая история героев!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"112501","ru":"幼女社長","en":"幼女社長","year":"2021","type":"Аниме","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/y6jU0k7uOuDVKZYwk3Vji3w4CgL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/43c7wtzF4TWELDSCET9PT3I2IYc.jpg","genres":["Мультфильм","Комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"76941","ru":"Дороти и Волшебник страны Оз","en":"Dorothy and the Wizard of Oz","year":"2017","type":"Аниме","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/ptIwxwpr7g9LZs0JLqOI82Z8lks.jpg","backdrop":"https://image.tmdb.org/t/p/w780/djhXJceqeilkdMysgUFxvdAzmqy.jpg","genres":["Мультфильм","Боевик","Детский","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"104352","ru":"魍魎戦記 MADARA[摩陀羅]","en":"魍魎戦記 MADARA[摩陀羅]","year":"1991","type":"Аниме","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/caK2mkn2I3ZklbqMk2KMPcsV77R.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kiR1dNDXPd7UM7OSNjmnrqQv2tp.jpg","genres":["Боевик","Мультфильм","Фантастика","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1515729","ru":"Blast","en":"Blast","year":"2026","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/ho824aZtnBzE6FuJRn2znQCq4qQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/z18AIGSU0vk4Y7LQP37CPSeKZvF.jpg","genres":["Боевик","Драма","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"304550","ru":"Территория убийств: Убийства на Гилго-Бич","en":"Killing Grounds: The Gilgo Beach Murders","year":"2026","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/mb1oBq4dnWI7vbX64HPXydCUj01.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lJ6rDjQQmMHz5m4GTPDi6vJXVck.jpg","genres":["Документальный","Криминал"],"overview":"Когда женщина исчезает, полиция находит тела вдоль побережья Лонг‑Айленда. Годы тупиковых ситуаций и упущенных жертв тормозят расследование, пока новая оперативная группа не обнаруживает подозреваемого, скрывающегося у всех на виду. По мере приближения суда свои истории рассказывают причастные к делу люди и семьи пострадавших.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1280405","ru":"Большой пернатый побег","en":"องครักษ์พิทักษ์เจี๊ยบ","year":"2024","type":"Мультфильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/d5q88Nr4J3cgGYpDkqnvWX66U9a.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ylOZ6sD51Bu1Jzsfk5hSwBnh0vT.jpg","genres":["Мультфильм","Семейный","Фэнтези","Приключения"],"overview":"Артур мечтает стать модным стилистом, но пока работает доставщиком. Когда миру грозит опасность, ему поручают доставить самый важный груз — волшебные золотые яйца. И все бы ничего, только по дороге из них начинают вылупляться очень разные и беспокойные птенцы. Артуру придется научиться заботиться о малышах, обрести друзей, стать героем и спасти этот мир.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1597608","ru":"Расследования Эйнсли Макгрегор: Дело часовщика","en":"Ainsley McGregor Mysteries: A Case For the Watchmaker","year":"2026","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/54a1WSYGAiWBwx7odKktfxI7JKz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vU4IrDePbCIOiDK3lXVwjFODA7o.jpg","genres":["Телевизионный фильм","Детектив"],"overview":"Эйнсли Макгрегор думала, что ее новая жизнь в родном Свит-Ривере будет определяться ярмарками ремесел и книжными клубами, а не трупами. Так продолжалось до тех пор, пока одна из любимых участниц книжного клуба не подняла нераскрытое дело, связанное с ее покойным мужем, которого нашли убитым из-за редких старинных часов. Эйнсли немедленно приступает к расследованию, чтобы распутать паутину маленьких городских секретов, прежде чем убийца начнет охоту на следующую жертву.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"308758","ru":"Мамник","en":"Мамник","year":"2026","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/8G0D9bbzXB02uekyCm2VAOPKSWV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zfHQujKkRlLFEiPTXTTC2KJNmlL.jpg","genres":["Драма","Детектив","Фантастика"],"overview":"В пограничном селе Вракола происходят странные убийства, а люди просыпаются с метками, похожими на следы птичьих когтей. Пограничница Божана Горнева и её напарник Митко вместе с Эмилом Славовым начинают расследование и выходят на древнее зло — мамника, демоническую птицу из болгарского фольклора, которую связывают со смертью и проклятием.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1373276","ru":"Они были ведьмами","en":"Eran brujas","year":"2025","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/vDCwHCtPJAWmEf9NpwmUH9AI1tv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f2SUTv6qGGQK9k8gInnG0z9mBN3.jpg","genres":["Ужасы"],"overview":"Миа, ведущая радиошоу о колдовстве, получает запрос на интервью от женщины, называющей себя ведьмой. Во время эфира происходит странный сбой, и Миа чувствует, будто впадает в транс. Не придавая этому значения, она отправляется в поездку и застревает в мотеле без электричества. Там она знакомится с молодой девушкой Сарой, своей поклонницей, и принимает приглашение переночевать у её друзей. Однако вскоре Мию начинают преследовать пугающие видения, а поведение новых знакомых становится всё более настораживающим. Постепенно Миа понимает, что её присутствие здесь — не случайность.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1147016","ru":"Побег по-королевски","en":"Royal Runaways","year":"2025","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/zpABxZgT5oSeafsAL0rvNbLzjIl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/24wsx8QFJLvx0TpDWK7bWtYXHaW.jpg","genres":["Мелодрама","Драма"],"overview":"От французской страны Каминель до винодельни в штате Мэн непокорный принц и осиротевшая девушка идут параллельными путями, чтобы найти друг друга, но прежде им предстоит раскрыть заговор, полный неожиданных поворотов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"791266","ru":"Маошань","en":"茅山","year":"2021","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/7bsZGUFcRRmIT7xadaBrxRv8tyG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nLrs9PAmvMyIjBXAlVIVt2WXeOd.jpg","genres":["Боевик","Фэнтези"],"overview":"Молодой парень Инь Шоу И (Натас Асока) помогает матери в небольшой таверне и мечтает стать героем. Шоу И надеется попасть в Маошань, овладеть кунг-фу и стать настоящим мастером. И однажды у него появляется шанс. Школа Маошань объявляет о проведении испытания, победитель которого получит знаменитый меч девяти драконов. Инь Шоуи решает испытать удачу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"982518","ru":"Каш","en":"Қаш","year":"2022","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/pjb4H0frf3qrKnHyHPHkDl3AHXx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fFWkZt8HD3CzWW9Gu97ypsItKQJ.jpg","genres":["Драма"],"overview":"Во время голода 30-х годов в Казахской АССР могильщик Исатай отправляется в ближайший город на рискованную миссию по спасению своего аула, но на пути ему встречается странник, который указывает путь, ведущий в никуда.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1400794","ru":"Бесконечное печенье","en":"Endless Cookie","year":"2025","type":"Мультфильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/m4QlGRQ8dSXIEPTYvKB54YvMGyE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7wSdWSscNpeNV0faXUQBJVO4Gyp.jpg","genres":["Документальный","Мультфильм","Комедия"],"overview":"В фильме исследуется сложная связь между двумя единокровными братьями — один из них коренной, другой белый — которые путешествуют из современной изолированной Шаматтавы в оживленный Торонто 1980-х годов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}