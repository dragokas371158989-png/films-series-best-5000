,"poster":"https://image.tmdb.org/t/p/w342/o1bzdEvMF8qUTrUEn9KrqCGZAv6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/guTg8NYMNb7oDWyn3p3tgvWppVB.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1000990","ru":"La femme de","en":"La femme de","year":"2026","type":"Фильм","rating":6.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/yeT4UPyP4Y1QS1sMlGnAXtfAyS4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iR3kcb9uXP9HmBa4CidYx2BUFru.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"673284","ru":"The Legend of Baron To'a","en":"The Legend of Baron To'a","year":"2020","type":"Фильм","rating":6.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/zbzGkQs0w2R4JIkZX8609bFTG3C.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sAb9zKY6epNiY2Y2IMUw8LtIqDE.jpg","genres":["комедия","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"95226","ru":"Елисейские поля","en":"Champs-Elysées","year":"1982","type":"Сериал","rating":6.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/uA6Waea7ozD7OEXNGaSqPtydPdd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k1FVoLHTV9gJZBIE1Z4nMeQthuE.jpg","genres":["Ток-шоу"],"overview":"Елисейские поля - это развлекательное шоу на французском телевидении, представленное Мишелем Друкером, а затем Лораном Рукье и транслируемое в прямом эфире с 16 января 1982 г. по июнь 1985 г. и с января 1986 г. по 29 июня 1990 г. каждую субботу вечером на Antenne 2 и нерегулярно на France 2 с С 13 ноября 2010 г. по 11 мая 2013 г. Шоу обязано своим названием тому факту, что оно проводится вживую из Павильона Габриэля, расположенного на авеню Габриэль, вдоль Елисейских полей в Париже. Музыкальная тема для титров шоу была написана Жан-Пьером Буртером и Жан-Клодом Пети. Хореографию в титрах написал Редха.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"623760","ru":"Весеннее половодье","en":"春潮","year":"2019","type":"Фильм","rating":6.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/oKgUaRKdwQQtwJBtpI6XLoShHLv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zzaHxfg94qWims1QuhzXvEWpocL.jpg","genres":["драма"],"overview":"Журналистка Го Цзяньбо живёт вместе с матерью-пенсионеркой и малолетней дочерью. Делая репортажи о социальных проблемах общества, женщина пытается разобраться со своей собственной драмой. Её мать, бывшая учительница, всегда вела активную общественную жизнь и пользовалась уважением окружающих, но дома её мало волновали дела семьи. Дочь же входит в подростковый возраст и бунтует против взрослых.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"519421","ru":"Билле","en":"Bille","year":"2018","type":"Фильм","rating":6.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/9sOZUq3VE8ZCUKY2tuly14xVbl0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9vf367XF6DUTCdSBPDy9zlv6KH7.jpg","genres":["семейный","драма"],"overview":"Семилетняя Билле живет в мире, где у богатых свои улицы, а у бедных — свои. С бедностью Билле научилась уживаться, однако материнской любви девочка лишена, а близкие не перестают напоминать, что ничего толкового из нее не вырастет. Билле это больно ранит, девочка мечтает заявить о себе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"66630","ru":"Oppassen!!!","en":"Oppassen!!!","year":"1991","type":"Сериал","rating":6.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/8Zg7uFytp09a4rCK7GrxHLTMguk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8Eksp4wxVT0WpFGqgeuHIf57sRT.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"508586","ru":"젊은장모","en":"젊은장모","year":"2018","type":"Фильм","rating":6.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/jIn3Z3heGwcRZQcR2f1wY9JMuzv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yuUXsE7S6m0uNARvC4BQh