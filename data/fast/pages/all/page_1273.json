342/40qPEw60NOizFznCf9L22GOcMrD.jpg","genres":["драма"],"overview":"Драматическая картина Пустынные берега ведет речь о мужчине по имени Брайан, который пытается упорно убедить свою жену, что переезд в другую страну будет отличной идеей, чтобы начать новую жизнь. Для этого он взял её в поездку в совершенно непримечательный курортный городок, в котором они когда-то провели свой новый месяц. В этом месте Брайан был вынужден столкнуться с собственными страхами и семейными проблемами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"454642","ru":"Мини-вселенная","en":"Miniverse","year":"2017","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/seUeva9egL033enBXRdh9AUwt6S.jpg","genres":["документальный"],"overview":"Сложно представить насколько велик Космос... Упростим задачу: что если проехать всю Солнечную систему на автомобиле? Космос столь велик, что мы сожмем расстояние между планетами Солнечной системы до размеров континентальной части США и расположим их вдоль нашего маршрута. 5,8 млрд. километров уместим в 4 800 километров. Нашим гидом в этом путешествии будет канадский космонавт, полковник Крис Хэдфилд — ставший звездой YouTube с его исполнением песни Дэвида Боуи \"Странный случай в космосе\", снятым на борту международной космический станции.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1246092","ru":"Murder at First Swipe","en":"Murder at First Swipe","year":"2024","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/6DadHYAl8dZwTutGMA6unsLL4lD.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"496479","ru":"Волшебное кимоно","en":"Maģiskais Kimono","year":"2017","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/mu4nSpKVUHkqSM0dy1olu65U6qc.jpg","genres":["комедия","драма","детектив"],"overview":"Японка средних лет по имени Кэйко приезжает в Латвию, чтобы участвовать в аутентичном перформансе кимоно, во время которого встречает одного мужчину. Начав разговор, Кэйко понимает, что он очень много знает о её прошлом. В результате недоразумения она даёт согласие помочь открыть японский ресторан и остаётся в Латвии. Здесь случайные встречи и события помогут ей пережить свои внутренние потери, а также понять, кто этот таинственный мужчина.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"809837","ru":"내 아내가 살이 쪘다","en":"내 아내가 살이 쪘다","year":"2020","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/3nvG8ifLHSCfMf62k5BIU6R0R36.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448596","ru":"Соломенный бычок","en":"Соломенный бычок","year":"1954","type":"Мультфильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/w1kjbmAltKXdG9Dhn23roW281KK.jpg","genres":["мультфильм"],"overview":"Экранизация украинской народной сказки \"Соломенный бычок - смоляной бочок\".","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"634983","ru":"Фарш","en":"Farse","year":"2019","type":"Мультфильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/rO54ohFEf6sJkjAWmG8rZYKzGi4.jpg","genres":["мультфильм"],"overview":"Мужчина, женщина и мясорубка. Любовь — это непросто.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448402","ru":"Муравьишка-хвастунишка","en":"Муравьишка-хвастунишка","year":"1962","type":"Мультфильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lMciV3Qk7fX0eyRGsAjJyjQXiIt.jpg","genres":["мультфильм"],"overview":"По мотивам сказки В.Бианки \"Как муравьишко домой спешил\".","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"906931","ru":"Смерть чиновника","en":"Смерть чиновника","year":"1988","type":"Мультфильм","rating":5.0,"votes":2,"poster":"https://image.t