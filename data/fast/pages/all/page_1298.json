isodes":"","studio":"","country":"","ageRating":""},{"id":"31351","ru":"Tout le monde en parle","en":"Tout le monde en parle","year":"2004","type":"Сериал","rating":4.7,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/8BiaKzjK3arQM2yKLzB9zBKB6GL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f5445uc1T6HqTe4Zi0hfkk7kuHn.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"516495","ru":"Flashout","en":"Flashout","year":"2019","type":"Фильм","rating":4.7,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/rlvDmN68efAdMzdCoAI2LicVuTa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3r8vekM0BTNQMGav40x72cMgYdC.jpg","genres":["Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"325205","ru":"Toiset tytöt","en":"Toiset tytöt","year":"2015","type":"Фильм","rating":4.7,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/sW1qtvP4SewLZ5M5gfIWpk5iU4e.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y7PHUcqQj3Y0nZkU9if98ENPmrz.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"277534","ru":"Carlotta","en":"Carlotta","year":"2014","type":"Фильм","rating":4.7,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/1KKXue0FWl0zI3fnevGNqmSaGae.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zK2IRQC7uSrtd81W7UULQjsx9qO.jpg","genres":["Телевизионный фильм","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_110371","ru":"«WIXOSS»: Дива в прямом эфире","en":"WIXOSS DIVA(A)LIVE","year":"2021","type":"Аниме","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/zGIDqyyLbTMNW5xqLyBo1EVADcM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/edl2vLPzj9RNmHrmOhobLNrXei4.jpg","genres":["Мультфильм","Аниме"],"overview":"В новом году выйдет пятая часть японского аниме «WIXOSS Diva(A)Live» в приключенческом жанре от режиссёра Мацунэ Масато. В мире этого мультсериала умы многих представительниц женского пола заняты одной интересной карточной игрой, которая способна перенести игроков в виртуальное пространство под названием «Wixossland». В данном развлечении очень популярны карточные сражения, в которых сами участники выступают только в составе определённой лиги. Особый фурор производят так называемые «баттлы див», где из трёх человек формируется полноценная команда, которая сражается за количество «селекторных» фанатов. Кроме этого, поговаривают, что в этой игре есть особые карты LRIG с живыми женщинами, у которых есть собственные воля и мечты. Тех, кто обладает такими атрибутами называют «селекторами», так как лишь они могут видеть и слышать этих прелестниц.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"143744","ru":"Детонатор Оргуна","en":"デトネイター・オーガン","year":"1991","type":"Аниме","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/4Frd38R5u6udPUSzN6beL6oSZ8g.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a4MAiRePIsSrlaahn8VLoiOPWbc.jpg","genres":["Мультфильм","Фантастика","Аниме"],"overview":"Далекое будущее. Земляне уже колонизировали Луну, Марс и вышли за пределы солнечной системы. В центре повествования юноша по имени Томору. Ему всегда хотелось большего чем простая работа в престижной компании, которую уже ему пообещал брат. Сверстники его не понимают. А он чувствует что у него есть более важная миссия. Параллельно нас знакомят с Оргуном — инопланетным воином, который предал свою расу для того что бы защитить землю. Он отдает жизнь за людей, но перед смертью изготавливает себе дубликат, который будет работать только соединившись с Томору. Эвольдеры — соплеменники Органа — начинают осаждать Землю. И все в руках Томору и таинственного Оргуна. Но никто не знает целей пришельца. Быть может его защита выйдет человечеству боком.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_35472","ru":"ご愁傷さま二ノ宮くん","en":"ご愁傷さま二ノ宮くん","year":"2007","type":"Аниме","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/5UCDo0xbQH13ZNdV1vE1DYE0O2J.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1i5LXR5LMCWokbioxCaCtcgHBTj.jpg","genres":["Мультфильм","Комедия","Фантастика","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"784963","ru":"టక్ జగదీష్","en":"టక్ జగదీష్","year":"2021","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/h3N0BvNtplnvK1kyqP4dQREUCn5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nnpFB8S2RSN5JA9MSJVMIDvHn3g.jpg","genres":["Драма","Боевик","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"862618","ru":"കാപ്പ","en":"കാപ്പ","year":"2022","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/hllm5duftEJDHQAPjK94DHisaE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6WGvlubnkAGq37o5prF37W7FcQA.jpg","genres":["Криминал","Боевик","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"665671","ru":"দ্বিতীয় পুরুষ","en":"দ্বিতীয় পুরুষ","year":"2020","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/btD6RnSK5QE0XcI0v1j2H9eUrJD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jrRiWKrAvzP15WopLQycyFXcHyQ.jpg","genres":["Драма","Детектив","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"532654","ru":"Ravers","en":"Ravers","year":"2020","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/dTPxFvDWAi6sZD8oDN2RyVUW6vw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9B0mSJEM493EQFE5MsrlEfet7Ja.jpg","genres":["Комедия","Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305099","ru":"Empire with David Olusoga","en":"Empire with David Olusoga","year":"2025","type":"Сериал","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/6LKKR14qoJ3ylaNGBYStML1yfyD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dn7FrhmqsmQNuBuFzHBT5z1g7Xs.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"327753","ru":"Подруга моей матери","en":"L'amica di mia madre","year":"1975","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/xmxpx76fbPzCAUs49mNzzgRnD6n.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pBz8lYp3ZWhXkSFQQZ7mScABROK.jpg","genres":["Комедия"],"overview":"Поссорившись с мужем, Барбара просит свою лучшую подругу приютить ее на время. Та соглашается без раздумий, вот только сама она находится в отъезде, а в ее доме пока живет лишь ее сын-подросток Билли. Но это только к лучшему. Заодно Барбара могла бы и присмотреть за тинейджером. Но подруги не предусмотрели, что Билли находится в том самом возрасте, когда присутствие рядом красивой женщины способно вызвать в подростке самую неожиданную реакцию. Так и произошло – юноша без памяти влюбился в Барбару, и поставил себе цель во чтобы то ни стало добиться ее.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"628261","ru":"Кто похитил мою дочь?","en":"Who Stole My Daughter?","year":"2019","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/AcPKCvYBPrQlPQM8JabVxFYe3fu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gCJ1ZOe43wGLjUrk4CvjLm0c0xy.jpg","genres":["Триллер","Телевизионный фильм"],"overview":"Через пять лет после своего исчезновения повзрослевшая Кэти появляется на пороге родительского дома. Но восторг и радость родителей длятся недолго, потому что у девочки травмирована психика и она перестала говорить. Вдобавок к этому в городе появляется таинственный незнакомец, который проявляет к девочке интерес, и тогда, устав от бездействия властей, её мать решает взять расследование в свои руки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"481359","ru":"Распространение тьмы","en":"Spreading Darkness","year":"2017","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/2aDRu6VTqIzCuInlpiQVGlYfacw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4AGXy33JncXwRHcZRBpir0X4Z0p.jpg","genres":["Детектив","Драма","Комедия","Криминал","Триллер","Фэнтези"],"overview":"Главный герой фильма — Стью. Он — молодой, красивый, успешный. Он амбициозный, всегда старается добиваться своего. И пока у героя это отлично получается. Но так в жизни Стью было далеко не всегда. Когда-то он был связан узами брака с прекрасной девушкой по имени Элли. Но их семейное счастье прервалось тогда, когда девушка погибла. Сейчас в жизнь мужчины вновь пришло несчастье. Кто-то явно хочет вернуть себе свое. Поэтому в жизни героя появляется влияние темных сил. Он не знает кто, за что, и зачем это делает. Но с каждым днем присутствие потустороннего только возрастает. Происходят непонятные вещи, мужчина даже начинает видеть свою покойную супругу Элли. Его преследует неизвестное, его сознание окутано страхом, и странными галлюцинациями. Стью понимает, что то, что на него охотится, никогда не оставит его в покое. Спасения практически нет. Но его собственная жизнь для парня очень дорога, и он намерен за нее бороться. Вот только справится ли он с такой очень непростой задачей?..","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"640094","ru":"90 футов от дома","en":"90 Feet from Home","year":"2019","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/7A8GdgemO2GPsXveCFzBmldwswq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/liLsDgTuuGjgnZ75451DNRtJ2bS.jpg","genres":["Криминал","Триллер","Драма"],"overview":"Бывшему игроку Большой Лиги по возвращении домой приходится столкнуться не только с собственными проблемами, но и с агрессивным отчимом...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"195748","ru":"雪在燒","en":"雪在燒","year":"1988","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/cLxSqaUxr7YVJhxU24SsE5Wlg3t.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oTQdtKPLqlfKOiGSkYqrnY2piB4.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"480812","ru":"రాజు గారి గది 2","en":"రాజు గారి గది 2","year":"2017","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/6Rr8Z3BkqeF4ivRdtTiX816Tbzl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/p42kyMQIUxXcGMS4mWc9ZU8rKHj.jpg","genres":["Криминал","Ужасы","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"408914","ru":"சங்கிலி புங்கிலி கதவ தொற","en":"சங்கிலி புங்கிலி கதவ தொற","year":"2017","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/uSg5052N2oK5ors0vCEAUaT2vQm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/u42KtZj9guzNlA44jI5yLFwqI25.jpg","genres":["Ужасы","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"157474","ru":"Блэк энд уайт","en":"Блэк энд уайт","year":"1932","type":"Мультфильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/ljTSEK3y9GVl5spR2YYbN6kbnVh.jpg","backdrop":"","genres":["Мультфильм"],"overview":"Тяжек труд чернокожих на сахарных плантациях Кубы. Горька участь старого негра Вилли, чистящего сапоги белым джентльменам. Не выдержал однажды Вилли, спросил у сахарного короля: почему черные делают только черную работу? И получил в ответ удар кулаком в зубы. Откуда знать старому негру,что с такми вопросом надо обращаться в Коминтерн, в Москву.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"378310","ru":"Tales of Poe","en":"Tales of Poe","year":"2014","type":"Фильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/Am08KjuOJ7SNKjWJVVYatWpDgad.jpg","backdrop":"https://image.tmdb.org/t/p/w780/34TFrH5EpFCGpyQTtbQRSNFfRRb.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"184575","ru":"Stop That Noise","en":"Stop That Noise","year":"1935","type":"Мультфильм","rating":4.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/tMn0ZKcX9jyCyWe2nVuI7lDzsx6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3kLim2n8tiOMUVr0c62DM3B9pBY.jpg","genres":["Мультфильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"128237","ru":"Легенда о святом мече: Легенда маны – Каплевидный кристалл","en":"聖剣伝説 Legend of Mana -The Teardrop Crystal-","year":"2022","type":"Аниме","rating":4.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/au32F8uWsO57yQ2oY2qWSMGqGZx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/87WbN1Ia1L4p75gkOuwbOlU5MsB.jpg","genres":["Мультфильм","Боевик","Фантастика","Аниме"],"overview":"Великое Древо Маны было уничтожено во время Войн Маны и теперь главному герою предстоит обеспечить его рост и «очищение», собирая по всему миру артефакты, являющиеся «законсервированными» землями, подземельями, замками и прочее.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"680590","ru":"Любовь, любовь, любовь","en":"Love Is Love Is Love","year":"2021","type":"Фильм","rating":4.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/360fKJpdFTqu3cwRXUREAn1cLUq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/336Je1Wzrhl89eIdirS9YRhfIiz.jpg","genres":["Комедия","Мелодрама","Драма"],"overview":"Пикантная история из трех новелл, которая исследует любовь, преданность и верность между парами и друзьями.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"217417","ru":"MILF Manor","en":"MILF Manor","year":"2023","type":"Сериал","rating":4.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/xVP7wggDSmLfLG6H8Vw86Xn2XWL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AapvoTMnfcNd5n5fpzYKYQK4C1E.jpg","genres":["Реалити-шоу"],"overview":"","source":"tm