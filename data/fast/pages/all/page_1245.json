QnjoFLpKhQAK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8pstjUz7Z07WwOLpiQrdVoBGtYi.jpg","genres":["Приключения","Фэнтези","Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"266315","ru":"ਜੱਟ ਜੇਮਸ ਬਾਂਡ","en":"ਜੱਟ ਜੇਮਸ ਬਾਂਡ","year":"2014","type":"Фильм","rating":5.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/kgeAS28rBZJSEVypaKpEaI4wunn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3zpR0XaPfXxmoh7inMDuim2Uc3S.jpg","genres":["Комедия","Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"166791","ru":"ジャスティ","en":"ジャスティ","year":"1985","type":"Мультфильм","rating":5.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/gelCCBuzFhByDcL4amJuYoiegXM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4xgstFsVjsYhGzg5tW7QPNjVEdQ.jpg","genres":["Фантастика","Мультфильм","Приключения","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"339937","ru":"悼む人","en":"悼む人","year":"2015","type":"Фильм","rating":5.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/fp9BkmngQvtfQI9MCrul31gOQ4x.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gtVspKKV8MbWqO7vn2T6gJr2bjp.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"405049","ru":"Эпоха демонов Суйкодэн","en":"妖世紀水滸伝 魔星降臨","year":"1993","type":"Мультфильм","rating":5.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/kK8SSjBTGxQQcgi4Wl6CpyEH5DX.jpg","backdrop":"","genres":["Мультфильм","Боевик","Приключения","Фэнтези"],"overview":"Недалекое постапокалиптическое будущее. Токио лежит в руинах после крупного землетрясения. Банды, контролируемые преступными синдикатами, властвуют над улицами, где выживает только сильнейший. В городе царит анархия. Главный герой Такатэру Суга узнает, что его сестра похищена мощной преступной группировкой. Герою предстоит спасти сестренку, попутно уничтожив бандитское логово. И чтобы повысить шансы на успех, Суга вступает в союз с двумя бывшими наемниками, трансвеститом и монахиней. Но впереди команду ждут не только обычные бандиты — заклятый враг Такатэру из прошлого жаждет мщения.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"429910","ru":"Halal Daddy","en":"Halal Daddy","year":"2017","type":"Фильм","rating":5.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/khaUm8DaLmA8duCLuHL8rxY7LWN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lp5anwox3nrrIm9FoWvXv9tMAw0.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"654403","ru":"30/30 Vision: Three Decades of Strand Releasing","en":"30/30 Vision: Three Decades of Strand Releasing","year":"2019","type":"Фильм","rating":5.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/tdRHjL7sWp87mDfDQebnV7AM1RW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nOiItOedPFUAvbg4zIsZOzIrrpm.jpg","genres":["Комедия","Фантастика","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"338376","ru":"白河夜船","en":"白河夜船","year":"2015","type":"Фильм","rating":5.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/5fVWNCNPviWXX5sMskgWYEDwTLF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qUVIgT2TzILQzDujak29ajCNl2c.jpg","genres":["Мелодрама","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}