ей тринадцатого апостола, выбирает младшую правнучку Фэй, чтобы использовать её для раскрытия самых мрачных семейных тайн. Члены семьи понимают, что деревянные статуи святых были свидетелями каждого из грехов, и теперь их жизни зависят от того, смогут ли они принять правду, которая может оказаться куда страшнее любого призрака.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"324082","ru":"Love In Beijing","en":"Love In Beijing","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/aRmN4NsgqdF2bGg0YpcxYsKceZ1.jpg","genres":["драма","НФ и Фэнтези","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}