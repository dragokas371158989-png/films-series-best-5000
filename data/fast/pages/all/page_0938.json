кальный мультфильм, основанный на оригинальной песне Пауля Триппа и Джорджа Кляйнзингера. Героями анимационной ленты становятся различные музыкальные инструменты, участники оркестра. Их великое множество: флейта, пикколо, гобой, кларнет, труба, скрипка, виолончель, контрабас, ксилофон, тарелки и прочее. Центральный персонаж — туба Табби, труба-толстячок. Она не довольна отведенной ей ролью в оркестре и устала от бесконечной басовой линии. Табби становится предметом насмешек других инструментов. От обиды труба убегает к ручью, где знакомится с одаренной лягушкой. Жительница болот помогает Табби разучить новую партию.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"310502","ru":"揽你入怀栀意浓","en":"揽你入怀栀意浓","year":"2025","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7n0mcgECHIRYHdpXFetp2eLW7Nu.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"304085","ru":"轻吻甘甜","en":"轻吻甘甜","year":"2025","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/ixGeWnnTXHmpJv7PYRJimKV2SI2.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"318065","ru":"日落之前拥抱你","en":"日落之前拥抱你","year":"2026","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9EalzZ5pWScmrxtLyxwBDYW01vt.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"306589","ru":"折金枝","en":"折金枝","year":"2025","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/bEXAfAM58coGRh8wml20s0gjJx9.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"314869","ru":"茶香四溢，爷他宠妻无度","en":"茶香四溢，爷他宠妻无度","year":"2025","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/28I4HOaeP4Xh9m6MorUCzx5I5jK.jpg","