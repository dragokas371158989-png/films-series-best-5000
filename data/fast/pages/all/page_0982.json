 She Lies","en":"Where She Lies","year":"2020","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/87ABySrJl8voJWdpmTlicIbHpxs.jpg","backdrop":"","genres":["Документальный","Детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"322202","ru":"Мои друзья Тигруля и Винни: Сказки для друзей","en":"My Friends Tigger & Pooh: Friendly Tails","year":"2008","type":"Мультфильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/sy18W9WWN8ZT5nyU11svBAcYhCb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bNAInemZYlHXw4ttdOFir0aRPtS.jpg","genres":["Мультфильм","Семейный"],"overview":"Ура! День обещает быть незабываемым, так что присоединяйтесь к Винни, Тигруле, Дарби и всей их веселой компании, раскрывающей новые удивительные тайны в самом сердце Сказочного Леса! Как только нужно решить какую-то проблему или разгадать загадку, за дело берутся Супер Сыщики. Они охотятся за сокровищем пиратов, идут по горячему следу пропавшего щенка или лечат икоту Тигрули, но, как только они объединяются с ТОБОЙ в поисках приключений - любая непосильная задача становится выполнимой!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"83893","ru":"KBS 드라마 스페셜","en":"KBS 드라마 스페셜","year":"2010","type":"Сериал","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/cWCHdWNCExYVug7aD7vTRUrzrfb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gmNtsz7MJ3IQoCFt8ymGNDfipfm.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"83853","ru":"あさが来た","en":"あさが来た","year":"2015","type":"Сериал","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/wNx40I5mkvowLdGsrGPzkKMJMPR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7SKBqTGhB3oycHcrWLNwMrLtZXy.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"51261","ru":"Taxa","en":"Taxa","year":"1997","type