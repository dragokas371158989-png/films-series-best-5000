 Британская Колумбия, штат Техас, Индонезия, архипелаг Сокорро (Мексика), Калифорния и Флорида. Представители рода ламантинов отличаются от представителей семейства дюгоней (Dugongidae) формой черепа и хвоста. Хвост ламантина имеет форму весла, в то время как хвост дюгоня — форму вилки. Одной из уникальных черт, объединяющих ламантинов со слонами, является постоянная смена коренных зубов, в целом нехарактерная для млекопитающих. Новые зубы появляются дальше по челюсти и постепенно вытесняют старые и изношенные зубы вперёд.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"136729","ru":"Qurban","en":"Qurban","year":"2017","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/z2OxQvF9flvhXnE0i6jtMeWfTaK.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"93805","ru":"De sjældne danskere","en":"De sjældne danskere","year":"2018","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/iYafDuMvvsduDcBAy2lzUOmt1X.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"231721","ru":"Verdens strengeste forældre","en":"Verdens strengeste forældre","year":"2011","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/oCxzeEvJOwtIxssEJD0BnmmIB7w.jpg","genres":["документальный","Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"124998","ru":"いろはに千鳥","en":"いろはに千鳥","year":"2014","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/A2fxpejfp4P4Js7cOgL0dATtZii.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"76770","ru":"Bride Killa","en":"Bride Killa","year":"2018","type":"Сериал","r