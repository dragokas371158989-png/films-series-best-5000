T.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9cO8wC2PkZ9nXYgTwJB2y11bUd.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"94879","ru":"Road Quest","en":"Road Quest","year":"2019","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/2s9luYgQm1aAtIUS2cnkQ3GJTwf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/IyMdtFxjmoVaENykA4C8bHLLgK.jpg","genres":["Комедия","Документальный","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"67938","ru":"Milwaukee Blacksmith","en":"Milwaukee Blacksmith","year":"2016","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ffkTKnKttK7kvn5tjogQzxdGkrt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oTJYLJcMs60576DGLWfSAPH9tpw.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"60160","ru":"Океаническая Одиссея: В подводном царстве","en":"Ocean Odyssey: The Blue Realm","year":"2010","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/xe6EZkTlFLO3k6KhBan5W5ldZER.jpg","backdrop":"","genres":["Документальный"],"overview":"Данный сериал - это телевизионные истории об удивительных существах в океане. Используя превосходную съёмку высокой четкости, привлечение ведущих ученых, опытных ныряльщиков - эти серии переносят зрителей в чарующий мир дайвинга. Съемки производились в местах: Папуа-Новая Гвинея, Палау (Микронезия), Южная Африка, Красное море, Большой Барьерный риф, Багамские острова, остров Кокос (Коста-Рика), Британская Колумбия, штат Техас, Индонезия, архипелаг Сокорро (Мексика), Калифорния и Флорида. Представители рода ламантинов отличаются от представителей семейства дюгоней (Dugongidae) формой черепа и хвоста. Хвост ламантина имеет форму весла, в то время как хвост дюгоня — форму вилки. Одной из уникальных черт, объединяющих ламантинов со слонами, является постоянная смена коренных зубов, в целом нехарактерная для млекопитающих. Новые зубы появляются дальше по челюсти и постепенно вытесняют старые и изношенные зубы вперёд.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"136729","ru":"Qurban","en":"Qurban","year":"2017","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/z2OxQvF9flvhXnE0i6jtMeWfTaK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ktyGWVZlV9euJYvq1gau0RwrOLD.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"93805","ru":"De sjældne danskere","en":"De sjældne danskere","year":"2018","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/iYafDuMvvsduDcBAy2lzUOmt1X.jpg","backdrop":"https://image.tmdb.org/t/p/w780/p42c6xr3eDd6qRFq2wPwhpz7rOp.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}