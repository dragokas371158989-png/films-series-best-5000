.org/t/p/w342/5XFsFIsnHaaIsfjoCGMs5N26pm6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1Glsr13h76eXUFrHzifUiHqGMOu.jpg","genres":["комедия","телевизионный фильм"],"overview":"Искрометное выступление актера и комика Рики Велеса. Издание Variety внесло артиста в список «Десять комиков, которых стоит посмотреть». В своем первом спешле Рики сполна оправдывает розданные ранее авансы и показывает самобытный и очень честный юмор. Продюсером его сольного выступления стал именитый комедиограф Джадд Апатоу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1497348","ru":"Alas Roban","en":"Alas Roban","year":"2026","type":"Фильм","rating":4.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dtJmnGZYuA2Ngnj3iv0T9EqCHBH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5Q2CWHZTk48lb8QOMninYmzUfvc.jpg","genres":["драма","ужасы","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1241743","ru":"Kapalit","en":"Kapalit","year":"2024","type":"Фильм","rating":4.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/s58sRbuoAojLFDZW8tUaTzpv7aB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xTYzXsIwf4qypnNRkSpkiHE3O30.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1404320","ru":"特工狂花2：蜜桃杀机","en":"特工狂花2：蜜桃杀机","year":"2024","type":"Фильм","rating":4.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/9D8v1zS9qsvekrMiQPjVqYlJz0L.jpg","backdrop":"https://image.tmdb.org/t/p/w780/su40GoVmKOLQGrFAXcvV2qd625H.jpg","genres":["боевик","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1582328","ru":"Sonunda Sen","en":"Sonunda Sen","year":"2026","type":"Фильм","rating":4.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/mnBW7o8ycDi8WotGeRkGoDxrNMd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yt7kUJ42heOePCPAdzvsAZP7lJH.jpg","genres":["комедия","мелодрама"],"overview":"","source":"t