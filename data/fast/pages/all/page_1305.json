 свой талант для создания и распространения движения FEMEN. Между горячим рвением творить и глубоким желанием изменить мир, она стала соучредителем знаменитой группы активисток, путь которых увел их с Украины в далекие уголки Европы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"107827","ru":"紅樓春夢","en":"紅樓春夢","year":"1977","type":"Фильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/nKZz3U3T1MlOpleurYbgLjmDhyW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6McCai8tyqCPWpZqaJtxmj3CjMo.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"64933","ru":"Hot Bench","en":"Hot Bench","year":"2014","type":"Сериал","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/yBTQALxmu6r92lGiE1qgWGA8HXq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5PaN8C94wAqaM2GnXtbHxurVvMD.jpg","genres":["Реалити-шоу","Ток-шоу","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"340349","ru":"全力扣殺","en":"全力扣殺","year":"2015","type":"Фильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/1enHeQcDyH3esIYmOVQYJhbLoxF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nsVkroU7GfRFqoTvS4kcGn5fZ6D.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"245336","ru":"Noël","en":"Noël","year":"1992","type":"Мультфильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/AebVj0yJPNgx3Lb1OUChlTISq8u.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n7VPoBq4ohtNmeRNk1PB24KSSvE.jpg","genres":["мультфильм","телевизионный фильм","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"480975","ru":"Façades","en":"Façades","year":"2017","type":"Фильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/wxZEaWY4lfawA44iF3v7GF6Aqw4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5gdk7j