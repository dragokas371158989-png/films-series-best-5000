://image.tmdb.org/t/p/w342/vfNru8IkSG3TBBfmshkjCj4oANM.jpg","genres":["боевик","приключения","мультфильм","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"144216","ru":"Приключения Шерлока Холмса: Этюд в багровых тонах","en":"Sherlock Holmes and a Study in Scarlet","year":"1983","type":"Мультфильм","rating":5.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/eRPbIus6KxUutiBXOv3qMbHGllY.jpg","genres":["детектив","мультфильм","семейный"],"overview":"Сэр Артур Конан Дойл обязан своим местом в мировой литературе только своими рассказами, в которых он изображает своего главного детектива Шерлока Холмса с доктором Уотсоном направляющихся на охоту с преступниками. Доктор Уотсон вспоминает своё первое знакомство как любознательный студент с Шерлоком Холмсом и первое совместное мероприятие. «Расследование Алого ордена» раскрытую трагедию религиозного фанатизма, любви, ненависти и смерти и впервые представило непревзойденный метод тщательного наблюдения и логического вывода Холмса.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1212","ru":"Prisoners of Gravity","en":"Prisoners of Gravity","year":"1989","type":"Сериал","rating":5.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/iYgDca5h0hQm8hFuLWivTeomET2.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"45205","ru":"ウール100％","en":"ウール100％","year":"2006","type":"Мультфильм","rating":5.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/nd0zXRGCf19MW2lnZXrf8OexgFR.jpg","genres":["мультфильм","комедия","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1391149","ru":"Орудия. Новая глава","en":"Waktu Maghrib 2","year":"2025","type":"Фильм","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/dTbDKuvr20EiyZxGDzBSMagonB1.jpg","genres":["ужасы","детектив","триллер"],"overview":"Через 20 лет после ужасных событий в Джатиджаджар в соседней деревне Гиритирто происходит похожий случай. В сумерках возвращаясь с футбольного матча, мальчишки из проигравшей команды и двоюродная сестра одного из них произносят злые слова, после чего нечто заманивает их в лес. Из лесной чащи возвращаются только трое, включая девочку, и с ней явно что-то не так. За этими событиями наблюдает повзрослевший Ади, который 20 лет назад потерял друга и теперь решил во что бы то ни стало уничтожить виновную в этом злую сущность.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1086726","ru":"एलएसडी 2: लव, सेक्स और धोखा 2","en":"एलएसडी 2: लव, सेक्स और धोखा 2","year":"2024","type":"Фильм","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ywUtbLJngSqykpxiIHIqJNA06EX.jpg","genres":["драма","комедия","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"795838","ru":"บอสฉันขยันเชือด","en":"บอสฉันขยันเชือด","year":"2021","type":"Фильм","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/gkZjoJcroaUrbjK0TE49ysLCGf6.jpg","genres":["комедия","детектив","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"486590","ru":"Polański, Horowitz. Hometown","en":"Polański, Horowitz. Hometown","year":"2021","type":"Фильм","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/qxteWaJcb7p8ocquRcBT1CW6IXm.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"105315","ru":"Lauren Lake's Paternity Court","en":"Lauren Lake's Paternity Court","year":"2013","type":"Сериал","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/f2ba4FRCjfiDkcrBzk7kNusZtW5.jpg","genres":["Реалити-шоу","Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"565885","ru":"வந்தா ராஜாவாதான் வருவேன்","en":"வந்தா ராஜாவாதான் வருவேன்","year":"2019","type":"