":"","ageRating":""},{"id":"202429","ru":"A Ponte: The Bridge Brasil","en":"A Ponte: The Bridge Brasil","year":"2022","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/9c3W1W5bNCSJX7fEqQjSNB2yThG.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"275600","ru":"Feuds Turned Fatal","en":"Feuds Turned Fatal","year":"2024","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/iOT7nj0SzWVuAfSSMsd2akYANYg.jpg","genres":["криминал","документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"130275","ru":"Älskade Husby","en":"Älskade Husby","year":"2020","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/nWfhrxfWcJ0JAlHs3uqcdkiAtbj.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"127872","ru":"Hitler Staline, le choc des tyrans","en":"Hitler Staline, le choc des tyrans","year":"2021","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/8k683GKiuKM9QspAANjt80YYew8.jpg","genres":["документальный","Война и Политика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"246428","ru":"Fanden ta' kommunen","en":"Fanden ta' kommunen","year":"2024","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/9TUxGkRhcr4uVBDTPwd3S2wlW3G.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"3061","ru":"Springwatch","en":"Springwatch","year":"2005","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/20eViMeHXpfOIKeaiDFL6hCjaeZ.jpg","genres":["документальный","семейный"],"overview":"Главный герой фильма — Джон, приехал в Нью-Йорк из глухой провинции. Он мечтает стать «королём» рекламы, но, столкнувшись с горькой действительностью, он вынужден работать клерком. Он влюбляется, женится. После свадьбы молодожены селятся в маленькой стандартной квартире. Появляется ребенок. Жизнь усложняется. С рождением второго ребёнка увеличиваются, и материальные затруднения. Главному герою повезло, он выиграл в лотерею, но за ним приходит несчастье — дочь погибает под колесами автомобиля. Джон стал рассеян и его увольняют с работы. Нужда приводит к разногласиям в семье. Жена собирается оставить Джона. Но однажды он возвращается домой счастливый — наконец он заработал доллар. Ему повезло — он теперь будет работать носильщиком рекламных щитов циркового представления.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"111526","ru":"The Great War","en":"The Great War","year":"2014","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/1sqvIM1MtZ0Z0YiwM8y6Fa8T1P7.jpg","genres":["документальный","Война и Политика"],"overview":"В ноябре 1918 года, когда Первая мировая война подходила к концу, подразделение американских солдат отправляется в тыл врага, чтобы найти потерявшийся взвод афроамериканских солдат.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"45259","ru":"Мария Селеста","en":"María Celeste","year":"1994","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/jPwe4og2gx6UceJjIFdopd9QBIO.jpg","genres":["драма","Мыльная опера"],"overview":"Мартирио Паниагуа вырастила Марию Селесту, как родную дочь. Мария считает ее матерью и не ведает, что это не так. Ее настоящая мать в свое время встречалась с певцом Патрисио Идальго, а так как она была дочкой миллионера, то вопрос о замужестве даже не рассматривался. И когда ее отец узнал об этих отношениях, то выгнал из дому несчастную, лишив ее средств к существованию. Вскоре родителей девушки не стало, они попали в автокатастрофу, а ее удочерила подруга матери, которой и была Мартирио. Она растила ее наравне со своей родной дочерью, никогда не делая между ними различий. Прошло много лет, и Мария выросла. Семья, в которой она выросла, была не богата и остро нуждалась в деньгах. Мария решила помочь и стала искать работу. Ей удалось найти место в консорциуме Идальго, где хозяином был ее дедушка.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"73347","ru":"Сладко-соленый","en":"Sucré salé","year":"2002","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/o4JQcem2uszT5vwrOkQUn1zZ3LH.jpg","genres":["Ток-шоу"],"overview":"Все лето главный герой путешествует по Квебеку, чтобы познакомить вас с местной жизнью и культурными мероприятиями.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"78945","ru":"Family Affair","en":"Family Affair","year":"2002","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/c31jGGgUgM2Fy7bmGB2vadARkaW.jpg","genres":["комедия","семейный"],"overview":"Билл Дэвис — высокооплачиваемый инженер-консультант, который ведет беззаботную жизнь на Манхэттене. Всю домашнюю работу за него выполняет дворецкий-англичанин Джайлс Френч — настоящий джентльмен с идеальными манерами. Привычный ход жизни меняется, когда Биллу приходится взять на воспитание троих детей своего погибшего брата: 6-летних двойняшек Баффи и Джоди, а также 15-летнюю Сисси. Так что теперь чопорному англичанину и свободолюбивому американцу предстоит освоить непривычную и нелегкую роль родителей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"4293","ru":"Охотники за сновидениями","en":"Sleepwalkers","year":"1997","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/stXLjQzeHrXNLGvgtpi2cpyYtvp.jpg","genres":["детектив"],"overview":"Сериал рассказывает о команде исследователей, которые используют технологии для проникновения во сны пациентов, чтобы диагностировать их проблемы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"18333","ru":"Best Ed","en":"Best Ed","year":"2008","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/k6aU2dMhkCfZMcCfEsnBH8hmLv5.jpg","genres":["комедия"],"overview":"Находящийся в творческом кризисе художник, одолеваемый кошмарами, живет вместе со своей женой на острове. Усугубляют страдания творца знакомство с проживающими поблизости аристократами и конфликт с беременной женой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"197632","ru":"Королёк – птичка певчая","en":"Çalıkuşu","year":"1986","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/luy0CvQyWT6JnoizG6Furg0iCb9.jpg","genres":["семейный","драма"],"overview":"Главная героиня фильма, Фериде, живет с теткой и ее сыном Кямраном. Повзрослевшая Фериде неожиданно для себя влюбляется в кузена. Ее тайна становится известна жителям деревни. Правда, вместе с этим выясняется, что и Кямран тоже любит Фериде. Свадьбу неожиданно срывает известие о мимолетном романе Кямрана в Европе. Фериде покидает отчий дом навсегда...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"69301","ru":"Чёрный хлеб","en":"Kara Ekmek","year":"2015","type":"Сериал","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/dJlsDp7yjpJfoC7DIlfdqVYnPln.jpg","genres":["драма"],"overview":"История двух сестер по имени Асие и Мине. Живут они на окраине Стамбула. Жить без любви, без денег, без всякой надежды на счастливое будущее тяжело, но не смотря на это сестры близки в отношениях друг с другом. Они всегда готовы доверить друг-другу все свои тайны и мечты. Старшая сестра - Асие достаточно амбициозная и глубоко уверенная в себя девушка. Младшая же - полная ее противоположность. Мине спокойная и покорная. В этом жестоком и нелегком мире сестры пытаются жить и любить. Но неожиданно жизнь одной из сестер меняется самым непостижимым образом","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"219364","ru":"Hearts On Ice","en":"Hearts