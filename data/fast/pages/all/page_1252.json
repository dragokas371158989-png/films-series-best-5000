уги, которые были неразлучны в школе, возвращаются в родной город на юбилей выпуска. 10 лет назад они спрятали коробку со своими самыми страшными признаниями и теперь должны найти ее, чтобы выполнить обещание, данное пятой, не дожившей до выпускного подруге. Девушкам придется поставить под угрозу не только дружбу, но свои жизни, чтобы разобраться в тайнах прошлого.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"12173","ru":"Запрещенная любовь","en":"Verbotene Liebe","year":"1995","type":"Сериал","rating":5.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/nO6PgeFkvsNN3PsE9xHSzqwCgNC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cjC8yYIw9IKfZ8YvD1DeawTEncX.jpg","genres":["Драма","Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"63252","ru":"Amar es para siempre","en":"Amar es para siempre","year":"2013","type":"Сериал","rating":5.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/lwnQn72X1i1Wwxm2tdCKXmBj91g.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hNkoafDHaWyeh6UV0ih5pPQ0CmR.jpg","genres":["Драма","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"8318","ru":"Zone Stad","en":"Zone Stad","year":"2003","type":"Сериал","rating":5.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/7vmeHSwf05wBP4vGmdGpmVIPPG1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qm27V4XXMQDX5GPWGlqHjUYB5DA.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"580430","ru":"இஸ்பேட் ராஜாவும் இதய ராணியும்","en":"இஸ்பேட் ராஜாவும் இதய ராணியும்","year":"2019","type":"Фильм","rating":5.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/AsiChegfsDU0nfrF8vl5LfiVpw0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/i5W9qkiiSHxLHFOOypsCOqNeNbU.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"617134","r