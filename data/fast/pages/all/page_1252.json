country":"","ageRating":""},{"id":"1132152","ru":"Туз","en":"ஏஸ்","year":"2025","type":"Фильм","rating":5.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/8N9ET0MxfaYi1R2a8my0x3JCAxW.jpg","genres":["криминал","комедия","боевик"],"overview":"Каннан приехал в Малайзию, чтобы начать жизнь с чистого листа, но судьба приготовила ему неожиданный куш - любовь к прекрасной и гордой Рукку. Девушка отчаянно борется с коррумпированным отчимом-полицейским, который шантажом выживает её из родного дома. Пытаясь помочь возлюбленной, Каннан делает роковую ставку в подпольном казино, но попадает в ловушку к его владельцу - коварному ростовщику Дхарме. Теперь, чтобы спасти Рукку и себя, ему предстоит провернуть дерзкое ограбление банка.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"136166","ru":"Lang Leve de Liefde","en":"Lang Leve de Liefde","year":"2020","type":"Сериал","rating":5.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/9lpvvzEl5kViIc2vUJG4QKzj2ds.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1301988","ru":"Cita","en":"Cita","year":"2024","type":"Фильм","rating":5.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/yh3KwJ6IE9RLkIaEsY9obo5CtCM.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1130852","ru":"Ka Whawhai Tonu","en":"Ka Whawhai Tonu","year":"2024","type":"Фильм","rating":5.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/4nhZYd3R7pzpijUiR6oY7VbeO70.jpg","genres":["боевик","приключения","драма","история"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"843252","ru":"Ура мечте! Фильм: Эпизод о Розелии — II","en":"BanG Dream! Episode of Roselia II: Song I am.","year":"2021","type":"Мультфильм","rating":5.2,"votes":9,"poster":"https://imag