ster":"https://image.tmdb.org/t/p/w342/yibOkTdFK8XDvNHK51ZrsdcCK7e.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3WoFhneZUitYaeKpv0Fkmil0zti.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"2786","ru":"Sons of Thunder","en":"Sons of Thunder","year":"1999","type":"Сериал","rating":9.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/mfZd6MiPet5DeBrGkkzST5RiSz3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dvaaHIFjZWFIqokpUsBh01v3oIO.jpg","genres":["драма","Боевик и Приключения","криминал"],"overview":"Фердинанд и нанятая присматривать за его ребенком приходящая няня, Карина, сбегают из дома и едут к морю на угнанном автомобиле, набитом крадеными деньгами… Он оставляет позади богатую жену, а она — неприятности, связанные с бандитами. Преследуемые полицией, они сжигают автомобиль, а вместе с ним и деньги мафии, и скрываются на безлюдном острове. Но что-то в их отношениях не складывается, и роман кончается.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}