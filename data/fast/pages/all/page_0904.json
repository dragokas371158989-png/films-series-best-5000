ng":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vQdiUWA8nF8Xi7izglIaRhx2mVo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s5zVARNdUOWHoxLNnhiACqY9q3B.jpg","genres":["комедия","Новости"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"310302","ru":"Raw Weekly Recap","en":"Raw Weekly Recap","year":"2026","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4TgJm0R6HWmdV57I3zFGg5lcTAd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jrbIROQqsBp26Fm8oHg1RrYGpyh.jpg","genres":["Боевик и Приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"301299","ru":"Crime désorganisé: au cœur de la délinquance juvénile","en":"Crime désorganisé: au cœur de la délinquance juvénile","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/wykDeYuewMVR8aPnfc23SKyhu1c.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4TFeT3ELKwXIJg9QBD68IFmQTst.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305057","ru":"Melvin ser rødt - ikke kun for sjov længere","en":"Melvin ser rødt - ikke kun for sjov længere","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vnpmwetBEVU0GZvvRJg1BeqwrEG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ruGNKGNrpnWeIxNNJsjlzoCb9IT.jpg","genres":["документальный","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"2667","ru":"Face The Nation","en":"Face The Nation","year":"1954","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/fWa7ZzkPT9FauzGuAi8NHPCH325.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bcOQi7jYd4XZpQ1JMbZ24p5iI6W.jpg","genres":["Новости","Ток-шоу"],"overview":"В октябре 1994 года трое студентов-кинематографистов исчезли в лесах штата Мэриленд во время съёмок документального фильма… Год спустя отснятый ими материал был найден. Они приехали в лес на Чёрных холмах в штате Мэрилэнд, чтобы снять документальный фильм о местной легенде — Ведьме из Блэр, мучившей и убивавшей всех, кто забредал в её владения. В предании говорится о вековом проклятии, ритуальных убийствах детей, зловещих артефактах и сверхъестественных явлениях. Но не успели студенты, вооруженные 16-миллиметровой камерой, углубиться в лес, как безнадёжно заблудились. Вокруг них сгущается невидимое зло…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1694","ru":"L.A. Doctors","en":"L.A. Doctors","year":"1998","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/mjBfHS7YSi91EzVd0r2hgFlCF6K.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kdBDcLmlFfaEqyWw2BJxyjZDMMh.jpg","genres":["драма"],"overview":"Студент медицинского университета Герберт Вест реанимирует мёртвых с помощью сыворотки, полученной в результате немыслимых экспериментов. Сосед Веста по комнате Дэн помогает приятелю в его страшном деле. Они начинают с кошки и добираются до трупов из университетского морга.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1529513","ru":"蛊降","en":"蛊降","year":"2026","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/wo8gufc4mGfu8Fejbn9nTRmuXYp.jpg","backdrop":"","genres":["приключения","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"73797","ru":"Девятнадцать","en":"Nineteen 19","year":"1990","type":"Мультфильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/wShb5W3Kq2BGbur1RBRlJebXced.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vL6bvEmxtomkkeUGvO2Kl7Amutp.jpg","genres":["мультфильм","мелодрама","драма"],"overview":"Куботе-куну вот-вот исполнится девятнадцать. За минувшие восемнадцать лет он сделал не так уж мало: окончил школу, устроился работать помощником кондитера в кафетерий, готовится в колледж и, к тому же, успел влюбиться. Фудзисаки-сан была самой очаровательной девочкой в средней школе, не зря она стала фотомоделью, бедный Кубота был обречен... и вот теперь, когда ему вот-вот стукнет девятнадцать, он снова видит Фудзисаки – еще более прелестную, нарядную и желанную, чем прежде. Может ли «девушка с обложки» осчастливить недотепу-кондитера?.. ведь если чудес не бывает в девятнадцать, когда ж им и случаться-то...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"928541","ru":"DIE WELT SIND WIR","en":"DIE WELT SIND WIR","year":"2022","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8sOUYrOMRhxTrtHQKbxVlCUgu87.jpg","backdrop":"","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1551154","ru":"Turtle und Albion","en":"Turtle und Albion","year":"2025","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4RzBe4xIG5x7gMrAEFq0qtalYFr.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1565268","ru":"L'Affaire Abdallah","en":"L'Affaire Abdallah","year":"2026","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/k1NjBvV8sycfHIHFQdfnDuAtj7U.jpg","backdrop":"","genres":["документальный","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"310631","ru":"Эскадрон красоток","en":"Groove Squad","year":"2002","type":"Мультфильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/47zztfbvkO8zMdzI8GmXMYJfdpu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vLga8jqPAJ1cwn4Jvf0rSn9hobq.jpg","genres":["телевизионный фильм","мультфильм","семейный"],"overview":"Как будто им было мало переживаний, связанных с участием в ежегодном конкурсе групп поддержки. Теперь они ввязались в борьбу с мировым злом! Три лучшие подруги Крисси, Мак и Пинг и их верный талисман Зек - не просто компания отвязных подростков.Они - супергерои, прямо как «Ангелы Чарли»! Но их миссия почти невыполнима: бесстрашные девчонки должны сорвать зловещие планы безумного доктора Найтингйла, собравшегося захватить власть над всем миром!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"938926","ru":"Whoopi Goldberg: The Winning Act","en":"Whoopi Goldberg: The Winning Act","year":"2022","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/A0zr8L74a9fdsGdy1gnbsNXUmI1.jpg","backdrop":"","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"132376","ru":"走れ！白いオオカミ","en":"走れ！白いオオカミ","year":"1990","type":"Мультфильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/z0XVFFoSFOARuc8ONW32Zwm3Wha.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s2BvQalXQFCK7qSdLIaDyP1cA2K.jpg","genres":["драма","семейный","мультфильм"],"overview":"Сериал рассказывает, что происходит за занавесом во время решающего сезона в одном из крупнейших футбольных клубов мира, когда \"Арсенал\" бросает свои усилия на борьбу за успех в национальном чемпионате и возвращение в еврокубки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1055255","ru":"Claustro","en":"Claustro","year":"2022","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1hpwBQAVS5h7YBkKLmQqAkZ6BiT.jpg","backdrop":"","genres":["фантастика","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"28278","ru":"Мышиный переполох: Ночь перед Рождеством","en":"The Night Before Christmas: A Mouse Tale","year":"2002","type":"Мультфильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/pAI41MpGL3dppv3ca1cNKe0JtiO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aVlMe3ovNmi2hvM0HORNYirGNSo.jpg","genres":["мультфильм","телевизионный фильм"],"overview":"Cемья Атвеллов готовится к встрече Рождества. По всему дому витает дух наступающего праздника. Двум маленьким мышатам Скипу и Сквик, живущим по соседству, всё кажется таким таинственным и загадочным - украшенная ёлка, коробки с подарками, праздничный стол - всё вызывает любопытство.В праздничную ночь они отправляются в удивительное путешествие по дому,чтобы получше узнать,что такое Рождество? Их ждут встречи с ожившими рождественскими игрушками и даже с самим Сантой Клаусом. Этот весёлый рождественский мультфильм расскажет вам немало нового о самом ярком празднике детства и станет отличным подарком для детства.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1372306","ru":"Storytelling","en":"Storytelling","year":"2024","type":"Мультфильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/tVmFw71IAqe9WOr7mNGwjA5ZRjO.jpg","backdrop":"","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"797019","ru":"Моби Дик","en":"Моби Дик","year":"2000","type":"Мультфильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1qc0WBx27p7jZEoSuFfuEw8Xkl3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a3GEDOS9dJsRwXizPcDvXbMWgr4.jpg","genres":["мультфильм"],"overview":"Измаил, от лица которого ведется повествование, молодой человек, уходит в плавание матросом на китобойном судне «Пекод». Вскоре после отплытия из порта выясняется, что рейс «Пекода» совсем не похож на обычные китобойные рейсы. Капитан «Пекода» Ахаб потерял ногу в схватке с Белым китом- Моби Диком. Теперь он вышел в море, чтобы отыскать чудовище и дать ему ответный решающий бой. Он заявил команде, что намерен преследовать Белого Кита и ничто не заставит его отказаться от погони. Захваченная яростной энергией капитана, команда клянется в ненависти к Белому Киту. Встреча с гигантом произойдет в «его владениях», вблизи от экватора. Схватка продолжится три дня, оставив в живых только одного свидетеля битвы…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"320173","ru":"诱他失控","en":"诱他失控","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4KcscById4tAHnBWqhCtaQGsnjH.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"290161","ru":"Charlotte Link - Einsame Nacht","en":"Charlotte Link - Einsame Nacht","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ju2kOGxrSoQxb2LlbatJP4Ay2Pq.jpg","backdrop":"","genres":["криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302591","ru":"怎敌她动人","en":"怎敌她动人","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/f4Z1HO838u4lDq1hiKULrSIYMrO.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1684163","ru":"Sonhos","en":"Sonhos","year":"2026","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8jjJckdxilbkIP2Lf4aK4ttORe6.jpg","backdrop":"","genres":["фэнтези","комедия","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"5822","ru":"SMAP×SMAP","en":"SMAP×SMAP","year":"1996","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/oXogyT6WvyLYVrxjJfiXKuBN1Ov.jpg","backdrop":"https://image.tmdb.org/t/p/w780/12OAXJqYazLGq70FJBv0IGjCHvY.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"99748","ru":"日向坂で会いましょう","en":"日向坂で会いましょう","year":"2019","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/10JBHKcQkhO9upveCfrClhMEbeF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uSr2zmE9sMDiiLurYgpsPQcpQCS.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country