db","episodes":"","studio":"","country":"","ageRating":""},{"id":"1432817","ru":"Mi Amor","en":"Mi Amor","year":"2026","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/ukOLfGfUileYmo2RArqyofwkpWS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/p2FOv6EdjbqmyxlbZLx7HZNhrpo.jpg","genres":["Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"633761","ru":"Рождество трёх медведей","en":"3 Bears Christmas","year":"2019","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/owQo9vr1Yk7QqQNKlkQj5OBDDfE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a6LW8SXQBHfiBZEeOJ1D1p5QqSX.jpg","genres":["Семейный"],"overview":"Медвежонок ускользает рождественским утром, чтобы найти идеальный подарок для своих родителей, Мамы Медведицы и Папы Медведя. И не знает, что ему предстоит встреча со злой ведьмой, которая превратит его в человека.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"759587","ru":"مجبوریم","en":"مجبوریم","year":"2020","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/t1jLZN727u3bWNGSN9YenOT4jDO.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"84583","ru":"Принцесса Лилифи 2","en":"Prinzessin Lillifee und das kleine Einhorn","year":"2011","type":"Мультфильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/miKFgiboTHHlRlCJQPIAhe2T8wG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/emjdNDTfh0DRKIPmpVHKl05QgQM.jpg","genres":["Мультфильм","Семейный"],"overview":"В волшебном Розовом королевстве Лиллифи и ее друзья наслаждаются теплым летом. Однажды ночью принцесса видит странный сон, в котором единорог Розали просит ее присмотреть за своей маленькой дочерью — Люси. Проснувшись, Лиллифи с удивлением обнаруживает, что Люси чудесным образом оказалась на кровати принцессы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"414973","ru":"Неуловимые: Бангкок","en":"Неуловимые: Бангкок","year":"2016","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/5skok9D3QBycRkPqEM0UmWzsIyk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fBmA5LBjFGLYYgAB4OTTfT0JdlD.jpg","genres":["Приключения","Криминал"],"overview":"Четвёрка героев живёт своей обычной жизнью отдельно друг от друга, пока в новостях не появляется сюжет про таинственную девушку (Киру), которая голышом въехала на Красную площадь на коне. Артем, Федя и Женя побросали все свои дела и помчались выяснять причины такого перформанса. Оказалось, что эксцентричный характер Киры здесь ни при чем, и все пути теперь ведут в Бангкок — к их давнему знакомому Сергею Полянскому.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"102758","ru":"Off Camera with Sam Jones","en":"Off Camera with Sam Jones","year":"2014","type":"Сериал","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/wFzCudeLabyjvwh0n5C9rEtCqVy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qI8PwP7R7Fbn78wocvkbFESvjbl.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"53270","ru":"Barwy szczęścia","en":"Barwy szczęścia","year":"2007","type":"Сериал","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/yPAk9l2KMfMXZKuoGLZMadCZRF3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zgDpajdlOKetwZ9Ys296o3qBjFy.jpg","genres":["Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"51038","ru":"Natholdet","en":"Natholdet","year":"2010","type":"Сериал","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fV1MLDaXk3Tq7xmSQcb41L1cet7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oUNw6oeJWsTR1XJXA40VJMHnFZs.jpg","genres":["Комедия","Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"409161","ru"