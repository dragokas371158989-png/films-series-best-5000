.org/t/p/w342/dYXqElbvX631OWSOidA66mmRP6P.jpg","genres":["фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"444213","ru":"The Electric Piper","en":"The Electric Piper","year":"2003","type":"Мультфильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/i9EJ7zbkR8Y8LMLAlug4aJ0pUGw.jpg","genres":["комедия","мультфильм","музыка","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299743","ru":"陛下わたしを忘れてください","en":"陛下わたしを忘れてください","year":"2025","type":"Аниме","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/y0VrJnFQXmMXF4ASTI7tkU0IoOc.jpg","genres":["мультфильм","драма","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"95919","ru":"Махораба","en":"まほらば ~Heartful days~","year":"2005","type":"Аниме","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bhWZOfPsAG5MzuWrYDTU1HtJyUO.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Ширатори Рюши - молодой художник, готовящийся учиться в художественном училище. Прибывая в свое общежитие, Нарутакису, он оказывается в центре внимания, постояльцев, каждый из которых, выделяется своей странностью. Он также встречается с комендантом общежития, Аобу Козуэ, которая, кажется, прекрасной и очаровательной девушкой. Тем не менее, у Козуэ, есть секрет, который и предстоит узнать нашему герою...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"23791","ru":"ポポロクロイス物語","en":"ポポロクロイス物語","year":"1998","type":"Аниме","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/en8iLBsfeE4Lmt5tQ9gjW2Uqh5Q.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"238346","ru":"Эна","en":"ENA. La reina Victoria Eugenia","year":"2025","type":"Сериал","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/edOf3B2ObfI8F6XZTeTHsUcFd0l.jpg","genres":["драма"],"overview":"Эна - это история королевы, а также женщины. О молодой англичанке, которая никогда не мечтала стать королевой Испании. Альфонс XIII, девятнадцатилетний король Испании с 1902 года, остановился на ней, и этот выбор вызвал недовольство его матери Марии Кристины. Она оставила свою семью, свои обычаи, свою культуру и была вынуждена отказаться от своей религии, чтобы жить в чужой стране, где первое, от чего она пострадала, было нападение в день свадьбы, во время парада на Главной улице. Эна никогда не чувствовала себя ни принятой, ни любимой, но всегда боролась за то и другое. Хотя в Испании её больше знают как Викторию Евгению, в британской королевской семье и в кругу их друзей её всегда ласково называли Эна.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1149108","ru":"Любовь на миллион","en":"The Modelizer","year":"2023","type":"Фильм","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/tsHwk7n8w1S5oSWFluYbgjLJrdh.jpg","genres":["комедия","мелодрама"],"overview":"Закоренелый холостяк, наследник очень богатой и влиятельной семьи, наслаждается разгульной и бесшабашной жизнью. Но однажды в баре он встречает обычную на вид девушку, которая отказывается играть по его правилам. Ему приходится приложить немало усилий, чтобы завоевать её сердце, переступив через все свои принципы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"881876","ru":"Жизнь после тебя","en":"Life After You","year":"2022","type":"Фильм","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/laR3ZrAiv9QiAiq8d03BF1s31ni.jpg","genres":["драма"],"overview":"Семья из пригорода борется со смертью своего 19-летнего сына в результате передозировки героина с примесью фентанила. Фильм исследует вопрос о том, кто и что несет ответственность за эту трагедию.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"i