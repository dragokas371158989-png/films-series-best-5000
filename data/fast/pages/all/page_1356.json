:3.3,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/9lbLYTpceUiKU7s7cesmQ6XmhxT.jpg","genres":["криминал","комедия","детектив","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1405185","ru":"Mama's Boy","en":"Mama's Boy","year":"2024","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/1zW70wqJWSsDakL0iDt80UyR9z7.jpg","genres":["драма"],"overview":"О жизни и творчестве оскароносного сценариста Дастина Лэнса Блэка, который рос в строгой религиозной семье. Опираясь на мемуары самого Блэка, фильм рассказывает о нелегком детстве сценариста, его пути к признанию, а также глубоких и трогательных отношениях с матерью; раскрывает Дастина не только как успешного и интересного сценариста, но и как активиста, который всегда черпал вдохновение в любви.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"923032","ru":"Табу 3: Незабываемый акт","en":"Taboo 3: The Unforgettable Act","year":"2021","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/vFGG8RBRMymzeCXYt9CGUwANMEt.jpg","genres":["драма","триллер"],"overview":"Когда Девин, наконец, встречает свою мать-звезду мелодрам, Ребекку, будучи уже взрослым молодым человеком, в ходе общения ему начинает казаться, что чувства между ними выходят за рамки семейной любви","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"698016","ru":"Грузовик","en":"Brummi","year":"2020","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/8hj8a1s0diC7ttmc7511kJNo1bR.jpg","genres":["драма","мелодрама"],"overview":"Кинематографическое размышление о жизни двух геев средних лет и формирующей ценности личной свободы.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"857837","ru":"В дремучем лесу","en":"Deep in the Forest","year":"2021","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/2qnjwezj6xpsRmvcMHsJqZW0U0N.jpg","genres":["триллер","драма"],"overview":"В недалеком будущем напряженность политической обстановки в США достигла такого уровня, что страна разделилась на два крайних лагеря: Демократическую и Республиканскую партии. Разгоревшийся конфликт приводит к гражданской войне. Часть членов Демократической партии и их родных тайно вывозят на заброшенную лыжную базу, чтобы защитить от преследований республиканцев. Запертые в одном помещении люди поначалу пытаются приспособиться к новым условиям, но постепенно внутренняя тревога и мелкие противоречия разрастаются до серьезных конфликтов. Бывшие сторонники становятся противниками.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1061536","ru":"逃学神探","en":"逃学神探","year":"2022","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/2y3PNlp3DWOXRPlmp6M8Kh3KUzK.jpg","genres":["боевик","криминал","комедия","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1555951","ru":"Salikmata","en":"Salikmata","year":"2025","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/tto58PLymhlubrzRatwyUm6iWLw.jpg","genres":["триллер","ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"322302","ru":"Pop Culture Jeopardy!","en":"Pop Culture Jeopardy!","year":"2026","type":"Сериал","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/gsXVzxzxL1SUn3F3arfe6CqJvml.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"978442","ru":"ഹോളി വോട്ടുണ്ട്","en":"ഹോളി വോട്ടുണ്ട്","year":"2022","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/pE6ssvIKeqs8FQLddB1tMvX1pym.jpg","