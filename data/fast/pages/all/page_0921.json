ng":8.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/uILmppa0qraGCzMV9WmPdGmwFPc.jpg","genres":["драма","фэнтези","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"342365","ru":"葫芦兄弟","en":"葫芦兄弟","year":"2008","type":"Мультфильм","rating":8.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/j1nftGotSYI9G6L4nm9oeIsyvBE.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"649478","ru":"A Cool Like That Christmas","en":"A Cool Like That Christmas","year":"1993","type":"Мультфильм","rating":8.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/o2h1aEcW1lRESgL8REv3ePTXNza.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1502038","ru":"るろうに剣心 -明治剣客浪漫譚- 星霜編","en":"るろうに剣心 -明治剣客浪漫譚- 星霜編","year":"2001","type":"Мультфильм","rating":8.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/yCZFHgtIWkWxSkcQ7vUQGPUf9fu.jpg","genres":["драма","мультфильм","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"382960","ru":"मुंबई पुणे मुंबई 2","en":"मुंबई पुणे मुंबई 2","year":"2015","type":"Фильм","rating":8.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/7f0AJgU18vQoz8uEL7dXDhT4FPz.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"43209","ru":"Оргусс","en":"超時空世紀オーガス","year":"1983","type":"Аниме","rating":8.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/jFpI4tXbAFCocWnfMRMpN2C9gaT.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","Аниме"],"overview":"2062 год. В мире идет война. Две сверхдержавы ведут кровопролитные сражения за контроль над космическим лифтом. Одна из сторон решает воспользоваться пространственно-временной вибрирующей бомбой — самым разрушительным оружием созданным человеком — в надежде, что это положит конец войне. Во время проведения операции, закончившейся провалом, Кэй Кацураги, один из пилотов, отправленных на это задание, решает разминировать бомбу, но терпит неудачу, в результате чего происходит взрыв, который приводит к колоссальным изменениям Земли. Оказавшийся в самом эпицентре взрыва, Кэй каким-то образом переносится на 20 лет в будущее новой Земли. Но и здесь, в будущем, как оказалось, не все так хорошо. Кэй, которого некоторые считают избранным, оказывается вовлечен в новый конфликт, итог которого может решить судьбу всего мира.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"126398","ru":"五十公里桃花坞","en":"五十公里桃花坞","year":"2021","type":"Сериал","rating":8.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/A3C6crK4GQPNt2f43Vq6l2c845Y.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"270856","ru":"Безмолвный дом","en":"哑舍","year":"2025","type":"Сериал","rating":8.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/nrGCImMBUzTXRiZdEGkgM7ipRFz.jpg","genres":["драма","НФ и Фэнтези"],"overview":"История Би Чжи, владельца антикварного магазина из будущего, и Су Бэй Лу, ветврача, живущего в наше время. Они становятся партнёрами и вместе путешествуют во времени в поисках антиквариата. Со временем они обретают дружбу, охватившую время и пространство, и с оптимизмом смотрят в будущее.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"244189","ru":"向流星許願的我們","en":"向流星許願的我們","year":"2026","type":"Сериал","rating":8.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/ldZDkCN294O1twViCCfPZOAGnsY.jpg","genres":["драма","НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"118085","ru":"Alertes","en":"Alertes","year":"2021","type":"Сериал","rating":8.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/smUWHDQnfaLltefKSYz9qg3G2bX.jpg","genres":["драма","криминал"],"overview"