{"tab":"all","page":1357,"pages":1604,"count":96213,"pageSize":60,"items":[{"id":"416358","ru":"ஆந்திரா மெஸ்","en":"ஆந்திரா மெஸ்","year":"2018","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/yBuWGqhGKEggKXafKW5A2vkDlhi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1tpcaGy5k7d3XF9wi3rKsqxLu9R.jpg","genres":["Триллер","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"416730","ru":"ਲੌਕ","en":"ਲੌਕ","year":"2016","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/eeknSAMEAnM8X7YqJPHHNetdxpC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5GOcnDyeKDW5h9CN6cUqibEOCfI.jpg","genres":["Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"421561","ru":"Panic","en":"Panic","year":"2016","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/4yEfi6Jtx15Nn7IROS6ZhIF5OPJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oxaEZ7JggSeJl3RXLxrNfIBGz43.jpg","genres":["Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"383557","ru":"환상","en":"환상","year":"2014","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/a5R9Jm2rb3FI5V0bPzDdncp3WFW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/81f3EYDCan8TLFJ1QuRYmK2x42W.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"737170","ru":"大人の同級生 させ子と初恋","en":"大人の同級生 させ子と初恋","year":"2018","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/cxTn4hfFv3jwU5xnuIC15pSWFxl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/unlW8HzkSAAPq2za2RgorlDwSX9.jpg","genres":["Драма","Мелодрама","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"463589","ru":"Я – учитель","en":"Я – учитель","year":"2017","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/g57WPiJi7aqj6RjTzeGlCJksqgC.jpg","backdrop":"","genres":["Драма","Военный","История"],"overview":"1942 год. Учитель Павел Зубов, эвакуированный из блокадного Ленинграда, оказывается в деревне, занятой немцами. Ему приказывают преподавать в школе под контролем новой власти. Молодой идеалист оказывается на моральной развилке: согласиться на сотрудничество, чтобы сохранить жизнь себе и детям, продолжив их обучение, или пойти на открытый конфликт, рискуя всем. Немецкий комендант, образованный и циничный, превращает каждый урок в испытание, заставляя Зубова делать невозможный выбор между компромиссом и принципами. Это не батальное кино, а глубокое психологическое исследование долга и выживания. Фильм задаёт сложные вопросы: что значит быть учителем, когда рушится привычный мир? Можно ли сохранить в учениках человечность, самому идя на сделку с совестью? Испытание Павла — это тихая, но отчаянная битва за души детей, где оружием становятся знания, а класс — последним оплотом достоинства.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"708062","ru":"白衣の妹 無防備なお尻","en":"白衣の妹 無防備なお尻","year":"2018","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/k3ZBl2OjD2jMmuqDWbT3UQfyC0h.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lNEtvQiQfWDbbnwkmVmlO8fCkQm.jpg","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"330405","ru":"Savaale Samaali","en":"Savaale Samaali","year":"2015","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/a2EgJGyGhzuoegelbsVZHNmaxTd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zvcuCsGKg8Ur1HW6AHgsoMswsRk.jpg","genres":["Мелодрама","Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"396713","ru":"우주 흑기사","en":"우주 흑기사","year":"1979","type":"Мультфильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.or