0/ge0rCtkbkXzm1SRMNA2LqgS3kBw.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302169","ru":"アニラとココラ","en":"アニラとココラ","year":"2025","type":"Аниме","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cKFstJ19818dSVEIvfIvME0glcv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pphNC3ZvOd0LYvrKqrfmH9g3W6N.jpg","genres":["мультфильм","комедия","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"283387","ru":"Джон Малейни: все в прямом эфире","en":"Everybody's Live with John Mulaney","year":"2025","type":"Сериал","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/c9hRxGJh6FjArAEpHnfk2IMkRkC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rBznKeMlWgJAB2hlWH1q1r7VfKp.jpg","genres":["комедия","Ток-шоу"],"overview":"Джон Малейни проводит ток-шоу со звездами. В прямой трансляции каждую неделю.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"104160","ru":"La tour","en":"La tour","year":"2020","type":"Сериал","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/9i4SPK15IFP2usWuGjY8qq0W5qt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dIbVTNX6VVKn49URlAyXiUri55p.jpg","genres":["Ток-шоу"],"overview":"Одним утром жители многоэтажки просыпаются и обнаруживают, что все окна и двери наружу окутаны черной пеленой. Мгла пожирает все и каждого, кто пытается пройти сквозь нее. Разбившись на группы, они пытаются выживать.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"247590","ru":"Вечное братство","en":"紫川","year":"2024","type":"Сериал","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lSm5KSR0jJNn5ytihNXwq3XbbYG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ydOMiIdEUfTstHiRzrdxJAa16Ts.jpg","genres":["Боевик и Приключения","Война и Политика","драма","НФ и Фэнтези"],"overview":"Действие происходит в беспокойные времена на земле Цзычуань, когда два клана, Цзычуань и Сайжун, непрестанно воюют. Цзычуань Сюй, который воевал на границе, возвращается в столицу после победы, принеся своей родине временный мир. Однако его встречают новые испытания. Придворный высокого ранга Ян Мин Хуа поднимает восстание. Цзычуань Сюй вместе со своими побратимами Ди Линем и Сы Ту Линем начинают действовать, чтобы устранить угрозу и вернуть спокойствие стране. Но стоит им добиться успеха, как клан Сайжун официально объявляет войну Цзычуаню.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1450340","ru":"Последний разговор","en":"12A రైల్వే కాలనీ","year":"2025","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/wrFVQ5dNoyAIvgJHK8cflDnL6it.jpg","backdrop":"https://image.tmdb.org/t/p/w780/YaINnl7Ne9y37gDXPa6tRAlLAp.jpg","genres":["ужасы","триллер"],"overview":"Картик работает на политика из Варангала по имени Тиллу, но его жизнь принимает неожиданный оборот после того, как он встречает Аарадхану, начинающую спортсменку, и решает сблизиться с ней. Однажды Тиллу даёт Картику посылку с просьбой сохранить её в целости и сохранности. Решив, что запертый дом Аарадханы - самое безопасное место, пока её нет, он прячет посылку там. Вернувшись, он обнаруживает, что Аарадхана и её мать убиты. Потрясённый и полный решимости найти ответы, Картик объединяется с полицейским Раной Пратапом, чтобы выяснить, кто стоит за убийствами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1556503","ru":"Чёрная змея","en":"검은뱀","year":"2025","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gAzoz2sE3ZQOtCMf32ZrYFWEwkG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/DjHTSTGylwbKJFPSAo09z2P7rE.jpg","genres":["криминал","боевик"],"overview":"Тэ Щик — наёмный убийца, работающий на банду. Но после смерти их босса группировка разваливается, и в борьбе за власть убивают ближайшего товарища Тэ Щика — Гисона. Гисон был для него как старший брат, поэтому Тэ Щик клянётся отомстить. С помощью продажного копа Тэ Щик знакомится с женщиной по имени Меа. Она даёт ему зацепки по делу об убийстве, и во время поисков между ними возникает связь. Однако Меа начинает задавать слишком много вопросов и привлекает внимание тех, кому это совсем не нравится — её жизнь оказывается под угрозой. Теперь Тэ Щик должен спасти её, прежде чем будет слишком поздно.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1302106","ru":"Телохранитель Хонэко Акабанэ","en":"赤羽骨子のボディガード","year":"2024","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/6NcYPlUSJq49i1Rp3OfVLUdwBTY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1gkC1eX7bg4hPIijgTJS3qVW5vS.jpg","genres":["боевик","комедия","мелодрама"],"overview":"У них есть только одна цель — убить Хонеко Акабане! Однажды Аракуни Ибуки узнает, что его подруга детства, Хонеко Акабане, стала целью убийц! Они оба учатся в классе в старшей школе Сосодзи, и Ибуки приказано защищать Акабане в течение года. Его цель — обеспечить ее благополучное окончание школы, но он должен сделать это так, чтобы она этого не осознала. И так начинается его тайная жизнь телохранителя в школе. Однако, похоже, в «классе 3-4» есть еще больше секретов...?!.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"948190","ru":"Легкая работёнка","en":"Nghề Siêu Dễ","year":"2022","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lTcobSSAYpMiGTgHk3iDttsaX9T.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1BpBf5b6TVOpyGLKv3KT05A5ro8.jpg","genres":["комедия"],"overview":"История об отставном полицейском и мошенниках, живущих по соседству, которые открывают ресторан, чтобы следить за криминальным авторитетом. Но выполнение миссии приводит к неожиданному результату.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1427830","ru":"Тайный этаж","en":"Das geheime Stockwerk","year":"2026","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/zhD6viTw23iStiBZmFdFj0uB9sR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rTGgxZ0ZOmXZmhQYgvtI41kLhYX.jpg","genres":["драма"],"overview":"История 12-летнего Карли, способного путешествовать во времени на старом лифте отеля, переносит его в Европу 1938 года и поднимает темы памяти, дружбы и личного выбора на фоне надвигающихся исторических потрясений.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"298846","ru":"Держись от него подальше","en":"Don't Date Brandon","year":"2025","type":"Сериал","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/5D1y0RqzeXdSc2kmT8cdJCwezDi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zcDMJQKr63b9dXVRZyItqj1cbqt.jpg","genres":["Реалити-шоу","документальный"],"overview":"Эмбер знакомится по интернету с Брэндоном, и ей он кажется самым прекрасным, нежным и заботливым человеком на свете. Она почти готова выйти за него замуж, но внезапно появляется бывшая жена Брэндона, Афина, и всё переворачивается с ног на голову. Вместе они узнают, что за прекрасным фасадом скрывается профессиональный манипулятор и лжец. Подруги по несчастью запускают совместный подкаст и вскоре находят множество жертв Брэндона.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"686118","ru":"Мы не пауков трахать пришли","en":"We're Not Here to Fuck Spiders","year":"2020","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lTcyp2veEKuQtWxVFd3hdgT3Tec.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uaZQQm3RnzmpRgy5e4jW7YhvJ5t.jpg","genres":["криминал","триллер"],"overview":"В начале 2018 года в интернете появились анонимные видеозаписи, состоящие из тысяч часов съемок скрытой камерой. Из этих записей был составлен данный фильм о наркоторговце Энтоне Бёрджере, его девушке и заложнице Эффс, его сообщниках, байкерах и грязных копах.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1669057","ru":"Check-In","en":"Check-In","year":"2026","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/r7tXZoO3rfkOpYQPCXftwugwny9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wspOfgFVJde2jjD4vlIqy5Jc3yy.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"155213","ru":"麻花特开心","en":"麻花特开心","year":"2022","type":"Сериал","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/as6d7ok94aSH7dc8Sc4whjpCEgL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pf7iBEt2xBg0Oorer5ExedOlSxd.jpg","genres":["Реалити-шоу","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1518247","ru":"ஹேப்பி ராஜ்","en":"ஹேப்பி ராஜ்","year":"2026","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8hmB6KNUFFzChYJxngIp063H2YR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fug20H3qffP941XVDJCnpY61GVn.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"793602","ru":"애첩","en":"애첩","year":"2020","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gGyQhfdqw9saOAlYHz4sxJO9Ot.jpg","backdrop":"https://image.tmdb.org/t/p/w780/u7mhBnMlTq9KTWAeY2isBAbeXPI.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1553949","ru":"醉刀客","en":"醉刀客","year":"2025","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/6FaWQH639tVJHJKkbNmLOWR1ccD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qOZ50hOHEyY7WgxIrCfQWXIykKH.jpg","genres":["боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1607088","ru":"熊出没·年年有熊","en":"熊出没·年年有熊","year":"2026","type":"Мультфильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/