rg/t/p/w342/mexUwJezxZxndrKxz5RXr6WsRqv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nCwomejOnMH0aznw3QS6rh4SESj.jpg","genres":["Драма","Комедия","Криминал","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"31283","ru":"Mommy XXX","en":"Mommy XXX","year":"2009","type":"Сериал","rating":3.5,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/j6Rr6VvjbLm3IrrufoK5u7uYKYj.jpg","backdrop":"","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"489013","ru":"Максимальный удар","en":"Максимальный удар","year":"2017","type":"Фильм","rating":3.5,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/gT0upYop2wMSVtFqncNMnnKscCD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/IIEIystX8p4uBFOXU1BGsyIrqk.jpg","genres":["Боевик","Комедия"],"overview":"Лучшим агентам ФСБ и ЦРУ предстоит совместная миссия — остановить преступного лидера, похитившего внучку госсекретаря США, который прибыл в Москву с тайным визитом. Государственный секретарь Соединенных Штатов Америки тайно прибывает на закрытые переговоры в Москву, с целью уладить растущую напряженность отношений между странами. Чтобы сорвать переговоры и подставить российскую сторону, лидер влиятельной преступной группировки организует покушение на американскую делегацию и похищает внучку государственного секретаря. И теперь лучшим сотрудникам ФСБ и ЦРУ предстоит приложить максимум усилий, чтобы спасти похищенную девушку и предотвратить международный конфликт, способный перерасти в настоящую войну.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"516604","ru":"Hell Trip","en":"Hell Trip","year":"2018","type":"Фильм","rating":3.5,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/mq5uw4yXoOitDAKQ6TWAe1Uli4S.jpg","backdrop":"","genres":["Ужасы","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"243754","ru":"Love Island: All Stars","en":"Love Island: All Stars","year":"2024","type":"Сериал","rating":3.5,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/eMQYbtPpoGUcRJtYus7jJcvXKY5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k6wUi9v3EzNaP07Ff2DtfNO5z2e.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"514755","ru":"Операция «Вторжение»","en":"Crossbreed","year":"2019","type":"Фильм","rating":3.5,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/azu9K63NBYoJ9dMg0j1knbqshXk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/13kPaB6tNtzWL64FP6o74CxA0gG.jpg","genres":["Фантастика"],"overview":"В ближайшем будущем человечество вступило в контакт с инопланетянами, Луна стала обитаемой, но большинство людей продолжают жить на Земле. Эллен Хенриксен, президент Новых Соединенных Штатов Америки, отправляет спецкоманду во главе с Адамом Рикером добыть секретное биологические оружие пришельцев. Объект находится в хорошо защищенном исследовательском центре на орбите планеты, поэтому опытным наемникам предстоит тайно проникнуть на станцию, чтобы выкрасть его. Операция идет по плану до тех пор, пока биологическое оружие не вырывается на свободу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"348523","ru":"Black Mass of the Nazi Sex Wizard","en":"Black Mass of the Nazi Sex Wizard","year":"2015","type":"Фильм","rating":3.5,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/48LhUdGOmRalmvrMj9JXhrWJgtU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j8zt9SQqVUHIY3sM0sBzFUXF3sE.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"525989","ru":"Тайна моего врага","en":"A Dark Foe","year":"2021","type":"Фильм","rating":3.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/rNLUwhhsxSTD4PaKY9fSZLvYLSk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qgG8VWmf95hfSngVU7Gfe3y8LV2.jpg","genres":["Криминал","Триллер","Драма","Ужасы"],"overview":"Тони был совсем ребенком, когда серийный маньяк по кличке «Колыбель» убил его мать и похитил сестру. Мальчик прятался под половицами и навсегда запомнил лицо этого страшного человека. Спустя годы он становится агентом ФБР, в надежде поймать убийцу. Но охваченный местью и злобой он совершает одну ошибку за другой и кажется уже никогда не разгадает тайну своего врага.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1005004","ru":"Murdercise","en":"Murdercise","year":"2023","type":"Фильм","rating":3.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/7Y8gsd4JP13Y3N8LbdFB9Vole32.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ph4UQYl587xyaNj5i9YqCYTeSmU.jpg","genres":["Ужасы","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"419386","ru":"Besetment","en":"Besetment","year":"2017","type":"Фильм","rating":3.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/vTOR38A4bAZw8n5hjr8VCeApDh2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6csrGe78t7H5xSpQYgKmYV66j8A.jpg","genres":["Триллер","Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"277353","ru":"Campus Code","en":"Campus Code","year":"2015","type":"Фильм","rating":3.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/lQUc3gKozAz7YP9iKKNHYrSF7sC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6AngeKlHAjMV50ET6LksddQPDjT.jpg","genres":["Боевик","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"768439","ru":"Erotica 2022","en":"Erotica 2022","year":"2020","type":"Фильм","rating":3.5,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/23Cjq0zQEH53fgHmCXxbZsBwhVN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xPg09JOcjHTIXzOYD8YJI7rdrdA.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"296138","ru":"Исчезновение Ленки Вуд","en":"The Disappearance Of Lenka Wood","year":"2014","type":"Фильм","rating":3.5,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/3ILQcMSZx2Dbbo9qiuymKQ2duQo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ciOD5NUMcRq5fOHCaLubtlsRnAK.jpg","genres":["Криминал"],"overview":"Сыграв свадьбу, молодожены Декстер и Ленка Вуд из Нью-Йорка отправляются в Турцию, чтобы провести там незабываемый медовый месяц. Поначалу их отдых действительно великолепен, однако через несколько дней Ленка становится жертвой похищения. Её супруг, в прошлом бывший военным, видя беспомощность местной полиции, лично берется за поиски девушки. Чтобы вернуть её живой Декстеру придется действовать быстро и жестко.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"812666","ru":"This Game's Called Murder","en":"This Game's Called Murder","year":"2021","type":"Фильм","rating":3.5,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/8KtkNgOgluMF6ynBC5YZT3kLeXA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3EO8O7t9BI1PiKSGpN1RzEmQdhJ.jpg","genres":["Триллер","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"966436","ru":"Suicide for Beginners","en":"Suicide for Beginners","year":"2022","type":"Фильм","rating":3.5,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/2zlsj82Rcm4gaPkpNijLsnwRODv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b8QddgsYFOOvct7dR8YQVRHTD1m.jpg","genres":["Комедия","Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1239468","ru":"Death Streamer","en":"Death Streamer","year":"2024","type":"Фильм","rating":3.5,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/jPv8841K4WXXntdci0js51qHzbX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eyFUEYbUASMpn4HjC9BdWhEtE2v.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"858073","ru":"அரண்மனை 3","en":"அரண்மனை 3","year":"2021","type":"Фильм","rating":3.5,"votes":14,"