едолгий роман рушится, когда Харпер депортируют обратно на родину в Канаду. Не желая вступать в брак, Росс решает найти фиктивного мужа, чтобы Харпер смогла снова вернуться в страну.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1181692","ru":"War of the Worlds: Extinction","en":"War of the Worlds: Extinction","year":"2024","type":"Фильм","rating":3.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/tRLTw0bWIoHmgaEMk3UxoUTp5w.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o73XAJXpWc14c4INBSqByDxzGu9.jpg","genres":["Фантастика","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"671474","ru":"Bone Breaker","en":"Bone Breaker","year":"2020","type":"Фильм","rating":3.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/ycEeSBcV4jmT0Yf8ERPLtcD58RJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6biZG7JVNlOnHytx5YNJEAQmMyp.jpg","genres":["Ужасы","Триллер","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1075316","ru":"Vacation Home Nightmare","en":"Vacation Home Nightmare","year":"2023","type":"Фильм","rating":3.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/o7w9tDt8kRsI4QvCrjuMnrkRMgp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8AYOf3yCrJ9EFNNd7Q6jDfy0rkX.jpg","genres":["Телевизионный фильм","Триллер","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}