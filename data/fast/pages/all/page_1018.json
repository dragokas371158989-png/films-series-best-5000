kdrop":"https://image.tmdb.org/t/p/w780/gWiK8x02BJdugUtTc02i3QHqz97.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"11477","ru":"Alcoa Theatre","en":"Alcoa Theatre","year":"1957","type":"Сериал","rating":7.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/uiaO4sVZbx4SJqJWdnDnNHO8HS2.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1226221","ru":"Danganronpa 3: The End of Kibougamine Gakuen","en":"Danganronpa 3: The End of Kibougamine Gakuen","year":"2016","type":"Мультфильм","rating":7.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xnkq0L0R4EFaKGUVJ3EcchHWJyD.jpg","backdrop":"","genres":["мультфильм","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"258100","ru":"Approaching the Elephant","en":"Approaching the Elephant","year":"2015","type":"Фильм","rating":7.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/snCY9DCjRAXDyhpl5sNl9x1THX3.jpg","backdrop":"","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"286236","ru":"野原ひろし 昼メシの流儀","en":"野原ひろし 昼メシの流儀","year":"2025","type":"Аниме","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/gN7Gjcsl46mP6Ed6bB95MusL2CL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j592xliqROmfMH6lMDzwrupWP7E.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"298629","ru":"Преемник: зов предков","en":"Halef: Köklerin Çağrısı","year":"2025","type":"Сериал","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/sQTx2hiwi9CmRYyt6CAV5sf8C1T.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nprBdtryh9CHTApmMhv72vfAjsi.jpg","genres":["драма"],"overview":"Серхат — успешный хирург, который много лет назад покинул отчий дом. Втайне от семьи он женился на любимой девушке Мелек и каждый день наслаждается своей счастливой семейной жизнью. Однажды Серхату поступает звонок из Урфы и мужчина вынужден оставить работу и жену, и вернуться на родину. Приехав домой, он узнает, что многолетняя кровная вражда истощила его семью и остановить кровопролитие сможет лишь религиозный брак, который Серхат должен заключить с Йылдыз. Оказавшись в безвыходной ситуации, мужчина соглашается. Мелек, приехавшая к мужу узнает, что у него появилась вторая супруга, а тем временем сам Серхат погружается в мрачные тайны своей семьи и особняка, в котором он живет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"286702","ru":"Женский ад","en":"Piekło kobiet","year":"2026","type":"Сериал","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/z4ulMbC7yUH84u4ZOgZp8cxWQJc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pErnzuGAqpSTMOaU9fxB4Is981z.jpg","genres":["драма","криминал","детектив"],"overview":"В 1930-х годах редактор журнала знакомств обнаруживает, что газета ее мужа может быть связана с загадочной смертью молодой танцовщицы. По мере того, как она пытается раскрыть правду, ее мир необратимо меняется, и даже малейшая ошибка может стоить ей жизни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"974397","ru":"Моя чудная семейка","en":"My Freaky Family","year":"2024","type":"Мультфильм","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/wPudEOa1KsFRK4O9ayJNmmaXa0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qDAvAUsnRrvkFO5EtNq1XFfyYTL.jpg","genres":["мультфильм","семейный","фэнтези"],"overview":"Бетти — обычная школьница, которая любит гулять с друзьями и играет в музыкальной группе. Но ее большая и дружная семья немного… чудная. Мама, папа и брат обладают магией и творят чудеса. Собака вообще разговаривает и спорит со всеми. Однажды Бетти узнает удивительную тайну. Оказывается, только она может спасти мир от злого колдуна, и для этого ей надо разучить и сыграть старинную песню, ноты которой надежно спрятаны.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"579821","ru":"Аманат","en":"Аманат","year":"2022","type":"Фильм","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/4xcwIJzhYVsttdSIkRCOiPKRp0C.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hVLdQj0kUJQxQ8vhVnjKqzSrnwM.jpg","genres":["драма","история"],"overview":"История любви сына имама Шамиля Джамалутдина и Лизы Олениной на фоне драматических событий военной истории России первой половины XIX века. Джамалутдин вошёл в историю как «великий заложник», и фильм — это попытка ответить на вопрос: заложник большой политики или большой любви. Исторический контекст заката Николаевской эпохи, на фоне которого разворачивается история о любви и предательстве, чести и долге, служении отчизне и верности данному слову станет ключевым для фильма.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"273415","ru":"Karşılaşmalar","en":"Karşılaşmalar","year":"2024","type":"Сериал","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/pN9MvNB69jiy9Q54LU7CexGW8pI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Ascg3JHKijCTqHraSkWEdGF1ixR.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1233655","ru":"Omaha","en":"Omaha","year":"2025","type":"Фильм","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/s1SNVyTWWmvpWK439bOrRF9xywS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rf8V9z28gJre58U9ObHN3NJph4A.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"224260","ru":"風間公親－教場0－","en":"風間公親－教場0－","year":"2023","type":"Сериал","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/dizt74h55byxyWIW2LRAGzOVGW3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a8cTpeK3lUN4s4AaUiqLOEwxC3g.jpg","genres":["драма","детектив","криминал"],"o