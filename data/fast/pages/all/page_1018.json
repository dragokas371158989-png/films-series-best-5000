.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xnkq0L0R4EFaKGUVJ3EcchHWJyD.jpg","genres":["мультфильм","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"258100","ru":"Approaching the Elephant","en":"Approaching the Elephant","year":"2015","type":"Фильм","rating":7.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/snCY9DCjRAXDyhpl5sNl9x1THX3.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"286236","ru":"野原ひろし 昼メシの流儀","en":"野原ひろし 昼メシの流儀","year":"2025","type":"Аниме","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/gN7Gjcsl46mP6Ed6bB95MusL2CL.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"298629","ru":"Преемник: зов предков","en":"Halef: Köklerin Çağrısı","year":"2025","type":"Сериал","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/sQTx2hiwi9CmRYyt6CAV5sf8C1T.jpg","genres":["драма"],"overview":"Серхат — успешный хирург, который много лет назад покинул отчий дом. Втайне от семьи он женился на любимой девушке Мелек и каждый день наслаждается своей счастливой семейной жизнью. Однажды Серхату поступает звонок из Урфы и мужчина вынужден оставить работу и жену, и вернуться на родину. Приехав домой, он узнает, что многолетняя кровная вражда истощила его семью и остановить кровопролитие сможет лишь религиозный брак, который Серхат должен заключить с Йылдыз. Оказавшись в безвыходной ситуации, мужчина соглашается. Мелек, приехавшая к мужу узнает, что у него появилась вторая супруга, а тем временем сам Серхат погружается в мрачные тайны своей семьи и особняка, в котором он живет.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"286702","ru":"Женский ад","en":"Piekło kobiet","year":"2026","type":"Сериал","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/z4ulMbC7yUH84u4ZOgZp8cxWQJc.jpg","genres":["драма","криминал","детектив"],"overview":"В 1930-х годах редактор журнала знакомств обнаруживает, что газета ее мужа может быть связана с загадочной смертью молодой танцовщицы. По мере того, как она пытается раскрыть правду, ее мир необратимо меняется, и даже малейшая ошибка может стоить ей жизни.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"974397","ru":"Моя чудная семейка","en":"My Freaky Family","year":"2024","type":"Мультфильм","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/wPudEOa1KsFRK4O9ayJNmmaXa0.jpg","genres":["мультфильм","семейный","фэнтези"],"overview":"Бетти — обычная школьница, которая любит гулять с друзьями и играет в музыкальной группе. Но ее большая и дружная семья немного… чудная. Мама, папа и брат обладают магией и творят чудеса. Собака вообще разговаривает и спорит со всеми. Однажды Бетти узнает удивительную тайну. Оказывается, только она может спасти мир от злого колдуна, и для этого ей надо разучить и сыграть старинную песню, ноты которой надежно спрятаны.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"579821","ru":"Аманат","en":"Аманат","year":"2022","type":"Фильм","rating":7.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/4xcwIJzhYVsttdSIkRCOiPKRp0C.jpg","genres":["драма","история"],"overview":"История любви сына имама Шамиля Джамалутдина и Лизы Олениной на фоне драматических событий военной истории России первой половины XIX века. Джамалутдин вошёл в историю как «великий заложник», и фильм — это попытка ответить на вопрос: заложник большой политики или большой любви. Исторический контекст заката Николаевской эпохи, на фоне которого разворачивается история о любви и предательстве, чести и долге, служении отчизне и верности данному слову станет ключевым для фильма.","source":"tmdb","tmdbId"