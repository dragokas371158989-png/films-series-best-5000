{"tab":"all","page":911,"pages":1604,"count":96213,"pageSize":60,"items":[{"id":"476476","ru":"Carte Blanche","en":"Carte Blanche","year":"2019","type":"Фильм","rating":8.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/nufMJDBY48n6tjwu8nlv8aapI8O.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hArIZYslq4jTr71oYlTgdqGXCJs.jpg","genres":["триллер","детектив"],"overview":"Кацпер, учитель истории, которого очень любят ученики, начинает постепенно терять зрение. Диагноз врачей не оставляет надежды. Мужчине грозит слепота. Он решает скрыть это от окружающих, чтобы сохранить работу и довести до выпускных экзаменов своих учеников.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1624429","ru":"قایق‌سواری در تهران","en":"قایق‌سواری در تهران","year":"2026","type":"Фильм","rating":8.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/bP1PNFgmo7wIWniiwVAm5pFuHF.jpg","backdrop":"","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1479498","ru":"Zico: O Samurai de Quintino","en":"Zico: O Samurai de Quintino","year":"2026","type":"Фильм","rating":8.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/jKnQxfKsvKLUBcznDi5OOQdrPtG.jpg","backdrop":"","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"591397","ru":"Doki Doki ヴァージン もういちど I LOVE YOU","en":"Doki Doki ヴァージン もういちど I LOVE YOU","year":"1990","type":"Фильм","rating":8.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/91GirQ8WcI54tHmwGMbuSKga960.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dUOPtAM53APne0LUhJlKlIT7QUU.jpg","genres":["мелодрама","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"99839","ru":"Siya Ke Ram","en":"Siya Ke Ram","year":"2015","type":"Сериал","rating":8.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/xtv6zbhZZ7Lq87IfSJ3g18a6s25.jpg","backdrop":"https://image