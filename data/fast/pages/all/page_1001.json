медия","мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"442887","ru":"The Marx Brothers: Hollywood's Kings of Chaos","en":"The Marx Brothers: Hollywood's Kings of Chaos","year":"2016","type":"Фильм","rating":7.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/17s8ufbfn7rj6GzPxs8jPNScFDI.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"499752","ru":"悪と仮面のルール","en":"悪と仮面のルール","year":"2018","type":"Фильм","rating":7.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/2OETtumSlRxUVwxwBXsJdzTj7LP.jpg","genres":["детектив","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"633783","ru":"エキストロ","en":"エキストロ","year":"2019","type":"Фильм","rating":7.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/keBOg6qEEwtMqRr91Kv5LqnrNAB.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"365887","ru":"The Plausible Impossible","en":"The Plausible Impossible","year":"1956","type":"Мультфильм","rating":7.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/tvjDdTVxNaGWjCXlKocNB8xgV7e.jpg","genres":["документальный","телевизионный фильм","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448687","ru":"Человечка нарисовал я","en":"Человечка нарисовал я","year":"1960","type":"Мультфильм","rating":7.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ArKzVO7pyLhY8wtSxGlLkBdb8Q.jpg","genres":["мультфильм","семейный"],"overview":"1 сентября. В школу самый первый пришёл мальчик Федя. В пылу радости Федя нарисовал углем на белой стене маленького весёлого человечка в шляпе и с зонтиком. На уроке учитель заметил человечка и спросил, кто нарисовал его, но Федя, испугавшись наказания, промолчал, и когда учитель попросил учеников поднять руки, Федя перед этим потихоньку вытер их, а его друг, с которым тот поздоровался в классе, ничего не подозревая, поднял испачканную углём руку и попался. Когда Федя, никому ничего не сказав, пошёл домой, возмущённый его поступком нарисованный человечек ожил и пошёл вслед за мальчиком, чтобы серьёзно с ним поговорить. Однако Феде нравится быть врунишкой, и он отзывается на предложение радио отправится в волшебное царство лжи, где правит королева-обманщица. Человечек отправляется Феде на помощь... В итоге, после приключений в поисках правды, Федя нашёл в себе силы произнести признание, давшее название фильму.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"342016","ru":"Our Friend the Atom","en":"Our Friend the Atom","year":"1957","type":"Мультфильм","rating":7.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/j9Eqq4s9qSzS9hGZOrWo83AffNy.jpg","genres":["мультфильм","документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"382466","ru":"Адский учитель Нубэ: Фильм 3","en":"地獄先生ぬ～べ～ 恐怖の夏休み！妖しの海の伝説","year":"1997","type":"Мультфильм","rating":7.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/tTZFzLII8mCEZIIASOgpN2vdvvJ.jpg","genres":["мультфильм","ужасы","фэнтези","приключения"],"overview":"Отправившись на маленький остров чтобы отдохнуть, Нубэ и его ученики встречают старого дедушку, который рассказывает им тайную легенду об этом острове. Якобы в море, что вокруг этого острова, живет паук, который каждые 200 лет превращается в страшного монстра, пожирающего людей. Вскоре после этого, ребята обнаруживают на пляже невероятно обаятельную маленькую девушку, которая сразу понравилась всей компании. Однако, через некоторое время начинают происходить странные и опасные события. Похоже, что легенда о морском чудище совсем не выдумка…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"37030","ru":"Именем закона","en":"Im Namen des Gesetzes","year":"1994","type":"Сериал","rating":7.2,"vot