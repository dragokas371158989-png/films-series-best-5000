WgB4Rjk2jELgMOwaJgFcUGvz.jpg","genres":["мультфильм","комедия","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"284512","ru":"玉茗茶骨","en":"玉茗茶骨","year":"2025","type":"Сериал","rating":8.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/emQR37pN4UluVbq7pGoMjXOAKX6.jpg","genres":["детектив","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"299395","ru":"Cocaine Quarterback: Signal-Caller for the Cartel","en":"Cocaine Quarterback: Signal-Caller for the Cartel","year":"2025","type":"Сериал","rating":8.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/zPDW51LSuzOndvVrgKQMMkFnaII.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"409069","ru":"The Fall","en":"The Fall","year":"2016","type":"Фильм","rating":8.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/qz6FXPDobOutDB2bmjupjFtCxmJ.jpg","genres":["документальный"],"overview":"Психологический триллер, рассказывающий о жизни двух охотников. Один из них - серийный убийца, а другой - талантливый детектив-женщина, старающаяся поймать первого. Действие разворачивается в городе Белфаст в Северной Ирландии. Местное население здесь терроризирует серийный убийца, и городская полиция никак не может вычислить этого маньяка. Детектив Стелла Гибсон берется разобраться в этом загадочном мрачном деле.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"230318","ru":"Открытый брак","en":"Открытый брак","year":"2023","type":"Сериал","rating":8.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/rFcLOQnqA4lUUo2hxvtkEj6tby7.jpg","genres":[],"overview":"Севе и Оксане за сорок. У них трое детей, большая квартира в центре Москвы, у обоих сложившиеся карьеры. Завидная жизнь, они — образцовая пара. Оказавшись в гуще мелких конфликтов, накопившихся претензий и низкой самооценки, Оксана изменяет Севе впервые за 20 лет брака и… признаётся в этом мужу. Вместо неизбежной драмы Оксана предлагает Севе попробовать… открытый брак. Сева неохотно, но соглашается, ведь он сам уже давно живёт двойными стандартами, у него есть любовница — учительница его младшего сына. В конце концов, для него это win-win. Супруги ступают на неизведанную территорию открытого брака — здравствуй, свобода!","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1590907","ru":"Ein Sommer in Italien - WM 1990","en":"Ein Sommer in Italien - WM 1990","year":"2026","type":"Фильм","rating":8.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/kJAxNDBp3SdHLtWUagQ5LOlyyWi.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1517874","ru":"Noviembre","en":"Noviembre","year":"2025","type":"Фильм","rating":8.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/n3ajNbRXDbqUl5UpejM9e6cNYEH.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"749418","ru":"The Third Day: Autumn","en":"The Third Day: Autumn","year":"2020","type":"Фильм","rating":8.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/hkBgdgne69pjyDDF0QQ2yS8F8vC.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"46222","ru":"ゲゲゲの女房","en":"ゲゲゲの女房","year":"2010","type":"Сериал","rating":8.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/2f95ckWlSNV6yga4bIJRNsy3NtH.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"19389","ru":"我和殭屍有個約會","en":"我和殭屍有個約會","year":"1998","type":"Сериал","rating":8.5,"votes":8,"poster":"https://image.tmdb.o