untry":"","ageRating":""},{"id":"347091","ru":"Тайна тёмной комнаты","en":"Тайна темной комнаты","year":"2014","type":"Фильм","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/fr4sH1bIpmvRSYD5EJbtgemOCFj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nm6pxrbl8olyhlsUKalr68nUMAw.jpg","genres":["Приключения","Семейный","Фэнтези"],"overview":"Два школьника решают исследовать таинственное окно, появляющееся на стене их дома в полночь во время полнолуния. Проникнув туда и оказавшись в тёмной комнате, они и не подозревают, какие приключения ждут их впереди…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"6174","ru":"Isidingo","en":"Isidingo","year":"1998","type":"Сериал","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/hxJdczj4roJ9OtqSJcuAkD2TK6y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eXPYbOfQ6YRgqgnsXTTEIL1clRs.jpg","genres":["Мыльная опера","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"92661","ru":"25 Words or Less","en":"25 Words or Less","year":"2018","type":"Сериал","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/gwu2aVl89amkSfBL5TqhvazYQAE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zi7hR8mfpApWoj3N3poBsJW9uxL.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"383","ru":"Cain's Hundred","en":"Cain's Hundred","year":"1961","type":"Сериал","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/gF52PA0wga7Cl5VWcjZ3wVVYTg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3IPbuOFNBv3A4ygYHTItlxVgeMl.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"73340","ru":"De Vuelta al Barrio","en":"De Vuelta al Barrio","year":"2017","type":"Сериал","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/po1FbSe2OtVz1w6r4vU8a3Tf6z6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8x