я между давлением рациональных родителей, решительно настроенных отправить дочь учиться на юриста, и своими мечтами о поступлении в Академию художеств в Петербурге. Поверить в себя и пойти на риск ей помогает новенький одноклассник, одаренный музыкант Игорь. Молодые люди влюбляются друг в друга. Спустя годы Наташа и Игорь случайно встречаются на выставке ее картин. Это возвращает их к воспоминаниям о той поре, когда они были счастливы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1700112","ru":"Policiaco Sin Crimen","en":"Policiaco Sin Crimen","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/jA5n1tyhQ6hnsZaaEXdsGbnMM5Z.jpg","genres":["триллер","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1695285","ru":"Therachaapa","en":"Therachaapa","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/hsIxklcJ3FM4L3Vu30F502fA79u.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1666501","ru":"La fête de la chanson française - 20 ans d'émotions","en":"La fête de la chanson française - 20 ans d'émotions","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/1rJGGdHB4xa4C1GlHBJhtD32K3S.jpg","genres":["музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1610585","ru":"Call Time","en":"Call Time","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/vzPUu6jwUaTzn1uuQweOhrNNitt.jpg","genres":["комедия","документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1377081","ru":"Slowburn Shoot: An Indie Wrestling Story","en":"Slowburn Shoot: An Indie Wrestling Story","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/7tK3C42B8WVAj24J5ij0MM