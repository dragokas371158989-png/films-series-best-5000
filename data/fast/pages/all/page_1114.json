ps://image.tmdb.org/t/p/w780/fHVv1DLfdKAZfcv6a2hIbZWytlH.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1301312","ru":"Darkwing Duck: Darkly Dawns The Duck","en":"Darkwing Duck: Darkly Dawns The Duck","year":"1991","type":"Мультфильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2ugzajtl0rHtCCBBra183RbHmds.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kVhUCvCqlPiaUZGfJxOmy0f2SB1.jpg","genres":["Мультфильм","Боевик","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"243230","ru":"Икар Монгольфье Райт","en":"Icarus Montgolfier Wright","year":"1962","type":"Мультфильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/d1fjnD3M4pqYlzo0EkzFaYCFVIG.jpg","backdrop":"","genres":["Фантастика","Мультфильм","Драма"],"overview":"Анимационная экранизация одноименного рассказа Рэя Брэдбери (1956), классика научной фантастики. «Икар Монгольфье Райт» — полностью рисованный мультфильм, созданный с помощью акварельных красок. Давний друг Брэдбери, иллюстратор Джозеф Маньяни, работал над экранизацией бесплатно, сотворив за год сотни цветных акварелей. Сюжет мультфильма рассказывает о пилоте ракеты, Джедедии Прентисе. Он набирается сил перед ответственным полетом на Луну. Во сне Прентис вспоминает знаменитые полеты в истории человечества, представляя себя то мифическим Икаром, то одним из братьев Монгольфье, изобретателей воздушного шара, то одним из братьев Райт — создателей самолета. Ощущая извечную жажду полета, Прентис предвкушает победу над силой притяжения Земли.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"495419","ru":"El modelo de Pickman","en":"El modelo de Pickman","year":"2014","type":"Мультфильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2LM7DG3jyxcipglsdFNiNEEYj9S.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g52Iwi5tzyT2xEGmCJcLjM2240F.jpg","genres":["Мультфильм","Фэнтези","Ужасы","Детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"3150","ru":"Texas","en":"Texas","year":"1980","type":"Сериал","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/nE2hcsuEaOYkLgbaQTDExJDObWH.jpg","backdrop":"","genres":["Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"216931","ru":"Crying フリーマン3 比翼連理","en":"Crying フリーマン3 比翼連理","year":"1990","type":"Мультфильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/AiWiAtiFhws4DoNUDsVCxzT7YD.jpg","backdrop":"","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"404110","ru":"Savannah Sunrise","en":"Savannah Sunrise","year":"2016","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/9U9eswnqSFectcAnNYlWOUdf0T6.jpg","backdrop":"","genres":["Комедия","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"903954","ru":"Бибо спасает Pождество","en":"Beebo Saves Christmas","year":"2021","type":"Мультфильм","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/177Jlgh6fEUCn49gXLWcDux0q3F.jpg","backdrop":"https://image.tmdb.org/t/p/w780/x93yY230XDxbNs9KRjDfd8LzvSh.jpg","genres":["Мультфильм","Приключения","Телевизионный фильм"],"overview":"Одержимый эльф Спринклз решает, что Рождество будет проходить лучше без Санта Клауса. Бибо и его друзья отправляются на Северный полюс, чтобы спасти Санта-Клауса и понять, почему Рождество является столь значимым праздником для всех.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"999602","ru":"Тайный Санта","en":"Тайный Санта","year":"2022","type":"Фильм","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/wR2VuYMxKLrAW1DF6YRwZOHu7F8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/A73tcsaqr0Kt71ol9of7hE6AoiI.jpg","genres":["Комедия"],"overview":"Юрист Светлана Соколова работает в компании Максима с самого основания и столько же времени они терпеть друг друга не могут. Максим давно бы избавился от Светланы, но понимает, что найти ей замену не так–то просто. Светлана в этот Новый год собирается, наконец, устроить свою личную жизнь. В коллективе решено провести вручение подарков от \"Тайного Санты\", и Светлана запланировала поездку на базу отдыха для себя и Стаса – сотрудника, который ей нравится, но все никак не сделает первый шаг. Однако все идет не по плану и приглашение достается… Максиму. Светлана и хотела бы сбежать, но Максим намерен как следует отдохнуть, а она, в свою очередь, принимает решение испортить ему праздник.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299365","ru":"신입사원 강회장","en":"신입사원 강회장","year":"2026","type":"Сериал","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ryoklqf5Xi76b1Cqb0h4I7zL6qa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nwbUawKqJOSXg1nR86fQzmxtVfv.jpg","genres":["Драма","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278868","ru":"方圆八百米","en":"方圆八百米","year":"2026","type":"Сериал","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/oj688ZRAnYQrcqk59euex7laL10.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cA8pX6GhKBvgdo1tAiyetEMDMCk.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1404155","ru":"パリピ孔明 THE MOVIE","en":"パリピ孔明 THE MOVIE","year":"2025","type":"Фильм","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/esxaA0t1WYuNibobLWVf2Iy7Zi8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2tyy6oMYznZiG3c829PiE6liEt7.jpg","genres":["Музыка","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"777637","ru":"Dirty Hari","en":"Dirty Hari","year":"2020","type":"Фильм","rating":6.4,"votes":4,"poster":"h