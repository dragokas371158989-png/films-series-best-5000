о старый отец умер, Иван единственный из троих сыновей выполнил его просьбу и три дня посещал отцовскую могилу. За это ему открылась тайна волшебного коня Сивки-Бурки, который может сделать Ивана прекрасным молодцем. Тем временем, царь решил выдать замуж свою дочь-царевну за того, кто поцелует ее, допрыгнув до высокого терема.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1707880","ru":"Dire Dryer","en":"Dire Dryer","year":"2027","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/aVawozhUbK8lmS28anNexcjTEsO.jpg","genres":["мультфильм","боевик","семейный","ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1542704","ru":"Datura Ultra","en":"Datura Ultra","year":"2027","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/9WH03byGyah6BTMZvDHQnwiNp3E.jpg","genres":["драма","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1595911","ru":"Puro R.A.P.","en":"Puro R.A.P.","year":"2027","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/k1SJr0mGRSWM8MluMrtRInCwG37.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1650060","ru":"Battle Pass","en":"Battle Pass","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/hLSAEwZjGB5hUTomwLWiCIFEE6y.jpg","genres":["документальный","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1574526","ru":"Shush, Now","en":"Shush, Now","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/85nk536PEwNJwP9iwQOnDQvnQhm.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":