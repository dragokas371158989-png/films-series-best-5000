онарду Фуртадо , пропавшую внебрачную дочь, единственным наследником. Леонарда Фуртадо, известная как Нана, с помощью своего друга Жеронимо Мачадо , известного как Жеже, использует уловки, чтобы выжить и продолжить учебу своей дочери Даниэлы в Швейцарии, которую она не видела более десяти лет. Нана забирает домой брошенных несовершеннолетних, которых подбирает на улице. Несмотря на то, что живут аферами, Нана и Жеже хорошие люди. Она не знает, что унаследовала состояние.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1381388","ru":"Holiday Hold-Up","en":"Holiday Hold-Up","year":"2024","type":"Фильм","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/4sy0zaPxOtOhozn18UZCSuApjEi.jpg","backdrop":"","genres":["комедия","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"115718","ru":"Οι Συμμαθητές","en":"Οι Συμμαθητές","year":"2014","type":"Сериал","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1NEx95LN5HiP1ZYuWaGN1mTWwE5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1OIITGT38bMmvuYUtjBw6PTUxqY.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"512273","ru":"炎神戦隊ゴーオンジャー 10 YEARS GRANDPRIX","en":"炎神戦隊ゴーオンジャー 10 YEARS GRANDPRIX","year":"2018","type":"Фильм","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1cFNOR3Fz0AfikYLhmc8vkka9qC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/26SfTtCgdHweXF513O4xsK9VEl4.jpg","genres":["боевик","приключения","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"492077","ru":"Taraji's White Hot Holiday Special","en":"Taraji's White Hot Holiday Special","year":"2017","type":"Фильм","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/nUxYcnUpqqJnFL1D3Odor1fUIsZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s1d52IPzPyzV5B22FlzF4EyxMtN.jpg","genres":["музыка"],"overview":"",