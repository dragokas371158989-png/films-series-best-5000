":""},{"id":"307687","ru":"Les saisons","en":"Les saisons","year":"2025","type":"Сериал","rating":6.3,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/hasXj1vSq2FiUQHkJiWCVRziHAj.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"646696","ru":"Mariposa","en":"Mariposa","year":"2020","type":"Фильм","rating":6.3,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/8qj4jcx96vhPx64lhI4GQQdsEqu.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"230599","ru":"Moshi Monsters: The Movie","en":"Moshi Monsters: The Movie","year":"2013","type":"Мультфильм","rating":6.3,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/c2V629MAZQiMbwUsxQHVGzcOoTB.jpg","genres":["приключения","мультфильм","семейный","комедия","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1015869","ru":"スポチャン対決! 〜妖怪大決戦〜","en":"スポチャン対決! 〜妖怪大決戦〜","year":"2014","type":"Мультфильм","rating":6.3,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/URyRwDZZp3TiZbR7CVVh9e9SUd.jpg","genres":["драма","боевик","мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"251104","ru":"Ультрамен Арк","en":"ウルトラマンアーク","year":"2024","type":"Сериал","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/6QzEtEJgscZysGWn8jVwGDlE2zG.jpg","genres":["Боевик и Приключения","НФ и Фэнтези","Детский","драма"],"overview":"В безмятежном городке Хосимото, расположенном под тенью величественной горы Сисио, вырисовывается впечатляющее зрелище – колоссальный объект, известный как Монорог, рог кайдзю, появившийся после катастрофических событий 16-летней давности. Это ознаменовало одновременное появление кайдзю во всём мире, навсегда изменив ход истории. С того рокового дня Глобальные силы обороны бдительно борются с угрозами кайдзю, используя военную мощь, в то время как Научный центр по расследованию и предотвращению кайдзю SKIP усердно занимается научными исследованиями, стремясь предотвратить и смягчить последствия, связанные с кайдзю.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"727121","ru":"Хари Хара Вира Маллу: Часть 1","en":"హరి హర వీర మల్లు: భాగం 1 – Sword vs Spirit","year":"2025","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/mKM3yC7kepjfs8A723dqd9hOky8.jpg","genres":["боевик","приключения","драма"],"overview":"Действие фильма происходит в Индии эпохи Великих Моголов XVII века, в период огромных политических потрясений и борьбы за власть. В центре сюжета — главный герой, Хари Хара Вира Маллу (в исполнении Павана Кальяна), легендарный воин-герой, который грабил богатых, чтобы помочь бедным, — настоящий Робин Гуд. Столкнувшись с жестокостью могольских военачальников, он начинает борьбу за справедливость и возглавляет первое в Индии восстание против Могольской империи.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1060784","ru":"Под твоей кроватью","en":"언더 유어 베드","year":"2023","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/r8JreYJ16CcgYHYXanleWCGRiNY.jpg","genres":["триллер","мелодрама"],"overview":"Однажды уловив знакомый аромат духов, одинокий парень Ким Джи-хун решает разыскать его обладательницу — девушку, в которую он был влюблён в университете. Тогда, девять лет назад, она покорила его своей улыбкой и жизнерадостностью, но теперь от прежнего сияния не осталось и следа. Джи-хун открыл с ней по соседству небольшой магазин аквариумов, установил в её доме камеры и вот уже два года бессильно наблюдает, как муж каждый день избивает и насилует любовь всей его жизни.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1340828","ru":"Рождество для маленьких женщин","en":"A Little Women's Christmas","year":"2024","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/bA3LRxSo3AWi7Ip8FDPnbSpHjb1.jpg","genres":["комедия","мелодрама","драма"],"overview":"«Рождество для маленьких женщин» - это современный пересказ любимого классического романа, рассказывающий о жизни и любви сестер Марч в небольшом городке в Теннесси на Рождество.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1120903","ru":"Гениальная афера","en":"盜月者","year":"2024","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/hc7UlKWsTycs6GV2BuXgLf0Q2AV.jpg","genres":["боевик","криминал","триллер"],"overview":"Отъявленный мошенник Винсент, работающий в часовом бизнесе, присоединяется к банде грабителей, задача которых выкрасть трое известных часов Пикассо. Но в процессе этого ограбления Винсент решает прихватить еще и одну из самых редких моделей — «лунные часы». Однако оказывается, что они принадлежат местному криминальному авторитету. Теперь за грабителями охотятся не только заказчики, но и наёмники, желающие вернуть собственность своего босса.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"209752","ru":"Celebrity Jeopardy!","en":"Celebrity Jeopardy!","year":"2022","type":"Сериал","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/vhll3DMjzU5xs94BqFl1aYp1DSc.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"296463","ru":"เริ่มใหม่หัวใจเดิม","en":"เริ่มใหม่หัวใจเดิม","year":"2025","type":"Сериал","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/dhxtPFTk4bjTVzcrDnXtuJuVREA.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"313973","ru":"Locker Diaries: ZOMBIES","en":"Locker Diaries: ZOMBIES","year":"2026","type":"Сериал","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/ysK8HjNiZkkopYyLuFMiqCtQyse.jpg","genres":["НФ и Фэнтези","семейный","Детский"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"987427","ru":"Polarized","en":"Polarized","year":"2025","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/ePgEcNKGxfVV71FCzPDCClxq5kP.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1438030","ru":"Slaughterhouse 2","en":"Slaughterhouse 2","year":"2024","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/wkZgGYcCQIzX8zvMAHpzg4hFhLF.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1164363","ru":"Perempuan Berkelamin Darah","en":"Perempuan Berkelamin Darah","year":"2024","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/rZNyjlDVKKRjtUzePyOmr9SEw5Z.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1084117","ru":"Пушистые спасатели: Новая команда","en":"Combat Wombat: Back 2 Back","year":"2024","type":"Мультфильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/w6xtvPqmpLuFS92rgjmY5IV2cbu.jpg","genres":["боевик","комедия","мультфильм","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"659762","ru":"Miranda: My Such Fun Celebration","en":"Miranda: My Such Fun Celebration","year":"2020","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/qy4BK5yqTx6lPDW0NuetnWdyMSJ.jpg","genres":["комедия","музыка"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"435160","ru":"Вилли и я","en":"Willie and Me","year":"2024","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xckMxjVErtURaxoFgANbOjjAvLi.jpg","genres":["приключения","комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1092613","ru":"찬란한 나의 복수","en":"찬란한 나의 복수","year":"2023","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/3AjSk4l5ytnLNumzQJhckEBkMIW.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"882416","ru":"யானை","en":"யானை","year":"2022","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/gfK7CTnhoFcxRVNk04bUHQjq3AJ.jpg","genres":["боевик","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"10214","ru":"Капитолий","en":"Capitol","year":"1982","type":"Сериал","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/mcGxIsADKbV975wjf4PzSeF5dtK.jpg","genres":["Война и Политика","Мыльная опера"],"overview":"Маска возвращается. Десятилетие спустя легендарная Маска Локи попадает в руки карикатуриста Тима Эвери, чей новорожденный сын имеет сверхъестественные способности. Малыш напару с собакой испытывают фантастические способности Маски, переворочивая дом вверх дном. Но настоящие проблемы возникают, когда сам Локи, бог озорства, отправляется на поиски магической Маски, готовый на все, чтобы вернуть ее себе…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"383856","ru":"Хикару и го: Кубок Северной Звезды","en":"ヒカルの碁 スペシャル 北斗杯への道","year":"2004","type":"Мультфильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/w4fGbWKxvWMT8DbYvqcNhRvsLVB.jpg","genres":["драма","приключения","мультфильм"],"overview":"Хикару приглашают участвовать в турнире юниоров между Японией, Китаем и Кореей. Но на Турнир Северной Звезды поедут только три игрока от каждой из стран, поэтому сначала необходимо пройти отборочные соревнования. Акира уже выбран для участия ввиду своих высоких достижений в играх про. Хикару решает не посещать го-салон и не играть с Акирой до тех пор, пока не займет место в турнирной команде. Отборочные игры оказываются более жесткими, чем казалось изначально, и за желанное место Хикару придется сражаться не только со старыми друзьями, но и с новым сильным соперником, перспективным игроком из Кансайского Института Го.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"25310","ru":"Шарлотта Земляничка: Выше небес","en":"The Strawberry Shortcake Movie: Sky's the Limit","year":"2009","type":"Мультфильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/jykaXMXn2zcItZyJrgDAdkz5X3W.jpg","genres":["семейный","мультфильм"],"overview":"В стране Ягодок все дружны, тут всегда растет цветная клубника. Однажды пришла буря и завалила источник воды камнем. Клубничка с друзьями отправляется на поиски волшебного камня, который добывает воду.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"448416","ru":"Ореховый прутик","en":"Ореховый прутик","year":"1955","type":"Мультфильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/8vU3metaiwqUzo6KmZ2Ud3EXvF3.jpg","genres":["мультфильм"],"overview":"Девочка Мариука и её брат Григораш пошли за грибами в лес. Мальчик отошёл от сестры и попал в ловушку. Злая колдунья Клоанца схватила его и улетела на помеле в свою пещеру в горе. Девочка отправилась на поиски брата. По дороге она пожалела ореховый куст и прогнала червяка, который грыз его корни. Орешник дал ей волшебный ореховый прутик: «Всё, к чему он прикоснётся, станет меньше в сорок раз», а если прикоснётся другим кончиком - увеличит. Ореховый куст отправил Мариуку к мудрому ворону, а тот - к доброму великану Фаурару...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"14509","ru":"Откровенно говоря","en":"In aller Freundschaft","year":"1998","type":"Сериал","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/f8ZHSXNs5jyjMz3qg7mB2fqnTjP.jpg","genres":["Мыльная опера"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"621240","ru":"ニモ","en":"ニモ","year":"1984","type":"Мультфильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/AgBy8KelzBjmLvSGFDxKg200bHm.jpg","genres":["мультфильм","фэнтези","приключения"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"451122","ru":"脫皮爸爸","en":"脫皮爸爸","year":"2016","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/vaVWy3Cgu4XS3qFnoCfIyM7wgAL.jpg","genres":["комедия","драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"641022","ru":"Le Fantastique Mr Murray","en":"Le Fantastique Mr Murray","year":"2019","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/7pehjoV4FeDGZ9tCdygenzgWT8y.jpg","genres":["документальный","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"567204","ru":"Cinderella: The Enchanted Beginning","en":"Cinderella: The Enchanted Beginning","year":"2018","type":"Фильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/4hAgjZizUkQ0JiAyxfMrxiNeQTG.jpg","genres":["семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"56827","ru":"Heidi's Song","en":"Heidi's Song","year":"1982","type":"Мультфильм","rating":6.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/l5ioAw1E8nm3mJMYUFCdMWY0JsN.jpg","genres":["семейный","мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}