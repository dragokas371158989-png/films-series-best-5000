,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1ITX9gOcuBSVTKQ4X40rZIJyXOM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dmSkUvrsRPzrYgRZELFmke6jCR6.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"676351","ru":"Omar Sharif – Aus dem Leben eines Nomaden","en":"Omar Sharif – Aus dem Leben eines Nomaden","year":"2020","type":"Фильм","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/9bvSVUxNJlgFvdj9t4fmR020FMJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eEziILTgcTdkqFuw9neK43twhFi.jpg","genres":["документальный","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"696025","ru":"설화","en":"설화","year":"2020","type":"Фильм","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fzywqR5ZZ2IkIB2gkHMpdmGp6iY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j8reMcq5v8qaLfSbFqQNEgZKvaf.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"300465","ru":"Drelich","en":"Drelich","year":"2025","type":"Сериал","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/jqLlCD80OMnrzM0j4eWSG6Q2DKp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uwLAo2VQBunURs9yV9CQM1OdTUj.jpg","genres":["криминал","Боевик и Приключения","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"773935","ru":"Spirit Riding Free: Ride Along Adventure","en":"Spirit Riding Free: Ride Along Adventure","year":"2020","type":"Мультфильм","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2Trtl3ff1VJIh2N8pOQAnwjDIQy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xfBKpS8Bsu0EMcQnNTrIcJDwSwy.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"108257","ru":"Морские дьяволы","en":"Морские дьяволы","year":"2005","type":"Сериал","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/4y0hKgQKYjywkVMRoVUEceZA6tQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/flz8NyVPRk6Ho6v3gVjFAtLixSL.jpg","genres":["Боевик и Приключения","криминал","драма"],"overview":"Их четверо. Они - бойцы спецназа. Их называют «морскими дьяволами», хотя по праву их можно считать рыцарями трех стихий: они действуют на земле, в воде и в воздухе. У каждого из них свой характер и своя судьба, но каждый полон решимости выполнить свой профессиональный долг, невзирая на риск. Понятия «братство», «дружба», «офицерская честь» - для них не просто абстракция, а то, чем они дорожат и ради чего готовы пожертвовать жизнью.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"158620","ru":"Перья и блестки","en":"Plumas & Paetês","year":"1980","type":"Сериал","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1oEQi2HSLgezuocBBN99XfhsoYX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xRTxntuyv8NwCtpkG3gpVHHxaQK.jpg","genres":["драма","Мыльная опера"],"overview":"Действие разворачивается в Сан-Паулу и рассказывает историю молодой Марселы. После года жизни вдали от семьи Осмар решает вернуться в Сан-Паулу со своей невестой. По дороге они подбирают подругу Марселу, которая беременна и планирует начать новую жизнь в столице штата. Однако в пути происходит страшная авария, и единственной выжившей оказывается Марсела. Девушка решает принять личность невесты Осмара и начинает наслаждаться комфортом, который обеспечивает ей семья погибшего жениха. Бруна замужем за богачом Густаво, от которого у нее трое детей: Осмара, Эдгара и Мелину. По сюжету старший сын Бруны, Эдгар, влюбляется в Марселу. Однако девушка вновь встречает своего бывшего возлюбленного Ренато, и между ними завязывается любовный треугольник.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"885058","ru":"A Night at the Academy Museum","en":"A Night at the Academy Museum","year":"2021","type":"Фильм","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2ANOppd40Q2qScqULGIduMwulSZ.jpg","backdrop":"","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"426342","ru":"Глубокое синее море","en":"National Theatre Live: The Deep Blue Sea","year":"2016","type":"Фильм","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/t4oFxxbrAOANvLF5cTLuK2r36R5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gv7T101MfFQdUobEOngre3OogNo.jpg","genres":["драма"],"overview":"Западный Лондон, 1952 год. Хестер Колльер совершает в своей квартире неудачную попытку самоубийства. Причины, толкнувшие женщину на такой отчаянный поступок – запутанные отношения Хестер с бывшим пилотом королевских военно-воздушных сил и неудачный брак с преуспевающим судьёй. За фасадом подчёркнутой благовоспитанности послевоенного британского общества скрывается одиночество, подавленная страсть и желание жить полной жизнью.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"27575","ru":"Screen Director's Playhouse","en":"Screen Director's Playhouse","year":"1955","type":"Сериал","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/s1LPx21vNJ37IDGqLqDC0e8ygQC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iD3FaP71cAOy5u9D3WaizSdJhMm.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"12788","ru":"Spoed","en":"Spoed","year":"2000","type":"Сериал","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fx3RfdKZ066UTbnA7DYHkt77eQl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2wNTHFkJzcgAdsW43yshoTDIYAM.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"15857","ru":"This Week","en":"This Week","year":"2003","type":"Сериал","rating":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/cWGOOkcLTlZesrb113NOOUN4V3I.jpg","backdrop":"https://image.tmdb.org/t/p/