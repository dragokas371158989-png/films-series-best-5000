rg/t/p/w780/8HA4jPsLNe2ztljqlr8EILZceIV.jpg","genres":["Боевик","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"204812","ru":"Робот-кролик","en":"Robot Rabbit","year":"1953","type":"Мультфильм","rating":6.8,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/zrQLmdXRl5R7eoD79S7du3tsaf6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/36wbalrnGTBkgskCSIXUNCW8iQk.jpg","genres":["Мультфильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"60698","ru":"Комедийные вечера с Капилом","en":"Comedy Nights with Kapil","year":"2013","type":"Сериал","rating":6.8,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/9rScFaEadiT3r46LuT9wWOkh3fo.jpg","backdrop":"","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_113042","ru":"Клуб красавчиков-детективов","en":"美少年探偵団","year":"2021","type":"Аниме","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/pukukrcqHmwTDlFDYjSXkvEzNaP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fL81d6le3QQNLEcoNtN6h95YqGa.jpg","genres":["Мультфильм","Комедия","Детектив","Аниме"],"overview":"Школьница Маюми потеряла звезду, которую она однажды увидела десять лет назад. На помощь ей приходит неофициальный, секретный и совершенно загадочный Клуб детективов-красавчиков. По слухам, эти пять великолепных мальчиков решают проблемы в школе — большинство из которых, правда, сами и создают. Очарованная ими Маюми погружается в мир азарта, опасностей и потрясающей красоты.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_217407","ru":"Может ли существовать дружба между мужчиной и женщиной? (Нет, это не так!)","en":"男女の友情は成立する？（いや、しないっ!!）","year":"2025","type":"Аниме","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/brgM5pN4tsaLAQXat15DuUTm6dm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/taa2aoX0ZBZiydrmc4p3IBtmJz0.jpg","genres":["Мультфильм","Комедия","Аниме"],"overview":"История Химари и Юу — это трогательная и лёгкая комедия о взрослении, дружбе и первых шагах к романтике. Они учатся понимать свои эмоции, сталкиваются с сомнениями и открывают для себя новые грани чувств. Смешные диалоги, милые сцены и ненавязчивая романтика делают этот аниме идеальным для тех, кто хочет окунуться в атмосферу юности, где каждый день — это маленькое приключение, а каждое решение может изменить всё.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"883768","ru":"機動戦士ガンダム ククルス・ドアンの島","en":"機動戦士ガンダム ククルス・ドアンの島","year":"2022","type":"Аниме","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/yWu4qA7B08YOL1eiz5KaUzEFcjU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sRUKTGQngY3XAJ0nxjvCO030Kby.jpg","genres":["Мультфильм","Драма","Фантастика","Боевик","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_65210","ru":"Бубуки Буранки","en":"ブブキ・ブランキ","year":"2016","type":"Аниме","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/zVjFhC43B3hklP83JgC4vxhhI0X.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2fs9w915mmNAtAoYeS9XpWaz048.jpg","genres":["Мультфильм","Фантастика","Аниме"],"overview":"Когда Адзума Икки возвращается в Японию после десятилетнего отсутствия, на него внезапно нападает группа вооруженных людей. Спастись ему помогла подруга детства Когане Асабуки с помощью оружия, известного как «Бабуки», оружия с собственной волей. Настало время нашему герою разобраться, за что же на него объявлена охота.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_78484","ru":"Инадзума 11: Весы Ареса","en":"イナズマイレブン アレスの天秤","year":"2018","type":"Аниме","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/xd2OyjcVDbNJAFBbBh63LniGDQB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cLAnJMn3j45ct04qCkfMoe82m3y.jpg","genres":["Мультфильм","Аниме"],"overview":"События разворачиваются в параллельном мире после окончания первой арки «Инадзума 11» и рассказывают историю с точки зрения трёх главных героев — Рёхэя Хайзаки, Асуто Инамори и Юмы Носаки. Группа ребят, живущих на острове, очень любит играть в футбол, но их футбольный клуб внезапно закрывают, и единственный способ вернуть его — выиграть «Футбольный рубеж». Протагонист Асуто Инамори и его друзья покидают остров и отправляются в Токио, чтобы поступить в среднюю школу Раймон и испытать себя в «Футбольном рубеже». Но их первый матч — против главных претендентов на победу Академии Сэйшо.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_75986","ru":"Служащий x Служба","en":"サーバント×サービス","year":"2013","type":"Аниме","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/fhGmNBTOUUOuonSlpoI1SA485TR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zDnpmBoIflnwXpc4ibiwriumx4I.jpg","genres":["Мультфильм","Комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"163754","ru":"クレヨンしんちゃん 嵐を呼ぶ黄金のスパイ大作戦","en":"クレヨンしんちゃん 嵐を呼ぶ黄金のスパイ大作戦","year":"2011","type":"Аниме","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/bXorDERG6ARfayQwKNCC4d37OWd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/obqeCTbgmCjqvj9LWjjrAucTszH.jpg","genres":["Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1002109","ru":"Police Flash 80","en":"Police Flash 80","year":"2026","type":"Фильм","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/2HD9MuSt5Fk6i7uAgI3m75VATjk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/83YBWW1sAtliSyejJ6880FJp1FI.jpg","genres":["Комедия","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1145358","ru":"Dead Man's Hand","en":"Dead Man's Hand","year":"2023","type":"Фильм","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/vbQ3ZWDSDM84sdl9