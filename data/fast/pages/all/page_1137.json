ную Куроми!Теперь Куроми предстоит разобраться во всём в сжатые сроки на новой должности, ведь срок сдачи нового эпизода аниме — всего неделя, а ничего даже и близко не готово, к тому же мультипликаторы как на подбор проблемные и требующие личного подхода и мотивации, а один, кажется, и вовсе не умеет рисовать! Справится ли новоиспечённый продюсер? Увидят ли зрители в срок новый эпизод «Путешествий во времени»?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"167947","ru":"魔境外伝レ・ディウス","en":"魔境外伝レ・ディウス","year":"1987","type":"Мультфильм","rating":6.2,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/xnVYqWpgd1zige4sOMjHHhXMQ32.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lC8ggpSb4DVfO2wSCUUiERIboR0.jpg","genres":["мультфильм","приключения","боевик","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"298044","ru":"神様のカルテ2","en":"神様のカルテ2","year":"2014","type":"Фильм","rating":6.2,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/qKx38zQWR9lHG9DP6kyMtME8Oq6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ndn8WlmLcCXXKRlsW04CMG9Pel9.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"427452","ru":"쌍둥이 에로 킬러: 자매의 유혹","en":"쌍둥이 에로 킬러: 자매의 유혹","year":"2016","type":"Фильм","rating":6.2,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/jO0gH1aG6PqBX0gTgLf0zNS9pHN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xUdBbTrcNPT3l250eqGA2qYJExm.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"322135","ru":"Blindgänger","en":"Blindgänger","year":"2015","type":"Фильм","rating":6.2,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/eHOENggqyAFscyFmZtiPug5710J.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jxXibjyLghVYYqKk6dY7mjURQtk.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"76