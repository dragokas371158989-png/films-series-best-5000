view":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1372313","ru":"2006","en":"2006","year":"2024","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/5rAHR5RHRbNSeUmiHyEkCBFVBwe.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1458083","ru":"Cosmografias","en":"Cosmografias","year":"2024","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/neiHKidP7dMSWIYls0Z203fTBDq.jpg","genres":["фантастика","документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1527782","ru":"Diaboli","en":"Diaboli","year":"2025","type":"Мультфильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xwme0CYhFMOEa5miDO9Re4vEFXP.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"889869","ru":"Broadcast Signal Intrusion","en":"Broadcast Signal Intrusion","year":"2016","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/jOYdB0x32L2HXlFAMttJ8biopTy.jpg","genres":["драма"],"overview":"В конце девяностых годов архивист видео наталкивается на несколько пиратских эфирных записей и начинает постепенно терять рассудок, пытаясь раскрыть страшную тайну, которую они хранят.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"348421","ru":"Проект: Динозавр","en":"T. Rex Autopsy","year":"2015","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/l6WdkcHbNyZO5w77BjhPXBkQYU5.jpg","genres":["документальный"],"overview":"Этот уникальный эксперимент предлагает беспрецедентную возможность узнать ответы на такие вопросы, как: были ли у Ти-рекса перья или нет, как он питался с такими маленькими ручками, был он изначально хищником или падальщиком, как он переваривал пищу, как долго жил, как размножался и был ли он теплокровным как млекопитающее или хладнокровным как рептилия. С глазами размером с грейпфрут, 30-сантиметровыми зубами и желудком, в который поместился бы четырёхлетний ребёнок, Ти-рекс будет воссоздан как живой — снаружи и изнутри. Используя самые современные техники спецэффектов и прибегнув к помощи почитаемых ветеринарных хирургов, анатомов и палеонтологов, эта передача прольёт свет на последние исследования и открытия о тираннозавре.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1212657","ru":"Antrenamentul de noapte","en":"Antrenamentul de noapte","year":"2023","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1x5X5XdFPJfwF4k3VKhNuYg5hln.jpg","genres":["драма","фэнтези","ужасы","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"685230","ru":"Disturbing the Peace: A Small Town Standoff","en":"Disturbing the Peace: A Small Town Standoff","year":"2020","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1vEJtsACLFSABvaZlBU4wgzBmQL.jpg","genres":["документальный","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1613889","ru":"Odonata","en":"Odonata","year":"2026","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hTrBfWDjjNhGU35gjC5mrcNNghx.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1268987","ru":"Mode Avion","en":"Mode Avion","year":"2024","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hgP5CwlsX3Tr5hFGckziPLTNoNw.jpg","genres":["детектив","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1