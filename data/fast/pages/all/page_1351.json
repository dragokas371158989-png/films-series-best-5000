.org/t/p/w342/nGQm7e2rZnZ6cHJlLmJndJxUtGF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3C0B4VvRMTVUuaQuhXqsPaw6jL.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"83964","ru":"Ты назови","en":"Adını Sen Koy","year":"2016","type":"Сериал","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/z2dKvxrk7U1a937ra1Jm5TqLPQO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xppU4PLid0wLnLWuInm6B5lTKIU.jpg","genres":["семейный","драма","Мыльная опера"],"overview":"Влюбленная душа живёт в тёмном и холодном климате. И зной, и свет всегда на один шаг впереди, все в руках твоего любимого. Любовь - это когда два сопротивляющихся сердца каким-то образом воссоединяются, пытаясь приблизиться, отдаляются. Омер для счастья своей младшей сестры, которому остаётся шесть месяцев жизни вступает в игру, даже не ожидая этого. Он вынужден жениться на Зехре из совсем другого мира. Они создадут фиктивный брак на шесть месяцев с брачным договором. Для этого он заплатит Зехре столько, сколько захочет, он покупает у неё её шесть месяцев.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"375109","ru":"Срочно выйду замуж","en":"Срочно выйду замуж","year":"2015","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bYRuUku0J4l5wqc0URr8j0fUvT6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6KNGSP8Uekv4WMzEBwoBEtRnOwU.jpg","genres":["мелодрама","комедия"],"overview":"Женя — редактор-трудоголик, Стас — светский фотограф. Она амбициозна, а у него по жизни — ни задачи, ни проблемы. Женя хочет и может стать главным редактором журнала, но для этого у нее срочно должен появиться супруг! Условие акционеров издания — семейная аудитория нуждается в семейном руководителе. И на решение этой задачи у девушки есть всего неделя. Стас берется помочь девушке, в картотеке у модного фотографа есть немало холостяков, которые вполне могли бы подойти на роль мужа. Но неожиданно Женя понимает, что совсем не расчетлива, а Стас с удивлением обнаруживает, что влюблен.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"511613","ru":"Пленительный бурлеск","en":"Becoming Burlesque","year":"2019","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/zgtxqGZtrSPdg9Gbwe8JjqL6Ys.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9RJ0lIC0UnxKbLHXHHvBlafYSwF.jpg","genres":["драма"],"overview":"Несмотря на то, что дядя Фатимы старается привить ей традиционный мусульманский образ жизни, она всё же тайно присоединяется к труппе бурлеска в Торонто.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"387808","ru":"등산의 목적","en":"등산의 목적","year":"2016","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/k4RwkJp99pSFnJ7La8w9AA86zNP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8HIlPYRAuhVQ9rEKx2cV8y8wPD0.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"435838","ru":"Debut","en":"Debut","year":"2016","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/b9WUabdQVTJnVGnfGPVlGDStxji.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1ovrHn1sPlD1j6ZFRH8pigNw6Q.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"659254","ru":"Broken Swords: The Last in Line","en":"Broken Swords: The Last in Line","year":"2018","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/lG3NmZa9XqkbC0x5D0dMKDveqJv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hG63ijNO9pdcX1P6D3sw5eSmzP5.jpg","genres":["боевик","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"623391","ru":"Just a Stranger","en":"Just a Stranger","year":"2019","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bQA7N9iBAtL5ws5DdvEwm0FYrBA.