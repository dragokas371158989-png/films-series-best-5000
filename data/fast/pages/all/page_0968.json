dio":"","country":"","ageRating":""},{"id":"220118","ru":"漣蒼士に純潔を捧ぐ","en":"漣蒼士に純潔を捧ぐ","year":"2023","type":"Аниме","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/9hyTDPS9uo70QJwvBsVGtaLAANB.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"221725","ru":"ちびゴジラの逆襲","en":"ちびゴジラの逆襲","year":"2023","type":"Аниме","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/be7uDWl2vWMX5OeAA8S6FNCT5Ei.jpg","genres":["мультфильм","комедия","Детский","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"60842","ru":"Безбилетники на Ноевом Ковчеге","en":"In der Arche ist der Wurm drin","year":"1988","type":"Аниме","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ltsO642LjbKl8qc1snbCSitaVVU.jpg","genres":["мультфильм","семейный","Аниме"],"overview":"Вы никогда не задумывались, почему от Ноева Ковчега не осталось даже истлевших обломков? И маленьким и взрослым наверняка будет любопытно взглянуть на историю мира глазами… древесных червей. Да, именно они плыли на Ковчеге без билета. Из-за них и рассыпались в прах реликвия — корабль, построенный нашим общим прапрадедушкой Ноем. Древесные черви должны отстоять свое доброе имя. Пусть они не совладали с аппетитом. Но если Ковчег едва не пошел ко дну, это дело не их рук… простите, зубов. Ведь на корабле были и другие безбилетники, куда более опасные …","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"231620","ru":"现在就出发","en":"现在就出发","year":"2023","type":"Сериал","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/zs9xoKTxMSI2gscD6z8X9sBWIWp.jpg","genres":["Реалити-шоу","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1629095","ru":"Городские пацаны: Городские парни","en":"Băieți de oraș: Golden Boyz","year":"2026","type":"Фильм","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/msmjEUOXH05AI5c6p3oQubJ282I.jpg","genres":["комедия"],"overview":"Фильм рассказывает о приключениях двух недалеких молодых людей - Роби Роберто и Мэлоуна. В центре сюжета оказывается Мэлоун, который неожиданно получает шанс унаследовать 9 миллионов евро после смерти дальнего родственника. Однако есть условие: чтобы забрать деньги, ему необходимо получить диплом о высшем образовании. Герои пускаются во все тяжкие, пытаясь провернуть эту аферу, сталкиваясь с реалиями современного Бухареста.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"231040","ru":"Пламя ярости","en":"烈焰","year":"2024","type":"Сериал","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/sWCByYEIrTdts3jOf2OBvKKM5PH.jpg","genres":["Боевик и Приключения","НФ и Фэнтези","драма","Война и Политика"],"overview":"Человеческий клан Синь на протяжении многих тысяч лет вынужден загонять свой народ на рудники для добычи драгоценных «кровавых камней», чтобы выплачивать богам огромную дань. В определенный момент король людей теряет терпение, объявляет войну богам, в которой терпит сокрушительное поражение и гибнет сам. Молодой принц У Гэн, потерявший всю свою семью, становится рабом в одной из шахт. Благодаря духовному наставнику Фу Си он начинает усердно тренироваться и тайно собирать новую армию, чтобы вернуть свободу себе и своему народу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1053194","ru":"Битва за завтрашний день","en":"拚命三郎","year":"2025","type":"Фильм","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/h3ZrvrQtEVuxgTC303mR8CO2YMi.jpg","genres":["драма","боевик"],"overview":"Бывший главарь банды Сэм Лун выходит из тюрьмы, решив начать всё заново. Он работает парковщиком и мечтает однажды открыть собственный паб, но сталкивается с финансовыми трудностями и последствиями пандемии. Случайная встреча в полицейском участке с его давно отдалившимся сыном, попавшим в неприятности из-за конфликта с сыном бывшего подельника Сэма, переворачивает его жизнь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1634301","ru":"Vanaveera","en":"Vanaveera","year":"2026","type":"Фильм","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/oBYExKI8E3bTzQjPkofhpV2EJon.jpg","genres":["боевик","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"253451","ru":"さっちゃん、僕は。","en":"さっちゃん、僕は。","year":"2024","type":"Сериал","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/cE2OlB7qqxAalgRJWmkmewwsRcW.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1513996","ru":"Maya & Samar","en":"Maya & Samar","year":"2026","type":"Фильм","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/6UdKNWOlZFTiGxOyaOoNZcqMj7t.jpg","genres":["драма","мелодрама","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"309766","ru":"爱在草原醒来","en":"爱在草原醒来","year":"2026","type":"Сериал","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/glfgnpVkbe5NRK4DkHAIp2eK7pt.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1035998","ru":"జీబ్రా","en":"జీబ్రా","year":"2024","type":"Фильм","rating":7.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/rCGgmmMD63pKH7lnmVJ5MMLQfOm.jpg","genres":["криминал","боевик","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}