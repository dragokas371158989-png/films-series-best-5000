sodes":"","studio":"","country":"","ageRating":""},{"id":"398362","ru":"Izzie's Way Home","en":"Izzie's Way Home","year":"2016","type":"Мультфильм","rating":1.8,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/5ZhVflF5cQ2rkwWJrdtwkHtu8Lt.jpg","genres":["приключения","мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"837542","ru":"Комната №9","en":"Room 9","year":"2021","type":"Фильм","rating":1.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/wwoPy8Iin3u49Gu5aUJULua3cwK.jpg","genres":["ужасы"],"overview":"Сорок лет назад в небольшом американском городке произошло жестокое двойное убийство. Спустя десятилетия город вновь потрясла серия жутких ритуальных убийств. В это же время в город приезжает молодой парень, получивший в наследство дом дальних родственников. Сразу же он начинает начинает страдать от странных воспоминаний, связанных с этим городом и осознает, что он имеет отношение к трагическим событиям прошлого, но не понимает, какова его роль в текущих событиях: жертвы или убийцы?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"347788","ru":"A Wife's Secret","en":"A Wife's Secret","year":"2014","type":"Фильм","rating":1.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/k4xCnSvmke5ukTQ42GUz5I31gIb.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1371522","ru":"盐湖计划","en":"盐湖计划","year":"2024","type":"Фильм","rating":1.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/4gXHVyhHMeaIQclNsupd2dQSbwj.jpg","genres":["комедия","криминал","приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"904116","ru":"Amityville Karen","en":"Amityville Karen","year":"2022","type":"Фильм","rating":1.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/iaRAnKpyo95dgDEJMGejWnYO5hA.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","countr