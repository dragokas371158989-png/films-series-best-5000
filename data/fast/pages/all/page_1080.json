mdb.org/t/p/w780/9SZWGari27b3SNIKXPKGkXPZ91n.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"366148","ru":"ஜில் ஜங் ஜக்","en":"ஜில் ஜங் ஜக்","year":"2016","type":"Фильм","rating":6.6,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/oYMVaJwHH2Cot5hYQbHT4j28gBv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lCVOfAHjGbMxBzlEk4M9GXdQbdR.jpg","genres":["Боевик","Комедия","Мелодрама","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"470836","ru":"Meditation Park","en":"Meditation Park","year":"2017","type":"Фильм","rating":6.6,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/sC3bgqxlZ0lB45zIEFfu6R1WrMm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vyeLzc3a15Nu23qigW1JoyPHH77.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"69868","ru":"Piccolo, Saxo et Compagnie","en":"Piccolo, Saxo et Compagnie","year":"2006","type":"Мультфильм","rating":6.6,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/7IM96wqjuZvuOjbcPXCkZCtoRSw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zJ1viB6EOIneoRVYwKMVeOMRwok.jpg","genres":["Мультфильм","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_132213","ru":"Стать настоящей героиней! Непопулярная героиня и секретное задание","en":"ヒロインたるもの！〜嫌われヒロインと内緒のお仕事〜","year":"2022","type":"Аниме","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/obcfoPXlAV0zrsI3znWeQB9UgD3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oPyLzaWOFsbteeOmlBt1b36jsT.jpg","genres":["Мультфильм","Комедия","Драма","Аниме"],"overview":"Хиори Сузуми покинула свой маленький городок и перебралась в столицу, чтобы профессионально заниматься атлетикой, ведь это её страсть и любовь всей жизни! И хотя планы были грандиозными, на деле все оказалось намного сложнее чем задумывалось. Хиори было не на что жить и не чем заплатить за свою квартиру. Но к счастью, она нашла подработку, да ещё и какую! Девушка стала менеджером группы айдолов LIPxLIP. Так Хиори начала свое знакомство с шоубизнесом и продолжила идти к своей цели!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_11316","ru":"Последняя фантазия: Всемогущий","en":"FF:U ～ファイナルファンタジー：アンリミテッド～","year":"2001","type":"Аниме","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/x0zqOcg7D6EzCsf7cx7r1KoBVPz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yrVWGIaOjTNFZEpg9sKXaOip9cW.jpg","genres":["Мультфильм","Боевик","Аниме"],"overview":"Однажды в нашем мире открылся проход в чужую вселенную, сквозь который прорвались два существа, обладающие невероятной силой. Сражаясь, чудовища уничтожили друг друга, оставив после себя лишь таинственную колонну темной материи и вопросы без ответов… Спустя двенадцать лет дети двух ученых, изучавших портал между мирами, отправляются на поиск исчезнувших родителей. На призрачном поезде Аи и Ю попадают в чужой мир. Здесь к ним присоединяются путешественница Лиза, а чуть позже они встречают таинственного странника Кадзе… Так начинается полное приключений путешествие в сердце Страны Чудес!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"255719","ru":"Мертёй","en":"Merteuil","year":"2025","type":"Сериал","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/awOWWPDLDc3Q5s5MuC3KXnhbpEj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iyPxER0i2XPPhK92kHmd7BAF7v0.jpg","genres":["Драма"],"overview":"Историческая драма, вольная адаптация романа «Опасные связи» Пьера Шодерло де Лакло. Сериал рассказывает о молодой Изабель де Мертёй, которая была предана виконтом де Вальмo. Она решает вернуть себе власть и достоинство – и её путь ведёт от низов общества до двора короля Людовика XV.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1223799","ru":"Астрал. Проклятие мёртвых","en":"Pemandi Jenazah","year":"2024","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/hBYZRtOA8pR0w0qpgGZ3XHrzvk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/p96S6KlDD71BMhNGLqf7zvEVlCL.jpg","genres":["Ужасы","Драма","Триллер"],"overview":"В городе происходит череда загадочных смертей: на телах жертв остаются странные следы. Во время древнего обряда омовения девушка начинает подозревать, что убийца совершает загадочный ритуал, не дающий душам погибших обрести вечный покой и призывающий могущественную потустороннюю силу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"949581","ru":"Снупи представляет: маме (и папе) с любовью","en":"Snoopy Presents: To Mom (and Dad), with Love","year":"2022","type":"Мультфильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/lGx3mlfCjtUx1JgtHxfBKj2ATKX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eqefJo4uCzBiI4zT0OA6mYoqVTi.jpg","genres":["Мультфильм"],"overview":"Вся «Мелочь пузатая» с восторгом ожидает приближающийся День матери. Кроме Пепперминт Пэтти, которой этот праздник лишний раз напоминает, что она растет без мамы. Марси помогает Пепперминт Пэтти понять, что семьи бывают разные.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1363916","ru":"Тайны Авроры Тигарден: Урок убийства","en":"Aurora Teagarden Mysteries: A Lesson in Murder","year":"2024","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/m5w7oPvKxtCFDHqmkEZ1kq8impf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4o0Ey0BUTdvYYFv7Ow8nsQos5gZ.jpg","genres":["Детектив","Телевизионный фильм"],"overview":"Когда одного из учеников курса Авроры по криминальной литературе находят убитым возле закусочной, где она подрабатывает, Аврора решает самостоятельно заняться расследованием. Не доверяя официальной версии событий, она берёт на себя задачу найти настоящего преступника, используя свои знания о криминалистике и детективной литературе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"744944","ru":"Рождество в усадьбе","en":"The Christmas Listing","year":"2020","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/mwOX89ifT59zq9lHu4JOIFk4ZIu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/81B5aGPIsvUWOsNUAzgljfkXLc9.jpg","genres":["Мелодрама","Драма"],"overview":"Риелторы Чед и Джулия соревнуются за право продажи одной и той же усадьбы. Но победить не так-то просто — для начала они должны провести все праздничные дни вместе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1105787","ru":"Королевский рецепт любви","en":"A Royal Recipe for Love","year":"2023","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/7fzp1Fvf60BtwATCoMEBeHG2cgi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ccwnedVLAmPa99PYuM7TEPtzJVX.jpg","genres":["Телевизионный фильм","Комедия","Мелодрама"],"overview":"Джессика — американский блогер, увлечённый кулинарией и историей. Она выигрывает конкурс на должность личного повара для принца небольшой европейской страны Сан-Амброзия. Чтобы не привлекать к себе лишнего внимания, Джессика решает скрыть свою настоящую профессию и представляется историком. И в первые же дни она случайно знакомится с принцем Алексисом. Он тоже решает не раскрывать своего положения, представившись обычным гидом. Вместе они исследуют страну, её кухню и культуру, и между ними возникает искреннее взаимное притяжение. Джессика с энтузиазмом берётся за работу повара при дворе, не подозревая, что её загадочный новый друг и есть её работодатель.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1255130","ru":"Смерть в отпуске","en":"Moartea în vacanță","year":"2024","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/ja9aqdAajtDbUfsXsmik1viruyA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ni58sIhwOX9nuctiCB9MLfFy4Y1.jpg","genres":["Комедия","Боевик"],"overview":"Фильм повествует о трёх авантюристах, которые внезапно становятся товарищами по несчастью. Каждый из них отчаянно пытается завоевать доверие одинокой и состоятельной старушки Родики, надеясь получить в наследство её внушительное состояние.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"602464","ru":"영웅","en":"영웅","year":"2022","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/ty2BX4V4ZBAg2ApG2WMmVYKwB1t.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wgiVj0H81KBpfUzcixmKdELhGW6.jpg","genres":["Драма","История","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"672125","ru":"ಲವ್ ಮಾಕ್‌ಟೇಲ್‌","en":"ಲವ್ ಮಾಕ್‌ಟೇಲ್‌","year":"2020","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/bJqYDmyJffTk9ruvPt6B5WTPe9B.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5VPIkLkBHKBd1QvewF4iDRPQK2j.jpg","genres":["Мелодрама","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1583500","ru":"Elway","en":"Elway","year":"2025","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/bPOEtWhI7lGpW0OxZZGjt545OXy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dM6EbI3T5O2PruUS5K7cbVAexON.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"598859","ru":"कामयाब","en":"कामयाब","year":"2020","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/b2VeikFx112olsivPPzA8D3cTUL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lNSaNHNdt8ci6o1UNjsauMl35ag.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"958496","ru":"Mi país imaginario","en":"Mi país imaginario","year":"2022","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/lMduFPHGOMORvrM0DTPCPfRhhRd.jpg","backdrop":"