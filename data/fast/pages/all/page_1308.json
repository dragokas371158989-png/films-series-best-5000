db","episodes":"","studio":"","country":"","ageRating":""},{"id":"639298","ru":"日光之下","en":"日光之下","year":"2020","type":"Фильм","rating":4.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/unniA9kVpHuRezDARcxqRxMZRY6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bmdHGMpiZTlg088HUEJyN3Cuohs.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"487734","ru":"Забери меня на Луну","en":"帶我去月球","year":"2017","type":"Фильм","rating":4.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/pdPqVOWplyMZrcfDf7ty7okOgeO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cg1KzUk0T6mPoMViHwP3Id8l8yy.jpg","genres":["мелодрама","драма"],"overview":"Двадцать лет назад шестеро школьных друзей собрали группу и надеялись покорить весь мир, выиграв конкурс японского лейбла. Но что-то пошло не так. Двадцать лет спустя на похоронах одного из товарищей главный герой теряет сознание и снова попадает в 1997 год. У него появился шанс исправить ошибки молодости.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"234088","ru":"ヌイグルマーZ","en":"ヌイグルマーZ","year":"2014","type":"Фильм","rating":4.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/oE4a7Tzg0tXILaG0h5863UqzZ3Q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kVY54xetUPTQiduzCdLbGX9MDA7.jpg","genres":["ужасы","комедия","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"564689","ru":"പ്രേതം 2","en":"പ്രേതം 2","year":"2018","type":"Фильм","rating":4.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/odvJhAGpHhZIooaWehHjFFTgV66.jpg","backdrop":"https://image.tmdb.org/t/p/w780/A8RuqeC5FpMAHvy8tr9bVhvAJrA.jpg","genres":["ужасы","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"638961","ru":"Erasing His Dark Past","en":"Erasing His Dark Past","year":"2019","type":"Фильм","rating":4.5,"votes":10,"poster":"https://image.tmdb.org/t/