s://image.tmdb.org/t/p/w342/8kLXDh37BmR2FJulE21YUF74vPs.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kmUR43ltGCecwybhXLFELwfrPxg.jpg","genres":["боевик","криминал","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"9379","ru":"Бедная Настя","en":"Бедная Настя","year":"2003","type":"Сериал","rating":4.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/emevvSYbd8m6dviEjmbW31irf94.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rSKTINaNtVu9Zg6otgIoposVRz2.jpg","genres":["драма","Мыльная опера"],"overview":"Барон Корф вырастил Анну как родную дочь и мечтает увидеть её на сцене императорского театра. Светский Петербург тоже видит в Анне несомненный талант, и ей прочат большое будущее. Но мало кто знает, что девушка — крепостная. Князь Михаил Репнин влюбляется в Анну с первого взгляда, но сохранит ли он свою любовь, когда тайна Анны раскроется?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"350563","ru":"Эйнджел","en":"Angel","year":"2015","type":"Фильм","rating":4.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/52Y5JHcoL07Ngy6aDJwf259nxA7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tJrb4P5Efon6758giknE8Jl30L5.jpg","genres":["триллер"],"overview":"В небольшом английском городке живет милая девушка Эйнджел, чисто ангел во плоти, тихая и робкая, очень любящая свою бабушку. Но никто не знает, что, в прошлом, ее бабушка была ораганизатором детских вечереинок для высокопоставленных педофилов....Основано на книге Найджела Макрери \"Средоточие зла\".","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"563799","ru":"Клайд Купер","en":"Clyde Cooper","year":"2018","type":"Фильм","rating":4.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/6gTe5LyA5wjdQAWy7aEnrNpMFMq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nWyQxUKrxOLk3YUDC0UyHompkFW.jpg","genres":["детектив"],"overview":"Недалёкое будущее. Частный детектив Клайд Купер соглашается начать поиски пропавшей девушки, которой интересуется таинственная корпорация Кремниевой долины.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"477848","ru":"В добром здравии","en":"Perfect sănătos","year":"2017","type":"Фильм","rating":4.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/8ZWyKmcotKnXpg0MbZgSa0fec0u.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g1TlPYHYwd46XcxSWsjq8RVwKrc.jpg","genres":["драма"],"overview":"Юрист собирает информацию о последнем дне жизни своего отца — судьи, загадочные обстоятельства смерти которого вызывают у окружающих подозрения насчет его молодой вдовы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"482706","ru":"올리고당 더 무비","en":"올리고당 더 무비","year":"2017","type":"Фильм","rating":4.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/8hRAm3H3wwBGRBCre6xfQfpwmHj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fbWHVtOATFhpipizRBNeulJNbcH.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"569578","ru":"Ascharyachakit!","en":"Ascharyachakit!","year":"2018","type":"Фильм","rating":4.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/jNThnK5uJS4g63CANGi7FukLgLt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uT0JMtEaVhPQwEUzovi44jJZdM4.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"525864","ru":"Groomzilla","en":"Groomzilla","year":"2018","type":"Фильм","rating":4.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/dS7U3qArQvbgpqP0hSQ3k0jF2hY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/po9e9LfsplKVo5ptoXrlNYdTqWw.jpg","genres":["мелодрама","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"327915","ru":"Sakalakala Vallavan","en":"Sakalakala Vallavan","year":"2015","type":"Фильм","rating":4.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/fSTe9o0j20H