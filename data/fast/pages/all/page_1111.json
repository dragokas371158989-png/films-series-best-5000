HrL7dI8BDCvblT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xTXHv1dftqmQAB6GhphvmTBL70R.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"721109","ru":"భానుమతి & రామకృష్ణ","en":"భానుమతి & రామకృష్ణ","year":"2020","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/Ag5XeTmbu9goww5gBYPNFRNYYW1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jppziGS8fz8Syd10aPtUHfpqvJ7.jpg","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"750461","ru":"Dar-Dar","en":"Dar-Dar","year":"2020","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/1Qi76KK8Ci4OPF8AbyHe6flS9ep.jpg","backdrop":"https://image.tmdb.org/t/p/w780/44rM9dBhNY8KB4FLQoyyFFLoHzD.jpg","genres":["драма","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"486684","ru":"Отголоски войны","en":"Aux","year":"2018","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6jPaPjzgbSUwfkyJKV4SpzWMJWH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vCpPohnXhP8y4p3m4If2xMBfQlG.jpg","genres":["ужасы","боевик","триллер"],"overview":"Действие разворачивается в Великобритании. Два подростка, играя на опушке леса, случайно находят старый подземный бункер, открытие которого приводит к появлению Боба Пирса — призрака британского солдата времен Второй мировой войны. Считая, что нацисты вторглись в Англию, он начинает убивать всех людей, которые попадаются на его пути. Количество смертей растет ежедневно, а остановить призрака не представляется возможным, поэтому полиция неохотно соглашается доверить это дело Джеку — ветерану войны, который утверждает, что способен прекратить бойню.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"573610","ru":"Солнечная семья","en":"썬키스 패밀리","year":"2019","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/tKq9w3g3I6ZFcqgP4MTOM72KrIP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qrsmrRjjWTeC7d3CH3UaP9RFgHx.jpg","genres":["комедия","семейный","драма"],"overview":"История о жизнерадостном семействе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"168273","ru":"Библиотечная война: Крылья революции","en":"図書館戦争 革命のつばさ","year":"2012","type":"Мультфильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/2Xeuh79j2N2Ag9P5QP2C3qVHNyR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f1CjCd3HAQGrhNlN902gBlNv9Z1.jpg","genres":["боевик","мультфильм","фантастика","мелодрама"],"overview":"В 2019 году закон угрожает подавить свободу выражения мыслей. Ику Касахара вступает в библиотеку Сил обороны Канто, военное подразделение, предназначенное для защиты книг от конфискации. Тем не менее, она считает, что работа мечты ее детства гораздо труднее, чем она себе представляла.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"632464","ru":"Доза счастья","en":"Доза щастие","year":"2019","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/3aHwSFGJF0XPVRynrh83vj8M0II.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gXsBmxVL0BuseS8afWLMGvSb9k5.jpg","genres":["драма"],"overview":"Веселе 22 года, у нее нет образования и мужа, но есть маленькая дочка и желание сделать ее счастливой. Увы, девушка попадает в большие неприятности, и ей не сразу удается вырваться из порочного круга. Ее жизнь рушится, а самая страшная зависимость – героиновая – усугубляет все еще сильнее. Эта история о пути в бездну и еще одном пути обратно. После наступления темноты всегда есть свет, даже если кажется, что все потеряно.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"83216","ru":"Red Table Talk","en":"Red Table Talk","year":"2018","type":"Сериал","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/9MFH6LriSscCg9HiGeLam78KfBV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8Zm2LR8YmGMF67Oofc9FdBSw1WM.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"600730","ru":"Psycho Stripper","en":"Psycho Stripper","year":"2019","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/1OxDf7HV9FEMkVrafx6U9W1QcRy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/twgzKyGAw1EGdkqyjEHHd3Y5Aj0.jpg","genres":["телевизионный фильм","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"412444","ru":"4 Days","en":"4 Days","year":"2016","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/fJRmSG4PBCq3UCR5Cyo3vTrNytp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yY0rD9C0o7iXEVKciDpxDeSf2Da.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278488","ru":"Beste Chance","en":"Beste Chance","year":"2014","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/zL3eUX4zjlFu7pDlLnaYnbmxNB2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wUTlnXmmsfVlMFKe9sZ7fG1dmpG.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"412524","ru":"Fishes 'n Loaves: Heaven Sent","en":"Fishes 'n Loaves: Heaven Sent","year":"2016","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/bHTpgkqvUeCiXmG0T3pprGuDe3G.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8cVq38MqnoBcPK8t0j6Y42RdgC.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"428014","ru":"메리 크리스마스 미스터 모","en":"메리 크리스마스 미스터 모","year":"2017","type":"Фильм","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/9qzdcIxgnzAlV6rZpXF2WkN7To8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wKVpwjrIlFEDOsJLW5xQMdHCjuO.jpg","genres":["комедия","драма"],"overview":"","