Yv5guMPi1Hm3yM.jpg","genres":["фантастика","мультфильм","боевик","приключения","военный","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"123951","ru":"超人ロック","en":"超人ロック","year":"1984","type":"Аниме","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/1IaEC05NObDqR2yHjQLKGcxpb9B.jpg","genres":["мультфильм","фантастика","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"410422","ru":"FASTENING DAYS","en":"FASTENING DAYS","year":"2014","type":"Аниме","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/a2mvrLKx3zJcC3DRaLf6eQSjrwh.jpg","genres":["мультфильм","приключения","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_259101","ru":"ラブひな Again","en":"ラブひな Again","year":"2002","type":"Аниме","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/xLqqR3lcMDvLukTtTpM5yXQwXwY.jpg","genres":["комедия","мультфильм","драма","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"748898","ru":"Вместе на Рождество","en":"Christmas Together","year":"2020","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/MKgopT6vlEc6aUR71MUOs7SCaR.jpg","genres":["мелодрама","телевизионный фильм"],"overview":"Эйва живёт в Нью-Йорке, но на Рождество решает отдохнуть от суеты и проблем большого города и едет в \"мировую столицу Рождества\", городок Тинсел. Там она знакомится с очаровательной девочкой, которая сдаёт ей в аренду гостевой домик, и влюбляется в её отца.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"716330","ru":"Бирьяни","en":"ബിരിയാണി","year":"2021","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/84P7wkgaNEKSlnz9lr8DTC5XMZt.jpg","genres":["драма"],"overview":"В фильме прослеживается история жизни замужней женщины-мусульманки, запертой в четырёх стенах семейного дома и вынужденной скрывать свои желания в угоду религиозным и общественным нормам. Когда по прихоти судьбы она оказывается предоставлена сама себе, женщина выбирает радикально иной способ финансового и сексуального освобождения - она становится проституткой. Однако вскоре понимает, что душа её так и не обрела покоя. В поисках новой надежды она решает воздать по заслугам тем силам, которые обрекли её на жизнь, полную унижений и горя.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1057635","ru":"Беспринципные в деревне","en":"Беспринципные в деревне","year":"2023","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/8IcpIQerWcxEzzj9yUWiClGA5hM.jpg","genres":["комедия"],"overview":"Отставному генералу Хадякову стукнуло 60 лет, и он решает отпраздновать юбилей не на Патриках, а в настоящей русской деревне — с полным погружением, праздничной трапезой, баней, рыбалкой и деревенским спа. Приглашены все любимые герои, но праздник идёт не по плану. Жители Патриков умудряются настроить против себя местных жителей, переругаться между собой и остаться без пропитания...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"747993","ru":"Сасаки в моей памяти","en":"佐々木、イン、マイマイン","year":"2020","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/5Alqtrr0ed8hWNipVFm54BBSbyN.jpg","genres":["драма","мелодрама"],"overview":"27-летний Юдзи Митани приехал в Токио, чтобы стать актером, но так и остался невостребованным. Отношения с девушкой практически разрушены, жизнь пуста и бесцветна. Однажды Юдзи воссоединяется с одноклассником Тада и вспоминает свои дни с Сасаки, который был чрезвычайно харизматичным человеком в школе. Сасаки всегда очаровывал окружающих своей взрывной энергией. Однако дружба постепенно начала рушиться после одного события, постигшего Сасаки. Репетируя новую роль, Юдзи чувствует, что содержание сцены связано с его прошлым и настоящим. Более того, застойная повседневная жизнь постепенно меняется, и впервые за несколько лет ему звонит Сасаки.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1235431","ru":"【推しの子】-The Final Act-","en":"【推しの子】-The Final Act-","year":"2024","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/5V24N6J7zqJ1IaahM97Asg72jJX.jpg","genres":["драма","музыка","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1224392","ru":"فاصل من اللحظات اللذيذة","en":"فاصل من اللحظات اللذيذة","year":"2024","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/7V6aeiGDJMlV70dY8Xt7Nt9iJKm.jpg","genres":["комедия","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"936667","ru":"നരിവേട്ട","en":"നരിവേട്ട","year":"2025","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/3xhdWk6y5hVUAOhW7MsBMA7wb10.jpg","genres":["драма","боевик"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"749078","ru":"蛇王","en":"蛇王","year":"2020","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/wBRFqF6YVSLFW4EYvXq9Vo0f10r.jpg","genres":["боевик","триллер","приключения","фэнтези","ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"881687","ru":"Alles in bester Ordnung","en":"Alles in bester Ordnung","year":"2022","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/ayLWtnKZ6Yyla7XLxXNo3K7JYqS.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"717689","ru":"El año de la furia","en":"El año de la furia","year":"2021","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/qmJLT7KAZf1V2QgQ3WIUqWNVyeQ.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"916426","ru":"Alle reden übers Wetter","en":"Alle reden übers Wetter","year":"2022","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/XSF0B6erRaFC6zU7nnShNPUYUd.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"60748","ru":"Кап Дон","en":"갑동이","year":"2014","type":"Сериал","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/uPNNdf7RXE2152KvaxcBNdAIG9E.jpg","genres":["криминал","драма","детектив"],"overview":"«Кап Дон» — это криминальная драма, главным героем которой является детектив Му Ём (Юн Сан Хён), цель жизни которого — поймать убийцу Кап Дона. 20 лет назад отец Му Ёма был подозреваемым по делу серийного убийцы Кап Дона. Из-за огромного давления, оказываемого на него детективами, расследующими это дело, отец Му Ёма кончает жизнь самоубийством. Будучи детективом, он безрезультатно пытается достичь своей цели, но, когда дело закрывают за истечением срока давности, он уходит в отставку с убеждением, что Кап Дон мертв. Однако вдруг появляются новые улики, свидетельствующие о деятельности серийного убийцы, и Му Ём вновь горит желанием поймать его раз и навсегда. Сериал основан на серийных убийствах, совершенных в Хвасоне с 1986 по 1991 год","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"401392","ru":"Нарушенное обещание","en":"Broken Promise","year":"2016","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/fgCpwhzeKrPDXYZSuwgEDQNd7Ps.jpg","genres":["телевизионный фильм","триллер"],"overview":"Группа старшеклассников врывается в старый дом, где они убивают хозяина. Двадцать два года спустя члена банды, который взял убийство на себя, выпускают из тюрьмы и он будет искать других...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"41018","ru":"Криминальный кроссворд: Висмар","en":"SOKO Wismar","year":"2004","type":"Сериал","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/jvc2fWkPfr5CdiK18k9VOM6xYZ5.jpg","genres":["криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"671622","ru":"처제의 비밀","en":"처제의 비밀","year":"2019","type":"Фильм","rating":6.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/ib7jFLnrI7KLbGa1GeZ9ZCuoWgO.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}