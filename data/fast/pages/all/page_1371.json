":"","studio":"","country":"","ageRating":""},{"id":"810499","ru":"The Gingerweed Man","en":"The Gingerweed Man","year":"2021","type":"Фильм","rating":2.1,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/uCPdqe6MzGeb5PhXHWsOE4eVclD.jpg","genres":["комедия","ужасы","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"216115","ru":"Abelhinhas","en":"Abelhinhas","year":"2007","type":"Мультфильм","rating":2.1,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/jykbvInQKrztF0P9IXtpBZ090dV.jpg","genres":["мультфильм","комедия","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"661397","ru":"ധമാക്ക","en":"ധമാക്ക","year":"2020","type":"Фильм","rating":2.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/yk3Lb70tZ5NH6mTf90E9e1NQDht.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"575328","ru":"Конец сезона","en":"Конец сезона","year":"2019","type":"Фильм","rating":2.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/564g6grDNZFeW92rumW4YXV36Mp.jpg","genres":["триллер","мелодрама"],"overview":"Три сестры волею обстоятельств оказались за пределами России и живут в маленьком прибалтийском городке. Они, как и героини знаменитой пьесы Антона Павловича Чехова, живут мечтой о возвращении в Москву и ищут любовь, однако у судьбы на них свои планы. Одну никак не оставляет прошлое, другая ищет простого женского счастья, а у третьей — кризис семейной жизни. Тем временем, на тихом побережье появляется опасный убийца… Светлая меланхолия сменяется взрывами человеческих эмоций и нешуточной борьбой за жизнь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"496432","ru":"Fate／Grand Order × 氷室の天地 ～７人の最強偉人篇～","en":"Fate／Grand Order × 氷室の天地 ～７人の最強偉人篇～","year":"2017","type":"Мультфильм","rating":2.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/6Wz6J7gtUi2WNUf9Wv1ZGCX5TWm.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"341005","ru":"The Pickle Recipe","en":"The Pickle Recipe","year":"2016","type":"Фильм","rating":2.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/hc4khIc9IVoZtJCfmF9CXrYwKoD.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"414687","ru":"Код Каина","en":"Код Каина","year":"2015","type":"Фильм","rating":2.0,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/lvsxWTXxUIMCrtqwckeWbkltrb.jpg","genres":["боевик","триллер","драма"],"overview":"В основе сюжета лежит Библейская история о Каине и Авеле, которая вновь оживает в современном мире. Успешная американская журналистка Сара Огден — агент тайного общества, которое исследует «Код Каина» — ген, толкающий человека на путь ненависти, предательства, убийства, несущий угрозу всему мирозданию. Для выполнения очередной миссии Сара отправляется в Восточную Европу на поиски носителя рокового гена. Удастся ли разрешить конфликт, когда ошибки уже допущены, обида нанесена и гнев, словно бушующее пламя, охватывает души и сердца людей? Смогут ли силы любви и примирения предотвратить трагедию или жестокого финала не избежать?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"793835","ru":"The Leprechaun's Game","en":"The Leprechaun's Game","year":"2020","type":"Фильм","rating":2.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/omd0aGr8QDDr7lBqrBJ6HveFzV0.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1242590","ru":"Nyctophobia","en":"Nyctophobia","year":"2024","type":"Фильм","rating":2.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/pNRzv6QLNenx7in2VKLuHjOoXEB.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"767246","ru":"廢棄之城","en":"廢棄之城","year":"20