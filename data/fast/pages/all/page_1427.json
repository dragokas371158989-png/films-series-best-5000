ержится в стороне от происходящего, вызывая ещё большее недоверие. После казни односельчан и подозрений в предательстве Кузьмич соглашается стать проводником для немецкого отряда, якобы чтобы получить лошадь и спасти семью. Однако на самом деле он задумывает жертвенный обман: через внука Ваську передаёт советским бойцам сведения о маршруте врага. В решающий момент Кузьмич уводит немецких егерей в ловушку, повторяя подвиг Ивана Сусанина. Старик ценой собственной жизни приводит врага к гибели, становясь символом народного сопротивления.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1662256","ru":"勇者无疆","en":"勇者无疆","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/5ENxl6xf3YUpcoUFVz4AebdHVi4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fArULAIfPBG6mRMX6yXjslK1kWP.jpg","genres":["Драма","Военный","История"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"279435","ru":"ฝนล้านฤดู","en":"ฝนล้านฤดู","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/4ILYm2njTjtQxiLF2PTKPdoSE31.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2L9XOoeS53t1ozTJI3a3YbXL8yR.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"319855","ru":"One Day in My Body","en":"One Day in My Body","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/eKIsEY5ApLGJCtdbFbzymza0vrU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xCIILTz1FL5ac4kQjwtCsdssWjh.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"321844","ru":"Talking Pictures: A Movie Memories Podcast","en":"Talking Pictures: A Movie Memories Podcast","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/2tuE80C6hjRtBAQTe54HgUvnLbJ.jpg","backdrop":"https://image.tmdb.org/t