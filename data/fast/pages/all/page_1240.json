/w342/iddfS5fGtMeI2oexwCl7xPhBuhS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mvyh8tXxuuaAFGR6QGQEbxfsd1s.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"411442","ru":"Расхитители времени","en":"盗墓笔记","year":"2016","type":"Фильм","rating":5.3,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/qtbJL3pWPJIO8KGqZpRLEn4jmQp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/96SopW64ZEipVXtPzHb3pOERtWu.jpg","genres":["боевик","приключения","фэнтези","ужасы"],"overview":"Тайное общество расхитителей гробниц \"Девять Семей\" многие столетия заняты своим ремеслом. У Се, молодой наследник торговой династии У, с детства был очарован древними артефактами и мечтал о приключениях. В руки У Се попадает ключ к гробнице древнего мастера Железной Маски. У Се отправляется в пустыню Гоби в поисках мифической страны Тамуто и скрытого города Змеиной Царицы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"104272","ru":"Чёрная магия 2","en":"勾魂降頭","year":"1976","type":"Фильм","rating":5.3,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/6BAaMwVQiyBgdF9kTFsd0fQCxsw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jkQAG5wj7QF7PtF6tzIy1eCswS2.jpg","genres":["ужасы"],"overview":"Врачи замечают, что с пациентами происходит нечто сверхъестественное. Бедолаги превращаются в зомби с шипами голове, а когда их удаляют, пациентов тошнит червями, они воспламеняются и взрываются. В ответе за всё происходящее — один ведьмак, но никто из врачей этому не верит. Кто-то должен остановить его и доказать, кто вызвал все эти кровавые причуды.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"63869","ru":"Пластиковое море","en":"Mar de plástico","year":"2015","type":"Сериал","rating":5.3,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/tQzJVV3VCgnHFezF6LhXsETtUm6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yHRwMJWBHvQVof4Izh0mlfgaeOf.jpg","genres":["криминал","детектив","драма"],"overview":"Убийство молодой девушки в Кампоамарго усугубляет расовую напряжённость, которая существует между различными группами, проживающими в городке. Найти убийцу и выяснить мотивы преступления предстоит новому начальнику судебной полиции Эктору Агирре и его команде.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"592678","ru":"Baby Phone","en":"Baby Phone","year":"2017","type":"Фильм","rating":5.3,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/xukrrM9LDzmvz4J2JifFRJEWlFt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9p2oeXK1xMKUuZaEZkxnaxVhpw7.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"42076","ru":"Хармагеддон","en":"幻魔大戦","year":"1983","type":"Аниме","rating":5.3,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/vSIAYwLPS9QD9xtF9yw2I5J6laY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rQEU3aDET3vXTCb1uHQgtQ75VZh.jpg","genres":["ужасы","боевик","мультфильм","фэнтези","фантастика","Аниме"],"overview":"Задолго до начала времен, когда Солнечная система была лишь облаком межзвездной пыли среди ледяного безмолвия хаоса, Великий Генма, чудовищное воплощение вселенского зла, вел яростную битву против всего сущего, поклявшись превратить космос в мертвое Ничто. Миллиарды лет, порабощая тела невинных и подчиняя себе стихии, бесформенный ужас пожирал галактики и созвездия, и теперь на его пути стоит хрупкая и одинокая планета Земля, чья единственная надежда — горстка загадочных сверхлюдей. Эти бесстрашные и мудрые воины способны одним усилием воли воздействовать на предметы с сокрушительной силой, и скоро их ряды пополнят новички, еще не подозревающие о своих способностях — прекрасная и грозная трансильванская принцесса Луна и простой японский школьник Джо. Когда Нью-Йорк будет лежать в руинах, а Токио превратится в песчаную пустыню, они, познав всё могущество своих удивительных сил, вместе с древним боевым роботом Вегой и собратьями воинами выйдут на решающую битву с Великим Генмой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"784696","ru":"Финансовая пирамида","en":"సర్కారు వారి పాట​","year":"2022","type":"Фильм","rating":5.3,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/jFwdKKDmgzKjZGFnSJma7I5XMpk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jNcf5p8y7CieOu9uHYzTVm1Qgtm.jpg","genres":["боевик","комедия","драма"],"overview":"Правительство поручило банковскому менеджеру привлечь мошенника к ответственности.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"662399","ru":"Уроки итальянского","en":"Italian Studies","year":"2022","type":"Фильм","rating":5.3,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/4CfPxOcz4rlQdiNa4qin4tJAvPr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e5XIgJd98MZEZTz6VhxpiG10BhG.jpg","genres":["драма"],"overview":"Молодая писательница внезапно теряет память. Оказавшись в Нью-Йорке, она общается с группой подростков. В разговорах — как реальных, так и воображаемых — она ищет путь домой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"590397","ru":"भुज: द प्राइड ऑफ इंडिया","en":"भुज: द प्राइड ऑफ इंडिया","year":"2021","type":"Фильм","rating":5.3,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/sdWesowyWuM2C5FjNkF589lGiu7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Aoq4QMrrBJcFt6WQcwj6px2LXQp.jpg","genres":["военный","история","боевик","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"87208","ru":"Зубастики: Новый загул","en":"Critters: A New Binge","year":"2019","type":"Сериал","rating":5.3,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/8J6wvQIhXneFS1w5tcJX3xD6rYG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/h9UzBXNr8rNwSpld4fcCiTELiUf.jpg","genres":["комедия","НФ и Фэнтези"],"overview":"Зубастики возвращаются на Землю в поисках сородича, оставленного на планете много лет назад во время миссии. Они приземляются в Калифорнии и тотчас начинают охоту на группу старшеклассников и их семьи.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"88366","ru":"Чеканутики","en":"Lunatics","year":"2019","type":"Сериал","rating":5.3,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/b1XdwJT0oB13MnJWaoailWuvB3Q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/itvp9uJwVKlUgLl4gZpNXwLCmyk.jpg","genres":["комедия"],"overview":"В центре сюжета жизнь шести эксцентричных людей, обитающих в разных концах мира. Успешный торговец модной одеждой Киф открывает новый магазин под крайне оригинальным и примечательным названием, имеющим прямую отсылку к его диагностированным сексуальным расстройствам. А ещё Киф очень любит свой кассовый аппарат, буквально. Бэки — невероятно высокая студентка американского колледжа с огромного размера ногами. Гэвин — проблемный подросток и будущий граф сельского поместья где-то в Англии, борющийся с моральным давлением своих больших перспектив и просто пытающийся быть ребёнком. Лесбиянка-медиум Джена страдает от безответной любви к своей помощнице. Риэлтор Куинтин, обладающий одной частью тела очень незаурядного размера, мечтать стать всемирно известным диджеем и граффити-художником. Сумасбродная затворница и собирательница всякого хлама Джойс когда-то была большой звездой фильмов для взрослых, а сейчас ей грозит выселение из дома.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"298094","ru":"我為卿狂","en":"我為卿狂","year":"1991","type":"Фильм","rating":5.3,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/1tQM77zgd3XKRnF1JtgH4EFyoHN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zAPnGBjapcXU5rF2oSJWcStLYCj.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"79723","ru":"The Cool Kids","en":"The Cool Kids","year":"2018","type":"Сериал","rating":5.3,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/m0EqmQqCQ5zkofwkVwoB5chod