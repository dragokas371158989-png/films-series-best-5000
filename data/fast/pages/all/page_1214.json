org/t/p/w342/sqPakE91yGAKSwL4Fzrq5x4RLQl.jpg","genres":["мультфильм","семейный","музыка","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"156497","ru":"You're Too Careless with Your Kisses!","en":"You're Too Careless with Your Kisses!","year":"1932","type":"Мультфильм","rating":5.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/jsFwbKtupZNANQgaPBX5YXdT5wa.jpg","genres":["мультфильм","комедия","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_95203","ru":"Любовь Влады","en":"ぶらどらぶ","year":"2021","type":"Аниме","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/iMyjPpLKGQMlBDVYPJO4CQB8NN4.jpg","genres":["мультфильм","комедия","НФ и Фэнтези","Аниме"],"overview":"Мицугу Банба - старшеклассница, которая находит смысл в сдаче крови. Она часто сдаёт кровь, несмотря на жестокое обращение медсестры. Однажды она встречает красивую девушку, которая выглядит так, как будто она приехала из-за границы. Бледная девушка выглядит так, будто вот-вот упадет в обморок. Девушка теряет сознание, и Мицугу забирает ее домой...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_38811","ru":"Драконий кризис!","en":"ドラゴンクライシス！","year":"2011","type":"Аниме","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/xKxlszugzZK9CV1xbGxiDTfvBVs.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","Аниме"],"overview":"Школьник Рюдзи Кисараги с подачи своей двоюродной сестры Эрико Нанао (и при её непосредственном участии) прямо из-под носа у контрабандистов похищает какой-то ящик. Открыв его, молодые люди видят девушку лет 14 — с золотистыми волосами и небесно-голубыми глазами. Впоследствии Рюдзи узнаёт, что девушка — никто иная как «Дракон», сказочное создание, которое моментально привязывается к своему спасителю и не отходит от него ни на шаг. И всё бы хорошо, но организация, у которой Рюдзи с Эрико похитили девушку, хочет вернуть её обратно","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1049574","ru":"Тьма человека","en":"Darkness of Man","year":"2025","type":"Фильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/rgqTfBKSveOMeM0z4JC8qdKMvbk.jpg","genres":["боевик","криминал","триллер"],"overview":"Рассел Хэтч — оперативник Интерпола, который берет на себя роль отца Джейдена, сына информатора, убитого в ходе неудачного рейда.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"724109","ru":"구멍동서","en":"구멍동서","year":"2020","type":"Фильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/ZAhAOX5RsstfrbLtkSjiUZGgw2.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"669146","ru":"జాను","en":"జాను","year":"2020","type":"Фильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/2koyOXlN9mJF0CmWkiGs7IqP0ZI.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"971470","ru":"Romantic Rewrite","en":"Romantic Rewrite","year":"2022","type":"Фильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/cHqEwXUShYuVpTaUTsyDgaUmmRA.jpg","genres":["телевизионный фильм","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"652535","ru":"Alle utlendinger har lukka gardiner","en":"Alle utlendinger har lukka gardiner","year":"2020","type":"Фильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/6Y06Wt6PlJOcP0A2JYlUh24u4LL.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"434395","ru":"Сатакарни, сын Гаутами","en":"గౌతమిపుత్ర శాతకర్ణి","year":"2017","type":"Фильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/8Mb7hg3zvrrMfJioJNivxK3NFP4.jpg","genres":["история","драма","боевик"],"overview":"Действие фильма разворачивается в самом начале второго века нашей эры. Где-то на полуострове Индостан раскинулось государство, которым управляет юный представитель династии Сатаваханов. Когда на государство махараджи напали враги, он отказался сдаваться. Сын царицы Гаутами никогда не идёт на уступки, борясь с захватчиками до последней капли крови. Вместе со своей конницей ему предстоит пройти сотни и даже тысячи километров в погоне за врагами. За двадцать долгих лет махараджа не отдал ни пяди земли ни скифам, ни парфянам, ни другим наглым захватчикам…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"35715","ru":"Робот Арк","en":"Ark","year":"2005","type":"Мультфильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/6eBHlLwwqBv8q4h8QrUdllu4I5k.jpg","genres":["боевик","мультфильм","драма","фантастика"],"overview":"Страшная катастрофа грозит планете Алцион. Остатки двух ее цивилизаций укрылись под защитным куполом в единственном городе — столице, расположенной на спине гигантского робота по имени Арк. Он был создан Цивианами с помощью загадочной богини Амео, но воинственные Сториане захватили Арка, вытеснив Цивиан в пустоши и поработив их. Однако без Амео, погибшей при схватке, робот остается недвижим, и все попытки Сториан запустить механизм тщетны. Два народа обречены на гибель, ведь Арк — их единственный путь к спасению, последняя возможность выбраться с умирающей планеты… Но таинственная девушка Эмерит дарит жителям Алциона новую надежду.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"398034","ru":"வேலைன்னு வந்துட்டா வெள்ளக்காரன்","en":"வேலைன்னு வந்துட்டா வெள்ளக்காரன்","year":"2016","type":"Фильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/wG8Xhce2VRlJrHBguj5MKfS9hZF.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"643437","ru":"Adan","en":"Adan","year":"2019","type":"Фильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/2o5FRs33XeQsmshEYhmXMcD6Z45.jpg","genres":["драма","триллер","мелодрама","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"44486","ru":"Mars","en":"Mars","year":"2010","type":"Мультфильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/niS8i4Hc2wK9bA4MDtEoQfj2T8X.jpg","genres":["мультфильм","комедия","мелодрама","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"650380","ru":"From the Vine","en":"From the Vine","year":"2019","type":"Фильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/nyEWowhsJuAZxKdeC8rxcW1yNsc.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"83796","ru":"Hell-Bent for Election","en":"Hell-Bent for Election","year":"1944","type":"Мультфильм","rating":5.6,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/hZiWB42bTpYtP0mxM7eNLYoa9Jb.jpg","genres":["мультфильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_13224","ru":"Истории Мейпл-тауна","en":"メイプルタウン物語","year":"1986","type":"Аниме","rating":5.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/4GG3mBDlM9NpRG1Puj7PKLHyPnD.jpg","genres":["мультфильм","Боевик и Приключения","Аниме"],"overview":"Действие происходит в Соединённых Штатах в 1920-е годы. Здесь среди дремучего леса располагается маленький городок Мейпл-таун, который населяют маленькие и дружелюбные зверьки. Туда приезжает крольчиха Пэтти вместе со своими родителями, однако в поезде сумку отца крадёт злой волк-разбойник Гретель и сбегает в лес. Она в одиночку отправляется в лес, где случайно знакомится с медвежонком Бобби, вместе они перехитрили волка и возвращают папину сумку. Семья крольчихи начинает работать почтальонами, а между Пэтти и Бобби образуется крепкая дружба. В то же время им предстоит срывать корыстные планы Гретеля.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"89095","ru":"Полли Покет","en":"Polly Pocket","year":"2018","type":"Аниме","rating":5.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/gGZsmoZ0Qd1WMX1WW1Dgy2LcR3m.jpg","genres":["Детский","мультфильм","Аниме"],"overview":"Приключения находчивой девочки Полли, которая доказывает, что сильным может быть даже самый маленький человек. Взрослые часто говорят Полли, что она ещё слишком мала, чтобы делать всё, что ей хочется. Но Полли доказывает, что быть маленькой — это не ограничение, а наоборот, большой плюс. Это её главная сила! Однажды героиня наследует волшебный медальон, который уменьшает её до размеров 10 сантиментов. Благодаря этой способности Полли и её друзья постоянно попадают в классные приключения и решают проблемы необычным способом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"55430","ru":"Сломанный меч 2","en":"劇場版 ブレイク ブレイド 第二章「訣別ノ路」","year":"2010","type":"Аниме","rating":5.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/9scWJkRwBKlFCLWU3juCUHtgvfO.jpg","genres":["мультфильм","боевик","фэнтези","Аниме"],"overview":"Противостояние двух держав не обошлось без вмешательства и третьей стороны, отсюда и мотивы действий Зесса, но он ещё не ведает условий сдачи короля Кришны, его некогда друга. Зессу предстоит встретить и ещё одного товарища, Райгата, того кому суждено тоже быть вовлеченным в этот конфликт и может быть прекратить ненужные кровопролития.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_34215","ru":"Идолмастер: Ксеноглоссия","en":"アイドルマスター ゼノグラシア","year":"2007","type":"Аниме","rating":5.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/n1nR7bqfBfy9FPXIrmaspnNzhc1.jpg","genres":["Боевик и Приключения","мультфильм","комедия","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"393808","ru":"スターフォックス ゼロ ザ・バトル・ビギンズ","en":"スターフォックス ゼロ ザ・バトル・ビギンズ","year":"2016","type":"Аниме","rating":5.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/jL92TBCND4JPtMonAe7SkFoNj9q.jpg","genres":["фантастика","мультфильм","боевик","приключения","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"854207","ru":"Любовь на плаву","en":"Love Afloat","year":"2022","type":"Фильм","rating":5.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/vfQtbcFdKf7juAnX2JSUSvkl75V.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"Лорелея наследует старую лодку от дальнего родственника на карибском островке, и чтобы привести ее в порядок, она нанимает Роба. Работая вместе, они оба учатся видеть мир иначе, чем прежде и, кроме того, помогают друг другу осознать, что для них важнее всего.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1134607","ru":"Брачный уговор","en":"The Marry Me Pact","year":"2023","type":"Фильм","rating":5.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/4gZYMOKK0tlzF7RADzGAmYMxQMj.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"Шарлотт и Рори - лучшие друзья, и на свое 30-летие Рори отправляется путешествовать по миру. Год спустя Шарлотт посещает ясновидящую, которая говорит ей, что ей суждено быть с Рори, когда он вернется домой. Рори возвращается... но с невестой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"602623","ru":"오! 문희","en":"오! 문희","year":"2020","type":"Фильм","rating":5.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/pjqweWlZtgivZKDTG2moq8MpCxU.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"927068","ru":"Le variabili dipendenti","en":"Le variabili dipendenti","year":"2022","type":"Фильм","rating":5.6,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/ageBdUzbMuW1xuIhu5ITG4dNTvZ.jpg","genres":["д