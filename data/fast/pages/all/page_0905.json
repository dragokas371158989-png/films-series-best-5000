tps://image.tmdb.org/t/p/w342/gkWnjOb2QvA2b8onBbEKf9o2JKw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tnf1NFPb3EsyO5eob0K1hquXJmt.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"281671","ru":"WWE Superstar Profiles","en":"WWE Superstar Profiles","year":"2025","type":"Сериал","rating":8.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/wTOC5twk3sWIX2JEM99aeJHBuaK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uR75laUljquG2D9bKjEawvZoY0L.jpg","genres":["Боевик и Приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"85226","ru":"Гранд","en":"Гранд","year":"2018","type":"Сериал","rating":8.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/4v9JvjgU5HOiaOKbTzoqtXATh6c.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ekA1LDz53UCazz7GarKNvIEWAul.jpg","genres":["комедия"],"overview":"Амбициозная и склонная к авантюрам студентка пятого курса Алтайского университета туризма и отдыха Ксения Завгородняя мечтает работать в гостиничном бизнесе и открыть собственный отель. Но навязчивое внимание ректора ставит под угрозу не только планы Ксюши, но и ее дальнейшее обучение в ВУЗе. Девушка находит смелый, но очень скандальный выход из ситуации, после которого ей приходится спасаться бегством из Барнаула. Ксюша отправляется в Москву в надежде устроиться портье в отель, где работает ее родственник.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"95718","ru":"グランメゾン東京","en":"グランメゾン東京","year":"2019","type":"Сериал","rating":8.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/2BkkqUop7NM4BfStDi67VHjl21R.jpg","backdrop":"https://image.tmdb.org/t/p/w780/r8f2xmBQlmRpo9tvRwy73CoF972.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1369595","ru":"По ту сторону","en":"Del otro lado del jardín","year":"2024","type":"Фильм","rating":8.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/axujDwRWO7K5HSvzvLfZoXbeVbh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nycI0r92qCelKsEF7OCf4qHFwyy.jpg","genres":["драма","триллер"],"overview":"Сорокалетний поэт приходит в себя, прикованный наручниками к больничной койке. Его обвиняют в убийстве собственной матери, но он настаивает, что это был акт любви: он хотел одновременно помочь ей уйти из жизни и покончить с собственной.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"252257","ru":"Любимицы Америки: чирлидеры Dallas Cowboys","en":"AMERICA'S SWEETHEARTS: Dallas Cowboys Cheerleaders","year":"2024","type":"Сериал","rating":8.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/dM3fGD2uDhE9Z5HDieeWXhpXyG0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/68acEMclrbMs72aMIvzLxityMPN.jpg","genres":["документальный"],"overview":"Посмотрите, как девушки борются за место в команде чирлидеров «Даллас Ковбойс»: от кастингов и тренировок до выступлений во время сезона НФЛ.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"138211","ru":"Ракетостроители","en":"Rocket Boys","year":"2022","type":"Сериал","rating":8.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/mLtA1cAejDG4H67jf6RG6VbGbo3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kOGM01ZhELmJCxdVObqQbRwXXH3.jpg","genres":["драма"],"overview":"История двух выдающихся людей, Джехангире Бхабхи и Викраме Амбалала Сарабхаи, которые творили историю, строя будущее Индии!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"247293","ru":"Млекопитающие","en":"Mammals","year":"2024","type":"Сериал","rating":8.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/h5JJUuiJwcitSFzKG71YzchmUqy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cgkVxjkEpjaY5K64a3goQRKeToV.jpg","genres":["документальный"],"overview":"«Млекопитающие» — захватывающий документальный сериал, посвящённый самым адаптивным и разнообразным существам на планете. В шести эпизодах раскрывается, как млекопитающие покорили все уголки Земли — от ночных лесов и ледяных пустошей до океанских глубин и перегретых пустынь. Используя новейшие технологии съёмки, проект показывает, как эти животные выживали и эволюционировали в условиях суровой природы. Их интеллект, социальные связи и уникальные стратегии поведения делают млекопитающих выдающимися выживальщиками в быстро меняющемся мире.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_76345","ru":"On Cinema","en":"On Cinema","year":"2012","type":"Сериал","rating":8.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/4TDQEYCS8HmvY7d8udmeS2ILqFl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5xGt8gdGOvcYcoHlhw4g9Y14riz.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"85751","ru":"นักเรียนพลังกิฟต์","en":"นักเรียนพลังกิฟต์","year":"2018","type":"Сериал","rating":8.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/toppoIqScxltH2VrC1NyDC8ESzD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l4sGHBjwaOe5ijQrfM7Nc0mqbL4.jpg","genres":["драма","НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"39811","ru":"Hot Wheels AcceleRacers: The Speed of Silence","en":"Hot Wheels AcceleRacers: The Speed of Silence","year":"2005","type":"Мультфильм","rating":8.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/r38yDi0EnLENS7F5e8E6l3oYYty.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vqQxY69v1qsfQ4wEf7Gup0gC7Pi.jpg","genres":["мультфильм","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"140109","ru":"Письмо Дракуле","en":"Dear Dracula","year":"2012","type":"Мультфильм","rating":8.4,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/jC85KOW4bbo64TlxzkRk2NJyZFZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bRW1EXlsIrrOhuWTizNUSKrC6nE.jpg","genres":["мультфильм","семейный","комедия"],"overview":"Мальчик Сэм обожает рассказывать страшные истории и знает толк в розыгрышах. В канун праздника Хэллоуин он пишет письмо своему кумиру, графу Дракуле, и приглашает его в гости. Сэм мечтает от души повеселиться в компании вампира и до смерти напугать всех своих соседей. Наконец, в ночь празднования таинственный граф появляется на пороге дома мальчишки. Восторгу Сэма нет предела! Но вдруг выясняется, что самый опасный вампир всех времен не в состоянии внушить страх даже трехлетней девчонке!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"262929","ru":"Апокалипсис: Отель","en":"アポカリプスホテル","year":"2025","type":"Аниме","rating":8.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/ipJV6gE0yjef7cbN1JNRXS653z0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cSTqAOPhuApXcAzn2SoBo2Ffral.jpg","genres":["мультфильм","комедия","драма","НФ и Фэнтези","Аниме"],"overview":"После краха цивилизации среди руин Гиндзы, района Токио, стоит грандиозный отель. Природа постепенно захватывает город, и лишь этот одинокий отель продолжает отрицать исчезновение человечества. Текущее число гостей: ноль. Запланировано прибытий на сегодня: ноль. Число посещений сайта за вчера: ноль. Погрузитесь в загадочную историю жизни в мире, где от людей осталось лишь угасающее воспоминание…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_249972","ru":"九重紫","en":"九重紫","year":"2024","type":"Сериал","rating":8.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/tp7teAry9XV4qtZysvK3Po4hFIu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gtmkb7g4jMMhmnufsxkXtGEkcYk.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}