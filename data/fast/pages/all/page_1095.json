/image.tmdb.org/t/p/w780/kMFyijmY6NYHNi5olULk4C3wxXH.jpg","genres":["документальный","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1035264","ru":"KKN di Desa Penari: Luwih Dowo, Luwih Medeni","en":"KKN di Desa Penari: Luwih Dowo, Luwih Medeni","year":"2022","type":"Фильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/bS5JONb9Q5hYdOKkVL61HJcFITX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4BxazsGhdbqipop2ZObd0HXXZ1j.jpg","genres":["ужасы","детектив","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"615518","ru":"Пятнадцать мальчиков на произвол судьбы","en":"十五少年漂流記","year":"1982","type":"Мультфильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/v5MCcF2a9w7Fux1IweHkVxNKlrM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/73OuaAuyAqi29i7v3Mye1HJQ5sf.jpg","genres":["мультфильм","приключения","семейный","телевизионный фильм"],"overview":"Отряд детей от восьми до тринадцати лет, брошенных на остров, борющихся за жизнь среди страстей, подогреваемых различиями национальностей. История в стиле Робинзона Крузо, переосмысленная Жюлем Верном.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"592551","ru":"Импровизаторы","en":"jam","year":"2018","type":"Фильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/hB2w5hq3GfQOUwGsmwBngU3GVOi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vKt9Ip6rfyipRRZkUmnuOfKFmdh.jpg","genres":["криминал","комедия","триллер"],"overview":"У исполнителя фольклорных баллад Хироси множество пожилых поклонниц. Такэру верит, что если будет делать добрые дела, то свершится чудо и его девушка выйдет из комы. Тэцуо отомстил якудза, которые упекли его за решётку, а оставшиеся теперь устроили на него охоту. Пути всех троих пересекаются и ведут к неизбежной развязке.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"434229","ru":"다른 길이 있다","en":"다른 길이 있다","year":"2017","type":"Фильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/c1rQOgc4JNrMFP88ifZZexdcNf9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6DMvrdyF7Fz5YsOXHa6CQDblwj.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"369124","ru":"陪安东尼度过漫长岁月","en":"陪安东尼度过漫长岁月","year":"2015","type":"Фильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/chMBlvYy7Go7WaLXDL3zlva2LE2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vRWH3LpSPpGdUjYdRk3elh8G9NX.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"565748","ru":"JKエレジー","en":"JKエレジー","year":"2019","type":"Фильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/dIa5nrloZJ7m1tEU7Jt3sWk6OsS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7JLSDmzuEaF3denyVHmLANNNtVf.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}