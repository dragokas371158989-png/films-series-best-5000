es":7,"poster":"https://image.tmdb.org/t/p/w342/hB2w5hq3GfQOUwGsmwBngU3GVOi.jpg","genres":["криминал","комедия","триллер"],"overview":"У исполнителя фольклорных баллад Хироси множество пожилых поклонниц. Такэру верит, что если будет делать добрые дела, то свершится чудо и его девушка выйдет из комы. Тэцуо отомстил якудза, которые упекли его за решётку, а оставшиеся теперь устроили на него охоту. Пути всех троих пересекаются и ведут к неизбежной развязке.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"434229","ru":"다른 길이 있다","en":"다른 길이 있다","year":"2017","type":"Фильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/c1rQOgc4JNrMFP88ifZZexdcNf9.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"369124","ru":"陪安东尼度过漫长岁月","en":"陪安东尼度过漫长岁月","year":"2015","type":"Фильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/chMBlvYy7Go7WaLXDL3zlva2LE2.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"565748","ru":"JKエレジー","en":"JKエレジー","year":"2019","type":"Фильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/dIa5nrloZJ7m1tEU7Jt3sWk6OsS.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"473410","ru":"Piazza Vittorio","en":"Piazza Vittorio","year":"2017","type":"Фильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/aKnzQbZAMRIyLJjcWyydAsAxEBn.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"400656","ru":"Oliver and the Artful Dodger","en":"Oliver and the Artful Dodger","year":"1972","type":"Мультфильм","rating":6.5,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/2WobeG2DmGwiDY8PUr5INB8ZFVu.jpg","genres":["мультфильм","приключения","драма","семейный","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"72511","ru":"Семь — верно, три — неверно","en":"ナナマル サンバツ","year":"2017","type":"Аниме","rating":6.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/qEoTBRocCmdqDLTSQe2ZRVZfVBk.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"При поступлении в старшую школу «Будзо» Сики Косияма меньше всего ожидал приглашения в таинственный клуб викторин во главе с Гакуто Сасадзимой. Скромный любитель книг, Сики ненавидит быть в центре внимания, а одна только мысль об участии в каких-либо соревнованиях претит ему до глубины души. И будто того мало бедолаге, на одном из отборочных турниров одноклассница парня Мари Фуками поражает всех, нажав на гудок прежде, чем вопрос оглашают до конца. «Если знаешь ответ на вопрос, нажимать на кнопку — слишком поздно! — заявляет девушка и с ещё большей решимостью добавляет: — Мне хватит и доли секунды, чтобы определить, кто выиграет, а кто — проиграет». Какие же открытия ждут Сики после того, как он, по просьбе этой боевой единицы, попадёт в ослепительный мир конкурсных викторин?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"42408","ru":"はなまる幼稚園","en":"はなまる幼稚園","year":"2010","type":"Аниме","rating":6.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/wkTYpjU5RPxhRlLNPhFbH3py3m1.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"211892","ru":"Одноцентовый вор","en":"One Cent Thief","year":"2022","type":"Сериал","rating":6.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/sw5QIK9ctfMCgi2IrBw8WH6U6M7.jpg","genres":["Боевик и Приключения","криминал","драма"],"overview":"Молодой, амбициозный банкир, которому отчаянно нужно было вылечить больного отца и восстановить чувство собственного достоинства, начал воровать по 1 центу с чужих банковских счетов.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"111414","ru":"Яркое пламя","en":"Alev Alev","year":"2020","type":"Сериал","rating":6.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/r8vnn1p8qcus1nWvCF3QzJgWmU1.jpg","genres":["драма"],"overview":"Рия, Чичек и Джемре совершенно не похожи друг на друга. У каждой своя жизнь, свои взгляды на жизнь и свои принципы. Но однажды их судьбы объединяет общая трагедия: на благотворительном вечере в здании старого музея случается пожар, в результате которого десятки человек сгорают заживо. Девушкам удается пережить трагедию, но никто из них уже никогда не сможет вернуться к прежней жизни. Три женщины становятся всем друг для друга, чтобы гордо взглянуть в лицо страхам и выстоять против несправедливых ударов судьбы.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}