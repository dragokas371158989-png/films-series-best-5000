ountry":"","ageRating":""},{"id":"1463704","ru":"Grazie tante arrivederci","en":"Grazie tante arrivederci","year":"1977","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/cicRgJgJpzXKxHdO4prXMfTaOvb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8Ro7N9DTeoqxDRMUbkLIhxp0jsc.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1456004","ru":"Маленькие рыцари","en":"ცეროდენა რაინდები","year":"1963","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/vjciMW2YysZiIywh4HvYmkLNEoz.jpg","backdrop":"","genres":["драма","семейный"],"overview":"Молодая, еще неопытная учительница Кетеван не может найти правильного подхода к ученикам. Дети беспрерывно шалят и неслушаются на уроках. Кетеван решает уйти из школы. Но однажды, проверяя тетрадки с сочинениями ребят, Кетеван начинает понимать, в чем ее ошибка - она недостаточно внимательно относилась к детям, не сумела по-настоящему заинтересовать их. Оказывается, во время каникул ребята делали много хороших, интересных и полезных дел. А свою учительницу они любят и уважают.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1415110","ru":"La Anecdota de los Chinardos","en":"La Anecdota de los Chinardos","year":"2017","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/x0dpDwXb7WbiMci0bJAS9I1Dcia.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zeVL1cbEmNTp9hzchliVpNGLnyJ.jpg","genres":["боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1403492","ru":"సీతా రాములు","en":"సీతా రాములు","year":"1980","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fqfBaeB7ru9QxHkNSsfCnav0ZWk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rUa3NBeYe6OkpLy8OX9FzoJoKho.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1402822",