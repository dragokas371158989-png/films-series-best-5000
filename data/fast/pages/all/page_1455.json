 эстрады. Однажды все они окажутся на корабле, будут по очереди рассказывать свои истории. Корабль поплывёт по тихой реке, а на берегу все-все-все будут прислушиваться: и летучие мыши в разрушенных дворцах, и бродячие фокусники, и гастролирующие диджеи. Им надо расслышать пение джиннов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"306941","ru":"Surf 'n' Love","en":"Surf 'n' Love","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/fEsanlLm4vYTVGHa3kYWLR2ytbA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lkWwmzixKlZ0Ixw9mH4200zL7Hi.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"321847","ru":"爱在博尔塔拉","en":"爱在博尔塔拉","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/kbpuyte455ulU66u2ME8jMkJM7Y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hBMIiIWKtElUn9YvWWG4kZQG3Bp.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"323142","ru":"8 點直樂 VIURIETY","en":"8 點直樂 VIURIETY","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/8ef663fBsdvzBnJgqqZKyUhhMyy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4Pt7c4ZmdjDRC4WDY4yaveKh1wf.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315182","ru":"2026bilibili大年初一联欢会","en":"2026bilibili大年初一联欢会","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/yFT4uk4As8ihvwAB0serwnrT0UT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jwf8GbPeLAVrObmlnYa9qaomMyO.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"307750","ru":"アキバロスト","en":"アキバロスト","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/wXMhws88fWU1ExPlw5SvubZBCWC.jp