драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"371722","ru":"Cinebasura: La peli","en":"Cinebasura: La peli","year":"2017","type":"Фильм","rating":4.1,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/wLzS1qhN0oWHRKmlsjcFF0IscmH.jpg","genres":["фантастика","комедия","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"436024","ru":"KFC","en":"KFC","year":"2016","type":"Фильм","rating":4.1,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/7Af2RfJfRY8oCIdGCCsCeNw3QHQ.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"311206","ru":"Pretend We're Kissing","en":"Pretend We're Kissing","year":"2014","type":"Фильм","rating":4.1,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/dykHoSYcDzXnmoATxX15G521r4w.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"222581","ru":"Five Thirteen","en":"Five Thirteen","year":"2014","type":"Фильм","rating":4.1,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/6mQegWd7oEfPEzWGQptGgq3LjcP.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"623409","ru":"Морская академия. Фильм","en":"劇場版 ハイスクール・フリート","year":"2020","type":"Мультфильм","rating":4.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/hih1iD2R3t02UmQ29cWlnfox1cO.jpg","genres":["мультфильм","боевик","драма","фантастика"],"overview":"Из-за сдвига в тектонических плитах, который произошёл около ста лет назад, Япония потеряла большую часть своей территории в связи с затоплением оных. Чтобы сохранить остатки территории, один за одним начали возникать прибрежные города. В конце концов они стали самыми настоящими морскими городами, и вместе с расширением морских путей для их соединения, возникла необходимость в людях, которые смогли бы защитить не только эти самые пути, но и море. В то же время, работа в море становится всё более популярной среди девушек. Таким образом, отряд «Синие русалки» стал работой мечты для каждой студентки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"990493","ru":"Ang Babaeng Nawawala sa Sarili","en":"Ang Babaeng Nawawala sa Sarili","year":"2022","type":"Фильм","rating":4.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/wkFC2NCyci47eqQrPvAVgeuSkw4.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"877975","ru":"Harland Manor","en":"Harland Manor","year":"2021","type":"Фильм","rating":4.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/b7Wb7c3b29plHji5yQB7r8Q9itx.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1043794","ru":"Cały ten seks","en":"Cały ten seks","year":"2023","type":"Фильм","rating":4.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/aHOHF7yq2XNHreQJSivcTIjmDhH.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"588351","ru":"Reality Queen!","en":"Reality Queen!","year":"2020","type":"Фильм","rating":4.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/nXGkYwux6HfTJU1uajmhiKfrslz.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"286052","ru":"A Despedida","en":"A Despedida","year":"2014","type":"Фильм","rating":4.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/b1RXa9txcIkPYBWK2mW5JYQ5Bih.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"575179","ru":"Fall Girls","en":"Fall Girls","year":"2019","type":"Фильм","rating":4.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/1lKcJ13GsFcqkU6QCNtO3O9MWrI.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"