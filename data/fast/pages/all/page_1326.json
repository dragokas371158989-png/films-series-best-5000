{"tab":"all","page":1326,"pages":1604,"count":96213,"pageSize":60,"items":[{"id":"636372","ru":"Oxalis","en":"Oxalis","year":"2018","type":"Фильм","rating":4.1,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/xMWaMPYzNEnq2cRLrbos2HWsYVt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dhOdZWhyC1K4Rx6WvgRQNb60h2J.jpg","genres":["Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"681461","ru":"The Surrogate","en":"The Surrogate","year":"2021","type":"Фильм","rating":4.1,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/aciPcnui9OIm2rGIAvfjjtMVbl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rU5ZQLwv87J2O7xCy8KwhUqBbfH.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"520696","ru":"Обуздание","en":"Restraint","year":"2017","type":"Фильм","rating":4.1,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/zp4jxX9O4aJrsoRYafnGHwDBDrM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pBiyzntjupjToUr69IK3sXXdphf.jpg","genres":["Ужасы","Триллер"],"overview":"Психически больная женщина в течение многих лет сдерживает в себе тягу к насилию. Однако, когда она выходит замуж за пожилого мужчину и переезжает к нему в загородный дом, ее истинная натура вырывается наружу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"535618","ru":"スティルライフオブメモリーズ","en":"スティルライフオブメモリーズ","year":"2018","type":"Фильм","rating":4.1,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/bOervm1IzTpUq5ZGZQpLjitxkA8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2dMUk8hAHwPmrxIpcEKneZAICKJ.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"433536","ru":"Shark Babes","en":"Shark Babes","year":"2015","type":"Фильм","rating":4.1,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/2y02xGe9E7bDAK6mEiKy7nq9MU8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fjP9EgJmIgVm7uFEM9HA6