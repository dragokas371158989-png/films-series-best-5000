es":"","status":"","studio":"","country":"","ageRating":""},{"id":"926174","ru":"狄仁杰之骷髅将军","en":"狄仁杰之骷髅将军","year":"2022","type":"Фильм","rating":3.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/uMHrujNWReBvZvuWzba0n5DkitA.jpg","genres":["боевик","детектив","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"842637","ru":"Occhi Blu","en":"Occhi Blu","year":"2021","type":"Фильм","rating":3.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/ihYCY17uB30NeizTa5RP0llgzMC.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"83379","ru":"Седьмой хранитель","en":"O Sétimo Guardião","year":"2018","type":"Сериал","rating":3.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/iazoBKOmyixpOdukKfVipvfCtq7.jpg","genres":["Мыльная опера","комедия","драма","НФ и Фэнтези"],"overview":"Серра-Азул - самый обыкновенный тихий и окруженный горами провинциальный городок, до которого еще не добрались многие технологические достижения, включая интернет и мобильный телефон. Но он скрывает немало тайн, главная из которых - это уникальный источник, обладающий целебными и омолаживающими свойствами. Охранять чудо природы поручено семерым стражам, среди которых есть мэр, доктор, эзотерик и другие жители города.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"841599","ru":"Silab","en":"Silab","year":"2021","type":"Фильм","rating":3.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/rP7B0g9do6YeikssIzeah6fCExK.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"409377","ru":"Отдам всю себя","en":"みんなあげちゃう♥","year":"1991","type":"Мультфильм","rating":3.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/tLZwouku9JaBdCrtZn2jgMemuLH.jpg","genres":["мультфильм","комедия","мелодрама"],"overview":"Юно Мамия – богачка, красавица и умница – должна была бы влюбиться в прекрасного принца. Но вместо этого, развлекаясь с приятельницами (они разглядывали в бинокль жильцов соседних домов), присмотрела юношу, который скромно онанировал на порножурнал. Ее подруги брезгливо отмахнулись: «Фу, это способно убить даже самую сильную любовь... Мужчины – такие животные!», но нежное сердце Юно было ранено: «Нет, он – хороший! Он просто одинок, и у него нет девушки!». Решение созрело само собой – предложить ему себя в качестве подружки! Сказано, сделано: не успел Рокуро привести себя в порядок после сеанса самообслуживания, как в дверь позвонила прелестная старшеклассница с предложением: а не нужна ли ему девушка?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"50895","ru":"Ordinace v růžové zahradě","en":"Ordinace v růžové zahradě","year":"2005","type":"Сериал","rating":3.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/lI0YdSKZXWG5DHcjpgILH9IqyZE.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"604092","ru":"Deadly Influencer","en":"Deadly Influencer","year":"2019","type":"Фильм","rating":3.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/eZxG5YrGGh78hvmEOWz2jEHZBSC.jpg","genres":["триллер","криминал","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"94505","ru":"超人学園ゴウカイザー","en":"超人学園ゴウカイザー","year":"1997","type":"Мультфильм","rating":3.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/n81aJ7JoQWUuDGtgvGxdg1GVxeT.jpg","genres":["мультфильм","боевик","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}