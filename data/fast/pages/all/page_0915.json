","episodes":"","studio":"","country":"","ageRating":""},{"id":"442179","ru":"Der kleine Prinz","en":"Der kleine Prinz","year":"1990","type":"Мультфильм","rating":8.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/1mnU14Bw2vxTZImljhozYDu7uVf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hTY7IiGwvdhtwHNnvvIuenGVqb0.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"393100","ru":"Salt Water","en":"Salt Water","year":"2016","type":"Фильм","rating":8.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/3qyt4cFtFA2T2dReI9P6OcLQ9GM.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"277194","ru":"Disney Princess Sing Along Songs, Vol. 3 - Perfectly Princess","en":"Disney Princess Sing Along Songs, Vol. 3 - Perfectly Princess","year":"2006","type":"Мультфильм","rating":8.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/2WajPn4mRLfYHJUKrrGBYsFx3wI.jpg","backdrop":"","genres":["мультфильм","музыка","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"8915","ru":"Галактические железные дороги","en":"銀河鉄道物語","year":"2003","type":"Аниме","rating":8.2,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/eG4Bayg3vtLB1gtjVHQSP0aHBgW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oi7w6NyclMw56ugKpmLRNsG1Ygv.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","Аниме"],"overview":"История начинает развиваться с планеты Дестини, которя претендует на звание центра всей Вселенной, потому что именно здесь находятся все терминалы \"Галактических железных дорог\". Главный герой, 20-тилетний Юки Манабу. Он следует пути покойного отца, воле брата, и своей мечты, поступает на службу в sdf, чтобы охранять и поддерживать безопасность на галактических железных дорогах. Лейла Дестини Шура - красавица, скрывающая много тайн. Она связывает sdf и линии всех железных дорог. Девушка обладает уникальным даром - видеть судьбы планет, людей и живых существ. Однако, с появлением тех, кто использует темные силы, в Лейле пробуждаются новые грани её способностей. Сможет ли девушка увидеть судьбу Юки? И что будет делать Юки, когда Галактическим железным дорогам грозит набольшой кризис за всю их историю?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"280822","ru":"你好1983","en":"你好1983","year":"2026","type":"Сериал","rating":8.2,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/j8rOn9MSKJ8tAuqOjTOzLsa0oqu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/d9s5SlGLnOWqWy2DHmdFoG4ZUKm.jpg","genres":["комедия","драма","НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1642210","ru":"Pushed Off a Plane and Survived","en":"Pushed Off a Plane and Survived","year":"2026","type":"Фильм","rating":8.2,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/cfMIooZWp9GsyAGZM4fuvBF03I7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9FW5k0qRcSzb7ApACr0ljSO57aU.jpg","genres":["триллер","драма","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"274323","ru":"La Famille Rose","en":"La Famille Rose","year":"2025","type":"Сериал","rating":8.2,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/y8DV3ix11nBE0q1pPITmKOtIT3W.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g5uwZLMhW5DxE2C8b05MTd1M6z6.jpg","genres":["комедия","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1033894","ru":"Ønskebarn","en":"Ønskebarn","year":"2022","type":"Фильм","rating":8.2,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/wtljuvWBFcNmgmgSzQI02s5grA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vZtHFUwEAEAdxKfJbawseUrLYTt.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1476169","ru":"Marathon","en":"Marathon","yea