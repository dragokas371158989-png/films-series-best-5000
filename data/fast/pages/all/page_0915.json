/image.tmdb.org/t/p/w342/AjjKcMbIMP8Lb3rl9gU5o7BWDzx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rC19hUIkRwH18PJZLT66pc8BZrc.jpg","genres":["документальный","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315450","ru":"Einfach Elli","en":"Einfach Elli","year":"2026","type":"Сериал","rating":8.2,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/f4QOF6euhOJ7WOM4g6F833xv3Bb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iQ38o9fhRX2Iok8Hvpth9R4vqCE.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"332511","ru":"Чародей равновесия. Тайна Сухаревой башни","en":"Чародей равновесия. Тайна Сухаревой башни","year":"2015","type":"Мультфильм","rating":8.2,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/3Kt4IOflyR9ZQUk30Zu2WN1Lmd3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3MrBmx9IuulMGanHPucXgyxDqRi.jpg","genres":["мультфильм","семейный","фэнтези","история"],"overview":"Россия, конец 17 века. Царь Петр Первый издает указ о праздновании Нового года. Ко двору царя под видом ученого-механика приезжает Магистр темной магии, который стремится попасть в Волшебные Миры и вернуть свою магическую силу. Врата Волшебных миров находятся в Москве в Сухаревой башне. Их охраняет граф Яков Брюс — знаменитый сподвижник царя Петра, ученый, колдун и Чародей Равновесия. Ученик Брюса, подросток Петя, случайно узнает о коварных планах Магистра и спешит к Сухаревой башне, чтобы предупредить дочь Брюса Маргариту об опасности. Дети ссорятся и нечаянно разрывают старинный манускрипт, в котором заключена магическая сила Брюса. Для восстановления манускрипта дети отправляются в опасное приключение в Волшебные миры.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"133841","ru":"En aparté","en":"En aparté","year":"2001","type":"Сериал","rating":8.2,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ncHQu8udR0YQhM2FlSibQ6Obeh0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8yODTFCkRbhnwpksRKMpQWjzmDY.jpg","genres":["Реалити-шоу","Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"616261","ru":"Vanishing Kings: Desert Lions of the Namib","en":"Vanishing Kings: Desert Lions of the Namib","year":"2015","type":"Фильм","rating":8.2,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4Q6A0e26grUvBLuaJsY4GkNC2pe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fEV0dUz4Z0FH24shLKTYpMcs3yg.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"534551","ru":"Carousel of Sex","en":"Carousel of Sex","year":"2015","type":"Фильм","rating":8.2,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/mizTVap4GtNJLX41hWHnuT3e8D8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w9fT4m1FOCa7IQ93W9BydiMVP8.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"317161","ru":"Bonifacio: Ang Unang Pangulo","en":"Bonifacio: Ang Unang Pangulo","year":"2014","type":"Фильм","rating":8.2,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/hNNfUqbv1xExffJNExIjBwbQ5Iw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kGs5vKEV3wVa5zj2GQhorAZJqqE.jpg","genres":["история","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"104","ru":"射鵰英雄傳","en":"射鵰英雄傳","year":"1983","type":"Сериал","rating":8.1,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/wuOGPke8Dm5g5X4qfYwHu3gXAyX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fcKuYJGQdI8E0Pec4PJUGILKXWe.jpg","genres":["драма","Боевик и Приключения"],"overview":"Лола и Манни живут в Берлине и безумно любят друг друга. И когда Манни — маленький курьер большого бандита — теряет сумку с деньгами своего босса, спасти его может только Лола. Но на то, чтобы раздобыть совсем не маленькую сумму в сто тысяч марок, у девушки есть только 20 минут. Каждая секунда может означать разницу между жизнью и смертью. Так что, как следует отдышитесь и приготовьтесь к головокружительной и опасной пробежке в компании со стремительной Лолой. В пути вас ждет не один сюрприз…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"116179","ru":"Комиссар Риккарди","en":"Il Commissario Ricciardi","year":"2021","type":"Сериал","rating":8.1,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/4j4czbpq3mSsBPRJ3nTwy9tk2td.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b8znMIR0ZjXkI9nVzkEzUvnULCD.jpg","genres":["криминал","детектив","драма"],"overview":"Молодой комиссар Риккарди расследует преступления в Неаполе в 1930-е годы. Он всегда серьёзен, а его сердце отдано двум женщинам: простой молодой леди и красивой богатой вдове.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"277685","ru":"Пи-Ви в роли самого себя","en":"Pee-wee as Himself","year":"2025","type":"Сериал","rating":8.1,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/245axX0GN2QQE8KwXGKEvAVl1YP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g0gQOWjCBYUUYVw1dlN6Fg60CzY.jpg","genres":["документальный"],"overview":"Двухсерийный портрет актёра и комика Пола Рубенса, который прославился созданием культового персонажа Пи-Ви Германа. Фильм рассказывает о жизни Рубенса: его детских годах в Сарасоте, создании сцены дома, начале актёрской карьеры, взлёте популярности образа Пи-Ви и его личных сражениях и переживаниях.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"632702","ru":"Кира и Эль-Джинн","en":"كيرة والجن","year":"2022","type":"Фильм","rating":8.1,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/cXD23v93qyFwXNBz3Z5kaTMac9h.jpg","backdrop":"https://image.tmdb.org/t/p/w780/138MfiMnLE2RjlFs6lQqnDPrxbX.jpg","genres":["драма","история","боевик"],"overview":"Каир, 1919 год. Первая мировая война унесла жизни многих египетских солдат британской армии, испанский грипп опустошил страну, а националистических лидеров депортируют на фоне бурных массовых протестов. Абдель Кадер, аполитичный наркоторговец по прозвищу Джинн, невзирая на беспорядки, продолжает вести дела с колонизаторами. Но когда в стране начинает твориться беспредел, он объединяется с подпольным отрядом сопротивления во главе с врачом Ахмедом Кира.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"214873","ru":"แฟนผมเป็นประธานนักเรียน","en":"แฟนผมเป็นประธานนักเรียน","year":"2022","type":"Сериал","rating":8.1,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/1WH2dUBvA07dvgLsKeYDmSJ2spi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xmY9qIiczjp1WO9A41vruldVMO6.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"155779","ru":"Мультяшки: Луниверситет","en":"Tiny Toons Looniversity","year":"2023","type":"Аниме","rating":8.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/w0xj55SjGzZenGn7NwJlv7kTHaC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nRWIpNayk6lyk5Acm60qditaa3H.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Добро пожаловать в Луниверситет - учебное заведение для начинающих мультяшек, которые хотят стать профи. Бэбс и Бастера Банни, птичку Свити, Хэмтона Дж. Пига и Плаки Дака ожидает первый учебный день в стенах кампуса. Им предстоит познакомиться, найти общий язык и научиться жить бок о бок в студенческом общежитии. И, конечно, у них впереди - множество занятий под руководством звёзд первой величины - Багза Банни, Даффи Дака и других гуру от мира мультяшек.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_279989","ru":"За небрежной молодой девушкой ухаживает бывший жених её сестры","en":"ずたぼろ令嬢は姉の元婚約者に溺愛される","year":"2025","type":"Аниме","rating":8.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/kwV4MylQoDhz14Qd54z3Hq4qppf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hyODXbjqZeGS2WMCw0nkcMiGTdO.jpg","genres":["мультфильм","комедия","драма","Аниме"],"overview":"Мари, вторая дочь обнищавшего барона, в своей семье словно служанка. Даже на дне рождения Мари звездой вечера оказывается её красивая старшая сестра Анастасия. Во дворе своего поместья Мари сталкивается с графом Киром Гранадо, который влюбляется в неё с первого взгляда. Однако в результате страшного недопонимания граф делает предложение Анастасии. Но после трагической гибели сестры Мари должна занять её место и выйти замуж за графа.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"112217","ru":"Дух игры","en":"棋魂","year":"2020","type":"Сериал","rating":8.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/vXSrZHJRVclMNFO9ca1FWcWOvjq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dmu2XlbFtSBMPq5MZHiPs64eMqe.jpg","genres":["драма","комедия"],"overview":"Однажды, будучи еще мальчиком, Ши Гуан нашел старую доску игры в Го и освободил духа лучшего игрока в эту игру эпохи Лян по имени Чу Ин. Призрак уверен, что Ши Гуан — именно тот, кто поможет ему отыскать «Божественный ход» — высшая цель любого игрока в Го. Так этот дух стал его неизменным спутником, следуя за ним всюду, помогая и наставляя, принося неприятности и поддерживая, но проблема в том, что он совершенно не видим для окружающих, и это приводит к множеству неловких ситуаций. Однако Чу Ину все таки удается уговорить Ши Гуана сыграть в Го, вдохновив его стать профессиональным игроком. Так они встречают юного гения Юй Ляня, ставшим главным соперником всей жизни Ши Гуана.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1693346","ru":"Apple Music Live: Lady Gaga MAYHEM Requiem","en":"Apple Music Live: Lady Gaga MAYHEM Requiem","year":"2026","type":"Фильм","rating":8.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/5qJgfeZRcz6EOi6zUb9tpSlmDni.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fwEg3NVuZ9cZrMrrWyckHGCBlTD.jpg","genres":["музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"31424","ru":"Охотники на рабов","en":"추노","year":"2010","type":"Сериал","rating":8.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/bn9jatgiQFyhaBX7DVuEo9JudvP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pzoWsyJm1ud3YqqPK9scilCiPkt.jpg","genres":["Боевик и Приключения","драма"],"overview":"Действия дорамы разворачиваются во времена династии Чосон (1392-1897). Рабы строят планы о присоединении к армии противника, ведь с новым правителем они получат равные социальные права и возможность достойного существования. В один не самый прекрасный день, один из рабов, принадлежащих семье Ли Дэ Гиля, поджигает дом хозяина и сбегает вместе со своей младшей сестрой Ким Хе Вон, которая в свою очередь была тайной возлюбленной Ли Дэ Гиля, сына хозяйской семьи. В пожаре погибает вся семья за исключением возлюбленного Ким Хе Вон, Ли Дэ Гиля. Одержимый желанием возмездия, после долгих скитаний по улицам, Ли Дэ Гиль становится бесстрашным и знаменитым охотником на беглых рабов. Главной его задачей является поимка Сон Тхэ Ха, так называемого генерала армии рабов, который безумно влюблен в... Ким Хе Вон. Ли Дэ Гиль же, в свою очередь, тоже так и не смог побороть своих чувств к беглой рабыне Ким Хе Вон, которая после побега стала невестой одного знатного господина...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"60013","ru":"Le Visiteur du Futur","en":"Le Visiteur du Futur","year":"2009","type":"Сериал","rating":8.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/rMZ9zp2P6qWm4kMz4PwkDU5qN1E.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ndnwi1n7njqaYbJFfuOnmMvcUax.jpg","genres":["комедия","НФ и Фэнтези"],"overview":"2555 год. Экологическая катастрофа уничтожила нашу цивилизацию. Остатки землян доживают свои дни среди полчищ зомби и потоков кислотных дождей. Один из последних - «Гость» - решается на отчаянный шаг. С помощью своего непутевого робота он возвращается в 21 век, чтобы предотвратить апокалипсис и спасти мир...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"195075","ru":"Маугли. Последняя Охота Акелы","en":"Маугли. Последняя Охота Акелы","year":"1969","type":"Мультфильм","rating":8.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/rHUc4JYCunUl5kxlL7eLWpAsF1Y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oDHKgZ4G6IdPAuqSCqkCH8owQNJ.jpg","genres":["приключения","мультфильм","семейный"],"overview":"Маугли вырос и для того, чтобы он мог занять подобающее место в стае ему нужно вооружиться. Питон Каа помог Маугли найти в заброшенной пещере железный зуб — нож. Это произошло очень вовремя потому что старый недруг тигр Шерхан поднял смуту в стае собираясь свергнуть вожака волка Акелу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"717","ru":"Charlie Brooker's Screenwipe","en":"Charlie Brooker's Screenwipe","year":"2006","type":"Сериал","rating":8.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/4rA6TmVOMJ7GZfiCLRMswtHk6gy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AqHR4iZ8r4guaz6doRvYw5ND9gp.jpg","genres":["комедия","документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}