g/t/p/w342/vJVgfqm0pmJfHMtPu6pTNSDgbUm.jpg","backdrop":"","genres":["Мультфильм","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"351072","ru":"نا معلوم افراد","en":"نا معلوم افراد","year":"2014","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/81FFfIt0fxG7st8jA20xBchWTdn.jpg","backdrop":"","genres":["Триллер","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"265934","ru":"Tommy Cooper: Not Like That, Like This","en":"Tommy Cooper: Not Like That, Like This","year":"2014","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/pjC9FqhQR24UNmufLqAIYWwxZZI.jpg","backdrop":"","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_65957","ru":"Бэттэри","en":"バッテリー","year":"2016","type":"Аниме","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/ugCejM0oYBHjp4ldn50W4TYoPBH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1UOuo00UAppeWOQ7Ycj8elDDjhG.jpg","genres":["Мультфильм","Драма","Аниме"],"overview":"История о Хараде Такуми – питчере (падающем), который уехал жить в глубинку и мечтает научиться профессионально подавать мяч в бейсболе. У него огромные амбции, но ему не хватает кэтчера (ловца)...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_80463","ru":"Менеджер среднего звена Тонэгава","en":"中間管理録トネガワ","year":"2018","type":"Аниме","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/a5sXAiOdxd10EXDGCUWnSkajS5P.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oCN0hCqhu0QQgPRiTy7elZdhW2U.jpg","genres":["Мультфильм","Комедия","Драма","Аниме"],"overview":"Юкио Тонэгава - номер два в организации Тэйай, которая даёт деньги в долг под огромные проценты и потом силой их выбивает. Но он не собирается останавливаться на достигнутом, и когда шеф от скуки приказывает ему организовать смертельную игру, он не может отказаться. Его ждут страдания с непутевыми подчинёнными, собственным слишком острым умом и многим другим.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"182768","ru":"Леда: Фантастические приключения Ёко","en":"幻夢戦記レダ","year":"1991","type":"Аниме","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/26im4ds1KlbJlu0bWKR7Xduu7kp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/98SmuzWEWyWQSy4V8k4njjqVNEp.jpg","genres":["Фэнтези","Боевик","Мультфильм","Фантастика","Аниме"],"overview":"Ёко Асагири — обычная ученица старшей школы. Она влюблена в молодого человека, который ничего об этом не знает. Чтобы объясниться в своих чувствах, Ёко сочиняет песню. Но вскоре понимает, что эта песня является чем-то большим, нежели просто красивой мелодией. Ёко осознаёт это, когда, слушая песню, она попадает в Асанти — клон Земли из другого измерения. Как выясняется, песня девушки открывает между Землёй и Асанти достаточно широкий проход, по которому могут пройти войска завоевателей. Именно поэтому проход был запечатан много веков назад легендарной воительницей Ледой, которая уже тогда предвидела опасность. Теперь на Ёко и её новых друзей падает обязанность остановить завоевателей и вернуть баланс в два мира. Может быть, после всего, Ёко и не такая обычная, какой кажется на первый взгляд?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1244517","ru":"На обочине жизни","en":"Tow","year":"2026","type":"Фильм","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/zACO5Og5qVmtm9uSxQanEqYdWi4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cRhOM5UDUpBV7EdpdXxkstpli86.jpg","genres":["Драма"],"overview":"После угона и эвакуации машины Аманда Огл остаётся на улицах Сиэтла без крыши над головой. Женщина отказывается мириться с абсурдным долгом и произволом бюрократии. Вместе с молодым адвокатом она вступает в изнурительную юридическую битву, чтобы вернуть старую машину. Ей предстоит пройти через череду отказов и бессмысленных процедур, а также найти неожиданную поддержку у женщин, которым тоже пришлось бороться за право быть услышанными.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"804013","ru":"У подножия вулкана","en":"Under the Volcano","year":"2021","type":"Фильм","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/iVlOOpvFCddoLYc0R5lm0UsHjeU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zwcxpnzWVCabI8Jd6IDZ804XcVf.jpg","genres":["Документальный","Музыка"],"overview":"В 1979 году продюсер The Beatles Джордж Мартин построил звукозаписывающую студию на вулканическом островке Монтсеррат в Карибском море. В этом райском уголке творилась музыка 80-х — у Мартина гостили Стинг, Пол Маккартни, Элтон Джон, The Rolling Stones, Duran Duran: для них это место было чем-то вроде богемного тропического ретрита, куда можно сбежать от всего мира.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"537761","ru":"七人樂隊","en":"七人樂隊","year":"2022","type":"Фильм","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/8m7AQ8zk1duggHlvUiPyxuGwZcM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nVrOKITGnyonbHCEcUucBPlgeVp.jpg","genres":["Боевик","Драма","История","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1616400","ru":"#SKYKING","en":"#SKYKING","year":"2026","type":"Фильм","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/4uXL16pegV9mccBeUqB9VGos5hv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nBO0TV1N3BbY25BWLRUqLrefxe8.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"702920","ru":"The Disney Family Singalong - Volume II","en":"The Disney Family Singalong - Volume II","year":"2020","type":"Фильм","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/uOYIKG0RfK6iWGQQXXY2vEHA7gI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lwwnoNDP7xEP2xypd0knp6zY8Cg.jpg","genres":["Семейный","Фэнтези","Музыка","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1279112","ru":"Элизабет Тейлор: Утерянные записи","en":"Elizabeth Taylor: The Lost Tapes","year":"2024","type":"Фильм","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/b4JVUpwPiVHdY4wlQJVcZP0Pltl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ovtUVT50eMPspiErQVS6ApADWC9.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"93265","ru":"Эмили Жоли","en":"Émilie Jolie","year":"2011","type":"Мультфильм","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/4JzI0XWWJiLvYNh403FdKcv00EP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bTBm13Hy5fUpIaFlleiyW5kqlUP.jpg","genres":["Мультфильм"],"overview":"Эмили — маленькая девочка с голубыми глазами, светлыми волосами и розовыми щечками. Завтра ее первый день в новой школе и она переживает. Сможет ли она завести друзей на новом месте? И главное, сможет ли папа отвлечься от работы, чтобы отвести ее в школу в этот важный день? Мама Эмили находит среди коробок с вещами книжку, которую сама читала в детстве, и дает ее дочке в надежде, что та отвлечется от хмурых мыслей. В книжке рассказывается история синего крольчонка по имени Жильбер, который из-за своего чрезмерного аппетита попадает в ловушку злой колдуньи. Читая, Эмили засыпает. Но сказка продолжается…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1048","ru":"Час комедии от Колгейт","en":"The Colgate Comedy Hour","year":"1950","type":"Сериал","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/oWvIOn94vgsrius8HYTreQgJtjp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4QrmsUEZgIjzr64MpHprZYEChUN.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"4591","ru":"America'