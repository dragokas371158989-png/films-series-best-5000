и справятся с каверзными заданиями ведущего, а также продемонстрировать свой интеллект и остроумие. В каждом выпуске соревнуются между собой две пары игроков. Участникам предстоит решать задачи на логику из разных сфер знаний и разгадывать головоломки - самостоятельно или используя подсказки ведущего. Победители каждого этапа будут получать «извилины». А та команда, которая лучше всего справится с заданиями викторины, получит в качестве награды статуэтку «Золотая извилина».","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"817828","ru":"Headlock","en":"Headlock","year":"2020","type":"Фильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xFFj3NZCSkb5ljHYsGdhgWQuOoS.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"295430","ru":"其实不是初恋","en":"其实不是初恋","year":"2026","type":"Сериал","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/6PHfor9C4rB84FLwaVvR42xA3Nm.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1276013","ru":"Color Book","en":"Color Book","year":"2024","type":"Фильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wQEVvXJpJL5ixw63Ir4ESbx9RYW.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"666600","ru":"아내와 내 친구들","en":"아내와 내 친구들","year":"2020","type":"Фильм","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/jwFqEBoKwqI1Vc9ny50a861fyiq.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"293441","ru":"能面検事","en":"能面検事","year":"2025","type":"Сериал","rating":9.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/stzFBgM2l3VIND3iDOwDx6QZ7Vx.jpg","genres":["детектив"],"overview":"","sourc