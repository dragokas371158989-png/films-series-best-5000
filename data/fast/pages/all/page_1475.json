ственная сила. Существо, связанное со статуей тринадцатого апостола, выбирает младшую правнучку Фэй, чтобы использовать её для раскрытия самых мрачных семейных тайн. Члены семьи понимают, что деревянные статуи святых были свидетелями каждого из грехов, и теперь их жизни зависят от того, смогут ли они принять правду, которая может оказаться куда страшнее любого призрака.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"324082","ru":"Love In Beijing","en":"Love In Beijing","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/aRmN4NsgqdF2bGg0YpcxYsKceZ1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aCOjQwYjR66wCP02PIETE2yOJjt.jpg","genres":["Драма","Фантастика","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"322216","ru":"أحاديث مع ريكاردو كرم","en":"أحاديث مع ريكاردو كرم","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/vICTpH7O3YyvICJ8acOy4RWlLOT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eSjymoHk2zC3LgmWfHq2avhkGga.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"323439","ru":"천재 아기의 인생 역전","en":"천재 아기의 인생 역전","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/tjaWXpJeLMVaHzJcc9Mf5McyPwf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rkYmoD2zQfTw7EV5N30uS3VF2xX.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"321659","ru":"The Good News According to Jesus","en":"The Good News According to Jesus","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/wj8LMcIZw3cir0sJKcWRK60TrWH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tJm4wPiZvksuO9BtOS3yp5O4dMQ.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"321102","ru":"This 