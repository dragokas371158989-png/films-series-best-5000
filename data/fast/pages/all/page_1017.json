{"tab":"all","page":1017,"pages":1604,"count":96207,"pageSize":60,"items":[{"id":"927035","ru":"Холм секретов","en":"비밀의 언덕","year":"2023","type":"Фильм","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/cIKKT6L5VcShADUUzybUC5T4ou8.jpg","genres":["драма"],"overview":"Староста класса Мёнын устанавливает почтовый ящик для желаний и секретов. Двенадцатилетняя девочка кое-что в этом понимает; желаний и секретов у нее самой предостаточно.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"271290","ru":"След клубничного поцелуя","en":"再见，怦然心动","year":"2024","type":"Сериал","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/s8YdYkdH8pfKoDbT4aSn8EnQG69.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1602783","ru":"தாய் கிழவி","en":"தாய் கிழவி","year":"2026","type":"Фильм","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/21dLAnBhu3dMjQ89UIHGEtkoQ02.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"952175","ru":"映画 バクテン!!","en":"映画 バクテン!!","year":"2022","type":"Мультфильм","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/b2KaXf2pV51YWUtMBJ6P9a2m3Vk.jpg","genres":["мультфильм","драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"301909","ru":"복숭아 꽃이 피었습니다","en":"복숭아 꽃이 피었습니다","year":"2025","type":"Сериал","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/y45X74jF2Pchc1OOhj13KMQkecJ.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"835684","ru":"ട്വന്റി വണ്‍ ഗ്രാംസ്","en":"ട്വന്റി വണ്‍ ഗ്രാംസ്","year":"2022","type":"Фильм","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/pxBfAKeZ