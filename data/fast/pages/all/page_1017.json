/t/p/w342/bY3Ynw8vvgTmYihQkloGUvf6P7L.jpg","genres":["криминал","драма"],"overview":"Сериал, главные герои которого — это городские ночи. Журналист Том Киквуд ведет колонку под названием «Ночная жара». В ней он рассказывает о ночных вылазках полиции, детективов, через его глаза показан город, так не похожий на дневной Нью-Йорк.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"502137","ru":"Марихуана для людей","en":"Weed the People","year":"2018","type":"Фильм","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/3jHkqOfoZtjxXRhKa9gY3xMLymy.jpg","genres":["документальный"],"overview":"Вдохновляющая и душераздирающая борьба семей, которые лечат марихуану своих детей, пораженных раком, у некоторых из них потрясающие результаты.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"71963","ru":"한끼줍쇼","en":"한끼줍쇼","year":"2016","type":"Сериал","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/ssSlNCa17L8ZD7KvGICE3bXURql.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"474412","ru":"사촌여동생","en":"사촌여동생","year":"2017","type":"Фильм","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/1CHTQ06CDJTyvmx6HAyCs9uBY2n.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"399902","ru":"타부: 금지된 사랑","en":"타부: 금지된 사랑","year":"2015","type":"Фильм","rating":7.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/hLUnGJs21uXkeXoqQA3uhVpqvqc.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"462436","ru":"Max Steel Team Turbo: Fusion Tek","en":"Max Steel Team Turbo: Fusion Tek","year":"2016","type":"Фильм","rating":7.0,"votes":8,"poster":"https://image.tmdb.