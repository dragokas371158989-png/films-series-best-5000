 ей на хранение. Члены гильдии волшебников «Хвост Феи» предлагают Эклер помочь раскрыть тайну реликвии, но в разгар путешествия неизвестные нападают на хранительницу и забирают камень. Эклер и «Хвост Феи» отправляются на поиски пропажи, ведь Камень Феникса обладает мощной магической силой, что может привести к катастрофе, а мир окажется на грани гибели.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"283952","ru":"良陈美锦","en":"良陈美锦","year":"2026","type":"Сериал","rating":9.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/3EZfUsQqJeF0gys3tTpAWTqD2pY.jpg","genres":["драма","Война и Политика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"672143","ru":"ਸੁਫਨਾ","en":"ਸੁਫਨਾ","year":"2020","type":"Фильм","rating":9.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/ozso0mV2H6Yke5L6mgZnripGwez.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"284599","ru":"Super Plá","en":"Super Plá","year":"1969","type":"Сериал","rating":9.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/w2eYR31j6J8RaAPJfZw4TdeDrqC.jpg","genres":["Мыльная опера","комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"468769","ru":"BABYMETAL Live at Tokyo Dome - WORLD TOUR 2016 - LEGEND - METAL RESISTANCE - Red Night","en":"BABYMETAL Live at Tokyo Dome - WORLD TOUR 2016 - LEGEND - METAL RESISTANCE - Red Night","year":"2016","type":"Фильм","rating":9.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/nbwOoe7ipO6I8SPe45SNb2mb3Tf.jpg","genres":["музыка"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"101998","ru":"Дорога в Квиндом","en":"로드 투 킹덤","year":"2020","type":"Сериал","rating":9.4,"votes":7,"poster":"https://image.tmdb.