eQrWVCPzI.jpg","genres":["драма","НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"298170","ru":"MasterChef Celebridades","en":"MasterChef Celebridades","year":"2025","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/tqKaSBQkb9joAm5gxu5zQKmzHF6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1BsLd6ynR3Orqz458Vu34tOwWZa.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"312610","ru":"จูบฉันด้วยความรักไม่ต้องพูดออกมา","en":"จูบฉันด้วยความรักไม่ต้องพูดออกมา","year":"2025","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/5KuhsCY0qLteE2VX13gzRAVoMEP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8EbgHiCMW8m7lIogCPPUJkzot7Y.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299444","ru":"Being Franziska van Almsick","en":"Being Franziska van Almsick","year":"2025","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qnzpnHIr5ilEgUT19cb4ncNS4t9.jpg","backdrop":"","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"80318","ru":"Тысяча витрин","en":"CentoVetrine","year":"2001","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/25v6iDGmIpyG3zndfYdt4KfQgQ9.jpg","backdrop":"","genres":["Мыльная опера","драма"],"overview":"В этой теленовелле прослеживается жизнь нескольких семей, работающих в модном торговом центре «Тысяча витрин». Бесконечное разнообразие магазинов, хитроумная паутина взаимоотношений, любовь и ревность, месть и мечты… Ферри – богатейшие владельцы Торгового центра – переживают ряд потрясений, которые переворачивают жизнь семьи вверх тормашками. У отца появляется еще одна дочь, о существовании которой он не подозревал, а приемный сын после долгого отсутствия возвращается, чтобы отомстить. При этом сердце главы семейства пытаются завоевать сразу две женщины… Семья Беттини кажется идеальной, но их детям придётся смириться с тем, что родители разводятся. Восемнадцатилетняя Франческа мечтает стать актрисой и встретить принца своей мечты…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"84121","ru":"超新星运动会","en":"超新星运动会","year":"2018","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/3exKhLmc09Jwtnw37VThZc2F6dK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2D5Rcgvj9Veq0NGaFniZWBwmXml.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"86623","ru":"구해줘! 홈즈","en":"구해줘! 홈즈","year":"2019","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/eAk01dqFDBCb5WITUwj7TQRzqci.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2ZYYy3hzbzSpyyKS8lBTL9Ozd6F.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"50829","ru":"Cesty domů","en":"Cesty domů","year":"2010","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/LBQbWe2hyWuCJJwJdWRYx6etqw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/npagdmqiCm3OVqNTlLsGXl88xkS.jpg","genres":["Мыльная опера","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"112456","ru":"Kättemaksukontor","en":"Kättemaksukontor","year":"2009","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/uGCshATIq90S0RWXjWLCujkJgBf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cmiEWElIg1K6s0SK6gfWynwDGEA.jpg","genres":["криминал","комедия","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"126213","ru":"La Chance aux chansons","en":"La Chance aux chansons","year":"1984","type":"Сериал","rating":6.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/rYof63Eq1mb6rCCtV