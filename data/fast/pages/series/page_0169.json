tion","en":"The Impressionists: Painting and Revolution","year":"2011","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qHqprYhW0bEWoqNLr4oGnJNLiks.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"16789","ru":"Saturday Stayback","en":"Saturday Stayback","year":"1983","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/8EsLdlc7SJkO9Zz0lhDRDTp8Ln1.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"11758","ru":"Scotch and Wry","en":"Scotch and Wry","year":"1978","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/89eBo0cPRB3qLpiE4fsHV2GlQOj.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"303620","ru":"Arby 'n' the Chief","en":"Arby 'n' the Chief","year":"2008","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/vgtRaFUtXQhkdv3tLp83snibHel.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"262417","ru":"Любовь с испытательным сроком","en":"Любовь с испытательным сроком","year":"2013","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/tyIesUqHoDZRBurQY2eMJLZyVVE.jpg","genres":["драма"],"overview":"Павел, 35-летний вдовец, один воспитывает двоих детей: Люсю восьми лет и Петю четырех лет. Павел держит пасеку в деревне, и постоянная занятость не позволяет ему уделять достаточное внимание его детям. Когда инспекторы из службы по делам детей собираются забрать Петю и Люсю в интернат, Павел принимает радикальное решение. Он помещает объявление в газете о том, что ему нужна жена, которая могла бы присмотреть за его детьми. На объявление откликается ровесница Павла, библиотекарь Наталья — одинокая женщина с огромным запасом нерастраченной нежности. Павел принимает Наталью в семью на испытательный срок. Он до сих пор не оправился после смерти жены и с трудом мирится с появлением новой женщины в его доме. Наталье тяжело справиться с детской ревностью и настороженным отношением к ней Павла. Да и подруга Павла, деревенский фельдшер Зоя, вынашивает планы, как бы захомутать завидного деревенского мужика. Павел уже и не рад своей затее, но отступать поздно…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"215353","ru":"Die Pferdeprofis","en":"Die Pferdeprofis","year":"2012","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/t5hCiT9tq4eLOZeb05ebbNhFxzm.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"210491","ru":"දඬුබස්නාමානය","en":"දඬුබස්නාමානය","year":"1995","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xC1OifgYknCyhg6JtN0g2m6zwf7.jpg","genres":["семейный","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"157280","ru":"Viva Radio 2... e anche un po' Rai Uno","en":"Viva Radio 2... e anche un po' Rai Uno","year":"2006","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/cgytAH5wo6qpOdVSW4j7l8xOUdh.jpg","genres":["комедия","Ток-шоу","Новости"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"139131","ru":"Upanishad Ganga","en":"Upanishad Ganga","year":"2012","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/pOsDC5TzCjUHIhvghDmlNRMCxK6.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"136728","ru":"En fri mand","en":"En fri mand","year":"1996","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/5ZoZkkPbVpGATjhwWi7wNqH422I.jpg","genres":["криминал","драма"],"overview":"","source":"tmdb","episodes":"","st