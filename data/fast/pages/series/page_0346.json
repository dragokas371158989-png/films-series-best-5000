","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/t3eirRLUSijWulibNUSnR7I1s9T.jpg","genres":["Детский","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"298662","ru":"Andy en de Baksteen Belgen","en":"Andy en de Baksteen Belgen","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/9oNO3Ali7m9BFzmkz7N7MUKrtMf.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"301878","ru":"Mordet och Malå","en":"Mordet och Malå","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/biXgWu1dtSneEgglcrRYl2uzdsb.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"300649","ru":"Charterfeber Sverige","en":"Charterfeber Sverige","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/hQPxsagBdSMNw0T8AEaJLiDr18z.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"302796","ru":"Космос. Забытые проекты","en":"Космос. Забытые проекты","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/thsI9BpbwtfR9MyjS9lpfGYcHcl.jpg","genres":[],"overview":"1 сентября 1957 года состоялись пробные пуски первой советской межконтинентальной крылатой ракеты. Она должна была стать неуязвимым носителем ядерного оружия! \"Буря\" стартовала вертикально с железнодорожного лафета, на высоте 18 километров сбрасывала маршевый двигатель и переходила в горизонтальный полёт со скоростью, втрое превышавшей скорость звука. Она улетала на 8 тысяч километров, а при подходе к цели делала противозенитный маневр, поднималась на высоту 25 километров и резко пикировала на цель! Системы наблюдения НАТО в Турции засекали верхнюю часть траектории полета советских баллистических ракет и затем было легко вычислить место их взлета и падения, но \"Буря\" могла совершить маневр в любой момент. Однако на рубеже 50-х и 60-х годов основными носителями нашего ядерного оружия всё же было решено сделать баллистические ракеты, а уникальное творение знаменитого авиаконструктора Семена Лавочкина оказалось забытым.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"304559","ru":"الملكية الأثرية","en":"الملكية الأثرية","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/qGOPHv8w1yogUO957spxbQz0Tis.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"302052","ru":"Secrets in the Dark","en":"Secrets in the Dark","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/7NM7oD565Frc5hhVc1ZsYl5JFcD.jpg","genres":["документальный","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"300537","ru":"Laten ja Sarkun hurjat suunnitelmat","en":"Laten ja Sarkun hurjat suunnitelmat","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/jNxaQoAcqSCh9DGIYMGCic5U9xy.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"302079","ru":"Strange Tales of the South Shore","en":"Strange Tales of the South Shore","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/fXVbLx4OG8PYGCtFnZPM7k6DSPI.jpg","genres":["детектив","драма","документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"304899","ru":"100% Immo, L'hebdo","en":"100% Immo, L'hebdo","year":"2025","ty