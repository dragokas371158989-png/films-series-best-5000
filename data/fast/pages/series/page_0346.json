лала противозенитный маневр, поднималась на высоту 25 километров и резко пикировала на цель! Системы наблюдения НАТО в Турции засекали верхнюю часть траектории полета советских баллистических ракет и затем было легко вычислить место их взлета и падения, но \"Буря\" могла совершить маневр в любой момент. Однако на рубеже 50-х и 60-х годов основными носителями нашего ядерного оружия всё же было решено сделать баллистические ракеты, а уникальное творение знаменитого авиаконструктора Семена Лавочкина оказалось забытым.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"304559","ru":"الملكية الأثرية","en":"الملكية الأثرية","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/qGOPHv8w1yogUO957spxbQz0Tis.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zcQ1OtQXodqCOxfvKAPvMh5ZglX.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302052","ru":"Secrets in the Dark","en":"Secrets in the Dark","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/7NM7oD565Frc5hhVc1ZsYl5JFcD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b0nj4iCAP8F8yngPQ2IQD825TW2.jpg","genres":["документальный","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"300537","ru":"Laten ja Sarkun hurjat suunnitelmat","en":"Laten ja Sarkun hurjat suunnitelmat","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/jNxaQoAcqSCh9DGIYMGCic5U9xy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ut7Lxf2rBtawU0wqu7vNxx6Ao9t.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302079","ru":"Strange Tales of the South Shore","en":"Strange Tales of the South Shore","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/fXVbLx4OG8PYGCtFnZPM7k6DSPI.jpg","backdrop":"https://