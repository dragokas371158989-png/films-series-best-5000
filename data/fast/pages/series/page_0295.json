{"tab":"series","page":295,"pages":366,"count":21960,"pageSize":60,"items":[{"id":"122692","ru":"Королевские Гонки РуПола: Австралия","en":"Drag Race Down Under","year":"2021","type":"Сериал","rating":5.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/uWZPjouQgLs1lMVL0lu8P5J1jBc.jpg","genres":["Реалити-шоу"],"overview":"Драг-королевы Австралии и Новой Зеландии будут соревноваться в актёрских, комедийных, танцевальных и многих других испытаниях, чтобы стать следующей драг-суперзвездой. В качестве основных судьей выступят РуПол и Мишель Визаж.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"61025","ru":"@midnight with Chris Hardwick","en":"@midnight with Chris Hardwick","year":"2013","type":"Сериал","rating":5.1,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/eVvxhRtJzl8nom2rAFxg60QkaYo.jpg","genres":["комедия","Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"41571","ru":"Шаг с неба","en":"Un passo dal cielo","year":"2011","type":"Сериал","rating":5.1,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/54S4YRYQP9CRugrZxaxfNfbaDmb.jpg","genres":["детектив","Боевик и Приключения","комедия","семейный","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"323111","ru":"Michael Jackson: The Verdict","en":"Michael Jackson: The Verdict","year":"2026","type":"Сериал","rating":5.1,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/8R40yI5AJ931Hd3P4Yf8pdFgwJ1.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"366","ru":"Tweenies","en":"Tweenies","year":"1999","type":"Сериал","rating":5.1,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/vY69uInloqhFSzihcxqwkJPuK39.jpg","genres":["Детский"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"84970","ru":"Desus & Mero","en":"Desus & Mero","year":"2019","type":"