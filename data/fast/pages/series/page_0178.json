ng":""},{"id":"83810","ru":"Watergate","en":"Watergate","year":"2018","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/ve3gaTLzOu7BVZYSpMBfXJvggP5.jpg","genres":["драма","документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"80363","ru":"Famous Food Truck","en":"Famous Food Truck","year":"2017","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/na2qxay8u9oBoIs7hzcg55UZWKk.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"78601","ru":"The Adventures of Dr. Buckeye Bottoms","en":"The Adventures of Dr. Buckeye Bottoms","year":"2017","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3z4a7vP92iodQ0yZuXsGaY772qX.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"66056","ru":"Atlanta Plastic","en":"Atlanta Plastic","year":"2015","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9hWdsGod2CFqngguUPdInMnAG0l.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"60891","ru":"Технология от природы","en":"Bionik - Das Genie der Natur","year":"2006","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/eGM2ntlpzK63SAX4DUEqe60tuyE.jpg","genres":["документальный"],"overview":"Жизнь на Земле существует почти четыре миллиарда лет. За это время природе пришлось решать самые различные проблемы: еды, передвижения, выживания в экстремальных условиях — на самых высоких горных вершинах и в ледяных водах океана. Человек пытается увидеть во всем этом многообразии адаптаций то, что можно было бы использовать с большой пользой для себя. Круг этих вопросов решает биомиметика — подход к созданию технологических устройств, при котором идея и основные элементы устройства заимствуются из живой природы. Научные открытия, новейшие изобретения, а также последние достижения архитекторов, инженеров и дизайнеров – всё, что подсказано самой природой. Фильмы о том, как, наблюдая за жизнью животных и растений, мы развиваем высокие технологии.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"57591","ru":"Beef Buddies","en":"Beef Buddies","year":"2013","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/6DCaWnjWd4uoQqjAKjBB4Tq7LZm.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"52053","ru":"Andre Van Duins Animal Crackers","en":"Andre Van Duins Animal Crackers","year":"2013","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fXiWuFdvXoMuoD0XSSaO41gtuO3.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"44488","ru":"Churches: How to Read Them","en":"Churches: How to Read Them","year":"2010","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/70hm3ejA2y93un9iLcPUq9XnpKp.jpg","genres":["документальный","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"18088","ru":"New York Goes to Work","en":"New York Goes to Work","year":"2009","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/obzvKa9q1JuweLhxlLf6YfmCbEk.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"14732","ru":"Frances Farmer Presents","en":"Frances Farmer Presents","year":"1958","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/2X6nNSMYGp2ZK00lP9b2NqWQwzw.jpg","genres":