ing":8.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/8sAKVFRZDoZa51a60BO24Pf6jnb.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"15025","ru":"Unscripted","en":"Unscripted","year":"2005","type":"Сериал","rating":8.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/d3qGi8y7jPmDQAYWJFim75mwW9H.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"68876","ru":"꽃보다 청춘","en":"꽃보다 청춘","year":"2014","type":"Сериал","rating":8.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/hQQZsjEMsmWbz6z9OfMzj0PSKe1.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"312046","ru":"Glitter & Gold: Ice Dancing","en":"Glitter & Gold: Ice Dancing","year":"2026","type":"Сериал","rating":8.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/irrdulKrIPIjUwpZMwdtoo80CLW.jpg","genres":["документальный","Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"297058","ru":"Глаза Черного моря","en":"Gözleri Karadeniz","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vFmQa8yyuirssDatMME4FQtoG65.jpg","genres":["драма"],"overview":"«Мачари / Глаза Черного моря» — атмосферный турецкий сериал, съёмки которого проходили в живописных уголках Средиземноморья и многоликом Стамбуле. Мачари — не просто семья, а могущественный и уважаемый клан, чья история уходит корнями в прошлое. Долгие годы Осман держал всё под контролем, но теперь пришло время передать власть. Он делает ставку на Азиля — сына, которого когда-то, после трагической смерти любимой женщины, отдал на воспитание матери. Но именно в тот момент, когда Азиль готовится принять судьбоносное решение, из тюрьмы выходит его брат Мехмет — и почти сразу же возвращается в мир, где всё решают пули и деньги. Между братьями назревает конфликт, а напряжение растёт с каждым днём. Когда Азиль знакомится с Гюнеш, он видит в ней надежду и свет. Вот только он ещё не знает, что за её доброй улыбкой скрывается тайна, способная разрушить всё, что он пытается построить…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"290370","ru":"诶？差点真分了！","en":"诶？差点真分了！","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/eKAsfvnW0EPFGbyftTeufolfOVE.jpg","genres":["драма"],"overview":"Группа людей, готовившихся к концу света, выходит из своего бункера через 10 лет после того, как на Землю упал гигантский метеорит. Они обнаруживают, что мир принадлежит бешеным мутантам, и теперь их задача — пережить наступление ночи. Они встречают загадочную путешественницу, которая говорит, что существует безопасный оазис, но чтобы достичь его, надо быть готовыми к войне не на жизнь, а на смерть…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"304024","ru":"Персона","en":"Persona","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/iU15jCyaAR7ET26qgfELERwKT0j.jpg","genres":["криминал","драма"],"overview":"Писатель и эксперт по криминальной психологии Йигит Даглы готовит к выходу новую книгу — и вдруг описанные им убийства начинают происходить в реальности. Полиция в тупике, свидетели путаются, улики словно подстроены. К делу возвращают следовательницу Бурджу Тюркоглу: единственный, с кем согласен говорить Йигит, — она. Но чем глубже они идут по следу, тем яснее, что «пророческая» книга лишь витрина для чужой игры. Кто диктует сценарий — автор, убийца или тот, кто стоит между ними? И успеют ли они остановить следующую главу до её кровавого финала?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"305793","ru":"Истина и измена","en":"Truth & Treason","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/y1sR10fmjiRFEbq9vpw6LfjVdSv.jpg","genres":["Война и Политика","драма"],"overview":"Фильм поставлен на основе реальных событий и рассказывает о 16-ти летнем лидере антигитлеровской группировки в нацистской Германии. В разгар Второй мировой войны подросток в Германии вынужден столкнуться с ужасной правдой: верность своей стране теперь означает верность лжи. Когда его доверенный пастор призывает к повиновению нацистскому режиму, он начинает всё подвергать сомнению. А после того, как его друга-еврея забирают, он тайно слушает запрещённые радиопередачи и начинает движение сопротивления, раскрывая правду. Но в стране, где правит страх, неповиновение дорого обходится, и герою предстоит решить, что на самом деле значит быть хорошим немцем.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"308218","ru":"Культурный шок","en":"Choque de Cultura: A Série","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/b5Dj79y5ohvV5mxVpa9fQImdKtw.jpg","genres":["комедия"],"overview":"Спустя годы после закрытия популярного шоу четверо знаменитых водителей маршруток — Рожериньо, Ренан, Жулиньо и Маурилио — ведут совершенно разные жизни. Рожериньо стал фальшивым экстрасенсом на телевидении, Ренан разбогател после удачного развода, Жулиньо преследуют коллекторы, а Маурилио наконец завершил сценарий своего фильма. Но череда нелепых случайностей, афер и дорожных происшествий снова объединяет их, втягивая в криминальную историю с участием знаменитостей.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"278850","ru":"รักแห่งสีลม","en":"รักแห่งสีลม","year":"2026","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/2yRMlVCTcydQ2iSRlChSJYpydqL.jpg","genres":["драма","криминал"],"overview"