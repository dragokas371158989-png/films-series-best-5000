ны четыре spin-off: Romeo & Rafael Desperados в 2008 году, Lillukanvarsia в 2010-2011 годах, Tuuliranta в 2011-2012 годах и «Young Man, Cash Man» в 2013 году.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"211178","ru":"Серый дом","en":"The Gray House","year":"2026","type":"Сериал","rating":4.3,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/wE5jZDeQuiulaAtjeaEq0y8tpey.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m8BuLCx997QVljT0wdss62QaRre.jpg","genres":["драма","Война и Политика","Боевик и Приключения"],"overview":"1860-е, штат Вирджиния. Светская львица, ее мать и самая известная в округе секс-работница ведут подпольную работу в штабе конфедератов. Они используют подземную железную дорогу для создания шпионской сети и рискуют жизнью ради идеалов свободы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"4781","ru":"Germany's Next Topmodel","en":"Germany's Next Topmodel","year":"2006","type":"Сериал","rating":4.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/wkQuRYdYJMOKO4F5qpQ6DV2ySuY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/77rbkHE0CWjZmbtSSiPocpClG2h.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"61140","ru":"감격시대: 투신의 탄생","en":"감격시대: 투신의 탄생","year":"2014","type":"Сериал","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/5Ch5wEp8sAZC1pnUAokyMDQn62M.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fRYxZoYoIOYFLeT826idmnE459o.jpg","genres":["Боевик и Приключения","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"226761","ru":"Sex Hub","en":"Sex Hub","year":"2023","type":"Сериал","rating":4.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/n129IC6sf046sCWZgXsa2DMRxSO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vCK3VWZR5Vp4C55mPiORkI8WqeC.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ag