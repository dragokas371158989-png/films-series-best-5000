":"","ageRating":""},{"id":"288670","ru":"Saturday Night Live UK","en":"Saturday Night Live UK","year":"2026","type":"Сериал","rating":4.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/48j16bIyIkeUIRFYfwZ6nWovQE2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mooCqZv9h5rF3vvBt5vKGbYahUH.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"3947","ru":"Verliebt in Berlin","en":"Verliebt in Berlin","year":"2005","type":"Сериал","rating":4.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/gw00a3X2xZ8avePAMyD4olZtN9u.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ug8VmeqBEpXzvSgLiCwbAZ3AkLI.jpg","genres":["Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"217728","ru":"ЭРОТИКА МАНИЛЫ","en":"Erotica Manila","year":"2023","type":"Сериал","rating":4.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/30BofpwNeMu3N9eYDdIT8FQ7lvW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aJgM3G8KBzdLfTi29gR7ou1YpW4.jpg","genres":["драма"],"overview":"Антология из четырех грустных и смешных эротических историй из жизни современой Манилы в исполнении кинозвед Филиппин.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"14321","ru":"The Bonnie Hunt Show","en":"The Bonnie Hunt Show","year":"2008","type":"Сериал","rating":4.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/hmvLAtbfLE8wG3wKpE2Se5tnqT5.jpg","backdrop":"","genres":["Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"271905","ru":"Top End Bub","en":"Top End Bub","year":"2025","type":"Сериал","rating":4.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/pm2ofsRHVvsxSAHHDGZPyqiBlHN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fduUEXMzRUqaxnrwNTJOnssukOA.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"313692","ru":"The Summit","en":"The