ry":"","ageRating":""},{"id":"31460","ru":"Stubbe – Von Fall zu Fall","en":"Stubbe – Von Fall zu Fall","year":"1995","type":"Сериал","rating":4.8,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/fsB6ox9rNdck68o62J6PcQrXSfv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7TxmXrhe2eKREJO5nshutLEogQT.jpg","genres":["криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305112","ru":"13 novembre, le choix de Sonia","en":"13 novembre, le choix de Sonia","year":"2025","type":"Сериал","rating":4.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/omq2xWVGt0rMyqDIT4zV4ZVbPAY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/js3K37nTgPqHXZlor3XnlfbtGoO.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"73328","ru":"Eve of Destruction","en":"Eve of Destruction","year":"2013","type":"Сериал","rating":4.7,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/4hk8x7cFHoyZQ2n9eE7THm3LKIG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sf0AQXy4DQTeBbezyZifWrym8N1.jpg","genres":["НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"46083","ru":"Не родись красивой","en":"Не родись красивой","year":"2005","type":"Сериал","rating":4.7,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/du9uAsR3sNrhLSnM8oQdTNJFt6D.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2IE2qcJafCC9vtJLU1wVQwOmHwL.jpg","genres":["комедия"],"overview":"Катя - главная героиня фильма, уверенно поднимается вверх по служебной лестнице. И в это время неожиданно ее настигает... любовь. У Кати кружится голова от счастья, но неожиданно она понимает, что была лишь тайным оружием в нечестной игре. К тому же карьера кажется, испорчена безвозвратно. Что отличает русских девушек от остальных? А то, что они знают: из любой ситуации есть выход. Катя решается на отчаянный шаг - она предлагает план, благодаря которому есть шанс все исправить... Устроится ли Катина личная жизнь? Как далеко удастся ей продвинуться по карьерной лестнице? Узнаем вместе!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"116479","ru":"Анупама","en":"अनुपमा","year":"2020","type":"Сериал","rating":4.7,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/i3ZcFxUiGr6HV5yv1i6n7uKHyj7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wBu3BErMuZ51H701J8QjmoHdBHr.jpg","genres":["драма","Мыльная опера"],"overview":"Сериал вращается вокруг гуджаратской домохозяйки Анупамаа Ванрадж Шах и ее семьи. Анупамаа очень преданная домохозяйка, мать и невестка. Лишенная такой же любви и уважения в своем доме со стороны членов своей семьи (кроме младшего сына Самара), она осознает горькую правду и решает жить своей жизнью.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"93449","ru":"Tamron Hall","en":"Tamron Hall","year":"2019","type":"Сериал","rating":4.7,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/pOqHc6Q47uGqnCps1DGVMaWyd9v.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wMVqVtaQdtPJk09eFVEZyN05efT.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"275557","ru":"Wild Cherry","en":"Wild Cherry","year":"2025","type":"Сериал","rating":4.7,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/oxn4ylDZSnQq83H0jXAmueBFV8A.jpg","backdrop":"https://image.tmdb.org/t/p/w780/c54arxwmTXMv4bPJo3RxbASW2s2.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"31351","ru":"Tout le monde en parle","en":"Tout le monde en parle","year":"2004","type":"Сериал","rating":4.7,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/8BiaKzjK3arQM2yKLzB9zBKB6GL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f5445uc1T6HqTe4Zi0hfkk7kuHn.jpg","genres":["Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}