у герою истории - майору Кириллу Решетову, которому коллеги сообщают страшную новость: жестоко убита его бывшая возлюбленная - Наталья, которая тоже работала в полиции. Шокированный известием Решетов срочно выезжает в Ярославль, где жила Наташа, и прямо на вокзале узнаёт, что пятнадцатилетняя дочь погибшей – его ребёнок, о котором он ничего не знал. Довольно скоро Решетов понимает, что это убийство как-то связано с «делом Лихова», которое они вместе с Наташей вели почти двадцать лет назад.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"129547","ru":"قبله عالم","en":"قبله عالم","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1nzgEDtJBpbBetuWdT9EMSg4sls.jpg","genres":["комедия","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"126977","ru":"這麼遠，那麼近","en":"這麼遠，那麼近","year":"2020","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4gnfTAbxfouIDofcF24cNt7YvpF.jpg","genres":["Реалити-шоу","документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"125277","ru":"Alex Tienda en Venezuela","en":"Alex Tienda en Venezuela","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qFNQS2EBJV0TEJrJU5fZe7fW9gD.jpg","genres":["документальный","Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"115091","ru":"Ζευγάρια που έγραψαν ιστορία","en":"Ζευγάρια που έγραψαν ιστορία","year":"2020","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lQvNaTAe99nrM9aM7U5hw957Lq9.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"103112","ru":"Kashf","en":"Kashf","year":"2020