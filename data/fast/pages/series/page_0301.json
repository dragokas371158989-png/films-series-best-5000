es":"","studio":"","country":"","ageRating":""},{"id":"287977","ru":"Бельфегор. Оживший миф","en":"Belphégor","year":"2025","type":"Сериал","rating":3.8,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/b6KZIup2a5yoqScZuCLyDxSUSB9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/63J7u2hFPAsvVnabvsQLCdkqJdh.jpg","genres":["Драма","Детектив"],"overview":"Хафса — талантливый реставратор, недавно принятая в штат Лувра. Ее жизнь погружается в хаос, когда она оказывается лицом к лицу с тысячелетней маской бога бури Бельфегора. Неожиданно оказавшись втянутой в череду необъяснимых исчезновений, она вступает в гонку со временем. Чтобы докопаться до истины, Хафсе предстоит бороться с теми, кто преследует ее… и со своими внутренними демонами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"109700","ru":"新还珠格格","en":"新还珠格格","year":"2011","type":"Сериал","rating":3.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/9jYapOTs1poV9GGrhu10putyd2O.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xAgASkifiXucuWIaEI6YrTe6uPX.jpg","genres":["Драма","Боевик","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"40938","ru":"Der Staatsanwalt hat das Wort","en":"Der Staatsanwalt hat das Wort","year":"1965","type":"Сериал","rating":3.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fkq4dZ3la24OZbHApZR61jKkYWy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/i3bc3egDBKmb39OQI176hy8X0zR.jpg","genres":["Криминал","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"98430","ru":"Infieles","en":"Infieles","year":"2005","type":"Сериал","rating":3.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/z8SXWRQQoRGd7deGGKd3icrpDB8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qLel5eu7jsdQOTLY73kUvnoo2HZ.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"70313","ru":"Rodinná pouta","en":"R