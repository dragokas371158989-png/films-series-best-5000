poster":"https://image.tmdb.org/t/p/w342/u2cX3CVzUZLIGVwd9HB7bUhE7OP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/p1ntnKJwn1URGv1xpU6NN33Y11O.jpg","genres":["драма","комедия","НФ и Фэнтези"],"overview":"Жизнь актрисы Син Со Ри резко меняется, когда в нее вселяется дух легендарной роковой наложницы из эпохи Чосон. Оказавшись в XXI веке, героиня начинает жить по своим правилам, не скрывая жесткого характера. Судьба сталкивает ее с Ча Се Ге - расчетливым наследником крупной корпорации, привыкшим держать все под контролем. Эта встреча втягивает обоих в опасную игру чувств.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"287346","ru":"Честь","en":"아너: 그녀들의 법정","year":"2026","type":"Сериал","rating":9.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/du36bolO9CpWinIB1o0L4hGSxBa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fULDivcid9WAuV6hKwobgRhVWD4.jpg","genres":["детектив","криминал","драма"],"overview":"Юн Ра Ён, Кан Син Джэ и Хван Хён Джин дружат уже около 20 лет, со студенческих времен, и теперь работают вместе юристами в юридической фирме L&J (Listen and Join)., которая специализируется на защите женщин, пострадавших от преступлений.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"79278","ru":"Любовь наших родителей","en":"父母爱情","year":"2014","type":"Сериал","rating":9.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/vDcxOBE2w0TYd514EUAC3RBl9Dr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xarivXV3RgKBryRXeT9lmjjPTFr.jpg","genres":["семейный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"318188","ru":"الخلاط+","en":"الخلاط+","year":"2026","type":"Сериал","rating":9.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/5t1g6ramHYGQd75jSwugoCvpw5e.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zEkUDuzflg6yDWBGqrqCXDksqYL.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""