же есть маленькая дочь, которую она родила живя в браке с ним. Ситуацию осложняет и тот факт, что в результате трагической случайности Беррак — жена Серхата впадает в кому, а он сам решает начать расследование, которое бы помогло ему узнать всю правду о своей семье. Поиски приводят мужчину в трущобы Стамбула, где он случайно знакомится с молодой девушкой по имени Зейнеп. Разница в возрасте и социальном статусе не смогла стать преградой для их чувств. Только вот и Серхат, и Зейнеп, понимают, что им будет трудно построить крепкие отношения. К тому же отец девушки, категорически против ее сближения с бизнесменом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"287114","ru":"นทีร้อยเล่ห์","en":"นทีร้อยเล่ห์","year":"2026","type":"Сериал","rating":9.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fYBqh4JSRdh8Vhyk5XgHq2F3qAb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dwnJMaGvRZqwZi3jKVlYvTC8ww0.jpg","genres":["драма","комедия","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"301625","ru":"Sin frenos","en":"Sin frenos","year":"2025","type":"Сериал","rating":9.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/3IeuYKkzf7AyilTXOKYMqjMDht8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wutFGFqhL91sOaiIuOVGA3HpApp.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"70204","ru":"순풍산부인과","en":"순풍산부인과","year":"1998","type":"Сериал","rating":9.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/cRvExNNMVinTXyW8YITQQ62oznN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/quC9EyY5UJ6hu3QklXXsaro45bp.jpg","genres":["семейный","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"5712","ru":"流金歲月","en":"流金歲月","year":"2002","type":"Сериал","rating":9.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/4ng0LnzpfCjI6FpfM9VCUIdp5Wj.jpg","backdrop":"https://image.tmdb.org