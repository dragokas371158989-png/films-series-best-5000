isodes":"","studio":"","country":"","ageRating":""},{"id":"10814","ru":"Counterstrike","en":"Counterstrike","year":"1990","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/no9Wg4VsDpSx4SO3AGavsk9eQnt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3Sn0f9owPLwnjsoBvrk6fxZAT25.jpg","genres":["Боевик и Приключения","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"154505","ru":"Gangaa","en":"Gangaa","year":"2015","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/5Zz2RC9K6BpXtJHq5tpif2OKxt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k98GSsQOBm7o45e69wX9iphEjD3.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"20463","ru":"Corpo Dourado","en":"Corpo Dourado","year":"1998","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/4BmKvi3YhCWsLejvVOl8A5mj1KY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ctxTVLXLbI9NbCfLn6Ky4wKvjee.jpg","genres":["Мыльная опера","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"105275","ru":"腾飞五千年","en":"腾飞五千年","year":"2014","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/ucO2MDyUGY0gD4UHUhiQwydXVA6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7Vhvc1FGNA9z0128tbotjnT5V1f.jpg","genres":["документальный","Ток-шоу","Война и Политика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"13502","ru":"Divine Design","en":"Divine Design","year":"","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/jWqw7Hr60g96FkrMO8xJmmrCaZh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/HEZTtckZosj8B3ZVHAJs10gPkp.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"48070","ru":"ITV Saturday Night Theatre","en":"ITV Saturday Night Theatre","year":"1969","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/8DfoF5tSiDKTrLonz8yHmUo2VVQ.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"276510","ru":"Марокканская мафия: Тоннано","en":"Tonnano","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/w9E2V0gNOsWvoWvZ3NNB5tVXXcW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zp25UhCeuBQ1C3CYAdmbDSmVCBO.jpg","genres":["драма","криминал","Боевик и Приключения"],"overview":"После рождения сына Тоннано хочет оставить свое криминальное прошлое позади и начать честную жизнь в районе Ахтерхук, где живет его подруга Амани со своей семьей. Его приезд вызывает волнения в печально известной наркосемье Айсинков. Выясняется, что дядя Амани в долгу перед семьей, и Тоннано снова оказывается втянутым в преступный мир.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"314669","ru":"Доктор Щин","en":"닥터신","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cSuTZ0yJgjN3DuWK1HsuWNmamkk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aWJ69UgwuksIt055n1Z9eyV1aND.jpg","genres":["драма","НФ и Фэнтези","детектив"],"overview":"Эта история о гениальном враче, осмеливающемся бросить вызов самому Богу, и о женщине, у которой внезапно отказывает мозг, и она медленно теряет свою душу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"312753","ru":"Резервация","en":"Резервация","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4IcEYz5Nw1p58TR4z174mPfDjCQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ah556k6i9UN5Wd2KKFjrQkeh7DL.jpg","genres":["детектив","драма"],"overview":"Загадочная аномалия отрезала Тополёво и его жителей от внешнего мира: любая попытка покинуть город оборачивается необъяснимой смертью. Именно туда после долгого отсутствия отправляется Сергей Назаров, к жене и дочери. Обнаружив лазейку, он проникает на закрытую территорию и сталкивается с новой реальностью: помимо того, что жизнь местных подчинена строгим правилам, в городе бесследно исчезают дети. Сергей пойдёт на всё, чтобы вытащить близких из ловушки — даже попробует раскрыть тайну резервации. Но что, если кому-то очень выгодно сохранять зону закрытой…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315638","ru":"Мотай!","en":"Мотай!","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/zIeVPuR7z7s1azzSTCQdzTaNT7B.jpg","backdrop":"https://image.tmdb.org/t/p/w780/em5Q6pUP9H0Q7w2qJUzCz9nbp53.jpg","genres":["комедия"],"overview":"Начальник колонии в глухой тайге Тимофей Назаров всё ещё мечтает вырваться в столицу — и снова делает ставку на кино. Но Николай Виденин вышел на свободу, и теперь Назаров переводит в свою колонию нового заключённого — известного московского режиссёра Матвея Селюжицкого, который получает кличку «Мотор» и начинает переснимать культовые голливудские боевики.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"312447","ru":"Мистер Ноготь","en":"Мистер Ноготь","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/aKApPcX0TC0Ufb4fKucah5PUp5x.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xF2UpLBJ7gpVNNEASWaQI39mLSI.jpg","genres":["комедия"],"overview":"Опытный мастер Семага теряет работу в цехе, а его жена, напротив, получает повышение. В это время дочь считает отца скучным скуфом, и только сын гордится папой. В отчаянной попытке вернуть уважение семьи и найти новое призвание Семага открывает маникюрный салон с другом Антохой. Уверенный, что с ногтями справится так же легко, как с матрёшками, герой попадает в мир женщин, гелей и лаков, который меняет его больше, чем он мог себе представить.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"316558","ru":"Тайны Амишей из Шугар Крика","en":"Sugarcreek Amish Mysteries","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ipm4Z8wI0WmQvAIh4HOH55i4iaj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tjlI2Sjv5BdR4GNW2Rtb5XwTABV.jpg","genres":["детектив"],"overview":"Шерил, пережившая болезненное расставание, случайно становится владелицей сувенирного магазина в амишском городке Шугаркрик — месте, где время будто замедлилось. Её дни наполняются заботой о ручной керамике, вышитых платках и причудливых мягких игрушках с необычными узорами. Идиллия рушится, когда из витрины исчезает старинный амулет, спрятанный среди товаров. Поняв, что это не простая кража, Шерил просит помощи у Наоми и Леви. Вместе они отправляются по следу таинственных знаков и старых обид, раскрывая секреты, которые связывают прошлое и настоящее Шугаркрика.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"251301","ru":"Чёрная графиня","en":"Чёрная графиня","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/t33qHmwXpZvLfchWsVz60OOCBBP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kzh7sMRx0xlSYzTl2jul9ueDD0l.jpg","genres":["драма","детектив"],"overview":"В Москве и Петербурге уже год идёт сенсационное театральное шоу с единственным зрителем, где стирается грань между вымыслом и реальностью. Каждый спектакль создаётся индивидуально командой профессионалов под руководством успешного режиссёра. Очередное представление проходит в уединённом особняке в лесу, куда зрителя доставляют на вертолёте. Но на этот раз всё выходит из-под контроля: один из актёров погибает, а участники оказываются отрезаны от внешнего мира. Новый «спектакль» превращается в испытание, где раскрываются человеческие слабости и ответственность каждого за происходящее.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"287677","ru":"Нейровася","en":"Нейровася","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8XIcuH6QMhFixR2IgKIP55zvws6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bMZajTaePVKKLYkxHoEXmIprPb0.jpg","genres":["комедия","детектив"],"overview":"Вася Фролов — полицейский старой закалки, привыкший действовать по интуиции и не доверяющий технологиям. Пережив развод и череду рабочих проблем, он получает необычного напарника — нейросеть Свету, установленную прямо в его мозг. Вместе они раскрывают запутанные преступления, от мелких краж до серьёзных дел, постоянно попадая в забавные ситуации. Света помогает Васе анализировать улики, вмешивается в его личную жизнь и спорит с ним о морали и чувствах. Постепенно грубый и упрямый следователь начинает понимать, что искусственный интеллект способен быть ближе к человеку, чем многие люди.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315751","ru":"Время Счастливых","en":"Время Счастливых","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lmEpZaEZoSQ6Gd4NcjxVTgZ3CGk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cZHudFCRcsGNbpmWbnIYWPxupDZ.jpg","genres":["драма"],"overview":"Незадолго до развала СССР у Марины и Ивана Счастливых рождается тройня и начинается жизнь в отдельной — наконец-то своей! — квартире номер 13. Но наивные 80-е сменяются голодными 90-ми, и настроения в семье уже не назовешь радужными. Некогда самый молодой и перспективный кандидат наук в МГУ, Иван вынужден стать репетитором и домохозяином, пока Марина зарабатывает на рынке. А потом приходит 2012 год, и энергия нового времени.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"304336","ru":"Константинополь","en":"Константинополь","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/xd3nMCl7gzwJxz8MKIcc9zJXfIB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3SYzJlMhKAIH1A0axgwt4UBp43Z.jpg","genres":["детектив","драма"],"overview":"Ноябрь 1920-го года. Белогвардейский офицер Сергей Нератов прибывает из Крыма в Константинополь вместе с остатками разбитой армии Врангеля и гражданскими беженцами. Одинокий и сломленный, потерявший в революцию и Гражданскую войну абсолютно всё – армия разгромлена, жена и дети погибли – Нератов становится во главе русской эмиграции. В Константинополе, с которым русские беженцы связывали надежды на спасение и свободу, их ждет холодный прием. Сергей Нератов – принципиальный русский офицер, ставящий долг и честь выше личной выгоды. Он оказывается в совершенно чуждом мире, где беженцев из России воспринимают людьми «второго сорта» – изгоями, обреченными на нищету и гибель. Но Нератов оказывается способным отстоять право своих соотечественников на достойную жизнь. Он сможет защитить от произвола русский мир.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305119","ru":"Мрачные хроники Древней Греции","en":"Ancient Greece: The Dark Chronicles","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qHEfzdWg9zwkeuvcsOy38KrKtwX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qtCpQdjzFjaHnYOrcEADaUrZDGf.jpg","genres":[],"overview":"Древняя Греция известна как родина демократии, науки и архитектуры, но за блестящим мраморным фасадом скрывается более мрачная реальность. Этот документальный сериал раскрывает другую сторону греческой истории - зловещих богов, гнетущие законы и жестокие войны. Каждая серия освещает отдельную эпоху: морские традиции бронзового века, агрессивный экспансионизм архаического периода, величие классического времени и Пелопоннесскую войну, поставившую греческий мир на грань разрушения. В финале рассказывается история Александра Великого и хаос, который последовал после его смерти.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"249725","ru":"Карта желаний","en":"Карта желаний","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1mwfXvO2WCCNhPWa3ASb2eCobpa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hUOdGeZ75VmRgzQP0vdTsnsYOCA.jpg","genres":["комедия","НФ и Фэнтези"],"overview":"Все, кто бесят Олесю, вдруг начинают получать по заслугам. Комедия о том, что порой стоит бояться своих желаний.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"318217","ru":"Как Деревянко Чехова играл","en":"Как Деревянко Чехова играл","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/2AgMa39nmirpWicI0JH5R2BVRb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qGJyauesV56JrfnkhdE5jEicGlH.jpg","genres":["комедия"],"overview":"После того как роль Ломоносова отдали другому актёру, Павел решает снова замахнуться на значимую роль — Чехова. Деревянко верит, что сможет получить признание критиков за серьёзный драматический образ. Как только запускаются съёмки фильма про Антона Павловича, выясняется, что в Таганроге живёт правнучка драматурга Маргарита Васильевна, которая запрещает снимать кино. Павел возвращается в родной город, чтобы переубедить наследницу. Правда, ради заветной роли ему придётся решить все конфликты её семьи.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305301","ru":"Знаменитые гангстеры с Шоном Бином","en":"Original Gangsters with Sean Bean","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/bqKG67StiHuGzijD3DEqn0yOh9X.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lnsIT7lvT9n6eJCbRnpfKGg1rgL.jpg","genres":["документальный"],"overview":"Документальный сериал, в котором актёр Шон Бин рассказывает о самых известных фигурах организованной преступности прошлого. В каждом эпизоде он разбирает реальные истории Аль Капоне, Острых козырьков, близнецов Крей, «Королевы Гарлема» и других персонажей, чтобы понять, где в их биографиях правда, а где мифы. Сериал показывает, кем эти люди были на самом деле, чем они прославились и почему до сих пор остаются частью массовой культуры. В программе используются исторические реконструкции, архивные материалы и интервью с историками, криминологами и людьми, которые изучали этих преступников или знали их лично.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"316954","ru":"Цезарь","en":"Цезарь","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/sHyNeMnUXkO3mu14EiKEaC2ej77.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tKril9U55ePIqbOScYTp6nCMqPM.jpg","genres":["комедия"],"overview":"Геннадий Юрьевич Коростелёв жил ничем не примечательной жизнью в ничем не примечательном районном центре, работая на ничем не примечательной работе, пока случайно не узнал старую семейную тайну: оказывается Коростелёв он только по фамилии, а по крови он Цезарь — сын заезжего полковника, когда-то служившего в их краях. Новость производит на Геннадия Юрьевича неизгладимое впечатление — он начинает интересоваться историей Древнего Рима и представлять себя в роли знаменитого римского однофамильца. Казалось бы, смешно, но эта комическая метаморфоза позволяет ему по-новому взглянуть на себя и принять судьбоносное решение — поменять фамилию, а вместе с ней и всю свою жизнь, и жизнь поселка, в который он переезжает из города, а дальше — кто знает — может, даже и жизнь всей России.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"217650","ru":"Dunaj, k vašim službám","en":"Dunaj, k vašim službám","year":"2023","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/dHt0ehVLaHTgN4eulK5T1h0GcmT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jOweYy6FWmYm3r93PBF4qsMHTUO.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"239028","ru":"快乐老友记","en":"快乐老友记","year":"2023","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/tv5YPBExl7ZFafuveJu1auttjqE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dvDGHFUtr8J40a52KgIfG42cIqi.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"281392","ru":"钢铁森林","en":"钢铁森林","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/abKwcuNbavcIGEFGTtLV11GT0dZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6p2BAwHKgIQfkoRdqVf3apf9ON9.jpg","genres":["драма","криминал","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"287267","ru":"여왕의 집","en":"여왕의 집","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/a7f0oIcDl471jQf7AiAc2JamfzN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3gwZomnMVDQFTElsVKsk9RvxbHj.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299988","ru":"ورد على فل وياسمين","en":"ورد على فل وياسمين","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/enD8EeChbrHZnrrHxrG0CPzY94C.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hEUhxDQp2bQkVdu0frnrSKITrww.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"295262","ru":"Bon Cop, Bad Cop","en":"Bon Cop, Bad Cop","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/jIHmjvF0mnW3KhV2stZaoABAiLJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kdJEF1Zj19SlZIduDKKcMCu2dFt.jpg","genres":["криминал","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305078","ru":"東京P.D. 警視庁広報2係","en":"東京P.D. 警視庁広報2係","year":"2026","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1ifRpg5Hj3ldJHQWuqXapcA39xS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zSnH4mnPUlv4EhXO9D8OfHkYslB.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRatin