{"tab":"series","page":264,"pages":367,"count":21970,"pageSize":60,"items":[{"id":"302030","ru":"Gümrük Muhafaza Türkiye","en":"Gümrük Muhafaza Türkiye","year":"2025","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/jUX13IG3Lp9P4KmS03rsiBTtbrT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9fCnUBYHIuB6I5LtU3a2y6BGlSP.jpg","genres":["Реалити-шоу","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"300734","ru":"Pojken i Grannhuset","en":"Pojken i Grannhuset","year":"2025","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/eO7cOC90yDsi7rYIVFaiJNXBn2g.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gtoknziIVViQoY9v5yVAJ93fcNW.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302124","ru":"Případy Jiřího Markoviče","en":"Případy Jiřího Markoviče","year":"2025","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/6hrQamUn0ZfKrXr1PptWEIxpDuE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ngpYqdmxdTgZjaKekkEtkw68ZoS.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"304291","ru":"Die Abrechnung - Der Promi-Showdown","en":"Die Abrechnung - Der Promi-Showdown","year":"2025","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/aR6ZOsu19YkLodW7MxCpRrFMTpU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yLktu5kQPSudKpsuvt1XmDCARrt.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"85533","ru":"Champagne","en":"Champagne","year":"1983","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/15eaG6UatsFMDneCK93kYjZwrmH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vLeEyTqKNHyiHcsx2G2l15rVdJI.jpg","genres":["драма","Мыльная опера"],"overview":"Жан, Патрик, Джоанна, Роман и Гийом дружат уже 30 лет. Патрик собирает старых друзей на свой мальчишник, решив совместить праздник и дегустацию лучших сортов игристого. Беда в том, что гости вечеринки ненавидят будущую жену Патрика и чем крепче градус событий, тем сложнее воспринимать выбор друга на трезвую голову.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"3427","ru":"皆大歡喜","en":"皆大歡喜","year":"2001","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/jvHCHnZxhYqVZRqifAnF3a40ZQa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/krxe8Tx9ZZG8NrG6M60pLumDZLm.jpg","genres":["семейный","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"114328","ru":"全员加速中","en":"全员加速中","year":"2015","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/bJYBQVR2doMX0TZ90CFO449IRlX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qVFi9Z2XexbN7uFJSSG4juidNvM.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"17091","ru":"ITV: Театр","en":"ITV Playhouse","year":"1967","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/uB7lHFZtiTg6lDAhVcuDW7CTbhU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eElJ4e0gR9isCnEOGxJIxxJlagb.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"8712","ru":"Бесконечное лето","en":"Verano del '98","year":"1998","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/z9Zqiyk7KJnXXk46LSU0H0Vr26y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lx28EIoHd2ooJ40lfBXTlhEkG7t.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"5640","ru":"溏心風暴","en":"溏心風暴","year":"2007","type":"Сериал","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/tJMWiCxC1MP5DoQDL7qy8B3PB2S.jpg","b