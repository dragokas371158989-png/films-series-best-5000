{"tab":"series","page":165,"pages":367,"count":21962,"pageSize":60,"items":[{"id":"303668","ru":"Family Pictures","en":"Family Pictures","year":"1993","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/jbJqhbpD82SlwtYeV8uC4rY4PPy.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"254256","ru":"זבנג","en":"זבנג","year":"1998","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/90b5bt0Jlsp3xTNTJIyAU4QnFGA.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"244895","ru":"Легенды колдовской любви","en":"Легенды колдовской любви","year":"2009","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/40kf5tQwJJWE2JugPCJyOlqSL3O.jpg","genres":["драма","Мыльная опера","семейный"],"overview":"Действие происходит в райцентре Кирилловск, куда из деревни приезжает главная героиня первой части сериала. В это время в городе бесследно пропадают несколько человек. Начальник милиции, знакомый с таинственной историей деревни Константиново, вызывает деревенского участкового Фёдора на помощь местному следователю. В ходе расследования к Фёдору попадает старинная тетрадь с описанием таинственной истории начала XIX века.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"130580","ru":"吾係獎門人","en":"吾係獎門人","year":"2002","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/2inRkK2FGxnEM2qg2PD5v0q3dAf.jpg","genres":["Реалити-шоу","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"130528","ru":"宇宙無敵獎門人","en":"宇宙無敵獎門人","year":"2000","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/nXLLcojHaUAPdwIJQnFR9IKq9Fs.jpg","genres":["Реалити-шоу","комедия"],"overview