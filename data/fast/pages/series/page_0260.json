rg/t/p/w342/fNgjy8rDEprVWqeGfzgQ5E0yyIv.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_30801","ru":"1박 2일","en":"1박 2일","year":"2007","type":"Сериал","rating":7.1,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/44CeavkZLqW9Z7SkOffxLNJtAv9.jpg","genres":["комедия","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"3576","ru":"Клан вампиров","en":"Kindred: The Embraced","year":"1996","type":"Сериал","rating":7.1,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/vrTvPwAZoFZyEDslppYxVSUU44B.jpg","genres":["драма"],"overview":"Cериал о современных вампирах, занимающихся организованной преступностью.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"63990","ru":"Давай дерзай!","en":"발칙하게 고고","year":"2015","type":"Сериал","rating":7.1,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/s0kUyrPB4U2VD91mUKRgvRyJ2xM.jpg","genres":["драма","комедия"],"overview":"Что важнее всего в школе - твои оценки или что-то ещё? Кан Ён Ду - яркая, дружелюбная и талантливая девушка. Но, попав в новую, причём элитную школу, где важнее всего успехи в учёбе, она оказывается изгоем из-за пресловутых оценок. Останется ли Кан Ён Ду изгоем или всё-таки сможет обойти остальных?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"59149","ru":"Неопалимая купина","en":"Hořící keř","year":"2013","type":"Сериал","rating":7.1,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/ctHySshid26OWP60IstO2PsDNXx.jpg","genres":["драма","Война и Политика"],"overview":"Фильм начинается с самосожжения Палаха в январе 1969 года в Чехии и показывают непростую ситуацию в обществе, которая осложняется несправедливыми обвинениями в использовании «холодного огня», со стороны Вильяма Нового. Основным действующим лицом сериала является реально существующая женщина-адвокат — Дагмар Бурэшова, которая от лица родных Яна Палаха, подала иск о защите чести и достоинства.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"16046","ru":"Sentimientos Ajenos","en":"Sentimientos Ajenos","year":"","type":"Сериал","rating":7.1,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/eiuTbmgCGgy2xA3BmdI2WfFpfoa.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_3469","ru":"Механик","en":"Minder","year":"1979","type":"Сериал","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/4s9hiyQvTaMe1bK91HRCTgDTAoF.jpg","genres":["комедия","драма","Боевик и Приключения","криминал"],"overview":"Артур Бишоп — «Механик», высокопрофессиональный безукоризненный киллер, который всегда работает по правилам — «чисто» и без следов. Такая работа требует полного самообладания и беспристрастности, и в своём деле ему нет равных. Бишоп всегда работал один, но ему пришлось стать наставником молодого и отчаянного Стива. Методичный профессионал и импульсивный ученик теперь на пару «устраняют проблемы», но рано или поздно они сойдутся в смертельной схватке…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"86365","ru":"Красная линия","en":"The Red Line","year":"2019","type":"Сериал","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/nCWJL4ky03pg5tLclM34gWKHqST.jpg","genres":["драма","криминал"],"overview":"Поднимающая тему расизма драма расскажет о событиях, произошедших после того, как в Чикаго белый полицейский по случайности убил врача-афроамериканца. Это история о трёх семьях, имеющих отношение к случившейся трагедии, рассказанная от лица каждой из них.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"9311","ru":"Секунды до катастрофы","en":"Seconds from Disaster","year":"2005","type":"Сериал","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/clHF8luMdEHSNkyv5bTp5bzXhRG.jpg","genres":["документальный"],"overview":"Американский документальный телевизионный сериал, посвящённый расследованию техногенных катастроф и стихийных бедствий в современной истории, а также анализу причин и событий, которые привели к возникновению каждой из катастроф. Для посекундной реконструкции событий в сериале используются официальные документы, интервью и свидетельские показания. Катастрофы не происходят случайно. К ним ведет цепочка критических событий. Раскроем загадки этой истории и отсчитаем эти последние секунды до катастрофы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"59184","ru":"Хочу любить тебя","en":"Quiero Amarte","year":"2013","type":"Сериал","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/seh2CX0WeAe7norKvTRgOrPmF0U.jpg","genres":["драма","Мыльная опера"],"overview":"Амайя замужем за Горацио. У них общая дочь, Валерия. Тем не менее, их брак трещит по швам. У Максимилиана роман с Констанцей, он собирается на ней жениться, но всё меняется, когда в его жизни появляется Амайя.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"68815","ru":"Лжесвидетельство","en":"솔로몬의 위증","year":"2016","type":"Сериал","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/uuEoHsiCw5LVp7i107NBQ5vfgmz.jpg","genres":["детектив","криминал","драма"],"overview":"Найдено тело школьника на территории школы. Следствие пришло к выводу, что парень совершил самоубийство, но родители, друзья и одноклассники погибшего не смогли примириться с заключением полиции. Тогда другие школьники взяли судебное разбирательство в свои руки, чтобы добиться правды и наказать виновных. Ремейк одноимённого японского фильма 2015 г, который базируется на новелле.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"55630","ru":"MasterChef Italia","en":"MasterChef Italia","year":"2011","type":"Сериал","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/wD8S0XLIrHsKzGuw5xPMjDCYYbq.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"964","ru":"The Ghost Busters","en":"The Ghost Busters","year":"1975","type":"Сериал","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/e6870w2UUqIu1Ndza5xaG5ULia5.jpg","genres":["НФ и Фэнтези","семейный","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"213344","ru":"Springfloden","en":"Springfloden","year":"2016","type":"Сериал","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/jZLihfemUoaaiTNC6T3AFsP3BDA.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"73700","ru":"Un gallo para Esculapio","en":"Un gallo para Esculapio","year":"2017","type":"Сериал","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/en9LmgDdmyQEGFtwyOUAT7W03gc.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"122169","ru":"Сквозь огонь","en":"Onder Vuur","year":"2021","type":"Сериал","rating":7.1,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/sK41CiqsF16VBwdhKueWBBfJxPv.jpg","genres":["драма"],"overview":"История рабочих будней и личных жизней членов пожарной команды города Остенде. Спасение людей для них всегда на первом месте, ради этого они буквально проходят сквозь огонь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_3840","ru":"Комиссар полиции","en":"The Commish","year":"1991","type":"Сериал","rating":7.1,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/osvVYFdCtz223oOQmMcoM1N4JGP.jpg","genres":["драма","комедия"],"overview":"Тони Скали — в прошлом бруклинский коп, а ныне комиссар полиции в небольшом городке, расследующий запутанные дела с помощью интеллекта.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1320","ru":"The Norm Show","en":"The Norm Show","year":"1999","type":"Сериал","rating":7.1,"votes":27,"po