8TvK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xSlkaxD7yr0y2BYexETBXxaofkm.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"312230","ru":"Looking for Cibola","en":"Looking for Cibola","year":"2025","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wMkoTRjXSd2nFw7Cb1oe68YfuH5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9CauEC4Up6lKBbdRtuOhU3bbmsr.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302592","ru":"Pop Elektron Revisited","en":"Pop Elektron Revisited","year":"2025","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/cy1GYoIrByYpv9BWzp1bPunJp06.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dqjQAXqonxWbtTp9X9brDguCzoO.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"6972","ru":"季節","en":"季節","year":"1987","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/z6WBeqlRVSvqgyPz1we4FHMVcIL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s1gFb4nGubODX8aY7V6Q7PNpwBv.jpg","genres":["драма"],"overview":"В основе сюжета положена история английской аристократки, получающей в наследство огромное ранчо на севере австралийского материка. Перед началом Второй мировой войны она приезжает в имение для того, чтобы оберечь его от попыток английских скотоводов заполучить ранчо под названием «Faraway Downs» в свою собственность, и сталкивается с необходимостью при помощи героя Джекмена перегнать 1500 голов скота через тысячи миль в город Дарвин. Там двое попадают под массированные бомбардировки со стороны японского Императорского флота.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"93421","ru":"Самозванка","en":"A Impostora","year":"2016","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/yLtLTnivr3CwnBwKW7E7008u363.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kHAxjfdl1cMgDpIjuxKWa1nE44i.jpg","genres":["драма","Мыльная опера"],"overview":"История начинается с таинственного исчезновения самолета, вместе с которым исчезает предприниматель Фредерику Варела и его служащая Витория. Ее сестра-близнец Вероника думает, что сестра погибла, и решает выдать себя за нее, чтобы ухаживать за ее семилетним сыном Жайме, который борется с раком, а также выяснить, что на самом деле случилось с Виторией и кто в этом виноват...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"118049","ru":"Три сестры","en":"三姉妹","year":"1967","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/d3crGMs3HVnafYdgWjSJFSWA6hx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2WpDH0F04sxDuRFhcpQtRtSzJeo.jpg","genres":["драма"],"overview":"Сестры Донюш, Тюркан и Дерья росли в обстановке, о которой можно только мечтать. Отец и мать окружили их необычайной заботой, теплом, стараясь не подвергать девочек каким-либо лишениям и трудностям. Красивый дом на морском побережье, материальный достаток, живописная природа небольшого городка, атмосфера добра, любви, доверия – то, что сопровождало героинь на протяжении детских лет. Усыпленные счастливым детством, они и предположить не могли, сколько трудностей, испытаний выпадет на долю каждой в новой взрослой жизни. Самым страшным для сестер окажется предательство, последующая боль и разочарование. Они столкнутся с подлостью людей, которым доверяли, считали близкими друзьями. Девушки поймут, что современный мир далек от детской сказки. У каждой героини случится своя драма, своя история любви, свои ошибки и испытания.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305554","ru":"你装纨绔，我装瞎，看谁能演","en":"你装纨绔，我装瞎，看谁能演","year":"2025","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7YcigFJUh7cRv2DTVH95t3tt7fG.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","epis