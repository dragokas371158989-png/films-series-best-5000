альный","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"79313","ru":"Кинопанорама","en":"Cinépanorama","year":"1956","type":"Сериал","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/aA3E04yh8xeNbOEp3Imsq2gqidc.jpg","genres":["документальный","семейный","Ток-шоу"],"overview":"Документальное телешоу с участием известных людей, работающих в киноиндустрии.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"5072","ru":"賭場風雲","en":"賭場風雲","year":"2006","type":"Сериал","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/lvcpdufUx3JpgIt9IdwzplHPn3k.jpg","genres":["драма"],"overview":"Во время бизнес-тура по Восточной Европе руководитель крупной международной оружейной компании Palisade решает устроить восьмерым работникам уикенд для поддержания командного духа и отправляет их на служебном автобусе в Венгрию, в удалённый лесной коттедж. Но до места они не доезжают, поскольку дорогу перегородило упавшее дерево, а водитель, отказавшись ехать другим путём, после конфликта со старшим сотрудником уезжает. Оказавшись в лесной глуши, группа решает пойти пешком и набредает на непрезентабельного вида дом. Вскоре выясняется, что за приехавшими кто-то следит.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"10325","ru":"Fired Up","en":"Fired Up","year":"1997","type":"Сериал","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/2zxTqI8BajdsjT64vnr7uVAwARS.jpg","genres":["комедия"],"overview":"Шона и Ника — звезд футбольной команды средней школы сильно удручает перспектива провести очередное лето на футбольных сборах. И благодаря виртуозной схеме, их жизнь приобретает настоящий вкус! Теперь они могут пронести лето в окружении красивейших девчонок — в лагере для чирлидерш. Все идет прекрасно! Ведь их «тонкая душевная организация» открывает доступ к самым чудным красоткам. Но это длится до тех пор, пока Шон не влюбляется в одну из самых очаровательных капитанш команды Карли, которая видит парней насквозь. Сможет ли Шон доказать свои намерения до начала финальных соревнований? Надо срочно изобрести пару-тройку движений, укрепляющих командный дух!","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"120850","ru":"七十二家房客","en":"七十二家房客","year":"2008","type":"Сериал","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/4uet3s7WlTaGnWF0buys47sKwvC.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"74277","ru":"ドキュメント72時間","en":"ドキュメント72時間","year":"2006","type":"Сериал","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/nVGFaga1eALOjX11vgwZs4FvMEa.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"72392","ru":"Kasam - Tere Pyaar Ki","en":"Kasam - Tere Pyaar Ki","year":"2016","type":"Сериал","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/7lG4aS1NE4arSjkBBlCErJToJtn.jpg","genres":["Мыльная опера","семейный","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"74035","ru":"어서와~ 한국은 처음이지?","en":"어서와~ 한국은 처음이지?","year":"2017","type":"Сериал","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/nVyY29AB1jDc8ndI6D6JTfkiIiM.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"4534","ru":"Almost Live!","en":"Almost Live!","year":"1984","type":"Сериал","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/mF1US0KO8oznRUEQnrSmJKL7WAh.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"81742","ru"