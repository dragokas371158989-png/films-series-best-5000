/wqCGwohb7i6mxRporVN7hAJjClK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jC65TuN4gHTUZDPfIGUP809YBjJ.jpg","genres":["Криминал","Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"306944","ru":"Heajastallan","en":"Heajastallan","year":"2026","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/93l2WVgFqMWgGnVmUkgiQXMuPpE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bzxHrwl2QA8klFLUa9wf6VOEU68.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"311376","ru":"MrBeast: Insane Competitions!","en":"MrBeast: Insane Competitions!","year":"2026","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/yP44m4GhXRIAIr8NgIDIONtD89.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xeZk5bgHge5tORht7yEDvcxJhxE.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"311377","ru":"MrBeast: Inspiring Stories!","en":"MrBeast: Inspiring Stories!","year":"2026","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/rHylzqnumGP3Gnh9GUFsK8zdMgD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vEFUlo8wt8Iq8Qw29JpnF0zTc3F.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"224455","ru":"Простые истины","en":"Простые истины","year":"1999","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/tThG3ymnKNDu1ZUC8csmgDAxC88.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Anq5YSygJIH1shUM7h603MPC5lT.jpg","genres":["Драма","Комедия"],"overview":"Молодёжный телероман о школьной жизни. Ситуации, в которые попадают герои, знакомы каждому подростку, а проблемы, которые герои пытаются решить, волнуют всех: как бороться с безответной любовью (и надо ли?), как разрешить конфликт с учителями или одноклассниками, как найти общий язык с родителями, как прогулять урок физкультуры, как, наконец, подтереть двойку в дневнике без последствий для школьной жизни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"194696","ru":"Уроки любви","en":"Saber Amar","year":"2003","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/kJCTxOrI1drwNCDsghC575w20jc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xISyGEMo4zpa0ykrZUMCGfnRXP2.jpg","genres":["Драма"],"overview":"Диана жила шесть лет в США, где изучала морскую биологию. Вернувшись домой в Алгарве, мечтает об изучении связи между дельфинами и детьми с проблемами социальной интеграции. Чтобы осуществить свою мечту, она пытается найти работу в морском зоопарке \"Зоомарино\". Диана девушка решительная и оптимистичная, но, вопреки своим ожиданиям, она встречает на своем пути множество неудач, как профессиональных, так и личных...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"154762","ru":"Белмонте","en":"Belmonte","year":"2013","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gl7tgKkotuuNyUnHXJ7oiuDg3Vy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hTVO9KRk0eIgoPLwkranh1Ivbzy.jpg","genres":["Драма","Комедия"],"overview":"На процветающей усадьбе Бельмонте работают пятеро братьев. Все они продолжают дело отца и по-настоящему любят свою работу. Семейный бизнес их процветает, но вот однажды в их дом пришло горе - скончался их отец. Вместе с преданным семейству управляющим, братья готовятся выслушать завещание своего недавно скончавшегося отца. В этот самый момент, когда адвокат готов огласить последнюю волю дона Эмилиу, появляется Паула. Оказывается что она - единственная дочь умершего отца, пятеро других детей были им усыновлены. Паула намерена не только получить свою долю наследства, но и перевернуть жизни пятерых братьев.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"114863","ru":"Mentiras verdaderas","en":"Mentiras verdaderas","year":"2011","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lBm5uxFGU40Hz7wztTAcsvh6Ng9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o6KKirdK4WyXfnSTd3QRzHcZJat.jpg","genres":["Ток-шоу","Новости"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"136549","ru":"Απαγορευμένη Αγάπη","en":"Απαγορευμένη Αγάπη","year":"1998","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/koUkb7wJp6JLHx7kIHQl8hihhUh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uKmXlyZAJvp90WJ0QGST5Pu1ysS.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"260609","ru":"Com si fos ahir","en":"Com si fos ahir","year":"2017","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/fCc6tIeV0yOCZq1DoWmFGQX2tOM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2ofetIR5RQmK3oWrFrHarFDFDnC.jpg","genres":["Драма","Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"119353","ru":"Детективы","en":"Детективы","year":"2006","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/9B93mB2Fgngf1mOtIZ2NWZbU7r0.jpg","backdrop":"","genres":["Детектив","Криминал"],"overview":"«Детективы» - так называется частное сыскное агентство. Клиенты обращаются в него тогда, когда надо буквально «докопаться» до правды, когда нужен не просто правовой совет, но активная помощь. И когда надежды или желания обращаться в милицию по вполне понятным причинам быть не может. В интересах клиентов сотрудники «Детективов» разыскивают свидетелей, выезжают на место событий, с помощью современной техники добывают необходимые доказательства. Напряженное молниеносное расследование всякий раз приводит к результатам, неожиданным для клиентов, самих сыщиков и зрителей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"97199","ru":"妻子的浪漫旅行","en":"妻子的浪漫旅行","year":"2018","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/dx3JOkHlSMASuK4xfmQ6N7IRSdd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9SfQdtDNS0SNOzAJiLbmjseUmYK.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}