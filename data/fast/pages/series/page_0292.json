":"","ageRating":""},{"id":"309959","ru":"MrBeast: Extreme Survival!","en":"MrBeast: Extreme Survival!","year":"2026","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/pnzaHNqab5ImCcKVLN0Zfd3a27n.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"317607","ru":"Boom Box: Beats and Betrayal","en":"Boom Box: Beats and Betrayal","year":"2026","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/wqCGwohb7i6mxRporVN7hAJjClK.jpg","genres":["криминал","документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"306944","ru":"Heajastallan","en":"Heajastallan","year":"2026","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/93l2WVgFqMWgGnVmUkgiQXMuPpE.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"311376","ru":"MrBeast: Insane Competitions!","en":"MrBeast: Insane Competitions!","year":"2026","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/yP44m4GhXRIAIr8NgIDIONtD89.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"311377","ru":"MrBeast: Inspiring Stories!","en":"MrBeast: Inspiring Stories!","year":"2026","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/rHylzqnumGP3Gnh9GUFsK8zdMgD.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"224455","ru":"Простые истины","en":"Простые истины","year":"1999","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/tThG3ymnKNDu1ZUC8csmgDAxC88.jpg","genres":["драма","комедия"],"overview":"Молодёжный телероман о школьной жизни. Ситуации, в которые попадают герои, знакомы каждому подростку, а проблемы, которые герои пытаются решить, волнуют всех: как бороться с безответной любовью (и надо ли?), как разрешить конфликт с учителями или одноклассниками, как найти общий язык с родителями, как прогулять урок физкультуры, как, наконец, подтереть двойку в дневнике без последствий для школьной жизни.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"194696","ru":"Уроки любви","en":"Saber Amar","year":"2003","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/kJCTxOrI1drwNCDsghC575w20jc.jpg","genres":["драма"],"overview":"Диана жила шесть лет в США, где изучала морскую биологию. Вернувшись домой в Алгарве, мечтает об изучении связи между дельфинами и детьми с проблемами социальной интеграции. Чтобы осуществить свою мечту, она пытается найти работу в морском зоопарке \"Зоомарино\". Диана девушка решительная и оптимистичная, но, вопреки своим ожиданиям, она встречает на своем пути множество неудач, как профессиональных, так и личных...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"154762","ru":"Белмонте","en":"Belmonte","year":"2013","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gl7tgKkotuuNyUnHXJ7oiuDg3Vy.jpg","genres":["драма","комедия"],"overview":"На процветающей усадьбе Бельмонте работают пятеро братьев. Все они продолжают дело отца и по-настоящему любят свою работу. Семейный бизнес их процветает, но вот однажды в их дом пришло горе - скончался их отец. Вместе с преданным семейству управляющим, братья готовятся выслушать завещание своего недавно скончавшегося отца. В этот самый момент, когда адвокат готов огласить последнюю волю дона Эмилиу, появляется Паула. Оказывается что она - единственная дочь умершего отца, пятеро других детей были им усыновлены. Паула намерена не только получить свою долю наследства, но и перевернуть жизни пятерых братьев.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"308803","ru":"Anime, une épopée japonaise","en":"Anime, une épopée japonaise","year":"2025","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vKoDldIsg9W5QdL9ctSmmY8iQS.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"114863","ru":"Mentiras verdaderas","en":"Mentiras verdaderas","year":"2011","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lBm5uxFGU40Hz7wztTAcsvh6Ng9.jpg","genres":["Ток-шоу","Новости"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"136549","ru":"Απαγορευμένη Αγάπη","en":"Απαγορευμένη Αγάπη","year":"1998","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/koUkb7wJp6JLHx7kIHQl8hihhUh.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"260609","ru":"Com si fos ahir","en":"Com si fos ahir","year":"2017","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/fCc6tIeV0yOCZq1DoWmFGQX2tOM.jpg","genres":["драма","Мыльная опера"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"119353","ru":"Детективы","en":"Детективы","year":"2006","type":"Сериал","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/9B93mB2Fgngf1mOtIZ2NWZbU7r0.jpg","genres":["детектив","криминал"],"overview":"«Детективы» - так называется частное сыскное агентство. Клиенты обращаются в него тогда, когда надо буквально «докопаться» до правды, когда нужен не просто правовой совет, но активная помощь. И когда надежды или желания обращаться в милицию по вполне понятным причинам быть не может. В интересах клиентов 