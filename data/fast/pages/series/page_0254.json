6BpkFo.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"6635","ru":"Oh Baby","en":"Oh Baby","year":"1998","type":"Сериал","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vs6G5RZ3q9w1aEFgJE3eFOcmc5j.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"158240","ru":"Гражданин Бразилии","en":"Cidadão Brasileiro","year":"2006","type":"Сериал","rating":7.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/y8KjQAxk2xpFXjygvAWEMlc2t9F.jpg","genres":["драма","Мыльная опера","Боевик и Приключения"],"overview":"Действие происходит с 1955 по 2006 год. Антониу Масиэль преследует много целей. Одной жизни ему может оказаться недостаточно, чтобы воплотить все свои мечты в реальность. Вот почему он живет каждым мгновением, напряженно борясь с каждой трудностью, с которой сталкивается. Он простой продавец пестицидов. Антонио совершает одну отличную продажу, но Фауста обманывает его, и он теряет все. Фауста - зрелая женщина, она любит приключения и очень умна. Она идет по жизни, чтобы зарабатывать деньги. Оказавшись в долгу, Антонио решает отправиться за Фаустой, чтобы отомстить. Фауста намеревается обмануть одного из самых важных политических лидеров в городе, Атилиу Саллеса Жордау . Антониу, осведомленный о ее планах, пользуется возможностью отомстить и использует ее, чтобы быстро продвинуться по социальной лестнице.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"69408","ru":"結婚式の前日に","en":"結婚式の前日に","year":"2015","type":"Сериал","rating":7.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/5J2stLBlUJ3uWjToD1cpmX5fhGj.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"31955","ru":"神鵰俠侶","en":"神鵰俠侶","year":"1995","type":"Сериал","rating":7.4,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/pkUGghGufdG17N601kD4m04LDNw.jpg","genres":["Боевик и Приключения","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"96041","ru":"Скажи, что ты видела","en":"본 대로 말하라","year":"2020","type":"Сериал","rating":7.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/otP9KY7n6hd5OSP8agRs9alxKYM.jpg","genres":["драма","детектив","криминал"],"overview":"После взрыва, устроенного маньяком и унесшего жизнь его невесты, криминальный профайлер уехал в сельскую глушь подальше от людей. Там он всё же знакомится с местной начинающей полицейской, у которой есть способность помнить всё, что она когда-либо видела.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"155545","ru":"Летние секреты","en":"Cielo grande","year":"2022","type":"Сериал","rating":7.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/z8COSAWI75uSWiMQ7o1fZt7bOm0.jpg","genres":["Детский","драма","семейный","комедия"],"overview":"На далёком аргентинском курорте возобновляются соревнования по вейкборду, куда едет мексиканская спортсменка Cтеффи, полная решимости узнать семейную тайну.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"87148","ru":"Меня зовут Мохаммед Али","en":"What's My Name | Muhammad Ali","year":"2019","type":"Сериал","rating":7.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/u1BpGlsRY5J24I7pIyVT48t1S9K.jpg","genres":["документальный"],"overview":"6 февраля 1967 года Мохаммед Али избивал Эрни Террелла на стадионе в Хьюстоне. Всякий раз он отказывался наносить решающий удар, который бы отправил соперника в нокаут, — и всякий раз спрашивал у Террелла: «Как меня зовут?». Али был по-настоящему зол: перед схваткой Террелл уж слишком назойливо называл его старым именем — Кассиус Клей. Клей сменил имя за три года до этого поединка, фактически став первым мусульманином-суперзвездой в истории поп-культуры.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_46052","ru":"ドクターX ～外科医・大門未知子～","en":"ドクターX ～外科医・大門未知子～","year":"2012","type":"Сериал","rating":7.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/xrn3UDlIU8yMnMTGw8N6I0hYJoU.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_1869","ru":"What's Happening!!","en":"What's Happening!!","year":"1976","type":"Сериал","rating":7.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/oaDvj8di0QjPuxqnANxT9ybn0E1.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"33164","ru":"Просто Мария","en":"Simplemente Maria","year":"1989","type":"Сериал","rating":7.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/6nOsf8qllCFwMNjBGa5lkE4DaoJ.jpg","genres":["Мыльная опера","драма"],"overview":"Мария - юная и наивная крестьянка - приезжает в большой город, чтобы найти работу, которая позволила бы ей обеспечивать себя и семью, которую она оставила в деревне. Вскоре девушка знакомится с богатым Хуаном Карлосом, и молодые люди влюбляются друг в друга. Однако семья Хуана Карлоса категорически против его отношений с крестьянкой, а он сам не способен противостоять родственникам и бежит, когда узнает, что Мария беременна. С помощью своей лучшей подруги Риты Мария знакомится с учителем Виктором Карено, который влюбляется в девушку, но Мария подавлена, ее сердце ожесточено, она не хочет больше влюбляться, чтобы не страдать. Проходят годы. Мария становится известным модельером, ее сын Хосе Игнасио учится на юридическом факультете...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"61606","ru":"Рождение красавицы","en":"미녀의 탄생","year":"2014","type":"Сериал","rating":7.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/t3CT6YyWMlCLyHjfwb1zn3MX3Tz.jpg","genres":["комедия"],"overview":"Хан Тэ Хи - глава крупной корпорации. Из-за психологической травмы он страдает \"синдромом разбитого сердца». Чтобы вернуть свою любовь, он преображает непривлекательную толстушку Са Гым Ран в красавицу Сару. И по ходу преображения Хан Тэ Хи в нее влюбляется.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"64900","ru":"Ангар-1: Архив НЛО","en":"Hangar 1: The UFO Files","year":"2015","type":"Сериал","rating":7.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/b7JYJGFK4aI50KxuuGphhRkIUw5.jpg","genres":["документальный"],"overview":"Созданная в 1969 году Всеобщая организация наблюдения за НЛО (MUFON) сегодня имеет свои представительства в 42 странах мира. В архиве MUFON - более 300 000 документов, связанных с НЛО. Все документы хранятся на закрытом для посторонних складе в Огайо, известном как «Ангар-1». Организация предоставила телеканалу неограниченный доступ в Ангар-1, ко всем хранящимся там документам и уликам, собранным за многие годы. Материалы этого обширного архива проливают новый свет на политические заговоры, прорывы в развитии технологий, перебои с энергоснабжением и другие технологические катастрофы. В каждой серии рассказывается о 3-5 случаях обнаружения НЛО.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"69864","ru":"テラスハウス Aloha State","en":"テラスハウス Aloha State","year":"2016","type":"Сериал","rating":7.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/nYBOS6hekFriElnPsXzT1FmP61Z.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"67392","ru":"Property Brothers: Buying and Selling","en":"Property Brothers: Buying and Selling","year":"2012","type":"Сериал","rating":7.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/3UM6vFhrUGRjCbjgqyoV8y6a1Ka.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"77278","ru":"Louis Theroux: Miami Mega-Jail","en":"Louis Theroux: Miami Mega-Jail","year":"2011","type":"Сериал","rating":7.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/ybLY8T6ZOakye90nO6TFm1nfHKG.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_201836","ru":"Путь домой","en":"The Way Home","year":"2023","type":"Сериал","rating":7.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/kfKsJktZvK22sYX2gV2LjsdIz3u.jpg","genres":["драма","семейный","НФ и Фэнтези"],"overview":"В финальном сезоне пруд переносит Кэт и Элис в семидесятые, где они видят зарождение любви юных Дел и Колтона. Пока Элис готовится к выпускному, а Дел страшится грядущего одиночества, семья раскрывает новые мрачные тайны прошлого, которые уводят женщин Лэндри прямо в эпоху ревущих двадцатых.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"213611","ru":"Наши океаны","en":"Our Oceans","year":"2024","type":"Сериал","rating":7.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/1mwKAh8x5KkX3mRKLU0E88FFRMY.jpg","genres":["документальный"],"overview":"В этом захватывающем документальном сериале рассказываются истории, скрытые под поверхностью пяти океанов Земли.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"218038","ru":"VIVANT","en":"VIVANT","year":"2023","type":"Сериал","rating":7.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/31iHlDe30pudzLfPaAg20H5gJmE.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"155547","ru":"Ser o no ser","en":"Ser o no ser","year":"2022","type":"Сериал","rating":7.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/z0zipqRdOiE2TRtIQ5BsMIiYfhU.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"62163","ru":"Восьмидесятые","en":"Восьмидесятые","year":"2012","type":"Сериал","rating":7.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/5CKCyhNhIsgrgo2IUidmLyVsZfb.jpg","genres":["комедия"],"overview":"Эта история началась еще в 1986 году. Уже шла перестройка, но Советский Союз еще не распался. Это было время, когда не было интернета, гипермаркетов и даже мобильных телефонов, но зато воду пили из-под крана, в Москве не было пробок, а ключи от квартиры спокойно оставляли под ковриком.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"70858","ru":"Красная дверь","en":"La porta rossa","year":"2017","type":"Сериал","rating":7.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/ptMii9yMKkLFV3yZUuO4pcXp5Bj.jpg","genres":["криминал","детектив"],"overview":"Следователь Леонардо Калиостро из маленького города Триеста расследует появление в округе нового наркотика и погибает от руки неизвестного убийцы. Это не останавливает героя, и он продолжает заниматься расследованием в призрачном виде, ведь ему нужно не только выяснить, кто его убил, но и спасти жену от неминуемой гибели.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"11415","ru":"Trigger Happy TV","en":"Trigger Happy TV","year":"2000","type":"Сериал","rating":7.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/jTxlVydhgzBpcuMciNaf1Qak7mR.jpg","genres":["комедия"],"overview":"Молодой писатель Роджер Кобб испытал на собственной шкуре ужасы вьетнамской войны, но это было лишь началом выпавших на его долю испытаний: брак Роджера развалился, малолетний сын исчез, а кровавые кошмары боев продолжали являться Коббу чуть ли не каждую ночь. Чтобы написать книгу о своих переживаниях, Роджер поселился в мрачном, старинном доме, что достался герою по наследству от тети. У дома — не самая лучшая репутация: его хозяйка была найдена повешенной у себя в комнате, и с тех пор по вечерам здесь раздаются странные звуки…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"78144","ru":"Ku'damm 59","en":"Ku'damm 59","year":"2018","type":"Сериал","rating":7.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/6m0xFnyl6rpAr6SH3gSIC5VoiY6.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"91514","ru":"Who Killed Garrett Phillips?","en":"Who Killed Garrett Phillips?","year":"2019","type":"Сериал","rating":7.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/5514E6S44pF430rs1fpBBhvDV68.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"103635","ru":"Роман тигра и розы","en":"传闻中的陈芊芊","year":"2020","type":"Сериал","rating":7.4,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/jy8QXNQD5g5hZWxVa8f5P6yGOGi.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1270","ru":"Тайны отца Даулинга","en":"Father Dowling Mysteries","year":"1989","type":"Сериал","rating":7.4,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/2i5jIo5pt0bdjZh2CbJk2YpWP0M.jpg","genres":["комедия","криминал","детектив"],"overview":"Приходской священник из Чикаго отец Даулинг имеет особый талант: он прирожденный криминалист. Отец Даулинг видит все, слышит все, и замечает все то, мимо чего другие проходят, не останавливаясь. Вместе со своей верной помощницей сестрой Стив отец Даулинг раскроет серию загадочных убийств, которыми наполнены закоулки огромного города.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_2400","ru":"The Red Green Show","en":"The Red Green Show","year":"1991","type":"Сериал","rating":7.4,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/rrDCC0WbGgSDB5pPU1HvllrygNh.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_53007","ru":"Burger Quiz","en":"Burger Quiz","year":"2001","type":"Сериал","rating":7.4,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/oiT0r9RW98aDvELLkpG2QG0uU4e.jpg","genres":["комедия","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_229516","ru":"Superpowered: The DC Story","en":"Superpowered: The DC Story","year":"2023","type":"Сериал","rating":7.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/2MKY8LIUIXPNUHIWneadd5dqPXF.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"96775","ru":"Дом, в котором ты родился - твоя судьба","en":"Doğduğun Ev Kaderindir","year":"2019","type":"Сериал","rating":7.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/66gqC84fH3L9RhJdHOK6vfOK4cL.jpg","genres":["драма"],"overview":"Зейнеп родилась в бедном доме, но в семилетнем возрасте её удочерила богатая пара. Годы спустя повзрослевшая Зейнеп мечется между двумя мирами и двумя семьями, которые предъявляют к ней разные требования.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"70260","ru":"Городские легенды","en":"Urban Myths","year":"2017","type":"Сериал","rating":7.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/1FrR9cP66DjXaW1coGxN1ucVTPR.jpg","genres":["комедия","драма","документальный"],"overview":"В шоу рассказываются удивительные истории, которые случились или могли случиться с некоторыми известными людьми.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"66402","ru":"По дороге с Норманом Ридусом","en":"Ride with Norman Reedus","year":"2016","type":"Сериал","rating":7.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/dQyDwNVO88PK2l8rQLaGR2mW6od.jpg","genres":["Реалити-шоу","документальный"],"overview":"Сериал о путешествиях на мотоцикле, в котором Норман Ридус и приглашенная звезда недели путешествуют в определенную точку Америки на мотоцикле изучая местную байк-культуру и места для мотоциклистов.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_62705","ru":"Married at First Sight","en":"Married at First Sight","year":"2015","type":"Сериал","rating":7.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/2F0ADv2beVB4tRG0qx7YlWMvnDN.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}