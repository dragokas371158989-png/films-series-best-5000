Svpp6RAsgsKBfrbIOmt36n98.jpg","genres":["документальный","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"305952","ru":"Watch Your Back","en":"Watch Your Back","year":"2026","type":"Сериал","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/zUMVYhbxvr7OKBiGkkigdRPOToH.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"316601","ru":"Die Apple-Story – Eine Vision verführt die Welt","en":"Die Apple-Story – Eine Vision verführt die Welt","year":"2026","type":"Сериал","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cVyZUcf1ZhjErhhsdevZdu0qONS.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"118161","ru":"Ронины из Ако","en":"赤穂浪士","year":"1964","type":"Сериал","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/xUmE1LGb4W81LNZ3Hp95VxkbzKf.jpg","genres":["драма"],"overview":"Первая телеадаптация знаменитой истории о 47 ронинах.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"83525","ru":"Тихие страсти Магдалены","en":"Vila Madalena","year":"1999","type":"Сериал","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/6vcebZdcvRNod7QD93LbU5rvsBS.jpg","genres":["Мыльная опера","драма"],"overview":"Солану и Эужения очень любят друг друга. Эужения работает секретарем, а Солану в течение шести месяцев не может найти работу. Ему предлагают работу водителя грузовика и он соглашается. Эужения очень расстраивается, ведь Солану человек с высшим образованием и способен найти что-то получше. Эужения говорит Солану, что она беременна и они очень рады этому. В то же время, другая пара Роберту и Пилар должны пожениться на следующей неделе. Когда все кажется безоблачным случается непредвиденное. Товар, который перевозит Солану оказывается краденым и его задерживает полиция..","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"93641","ru":"Назаре","en":"Nazaré","year":"2019","type":"Сериал","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/mhAd5IyrxRlLWtbbEkf4J0Pu8Vf.jpg","genres":["драма"],"overview":"Назаре Гомес была совсем маленькой, когда ее отец Хоаким бросил ее маму Матильду. Воспитанная матерью девушка очень ей благодарна и, повзрослев, пытается заботиться о ней. А это непросто – Матильда много лет страдает депрессией, к которой недавно присоединилась опухоль мозга. Назаре усердно работает, чтобы накопить денег на дорогостоящую операцию у лондонского хирурга. Он – единственный, кому под силу спасти Матильду, и Назаре готова на все, чтобы к нему попасть.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"4013","ru":"皆大歡喜時裝版","en":"皆大歡喜時裝版","year":"2003","type":"Сериал","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/im3qS74ptAtmu7Tz07cN3xnW7xn.jpg","genres":["комедия","семейный","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"80715","ru":"Firing Line with Margaret Hoover","en":"Firing Line with Margaret Hoover","year":"2018","type":"Сериал","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/lIyK5ZRvZui0uLCHJnjL2oIZENn.jpg","genres":["Ток-шоу","Война и Политика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"233039","ru":"L'Académie des 9","en":"L'Académie des 9","year":"1982","type":"Сериал","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/6juWnjgmx8Dpx3pPc2vVAIc8rAo.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"115992","ru":"The Damage Report with John Iadarola","en":"The Dama