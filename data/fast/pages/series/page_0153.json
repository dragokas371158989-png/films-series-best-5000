ountry":"","ageRating":""},{"id":"135395","ru":"Power of Attorney: Don Worley","en":"Power of Attorney: Don Worley","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/8vTjTwPc8aNJ6l1fJHpoaW3SOb8.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"270696","ru":"Большая игра","en":"Большая игра","year":"2008","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/l41V31mZdVElldF81Qo0My1jcTc.jpg","genres":["документальный"],"overview":"Проект М.Леонтьева – исчерпывающее, уникальное исследование на тему исторического противостояния России сначала с Британской империей, а затем с США. Включенные в проект примеры знаменитых политических и военных дуэлей между великими державами, которые сотрясали весь земной шар, откроют зрителям глаза на один простой факт: события, которые происходят с нами сейчас, уже происходили с нашими предками в той же точно последовательности и с тем же точно результатом\".","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"319368","ru":"Kirstens vilde år","en":"Kirstens vilde år","year":"2026","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hY8Y1dYI77liIu6n9lZOMnwu1yV.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"316057","ru":"嘟嘟嘟：重装运载巨兽出发","en":"嘟嘟嘟：重装运载巨兽出发","year":"2025","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/n6Fp4sWVRzMWFx0h1BQ2spWGOim.jpg","genres":["Детский"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"316050","ru":"嘟嘟嘟：火车大揭秘","en":"嘟嘟嘟：火车大揭秘","year":"2025","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xsRrIdxH3wMSD0wjZlsoVSb89hh.jpg","genres":["Детский"],"o