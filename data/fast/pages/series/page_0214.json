r":"2017","type":"Сериал","rating":9.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/fEfZr0fE6zAlTSdah6cuZj3mguF.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"94723","ru":"Live PD: Wanted","en":"Live PD: Wanted","year":"2019","type":"Сериал","rating":9.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/z7TazmR2225znLaaslSWNbE7Moi.jpg","genres":["криминал","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"3687","ru":"Buffy the Animated Series","en":"Buffy the Animated Series","year":"2008","type":"Сериал","rating":9.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/rZIJX2XsDqxXR3l77KYBaT8eeIe.jpg","genres":["НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"252396","ru":"Следуй за своим сердцем","en":"颜心记","year":"2024","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/6TXKEuHtIE2J4ROWYrxAGGMcaSV.jpg","genres":["детектив","комедия","драма"],"overview":"Цзян Синьбай (Ло Юньси) несколько высокомерен и у него плохая память на лица из-за былой травмы головы, полученной во время спасения девушки. Цзян Синьбай - констебль, \"охотник за головами\". Его отца убили, когда юноше было 18 лет, и теперь он надеется открыть правду о тех событиях. Во время тайного расследования он знакомится с милой и добросердечной девушкой Янь Наньсин (Сун И), которая прекрасно разбирается в лекарственных средствах и владеет боевыми искусствами. В детстве она была похищена. К счастью, какой-то юноша спас ее, но с тех пор Янь Наньсин страдает от странного \"синдрома трансформации\", каждый месяц на несколько дней превращаясь в кого-то другого. Однако Цзян Синьбай с его \"слепотой на лица\" всегда может интуитивно узнать её. Этим двум героям предстоит пройти долгий путь вместе, трижды вступить в брак и раскрыть, наконец, кто же стоит за всеми заговорами и запутанными делами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"157195","ru":"Невероятные путешествия животных","en":"Incredible Animal Journeys","year":"2023","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2eU0hYkTki4VoTCNaEH6UhQjD9r.jpg","genres":["документальный"],"overview":"Люди могут верить, что они величайшие исследователи в мире, но это не так. Миллионы животных мигрируют по всему земному шару каждый день по тропам, которые использовались веками. Присоединяйтесь к Джереми Реннеру, который рассказывает о самом экстремальном приключении.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"293371","ru":"18-летняя прабабушка наводит порядок в семье","en":"十八岁太奶奶驾到，重整家族荣耀","year":"2025","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/gi8OL0rAP1hckftAD6pMjHpLEhG.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278887","ru":"外道の歌","en":"外道の歌","year":"2024","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/f1Xl7nbCQzTbwdFJEHhHfDPTpvy.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"137092","ru":"时光音乐会","en":"时光音乐会","year":"2021","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/j6AFu7MLxLM8dOOo0My9CQV9Ctt.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"242332","ru":"広重ぶるう","en":"広重ぶるう","year":"2024","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/sUES1wPfhnNiYzQo9JVzdGoe9Qr.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"120749","ru":"슬기로운 캠핑생활","en":"슬기로운 캠핑생활","year":"2021","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/4awCOYnKRVS5iq3sTld0WGGqvkD.jpg","genres":["Ре