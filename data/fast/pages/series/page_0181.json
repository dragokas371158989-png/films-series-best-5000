 терпит крушение, и среди немногих выживших – Чема, которого опознают по документам Маркоса и принимают за него...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"104317","ru":"Testkaninerne","en":"Testkaninerne","year":"2015","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/h32dvlZRdGqLYsbqFKb0Jre2Sgm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7h6m7tOUOo63xUIVa5QaU0afZMY.jpg","genres":["Комедия","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"100855","ru":"Being Braydan","en":"Being Braydan","year":"2019","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/gw4yglS7E2nXXvqW2UZ2OKDTwmm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7CNjDum7LAMIbQEaexJSCbVGsWN.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"100637","ru":"Danske mord","en":"Danske mord","year":"2008","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/i6lUKAVjQ0zvVyyN0rHM6wT9Sph.jpg","backdrop":"https://image.tmdb.org/t/p/w780/z6PzTXSKg0c0sHXdynFfPNDq1yL.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"92562","ru":"The Next Big Thing","en":"The Next Big Thing","year":"2019","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9qr2ojQu827cQssSILP2UiWP9dm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ukKBC7UKjm0qBnoLPl5h0eJwSAW.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"91020","ru":"Heroes of World War II","en":"Heroes of World War II","year":"2004","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4uYkJoRVx43IbcTplVPvUri9Q2L.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yM2MkWwtWVzAhetUsv6827I08uL.jpg","genres":["Документальный"],"overview":""