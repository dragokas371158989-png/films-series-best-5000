ихоаналитика Миловавич. Случайно оказавшись в кабаре «Апокалипсис», Шушу попадает на шоу трансвестита Ванессы. Парень в восторге, и вскоре сам становится членом труппы «Апокалипсиса». Он влюбляется в завсегдатая заведения Станисласа. Шушу наслаждается жизнью, пока на горизонте не появляется лейтенант Грегуар. Он – пациент доктора Миловавич. У него множество странностей. Отныне счастье Шушу - под угрозой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"111798","ru":"요즘 육아 금쪽같은 내새끼","en":"요즘 육아 금쪽같은 내새끼","year":"2020","type":"Сериал","rating":6.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/iq7VSsoyJCZZstCiM7Vw5GdXbEB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ApGvX0blnHw1cAaL2QRBlJn7hUR.jpg","genres":["Реалити-шоу","Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"292157","ru":"การโต้กลับของซินแส","en":"การโต้กลับของซินแส","year":"2025","type":"Сериал","rating":6.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/xbfrrWZXvEw7M0uRc7J8c4uEMMd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6ATHhsOUcHfDln6732GAnT7uMvh.jpg","genres":["драма","НФ и Фэнтези","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"107467","ru":"我是歌手","en":"我是歌手","year":"2013","type":"Сериал","rating":6.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/cLcarnYaKBiIssUqp5bq76Dxj2p.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dkQMNLgZMZfVXReu7EBJ88Emcka.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"85518","ru":"Khatron Ke Khiladi","en":"Khatron Ke Khiladi","year":"2008","type":"Сериал","rating":6.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/hazzEPNH1CzajIBzP6PyHjVi1cg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6dBJ8KW0U2yRB6Uzo1CRc3Q2Uww.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}