ting":7.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/znTohwOxX7CsY4LE8PdoNA8OUjU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8QAnW9JDGj5qAu2Il5VvXCEmSqJ.jpg","genres":["Мыльная опера","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278164","ru":"เปย์รักด้วยแมวเลี้ยง","en":"เปย์รักด้วยแมวเลี้ยง","year":"2026","type":"Сериал","rating":7.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6FRWFGxxTg3SMxMIUItDMpEMMYe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gfmkw323bG7Q9XXzxEgNWNiAxnd.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"11229","ru":"10-8: Officers on Duty","en":"10-8: Officers on Duty","year":"2003","type":"Сериал","rating":7.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/ynPRzRwxafY8z2Tjrz3S6sbsvSP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qKYjWs6uwgSztDoHcQRWUIQU2p2.jpg","genres":["Драма","Боевик"],"overview":"Ванесса — трудный и в тоже время несчастный подросток: мать — проститутка и наркоманка, отчим — наркоман и ублюдок, изнасиловавший падчерицу, когда ей было 11 лет. После очередного ареста родителей она сбегает из дома и пытается добраться до своей бабушки в Лос-Анджелес. Некий психиатр Боб Вулвертон, предлагает подбросить Ванессу до Западного побережья. В это время на шоссе подстерегает своих жертв сексуальный маньяк и убийца несовершенолетних девочек. Ванесса становится мишенью преступника, и её ждет смертельная опасность.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"84895","ru":"まれ","en":"まれ","year":"2015","type":"Сериал","rating":7.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/yDC2RkGF4D8EnO8QnoFhviYSKdm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lfjAr2uL5l6midusu231Pjl3bjO.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"83877","ru":"Téléchat","en":"Téléchat