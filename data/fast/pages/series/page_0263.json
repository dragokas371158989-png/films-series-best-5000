трагивают души всех зрителей. Будьте готовы забыть о реальности и погрузиться в мир эмоций и семейных отношений.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"131659","ru":"제시의 쇼!터뷰","en":"제시의 쇼!터뷰","year":"2020","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/jhrwzMvVLwJo9uWhHS9m3IV8tIi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zi5B3468QjH6jM7D8gQYzPgvMQZ.jpg","genres":["Ток-шоу","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"272681","ru":"岁月有情时","en":"岁月有情时","year":"2026","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ly8KtCEkT57YmMO7ztGkawzVXBy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y0R84gqHuRuGJ0rpf7dRf3QjZJW.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"263139","ru":"Самому себе в 1999 году","en":"致1999年的自己","year":"2025","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/AvX4P29ddg7GXQRUbifKn9D8U6q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1RT69lxNUUExpwdkF90nRN5dQ1b.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"304303","ru":"키스키스X스","en":"키스키스X스","year":"2025","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/w0zmCzvedHPlL7p3xQK1iStA12J.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ukDqwekmXUUNCfOQPCFtBZSL2Yr.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"309112","ru":"어느 날 형이 생겼다","en":"어느 날 형이 생겼다","year":"2025","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/sOZXxQqf5hL7NgK52y4mzKO8EnB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o4kcuefNsi5C7EOgZgepLWpEYXm.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},