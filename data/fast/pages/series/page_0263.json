ing":7.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/155ZMISJkCkTleBKKoNlubt51bB.jpg","genres":["комедия","семейный","Ток-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"240335","ru":"Запах сундука","en":"Sandık Kokusu","year":"2023","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/sXzTcIgXMWIotuymY6Lt1zdztWC.jpg","genres":["семейный","драма"],"overview":"В центре сюжета находится Карсу - мощная и увлекательная главная героиня. Она - мать трех прекрасных детей, но не всегда находит с ними общий язык и взаимопонимание, что создает дополнительные сложности их семейной жизни. Волнующая история будет разворачиваться перед зрителями уже в конце осени 2023 года, и мы с нетерпением ожидаем ее премьеры. «Запах сундука» - это не только увлекательное развитие сюжета и запоминающиеся персонажи, но и глубокие семейные ценности, которые затрагивают души всех зрителей. Будьте готовы забыть о реальности и погрузиться в мир эмоций и семейных отношений.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"131659","ru":"제시의 쇼!터뷰","en":"제시의 쇼!터뷰","year":"2020","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/jhrwzMvVLwJo9uWhHS9m3IV8tIi.jpg","genres":["Ток-шоу","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"272681","ru":"岁月有情时","en":"岁月有情时","year":"2026","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ly8KtCEkT57YmMO7ztGkawzVXBy.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"263139","ru":"Самому себе в 1999 году","en":"致1999年的自己","year":"2025","type":"Сериал","rating":7.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/AvX4P29ddg7GXQRUbifKn9D8U6q.jpg","genres":["драма","семейный"],"overv