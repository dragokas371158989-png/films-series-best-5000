://image.tmdb.org/t/p/w342/szBB3GbJqskSUf5ii86ATxjEq5A.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"129578","ru":"스튜디오 K","en":"스튜디오 K","year":"2020","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/jtg26XP7Y9PePiDk7rjM1m3ULop.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"117174","ru":"Cartoon Network to the Rescue","en":"Cartoon Network to the Rescue","year":"2020","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/tL0SJH4lpZne8T0XVNSXWGc2PJ9.jpg","genres":["комедия","семейный","Детский"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"14370","ru":"Nya tider","en":"Nya tider","year":"1999","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3dodshdES4YlIr71mhMoMR4YUpg.jpg","genres":["драма","Мыльная опера"],"overview":"Юный гений Митч поступает в университет в 15 лет. Его соседом по комнате оказывается другой молодой талант, Крис Найт, предводитель компании самых способных студентов университета. В рамках исследовательского проекта одного из профессоров ребята разрабатывают высокомощный лазер, однако профессор похищает его, чтобы продать военным для использования в качестве оружия. Студенты взламывают механизм управления лазером и срывают планы профессора...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"13078","ru":"The Real Estate Pros","en":"The Real Estate Pros","year":"2007","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wr1FlcUBydMWAKSZoyxaIR2EVYc.jpg","genres":[],"overview":"Ширли, выпускница средней школы, подрабатывает нянькой, чтобы заработать на колледж. Она серьёзно «запала» на Майкла, отца двоих ее воспитанников. Однажды вечером Майкл и Ширли срывают запретный плод, и Майкл за это делает надбавку к её зарплате. Друзья Майкла, узнавшие об этом, начинают проявлять интерес к таким услугам ― так Ширли становится школьной мадам с чёрной записной книжкой, организовывая свидания между своими подружками и женатыми мужчинами. Невинный флирт быстро превращается в романы, за которые каждому приходится платить в двойне.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"313043","ru":"Abstinent CEO's Pregnant Sweetheart","en":"Abstinent CEO's Pregnant Sweetheart","year":"2025","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/mVri4yLsmx2CheN27O3fV4TH5Np.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"312287","ru":"Love Is Sweet Torture","en":"Love Is Sweet Torture","year":"2025","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/bwUq9tpZ1btu2t9uKLEdz7e7Oa1.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"246672","ru":"2024年北京广播电视台春节联欢晚会","en":"2024年北京广播电视台春节联欢晚会","year":"2024","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/trwcmvYH6XKKLdcjS0uf47dwNri.jpg","genres":["Реалити-шоу","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"204679","ru":"Maravillas del mundo antiguo con Albert Lin","en":"Maravillas del mundo antiguo con Albert Lin","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xXsdD4vFcGPU06OiSFtNNDimx5h.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"153626","ru":"Confessions d'un tueur","en":"Confessions d'un tueur","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wQbjNFDvxR3byjhLbjE4iFojEaN.jpg","genres":["криминал","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"115821","ru":"Oyunlar Holding","en":"Oyunlar Holding","year":"2021","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/y1L3pR2SXVXzzQvJpRv3UV3L2JO.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"84182","ru":"Gladiators","en":"Gladiators","year":"2010","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/99KX6BrOlKZlIOCudBBnkzlshfZ.jpg","genres":[],"overview":"Когда убивают невесту некогда великого гладиатора, он клянётся найти убийцу. Но правда оказывается страшнее: убийца — не чужак, а свой. Чтобы отомстить, гладиатору придётся снова войти в Колизей — туда, где он когда-то был героем, а теперь станет проклятием.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"56046","ru":"Ангкор: Земля Богов","en":"Angkor: Land of the Gods","year":"2013","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qRKWsVfVlt4wP25J70S1J6ddztM.jpg","genres":["документальный"],"overview":"Буддисты, индуисты и сотни тысяч туристов со всего мира стекаются в Камбоджу каждый год, чтобы испытать величие Ангкора. Его знаменитые храмы были построены на протяжении пяти веков правителями Кхмерской империи, и сегодня они одно из величайших археологических чудес Земли. Присоединяйтесь к нам, и мы прольём свет на одну из самых загадочных, завораживающих цивилизаций в истории человечества. Мы отбросим в сторону мифы и легенды, чтобы раскрыть неизвестную историю создания этого древнего города. Ангкор Ват (Angkor Wat) в переводе с кхмерского означает «город-храм». Это самый популярный и известный объект из всего храмового комплекса Ангкор. Ангкор Ват представляет собой часть храмового комплекса г. Ангкор в индуистском стиле, который был древней столицей Камбоджи вплоть до XV в. На сегодняшний день он сохранился лучше других храмов, расположенных на территории г. Ангкор. Храм Ангкор Ват даже изображен на государственном флаге Камбоджи. Построен храм в период c 1113 по 1150 гг. при правлении короля Сурьявармана II (посмертное имя – Парамавишнулок) и, по одной из версий, возводился, как усыпальница для него...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"12573","ru":"Martha Stewart Living","en":"Martha Stewart Living","year":"","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/2eaWUjV97UcleCwf7KGeCv1UQCz.jpg","genres":[],"overview":"Главным героем фильма «Серьёзный человек» является Ларри Гопник, профессор еврейского колледжа на Среднем Западе в 1967 году. Ларри начинает задаваться вопросом о ценности жизни, когда он обнаруживает, что его жена хочет развестись. У него также проблемы с его детьми, ворующими деньги из его кошелька и его братом-бездельником, который поселился у него, потому что у него нет ни денег, ни зрелости для того, чтобы жить своей собственной жизнью.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"320149","ru":"Så er der banko","en":"Så er der banko","year":"2026","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fsweUm0wyZ1bkzRP9rxTGWpCLsV.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"245668","ru":"A Matter of Sin and Love","en":"A Matter of Sin and Love","year":"2023","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/eo43Bi3jmbwDes9CFjicp85GWAS.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}