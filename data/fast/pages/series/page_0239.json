ttps://image.tmdb.org/t/p/w342/sJk02YyYCfE8ng0SIyUHC0LHHlt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iLS7ngE6ituPfgE0u5Ybr2QZWl5.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"305656","ru":"The Infinite Explorer with Hannah Fry","en":"The Infinite Explorer with Hannah Fry","year":"2025","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/phxPmtcRLNLsDCIp8FsO7CYi036.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lnsUGO1ecITAIukU6scKJE88OcM.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"313274","ru":"Troskyldigheden selv","en":"Troskyldigheden selv","year":"2025","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cXMYkFBlKp3RKtIASwzFUVrglNQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vKrOs4fdshoHLZuK898ko2RA22N.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"34631","ru":"Настоящие романтические любовные письма","en":"리얼 로망스 연애편지","year":"2003","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8qDibJykvNuxSDExWUQlNZalJRX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n7S7mAvhNcMnTUipj74DukDoeGT.jpg","genres":["Комедия"],"overview":"Каждый выпуск шоу состоит из двух частей. Во время шоу участники играют в различные игры. В конце первой части гостья выбирает двух парней, с которыми сходит на свидания, а остальные парни в это время будут вынуждены идти в тренировочный лагерь. В конце второй части, гостья выберет \"идеального мужчину\". Победитель получит значок \"идеальный мужчина\" и поцелуй в щечку от гостьи.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"2882","ru":"This Is Wonderland","en":"This Is Wonderland","year":"2004","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/oDVf1KgCH4FhmyGAa1EJa6sXXr6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2StTZG7zzlXRN7tY1LnoTqkFAJL.jpg","genres":["Драма","Комедия"],"overview":"Экранизация одноимённого романа Анны Гавальда. Трое совершенно разных, но одинаково неприкаянных людей оказываются соседями по квартире. У каждого из них своя история, свои страхи и разочарования. Но каждый хочет одного - быть счастливым. И то, что они оказались вместе, спасло каждого, сделало мудрее, сильнее и дало шанс раскрыться. Это история о душевных ранах и их исцелении, об одиночестве и дружбе, о том, что от ненависти до любви действительно один шаг!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"5203","ru":"Rafferty's Rules","en":"Rafferty's Rules","year":"1987","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/iWY6s5SilGbn6NyiZsc2j0YTrtx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f3jxLETlVbHEoGqPR9X7ZB0LG8u.jpg","genres":["Драма","Криминал","Комедия"],"overview":"Поступив на работу в юридическую фирму, Эмили (Кэрри Отис) — молодая красивая девушка — отправляется в Бразилию помочь завершить крупную сделку с недвижимостью. В Рио-де-Жанейро она встречается с Джеймсом Виллером (Микки Рурк) — загадочным и очень сексуальным миллионером, который, используя свое колдовское очарование, пытается соблазнить невинную красотку. Под сумасшедшие ритмы и краски карнавала он распаляет в девушке вулкан неведомых ей ранее чувств и эротических фантазий, так и не решаясь на активные действия. Эмили потрясена и заинтригована сексуальными выходками, в которых она невольно задействована. Но, спровоцировав девушку на связь с другими мужчинами, а сам выступая в качестве наблюдателя за чужими эротическими сценами, Джеймс с удивлением обнаруживает, что всё-таки по-настоящему влюбился в Эмили. Для него это привычная игра в любовь, но Эмили не хочет и не может играть, она искренна, и это заставляет Виллера открыть ей свое сердце.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"84539","ru":"Чистое сердце","en":"純情きらり","year":"2006","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/AulomJRjwzM9sy9g0klD0xRpXVK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/auhYm8vvhIW33q1U5uMz3Y5vNLf.jpg","genres":["Драма"],"overview":"История начинается в 1928 году. Главная героиня Сакурако - очень энергичная семилетняя девочка. Уже в первом эпизоде она проявляет свою уверенность и энтузиазм. Прежде всего Сакурако хочет стать джазовой пианисткой, и музыке отводится важнейшее место. Далее сюжет захватывает эпоху Второй мировой войны.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"123069","ru":"少林寺传奇","en":"少林寺传奇","year":"2007","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/dgpLAABCLdM2AxuFPmNZ2uZFSbv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hUU7f9E5S3dJOr7ZhgnWGme2z9k.jpg","genres":["Драма","Боевик"],"overview":"Садистка Маргарита хозяйка экзотического борделя в Копенгагене, который удовлетворяет самые изощренные вкусы клиентов. Каждую ночь в борделе красивые девушки показывают стриптиз, а тот кто заплатит наибольшую сумму, сможет удовлетворить свои сексуальные фантазии с участницами шоу. Племянницы Маргариты Сюзанна и Карин, загримированные под тигриц, являются наиболее вожделенными для клиентов. Но их начинают утомлять навязчивые клиенты и они мечтают о настоящей любви. Сюзанна встречает Питера, молодого шведского летчика, который быстро влюбляется в нее. Но он не знает всей правды о Сюзанне...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1089","ru":"זהו זה!","en":"זהו זה!","year":"1978","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/zt0Ev2U9ECsCcCSJ7AZHuQqRNqz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vhAPxbQukz8b2IgBqLIxfCskMXy.jpg","genres":["Комедия"],"overview":"Таинственная банда серфингистов среди белого дня совершает ограбления банков. Полиция и ФБР поражены профессиональностью и скоростью проведения преступлений. Следствие ведет молодой и претенциозный агент ФБР, который, рискуя жизнью, внедряется в банду и раскрывает это дело, но неожиданно для самого себя он осознает, что вернуться к нормальной жизни он уже не сможет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"282658","ru":"Mulheres de Areia","en":"Mulheres de Areia","year":"1973","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/z2Rya5O5o1hCMGK8A3E4olugCv1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mRQPmFVX0i9RVfHixYiSPUAHQQv.jpg","genres":["Мыльная опера","Драма"],"overview":"Сюжет новеллы разворачивается в небольшом райском уголке близ Рио-де-Жанейро. Две сестры, такие похожие внешне, словно они зеркальные отражения друг друга, и такие разные внутри. У каждой из них свои представления о жизни, свои мысли, свои чувства. Одна из них, Ракел, настоящее исчадие ада, мечтающее только об одном - жить богато и беззаботно, и не останавливающееся ни перед чем в достижении своей цели. А другая, Рут, напротив, просто ангел, сошедший с небес, и все, что ей нужно - это любить и быть любимой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"207424","ru":"Хелена","en":"Helena","year":"1987","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/w1vaMs9MiDeWfpQUNF9wXUHYiC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6w2KkwtZsd6SJkEGs3QdSDHyrAm.jpg","genres":["Драма"],"overview":"Бразилия, 1859 год. Дом богатого фазендейро Консельгейро Валя. Сам хозяин, его сестра Урсула и его сын Эстасио. Хозяин умирает. После его смерти обнаруживается, что у него в столице была любовница, от которой у него есть дочка, которую он признал своей. И выделили ей в наследство половину фазенды. После его смерти она приезжает на фазенду. Она молодая и красивая а Эстасио, потрясен и очарован. Но, она его сестра..","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"323116","ru":"Your Loser Husband Is A Big Shot","en":"Your Loser Husband Is A Big Shot","year":"2026","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1olDRVgmNUb7FoaBw1YnCYN3uyE.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"12179","ru":"Mula Sa Puso","en":"Mula Sa Puso","year":"1997","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/w6bpnhAeaceKJTMVoUiwvEyjN2Y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/r8EXfzJ6xiA35nZVgSzuvak4b21.jpg","genres":["Драма","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"83598","ru":"Die Montagsmaler","en":"Die Montagsmaler","year":"1974","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4XTSuukIkXpWKQA2BK3kr89hN60.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ntJxudn4PVRaBadO5gG1b7c5kIS.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"229237","ru":"木枯し紋次郎","en":"木枯し紋次郎","year":"1972","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/oY7gNl0DfG1mHmmAASoPz9WH70k.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ubrQkt6XI4ltGj5vAM7lJ0Kniwu.jpg","genres":["Боевик","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"275344","ru":"Kelime Oyunu","en":"Kelime Oyunu","year":"2009","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/m6voWSntKc1KdABTWNddqu96aUV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e6Vf5x3j6pOpbgW5zDE1LR6pdlL.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"72522","ru":"May I Come in Madam?","en":"May I Come in Madam?","year":"2016","type":"Сериал","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/9