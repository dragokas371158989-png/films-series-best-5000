мимо этого за кадром в сжатом виде раскрывается суть проблемы. Потом показывают некую иллюстрацию данной ситуации со всеми бытовыми подробностями. Снимают человека дома, на работе, в том месте, где происходит конфликт, с представлением всех действующих лиц. Это не один прием-разговор, а много встреч, много разговоров, конкретная проблема и реальное ее решение. Получается реконструкция истории лечения пациента, сжатая до одной программы.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"84791","ru":"愛·回家","en":"愛·回家","year":"2012","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/nQwKCmgbpjb3wIf816t4WNgxzcR.jpg","genres":["комедия","драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"256059","ru":"Ready, Steady, Cook","en":"Ready, Steady, Cook","year":"1994","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3NotbtMdZouIVywd5VcGezBEcNC.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"305237","ru":"Γαλάτεια","en":"Γαλάτεια","year":"2016","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/5MSjIS2FVdtyWGjkKzUVaZCujrT.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"66130","ru":"그것이 알고싶다","en":"그것이 알고싶다","year":"1992","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/dm21RNuQAh4HmovfZgyZ8t8iAMq.jpg","genres":["документальный","Ток-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"82172","ru":"世界遺産","en":"世界遺産","year":"2014","type":"Сериал","rating":8.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/bES9DDFubda9XEIbdcEK6DAu8rZ.jpg","genres":["документальный"]