","studio":"","country":"","ageRating":""},{"id":"40231","ru":"So You Think You Can Dance","en":"So You Think You Can Dance","year":"2008","type":"Сериал","rating":9.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/A1k98bcVYp0F0FxpM3LpBCFrkjk.jpg","genres":["семейный","Реалити-шоу"],"overview":"В мегаполисах США проводится кастинг на отбор ТОР 20 лучших танцоров, которые встретятся в финале. Количество претендентов несколько тысяч. Это реалити-шоу с профессиональными танцорами и обычными людьми.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"77743","ru":"Encantadia","en":"Encantadia","year":"2016","type":"Сериал","rating":9.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/wLJoFUI9rTBB4EeSGULDY3SJcWG.jpg","genres":["драма","НФ и Фэнтези","Боевик и Приключения"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"89525","ru":"生存之民工","en":"生存之民工","year":"2005","type":"Сериал","rating":9.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/wlxWPPipDCSNzv0cRtMTXJMNa53.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"83618","ru":"Horvathslos","en":"Horvathslos","year":"2013","type":"Сериал","rating":9.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/eqjUvdIPRWRA16z6czUz34Qv6SZ.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"224577","ru":"Zodíaca – O Monólogo Definitivo de Cada Signo","en":"Zodíaca – O Monólogo Definitivo de Cada Signo","year":"2019","type":"Сериал","rating":9.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/3HtckGF3MQjleQkVNRnX1qyNOWE.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"218316","ru":"Eu Que Amo Tanto","en":"Eu Que Amo Tanto","year"