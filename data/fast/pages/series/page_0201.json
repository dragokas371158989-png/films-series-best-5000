sa5qAIgtSHPgXdf32RRjyyphkg.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"77419","ru":"Жатва","en":"The Reaping","year":"2018","type":"Сериал","rating":9.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/efgufSzYd8MWXhp2N8GfmimE0CN.jpg","genres":["драма","криминал","детектив"],"overview":"Главная героиня знаменита оригинальным хобби — развеивать мифы. Придумав себе новое развлечение, она отправляется в маленький, Богом забытый городок в штате Техас с намерением развеять его зловещую легенду.В процессе расследования, она понимает, что на этот раз ей придется столкнуться с чем-то действительно мистическим… Ужас, царящий в городе — это не россказни впечатлительных путешественников, а не что иное, как 10 страшнейших библейских проклятий…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"286086","ru":"เมื่อตะวันลับฟ้า ก็จะเป็นเวลาของดวงดาว","en":"เมื่อตะวันลับฟ้า ก็จะเป็นเวลาของดวงดาว","year":"2025","type":"Сериал","rating":9.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/yfIZWoXNMdbb9kQ4zV8hPtcrXqU.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"277215","ru":"レッドブルー","en":"レッドブルー","year":"2024","type":"Сериал","rating":9.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/zN0EZSLoruZ56b4Unm9Afc2JYLQ.jpg","genres":["Боевик и Приключения","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"286773","ru":"How to Cheat Death","en":"How to Cheat Death","year":"2025","type":"Сериал","rating":9.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/6eFEHHUDS0PfIYT6A63lC4JiWTA.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"87680","ru":"Тифлис","en":"ტიფლისი",