s":["драма","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"114574","ru":"Cooku with Comali","en":"Cooku with Comali","year":"2019","type":"Сериал","rating":8.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/iuPhRaSQNj1K6fo1g1dVEQx1Q5d.jpg","genres":["Реалити-шоу","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"46631","ru":"あぶない刑事","en":"あぶない刑事","year":"1986","type":"Сериал","rating":8.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/1fkiEOZeVBsm2lLLD3JGd0EgGvj.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"280916","ru":"Внезапная любовь","en":"突然的喜欢","year":"2026","type":"Сериал","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/oxO7uBExa8fWe98joDVtjSm9zHo.jpg","genres":["драма","комедия"],"overview":"Популярная стримерша и эксперт по отношениям Линь Хуань Эр из 2025 года, неожиданно оказывается в старомодном любовном романе в роли главной героини. На дворе 1999 год, а перед ней властный президент крупной компании, белый снаружи, чёрный внутри. Для того чтобы вернуться в реальный мир, Линь Хуань Эр нужно выполнять задания, которые ей приходят на пейджер. И она пускает в ход весь арсенал уловок и романтических тактик девушки из будущего, пытаясь завоевать сердце Гао Хай Мина. Но все её хитроумные планы с треском проваливаются и... она сама влюбляется в него. Когда цель достигнута, Линь Хуань Эр вдруг понимает, что ей совсем не хочется покидать мир книги и возвращаться в реальность. Сможет ли эта пара из разных миров написать свой собственный роман со счастливым концом? «Белый снаружи, чёрный внутри» китайский аналог идиомы «волк в овечьей шкуре». Сериал снят по роману Чжан Сяо Сянь (张小娴) «Прощай, дикая ласка» (再见野鼬鼠).","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"302617","ru":"ميد تيرم","en":"ميد تيرم","year":"2025","type":"Сериал","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/6MsmDz6M6m5TIVStBuqfd57cglU.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"324175","ru":"El precio de la fama","en":"El precio de la fama","year":"2026","type":"Сериал","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/53igoDkKhiBFTC89qNUXccwf5H.jpg","genres":["криминал","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"300595","ru":"รัก สาป สูญ","en":"รัก สาป สูญ","year":"2025","type":"Сериал","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/rT92fidLdlBRLiWAzhET6U5urFm.jpg","genres":["драма","НФ и Фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"312282","ru":"コントラスト","en":"コントラスト","year":"2026","type":"Сериал","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/gF9uvsknSthHhbelLzwis4Nzoee.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"314297","ru":"Blue Therapy","en":"Blue Therapy","year":"2026","type":"Сериал","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/H8K1osuUf7OsMbtSVPvXJlcnWS.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"83866","ru":"Мошенничество","en":"Cambalacho","year":"1986","type":"Сериал","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/ohZdVSivCsLzyJIIcJghJ4FxuV5.jpg","genres":["Мыльная опера","комедия"],"overview":"Андреа , амбициозная женщина без угрызений совести, выходит замуж за миллионера Антеро Соуза э Сильва. Чтобы унаследовать состояние мужа, она планирует его смерть: яхта, на которой он находился, взрывается в открытом море. Завещание миллионера открыто, и, к отчаянию вдовы, Антеро назначил Леонарду Фуртадо , пропавшую внебрачную дочь, единственным наследником. Леонарда Фуртадо, известная как Нана, с помощью своего друга Жеронимо Мачадо , известного как Жеже, использует уловки, чтобы выжить и продолжить учебу своей дочери Даниэлы в Швейцарии, которую она не видела более десяти лет. Нана забирает домой брошенных несовершеннолетних, которых подбирает на улице. Несмотря на то, что живут аферами, Нана и Жеже хорошие люди. Она не знает, что унаследовала состояние.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"115718","ru":"Οι Συμμαθητές","en":"Οι Συμμαθητές","year":"2014","type":"Сериал","rating":8.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1NEx95LN5HiP1ZYuWaGN1mTWwE5.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"314048","ru":"Парень","en":"Delikanlı","year":"2026","type":"Сериал","rating":8.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/zChQ3tTAtUn306xBrDdI1VQkagZ.jpg","genres":["драма"],"overview":"Юсуф вместе со своей семьей живет в одном из самых бедных районов Турции, но молодой мужчина счастлив, ведь уже совсем скоро он должен жениться на Хазан — своей любимой девушке. Айдемир — одна из самых богатых семей Турции. Сарп — наследник клана начинает строительство спортивного комплекса в районе Юсуфа и случайно знакомится с Хазан. Девушка быстро понимает, что Айдемир может помочь ей выбраться из нищеты, а поэтому она решает оставить Юсуфа в прошлом, не догадываясь о том, на какую месть он способен.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"313100","ru":"हैलो बच्चों","en":"हैलो बच्चों","year":"2026","type":"Сериал","rating":8.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/sBprJ6cIkWWKl4ABWgxNDKxe9kL.jpg"