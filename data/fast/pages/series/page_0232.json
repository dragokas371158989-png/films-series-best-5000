{"tab":"series","page":232,"pages":367,"count":21970,"pageSize":60,"items":[{"id":"285636","ru":"Time Flies","en":"El tiempo de las moscas","year":"2026","type":"Сериал","rating":8.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/9n2HM0guy6Wn95EshDj7Uw6XWd2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qUrVqmzdoRbFQpfbPnYXQQP2Zzl.jpg","genres":["Драма","Комедия","Криминал"],"overview":"Выйдя из тюрьмы и оказавшись в безвыходном положении, две женщины открывают бизнес по дезинфекции помещений — до тех пор, пока сомнительный клиент не втягивает их обратно в жизнь, от которой они пытались сбежать.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"51018","ru":"Reis","en":"Reis","year":"2022","type":"Сериал","rating":8.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/r43ZcZmdN7pqSgCv67nGhjN35lM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vZCVWvGNWCcO0SKO2l1Je6kIXpv.jpg","genres":["Боевик","Драма","Детектив","Война и политика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"258063","ru":"ソウルメイト","en":"ソウルメイト","year":"2026","type":"Сериал","rating":8.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/8ppPFQJhrc6fD6s2roCL7PTRDzX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dW8Gpg3XhumcGUOGC2lVepM9rHy.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"8919","ru":"洗冤錄","en":"洗冤錄","year":"1999","type":"Сериал","rating":8.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/fbonuuEAxTjoPFXTonuDI4ZAcSr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pkDVdZnzWOxEXmRefJhLOhKDhQe.jpg","genres":["Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"72763","ru":"효리네 민박","en":"효리네 민박","year":"2017","type":"Сериал","rating":8.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/gRxSXyayyK8FSSGON1wio0bVyND.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w68sVw6ffw6xCb