"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"262339","ru":"あんぱん","en":"あんぱん","year":"2025","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/rhdmbSPCNCgSFLE0inOs8UWrpq.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}