{"tab":"series","page":157,"pages":367,"count":21970,"pageSize":60,"items":[{"id":"15209","ru":"Секреты Нью-Йорка","en":"New York Confidential","year":"1959","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/s9rZx1mNttR2o0TiD5ry4e0Iin3.jpg","backdrop":"","genres":["Криминал","Драма"],"overview":"\"Секреты Нью-Йорка\" - британско-американский криминально драматический сериал. Сериал рассказывает о приключениях журналиста газеты «Нью-Йорк» Ли Кокрана. Сериал часто неправильно сравнивается сегодня, как проистекающий из одноименного фильма Бродерика Кроуфорда 1955 года. Однако в фильме не фигурирует ни Ли Кокран, ни какой-либо газетный обозреватель. По правде говоря, этими двумя работами были несвязанные попытки адаптировать тот же роман Джека Лайта и Ли Мортимера с разной степенью точности к этому источнику. Фильм часто цитируется как просто «предложенный» книгой, тогда как телесериал рассматривается как «основанный на нём».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"212577","ru":"Golden Warrior","en":"Golden Warrior","year":"2008","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/yJLr01kLXQsN5DZXyVFI6b4INuf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tF9vsQMhg4Z3D7sB985eRSmCBG2.jpg","genres":["Драма","Боевик","Фантастика","Детский"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"109882","ru":"神勇CID","en":"神勇CID","year":"1986","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qGDqYwB1GrHieCKZjs8QpGSv665.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nYWeVii6K26E21MrklVOuKiVcQA.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"46044","ru":"Sat.1-Frühstücksfernsehen","en":"Sat.1-Frühstücksfernsehen","year":"1996","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/x6RTSU6dZaKWAgGudifB2z3BOMI.jpg","backd