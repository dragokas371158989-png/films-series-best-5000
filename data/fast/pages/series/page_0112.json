которая касается наркотиков. Расстроенный его гибелью он возвращается с наличием определенных доказательств виновности преступника. Теперь он начинает преследовать наркобарона, чтобы отомстить за убийство брата.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"91861","ru":"Les Sept de l'escalier 15","en":"Les Sept de l'escalier 15","year":"1967","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/v2Nn3NHPvYjkxOG40jUkjuugaWo.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"30867","ru":"Full Color Football: The History of the American Football League","en":"Full Color Football: The History of the American Football League","year":"2009","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gh2OtPXx297TvLj193ffaxpruLM.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"6248","ru":"Road Wars","en":"Road Wars","year":"2003","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/2AYj59uTv70lxMaZaxyyGxknWe3.jpg","genres":["документальный","Реалити-шоу","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"76709","ru":"Skapi Naslednici","en":"Skapi Naslednici","year":"2018","type":"Сериал","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8hDRbsQCrZMRs9GIqu1n1F3Bh8M.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}