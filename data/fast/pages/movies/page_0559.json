ster":"https://image.tmdb.org/t/p/w342/jYlG2qUdmaeCerlbqyJwBYyeF7u.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wuzZvZiOaJ270xmSfRMbV1bvlJL.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"618597","ru":"Very Ralph","en":"Very Ralph","year":"2019","type":"Фильм","rating":6.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/35B9HpDJPCoaaz70qeERBZPu4eH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rzPmIgvIk3nf3UVgexFzGAbLRV4.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"432688","ru":"Freddy Eddy","en":"Freddy Eddy","year":"2018","type":"Фильм","rating":6.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/1hmtGuP68ZVyoBOsAou1LUznI0P.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3Gp49cizMhzurBQTimJiAH29LSL.jpg","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1546001","ru":"Чем больше, тем веселее","en":"The More the Merrier","year":"2025","type":"Фильм","rating":6.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/3wiTWMVT6RpnMkWfW5tW39Ou8ba.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xCupNqKQI3mnSfNg9COykmkdMAF.jpg","genres":["мелодрама","драма"],"overview":"Элис, врач отделения неотложки в небольшой больнице, всегда добровольно берет ночную смену в канун Рождества и прилагает все усилия, чтобы сделать праздник веселым и ярким для пациентов и персонала. Когда больницу засыпает снегом, Элис и Брайан, недавно нанятый кардиолог, оказываются в эпицентре настоящего «беби-бума», когда три женщины, в том числе единственный акушер-гинеколог в округе, начинают рожать в самый редкий день рождения в году. К концу смены становится ясно, что после этого Рождества их жизнь уже не будет прежней.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1291932","ru":"Воздух которым он дышит","en":"The Air He Breathes","year":"2024","type":"Фильм","rating":6.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/78mVsnTLDpalSVmXM2sNv0GlvZu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jA8DrPoh8x50HCJBqXxYfr6jR6t.jpg","genres":["драма","мелодрама"],"overview":"Элизабет и Тристан, находят утешение и исцеление в обществе друг друга после тяжелых потерь. Преодолев свое горе и прошлые травмы, они открывают для себя силу второго шанса и любви.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"766428","ru":"Мама, я дома","en":"Мама, я дома","year":"2022","type":"Фильм","rating":6.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/aCenm49Nc49ohTqsxSMcXxnpOs1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/DbEFFI99sXLsBmJdqAtLx076e9.jpg","genres":["драма"],"overview":"История этой непростой картины начинается в небольшом поселке под Нальчиком. У Тони − водителя рейсового автобуса на войне в Сирии погибает единственный сын, завербовавшийся в ЧВК. Женщина не хочет верить в смерть сына, пока сама не увидит его тела. Представители ЧВК настаивают, что трагедия на самом деле произошла, но ни военкомат, ни милиция, ни городская администрация не способны ничем помочь матери (что естественно). Тоня пытается добиться расследования, но это только усугубляет ее положение. Однако жизнь Тони и всего поселка переворачивается, когда на пороге ее дома появляется молодой солдат, который представляется её сыном...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1173894","ru":"Бестселлер любви","en":"A Bestselling Kind of Love","year":"2024","type":"Фильм","rating":6.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/At4KSxIl6s4GSlrMAtVHDmTWJCJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wjUQkGaY08EOINX1cPeWW2k2NaX.jpg","genres":["мелодрама","комедия","телевизионный фильм"],"overview":"Флористка Софи Вуд получает шанс построить писательскую карьеру. Опытные редакторы замечают её талант, и новая книга Софи имеет все шансы стать бестселлером. Но впереди её ждут интервью, презентации, пиар-кампании… Она робеет и теряется на первом же выступлении перед небольшой аудиторией. Чтобы побороть свой страх, Софи соглашается пройти тренировочный курс под руководством чуткого наставника Дэниела. Он учит её справляться с волнением на публике – но в присутствии друг друга сердце бьётся чаще.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1062844","ru":"銀河鉄道の父","en":"銀河鉄道の父","year":"2023","type":"Фильм","rating":6.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/7xO75UBglX4KNyhYKvOaTmf6zlN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wD0UHVHWV3kJPgB4bzjFN7MaCc0.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"912632","ru":"ウェディング・ハイ","en":"ウェディング・ハイ","year":"2022","type":"Фильм","rating":6.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/1MYvDAxWQlPVimBo1aFf7dCV5c2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dOJ9ssoQHSmRjPBAIGMsqfqOkql.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"967954","ru":"El Houb","en":"El Houb","year":"2022","type":"Фильм","rating":6.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/gfUU50maD7ttL7nAag5NgK23fMK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gooXF8u43jVhzQFtORoOMcS79yE.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"879337","ru":"ਹੌਂਸਲਾ ਰੱਖ","en":"ਹੌਂਸਲਾ ਰੱਖ","year":"2021","type":"Фильм","rating":6.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/2qyTW8y0GR2LNgSbPUZfbbxXPyy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1BN7dEPtyX4HH8sNDyY6t1Y3ApB.jpg","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"637961","ru":"Videophobia","en":"Videophobia","year":"2020","type":"Фильм","rating":6.3,"votes":11,"po