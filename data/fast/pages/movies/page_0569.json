tps://image.tmdb.org/t/p/w780/xIpVsOGaKuguTQl5k6IGJeDzp6k.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1063863","ru":"七月返歸","en":"七月返歸","year":"2023","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/7InSG7Ts4VVZmqs3hYZZe13JsKS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/boN7LfHrzKrMn8V1jXcpcEvqPrH.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"916093","ru":"O Night Divine","en":"O Night Divine","year":"2021","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/lZqCGeccJSCRs1Tywl0ltROC9if.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hpL90jvkb6XIVl4L5bRIXmikmKf.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"983873","ru":"妖怪シェアハウス—白馬の王子様じゃないん怪—","en":"妖怪シェアハウス—白馬の王子様じゃないん怪—","year":"2022","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/5jpIU2R1WsnGp7KY9m21tsbWqa7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qKv3CAEZvLH4fKagPaZDr8A4s1L.jpg","genres":["драма","фэнтези","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"552475","ru":"Судья Ди: Сделка с Царем Преисподней","en":"狄仁杰之幽冥道","year":"2018","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/tPkPlaY34JruYWMJe77jfiiS0Wy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2GoBv4bdG4DB1Do0A5CMskgfB5z.jpg","genres":["боевик","фэнтези"],"overview":"История о знаменитом судье Ди, которому нужно раскрыть убийство, совершенное самим Царем Преисподней. В городе Вэйчжоу переполох — исчез местный ростовщик. Говорят, что он забрел на пир к Царю Преисподней и его растерзали демонические гости торжества. К тому же среди жителей ходят слухи, что таким образом духи наказывают Китай за политику, которую ведет императрица У Цзэтянь. Разгневанная такими домыслами, она отправляет расследовать это дело самого судью Ди. Приехав в Вэйчжоу, тот находит карту, по которой ростовщик собирался найти сокровища. Все улики указывают, что случай не такой простой, как могло показаться на первый взгляд.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"283521","ru":"Ложно обвинённая","en":"Falsely Accused","year":"2016","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/frQeW8aL0TxbEVexpxKDPgAJBDq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3dBdzRO4M72wOPKxX1oMrfXFi6L.jpg","genres":["криминал","детектив","триллер"],"overview":"Шелли нужно поймать убийцу своего брата, чтобы доказать, что она не виновна. На этом непростом пути она встречает любовь, горе и преследование, и осознает свое истинное предназначение.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"489150","ru":"어린 형수 3","en":"어린 형수 3","year":"2017","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/a8qjKGH7peFrUlewKBSwymurkNs.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9iYiqu4gOWH5vI0VWfUZPiOx1iw.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"578844","ru":"어린 형수 4","en":"어린 형수 4","year":"2019","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2Z2SCginda77LG1wUweyFEFf8KM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1fenXSvsiQY9vH7qT6n8BmOzZHt.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"391892","ru":"커터","en":"커터","year":"2016","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/iAXLCMuAt3RUwN6sW1GZIjcScU6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zpHQMDlqxPKrN2K1Ko8HqGJWJTx.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"572983","ru":"A V