ейных тайн. Члены семьи понимают, что деревянные статуи святых были свидетелями каждого из грехов, и теперь их жизни зависят от того, смогут ли они принять правду, которая может оказаться куда страшнее любого призрака.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1604417","ru":"Get to That Place","en":"Get to That Place","year":"2027","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/7aW2ao05IEmvIrOODDe3MwUXLUg.jpg","genres":["комедия","драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1692623","ru":"Now Playing","en":"Now Playing","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/rn6wvMu5Xwchbdol4KZ9x6H3vVv.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1557399","ru":"zusammen ist man weniger getrennt.","en":"zusammen ist man weniger getrennt.","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/yffdTGcTIc3YfgyUqKlK6m4Iyq6.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}