драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1032121","ru":"Bad Connection","en":"Bad Connection","year":"2023","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/rq3uznZUyjQEhRS4dV2AWRinAnL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kUATo6KXadiJD9WRNmmfrGHcOlm.jpg","genres":["триллер","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1116738","ru":"Mommy's Stolen Memories","en":"Mommy's Stolen Memories","year":"2023","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ijNl1pwWFzNcaaSuhtuWknMBaek.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5Kdog2N14NnWG3NvSxoez4gWiaa.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"733852","ru":"Spiral Drive","en":"Spiral Drive","year":"2020","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/56MLD3uX37VPBot7xhqSauzdrNc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1Z8qLR6OKoXJORrPO9lwWTionA.jpg","genres":["ужасы","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"749550","ru":"An Organized Killer","en":"An Organized Killer","year":"2021","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/2bBCuzmFrptAeN3rAmipTyrzaOA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qpaVl9CgUQqAzCqs4eLnFaoxqc1.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"373181","ru":"Супер Такса","en":"Wiener Dog Internationals","year":"2015","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/sAle9wRIjTKcBySd8uD8plg3YNd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pDFlghFFw0HzSgQQA6dbvj38Lrc.jpg","genres":["семейный","комедия"],"overview":"Что делать, если так ждал Чемпионата мира среди такс, но не получается участвовать? Правильно: хитрить и проявлять находчивость. Шелли и её команда должны быть там. Но в этот раз участники забегов стали в разы сильнее. Сможет ли Шелли выиграть?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"609112","ru":"Переезд по-самурайски","en":"引っ越し大名！","year":"2019","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/76Y1sSFpVHNHoyKV7ZTeUTucE1z.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1WUxnpQE7fsVwtiaqap38tiCMCf.jpg","genres":["комедия","история"],"overview":"Экранизация новеллы, основанной на реальной жизни феодала в Японии периода Эдо. Однажды Наонори Мацудайра, феодал замка Химэдзи, получил указ сёгуна о необходимости переезда из Химэдзи в Оита. Мало того, что его клан ожидают огромные затраты в материальном плане, руководить переездом назначили местного библиотекаря-затворника, Харуносукэ Катагири. Так начинается невиданный по своим масштабам проект, который может поставить под угрозу само существование клана Мацудайра.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"534179","ru":"엄마친구들","en":"엄마친구들","year":"2017","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/n2koZwS6eqOWihxQ1OyEgdiJJya.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9FV3UsHDekhBjUhRisg495BU9bd.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"458085","ru":"아내를 바꾸다","en":"아내를 바꾸다","year":"2017","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/iqnq8JOQj1VJ73vwJuO0J1lmnG3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3fhzOes7tRnoOwf6tqYbbXJTizx.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"784272","ru":"Lughead","en":"Lughead","year":"2019","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/zCv5G