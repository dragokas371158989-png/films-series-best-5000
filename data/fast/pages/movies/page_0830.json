родит по улицам города, опустевшего после эпидемии зомби, и, чтобы выжить, всюду ищет припасы – в домах, магазинах и на складах. Он наслаждается чувством свободы, которого не испытывал до эпидемии. В это же время в город приезжают Матиас и Андреа. Они хотят собрать кое-какие вещи, повидаться с матерью, а затем отправиться в безопасную зону. Вскоре все они встретятся…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1680004","ru":"Сэтгэлийн Уяа","en":"Сэтгэлийн Уяа","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/skCcngI5abjiyXtBLHplwvh5Yz.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1655835","ru":"In the Dream I Forget","en":"In the Dream I Forget","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/bqo8pQ6ERLp8tHoe1ES4iQq4e0n.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1691754","ru":"缺席的猫","en":"缺席的猫","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/23q4j8HKG8s3LA2kU1uNKwI7id8.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1657671","ru":"Chaos Darkness Woman","en":"Chaos Darkness Woman","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/42MCXejpVBhll3mcivoa4PzRs35.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1319600","ru":"Cagüeira","en":"Cagüeira","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/nl38XqA1RYXnfetZRt5ws88J65C.jpg","genres":["драма","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episo