.org/t/p/w342/pofgUZkETInWRlyzFz82Kf6jOEZ.jpg","genres":["мелодрама","комедия"],"overview":"Адам комично лавирует между свадьбой с дочерью босса и внезапным возобновлением отношений с давней возлюбленной, что приводит к неожиданным открытиям о природе любви.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1068830","ru":"Любопытный ресторатор: Сезон барбекю","en":"Curious Caterer: Grilling Season","year":"2023","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/4uuk28oJVIqK8AyUpoxfHIndG9Z.jpg","genres":["телевизионный фильм","детектив"],"overview":"В связи с убийством риэлтора поставщик провизии Голди Берри объединяются с детективом Томом Шульцем. По мере раскрытия личных и профессиональных противоречий они понимают, что преступник находится ближе, чем предполагалось.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"811959","ru":"Великий «Юнайтед»","en":"The United Way","year":"2021","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/5tKjgmfMBu1x6KAUu5HhHmnYpqo.jpg","genres":["документальный"],"overview":"История успеха знаменитого английского футбольного клуба «Манчестер Юнайтед».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"941859","ru":"Ellos eatnu - La elva leve","en":"Ellos eatnu - La elva leve","year":"2023","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/kQZFo5AmJpwvdZ1uMZ2P3LhQIja.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"617776","ru":"Поместье","en":"A Herdade","year":"2019","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/wy78HRf3Gpvzw4e9SLcOzitxwBJ.jpg","genres":["драма","история"],"overview":"Сага о португальской семье, которая владеет одним из крупнейших поместий в Европе, на южном берегу реки Тахо.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"343887","ru":"The Last Laugh","en":"The Last Laugh","year":"2016","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/aSx9GuubOqbCUWAJjt62UogsES2.jpg","genres":["документальный"],"overview":"Вышедший на пенсию менеджер Эл Харт случайно натыкается на своего самого первого клиента — комика Бадди Грина, который оставил шоу-бизнес 50 лет назад. Эл видит в Бадди возможность вернуться в игру. Он уговаривает Бадди сбежать из дома престарелых и отправиться в турне.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299244","ru":"Медленное видео","en":"슬로우 비디오","year":"2014","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/zPxNyV7jpoJWYiXNFQqrXPtcJCJ.jpg","genres":["комедия","драма"],"overview":"Чан-бу видит всё вокруг как при замедленном воспроизведении видео. Когда он был маленьким, дети смеялись над ним, поэтому 20 лет он провёл дома за просмотром дорам. Но потом всё-таки вышел в люди и теперь работает в центре наблюдения.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"621751","ru":"Курс на экологичность","en":"And We Go Green","year":"2019","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/jO6IqXuWb8hY6145rhsNkRUewoz.jpg","genres":["документальный"],"overview":"Документальный фильм о гонщиках Формулы Е - как Формула 1, но на экологичекси чистых электромобилях - борьба за звание чемпиона и гонки в десяти городах.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"406535","ru":"Истерзанные сердца","en":"Inimi cicatrizate","year":"2017","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/4MP2ska5cBLK3DiGl92KHUISrum.jpg","genres":["драма"],"overview":"Лето 1937 года. Больной костным туберкулезом молодой человек двадцати с небольшим лет отправляется в санаторий на Чёрном море. Лечение состоит из болезненных уколов в позвоночник и необходимости много времени проводить в постели. Немного привыкнув в своему печальному положению, Эммануэль вдруг обнаруживает, что и внутри санатория есть своя жизнь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"347423","ru":"The Cannibal in the Jungle","en":"The Cannibal in the Jungle","year":"2015","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/6UVXRYZQfbb1ssFufdanwwYji3Z.jpg","genres":["фантастика","криминал","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"376389","ru":"Sky Ladder: The Art of Cai Guo-Qiang","en":"Sky Ladder: The Art of Cai Guo-Qiang","year":"2017","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/bYE9EZbplP8gbqaT1w9wsSW4n5c.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"324264","ru":"Danny Says","en":"Danny Says","year":"2015","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/oWrWgrWuXM2dAkZzqjuyleH4IOh.jpg","genres":["документальный","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315723","ru":"Ностальгист","en":"The Nostalgist","year":"2014","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/80vXc1EAUUhlzYo6767h8g3G4bX.jpg","genres":["боевик","приключения","фэнтези","фантастика"],"overview":"В ретрофутуристическом городе Ваниль всегда безоблачное ванильное небо - настоящий синтетический рай, поддерживаемый искусственным интеллектом. Но даже идеальная система может дать сбой - и Ваниль окажется потёмкинской деревней, за фасадом которой - мрачное будущее, в котором все - не те, кем кажутся...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1359060","ru":"Сахарное Рождество","en":"Sugarplummed","year":"2024","type":"Фильм","rating":7.0,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/oI4K0OiWzZ9DiGHJXa