ия выходит из-под контроля, и праздники норовят стать слишком идеальными.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"747999","ru":"Мишель Бюто: Добро пожаловать в бютопию!","en":"Michelle Buteau: Welcome to Buteaupia","year":"2020","type":"Фильм","rating":7.0,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/9cZNfEZuGA4KnVGyhymjYv0GCTc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zFfcqEE426H6yN0hXEcKMk7Q1BM.jpg","genres":["Комедия"],"overview":"Невероятная Мишель Бюто завораживает зрителей откровенными размышлениями об отношениях, родительстве, культурных различиях и причинах, по которым ее любят госслужащие.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1167898","ru":"Straight","en":"Straight","year":"2024","type":"Фильм","rating":7.0,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/mJqf675Rjx12lazC7uGTd963u4q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bcVb0UyC15HQq8b6UV9DC0lBC5K.jpg","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1171101","ru":"కుబేర","en":"కుబేర","year":"2025","type":"Фильм","rating":7.0,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/xjLC5DeA4FQTBv4xe8r3wYqh8lu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nbyTX77u3qELm9DYPgYfva7vAwj.jpg","genres":["Криминал","Триллер","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1570282","ru":"This is I","en":"This is I","year":"2026","type":"Фильм","rating":7.0,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/ydS4g1Kzv2KBTGwDR4wKl6FTxGe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6aa0MMYI0cnrAw2ra3E5CmfHfUV.jpg","genres":["Драма","Музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"828378","ru":"പട","en":"പട","year":"2022","type":"Фильм","rating":7.0,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/5ppn9FFpgD3xlpIB9KVEeDTyxDd.jpg","bac