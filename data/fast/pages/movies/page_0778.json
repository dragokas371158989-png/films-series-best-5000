/w780/seXrTnIceyZSYqLiR6acQ8FEfpl.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1187129","ru":"В паутине обмана","en":"Unwinding","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/hkChk0wvGstf3rXSd8UdpqsjHln.jpg","backdrop":"","genres":["Триллер"],"overview":"Частный детектив Гавен Мор пытается наладить свою жизнь воспитывая в одиночку маленького сына после загадочной гибели жены. Когда влиятельный сенатор нанимает его для поиска своего пропавшего наследника, рутинное расследование оборачивается опасным заговором. Погружаясь в темную сторону жизни города, Гавен обнаруживает след тайной организации, чьи нити тянутся к самым верхам власти. Чем ближе он подбирается к истине, тем яснее понимает: похищение связано с его собственным прошлым, а цена правды может стоить жизни его единственному близкому человеку.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1595780","ru":"Crisis Actor","en":"Crisis Actor","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/g74kCDMqgJKuIgAjoBooHODabfg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/enMHynYxQaKe2l8tQuVFE85HNm2.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1562316","ru":"Accept Our Sincere Apologies","en":"Accept Our Sincere Apologies","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/yL8j6fnTzj3C658tWulGpz5lti.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lgzL5IXhHwmZXhmKised0wTjupn.jpg","genres":["Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"811677","ru":"重案·无罪","en":"重案·无罪","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/lCf53achEv6J2HR2TYgsTjt1Ykk.jpg","backdrop":"https://image.tmdb.org/t/p/w78