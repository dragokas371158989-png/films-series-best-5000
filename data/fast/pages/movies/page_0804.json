ятся к музыкальному мероприятию с участием звёзд эстрады. Однажды все они окажутся на корабле, будут по очереди рассказывать свои истории. Корабль поплывёт по тихой реке, а на берегу все-все-все будут прислушиваться: и летучие мыши в разрушенных дворцах, и бродячие фокусники, и гастролирующие диджеи. Им надо расслышать пение джиннов.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1661187","ru":"Sam Wants Her Sweater Back","en":"Sam Wants Her Sweater Back","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/3ba8uCCPTCFnkc8xmexk34stYSU.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1631532","ru":"Блокадный зоопарк","en":"Блокадный зоопарк","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/cr0jFMFRQZ7MnM2QXVO2FyuoymR.jpg","genres":["документальный","военный","история"],"overview":"Рассказ о сотрудниках зоопарка в блокадном Ленинграде, которые в 40-градусные морозы, в условиях голода и постоянных обстрелов и бомбёжек, при отсутствии топлива, электроэнергии и работающего водопровода боролись за жизни редких зверей и птиц.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1418829","ru":"Kabul, Between Prayers","en":"Kabul, Between Prayers","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/p4chzKk2Pk8Szn4rrZfyUCp6K7G.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1620789","ru":"Brick by Brick","en":"Brick by Brick","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/qxTCtp17e3ROZoGhkP5qRo57pMF.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":