 журналиста Алексея Пивоварова. Фильм рассказывает о лидерах протестов, которые происходили в России после выборов президента в марте 2012 года. Среди героев картины — Алексей Навальный, Ксения Собчак, Илья Яшин, Pussy Riot, Борис Немцов, Эдуард Лимонов, Сергей Удальцов. Авторы фильма утверждают, что их работа не является летописью протестов и посвящена только фиксации мыслей и эмоций лидеров оппозиции с целью понять, «куда нас ведут те, кто ради своих убеждений готов идти на срок».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"498366","ru":"Mr. சந்திரமௌலி","en":"Mr. சந்திரமௌலி","year":"2018","type":"Фильм","rating":4.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/oJgHRoykhkE2xJb3kRyEtgszCBT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1Bjn1X5kaYkB1xMN8XrChlZCsuR.jpg","genres":["мелодрама","боевик","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"589677","ru":"入鐵籠","en":"入鐵籠","year":"2019","type":"Фильм","rating":4.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/aP2hIXLutzzsXb1pJit8gdK6TtR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/98d3XPUmdWoz0Y1OsKi2t5L9Js4.jpg","genres":["боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"259277","ru":"Bramman","en":"Bramman","year":"2014","type":"Фильм","rating":4.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/zlKna8jw1I6PDRlIO5HVJ4NEm0j.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jO7OZPeKN8XJypQYwJUIawYa8LC.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"507681","ru":"おもてなし","en":"おもてなし","year":"2018","type":"Фильм","rating":4.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/o7owkz9xnQrbffI9TBqq6YvxoB3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gnoCAQjJ09PptKolh4TN6txZC88.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageR