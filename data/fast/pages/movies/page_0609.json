vzzICXGXuwd6Tx0ealM7ORuU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/faBecyV2MHGdgaTm5qSGjJzRRCN.jpg","genres":["Ужасы","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"724735","ru":"In Berlin wächst kein Orangenbaum","en":"In Berlin wächst kein Orangenbaum","year":"2020","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/mjjpev5dtVXcGuc6iSIw1HZiRWn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iWjbsSPE7Z2W0SGU7YTYz5cepJp.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"435145","ru":"Дело \"Кингс Бэй\"","en":"Kings Bay","year":"2017","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6nrgcWDm46IuLkLQxODbDSNVUrX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3d2vAGut5ZrIbhxNasdsU1KZ74g.jpg","genres":["Триллер"],"overview":"Страдающая алкоголизмом пожилая журналистка крупной норвежской газеты получает от анонимного источника материалы, которые возможно могут пролить свет на трагические события на шахте Кинс Бэй, ставшие причиной одного из крупнейших политических скандалов в истории Норвегии. Но действительно ли за всем стоит политика? Или все же причина куда более прозаична? Это и решает выяснить Гарриета Гансен, начав своё журналистское расследование, которое быстро привлекает к себе внимание таинственной спец.службы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"496324","ru":"Рекрут Саджан Сингх","en":"ਸੱਜਣ ਸਿੰਘ ਰੰਗਰੂਟ","year":"2018","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/zlOvO4fgun0b5B7AxPnPVV2TCVt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mp7ryCvT7zCmDH2VcfME3OHF9Z9.jpg","genres":["Боевик","Драма","Военный"],"overview":"Действие фильма разворачивается в самый разгар Первой мировой войны. Сюжет картины закручивается вокруг полка сикхов, родиной которых является индийский штат Пенджаб. Представители этого этнического меньшинства совсем не пользовались уважением со стороны британских военных, считавших сикхов людьми второго сорта. Саджан Сингх сражается на передовой на западном фронте. Постепенно главный герой начинает осознавать, что ему и его однополчанам не стоит так рисковать своими жизнями ради людей, которые их эксплуатируют. Ему постоянно приходится сталкиваться с необходимостью делать тяжёлый с точки зрения морали выбор, ведь, несмотря на всю абсурдность этой войны, он должен защищать себя и своих товарищей до последней капли крови…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"338399","ru":"ジヌよさらば ～かむろば村へ～","en":"ジヌよさらば ～かむろば村へ～","year":"2015","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/oHmukFeoJe4tSt1e5bHjnby7po6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jWXlxgDrWfm4QO8hw9PFNN2uldS.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"578663","ru":"九月の恋と出会うまで","en":"九月の恋と出会うまで","year":"2019","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/abg5jMjbvIhnsXuLaP9mQ1Yhwa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/z5mHov1cDy3xbElhlWr2AUE2RXs.jpg","genres":["Детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"627064","ru":"Real","en":"Real","year":"2019","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/qeIgzcCW4wBsdy9Fv824XDmi56r.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hqByiNd1gabtv94oF5OdiiwrL09.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"554476","ru":"古宅","en":"古宅","year":"2018","type":"Фильм","rating":5.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/3xG4rL8vMOvX405Xu8aqdA823Uj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xcfY3jEW4vQE8UDciaNw16Z5B85.jpg","genres":["Ужасы"],"overview":"","source":"tm