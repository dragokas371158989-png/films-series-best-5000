а, Нагиса решил порвать с ним, потому что не видел у них будущего. Они расстаются, но через несколько лет Нагиса вновь появляется в жизни Шуна вместе с 6-летней дочерью.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"603170","ru":"Старик и пруд","en":"A Father's Legacy","year":"2021","type":"Фильм","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/vVH01Dm84Nam5q15tIdIaA3LcYi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2kxs8n2FxkI6ve6BZrHNXjpp849.jpg","genres":["Драма"],"overview":"Мужчина в бегах набредает на дом у пруда, где живет одинокий старик, и решает взять пожилого мужчину в заложники. Со временем они понимают, что их встреча не случайна.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1074074","ru":"El ser querido","en":"El ser querido","year":"2026","type":"Фильм","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/bFYCaNsYmj4bOoHGIoqEthRxfRv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7jdH0I7Vf3HtjFTIuoxvkjLwT4C.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1160972","ru":"3 Bed, 2 Bath, 1 Ghost","en":"3 Bed, 2 Bath, 1 Ghost","year":"2023","type":"Фильм","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/hrOWLQxK7zXybn7RUqBRLYxzPqP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ctzeHu8S4pubfRYy38fxQPSKbqP.jpg","genres":["Телевизионный фильм","Комедия","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1002125","ru":"Zee van tijd","en":"Zee van tijd","year":"2022","type":"Фильм","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/bytlbPvg46t1JLZawDk4SC3zdPz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4nlHGM6XWj3YJm28E849h0cf76U.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}