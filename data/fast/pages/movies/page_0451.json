сти корпорации «TerraGroup». Главный герой Скиф – сотрудник ЧВК BEAR. Он вместе с группой своих коллег отправляется в Тарков для поиска своей пропавшей группы, целью которой было перехват стратегически важной информации о секретных разработках корпорации «TerraGroup»...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"883126","ru":"Ještě nejsem, kým chci být","en":"Ještě nejsem, kým chci být","year":"2024","type":"Фильм","rating":8.0,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/savWCVxONT7Xa0KWIcGXdtkE77w.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2XswGPg27ZXhF6cOGJtDX2XDu2V.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1219566","ru":"バジーノイズ","en":"バジーノイズ","year":"2024","type":"Фильм","rating":8.0,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/sQmmCDfOYDZNzvRs6keYqQQQMGm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3shJNzvw01KGaBVvnuFiwuSbnD6.jpg","genres":["Драма","Мелодрама","Музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"492970","ru":"Elton John: I'm Still Standing - A Grammy Salute","en":"Elton John: I'm Still Standing - A Grammy Salute","year":"2018","type":"Фильм","rating":8.0,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/6dyNvikni2kltUjtNjJ0q6w1JdZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mamkWg6K5hpsloTKh67uGKMLcRm.jpg","genres":["Музыка","Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1396122","ru":"তান্ডব","en":"তান্ডব","year":"2025","type":"Фильм","rating":8.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/iplMLlXU1BgmTz4xviILTOlECYL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/v1U3lht8yAgdL9FdpzxlznAqNWH.jpg","genres":["Криминал","Боевик","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"800657","ru":"NO CALL NO LIFE","en":"NO CALL NO LI