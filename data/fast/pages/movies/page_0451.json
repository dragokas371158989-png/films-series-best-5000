607TgZCmyRPo7GQJ.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"295922","ru":"Doctor Who: The Ultimate Companion","en":"Doctor Who: The Ultimate Companion","year":"2014","type":"Фильм","rating":8.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/vmXmHz9BklTDBmNiu4zNi2MaZiH.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1178574","ru":"爸爸","en":"爸爸","year":"2024","type":"Фильм","rating":8.1,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/r8dNrIdJq7riXmexf5B6mLDwUr8.jpg","genres":["криминал","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1087657","ru":"Viva Varda!","en":"Viva Varda!","year":"2023","type":"Фильм","rating":8.1,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/yf512YzcQtPognQkQB1R4D9YUiS.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"950538","ru":"Freedom's Path","en":"Freedom's Path","year":"2023","type":"Фильм","rating":8.1,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/eDzo3kzDDFrvrQ980ZZhUywURDZ.jpg","genres":["драма","история","военный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"422212","ru":"Расскажи всему миру","en":"Tell the World","year":"2016","type":"Фильм","rating":8.1,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/tRNWbJDo1VatznAXt2XIYWuLelL.jpg","genres":["драма","фэнтези"],"overview":"Основанный на реальных событиях, фильм рассказывает об истоках зарождения Церкви Христиан Адвентистов Седьмого Дня — 5-й по численности на сегодняшний день христианской деноминации, представленной более чем в 200 странах. Будучи движимы желанием понять Священное Писание, пионеры движения АСД ошибочно толкуют смысл пророчеств книги Даниила и Откровения и обнаруживают, что 2-е пришествие Христа должно произойти в ближайшее время. Но в назначенный срок их ожидания не оправдываются, происходит \"Великое разочарование\", в следствии которого люди, напуганные событием, но с поверхностной верой оставляют веру, но преданные Богу обнаруживают ошибку и укрепляют веру. Выясняется, что \"Великое разочарование\" было также предсказанной в книге Откровение и Святой Дух всё это время вёл верных последователей, просеивая их ряды для организации всемирной Церкви!","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"691302","ru":"Бесстрашный король кунг-фу","en":"功夫宗师霍元甲","year":"2020","type":"Фильм","rating":8.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/boXAHksMkouUllY33yhWu8i45TE.jpg","genres":["боевик","драма"],"overview":"Когда Хо Юаньцзя был молод и агрессивен, он считал боевые искусства самым важным в жизни. Однако постепенно он понял, что действительно важно помочь стране и людям. Судьба приводит его в Тяньцзинь, где Хо встречает лидера реформистов господина Тана, которого он сопровождает в столицу. Во время этой захватывающей миссии Хо Юаньцзя понимает, как важно нести ответственность за свою страну.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"525540","ru":"Побег из трущоб","en":"Riding with Sugar","year":"2020","type":"Фильм","rating":8.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/b9Sz4j9u3ouuki3tQ0Xtj6vakrv.jpg","genres":["драма"],"overview":"Спасая свою жизнь от военного беспредела, подросток Джошуа бежит из Зимбабве в ЮАР. Вся его семья погибла, у него нет денег и надеется он лишь на милосердие окружающих. Страстное увлечение Джошуа — велосипед BMX, и мальчик поставил перед собой цель стать профессиональным спортсменом. Однако его мечты разбиваются после серьезной травмы колена в результате столкновения с автомобилем. Одинокий и потерянный, он находит приют и наставника в лице Мамбо, такого же беженца, который раньше был профессором в своей родной стране. Но под доброжелательностью Мамбо скрывается темная тайна.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"597749","ru":"Essere Leonardo da Vinci - Un'intervista impossibile","en":"Essere Leonardo da Vinci - Un'intervista impossibile","year":"2019","type":"Фильм","rating":8.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dj9IV4O6qDb3ZyeWhdNpGjLQni0.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1575567","ru":"Лагат, несбыточная мечта","en":"Laghat - Un sogno impossibile","year":"2025","type":"Фильм","rating":8.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/og0V25iiWcfBidMbUcrJXxqcKnY.jpg","genres":["драма"],"overview":"Андреа, бывший жокей, воссоединяется со своим бывшим тренером Тони и берётся за Лагата — выдающегося скакуна с нарушением зрения. Их невероятная связь заставляет Андреа встретиться лицом к лицу со своим прошлым и побороться за последний шанс на искупление.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"804220","ru":"Femme","en":"Femme","year":"2021","type":"Фильм","rating":8.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ormoIW38yXjx26vP8xQdzTGGmOy.jpg","genres":["триллер"],"overview":"Джулс — лондонский дрэг-артист, который замыкается в себе и теряет карьеру после ужасного нападения. Несколько месяцев спустя он узнает одного из нападавших и быстро понимает, что у него есть прекрасная возможность отомстить.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"896405","ru":"অপরাজিত","en":"অপরাজিত","year":"2022","type":"Фильм","rating":8.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/1ut3XJUxQEus4B57TQ5wZHiXgN6.jpg","genres":["драма","история"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"543830","ru":"교회누나","en":"교회누나","year":"2018","type":"Фильм","rating":8.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/tyN8b6ea8kHWOZmtIeYA0eVnCFy.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1246369","ru":"Отступники Муромати","en":"室町無頼","year":"2025","type":"Фильм","rating":8.0,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/s0J4iywfMLMRg4HIXxegzjXncQf.jpg","genres":["боевик","драма"],"overview":"1461 год. Киото накануне войны Онин. Голод и болезни привели к появлению бесчисленных груд мертвых людей на улицах. Однако власти закрывали на все глаза и проводили свои дни только в удовольствиях. Тем временем Хасуда Хёэ, свободный человек, живущий в этом хаотичном мире, полагаясь только на свои собственные навыки и талант, тайно замышляет свергнуть сёгунат и реформировать мир, ожидая подходящего момента, чтобы восстать. Однажды он встречает Сайдзо, у которого есть талант к боевым искусствам, но совершенно нет цели и стремлений. В конце концов воины, собравшиеся вокруг Хёэ, подняли бунт против власти, но им противостоят войска сёгуната.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1026961","ru":"ลอง ลีฟ เลิฟว์","en":"ลอง ลีฟ เลิฟว์","year":"2023","type":"Фильм","rating":8.0,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/wLIu4t4aTPSw9aHYNctQBZPaurY.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"566100","ru":"Семья Чемары","en":"Keluarga Cemara","year":"2019","type":"Фильм","rating":8.0,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/1fHxOly9EWy1cahwIsmcE7k7CT.jpg","genres":["семейный","драма"],"overview":"Владелец строительный фирмы в одночасье теряет свой бизнес из-за мошенничества подчиненного. Вместе с женой и детьми они вынуждены уехать из престижного района Джакарты в провинцию на окраине страны. Но члены семьи не унывают, быстро привыкая к жизни на новом месте. Кемара, его дочь, переживает подростковый период и особенно болезненно переживает переезд. Но неожиданно для самой себя в новой школе она находит друзей и единомышленников.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"362268","ru":"Stretch and Bobbito: Radio That Changed Lives","en":"Stretch and Bobbito: Radio That Changed Lives","year":"2015","type":"Фильм","rating":8.0,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/v16qdesSTFwzbqXxXsyuUZZtUMI.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"570511","ru":"힘을 내요, 미스터 리","en":"힘을 내요, 미스터 리","year":"2019","type":"Фильм","rating":8.0,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/kl0HnWS6DuVX9A6RfUXo4ixBB6i.jpg","genres":["драма","комедия","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"847357","ru":"Введение в детективы: Смертельная история","en":"Mystery 101: Deadly History","year":"2021","type":"Фильм","rating":8.0,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/19pDGoSIq594OGEx3UQD1MFHzNY.jpg","genres":["телевизионный фильм","криминал","детектив"],"overview":"Эми и Трэвис отправляются в Нью-Йорк, чтобы расследовать дело об исчезновении дяди Эми, и улики, которые они находят, приводят их в ужас.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1064662","ru":"劇場版 美しい彼〜eternal〜","en":"劇場版 美しい彼〜eternal〜","year":"2023","type":"Фильм","rating":8.0,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/eL8m72XmU5fAssaGa4BWSKzSTlh.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1188104","ru":"Форсаж в Паттайе","en":"ปล้นทะลุไมล์","year":"2023","type":"Фильм","rating":8.0,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/squhNSzXMrAwPZ0yIKB7RLTsyAw.jpg","genres":["боевик","криминал"],"overview":"Кла — подающий надежды гонщик; его сестра Фун — профессиональный боец ММА. У них одна проблема на двоих — достать крупную сумму на операцию матери. Поиски денег приводят их в мир криминала. Кла предстоит принять участие в мафиозных разборках, а Фун — проиграть в купленном матче и расстаться с мечтой. Но все идет не по плану, и теперь, чтобы выжить, им придется сражаться не на жизнь, а на смерть.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"405604","ru":"Branagh Theatre Live: Romeo and Juliet","en":"Branagh Theatre Live: Romeo and Juliet","year":"2016","type":"Фильм","rating":8.0,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/m8ILvsYustYX3tFN8FwZNjvKj0l.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"942713","ru":"Stolen by Their Father","en":"Stolen by Their Father","year":"2022","type":"Фильм","rating":8.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/m31GJGP8yf0aASFrzrrQe28vvKd.jpg","genres":["драма","телевизионный фильм","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"494456","ru":"Два огонька","en":"두개의 빛: 릴루미노","year":"2017","type":"Фильм","rating":8.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/mNsrcvU2YchCSNJ3mj995lL0a70.jpg","genres":["драма","мелодрама"],"overview":"Романтическая история о слепнущей девушке, её парне и об их общей любви к фотографии.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"738562","ru":"Game of Thrones: The Story So Far","en":"Game of Thrones: The Story So Far","year":"2017","type":"Фильм","rating":8.0,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/eAi9qEEKMTVruWfDFrZ58wEy5xS.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"598254","ru":"Тапок седьмого размера","en":"ஒத்த செருப்பு அளவு -7","year":"2019","type":"Фильм","rating":8.0,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/9DHX4Ip2Kp7jkL7EHYWCw5H9HZ5.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"468200","ru":"Ричард спускается в ад","en":"Riccardo va all'inferno","year":"2017","type":"Фильм","rating":8.0,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/mBqe1DtXVhOVDdvwFjccwYOUteY.jpg","genres":["музыка"],"overview":"В вымышленном королевстве, в замке у подножья Рима живет уважаемая семья Манчини. Потомки знатного рода процветают за счет наркоторговли и прочих незаконных операций. Риккардо Манчини и его братья ведут постоянную борьбу за власть и право называться главой семьи. Но настоящим серым кардиналом Манчини является мать семейства, умело плетущая интриги во благо сохранения status quo. Риккардо возвращается домой после долгого пребывания в психиатрической клинике с намерением захватить корону. И на этот раз он готов идти до конца.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"368834","ru":"The Latin Explosion: A New America","en":"The Latin Explosion: A New America","year":"2015","type":"Фильм","rating":8.0,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/cvZmJeepQTRdg3t9e1oeuivZgDA.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1571485","ru":"Дэвид Боуи: Последняя глава","en":"Bowie: The Final Act","year":"2025","type":"Фильм","rating":8.0,"votes":16,"poster":"https:/