rview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"822593","ru":"Leylak","en":"Leylak","year":"2021","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/rifxHMDRRC4FuDIMgjuI2rmO1oP.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"573675","ru":"Настоящее. Совершенное","en":"完美現在時","year":"2019","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/sSVVBrxiqDcaVj2ZQPGPFwKRkXa.jpg","genres":["документальный"],"overview":"Этот кинематографический коллаж составлен из видео, записанных и выложенных в сеть Интернет малоизвестными людьми, которые в реальной жизни испытывают проблемы в общении из-за своей ориентации, инвалидности, социально-экономического статуса. Эти люди жаждут общения, пусть и в виртуальном мире, но эти виртуальные отношения бросают вызов традиционным представлениям о дружбе.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"843900","ru":"Clue: Maltesergåten","en":"Clue: Maltesergåten","year":"2021","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/fUeEUL5tsilCmz31blD9EQVIWJv.jpg","genres":["криминал","боевик","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"520574","ru":"Банан посреди ночи: Правдивая история","en":"こんな夜更けにバナナかよ 愛しき実話","year":"2018","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/xJDrikrKYbJogRO2JBWu3YApm9W.jpg","genres":["комедия","драма"],"overview":"34-летний Ясуаки Сикано страдает мышечной дистрофией, из-за чего прикован к инвалидной коляске. Несмотря на это, парень ведёт себя эксцентрично: убегает из больницы или требует принести ему банан посреди ночи. Но его беззаботная жизнь заканчивается, когда новенькая девушка-волонтёр Мисаки высказывает эгоистичному Сикано всё, что о нём думает. С тех пор Сикано начинает испытывать к ней романтические чувства, но, к сожалению, у Мисаки есть молодой человек.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"309665","ru":"Мамы 3","en":"Мамы 3","year":"2014","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/d61Vlg0LL623lIfVreFKy08YfmA.jpg","genres":["драма","комедия"],"overview":"31 декабря наши Мамы вместо того, чтобы резать оливье и смотреть «Иронию Судьбы», летят в Прагу праздновать Новый Год «по-европейски». Но самолет из-за погодных условий вынужден приземлиться в аэропорту небольшого, но очень красивого и уютного польского городка. Город встречает Мам абсолютно пустыми улицами. Новый Год для местных жителей- спокойный праздник. Наших Мам и их попутчиков это категорически не устраивает, и они решают устроить в этой «провинциальной Европе» настоящий, безбашенный Новый Год «по-нашему»... Дело за малым - найти Деда Мороза, Советское шампанское, оливье, петарды... в общем, всё, что нужно для праздника!","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"409282","ru":"타부: 새누나","en":"타부: 새누나","year":"2016","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/wfEuhpvmA4QjY4CP0rHr4sysaoo.jpg","genres":["мелодрама","драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"108776","ru":"Трагедия «Счастливого дракона»","en":"第五福竜丸","year":"1959","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/zBHhQtwUS97l20BSYWb5e27Drfw.jpg","genres":["драма"],"overview":"2 января 1954 года рыбачья шхуна «Дракон Удачи №5» вышла в очередной рейс. На корабле есть бригадир и менеджер, но команда больше всего доверяет самому опытному человеку на судне, связисту Аикити Кубояма. В надежде добыть богатый улов судно направляется не на юг, как обычно, а на восток. 1 марта 1954 года рыбаки становятся невольными свидетелями испытания водородной бомбы на атолле Бикини.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"519433","ru":"Quand l'amour se creuse un trou","en":"Quand l'amour se creuse un trou","year":"2018","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/hdfz1LSHbb30NKFndFPXpwXnO4W.jpg","genres":["комедия","мелодрама","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"483450","ru":"宇宙戦隊キュウレンジャー THE MOVIE ゲース・インダベーの逆襲","en":"宇宙戦隊キュウレンジャー THE MOVIE ゲース・インダベーの逆襲","year":"2017","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/v3LICePAsYb5MCoxgqKF7uDlYVv.jpg","genres":["боевик","приключения","фантастика","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"497569","ru":"The Real T Rex with Chris Packham","en":"The Real T Rex with Chris Packham","year":"2018","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/wG1v3gM0g02DZhhtvXUJ7DlvJMQ.jpg","genres":["документальный","история","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"489892","ru":"北の桜守","en":"北の桜守","year":"2018","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/5A36X8YJiUDecx1JRoKbn8Zcu32.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"436816","ru":"ねこあつめの家","en":"ねこあつめの家","year":"2017","type":"Фильм","rating":7.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/pJlM1aQoaRCC4wY0l4iW9GaLFYK.jpg","genres":["комедия","драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating"