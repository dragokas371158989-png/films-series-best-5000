ама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"182981","ru":"Nude Area","en":"Nude Area","year":"2014","type":"Фильм","rating":4.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/qfnt11d8JyjQnyChAalt7QHayoh.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"489705","ru":"Смерть по прибытии","en":"Dead on Arrival","year":"2018","type":"Фильм","rating":4.4,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/vZMn84gTMCXngo80o05GHcnH7cm.jpg","genres":["триллер"],"overview":"Представитель фармацевтической компании приезжает в маленький городок, чтобы подписать контракт на продажу вакцины, но попадает в круговорот бандитских разборок, коррупции и полицейского произвола.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"25493","ru":"The Breastford Wives","en":"The Breastford Wives","year":"2007","type":"Фильм","rating":4.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/tEx2073cwxiN9niVVEvaZikbTMB.jpg","genres":["комедия","драма","фантастика","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"376575","ru":"48 часов, чтобы жить","en":"48 Hours to Live","year":"2016","type":"Фильм","rating":4.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/87tmBJac7Rl4EpCkURXkxqL7x2d.jpg","genres":["криминал","музыка","триллер"],"overview":"В фильме переплетаются черный детектив, танцы и мистика. Преследуемый с обеих сторон закона герой-одиночка возвращается домой из реабилитационного центра, чтобы раскрыть убийство сестры, и оказывается впутанным в игру клубного мира Лос-Анджелеса.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"582148","ru":"Mamma + Mamma","en":"Mamma + Mamma","year":"2018","type":"Фильм","rating":4.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/1dwHgwOH4cylCzapKlT2kDZvmhu.jpg","genres":["мелодрама","драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"258353","ru":"The Good Mistress","en":"The Good Mistress","year":"2014","type":"Фильм","rating":4.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/wjxgjoppoMP2AyJoWJZ5hyULKtE.jpg","genres":["триллер","телевизионный фильм","криминал","детектив","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"776506","ru":"Пылающий мир","en":"The Blazing World","year":"2021","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/s18H9aU7yT91U2XPAc2a3UxldA7.jpg","genres":["ужасы","фэнтези","приключения","драма"],"overview":"С тех пор, как Маргарет исполнилось шесть лет, ее преследуют воспоминания о том, как ее сестра тонет во время ссоры между их родителями. Став молодой женщиной, она все глубже погружается в свою извращенную внутреннюю жизнь и в конечном итоге оказывается на грани самоубийства. Пройдя эпическое путешествие по самым дымным и страшным коридорам своего воображения, она пытается изгнать своих внутренних демонов, что подталкивают ее все ближе и ближе к краю.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"661437","ru":"Похищение в эфире","en":"The Lead","year":"2020","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/m9ZWrxoznoMFBW1mlj8NA0f17er.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"829577","ru":"The Siege of Robin Hood","en":"The Siege of Robin Hood","year":"2022","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/zetKhTVOuScOavtqi2sQT14vcyR.jpg","genres":["приключения","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"532163","ru":"7 осколков во времени","en":"7 Splinters in Time","year":"2018","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/bMLUM7GtjfLXm2urBwoqAkLGG8z.jpg","genres":["детектив","фантастика","триллер"],"overview":"Детектив расследует странное убийство и вскоре узнает, что жертвой оказывается он сам. Дальше он обнаруживает несколько клонов самого себя, и все они недружелюбны к нему.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"441967","ru":"Immigration Game","en":"Immigration Game","year":"2017","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/8vh8u3PZXV7NMfZm635J5pvrsSq.jpg","genres":["драма","триллер","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"336833","ru":"Кавдор","en":"A Haunting in Cawdor","year":"2015","type":"Фильм","rating":4.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/5YbdUgvCFzw4QZtaJvIStj1e1OI.jpg","genres":["триллер","ужасы"],"overview":"Во время отбывания тюремного заключения, женщина обнаруживает ужасающую VHS кассету с кадрами из преступления, совершенного пару лет до этого.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"635146","ru":"Легенда о Пяти","en":"The Legend of The Five","year":"2020","type":"Фильм","rating":4.4,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/4kcwmdFIdk1nlCwjzIRPLZlsiuj.jpg","genres":["фэнтези","приключения","семейный","детектив"],"overview":"Во время скучной поездки в музей группа школьников случайно сталкивается с невероятным волшебным миром. Теперь им предстоит противостоять многовековому злу, желающему уничтожить Землю.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"504588","ru":"Мектуб, моя любовь 2","en":"Mektoub, My Love: Intermezzo","year":"2019","type":"Фильм","rating":4.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/j3F4HpGnAlm34bsukL1TAlrBon6.jpg","genres":["комедия","драма"],"overview":"Летний отпуск Амина подходит к концу. Молодой фотограф проводит приятные вечера с Шарлоттой, бывшей девушкой его двоюродного брата. Она говорит с ним о литературе, он фотографирует ее. Никто не знает, что они видятся, особенно Офелия, подруга детства Амина, которая делится с ним своими многочисленными проблемами…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"648968","ru":"Тутси и фальшивка","en":"ตุ๊ดซี่ส์ แอนด์ เดอะเฟค","year":"2019","type":"Фильм","rating":4.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/efZxuEt7AzMrmeaFvbiuieR45wK.jpg","genres":["комедия"],"overview":"Гасу порядком устала от проблем в личной жизни. Она окончательно запуталась в себе, из-за чего вот-вот опустит руки. Гольф и Ким все те же ребята, которые массу времени посвящают развлечениям и во многом ведут беззаботный образ жизни. Натти будто бы невольно притягивает к себе многочисленные конфузы. Что есть общего у главных героев? Все они не сидят без дела и пытаются решать жизненные, наболевшие проблемы. При этом ребята не зацикливаются на испытаниях, которые подкидывает им судьба. Они стараются оставаться позитивными людьми, верящими, что вот-вот наступит светлая полоса.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"287915","ru":"Одна ночь в Стамбуле","en":"One Night in Istanbul","year":"2014","type":"Фильм","rating":4.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/6HLo27SX1qpTZpPYjYOlFzgOcgC.jpg","genres":["комедия"],"overview":"История о подвигах болельщиков клуба Ливерпуль в финале Лиги Чемпионов в Стамбуле.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"401697","ru":"Во имя Бен-Гура","en":"In the Name of Ben-Hur","year":"2016","type":"Фильм","rating":4.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/jHUjlnbGoLZRBVPkRyChzp6cAOr.jpg","genres":["боевик"],"overview":"Бен-Гур мстит предателям, из-за наговоров которых попал на долгие годы в рабство.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"416572","ru":"Joker's Poltergeist","en":"Joker's Poltergeist","year":"2017","type":"Фильм","rating":4.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/pPJcCvFZBslhVXBvxNW2QxFB5w.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"579296","ru":"Abnormal Attraction","en":"Abnormal Attraction","year":"2018","type":"Фильм","rating":4.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/4JuKQfbbzge3Iyk5c6hcIOmeQFD.jpg","genres":["приключения","комедия","фэнтези","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"712110","ru":"Последние слова","en":"Last Words","year":"2020","type":"Фильм","rating":4.4,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/rnD0z6F9dR9CVSCwUP3ws5sPpo9.jpg","genres":["фантастика"],"overview":"Год 2085, уже десять лет как не родилось ни одного ребёнка. Несколько случайных людей откликнулись на призыв встретиться в Афинах, где юный африканец Джо намерен снять последний фильм на Земле.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"714995","ru":"Братья Мэнсон против зомби","en":"The Manson Brothers: Midnight Zombie Massacre","year":"2021","type":"Фильм","rating":4.4,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/6zcOni8qKtFCdvJr2cCIXkFC5GM.jpg","genres":["ужасы","боевик","комедия"],"overview":"Братья Мэнсон, один из самых противоречивых дуэтов в рестлинге, находятся на закате карьеры и вынуждены принимать любые предложения чтобы заработать. В Хэллоуин им предлагают провести в клетке целую ночь. Они и подумать не могли, что в этот раз им придется противостоять настоящим зомби.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"802065","ru":"Веселье и разочарование 2","en":"F3: ఫన్ అండ్ ఫ్రస్టేషన్","year":"2022","type":"Фильм","rating":4.4,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/c6yJv8fyNONChZ6bSAGsLEnvDKt.jpg","genres":["комедия","мелодрама","семейный"],"overview":"Венки и Варун Ядав — обычные ребята с обычной жизнью. Вся их борьба связана с деньгами. Однажды они узнают о богатом промышленнике из Виджаянагарама, который ищет своего наследника. Что происходит, когда Венки, Варун и банда появляются у его двери, притворяясь его наследником?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"888234","ru":"ధమకా","en":"ధమకా","year":"2022","type":"Фильм","rating":4.4,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/l0E50ILyzg0AyjKuV45aEPuIOz4.jpg","genres":["боевик","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"467377","ru":"Crazy Lake","en":"Crazy Lake","year":"2017","type":"Фильм","rating":4.4,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/zcBMDOBaH4QTPCwXriuNKfcaDyQ.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"440020","ru":"Lycan","en":"Lycan","year":"2017","type":"Фильм","rating":4.4,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/bStFPau3sMO4v1XqEuDHsAdZgEf.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"688809","ru":"Бегущие","en":"The Runners","year":"2020","type":"Фильм","rating":4.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/7vjN3uUo86NMllcEZC0auO7vRzV.jpg","genres":["боевик"],"overview":"Когда младшую сестру Райана похищают с вечеринки в Восточном Техасе, ему предстоит гонка со временем, чтобы успеть найти сестру, прежде чем она окончательно исчезнет в мире секс-торговли.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"32005","ru":"Точка разлома","en":"Breaking Point","year":"2009","type":"Фильм","rating":4.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/r0TnXF7KAEzGOw4q2SBQPx6pBZF.jpg","genres":["боевик","приключения","драма","триллер"],"overview":"Стивен Луизи, бывший некогда известным адвокат по уголовным делам, пытается вернуться к работе, покончив с прошлым наркомана и трагедией в семье. Стивен натыкается на сложное, тонко спланированное дело об убийстве. Вопреки здравому смыслу, он берется за это дело, которое, в конечном счете, приведет его туда, где он лицом к лицу столкнется со своими собственными страхами. Пытаясь раскрыть дело, Стивен обращается за помощью к бывшему спортсмену, ныне члену банды, Ричарду «Beanz» Аллену. Они быстро находят общий язык. Вместе они стремятся докопаться до правды и добиться правосудия в суде и на улицах.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"327266","ru":"A Dark Reflection","en":"A Dark Reflection","year":"2015","type":"Фильм","rating":4.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/2N9pVXXkVEyYCVb6LzTWD6GViIe.jpg","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"982981","ru":"Glamour Girls","en":"Glamour Girls","year":"2022","type":"Фильм","rating":4.4,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/rUVffDPWI7EZLDjkol4I8dl5bov.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"666265","ru":"Амарант","en":"The Amaranth","year":"2018","type":"Фильм","rating":4.4,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/wtyt7E8p2Pk5dMexBFafpSgiiXp.jpg","genres":["драма","детектив","триллер","фантастика"],"overview":"Лили и Ричард переезжают в роскошный дом престарелых Амарант. Лили кажется подозрительным неожиданные перемены в поведение мужа и собственной физиологии, что наталкивает её на мысль о том, что, возможно, в доме далеко не всё так идеально, как кажется.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"338930","ru":"ലോഹം","en":"ലോഹം","year":"2015","type":"Фильм","rating":4.4,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/k3AjjlEH1Rb9YhmTTaHe9lNfECF.jpg","genres":["боевик","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"353500","ru":"Essex Boys: Law of Survival","en":"Essex Boys: Law of Survival","year":"2015","type":"Фильм","rating":4.4,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/uNuSqRIfrCsQPQqbY2LSmV5Ey4m.jpg","genres":["боевик","приключения","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"616982","ru":"Основано на вере","en":"Faith Based","year":"2020","type":"Фильм","rating":4.4,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/gXSXYzdYALkWKv5Iojhyh0PoGoO.jpg","genres":["комедия"],"overview":"Закадычным друзьям Люку и Таннеру давно за тридцать, но они совсем не торопятся взрослеть. В арендованном доме эта парочка прожигает остатки молодости сидя на диване и пересматривая боевики из восьмидесятых. Таким положением дел немало озадачен приемный отец Люка Майк, который работает служителем в церкви и никак не может смириться с тем, что его сын простой чистильщик бассейнов. Тем временем у самого Майка тоже не всё гладко: у его церкви серьёзные финансовые проблемы. Узнав об этом, Люк решает помочь отцу и доказать, что не такой уж он бесполезный разгильдяй. У Люка есть железный план: вместе с Таннером они снимут блокбастер на религиозную тему, а все вырученные с проката деньги отдадут церкви Майка. Друзья берутся за дело, трепещи Голливуд! Озорная комедия о двух простаках в духе культовой «Перемотки».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1498014","ru":"Airplane 2025","en":"Airplane 2025","year":"2025","type":"Фильм","rating":4.4,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/MOh1lS4sA94MMRMrdtcY2ghRUW.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1161980","ru":"A Very English Christmas","en":"A Very English Christmas","year":"2023","type":"Фильм","rating":4.4,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/gZVGCg9RWTev6whA430Ehwvm0h0.jpg","genres":["телевизионный фильм","комедия","мело