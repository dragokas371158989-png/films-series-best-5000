org/t/p/w342/AkMWQY4mPAUGnFLCwj7cPB81Cs4.jpg","genres":["криминал","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"787767","ru":"Family Squares","en":"Family Squares","year":"2022","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/99rpfRJCt6JPhyos1oOZhizQ5Iu.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"530624","ru":"Антиквариат","en":"Antiquities","year":"2019","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/d6xyWHELxrGlR5oaOX2Z22XM9uM.jpg","genres":["комедия"],"overview":"После смерти отца, молодой человек по имени Уолтер хочет узнать о нём побольше, пожить его жизнью и прочувствовать всё на своей шкуре, но в итоге неизбежно сталкивается с собственными проблемами.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"312171","ru":"Sex, кофе, сигареты","en":"Sex, кофе, сигареты","year":"2014","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/31Gu8dL5lySlBWl3ZNnjXzLXuXW.jpg","genres":["драма","комедия"],"overview":"Кого только не встретишь в московских ресторанах! Вам кажется — люди приходят сюда, чтобы насладиться вкусной едой или ароматным кофе с сигаретой? Отнюдь… Они приходят в рестораны, потому что здесь кипит бурная жизнь! Здесь покупают и продают кофейные плантации, здесь орудуют ловкие карманники и хладнокровные убийцы, здесь пишут диссертации о многообразии сексуальных отношений в мире насекомых… Здесь в укромных местах возникают мимолетные связи, здесь находят свою единственную любовь или расстаются навсегда.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"539397","ru":"Недосломленная","en":"Pretty Broken","year":"2018","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/gqIqb9HLBEfxvWYN5ye4rRNTncX.jpg","genres":["комедия","драма"],"overview":"Отец Линдси Лу, профессор геологии, пропал во время восхождения на Эверест после схода лавины. Вся семья уже смирилась с его смертью, лишь Линдси продолжает верить, что отец жив, и решает отправиться на его поиски. Вот только она ничего не смыслит в альпинизме","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"340243","ru":"Все ошибки зарыты","en":"All Mistakes Buried","year":"2015","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/p0FKuXDxKBSZaqRsOzcekrFfZo6.jpg","genres":["драма","триллер"],"overview":"Когда-то у Сонни была идеальная жизнь: хорошая работа, уважение и положительная репутация в обществе, счастливый брак с любимой женщиной и твёрдая уверенность в светлом будущем. Всё рухнуло, когда в жизнь Сонни ворвались наркотики. Постепенно мужчина начал отдаляться от жены, его разум помутнел, внешний вид и сознание с каждым днём становились всё печальнее, пока однажды не настал конец всему. Сонни остался без супруги, денег, карьеры и окончательно погрузился в саморазрушение за счёт употребления тех веществ, на которые у него ещё хватало.Однажды случилось то, что расшевелило последние остатки человечности внутри загнивающего зависимого: преступники украли прекрасный кулон, который Сонни годы назад подарил супруге. Он свято верит, что если вернёт кулон - все ошибки будут похоронены, жена вернётся и жизнь наладится...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"483664","ru":"PlayBoy (and the Gang of Cherry)","en":"PlayBoy (and the Gang of Cherry)","year":"2017","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/3LlbpgxWqPXr5U7jQOPJ6RyXMHh.jpg","genres":["боевик","криминал","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"387847","ru":"친구누나","en":"친구누나","year":"2016","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/5J0SWa3BEYdWfvMgtOJIBAMSPQf.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"398841","ru":"Песня сирен","en":"Blood Lust","year":"2016","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/yWd9zdBDUXvCW69jnnmpaXchn1x.jpg","genres":["ужасы","детектив"],"overview":"После смерти жены, вегетарианский повар ресторана и критик Дэн заводит виртуальные отношения с Келли, которая владеет отелем на острове. Проблемы возникают, когда он приезжает по ее просьбе на остров, и к удивлению Келли, выясняет, что приглашала его не она, а ее странные сестры Лидия и Тесс. И когда другие постояльцы начинают исчезать один за другим, Дэн понимает, что все не так, как кажется, и он не может доверять никому на острове.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"472225","ru":"¿Cómo matar a un esposo muerto?","en":"¿Cómo matar a un esposo muerto?","year":"2017","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/yZQbSUZTSL8jO8DN12XI2uhjAAV.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"323692","ru":"Quitters","en":"Quitters","year":"2015","type":"Фильм","rating":4.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/oTnlhihOXqYs0cAwBxRdFV4adRM.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"625234","ru":"Мотель «Акация»","en":"Motel Acacia","year":"2020","type":"Фильм","rating":4.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/n5nZ6wtfrkY0xo79lSrO3Jto0nD.jpg","genres":["детектив","ужасы"],"overview":"Молодому филиппинцу Джею Си приходится брать в свои руки управление семейным бизнесом, который создал его отчуждённый отец-тиран. Им является мотель, одиноко стоящий в пустыне. Там предоставляют убежище нелегально въехавшим в страну людям, под присмотром правительства. Скоро новый хозяин и гости обнаружили, что в «Акации» нашёл прибежище тёмный и очень древний дух. Это потустороннее существо, дух отца Джей Си, пожирает людей. Однажды вокруг заведения начинается бурная метель, в то время как еда подходит к концу. Все оставшиеся в живых объединяются и начинают отчаянно биться за свою жизнь. В этой борьбе с тенью отца молодой человек рискует превратиться в зверя…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1233324","ru":"Невидимая сестра","en":"乔妍的心事","year":"2024","type":"Фильм","rating":4.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/fl8P4exEv1TyAX4V518DQC9NEj9.jpg","genres":["драма","детектив"],"overview":"Актрисе удается справляться с разными трудностями и унижениями за время своей карьеры. Однако её относительное благополучие оказывается под угрозой из-за попытки вымогательства и появления сбежавшей из дома много лет назад сестры.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"516579","ru":"Бойн Фолс","en":"Boyne Falls","year":"2018","type":"Фильм","rating":4.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/mHt70oLFENHqwSz4opWS0R6pqpE.jpg","genres":["триллер"],"overview":"Когда-то Доминик и Эдди были лучшими друзьями, которым удалось сколотить целое состояние, работая в музыкальной индустрии, однако спустя несколько лет их дружба угасла и мужчины перестали общаться. Чтобы вспомнить былые времена и отдохнуть от работы, Эдди уговаривает Доминика отправиться с ним в поход и провести несколько дней на природе. Но все их планы рушатся, когда они случайно находят в лесной чаще лабораторию по производству наркотиков, хозяева которой оказались не рады тому, что их обнаружили. Теперь, чтобы выжить, мужчинам снова придется вспомнить, каково это — работать сообща.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"398780","ru":"Колеблющийся штат","en":"Swing State","year":"2017","type":"Фильм","rating":4.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/lb1LDus4hIuONUqKp0Ik85DDcUT.jpg","genres":["комедия"],"overview":"Богемный радиоведущий из Сиэтла, используя свою харизму в эфире, создаёт фиктивную медийную персону, которая в одночасье становится знаменитой.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"367153","ru":"Бедный мальчик","en":"Poor Boy","year":"2018","type":"Фильм","rating":4.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/oxAGYHNQeScvCxZuhzMj0dRUEFp.jpg","genres":["драма","вестерн"],"overview":"Два брата, проживающих в ветхом доме на забытой богом окраине и промышляющих криминальными делишками, хотят перебраться в солнечную Калифорнию. Чтобы осуществить свою мечту, они решают провернуть рискованное дело.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"580116","ru":"ザ・レイプ","en":"ザ・レイプ","year":"1982","type":"Фильм","rating":4.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/kY6gWfEJMjJ0JSvDkBuOCB3U6v0.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"506406","ru":"Hello Apartment","en":"Hello Apartment","year":"2018","type":"Фильм","rating":4.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/tsU24xCcBrc71i0XH9TsySv4lIV.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"463857","ru":"Passade","en":"Passade","year":"2017","type":"Фильм","rating":4.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/7i8Oy9RTaBlGfc6ZDEOuTTtv5sq.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","statu