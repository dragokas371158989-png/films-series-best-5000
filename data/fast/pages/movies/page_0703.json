ge.tmdb.org/t/p/w342/3kPiE2X1neiHDcAXEzCKK3fQJD6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m5G2iMzzxDygPHkzNRAV20DggsZ.jpg","genres":["драма","мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"474333","ru":"Рэй встречает Хелен","en":"Ray Meets Helen","year":"2018","type":"Фильм","rating":4.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/vFBKIdcBqoruoIKOrbWqHEBWtqp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/65dOkC8orRqK9Uoz1KL4ZS9tn7x.jpg","genres":["драма","фэнтези","мелодрама"],"overview":"По невероятному стечению обстоятельств Рэй и Хелен вдруг становятся сказочно богаты. Теперь у них, наконец-то, появляется шанс оставить прошлое в прошлом и начать новую счастливую жизнь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"45032","ru":"Маслин-Бич","en":"Maslin Beach","year":"1997","type":"Фильм","rating":4.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/waznlBbrvgkzb3DMnygqDAjkyEg.jpg","backdrop":"","genres":["комедия","драма","мелодрама"],"overview":"Действие фильма разворачивается на знаменитом нудистском пляже Маслин. Декорации не могут быть более захватывающими, особенно, поскольку это пляж Маслин, наиболее посещаемых ню пляж в Австралии, сюда престают люди в поисках веселой, полной романтики и приключений жизни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"332996","ru":"Trust Fund","en":"Trust Fund","year":"2016","type":"Фильм","rating":4.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/uQnLaKaEH4Y5IS15wf959aDPUU9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/i3QChkL2rnvh0Z5HGll9cGAglq9.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"550433","ru":"פרא אציל","en":"פרא אציל","year":"2018","type":"Фильм","rating":4.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/tK3gjCTOH1dqSkLJrkvVXw6iHlI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4HGvtJyfQtN60K39U5Ql8DgAWWY.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"443205","ru":"The Red Maple Leaf","en":"The Red Maple Leaf","year":"2017","type":"Фильм","rating":4.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/A9j8RV2Qtz7BzAZ4oGFrvXMLEkM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sJPTOERrqolNE330ibDSLCw0KDz.jpg","genres":["детектив","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"445917","ru":"Great Great Great","en":"Great Great Great","year":"2017","type":"Фильм","rating":4.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/7zlCE6E2Q8xNCJ9h547v9RXIpN1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2QNEinBU4r68G9jeDBlOI1ia4zi.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"378331","ru":"Das Wetter in geschlossenen Räumen","en":"Das Wetter in geschlossenen Räumen","year":"2015","type":"Фильм","rating":4.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/p5Ye3MhRYwqQDUQ8LQWn9M2PUNF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3eaKaRemFsQPhVAwbU7jqeHEteP.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"390209","ru":"TRI","en":"TRI","year":"2016","type":"Фильм","rating":4.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/S67ndaWfHDRz5dNXSncTxgBlbn.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"277611","ru":"The Mentor","en":"The Mentor","year":"2014","type":"Фильм","rating":4.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/pwHskj1as4EJY7ZWXdnJl1W3xxG.jpg","backdrop":"","genres":["криминал","детектив","драма","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1381405","ru":"Большой фестиваль","en":"మాస్ జాతర","year":"2025","type":"Фильм","rating":4.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/qvSyQdI2Mlpa5X7dRDBmIi30oHT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9jiqrAgC9DoWKte8qc5gis0fWem.jpg","genres":["боевик","криминал","триллер"],"overview":"Один человек против целой системы. Лакшман Бхери (Рави Теджа) — железнодорожный полицейский, который вершит правосудие, не глядя на устав. За это его высылают на глухую станцию Адививарам, где царит закон джунглей. Здесь, среди холмов, жестокий Шивуду выстроил наркоимперию, купив лояльность всех наверху. Для местных он — король. Для полиции — неприкасаемый. Но для Лакшмана — цель. Без поддержки, против армии бандитов и продажных политиков, он начинает свою личную войну. Чтобы победить, ему придётся стать ураганом, который сметёт всё на своём пути.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"724450","ru":"Суперчеловек: тайное становится явным","en":"Superhuman: The Invisible Made Visible","year":"2020","type":"Фильм","rating":4.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/b505VZaLGXas8DMEP8ifL6jtrMc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/59U71nX09a82MOXUBpy0A5qHrBY.jpg","genres":["документальный","детектив"],"overview":"Фильм основан на фактах потрясающей деятельности людей с экстрасенсорными способностями, лежащими за пределами известных человеку законов физики. Продюсер и ведущая, Каролин Кори, сама обладает обширным опытом в области науки о бессознательном и экстрасенсорики. Она демонстрирует зрителям реальные и осязаемые доказательства существования данного чудесного феномена. В серии революционных научных экспериментов и показов зрители смогут составить полную картину о своем подсознании, установить связь между разумом и материальным, понять, живем ли мы в смоделированной матрице или можем сами управлять своими «физическими характеристиками» и создавать эмпирию. Фильм четко показывает, как невидимые миры становятся видимыми, а достигнувшая непостижимых высот самосознательность превратит людей в суперлюдей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1291434","ru":"Maliko","en":"Maliko","year":"2024","type":"Фильм","rating":4.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/o8TMVI2n79BPQPqKRkqZwqZoc0O.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bvT9cnrn7NHXzSQZIcddyrcpWdg.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"988311","ru":"Kärleksbevis","en":"Kärleksbevis","year":"2022","type":"Фильм","rating":4.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/l445VWScAf5DjpiVenFwfHwIvHG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1NCwY9VtlufGJtucQTqcug2Ln4a.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"768102","ru":"Vánoční příběh","en":"Vánoční příběh","year":"2022","type":"Фильм","rating":4.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/dJXY3hkaC5Yi8rEWhOogLAzUlzV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w8IDD5Eh7VL0uaoulkRa6KbqKiS.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1129293","ru":"اولاد حريم كريم","en":"اولاد حريم كريم","year":"2023","type":"Фильм","rating":4.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/1BbYw0r94sIN93hgSNzf7MUsVvu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/blG8GQNdLpZAMP1x63DneCq0gQB.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"714202","ru":"Tell Me I Love You","en":"Tell Me I Love You","year":"2020","type":"Фильм","rating":4.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/utG2S1WsZh5VOtpoB0Uq1a3n7Zu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hsOaibIRYKJyxUg7EV9wOC7sXgP.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRat