{"tab":"movies","page":703,"pages":900,"count":53963,"pageSize":60,"items":[{"id":"545816","ru":"Мясная лавка","en":"The Griddle House","year":"2018","type":"Фильм","rating":4.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/5PNH9wHEvI6YpNQfufKJbluufHd.jpg","genres":["драма"],"overview":"Подросток Джек Бенсон практически не видит свою маму дома - она постоянно куда-то уходит. Однажды, Джек обнаружит ее в мясной лавке. Все дело в том, что он решил проследить за собственной матерью, чтобы узнать все о ее скрытой жизни. И вот, в канун Нового года он узнал, где она пропадает. Теперь в его голове стоит только один вопрос: Что она тут делает? Она начинает пристально наблюдать за мамой. Джеку нужно вести себя предельно осторожно и действовать очень необычно. Но, именно такая \"игра в шпионов\" поможет ему немного стать взрослее и осмыслить некоторые жизненные истины.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"86461","ru":"Hanna D. - La ragazza del Vondel Park","en":"Hanna D. - La ragazza del Vondel Park","year":"1984","type":"Фильм","rating":4.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/r4UtpqTl5VKF8xQKzUjMBb5sDa2.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"640521","ru":"Prescience","en":"Prescience","year":"2019","type":"Фильм","rating":4.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/egAdHs6uIPfE9QpqmtFXRd3gwHg.jpg","genres":["мелодрама","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"548998","ru":"Furthest Witness","en":"Furthest Witness","year":"2018","type":"Фильм","rating":4.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/vuzUtfIJAvmWWBwJ3nMnJzneD50.jpg","genres":["криминал","драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id