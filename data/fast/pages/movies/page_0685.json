ма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"860306","ru":"Taya","en":"Taya","year":"2021","type":"Фильм","rating":4.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/zzjnLTaFGTsmksfo9r8yJ02s1yw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/90hz1RM3PDqLXs5ZPqAzM08lzOq.jpg","genres":["триллер","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1041896","ru":"Us X Her","en":"Us X Her","year":"2022","type":"Фильм","rating":4.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/23kUWRcMWrpb9huVE8R0ObHmSTp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oE5bdUB4QBTX2g1Q0eUygxkvghN.jpg","genres":["драма","мелодрама","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"669748","ru":"Крокодилий остров","en":"巨鳄岛","year":"2020","type":"Фильм","rating":4.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/uVKtTsjOS1WjSpTbTcfVrnmfzyj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nV7p8pJtpr5fpugqPwSIkEUoDiI.jpg","genres":["приключения","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"906270","ru":"La vaca que canto una cancion sobre el futuro","en":"La vaca que canto una cancion sobre el futuro","year":"2023","type":"Фильм","rating":4.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/6nXRJNpGs3sIgxtQhdJ94m9DjrZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dxtWWV1BdfWvXCwEuZ0j5ti2JN.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"371874","ru":"Цацики, папа и оливковая война","en":"Tsatsiki, farsan och olivkriget","year":"2015","type":"Фильм","rating":4.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/eqkhqdrP1HnOjKOPT5I6Y2vS7Ve.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wstwBM5vq3otuzgbdihUBwXJxIn.jpg","genres":["комедия","семейный"],"overview":"Цацики с нетерпением ждёт очередных летних каникул, чтобы снова поехать в Грецию, в гости к папе. Однако по приезде он узнаёт печальную новость — отель, которым владеет отец, пустует. В стране кризис, отразившийся на всех сферах жизни. Мальчик, которого мама научила никогда не сдаваться, решает проявить инициативу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"226074","ru":"Pleasure Spa","en":"Pleasure Spa","year":"2013","type":"Фильм","rating":4.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/ssYFXmu9LWtFOxfGaBDaLEKS8Cr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rS03B5c90n2vLkXaXVR4Fmuxh35.jpg","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"633545","ru":"The Missing Sister","en":"The Missing Sister","year":"2019","type":"Фильм","rating":4.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/w9RVDJgSPkeQAhUesQ8QH6ALNgZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2zfVF0ZkAgxey2rZ508Tq9Xn48U.jpg","genres":["телевизионный фильм","триллер","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"434129","ru":"Days of Power","en":"Days of Power","year":"2018","type":"Фильм","rating":4.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/shKWjmH8ZDQVnCwIU5exsqzfiBo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dS7JCOd3yC19ALccD53q9keWyoY.jpg","genres":["боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"262733","ru":"Дубровский","en":"Дубровский","year":"2014","type":"Фильм","rating":4.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/7FRGqT9klwi5fY0Vv9gxVIzPWcC.jpg","backdrop":"","genres":["драма"],"overview":"Владимир Дубровский — успешный столичный юрист и завсегдатай модных клубов, Маша Троекурова — выпускница английского колледжа и нежная дочь… Хозяева собственных судеб, они едва ли похожи на героев Пушкина. Но внезапная ссора их отцов решительно меняет жизнь Владимира и Маши – они погружаются в реальность, где действуют совсем другие законы…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1111491","ru":"Тёща в загуле","en":"Katie's Mom","year":"2023","type":"Фильм","rating":4.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/3FGKV2NtvvzGRbYDxazJeYFy5L5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rxG3qhUIpwnyW00gral3wf5sLkj.jpg","genres":["комедия","драма","мелодрама"],"overview":"Нэнси недавно развелась и пытается начать жизнь заново. На Рождество к ней приезжают взрослые дети — сын, дочь и новый бойфренд дочери. Последние остаются подольше — дочь с парнем попросились временно пожить у мамы. Неожиданно для себя Нэнси начинает испытывать чувства к бойфренду дочери, и они оказываются взаимными.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"920332","ru":"Белая ворона: Эпилог","en":"Insecure: The End","year":"2021","type":"Фильм","rating":4.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/h6p5ntDwl7Vb6lSDI7R5hlQ5Mxl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zsGrTbCugYMSENXTPzeZhOFWiB1.jpg","genres":["документальный"],"overview":"Документальный фильм, рассказывающий о создании сериала «Белая ворона». Мы увидим, как после пяти успешных сезонов съемочная группа вспоминает самые ударные моменты и размышляет о вкладе проекта в поп-культуру. «Белая ворона: Эпилог» покажет, какой большой путь создательница шоу Исса Рэй прошла — от скромного веб-сериала до многочисленных наград. В фильме появится основной каст и шоураннер проекта Прентис Пенни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"760871","ru":"Полубог","en":"Demigod","year":"2021","type":"Фильм","rating":4.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/xTUhRLblPHTJmyFEiqHWUuY4Wcg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1X46oSUSqvmAeFmQnopwhPnb7oE.jpg","genres":["ужасы","детектив","драма"],"overview":"Робин и её муж Лео отправились в Шварцвальд, чтобы разобраться с наследством, оставленным её дедом-охотником. Вскоре после прибытия в уединенную хижину усопшего главная героиня понимает, что наследство это гораздо более жуткое, чем она рассчитывала. Робин оказывается вовлечена в пугающий охотничий ритуал, который вынудит женщину считаться с прошлым её семьи и приложить чудовищные усилия для преодоления препятствий на собственном пути.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1440641","ru":"The Jolly Monkey","en":"The Jolly Monkey","year":"2025","type":"Фильм","rating":4.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/1QVc7y4t9h8aHX51Hu2xb2XdjHu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vmCuylFEhOvNMogIsW2iEoN0BfC.jpg","genres":["ужасы","триллер","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"569970","ru":"Хранители душ","en":"Body Keepers","year":"2018","type":"Фильм","rating":4.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/exBTkhiGAgsjNtKJTp8r5GPZXEv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/siw0SucjcvqGyEPLZR4KSGKKdev.jpg","genres":["триллер"],"overview":"В Недерленде, штат Колорадо, продолжают пропадать дети. Однажды, группа подростков решает взломать сарай, чтобы украсть детали для своего проекта. Там они обнаруживают замороженное тело. Пробудив адскую сущность они узнают, что на самом деле значит \"холод, как в аду\"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"268729","ru":"10 правил как соблазнить девушку","en":"10 pravidel jak sbalit holku","year":"2014","type":"Фильм","rating":4.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/kPtjUYuln0jK49Xd330IeKQMNTm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6a6y59ADAG0GONdERjvhYuPkq5n.jpg","genres":["комедия"],"overview":"Герой фильма Марек влюбляется в потрясающей красоты девушку. Но как завоевать ее сердце, ведь он обычный студент, обожающий гороскопы. Друзья решают помочь ему, обратившись за помощью к его отцу, написавшему бестселлер \"Как покорить девушку\".","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"447759","ru":"청불학원","en":"청불학원","year":"2017","type":"Фильм","rating":4.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/5XR1lyewXl4U4VoVTi4Mgn0bmiF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1rheal7SqXaBAVySQlVPJ2vmaRy.jpg","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"502805","ru":"Ladyworld","en":"Ladyworld","year":"2019","type":"Фильм","rating":4.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/zSnPyXrayan8JlPFJin2VBeGdBp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/osc9hWKeXwr2xfrWCto8dUwBGLf.jpg","genres":["триллер","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"550059","ru":"三十儿立","en":"三十儿立","year":"2017","type":"Фильм","rating":4.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/zlMytIUN2DR8OC6i4xrPrEDC0km.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oXvF3ZIk7puZrvEX4BJlrNtYiuR.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}