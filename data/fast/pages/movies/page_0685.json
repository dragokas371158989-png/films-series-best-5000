{"tab":"movies","page":685,"pages":899,"count":53936,"pageSize":60,"items":[{"id":"752961","ru":"அண்ணாத்த","en":"அண்ணாத்த","year":"2021","type":"Фильм","rating":4.7,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/1T5BAF0RsrQfQik5WtXA30gJlk7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wKMprNDrGTVKTNWTvRZ0MSt59up.jpg","genres":["боевик","семейный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"687262","ru":"Cold Meridian","en":"Cold Meridian","year":"2020","type":"Фильм","rating":4.7,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/uyHgDkeq0X3itadbsrYzVkMSADL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8rHIOVraeiOHj1TTqFspkbdYyRc.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"572851","ru":"Уилл Гарднер","en":"SGT. Will Gardner","year":"2019","type":"Фильм","rating":4.7,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/3OSAh3Tw1FHzK8Pc6DUAUqSOerC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2IOUgBLgcnEhPKcu3cO5lLHXXj8.jpg","genres":["военный","боевик","приключения","драма"],"overview":"Фильм рассказывает историю ветерана Иракской войны Уилла Гарднера, который получил черепно-мозговую травму в бою и после возвращения на родину столкнулся с серьезными трудностями при адаптации к гражданской жизни, вызванными посттравматическим стрессовым расстройством. После серии жизненных неудач он угоняет мотоцикл своего работодателя, не желающего выплачивать ему честно заработанные деньги, и отправляется в спонтанное путешествие по стране, надеясь воссоединиться с маленьким сыном, которого не видел уже очень давно.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"294222","ru":"Mantervention","en":"Mantervention","year":"2014","type":"Фильм","rating":4.7,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/oNGtC9TFOidg1bIbxgp3DEZGXYb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/v9rCZr7Vg9PIGAF71E2MQe3rU9o