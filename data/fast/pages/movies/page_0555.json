episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"357183","ru":"Danny & the Human Zoo","en":"Danny & the Human Zoo","year":"2015","type":"Фильм","rating":6.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/x3fExFnjmsl7Q55qi4yKqKrbHJr.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1240224","ru":"Серые люди","en":"黑白潜行","year":"2024","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/bHumYPRu9VodkUXSj8CL7rU5qf9.jpg","genres":["драма","криминал"],"overview":"Гонконгский полицейский Шань внедряется в тюрьму, чтобы завоевать доверие преступника Тяня и собрать доказательства против его банды. После освобождения Шань помогает Тяню подняться в преступной иерархии и стать новым боссом. Но когда Шань успешно разоблачает банду, он раскрывает шокирующую тайну Тяня.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1359005","ru":"Через тернии к звёздам","en":"星河入梦","year":"2026","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dKT6A7yQWxvRhZwX5uudHofvpja.jpg","genres":["драма","фантастика","приключения"],"overview":"В будущем межзвёздные полёты стали обыденностью. На время долгого путешествия экипаж погружают в анабиоз, а чтобы нейроны мозга не деградировали, людей подключают к инновационной системе виртуальных сновидений. На космическом корабле, направляющемся к далёкой планете с колонизаторской миссией, для выполнения плановой проверки выходит из анабиоза техник Сюй Тяньбяо и становится свидетелем аварии и глобального сбоя. Пока система не сделала идиотами весь экипаж, ему нужно разбудить капитана, но сделать это можно только проникнув в её сон.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"543761","ru":"Сложность","en":"コンプリシティ","year":"2020","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/hpSpOel4h9P6xMArv0CJLROXPK.jpg","genres":["драма"],"overview":"Молодой парень из Китая нелегально переезжает в Японию, чтобы улучшить уровень жизни и заработать деньги. Он покупает фальшивые документы и с радостью принимает предложение о работе за другого человека. Но новое место окажется не таким простым, как ему казалось на первый взгляд.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1628522","ru":"Чай на двоих","en":"Two for Tee","year":"2026","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/bEHc7cpqNAG6HhD24hHB1qltcy5.jpg","genres":["мелодрама","драма"],"overview":"Ти - художница и американка китайского происхождения, которая занимается гончарным искусством и через творчество всё глубже открывает для себя традиции собственной семьи. В общественном центре она знакомится с разнорабочим Уиллом, и эта встреча постепенно меняет их обоих. Пока Ти ищет связь с корнями и пытается понять себя через искусство, им вместе с Уиллом приходится бороться за судьбу центра, которому грозит закрытие. Но смогут ли они сохранить это место, пока оно не исчезло вместе со всем, что для них стало важным?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"847738","ru":"Быстрая месть","en":"Fast Vengeance","year":"2021","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/kUD1X41bSlwr11do45t4EHWPpOd.jpg","genres":["боевик","криминал"],"overview":"Услышав о смерти брата, мужчина возвращается на родину, чтобы найти виновных и взять правосудие в свои руки.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1034809","ru":"Древо жизни: Нападение на синагогу в Питтсбурге","en":"A Tree of Life: The Pittsburgh Synagogue Shooting","year":"2022","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/xpapeayfKZKoUvZTAzBJpswTUA4.jpg","genres":["документальный"],"overview":"История о трагическом инциденте, ставшим одним из самых крупных антисемитских нападений в истории Америки. 27 октября 2018 года был открыт огонь в синагоге Питтсбурга. Одиннадцать человек погибло во время молитвы. Фильм основан на воспоминаниях оставшихся в живых, родственников погибших, а также местных жителей.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1610840","ru":"Godari Gattupaina","en":"Godari Gattupaina","year":"2026","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/jVENga0uWeOM3vc7KtLhieBwNRy.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1608620","ru":"Romance at Hope Ranch","en":"Romance at Hope Ranch","year":"2026","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/arwU50Da8nL7xgPQHAwZjV4aQMo.jpg","genres":["мелодрама","телевизионный фильм","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"941045","ru":"화사한 그녀","en":"화사한 그녀","year":"2023","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/zWfExgXQ99355LCMFFdqwmQdD9A.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"865428","ru":"മകൾ","en":"മകൾ","year":"2022","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/uGeJE6AjzDhVDRpi3RYiPFHAa1o.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1084013","ru":"Carry On Jatta 3","en":"Carry On Jatta 3","year":"2023","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/pJqAHS4a1GrtqreALTPG5cqqLKf.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbI