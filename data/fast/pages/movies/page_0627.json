342/mjbK8vWNSvF9uAvDA6NJM1TOhzF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tsZGJtYrHy5290cRt7Rqxy7k1sN.jpg","genres":["Комедия","Драма"],"overview":"Мужчина делает все возможное, чтобы сохранить право собственности на приморский коттедж, который он построил вместе со своей покойной женой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"744935","ru":"Рождество на винодельне","en":"Christmas on the Vine","year":"2020","type":"Фильм","rating":5.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/bYqHaFOvO8MVx1BrPHJYfxCFOjK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1qU8KnxrYXCIp2ZL9zk2f39VTOk.jpg","genres":["Телевизионный фильм","Мелодрама"],"overview":"Молодой менеджер по маркетингу получает задание помочь разоряющейся семейной винодельне в городе, который лишился рождественского духа из-за крупного предприятия по производству вина.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"828901","ru":"Хостел любви","en":"Love Hostel","year":"2022","type":"Фильм","rating":5.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/gjp2tU35OCLErpIG5pKqgBc9Ch7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qwCUf2jbmrK7BbWprlfLvkzd0XM.jpg","genres":["Криминал","Мелодрама","Триллер"],"overview":"Фильм о путешествии молодой пары, за которой охотится безжалостный наёмник.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"720851","ru":"哈囉少女","en":"哈囉少女","year":"2020","type":"Фильм","rating":5.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/8bD19R4n7Vjdc3uT0OWiJwpuLgV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3KOr3usI0r2qIjRMeDfB3b01SC.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"749552","ru":"Ruthless Renegade","en":"Ruthless Renegade","year":"2020","type":"Фильм","rating":5.5,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/tJomo6gVGaYYDuFUzDDMZlpnNNs.jpg","backdrop":"https://image.tmdb.org/t