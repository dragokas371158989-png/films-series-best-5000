0/ljW26r8uuJs8zvdjFW3mnKmSN51.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"367198","ru":"Под прикрытием: Удар и пистолет","en":"潛龍狙擊","year":"2019","type":"Фильм","rating":6.1,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/8lGFVecQmk8XYuL1McuU5EDwsNY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zoYRdsobR1etsW6h1IZY9Hdl8J6.jpg","genres":["боевик","триллер"],"overview":"Кин У (Филлип Нг) - полицейский под прикрытием. Уже несколько лет он правая рука одного из боссов наркосиндиката, да к тому же его будущий зять. Во время очередной сделки босс погибает и У занимает его место. Осталось совсем немного и тут появляется новый враг. Бывший спецназовец вознамерился стать королем наркобизнеса. Он собирается делать наркотики на грузовом судне в открытом море. Кин У должен остановить его любой ценой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"379297","ru":"Toni Braxton: Unbreak My Heart","en":"Toni Braxton: Unbreak My Heart","year":"2016","type":"Фильм","rating":6.1,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/8ksJ3E5TmnUXqakHfk0bzVfnI61.jpg","backdrop":"https://image.tmdb.org/t/p/w780/czRIOl62QnoOx7nxb0POTnb8Iqz.jpg","genres":["драма","музыка","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"324307","ru":"Sneakerheadz","en":"Sneakerheadz","year":"2015","type":"Фильм","rating":6.1,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/4SCr5MhGnkBg7r9WotdnuJogc3L.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zvZQQ5PVlKJYQ3y0UTUY4Kbu50c.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"592545","ru":"അതിരൻ","en":"അതിരൻ","year":"2019","type":"Фильм","rating":6.1,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/iZmBBDoDrd49dg8RMvIdJy5q7k1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rpZ8LerM7LBeg69b2ijQiirNqqf.jpg","genres":["мелодрама","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"866669","ru":"Махнёмся местами. Рождество в Солт-Лейк","en":"Sister Swap: Christmas in the City","year":"2021","type":"Фильм","rating":6.1,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/xIxSuBvx8tApounB5etdD5JGQvw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k1Z9MtEJObB4q4dzkXCLP554CnT.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"Дженнифер живёт в Солт-Лейк-Сити и управляет успешным рестораном, который она открыла вместе со своим покойным мужем, а так же она воспитывает сына, подростка Саймона. Мэг осталась жить в родном городке Хейзелвуд, помогая родителям управлять пекарней. Дженифер и Мэг сёстры, которые на это Рождество встретятся и провернут удивительную авантюру...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"874226","ru":"Рождество в Тахо","en":"Christmas in Tahoe","year":"2021","type":"Фильм","rating":6.1,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/oTqpT4yqo2uXr7CSYDWHTiIOe6c.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6cNeUaoNNFsNhtHiUpxfVp5tDZS.jpg","genres":["телевизионный фильм","мелодрама","драма","комедия"],"overview":"Клэр Роудс - молодая амбициозная девушка, которая работает в отеле своего отца. Ее главная мечта: покорить Лас-Вегас, став управляющей одного из самых престижных центров развлечений. Но отцу не нравится решение дочери, поэтому он всеми способами пытается удержать ее. Мужчина постоянно хвалит Клэр, акцентируя внимание на том, что без ее помощи семейный бизнес уже давно бы рухнул. Но однажды у девушки появляется прекрасная возможность осуществить свою мечту. Отправившись навстречу к ней, она и подумать не могла, что ей предстоит работать со своим бывшим парнем...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1415974","ru":"Raat Akeli Hai - The Bansal Murders","en":"रात अकेली है - द बंसल मर्डर्स","year":"2025","type":"Фильм","rating":6.1,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/nBhae2KNhk0R6cvVppoCo389gs6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tql3kTLmF2FFeSVIlafFJiZfcfk.jpg","genres":["триллер","детектив","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"592782","ru":"Poissonsexe","en":"Poissonsexe","year":"2020","type":"Фильм","rating":6.1,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/Y19yeHiAKBINqvm1DheUSrMr0Y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8VvoY62mm2TicNvjarlRPnYpMEf.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"402648","ru":"Прощай, одинокая жизнь","en":"굿바이 싱글","year":"2016","type":"Фильм","rating":6.1,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/sIXM127k6yGyzlm4rrEw4vvicZQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hifeQonN8v91dk7ZHgUnk0Y28sB.jpg","genres":["драма","комедия"],"overview":"У популярной актрисы Ко Джу-ён в жизни всё идеально, кроме одного - нет семьи. Чтобы исправить эту досадную оплошность, она разрабатывает оригинальный план.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302431","ru":"Rang Rasiya","en":"Rang Rasiya","year":"2014","type":"Фильм","rating":6.1,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/fz6d1MFMn2qkkjNQUtFxq7HJsqk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1yD7scPEKxKugzgn8Ydcua2odza.jpg","genres":["драма","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"683722","ru":"Аалто","en":"Aalto","year":"2020","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/j1htntItu5WlSTk2pyoH6MlUX5r.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q7WibUOOmmQReG6zDTuldah8cWs.jpg","genres":["документальный"],"overview":"Дизайн для скандинавов священен: в Национальном музее Швеции на втором этаже выставлен Рембрандт, а на первом — выдающиеся предметы домашней утвари. Тот же сакральный трепет раскрашивает этот фильм. Камера с высоты птичьего полёта восхищённо рассматривает построенные Алваром Аалто виллы и библиотеки, в замедленной съёмке со всех сторон любуется его культовыми стульями.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"876103","ru":"Рождество вместе с тобой","en":"A Christmas Together With You","year":"2021","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/bDlKgyTZtd5T7sZidwndSxUAjgY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s64fCVdgjiTM2Bu5nJKbRk0tMSt.jpg","genres":["телевизионный фильм","мелодрама","драма"],"overview":"Во время рождественского сезона Меган и ее отец Фрэнк отправляются в путешествие, чтобы найти свою давно потерянную любовь. Найдет ли Меган любовь всей своей жизни на этом пути?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"795104","ru":"రంగ్ దే","en":"రంగ్ దే","year":"2021","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/q1USrpUYiRkAj8ArEG5jUUXCCEo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zKTrqpxGUfEYHWlCEOKhKyMRyzd.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1295415","ru":"变体","en":"变体","year":"2024","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/dil7ytWMsH5P1KZqYlXq3FN6Qur.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hPaZByAT7gXRaJ6YU3NAX13DLdO.jpg","genres":["фантастика","мелодрама","военный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1081920","ru":"Royal Rendezvous","en":"Royal Rendezvous","year":"2023","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/93f71drYfVjZvqP0EsGVMRvF5Ab.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pSc7ywZogaLIyAmaavlOhLPkAGE.jpg","genres":["мелодрама","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"371241","ru":"Театр призраков","en":"劇場霊","year":"2015","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/wlFnjImZTPwe1rqcS4CI4tFC1kL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pBhuSlkr1hTuzRlVfvLT1zz88DQ.jpg","genres":["ужасы"],"overview":"Говорят, что у кукол, сделанных настоящими мастерами своего дела, тоже есть душа. Такая кукла впитывает в себя эмоции своего создателя и бывших хозяев, но иногда она может стать настоящим проклятием. Сара — молодая амбициозная актриса, но все, что ей предлагают — лишь небольшие роли в эпизодах телевизионных сериалов. Чтобы как-то заявить о себе она решает принять участие в крупной театральной постановке. Она еще не знает, что этот проект может стать для нее последним, ведь одна из главных ролей в спектакле отведена кукле со страшной и кровавой историей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"257441","ru":"Рождество в Роузмонте","en":"Rosemont","year":"2015","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/3RQN5wj0hErqWknYhAbHMxpZBVJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/92j2iwzDEdPHH6SK2JRxqWvPApJ.jpg","genres":["драма","телевизионный фильм"],"overview":"В снежную бурю за пять дней до Рождества двое молодых людей встречаются случайно: девушка 23 лет, беременная и напуганная, и Брэд, профессионал по сноуборду. Оба хотят добраться до гор до шторма, Брэд, чтобы посетить вечеринку, объявляющую о его помолвке, девушке же, потому что она отчаянно пытается куда-то добраться, скрывая таинственные обстоятельства, от которых она бежит. У них это не получается. Метель застигает их: машина Брэда врезается в снежный сугроб посреди пустыни. Они вынуждены укрыться в единственном на всю округу домике с неприветливой хозяйкой. Кажется, их встречу запланировала сама судьба…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"575236","ru":"Хулиган. Трус. Жертва: История Роя Кона","en":"Bully. Coward. Victim. The Story of Roy Cohn","year":"2019","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/2jeIBj5ifUVIvmSNTPKoe4WsHD4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cTv2E1UfQYzvrlzxr7t9AUzEmrg.jpg","genres":["документальный"],"overview":"Документальный фильм о жизни и карьере печально известного адвоката Роя Кона. Рой посвятил свою жизнь охоте на коммунистов и представителей ЛГБТ-сообщества: прежде всего он стремился «очистить от них руководящие посты». Позже стало известно о его гомосексуальности. Фильм попытается показать трагические парадоксы судьбы Кона и раскрыть мотивы его поведения.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"432560","ru":"Ян Масарик","en":"Masaryk","year":"2017","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/bwbVeEi0i3BL8UyETfyLYSck1aa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5GxeioqYZd6y3Mex0cQzw8tiQk0.jpg","genres":["драма","история"],"overview":"Фильм о нескольких годах жизни чехословацкого государственного деятеля, Яна Масарика. События охватывают период с 1937 по 1939 годы, когда было оформлено и подписано Мюнхенское соглашение, по которому часть Чехословакии перешла во владения Германии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"343426","ru":"Контракт на убийство","en":"Tell Tale Lies","year":"2015","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/nbjycFUbckqCriSiqhnbU0kKbb8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ltYC5BqO6eUcMrN9sS3wSsNOo0t.jpg","genres":["триллер","телевизионный фильм"],"overview":"Сюжет строится вокруг четырех студентов престижного университета, чье блестящее будущее может не состояться из-за того, что они вдруг оказываются связаны со случайным убийством однокурсницы. Когда одна из студенток заявляет, что знает об их причастности, они начинают строить план ее убийства.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"330385","ru":"Несмотря на ночь","en":"Malgré la nuit","year":"2016","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/26W1KfyVPwiiMFpgpdxKOdoabjD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cYrIeUbyPDdKPc10qH8RKXD3Jag.jpg","genres":["мелодрама","драма","детектив","ужасы"],"overview":"Музыкант Ленц покидает Англию и отправляется на поиски своей возлюбленной Мадлен, исчезнувшей в Париже при таинственных обстоятельствах. Встреча с медсестрой Элен, оплакивающей смерть сына, и компанией, снимающей снафф-муви, становится для Ленца началом болезненных отношений, полных скорби, страсти, ревности, саморазрушения… и освобождения.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"430642","ru":"Beaches","en":"Beaches","year":"2017","type":"Фильм","rating":6.1,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/ouwWLCvdMSTkz7khmyqDDYfjT1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zehUyDv5sD1FNGjbR3JO8h8m96i.jpg","genres":["драма","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}