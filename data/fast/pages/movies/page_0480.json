{"tab":"movies","page":480,"pages":899,"count":53936,"pageSize":60,"items":[{"id":"1114072","ru":"Франкенштейн: Воскрешение","en":"Frankenstein: Legacy","year":"2025","type":"Фильм","rating":7.4,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/cnqyaHpZ7CpgKBlmBgbgqyKicJX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jzhQGjzfsrxPwIkSZPMTpfhh27h.jpg","genres":["ужасы","триллер","драма"],"overview":"Англия, 1875 год. Спустя столетие после злополучного эксперимента Виктора Франкенштейна его дневники десятилетиями переходили из рук в руки. Но секреты Франкенштейна не умерли вместе с ним. Пока разваливаются могилы и исчезают пациенты из приюта, Уильям Браунинг отправляется на поиски того, кто похитил тело его отца, и обнаруживает ужасы возле дома, в котором находится его безумная мать.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1089953","ru":"这么多年","en":"这么多年","year":"2023","type":"Фильм","rating":7.4,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/vcoCNx1eRimtz8DZJMv71fuqBVk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yqqRuj41NSQMRkQAURNqazSzusi.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"657521","ru":"I Am Patrick: The Patron Saint of Ireland","en":"I Am Patrick: The Patron Saint of Ireland","year":"2020","type":"Фильм","rating":7.4,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/n9D2Aq0G4rPKSjKJ2k0Pq69CAW9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hCZo34AqV9Oji1cQmwbKO69Z9vj.jpg","genres":["документальный","драма","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1001376","ru":"Les reines du drame","en":"Les reines du drame","year":"2024","type":"Фильм","rating":7.4,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/gZtBtBJPpGSeFVXF0S2Kt388rE1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/15eSItHC98hBs0NyRoyLfuv7PNp.jpg","genres":["музыка","мелодрама","драма","комед