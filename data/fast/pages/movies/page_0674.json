е \"Американцы\" и фильме \"Восемь подруг Оушена\"), для нее \"Ома\" - в том числе экранизация личного опыта: \"Когда я была ребёнком, бабушка с дедушкой не рассказывали, как выжили в Холокост. Дед пытался открыться, но я меняла тему. Я не знала, каким очищающим мог быть этот разговор. Сейчас, повзрослев, я разговариваю со своей 94-летней бабушкой, и я столькому у неё научилась\".","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"307751","ru":"బ్రదర్ అఫ్ బొమ్మలి","en":"బ్రదర్ అఫ్ బొమ్మలి","year":"2014","type":"Фильм","rating":5.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/mQl6gW80AbcJDRQHjE23Lo6BdtZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1g9IYHwVbs8U3uP1W2fQGKouCaJ.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"285930","ru":"గాలిపటం","en":"గాలిపటం","year":"2014","type":"Фильм","rating":5.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qhdo7bUgkPzaU7v6HSKpNPRgzUX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zg9Pk6NNpSanymihO8Dai5CvXBj.jpg","genres":["драма","мелодрама","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"566605","ru":"Le cri du rhinocéros","en":"Le cri du rhinocéros","year":"2018","type":"Фильм","rating":5.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/i0J78FgW0RFbBeWIXhd2iY16Vro.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8QS4pdlSnJAu7WgOf0Aer49zapO.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"804658","ru":"Dead Man Rising","en":"Dead Man Rising","year":"2017","type":"Фильм","rating":5.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9ehPnMgpCvBu7rDr8Pn1Kfiq2pl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qE4W7jVaO9QtPbgn9vlKcwLckrU.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"491671","ru":"ماحی","en":"ماحی","yea