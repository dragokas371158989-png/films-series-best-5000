oster":"https://image.tmdb.org/t/p/w342/3sdZjxrk0KUCicK125x3JD49MG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zlRP379lcMxpPrh86APpFCz6Zon.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1553116","ru":"Deep Ocean: Kingdom of the Coelacanth","en":"Deep Ocean: Kingdom of the Coelacanth","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/qOkGlK5gsNIQ3Np8uJaUKrISwpu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mplsYBqMB5o8BlznjGLRbV5UuVH.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1415489","ru":"SO36","en":"SO36","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/8rch49M5PMesrC6eySYbJXfnjfF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zwvL7glaV5DPnmdRmoAFVg3CYCq.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1471533","ru":"Руслан и Людмила. Волшебное путешествие","en":"Руслан и Людмила. Волшебное путешествие","year":"2027","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/zQbOTYnt5mVnU7tJb4ZuhwSKZsg.jpg","backdrop":"","genres":["фэнтези"],"overview":"Молодой витязь Руслан встает на защиту Людмилы и портит планы ее отца, князя Владимира, выдать дочь замуж за одного из достойных молодцев – Рагдая, Ратмира или Фарлафа. Людмила влюбляется в Руслана, он тоже очарован красавицей, но их счастью не бывать: Владимир против, а потом Людмилу и вовсе похищает завистливый колдун Черномор, жаждущий отомстить князю за былые обиды. Теперь Руслану и трем витязям-соперникам предстоит преодолеть нелегкий путь до замка колдуна, раздобыть меч-кладенец, который охраняет голова богатыря Святогора, и бросить вызов коварному Черномору, чтобы освободить красавицу Людмилу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1570733","ru":"Vampyr","en":"Vampyr","year":"2027","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/u0rmkQr32u1UkC8GdluAqnVd1de.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2U0LDQBI6r8YwI02Q4n9qU1TOcc.jpg","genres":["триллер","ужасы","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1689833","ru":"Cop This","en":"Cop This","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/pSLIWEycNrWKJWM5KMsB46HXRYA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4kQTGnv7XT6C9KISEQgqlPgLfhD.jpg","genres":["комедия","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1623608","ru":"Ceniza en la Boca","en":"Ceniza en la Boca","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/utQMSJZL1zUfMY1iFBtuAbaepby.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2Yvdd2aAk0WNWrhW93Qbrsu326l.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1528835","ru":"Царевна Несмеяна","en":"Царевна Несмеяна","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/7kzN4iccu0yOMWHTsgiaAYjvb6f.jpg","backdrop":"","genres":["семейный","приключения","фэнтези"],"overview":"Прагматичный Ерёме накануне повышения на работе случайно попадает в волшебное Тридевятое царство вместе с младшей сестрой. Чтобы вернуться домой, ему нужно рассмешить хмурую Царевну Несмеяну. Но сделать это будет непросто, ведь на самом деле девушка лишь притворяется — она мечтает о настоящей любви. Ерёма завоевывает доверие Царства и сердце Царевны, но, добившись цели, признается в обмане и возвращается в реальный мир. В награду он получает все, о чем только мечтал, но ощущает, что потерял главное. Тем временем Несмеяну похищает Водяной, а сказочный мир погружается в уныние. Ерема решает вернуться в Тридевятое царство и спасти Несмеяну, не зная, удастся ли ему снова пройти путь героя, только уже не ради награды, а ради любви.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1670061","ru":"藁にもすがる獣たち","en":"藁にもすがる獣たち","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/n5gXSMpvetQzC2wAYUc4Hl0VCge.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fMrUAdZkpcVopuO6FbVcSLPXenW.jpg","genres":["детектив","драма","боевик","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1352071","ru":"More Beautiful Than Death","en":"More Beautiful Than Death","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/7vpfGcCeDhYkmHwwvxIQPZNChrR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/DuEdS0vQFlerGteGHOq2tw5fEP.jpg","genres":["драма","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1694317","ru":"One Guy, Too Many Dates","en":"One Guy, Too Many Dates","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/nlW6tYCNCipF2l0XDVc4kZVAcd6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qZKRSFEXkBHxYqoeLpG0YE93aHI.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1634140","ru":"Mala bèstia","en":"Mala bèstia","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/4NjHPW0ZttQTkrJZrmFRISq2d5V.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3KeGNPiNDJ5fHSC43hais8LAtio.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1307903","ru":"Pequenas Criaturas","en":"Pequenas Criaturas","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/lcY3sM8JE81CTcNygZ51vl3dRzh.jpg","backdrop":"https://image.tmdb.org/t/p/w7