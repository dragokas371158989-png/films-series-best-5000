2/jd8XfaeY0mSDzEnUNPKgeBV4Tcq.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"560577","ru":"Клоунский торнадо","en":"Clownado","year":"2023","type":"Фильм","rating":1.9,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/aYrvdvqnCDJnUCrof0dA4cKspyd.jpg","genres":["ужасы","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"370417","ru":"Генитальные воины","en":"Die Geschlechtskriegerinnen","year":"2015","type":"Фильм","rating":1.9,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ufxCGIrY6LXj4feRQBxpWTHbHxH.jpg","genres":["комедия"],"overview":"70-летний мужчина по имени Франк сидит в сумасшедшем доме. Чтобы заполучить назад одну из двух своих подруг 40-летней давности – Лену или Барбару – он снял для них фильм. Обнаружив, что Франк ведет двойную игру, пожилые дамы клянутся ему отомстить. Вооружившись волшебной палочкой и дробовиком, они отправляются в прошлое.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"780268","ru":"Сверххищники: Челюсти Лос-Анджелеса","en":"Apex Predators","year":"2021","type":"Фильм","rating":1.8,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/mLOJB8OvFdA3iUkcvcntprj49Qh.jpg","genres":["ужасы"],"overview":"Море вдруг начало выбрасывать на пляж тела отдыхающих в то время, когда шло торжественное открытие нового курорта, что привело к плачевным результатам.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"837542","ru":"Комната №9","en":"Room 9","year":"2021","type":"Фильм","rating":1.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/wwoPy8Iin3u49Gu5aUJULua3cwK.jpg","genres":["ужасы"],"overview":"Сорок лет назад в небольшом американском городке произошло жестокое двойное убийство. Спустя десятилетия город вновь потрясла серия жутких ритуальных убийств. В это же время в город приезжает молодой парень, получивший в наследство дом дальних родственников. Сразу же он начинает начинает страдать от странных воспоминаний, связанных с этим городом и осознает, что он имеет отношение к трагическим событиям прошлого, но не понимает, какова его роль в текущих событиях: жертвы или убийцы?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"347788","ru":"A Wife's Secret","en":"A Wife's Secret","year":"2014","type":"Фильм","rating":1.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/k4xCnSvmke5ukTQ42GUz5I31gIb.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1371522","ru":"盐湖计划","en":"盐湖计划","year":"2024","type":"Фильм","rating":1.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/4gXHVyhHMeaIQclNsupd2dQSbwj.jpg","genres":["комедия","криминал","приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"904116","ru":"Amityville Karen","en":"Amityville Karen","year":"2022","type":"Фильм","rating":1.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/iaRAnKpyo95dgDEJMGejWnYO5hA.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"743679","ru":"Valerie","en":"Valerie","year":"2019","type":"Фильм","rating":1.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/40EC3bR4UTJfm58438TApmPVh8i.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"452403","ru":"হরিপদ ব্যান্ডওয়ালা","en":"হরিপদ ব্যান্ডওয়ালা","year":"2016","type":"Фильм","rating":1.8,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/12HPDM7lAfyrs4wAj6fu63Ue3q5.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"273876","ru":"ஐந்தாம் தலைமுறை சித்தவைத்திய சிகாமணி","en":"ஐந்தாம் தலைமுறை சித்தவைத்திய சிகாமணி","year":"2014","type":"Фильм","rating":1.8,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/j9dLDwmG83K1