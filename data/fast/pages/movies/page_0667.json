g/t/p/w342/6oKd1MkgDqabYA8XngrCD0NfW6C.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1049514","ru":"얼룩","en":"얼룩","year":"2022","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/jeGyZvuRcplZEk7eIQvtVVuCJxJ.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"515599","ru":"Ню","en":"Ню","year":"2018","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/huq6Mw2pZiqqKb1DTBzO1XySYHE.jpg","genres":["драма"],"overview":"Китайская девушка ищет в Москве свою любовь, идеал, мечту... Ладно, на самом деле, она всего лишь ищет с кем бы ей переспать. Но почему-то у нее ничего не получается: ни с лучшим другом, ни с девушкой, ни с незнакомцем из интернета. Может, причина в ней самой? Русский не ее родной язык - может быть ее неправильно понимают? К кому она обращается в каждом выпуске своего видеоблога? Что нарисовано на картине, которую она ото всех прячет? Что означает иероглиф 牛?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1061818","ru":"'Tis the Season: The Holidays on Screen","en":"'Tis the Season: The Holidays on Screen","year":"2022","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ie5zpIgWKKKAU24flhdO3FjrUVD.jpg","genres":["документальный","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1320149","ru":"Детектив со школьного двора","en":"校园神探","year":"2024","type":"Фильм","rating":5.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/kOlspLNPHwtyvmHWBlBvfHanMVp.jpg","genres":["детектив","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1016013","ru":"음란캠핑장 장박녀들","en":"음란캠