.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/iXM5WzUcYreTK9aXiOcGtrMgnBP.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"402967","ru":"Koko: The Gorilla Who Talks to People","en":"Koko: The Gorilla Who Talks to People","year":"2016","type":"Фильм","rating":7.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/ltZNA9hf1Aj7aStQovtSShyHRDS.jpg","backdrop":"","genres":["Документальный","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"931219","ru":"Чёрная дыра","en":"Must auk","year":"2025","type":"Фильм","rating":7.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/iu12NWWiYXKTgyMfaSbA5U6BZPS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bQrNCrUDqT7ovJYthThc4QOL29F.jpg","genres":["Комедия","Драма","Фантастика"],"overview":"В недалёком будущем космический корабль терпит бедствие, в результате чего совершает вынужденную посадку на отдалённой планете. Но в результате такой посадки погибает командир корабля, часть команды и большинство пассажиров. Оставшиеся в живых оказываются одни на жуткой и безжизненной планете. Первое, что бросается в глаза — это то, что планета имеет три солнца, из-за чего всё живое погибает в этой пустыне. Но как только планета погружается в темноту, появляются какие-то странные существа…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1399515","ru":"奇遇","en":"奇遇","year":"2025","type":"Фильм","rating":7.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/jbwStPL6OrIAU8EFydmgZeykBdo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9CvkkSqukN8QymWaudrpSArrwLL.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1041721","ru":"忍風戦隊ハリケンジャーでござる！シュシュッと20th Anniversary","en":"忍風戦隊ハリケンジャーでござる！シュシュッと20th Anniversary","year":"2023","type":"Фильм","rating":7.6,"votes":9,"poster":"https://ima