ar":"2014","type":"Фильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/uBlsOAY2JNWRYbZXiycwsVtCAGo.jpg","genres":["документальный"],"overview":"Оксана Шачко - женщина, активистка и художница. Когда она была подростком, ее увлечение религиозной живописью заставило ее серьезно задуматься над тем, чтобы уйти в монастырь, но в конце концов она использовала свой талант для создания и распространения движения FEMEN. Между горячим рвением творить и глубоким желанием изменить мир, она стала соучредителем знаменитой группы активисток, путь которых увел их с Украины в далекие уголки Европы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"107827","ru":"紅樓春夢","en":"紅樓春夢","year":"1977","type":"Фильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/nKZz3U3T1MlOpleurYbgLjmDhyW.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"340349","ru":"全力扣殺","en":"全力扣殺","year":"2015","type":"Фильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/1enHeQcDyH3esIYmOVQYJhbLoxF.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"480975","ru":"Façades","en":"Façades","year":"2017","type":"Фильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/wxZEaWY4lfawA44iF3v7GF6Aqw4.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"545188","ru":"Oktober dreng","en":"Oktober dreng","year":"2018","type":"Фильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/ukWi4C4GlmqD0kDaGOxtTkukQMs.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"347897","ru":"Guddu Rangeela","en":"Guddu Rangeela","year":"2015","type":"Фильм","rating":4.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/y2iEYUktiTFLjmNMEsyX27tszVg.jpg","genres":[],"o