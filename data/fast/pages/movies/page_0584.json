2PvLFTphR4WidD.jpg","genres":["Драма"],"overview":"Василий Кандинский официально был женат дважды. Но была в его жизни ещё одна женщина, на глазах которой рождался творческий гений основателя абстракционизма. Молодая немецкая художница Габриэле Мюнтер стала для Кандинского спутницей и единомышленницей на долгие 12 лет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1098343","ru":"除恶：飞车党","en":"除恶：飞车党","year":"2023","type":"Фильм","rating":6.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/tVQ1DJjdtPQd9HeaUntXaGuWadq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/okzrhS42C2UbVvIokxdoZn1l4U9.jpg","genres":["Боевик","Криминал","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"938144","ru":"너튜브: 3인의 맛집 2","en":"너튜브: 3인의 맛집 2","year":"2020","type":"Фильм","rating":6.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/vrSqq9hgJh1nqLdIznNHCzUHV4D.jpg","backdrop":"https://image.tmdb.org/t/p/w780/c5Gbj9NXWOBKxeoCnUJCvpv92SH.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1287809","ru":"The Sheriff","en":"The Sheriff","year":"2026","type":"Фильм","rating":6.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/pba15JjYAoyuFIM6kkZ7qE6oqG2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jrYEcctu1rUa5OhRuGc3ooU7uSO.jpg","genres":["Криминал","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"757446","ru":"Intelligentia","en":"Intelligentia","year":"2020","type":"Фильм","rating":6.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/dL3stvvSCWF2lsT9Sn0DX65LYlz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hX9EWF30CrETuUqHWziUgMU4G3l.jpg","genres":["Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}