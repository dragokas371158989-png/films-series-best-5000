e.tmdb.org/t/p/w342/et0muLm0VHD1zWqeTyYhCNuendZ.jpg","genres":["мелодрама","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"524377","ru":"Spitfire","en":"Spitfire","year":"2018","type":"Фильм","rating":7.1,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/u7NNWQL7UGFFB1lajJSaaGNKQk.jpg","genres":["документальный","история","военный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"826691","ru":"Последний из волков","en":"孤狼の血 LEVEL2","year":"2021","type":"Фильм","rating":7.1,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/lK1Ueoiy1fbTJjOdseK3Tu0hT6L.jpg","genres":["криминал","триллер","боевик"],"overview":"После смерти Сего Огами в Хиросиме детектив Шуичи Хиока успешно осуществил план Сего Огами, который состоял в том, чтобы контролировать якудзу, чтобы предотвратить дальнейшие бандитские войны и спасти невинных людей от причинения вреда. Шуичи Хиока управляет преступными организациями, но из-за одного злого человека, которого выпускают из тюрьмы, ситуация резко меняется.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"734780","ru":"Внук","en":"सरदार का पोता","year":"2021","type":"Фильм","rating":7.1,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/nlQFKybBpJrpKS65wd7lhiSpnkt.jpg","genres":["комедия","драма","мелодрама","семейный"],"overview":"Амрик живёт в американском городе Лос-Анджелесе вместе с подругой Радхой. Они основали бизнес и успешно справляются со своими рабочими обязанностями. Жизнь главного героя меняется после того, как Радха решает с ним расстаться. Сразу после этого с ним связывается отец, который живёт в небольшом городе в штате Пенджаб. Он сообщает Амрику плохие новости: бабушка Сардар находится при смерти, и совсем скоро ей предстоит пройти курс лечения от рака. Ей уже 90 лет, и она не тешит себя иллюзиями о возможном выздоровлении. Амрик должен будет исполнить её последнее желание. Сардар всегда мечтала съездить в пакистанский город Лахор, где находится дом, который она вместе с супругом построила в далёком 1946-м году…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1260916","ru":"Путешествие","en":"A Journey","year":"2024","type":"Фильм","rating":7.1,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/8LbrDogBCM7BxUl5igUrY1CLUfO.jpg","genres":["драма"],"overview":"Отказываясь от лечения от рака, женщина отправляется в путешествие по Тасмании, чтобы вместе с мужем и лучшей подругой проверить пункты своего списка желаний.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"783127","ru":"불도저에 탄 소녀","en":"불도저에 탄 소녀","year":"2022","type":"Фильм","rating":7.1,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/pQO5yeQWDl1TUvQ7gadTWWHB60D.jpg","genres":["детектив","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1070507","ru":"カラオケ行こ！","en":"カラオケ行こ！","year":"2024","type":"Фильм","rating":7.1,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/1OXmRTWQoxjcPJHrm1qDdWddeJ7.jpg","genres":["комедия","драма","музыка"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1100287","ru":"Making of The Last of Us","en":"Making of The Last of Us","year":"2023","type":"Фильм","rating":7.1,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/nter1KTaQjmkGCjvSu5u01FoecP.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"645444","ru":"Сумасшедшая лучшая подруга","en":"Psycho BFF","year":"2019","type":"Фильм","rating":7.1,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/znqtsvwjGa1zqG6hhv88Dyaa3lZ.jpg","genres":["триллер","драма","телевизионный фильм"],"overview