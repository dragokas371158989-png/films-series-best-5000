":"https://image.tmdb.org/t/p/w342/hEXLWjeKcaUyUryBgfmtTVozowh.jpg","genres":["телевизионный фильм","драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"344491","ru":"Красивое сейчас","en":"A Beautiful Now","year":"2015","type":"Фильм","rating":4.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/qJ2QhIrehh1TjPlCa6uSZ06qTgz.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"864221","ru":"Бхола Шанкар","en":"భోళా శంకర్","year":"2023","type":"Фильм","rating":4.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/hgip2gbwu19ITJw1KvzLjKHIInt.jpg","genres":["боевик","криминал","драма","триллер"],"overview":"Шанкар переезжает из Хайдарабада в Калькутту со своей любимой сестрой Махалакшми для её поступление в колледж искусств. По прибытии в Калькутту Шанкар устраивается на работу в такси. Оказав помощь полиции, он невольно навлекает на себя месть преступного синдиката. Горя желанием восстановить справедливость и защитить свою сестру, он начинает охоту на главарей синдиката. Ремейк тамильского фильма 2015 года \"Фантом (Vedalam)\".","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1451588","ru":"Загородный корпоратив","en":"Corporate Retreat","year":"2026","type":"Фильм","rating":4.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/jBaTifqUqkjC1oI9GQGqHCXcgap.jpg","genres":["ужасы","триллер","комедия"],"overview":"Руководители компаний, участвующие в корпоративном тренинге по сплочению коллектива, сталкиваются со смертельной опасностью, когда их лидер жестоко выступает против них.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1174732","ru":"Ёлки 10","en":"Ёлки 10","year":"2023","type":"Фильм","rating":4.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/wy5L6KBPNZdXJGjKIJXHAFCnW40.jpg","genres":["комедия"],"overview":"В новогоднюю ночь всегда есть место чуду, даже если ты вдруг перестал в него верить. Геннадьич, коротающий свой век в доме престарелых, обретёт свою настоящую семью. Начинающей блогерше Ларисе из Тюмени предстоит узнать, на что ради своих близких готов решиться её супруг. Марине из Татарстана – научиться любить то, что действительно важно для её мужа. А девушка-геймерша по имени Таня поймёт, что настоящая любовь – это совсем не игра. Ведь в самую волшебную ночь года каждый имеет шанс обрести своё персональное счастье...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1444973","ru":"జటాధర","en":"జటాధర","year":"2025","type":"Фильм","rating":4.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/91aJa79gHiTUWh86XFRMaD2MGjj.jpg","genres":["боевик","ужасы","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1180447","ru":"Haliparot","en":"Haliparot","year":"2023","type":"Фильм","rating":4.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/65ue5jHgXHC5De2LI7wlim9Wyua.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1384945","ru":"熱血燃燒","en":"熱血燃燒","year":"2024","type":"Фильм","rating":4.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2pl0ipyrIUyIv8LOGzPChpgm3Jr.jpg","genres":["боевик","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"795074","ru":"Courting Mom and Dad","en":"Courting Mom and Dad","year":"2021","type":"Фильм","rating":4.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1HMEQGJhMcciNmkBPrpMyCDcNkf.jpg","genres":["семейный","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"944737","ru":"Все виды любви","en":"All Kinds of Love","year":"2022","t