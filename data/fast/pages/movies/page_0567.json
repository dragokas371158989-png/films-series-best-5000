 мужчинам и для каждого придумывает разные образы. Для одного она вежливая пай-девочка, для второго – откровенная и дерзкая, элегантная и женственная для третьего. Всё идёт прекрасно до тех пор, пока девушка не начинает путать роли. И в этот не самый простой момент жизни Ын-хи встречает известного японского писателя, приехавшего в Сеул на презентацию очередного романа. Писатель поражен: Ын-хи - определенно героиня его романа.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"493513","ru":"菊とギロチン","en":"菊とギロチン","year":"2018","type":"Фильм","rating":6.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/oDwiC9DvZNAiZ4AGPbjxmS0PQmZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1F3M5lPytE9BdgSfYtLfWRA73YN.jpg","genres":["Драма","История"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"474442","ru":"西謊極落: 太爆‧太子‧太空艙","en":"西謊極落: 太爆‧太子‧太空艙","year":"2017","type":"Фильм","rating":6.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/tTOy78FnWIxubs4a9O7xxq9qd4g.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zvzrk1HSyAZMMallG0sZF9RJrKU.jpg","genres":["Комедия","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"498737","ru":"素敵なダイナマイトスキャンダル","en":"素敵なダイナマイトスキャンダル","year":"2018","type":"Фильм","rating":6.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/mhUsYlTYj9topDMfcpEL7rB4PxW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pNVYgtVz65voQFEmNdIeArieob2.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"464766","ru":"ทองดีฟันขาว","en":"ทองดีฟันขาว","year":"2017","type":"Фильм","rating":6.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/hphpwAmXa7AEgZEjgsp4e8ay7PS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ajMx3s0ihfCr2XVRJiKaumcCsSb.jpg","genres":["Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"394998","ru":"不速