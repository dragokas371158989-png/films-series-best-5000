емела страшная война между человеком и демонами. По сюжету \"Легенды Зу\" с тех пор прошло более пятисот лет. Тогда война закончилась победой человека, а демоны были вынуждены отступить. Но, в то же время, были очень значительные потери с обеих сторон. Война забрала с собой миллионы жизней. Теперь же ученик клана Куньлунь вынужден встретиться со своим старым учителем. К чему приведет эта встреча, ведь они не виделись долгое время и у каждого есть что сказать друг другу. Но, этой встречи уже не миновать, ведь она просто-напросто неизбежна.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"357458","ru":"젊은엄마: 내 나이가 어때서","en":"젊은엄마: 내 나이가 어때서","year":"2015","type":"Фильм","rating":5.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/kxAMzYivxnEftAEML4FGAIbia0.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"658228","ru":"딸의 애인 3","en":"딸의 애인 3","year":"2019","type":"Фильм","rating":5.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/4zqJPk4NghDpBKWtPOa5fC74tKx.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"6636","ru":"El asaltante","en":"El asaltante","year":"2017","type":"Фильм","rating":5.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/nI7fpYioLcumBOIH0PMPDKxeqZc.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"479390","ru":"Eldritch Code","en":"Eldritch Code","year":"2017","type":"Фильм","rating":5.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/qwPV0SpjZ11Ebz3bdUPwjemxhRb.jpg","genres":["триллер","фэнтези","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"435797","ru":"一萬公里的約定","en":"一萬公里的約定","year":"2016","type":"Фильм","rating":5.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/n0Flo2GbHyfLJyIiWCcbvpF2Izl.jpg","genres":["мелодрама","драма"],"ov