 который вместе с парнем, больным туберкулёзом, и владелицей местного борделя, пытается отвоевать свой город у безжалостной техасской банды.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"582246","ru":"Phoenix, Oregon","en":"Phoenix, Oregon","year":"2019","type":"Фильм","rating":5.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/wiwUfIwL10kkvNPLyKYajlEY137.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"339191","ru":"Мой кореш — зомби","en":"Amigo Undead","year":"2015","type":"Фильм","rating":5.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/hdEbcwrpnV1RMwwZ5KjqdbzhP8R.jpg","genres":["ужасы","комедия"],"overview":"История Кевина Островски, который отправляется со своим братом-неудачником, Нормом, в поход. С ними отправляется несколько чудаковатых друзей Норма. Когда один из друзей случайно умирает в пустыне, они принимают решение похоронить его там, но дело принимает непредвиденный оборот, поскольку пустынька-то оказывается с секретом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"290772","ru":"Fatal Instinct","en":"Fatal Instinct","year":"2014","type":"Фильм","rating":5.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/4o95oEXU6kCMBaqBWynyJ3nd47p.jpg","genres":["боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"266062","ru":"Run","en":"Run","year":"2014","type":"Фильм","rating":5.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/yTfYnBiZcyG8I5aJvyMwvOPbMKq.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"543692","ru":"नमस्ते इंग्लैंड","en":"नमस्ते इंग्लैंड","year":"2018","type":"Фильм","rating":5.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/kx2sDYu2GBWf7GaTXXlqOgTgxpp.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","