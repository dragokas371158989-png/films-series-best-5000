.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/vtmzPMRPlTZPR6uHPg0zJQocQjo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gQ4h2gKXF1CRJeoWTpJWh38DFp4.jpg","genres":["документальный","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"924117","ru":"Кафка для детей","en":"קפקא לילדים","year":"2022","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/v0K0sDa1esMhXaRuA9swg6oTtPd.jpg","backdrop":"","genres":["комедия","музыка"],"overview":"Многожанровый фильм, сочетающий в себе музыкальную комедию с элементами драмы и политической документалистики. Действие разворачивается как пилотный эпизод телесериала, цель которого – сделать сказки Кафки понятными для детей. История, представленная в первом эпизоде, называется «Метаморфозы». Хотя сказание о превращении ГрегораСамсы в паразита показана в анимации, чтение сказки происходит как бы вживую, в волшебном домике, где безымянные дедушка и бабушка читают сказку ребенку в окружении оживших предметов, таких как мисс Лампа и мистер Стол. Они озвучивают персонажей сказки и исполняют песни из фильма в сопровождении игрушечного оркестра. По мере развития сюжета к ансамблю присоединяются другие персонажи, такие как Носитель плохих новостей и домашний мудрец – левый ботинок Кафки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1031996","ru":"ପ୍ରତୀକ୍ଷା","en":"ପ୍ରତୀକ୍ଷା","year":"2022","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/n5T8NqVwzp68kIgI9DHcMNkeKPJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rPC7u38IEAgOZQ6WbnM7CVtXy64.jpg","genres":["драма","семейный","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"975093","ru":"துணிகரம்","en":"துணிகரம்","year":"2022","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/AsJz1POyZYaoxdZtMkRZ7i8n6Yu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k7tGfasGX