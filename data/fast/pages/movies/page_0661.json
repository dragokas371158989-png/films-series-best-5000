2/1rwm7sC64LSDioItxNlFiLowUYN.jpg","backdrop":"","genres":["музыка","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1057265","ru":"పెద్ది","en":"పెద్ది","year":"2026","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/kJAJNNBYlbqAcpTDxBNnaILSMTy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oPsRr7AfNLw6XaPuMpvkWK0bIUA.jpg","genres":["боевик","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1260982","ru":"Влюбленная Элли","en":"恋わずらいのエリー","year":"2024","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/udQmpEgdBFQmiF0rKaLDmrpwpT5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cMglZNvKTURF8NjDjvCqEvUP7N7.jpg","genres":["мелодрама","комедия"],"overview":"Неприметная школьница Эрико Ичимура находит убежище в социальных сетях. Здесь она перевоплощается в Элли и становится предметом воздыханий многих парней. В мечтах девушка видит себя рядом с Акиро Оуми - признанным красавцем и звездой школы. Однако реальная встреча с ним разрушает ее иллюзии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1096563","ru":"Никакой преданности","en":"End of Loyalty","year":"2023","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/c4QA1rFQcyBZKaOOdUrDeL1G9Er.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qskMJe62v9kPj4tD9UawIGW0WxD.jpg","genres":["криминал","боевик"],"overview":"После того, как лидера преступной организации убивает конкурирующая семья, Грант, его сын, клянётся отомстить. В глубоком горе и ярости Гранта, его лучший друг Рэй, федеральный агент, старается предотвратить его погружение в насилие и сохранить здравомыслие.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"637201","ru":"Гаттерби","en":"American Sausage Standoff","year":"2021","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/te6Ac5dgiNJAmbF3vqG4fnzqiuF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ooEUSA2bVuBNKttrrmAxdSNuTgP.jpg","genres":["комедия"],"overview":"Немецкий колбасник Эдвард перебирается в маленький американский городок, чтобы открыть ресторан. Здесь он знакомится с бывшим сутенером Майком - тот только что вышел на свободу и находится в поисках новых жизненных целей. Оба быстро находят общий язык и помогают друг другу реализовать свои мечты. Всем нравится немецкая колбаса - всем, кроме шерифа. Он любит исключительно американские хот-доги. Напряжение между друзьями и шерифом растет, а значит конфликт неизбежен.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1339952","ru":"किस किस को प्यार करूँ 2","en":"किस किस को प्यार करूँ 2","year":"2025","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/sqCgEMxOKvb949xbxn35Wcfn50S.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pwyBBLEofnkRSyQ60oxjXCw9uGW.jpg","genres":["комедия","мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"594174","ru":"Locusts","en":"Locusts","year":"2020","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/v5qphhS55KPhqmyGafHAcSVPhvU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7YGubdw4ssfrUbfzknSVG1CSu8J.jpg","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1318308","ru":"ஆர்யன்","en":"ஆர்யன்","year":"2025","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/rRjh3zumdW89fNMe4tdjmALB1xG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mRyCfbc3vZblB8slswmwovrEhTR.jpg","genres":["боевик","триллер","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1152794","ru":"Lęk","en":"Lęk","year":"2023","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/fELMFc62MqGm16ZCDNlKEGYA2tE.jpg","backdrop