g/t/p/w342/UZtlr9TmcF5BcI23dfQ1UQL2EK.jpg","genres":["боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278329","ru":"Korso","en":"Korso","year":"2014","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/d9GFq67eAeZbJbQXxLOKzMlYFiL.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"838720","ru":"Неделя в раю","en":"A Week in Paradise","year":"2022","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/dYmlqJeBkO2B9Aa2VCbzETtCS9X.jpg","genres":["мелодрама","комедия"],"overview":"Известная актриса узнаёт из прессы об измене мужа. В поисках утешения она летит на райский остров и знакомится в отеле с обаятельным шеф-поваром. Летняя мелодрама на фоне курорта Карибского моря с Малин Акерман, Конни Нильсен и Филипом Уинчестером.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"982813","ru":"Семь лиц Джейн","en":"The Seven Faces of Jane","year":"2023","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/AiC5auZlZNKxlNO8jlI73b63Bgw.jpg","genres":["драма"],"overview":"Мать-одиночка Джейн (Гиллиан Джейкобс) отвозит дочь в летний лагерь и впервые за долгое время остается наедине с собой. Впереди у нее длинная дорога, в которой она познакомится с новыми людьми, встретит старых знакомых, начнет познавать себя и различать, что ей нравится, а что нет. Каждый фрагмент жизни Джейн не похож на другие, одни окрашены в более мрачные тона, другие — окутаны духом вестернов, а третьи и вовсе похожи на мелодраму, но в каждом из них Джейн проходит через кризис идентичности, ища путь к себе настоящей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"776327","ru":"Любовь без памяти","en":"Blackout Love","year":"2022","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/yOoxbjxnzggNNCOtu152jrMpDUS.jpg","genres":["мелодрама","комедия"],"overview":"Циничная и расчетливая Валерия меняет мужчин, ни секунды не сожалея о расставаниях. Тому же она учит и своих подопечных из волейбольной команды. Но единственный человек, который год назад разбил ее сердце, снова появляется в жизни Валерии. Она решает, что теперь найдет в себе силы отомстить бывшему бойфренду. Или это ей только так кажется?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1069069","ru":"10일간의 애인","en":"10일간의 애인","year":"2023","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/osqXpbKzoyTYAGOEmgtID230p7M.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"288287","ru":"打噴嚏","en":"打噴嚏","year":"2020","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/1G7DZYsPHAzpnSh97bsnnfAqEth.jpg","genres":["боевик","комедия","мелодрама","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"740963","ru":"Jump, Darling","en":"Jump, Darling","year":"2022","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/ziQks92PZUAkcxO3tvR3yCIXGXf.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"631880","ru":"Tyger Tyger","en":"Tyger Tyger","year":"2021","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/5fhlV6jdEd9iqYnE9XUQAAhvw82.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"298581","ru":"Кровь храбрых мужчин","en":"Borgríki II - Blóð hraustra manna","year":"2014","type":"Фильм","rating":5.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/9FITP0KQsYXXhAkzhHyJTCQuTmk.jpg","genres":["криминал","триллер","боевик","драма"],"overview":"Бывший главарь мафии Гуннар отстранен от дел, утратил все влияние и мечтает о мести. Сербская мафия конт