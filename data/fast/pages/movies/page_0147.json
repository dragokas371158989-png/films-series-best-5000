er":"https://image.tmdb.org/t/p/w342/AbToqdta8kFDFdIJS4t9UapcJKk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dg2eppz1dH0dETHVGiayYDau6vb.jpg","genres":["Комедия","Мелодрама","Музыка"],"overview":"В Бенидорме, в клубе для кавер-певцов, Дэни стремится к чему-то большему. Он встретится с Сандрой и откроет для себя истинную любовь и то, что значит не быть кем-то другим.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"795980","ru":"По воле случая","en":"As Luck Would Have It","year":"2021","type":"Фильм","rating":6.5,"votes":43,"poster":"https://image.tmdb.org/t/p/w342/50dVUPdEI1qWhiTnIWN3NIZqftn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uBVE7KJ7ivEmYil3R32fB4PGVPB.jpg","genres":["Телевизионный фильм","Комедия","Мелодрама"],"overview":"Линдси едет в Ирландию, чтобы приобрести землю, которая идеально подходит для организации курорта. Она решает принять участие в городском фестивале сватовства, чтобы доказать серьёзность своих инвестиций и привлечь на свою сторону симпатичного местного жителя.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"661332","ru":"Родственные души","en":"Matching Hearts","year":"2020","type":"Фильм","rating":6.5,"votes":43,"poster":"https://image.tmdb.org/t/p/w342/zvQGosiD0rF7bWaI5W39O8s3n5U.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a0GywD3uJesvWDCEZ5pAPZ4prBe.jpg","genres":["Мелодрама","Телевизионный фильм"],"overview":"В 2035 году люди получают возможность найти свою вторую половинку с помощью теста, безошибочно указывающего на идеального партнера. Шесть серий, шесть историй о том, как такой тест может повлиять на человеческие отношения.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"746056","ru":"Рождество в Гленбруке","en":"A Glenbrooke Christmas","year":"2020","type":"Фильм","rating":6.5,"votes":43,"poster":"https://image.tmdb.org/t/p/w342/i2Q7WtmhXlDp8rDwTdmKBxiIMTZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pBY3XBGT1WplO30yzrhSGBSvbaQ.jpg","genres":["Мелодрама","Телевизионный фильм"],"overview":"Джесс Морган родилась в богатой семье. Когда наступает момент её вступления в наследство, молодая женщина осознаёт всю грядущую ответственность. Она понимает, что с этой минуты всё изменится. Люди всегда относились к ней как к «денежному мешку». Возможно, именно по этой причине она пока одинока. Героиня мечтает встретить человека, который влюбится в неё настоящую, а не в количество нулей на её банковском счету.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"400001","ru":"Trémulo","en":"Trémulo","year":"2015","type":"Фильм","rating":6.5,"votes":43,"poster":"https://image.tmdb.org/t/p/w342/8wbvCLoKC4opyydhTZ1z2NasXwR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/clwqQRNWQ2dyj70z8iM60sd6TQs.jpg","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"473760","ru":"L'ordine delle cose","en":"L'ordine delle cose","year":"2017","type":"Фильм","rating":6.5,"votes":43,"poster":"https://image.tmdb.org/t/p/w342/tdU2dInjn0m9SBAnjYAYZYXH9Qk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jt9lJXGLYpEUG4t4tcSmJgtGUVz.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"494632","ru":"Making Fun: The Story of Funko","en":"Making Fun: The Story of Funko","year":"2018","type":"Фильм","rating":6.5,"votes":43,"poster":"https://image.tmdb.org/t/p/w342/geO9eo1q9xihlrhXCeg6BqZIesx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vl4xE0LZfBX7D5mY4WHsEmxNJJZ.jpg","genres":["Документальный","Приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"653580","ru":"Чартер","en":"Charter","year":"2020","type":"Фильм","rating":6.5,"votes":42,"poster":"https://image.tmdb.org/t/p/w342/7VENGNCc3GIqvs78cj7Z46pST5U.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bvsp4VuvwEweg72PCNvbnYTU8sz.jpg","genres":["Драма"],"overview":"После развода муж Алисы запрещает ей видеться с детьми. Однажды вечером ей звонит младший сын и плачет. Алиса решает, не предупредив отца, взять детей со школы и чартерным рейсом полететь на Канарские острова.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1047431","ru":"Prancer: A Christmas Tale","en":"Prancer: A Christmas Tale","year":"2022","type":"Фильм","rating":6.5,"votes":42,"poster":"https://image.tmdb.org/t/p/w342/tJgCmwkf2ytEHYHv8vH3QtRGVPW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fHWUxzEgCqIfToLjlY9UrR6uQtz.jpg","genres":["Семейный","Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"681711","ru":"The Haunting of Alcatraz","en":"The Haunting of Alcatraz","year":"2020","type":"Фильм","rating":6.5,"votes":42,"poster":"https://image.tmdb.org/t/p/w342/xfv77EkP1CbOCi36LZWuWlvoL4o.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bamlu5mY6WOwjQR2AxjNpbtmzDK.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"354980","ru":"Любовь под звёздами","en":"Love Under the Stars","year":"2015","type":"Фильм","rating":6.5,"votes":42,"poster":"https://image.tmdb.org/t/p/w342/hx2jS5Jv8Dx5tdb9YpdSTpHed3Q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rVD8VZjxoglyEFjT017u89k2W84.jpg","genres":["Комедия","Телевизионный фильм","Мелодрама"],"overview":"Благодаря маленькой девочке и вдовцу, 30-летняя женщина столкнулась со взрослой жизнью...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"445913","ru":"Поцелуй у костра","en":"Campfire Kiss","year":"2017","type":"Фильм","rating":6.5,"votes":42,"poster":"https://image.tmdb.org/t/p/w342/uFwX0kQC8jIzHz9XQo2KOxtgaf1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7A8VpNnAZ3vkMs1ZGYXAU5R0AG2.jpg","genres":["Комедия","Мелодрама","Телевизионный фильм"],"overview":"Чтобы наладить отношения с сыном-подростком, заботливая мать-одиночка решает выйти из зоны комфорта и отправиться с ним в лагерь. В лагере она встречает симпатичного отца-одиночку, который тоже пытается наладить отношения со своей дочерью. У двух родителей вечно назревают конфликты, но постепенно они понимают, что влюбляются в друг друга.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"421452","ru":"Espèces menacées","en":"Espèces menacées","year":"2017","type":"Фильм","rating":6.5,"votes":42,"poster":"https://image.tmdb.org/t/p/w342/mQGhLaAS9dy88Gl3LuqEnIw46EJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/veUROBYQZSWrhW61y5GTbi0Klao.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"392625","ru":"Flower Shop Mystery: Snipped in the Bud","en":"Flower Shop Mystery: Snipped in the Bud","year":"2016","type":"Фильм","rating":6.5,"votes":42,"poster":"https://image.tmdb.org/t/p/w342/5cKtGbgxh47bROQx7raEGG8ZwfD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uEljPiEj5LrRVswijNgI32gtCkq.jpg","genres":["Телевизионный фильм","Детектив","Криминал","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1054221","ru":"Идеальный лжец","en":"Coup!","year":"2024","type":"Фильм","rating":6.5,"votes":41,"poster":"https://image.tmdb.org/t/p/w342/oHfPnNmAO0fTRdGO6MVSFCzcmNO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hoeooOsGEYsr5du9j1j12jGv0UL.jpg","genres":["Комедия","Триллер"],"overview":"1918 год, весь мир охватила пандемия испанского гриппа. Богатое поместье недалеко от Нью-Йорка готовится к локдауну, владельцы спешно набирают слуг, которые обеспечат им максимально комфортное существование в это время. Среди них и знаменитый шеф-повар, который славится идеальными рекомендациями и хорошими манерами. А еще он неплохой охотник… и отличный манипулятор. День за днем обстановка в доме меняется — и вот уже слуги берут власть в свои руки, а вскоре и хозяйка дома попадает под чары этого необычного господина. Ее супруг понимает, что единственный шанс выжить — победить самозванца в этой хитрой игре.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1327769","ru":"27 ночей","en":"27 noches","year":"2025","type":"Фильм","rating":6.5,"votes":41,"poster":"https://image.tmdb.org/t/p/w342/56p2n8K8vASF5C7Y7zPZiTGiwT5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/28xIxuw60UNZ3Tsz1tT5Gg7MS67.jpg","genres":["Комедия"],"overview":"Дочери помещают мать в психиатрическую клинику из-за ее легкомысленного образа жизни. Специалист должен решить, больна ли она или просто желает наслаждаться жизнью.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"494467","ru":"Расследования Эммы Филдинг: Давняя злоба","en":"Past Malice: An Emma Fielding Mystery","year":"2018","type":"Фильм","rating":6.5,"votes":41,"poster":"https://image.tmdb.org/t/p/w342/jLex3GzVQ7VJBZkVOZfI3rPGBJn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mOSBM2h6q0Ky4ZMPwuU4SmlbdXv.jpg","genres":["Детектив","Криминал","Драма","Телевизионный фильм"],"overview":"Археолога Эмму Филдинг приглашают для консультирования при продаже древнего замка, который, если верить легендам, был проклят. Но она оказывается втянутой в дело об убийстве - тело другого археолога, её предшественника, было найдено в потайной комнате в подвале огромного строения. Вместе с другом, агентом ФБР Джимом Коннором, Филдинг придётся пройти путь через множество улик и столкнуться с подозреваемыми, у каждого из которых могла быть причина желать смерти жертве.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"522811","ru":"Случайный детектив: Возвращение","en":"탐정: 리턴즈","year":"2018","type":"Фильм","rating":6.5,"votes":41,"poster":"https://image.tmdb.org/t/p/w342/b5KVtP7dLeQoEM5iMjs4Iib18Eb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1kzsu5rW3xt4K96hXyooWAxBeVD.jpg","genres":["Комедия","Криминал"],"overview":"Кан Дэ Ман продал свой магазин комиксов и открыл частное сыскное агентство, ни слова не сказав своей жене. Но Тхэ Су - бывший детектив, который работает вместе с Дэ Маном. Однажды они начинают работать с Ёчи, который управляет виртуальным детективным агентством.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"531837","ru":"Незабываемое лето","en":"A Summer to Remember","year":"2018","type":"Фильм","rating":6.5,"votes":41,"poster":"https://image.tmdb.org/t/p/w342/iz9diZVtZGtyRWd8Mu51lDybkiK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yIZtDi16zGdPk8HWKBE6MNinxjL.jpg","genres":["Телевизионный фильм","Драма","Мелодрама","Комедия"],"overview":"Джессика, вдова и врач, пытается совмещать работу и семью. Она берёт отпуск, чтобы сблизиться со своей дочерью, и отправляется на курорт в Фиджи, где завязывает дружбу с Уиллом, очаровательным владельцем отеля. Проводя время с Уиллом, Джессика начинает задаваться вопросом, может ли райский остров дать ей то, что она всегда искала.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"417546","ru":"Fala Comigo","en":"Fala Comigo","year":"2016","type":"Фильм","rating":6.5,"votes":41,"poster":"https://image.tmdb.org/t/p/w342/ePFiF7L9airzDkPwI6txjxG9RV7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yf436twLhr0Xq6y6tGF8JMuEPES.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"401441","ru":"Embrace","en":"Embrace","year":"2016","type":"Фильм","rating":6.5,"votes":41,"poster":"https://image.tmdb.org/t/p/w342/5Fgx8oY77AiaqS7CIEeqSFnKHnr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AddQCPVi5caUDaME7mNgsOLcCV7.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"999142","ru":"Рабия","en":"Rabia","year":"2024","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/rCE2jDp5wS3VahLLhismUMWLb96.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tZ7ki6JMgEliY4u4XJmABZfAT2g.jpg","genres":["Драма","Триллер"],"overview":"Купившаяся на обещания новой жизни, 19-летняя француженка Джессика отправляется в Сирию, чтобы присоединиться к ИГИЛу. Прибыв в Ракку, она устраивается в дом для будущих жен боевиков и вскоре становится пленницей Мадам — деспотичной директрисы, которая держит всех своих воспитанниц в ежовых рукавицах.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"869434","ru":"Неизвестные измерения: История паранормальных явлений","en":"Unknown Dimension: The Story of Paranormal Activity","year":"2021","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/10a5miRZ8FMNCiPC8PIc0sAdBlk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dtzNRRjus5fGOMZBs91AMJWvfMN.jpg","genres":["Документальный","Ужасы"],"overview":"Как низкобюджетный хоррор, снятый новичками-энтузиастами, стал кассовой бомбой, мировым хитом и началом долгоиграющей киносерии? Об этом рассказывают его создатели и звезды: режиссер и сценарист Орен Пели, глава знаменитой студии Blumhouse Productions Джейсон Блум, исполнители главных ролей Кэти Физерстон и Мика Слот, а также другие продюсеры и члены съемочной группы, внесшие вклад в феноменальный успех проекта.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1015981","ru":"Jolly LLB 3","en":"Jolly LLB 3","year":"2025","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/bwRoU9p5GvjxgPfmIgsfcJ4ydng.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gC1kJpDPtaogbq7N543si20jC0w.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1147546","ru":"राजनयिक","en":"राजनयिक","year":"2025","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/uwl9Y4px8TTIQK4N19k6gnW1RnX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2ZmbuDNbL6YUV2r8O5AAenKx01V.jpg","genres":["Триллер","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1051560","ru":"The Devil Comes at Night","en":"The Devil Comes at Night","year":"2023","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/6QIeZuKirT4cXVpW7ilVZmcRmdK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aGQIIKpAPYNtziFrCCBBgIzmUXe.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"426484","ru":"Посланные небесами","en":"Heaven Sent","year":"2016","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/dhLWpNK1taCXWRLQopU8mXN41Z4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3UJ1IcxIORsTmoLzPv6k6BZwdqe.jpg","genres":["Мелодрама","Драма","Телевизионный фильм"],"overview":"Брак Билли и Мэй полностью себя исчерпал, и они не хотят больше портить жизнь друг другу. Они и впрямь очень разные: Мэй – амбициозная деловая женщина, Билли – художник, творческая и ранимая натура. Может быть и правда им стоит развестись и найти каждому более подходящую пару? Однако у провидения другие планы на их будущее. Где-то там, наверху было принято решение помирить этих двух и сделать так, чтобы они снова были счастливы вместе. И с небес посылается восьмилетний ангел с непростой задачей – дать понять Билли и Мэй, что они созданы друг для друга.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"223632","ru":"Галапагосская афера: Сатана явился в Эдем","en":"The Galapagos Affair: Satan Came to Eden","year":"2014","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/fUZPUzv5GUxYcycPFudBLLU8S39.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rpXp9wbmyj0UeChII64FRGwrnih.jpg","genres":["Документальный","Детектив","История","Криминал"],"overview":"Дарвин и Хичкок смешаны в этой настоящей криминальной истории о Рае, обретённом и затерянном. Фильм представляет захватывающий документальный портрет 1930-х годов в обрамлении повествования о загадочном убийстве, странного и притягательного, как сам знаменитый архипелаг. Удалившись от мещанского общества, берлинский доктора и его возлюбленная начинают новую жизнь на прежде необитаемом острове Флореана (Цветущая - исп.). Но после того, как международная пресса сделала сенсацией деяния галапагосских \"Адама и Евы\", другие стекаются туда, в том числе самозваная швейцарская семейка робинзонов и вооружённые до зубов венская баронесса и её двое любовников. Ничего уже не будет прежним.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"320421","ru":"Моя Валентина","en":"Meet My Valentine","year":"2015","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/e6vDlvYA42LANg8tuzhRxgpmVZT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f4B5JKnDX7FI5bGy4lHJeI8PDPn.jpg","genres":["Мелодрама","Драма"],"overview":"Том узнал, что ему осталось всего несколько месяцев жизни и он хочет найти того, кто позаботится о его жене и 8-летней дочери, когда его не станет...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"329687","ru":"雛妓","en":"雛妓","year":"2014","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/efHMkauOLpc9TphadoalqH3pgY1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/x0d7XtZmlVuc5HLRgQv26cdn4Um.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"398356","ru":"Flower Shop Mystery: Dearly Depotted","en":"Flower Shop Mystery: Dearly Depotted","year":"2016","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/wq9Vine2xE8SqqGwfTA1HzRvaWC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6b7tPABNQbn97jEh1KPbWPe1OcG.jpg","genres":["Телевизионный фильм","Детектив","Криминал","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"325699","ru":"టెంపర్","en":"టెంపర్","year":"2015","type":"Фильм","rating":6.5,"votes":40,"poster":"https://image.tmdb.org/t/p/w342/hA793thpccdoAHSOZ5GNbtdS