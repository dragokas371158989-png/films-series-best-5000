ерей в ловушку, повторяя подвиг Ивана Сусанина. Старик ценой собственной жизни приводит врага к гибели, становясь символом народного сопротивления.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1662256","ru":"勇者无疆","en":"勇者无疆","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/5ENxl6xf3YUpcoUFVz4AebdHVi4.jpg","genres":["драма","военный","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1573031","ru":"The Blue Suit","en":"The Blue Suit","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/tNUfrFfiyA7AefGKXrjb3rKR7lU.jpg","genres":["драма","комедия","вестерн"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1421128","ru":"বাক্স বন্দি","en":"বাক্স বন্দি","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/bshqlomXJRIKHCpmyU2rTYTgTGm.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1520517","ru":"6:06","en":"6:06","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/6wW6VYPohfoIXETtXToWzvkFRr.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1588895","ru":"Finding Goldfinger","en":"Finding Goldfinger","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/xbjLWRza9d9OEikGlPgNCpzCudW.jpg","genres":["приключения","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1364624","ru":"Worry Time","en":"Worry Time","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/u76CCmikSLIA3KiTwD41jqiqRl6.jpg","genres":["фантастика","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1616