{"tab":"movies","page":625,"pages":899,"count":53936,"pageSize":60,"items":[{"id":"934358","ru":"Анка","en":"Anka","year":"2022","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/mF0tx550p3ViekKX7pfSXKzkXnd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oaRpElP2J8wgwcDoAstymeiR4Yg.jpg","genres":["боевик","драма"],"overview":"Мурат, потерявший семью в результате несчастного случая в детстве, становится известным в автогонках, борясь со своей травмой на протяжении многих лет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1030598","ru":"כאילו אין מחר","en":"כאילו אין מחר","year":"2022","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/84Ub8u6mu0taZPTBJVHdbwyQtLA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8c1jBGplle95WftDN56h9N4q2q7.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1008640","ru":"黄金大逃狱","en":"黄金大逃狱","year":"2022","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/u5ml4gox6r4WJ7Xn5ZAkgLC1VZw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m61YN7oUmrdEetwjdPN3tXQtx9S.jpg","genres":["криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"951189","ru":"Kapinynas","en":"Kapinynas","year":"2022","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/ajHTU7ObS1nhskW1fUwIW5iX0Y2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cAzjcBAUUysmMNasciIJxgbmD7L.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1583798","ru":"Merge","en":"Merge","year":"2025","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/96RRndTH4YPqYplAmnTT4hOW7MF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lEGHJBF7gwILj1MSJYDxNc4JcJy.jpg","genres":["фантастика","драма","мелодрама","ужасы"],"overview":"","source":"