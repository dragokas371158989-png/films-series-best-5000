s://image.tmdb.org/t/p/w342/oMgS80fHZhFTRykiynvIAvTKlyX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nFOWOd0KEgOTKclFZBm1eX0g2v5.jpg","genres":["фантастика","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"401178","ru":"夫婦フーフー日記","en":"夫婦フーフー日記","year":"2015","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/qKWdwvzfhCUEQDxKBRDgvL0y2IK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lmQsuRd7uCrNmB5hK87RYzGCyGG.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"347786","ru":"Пионеры-герои","en":"Пионеры-герои","year":"2015","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/kItaVNUJwAN6yPrzqKgs4QJA3Hs.jpg","backdrop":"","genres":["драма"],"overview":"Ольга, Катя и Андрей давно приехали в Москву, они дружат со школы. Они вполне успешны. Ольга — актриса, Катя — работает в крупном PR-агентстве, Андрей политический аналитик. Они покупают машины, берут ипотеки, строят дачи. Живут как все. Но это не приносит им ни счастья, ни удовлетворения. Ощущение, «что все вроде нормально, но что-то не так» — лейтмотив жизни сегодняшних тридцатилетних. Их детство пришлось на советскую пору — когда дети мечтали о подвигах, верили в шпионов и светлое будущее, и никто не ожидал, что мечту о подвиге заменит мечта о стабильности. Люди больше не мечтают о великом. Они просто живут.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"361556","ru":"Brandmal","en":"Brandmal","year":"2015","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/dU6wF7hTev0ldxm37SNnsKN1Xku.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tLrRiHFJ4Cjmdl3HAHwxlGp40vp.jpg","genres":["триллер","телевизионный фильм","боевик","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1529439","ru":"중간계","en":"중간계","year":"2025","type":"Фильм","r