g":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/jaHbkAd9cA4EhIP49adGXypFSBX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jSHYcscAYlkxRNxFt7CWgiPrh67.jpg","genres":["драма"],"overview":"1881 год. Япония ставит задачу освоения Хоккайдо. Но проложить дороги в этих суровых местах можно только силами заключенных. Начальник тюрьмы Кабато, тиран и шут Цукигата Тэнгоку не жалеет ничьих жизней. Какая расплата ждет его за грехи?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"405340","ru":"セーラー服 百合族2","en":"セーラー服 百合族2","year":"1983","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/tvKS2V9bCWgjDCa4tPI0lwHN1kN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5G062LSG2AvDFq0xyRKeme2nuCX.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"402224","ru":"Send","en":"Send","year":"2014","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/zfSZPQ4I4LHmWba4DHmRL9ztXwx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cds7K4oBQJpHAW3gTGLbBYKhIk4.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"470413","ru":"心理罪","en":"心理罪","year":"2017","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/zbO8uBqF8dCTF445OA9RTbfwEod.jpg","backdrop":"https://image.tmdb.org/t/p/w780/giAmlQsPcZvY85wIYcC6Ghs4jPE.jpg","genres":["детектив","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"371676","ru":"సోమరి","en":"సోమరి","year":"2015","type":"Фильм","rating":5.6,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/qXrIBBugDIgjd7mm6XqDj256gCx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uVQYYe56a0mchLNlwIyWsTswLtx.jpg","genres":["драма","семейный","боевик","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"568461","ru":"Med