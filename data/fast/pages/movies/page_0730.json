es":"","studio":"","country":"","ageRating":""},{"id":"1063738","ru":"燕交","en":"燕交","year":"2025","type":"Фильм","rating":3.5,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/nZoCnOfMqqKXY0DerPgoxnBG2WR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zDBpJfzfXnNtd5tvAa0GssNXaA9.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"652572","ru":"엄마친구 6","en":"엄마친구 6","year":"2019","type":"Фильм","rating":3.5,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fGl0JGTGNNgqT5XYwcR0BUmODA3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yLJyLcTWecLAYDMwfdJ5jbwW17S.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"412018","ru":"கதாநாயகன்","en":"கதாநாயகன்","year":"2017","type":"Фильм","rating":3.5,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/eEQnCK9BdDxO8EaUSEWSsZsY8KW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zXkzGR98TefpGJj5gfZVNHaO75i.jpg","genres":["боевик","комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1186067","ru":"Подвал господина Гринберга","en":"Подвал господина Гринберга","year":"2023","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/k7XwNLLaTVfUlr9Mysd2LQh94En.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b45OgiXp1LOffpqnfeDpDcmeL4x.jpg","genres":["криминал","триллер"],"overview":"В маленьком провинциальном городке начали пропадать молодые девушки. Подозрение полиции вызвал Артур Гринберг, которого видели в баре с последней пропавшей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1416281","ru":"Простоквашино","en":"Простоквашино","year":"2026","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/rAbQ6N7p5M81DiFfsFirMeOUuYY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zQSI6yJpq0CCxZgPYeXC0tZTpuc.jpg","genres":["приключения","семейный"],"overview":"Жил-был мальчик по прозвищу Дядя Фёдор. Он очень любил животных, но его родители и слышать ничего не хотели о том, чтобы в их квартире завёлся кто-то хвостатый и лохматый. И пришлось Дяде Фёдору со своими новыми приятелями — котом Матроскиным и верным псом Шариком — отправиться в деревню Простоквашино.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"814814","ru":"Кензели","en":"Кензели","year":"2021","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/tYQwELM763dJZWU3j4Qz0mQ14wc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2dwBDa36m8jtFrPFz6NQFDtCy03.jpg","genres":["мелодрама","фантастика"],"overview":"Влиятельный бизнесмен Владимир обладает предприятиями по разработке и продаже технологий, позволяющих видеть скрытое. Вокруг него и его молодой супруги Екатерины разворачиваются события, уносящие их в прошлое. Они становятся свидетелями любовного треугольника Фелиссы Круут 20-х — 30-х годах XIX века. В настоящем Екатерина встречает молодого музыканта Степана и ее реальная любовная жизнь становится отражением жизни Фелиссы Круут в прошлом. Владимир, не в силах наблюдать со стороны и смириться с неверностью жены, пытается помешать этим отношениям.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1117061","ru":"Hugot","en":"Hugot","year":"2023","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/uuxhFccZJvmQy5UDzoP3Wzjn7LU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/opkaX1d1uvkgzN9dAHYjDeUWFgW.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1256658","ru":"Cheaters","en":"Cheaters","year":"2024","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/f4kCaBqXQkflj9sUWZOosS9WbCD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zqXXFYSIxaN5qfRnShRSywtqmQC.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1541444","ru":"Nepela","en":"Nepela","year":"2025","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/oh8hlzLuazmFZHwkDVSOzATrqwO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lX1T5cI7s0JxWt8ypXfbrGL4dAl.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"785507","ru":"게임의 법칙: 인간사냥","en":"게임의 법칙: 인간사냥","year":"2021","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/7UVfaDT27IZWby255AeKk0vOcyL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mTB7H4ceABGSubuKF1RbJClwBNl.jpg","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1204960","ru":"疾速反击","en":"疾速反击","year":"2023","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/em4UK3ECROeUemsYi3VyAklRzjk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iuXF2nvgORZw1C2g8HguOsU9avO.jpg","genres":["боевик","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"824199","ru":"Don Filipo","en":"Don Filipo","year":"2021","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/nGQm7e2rZnZ6cHJlLmJndJxUtGF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3C0B4VvRMTVUuaQuhXqsPaw6jL.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"375109","ru":"Срочно выйду замуж","en":"Срочно выйду замуж","year":"2015","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bYRuUku0J4l5wqc0URr8j0fUvT6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6KNGSP8Uekv4WMzEBwoBEtRnOwU.jpg","genres":["мелодрама","комедия"],"overview":"Женя — редактор-трудоголик, Стас — светский фотограф. Она амбициозна, а у него по жизни — ни задачи, ни проблемы. Женя хочет и может стать главным редактором журнала, но для этого у нее срочно должен появиться супруг! Условие акционеров издания — семейная аудитория нуждается в семейном руководителе. И на решение этой задачи у девушки есть всего неделя. Стас берется помочь девушке, в картотеке у модного фотографа есть немало холостяков, которые вполне могли бы подойти на роль мужа. Но неожиданно Женя понимает, что совсем не расчетлива, а Стас с удивлением обнаруживает, что влюблен.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"511613","ru":"Пленительный бурлеск","en":"Becoming Burlesque","year":"2019","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/zgtxqGZtrSPdg9Gbwe8JjqL6Ys.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9RJ0lIC0UnxKbLHXHHvBlafYSwF.jpg","genres":["драма"],"overview":"Несмотря на то, что дядя Фатимы старается привить ей традиционный мусульманский образ жизни, она всё же тайно присоединяется к труппе бурлеска в Торонто.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"387808","ru":"등산의 목적","en":"등산의 목적","year":"2016","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/k4RwkJp99pSFnJ7La8w9AA86zNP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8HIlPYRAuhVQ9rEKx2cV8y8wPD0.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"435838","ru":"Debut","en":"Debut","year":"2016","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/b9WUabdQVTJnVGnfGPVlGDStxji.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1ovrHn1sPlD1j6ZFRH8pigNw6Q.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"659254","ru":"Broken Swords: The Last in Line","en":"Broken Swords: The Last in Line","year":"2018","type":"Фильм","rating":3.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/lG3NmZa9XqkbC0x5D0dMKDveqJv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hG63ijNO9pdcX1P6D3sw5eSmzP5.jpg","genres":["боевик","фэнтези"