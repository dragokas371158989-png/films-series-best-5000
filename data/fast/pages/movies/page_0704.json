ype":"Фильм","rating":4.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/4gEreoerGVojAVY6a0ucSQPNPbU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3vHPwPotwt1scWs44DhlfaI5TAV.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"585534","ru":"モーニング・ムーンは粗雑に","en":"モーニング・ムーンは粗雑に","year":"1981","type":"Фильм","rating":4.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/ogRSqsyiiQOxPXQR6y2WUMwcMb8.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"293235","ru":"All Star Comedy Jam: Live from Las Vegas","en":"All Star Comedy Jam: Live from Las Vegas","year":"2014","type":"Фильм","rating":4.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/y4dCYWw0N9C26L302mFoYVJzFnY.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"464175","ru":"Dirty","en":"Dirty","year":"2016","type":"Фильм","rating":4.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/zmbKs6pRHWy2FjlCoDXCwSnpWdb.jpg","backdrop":"","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"629390","ru":"SophiaWorld","en":"SophiaWorld","year":"2019","type":"Фильм","rating":4.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/uU2XylHRDY8a1cBCcK1axVux8cM.jpg","backdrop":"","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"329321","ru":"살인캠프","en":"살인캠프","year":"2015","type":"Фильм","rating":4.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/bbts9QYeVrtNsmV2yZSRJKBpeXa.jpg","backdrop":"","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"335004","ru":"The Thrilling Adventure Hour Live","en":"The Thrilling Adventure Hour Live","year":"2015","type":"Фильм","rating":4.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/idwLpR58NeK3CyvZT2UHhvqD3lE.jpg","backdrop":"","genres":["комедия","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"412280","ru":"Северянин","en":"The Northlander","year":"2016","type":"Фильм","rating":4.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/tZNMuNe5EQiV7VUNbDmE9ovBln.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Uj8kB5siJJRX9gY7nx1ufBMYQY.jpg","genres":["приключения","фэнтези","фантастика"],"overview":"В 2961 году эпоха людей подходит к концу. Природа начинает отвоевывать назад свои территории. Охотник по имени Сигнус призван защитить свой народ. Он отправляется в путешествие сквозь пустоши, чтобы остановить шайку еретиков. Сигнус должен найти способ спасти свое племя.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"514782","ru":"Игрушечный пистолет","en":"Toy Gun","year":"2018","type":"Фильм","rating":4.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/z7Cti1ii27TTyKLx5YJPq3inX8S.jpg","backdrop":"https://image.tmdb.org/t/p/w780/590mujnOlnjoSwvmNQ8VUaPt4Zb.jpg","genres":["комедия","боевик","криминал"],"overview":"Игрушечный пистолет - это забавная, но мрачная комедия о кротком молодом человеке, который импульсивно грабит банк, чтобы доказать своей бывшей жене, что он храбрый и мужественный. Полицейское расследование затрагивает всех, кроме нашего ничего не подозревающего героя, которого, по иронии судьбы, оно полностью игнорирует.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"301730","ru":"Охота на индюшек","en":"Turkey Shoot","year":"2014","type":"Фильм","rating":4.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/8f3twszUfCtInJo0VB1Bz3ptx0e.jpg","backdrop":"https://image.tmdb.org/t/p/w780/v2lzXdjug3Ui8y0gjBeBm3hxD2s.jpg","genres":["боевик"],"overview":"В вымышленной стране с военной диктатурой всех неблагонадежных и просто сочувствующих перевоспитывают в особых лагерях, превращая в послушных рабов. «Посадочных» мест уже не хватает, но эту проблему начальники-садисты одного из ИТУ решают очень просто. Для высокопоставленных гостей, приезжающих отдохнуть, устраивают так называемую охоту на индюшек, мишенями в ней служат заключенные. Смертоносная игра, в которой охотники могли использовать все виды холодного и огнестрельного оружия, была для них безопасной, пока на роли «индюшек» не назначили красотку Крис и мужественного Пола Андерса…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"403100","ru":"Scared Topless","en":"Scared Topless","year":"2015","type":"Фильм","rating":4.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/3bsTVoTl2UAHSMla8GXFjxf6w21.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wFASwHuWWoamkfnfpcbMuzDUYVa.jpg","genres":["комедия","ужасы","детектив","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"438086","ru":"Машина любви","en":"Машина любви","year":"2016","type":"Фильм","rating":4.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/ljYTewDPowqFvVnodJnblW9oWkl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/v0WMc4pd3iknTPaffLdwXtB5z2S.jpg","genres":["драма"],"overview":"Интимная драма о разных сторонах любви: нежности, страсти, ее магии и ловушках. Поэтическое путешествие в сферу подсознательного переплетается с автобиографической историей об отношениях и расставании, где реальные герои — режиссер Руминов и его бывшая девушка — играют самих себя.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"412452","ru":"Крест. Часть вторая: Двойной обман","en":"Cross Wars","year":"2017","type":"Фильм","rating":4.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/56LXhaTT7u5E8WAjvYOSNXC7WBQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vmq1kWoBqOjUwjFB5IOexUNQloL.jpg","genres":["боевик"],"overview":"Возвращение непримиримого борца со злом Каллана, обладателя древнего магического амулета Крест, и его брутальной команды. Теперь их жизням угрожает новый враг Муэрте и их старый знакомый, проклятый викинг Гуннар. Чтобы спастись самим и спасти всё человечество, герои вынуждены объединиться с командой воинственных женщин, возглавляемых красавицей Райли, у которой есть своей древний амулет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"467839","ru":"Чужие против Титаника","en":"Aliens vs. Titanic","year":"2017","type":"Фильм","rating":4.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/amqjAZ1c6rTLtCSk3gnBeEuyJFZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xSssW53a2s2euCdyI4aEpzyZfb1.jpg","genres":["фантастика","комедия","ужасы","триллер","боевик"],"overview":"Экипаж круизного космического корабля «Титаник» столкнулся с астероидом и потерпел крушение во время своего первого полёта. Большинству пассажиров посчастливилось умереть, но пять человек выжили. И очень скоро пожалели об этом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"13902","ru":"Отрава","en":"Toxic","year":"2008","type":"Фильм","rating":4.2,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/pgXHemrcs5UI6Usay7FD1g3ShB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s99KIYggfTytduAPy0XpBNGorX.jpg","genres":["боевик","триллер"],"overview":"Жизни владельца ночного клуба, криминального босса, стриптизерши, бармена, двух наемных убийц, проститутки и психиатра превращаются в кошмар, когда они сталкиваются со сбежавшим психопатом, который идет по своему зловещему пути безумия и разрушения.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1104670","ru":"Pillow Party Massacre","en":"Pillow Party Massacre","year":"2023","type":"Фильм","rating":4.2,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/i0IGE0CCfHxsbCNJEPkYgLKdaSA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jooiSBVQ0ZrpJAxUrVfreDLKlnx.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}