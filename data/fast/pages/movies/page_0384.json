mdb.org/t/p/w342/AuHe7cNA9niHgCR9M4q5xS5TqkC.jpg","backdrop":"","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1340035","ru":"JVP a Londres","en":"JVP a Londres","year":"2024","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7VnHYaZF8em99wReSyi7rNh1BNR.jpg","backdrop":"","genres":["документальный","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1512480","ru":"Vanishing Point","en":"Vanishing Point","year":"","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/uwjISpGcdBldS6irjLjyTYntFwe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sYn05iS9AxV9rsjqBSHrI4azji1.jpg","genres":["драма","семейный"],"overview":"Зарабатывая на жизнь перегоном машин из города в город, Ковальски получает очередное задание — доставить белый «Додж Челленджер» в Сан-Франциско из Денвера. Когда его пытаются остановить полицейские по неясной причине, Ковальски демонстративно отказывается подчиняться властям и упорно уходит от преследования, следя лишь за тем, чтобы никто из гонящихся за ним полицейских не погиб…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1486994","ru":"Shakhaur 7116m, Face Nord","en":"Shakhaur 7116m, Face Nord","year":"1969","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/uBzPW1iQwJlDEIQiq3CreQhRWJ1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uPJCpCVky8cPoyP6x3sn6TkXUSd.jpg","genres":["документальный","приключения"],"overview":"Этот фильм — без комментариев и просто в сопровождении местной музыки — рассказывает о восхождении в 1969 году на северный склон Кохе Шахавр, гималайской вершины, расположенной на границе с Афганистаном, которое совершили альпинисты Бенуа Матье, Жак Суби, Рене Тома, Жан-Поль Пари, Изабель Агрести, Анри Агрести, Роже Диц, Жан-Пьер Фрезафон, Поль Жандр, Клод Яже и Феликс Маньен. Как это часто бывает в фильмах Анри Агрести, во введении подробно описывается встреча с другими народами, другими культурами. Затем, после бесконечного подхода, начинается восхождение: распределение лагерей, последовательные штурмы горы, переходы по крутым осыпям и снежным склонам, восхождения по ледяным стенам... Прибытие на вершину без помощи кислородных приборов, кажется, происходит в замедленной съемке: усталость смешивается с радостью победителей-альпинистов, которые будут праздновать свой успех по возвращении в базовый лагерь 24 августа 1969 года.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1469425","ru":"La Bataille De La Production","en":"La Bataille De La Production","year":"1998","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/aWTirwaWR7z5XO3JL2ROzObFcAc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5Zw0fqFiAGcuQrm3wOBGfLkKmLe.jpg","genres":["документальный"],"overview":"В 1997 году преданный своему делу режиссер Жан Ассельмайер, вооружившись своей камерой, задал на Генеральной ассамблее документального кино в Люзасе и Париже следующий вопрос: возможно ли сегодня снять преданный своему делу творческий документальный фильм? Рене Вотье, Тьерри Жаррелю, Жан-Мишелю Карре, Жан-Мари Барбе, Иву Гено, Александру Корню, Labelle Films, Жану-Франсуа Рейно, Самиру Абдалле и многим другим, не в последнюю очередь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1341751","ru":"Unleashed","en":"Unleashed","year":"1997","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/haF1O5t9hD1jht9roGiZMAxx2mu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/leukkAoRu9rsa3s8oaLm8C10EWw.jpg","genres":["ужасы","комедия"],"overview":"Дэнни — человек. Он — не собака и вообще не зверь. Но он ходит в ошейнике, спит в ошейнике, ест в ошейнике, почти круглые сутки он проводит в ошейнике. Потому что таким его воспитал Барт, гангстер из Глазго, собиратель долгов, не брезгующий никакими методами при достижении поставленной цели. Когда ему не отдают долг, у него быстро лопается терпение, и тогда Барт снимает с Дэнни ошейник. И Дэнни превращается в собаку, в злобного бультерьера, в адскую смесь жестокого зверя и неудержимого боевого киборга. Нет на свете соперника, равного Дэнни в поединке. Дэнни не знает иной жизни, кроме полусонного существования в ошейнике или смертельной битвы без ошейника. Однажды волею судьбы он оказывается в доме, где живут старый слепой пианист Сэм и его приемная дочь Виктория. Дэнни узнает, что есть иная жизнь, в которой есть чувства, краски, звуки…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1701831","ru":"Hands Off","en":"Hands Off","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/di8KRUZlAo6A7rDqKNvmb3O4ju5.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1693755","ru":"Save the Pigeons","en":"Save the Pigeons","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/dDsnz88UYVQgbl1bLpIvx4a4bHj.jpg","backdrop":"","genres":["комедия","документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1690718","ru":"The Seal Movie 2","en":"The Seal Movie 2","year":"2022","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/nBcTtGI3lTHFrl23kqXgGV2XOv6.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1688130","ru":"The Sullivan Stories","en":"The Sullivan Stories","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/npNkdlPrhBvV8e0azilLEj78Pnt.jpg","backdrop":"","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1685835","ru":"What Happens Next?","en":"What Happens Next?","year":"2026","typ