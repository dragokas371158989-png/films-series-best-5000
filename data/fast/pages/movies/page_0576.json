а","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"917082","ru":"Der Rebell - Von Leimen nach Wimbledon","en":"Der Rebell - Von Leimen nach Wimbledon","year":"2021","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/fuRoEfJV5Iz1nHdOzy2J5LYrT6p.jpg","genres":["телевизионный фильм","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"499874","ru":"От отца к сыну","en":"范保德","year":"2018","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/iFilj7Y4TQzwus3nIURICOBnSNJ.jpg","genres":["драма"],"overview":"На свой 60-летний юбилей Ван узнаёт, что смертельно болен. Но вместо больницы мужчина вместе с сыном отправляется в Японию на поиски отца, который бросил его 50 лет назад. В это же самое время молодой человек, как-то связанный с Ваном, едет из Гонконга на Тайвань.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"453663","ru":"Ён-сун","en":"용순","year":"2017","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/3QNgu1vWUQg5ZNgSyHGiDeJRFcL.jpg","genres":["драма","комедия"],"overview":"18-летняя старшеклассница Ён-сун ненавидит своё имя. А ещё её угораздило влюбиться в учителя физкультуры, но он, скорее всего, уже с кем-то встречается. Чтобы убедиться в этом наверняка, Ён-су с друзьями начинает расследование, а тут ещё и папа решил устроить свою личную жизнь и привёл в дом мачеху из Монголии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"395319","ru":"Создатели страхов","en":"Definition of Fear","year":"2015","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xySWpKCii1RUdYQ9lD7LTp8NJAe.jpg","genres":["ужасы"],"overview":"Четыре красивые девушки проводят выходные в очаровательном домике отдыха. Но все не так спокойно, как кажется. Вскоре они понимают, что кроме них в доме есть кто-то еще.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"322819","ru":"Я еще не готова умереть","en":"Jag är inte beredd att dö än","year":"2014","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/us5m3VwewzryikqfuNnMLQo5H2E.jpg","genres":["документальный","музыка"],"overview":"Будучи маленькой девочкой, Лале переоделась принцессой в ожидании спасительного принца. Мать сказала - Нет, Лалех, это ты принц, ты себя спасешь. Лале - одна из немногих, кто является одновременно автором песен, продюсером и исполнителем. Ее родители три года жили под землей в Иране, когда у них родилась дочь Лале. Они уехали в изгнание, и исход забрал семью через Советский Союз и Германию в Швецию. История о жизни и мужестве, о музыке и самоотверженности. О подарке, который она получила от родителей, и ответственности позаботиться о своей свободе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"700199","ru":"엄마친구 4","en":"엄마친구 4","year":"2018","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/szssOJ10ZixWA5gZrfYhdKOI0SZ.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"485470","ru":"착한 형수2","en":"착한 형수2","year":"2017","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/3pEs4hmeHvTAsmx09whEaPDOQpq.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"542603","ru":"Minutes","en":"Minutes","year":"2017","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/3MzlpJR8GlqMxeCIxvvXB7HIqYl.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"486912","ru":"Cô Ba Sài Gòn","en":"Cô Ba Sài Gòn","year":"2017","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/vv8JfnN1ljrB1BvI7Ob9ZNrVgpb.jpg","genres":["драма"],"overview"