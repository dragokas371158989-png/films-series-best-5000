db.org/t/p/w342/iD3xXWqEXdpEl6M3cmgUOHmbOTO.jpg","genres":["боевик","драма","фэнтези","ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"748917","ru":"பிச்சைக்காரன் 2","en":"பிச்சைக்காரன் 2","year":"2023","type":"Фильм","rating":4.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/sZ6b5VYTZRFI1Q66tsOQXKokre7.jpg","genres":["боевик","драма","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"172752","ru":"Оплата по факту доставки","en":"與鴨共舞","year":"1992","type":"Фильм","rating":4.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/dVRqxYjfdiEFblniI2SH9v3KgBc.jpg","genres":["драма","комедия","мелодрама","криминал"],"overview":"Элитный жиголо Саймон давно отошел от дел и зарабатывает на совладении ночным клубом, в котором когда-то работал. Но жене богатого бизнесмена, которая ищет себе идеального мужчину для того, чтобы забеременеть, нужен именно он и Саймон соглашается провести с ней три дня. Однако влюблен он совсем в другую женщину — в скромную и неуклюжую помощницу прокурора.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"344276","ru":"Бесчеловечные","en":"Inhumane","year":"2018","type":"Фильм","rating":4.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/5XQid2cGPMak3ZSWj0vfZEJzdT2.jpg","genres":["триллер"],"overview":"В секретном правительственном учреждении ученый, занимающаяся психологией поведения человека, проводит экспериментальные испытания медицинского препарата на группе заключенных, чтобы выяснить, что послужило причиной такого их агрессивного поведения.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"635737","ru":"В поисках древнего артефакта","en":"Devil's Revenge","year":"2019","type":"Фильм","rating":4.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/wGNA3vTrsIQxnZWujWaxhpagz8l.jpg","genres":["ужасы"],"overview":"Неудачливый археолог возвращается из экспедиции в пещеру, где обнаружил проклятую реликвию, являющуюся, к тому же, порталом в ад. Единственный способ остановить проклятие, угрожающее его семье - вернуться в пещеру и уничтожить реликвию.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"271116","ru":"Devil Angel","en":"Devil Angel","year":"1995","type":"Фильм","rating":4.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/k7hbB1jGtUgVeVjFHKQbjYxPLLD.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"446594","ru":"96 Souls","en":"96 Souls","year":"2016","type":"Фильм","rating":4.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/bN98WDPCKtewXT8sfJgD8sGM5fk.jpg","genres":["драма","детектив","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"282907","ru":"살인자","en":"살인자","year":"2014","type":"Фильм","rating":4.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/wSwaVUeg2u7HnqPJTJO0z6FS3er.jpg","genres":["криминал","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"507781","ru":"A Father's Nightmare","en":"A Father's Nightmare","year":"2018","type":"Фильм","rating":4.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/gB0SZcEukr5NQyZ7plLUklrGjbZ.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"861035","ru":"Путешествия Сэмюэля","en":"Sema ceļojumi","year":"2022","type":"Фильм","rating":4.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/7B0kvf63WTJvQeca3l9j0fz5M2B.jpg","genres":["комедия","ужасы","фэнтези"],"overview":"В поисках своего биологического отца приводят иностранца Самуэля в Латвию на опушку таинственного леса, где в момент невнимательности он натыкается на поросенка. Сэм думает, что убил свинью, и пытается зарыть ее в лесу. За ним наблюдает дочь фермера Кирке. Поросенок оказывается не так сильно ранен, и в качестве извинения Сэм подвозит Кирке с поросенком на их ферму. Там Самуэля тепло приветствует семья Кирке, которая приглашает его на ужин и предлагает ему ночлег. Сэм засыпает со спокойной душой, но просыпается на следующее утро прикованным в свинарнике.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1210338","ru":"После родов","en":"Lohusa","year":"2024","type":"Фильм","rating":4.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/5XOLpO3Ugp6c5cklMe71d7hsO1X.jpg","genres":["комедия","мелодрама"],"overview":"Фильм рассказывает забавную историю о матери и отце, пытающихся не отставать от жизни в течение первых 40 дней после рождения ребенка.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"777326","ru":"Честный развод","en":"Честный развод","year":"2021","type":"Фильм","rating":4.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/fFMveFGcAksUapkaQu2NbL44lec.jpg","genres":["комедия"],"overview":"Гена всю жизнь старался быть опорой семьи. Ради этого он даже отказался от бурной молодости и мечты стать звездой КВН. А когда спустя 25 лет жена назвала его скучным и предложила развестись, Гена решает наверстать упущенное — наполнить жизнь приключениями и поехать на фестиваль КВН в Сочи. А подталкивает его к этому путешествию новая знакомая — прекрасная девушка очень легкого поведения. Она уверена, что талантливый Гена с ее помощью очень быстро станет звездой юмора. Если ещё быстрее она не исчезнет вместе с приличной суммой с Гениной карты.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"462035","ru":"Дом демонов","en":"House of Demons","year":"2018","type":"Фильм","rating":4.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/4TbNaM6roe5varLmhe9afv2TmXX.jpg","genres":["драма","триллер","ужасы","фантастика","фэнтези"],"overview":"Четверо отчужденных друзей встречаются впервые за долгое время и проводят ночь в отдаленном загородном доме. Ночь становится всё глубже, и странные ритуалы старого дома отчётливо показывают связь между прошлым, настоящим и подсознанием, заставляя всех персонажей противостоять самым жутким тайнам и самым темным демонам.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"400823","ru":"덫, 치명적인 유혹","en":"덫, 치명적인 유혹","year":"2015","type":"Фильм","rating":4.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/1MQ21P4Lf0tPh5C1F7zQiM0qrqH.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"474883","ru":"A Swingers Weekend","en":"A Swingers Weekend","year":"2018","type":"Фильм","rating":4.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/6TIWy1fAQimgToNDVX1Umc4RhNG.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"957691","ru":"Место","en":"Kaliwaan","year":"2022","type":"Фильм","rating":4.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/6of9dZ3RAF445ruhAfKHRtwQbSk.jpg","genres":["триллер"],"overview":"Буги чуть не убивает мужчину, с которым переспала его девушка Моника. Его дядя-полицейский помогает ему скрыться, но семья его жертвы, не подозревая об этом, берет правосудие в свои руки.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"328950","ru":"Synapse","en":"Synapse","year":"2021","type":"Фильм","rating":4.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/slLEH1tVrU7FUmIjFKdviQY4dFe.jpg","genres":["фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1002317","ru":"屍房菜","en":"屍房菜","year":"2023","type":"Фильм","rating":4.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/86uemBppO7f0fb4zYIDZ2yoZGsL.jpg","genres":["фэнтези","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"420538","ru":"Миссис К","en":"Mrs K","year":"2017","type":"Фильм","rating":4.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/37PfiOrrDnhmkZ8h9KGm7GtT4Fw.jpg","genres":["боевик"],"overview":"Миссис К — образцовая жена, заботливая мать и безупречная домохозяйка. Мягкая, спокойная и доброжелательная женщина. Но однажды в её доме появляется неприятный человек (в прошлом, продажный коп), который шантажирует героиню тем фактом, что много лет назад она якобы принимала участие в ограблении большого казино в Макао. Избавиться от шантажиста — для человека с подобной репутацией дело пустяковое, но вскоре выясняется, что он далеко не один. Люди из прошлого Миссис К возвращаются в её жизнь, и эти люди отчаянно хотят крови и возмездия.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"270417","ru":"The Xposé","en":"The Xposé","year":"2014","type":"Фильм","rating":4.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/banahHkzFfTQlIriqTbmxw3xvRc.jpg","genres":["триллер","драма","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"467245","ru":"Freiheit","en":"Freiheit","year":"2017","type":"Фильм","rating":4.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/kb3YGEQjWqUEs2BM93P1Hoivmtd.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"750109","ru":"АНОНИМНЫЕ УБИЙЦЫ","en":"Anonymous Killers","year":"2020","type":"Фильм","rating":4.4,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/6C2muTLNRC0v56t74vsD0edO2gg.jpg","genres":["криминал","ужасы"],"overview":"Четверо хладнокровных убийц и один незадачливый профессор оказываются в лапах таинственного похитителя. Все они стали частью его безумного эксперимента.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"736593","ru":"Побег Акиллы","en":"Akilla's Escape","year":"2021","type":"Фильм","rating":4.4,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/7RxwJNfqepJav2SSEi5EstoofVy.jpg","genres":["криминал","драма","триллер"],"overview":"40-летний торговец наркотиками Акилла Браун во время передачи товара покупателю попадает в эпицентр жестокого ограбления. Ему чудом удаётся выжить в перестрелке благодаря тому, что он берёт в заложники одного из членов банды — подростка по имени Шеппард. Вместе с ним Акилла сбегает и попадает в ещё более затруднительную ситуацию. Ограбление вешают на него, а подросток, который оказался в его власти, связан с криминальной группировкой, от которой сам Акилла пострадал в детстве.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"958055","ru":"Habib, la grande aventure","en":"Habib, la grande aventure","year":"2023","type":"Фильм","rating":4.4,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/rtMEBBhetvWerU7ChZPuaUUurFd.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1024601","ru":"May the Best Wedding Win","en":"May the Best Wedding Win","year":"2023","type":"Фильм","rating":4.4,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/y4jHN5hE5Xb93LRSTyk06cjRZg8.jpg","genres":["телевизионный фильм","мелодрама","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"270463","ru":"Как я научился любить женщин","en":"Come imparai ad amare le donne","year":"1966","type":"Фильм","rating":4.4,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/zbiosqRrLbxVrtWf1XRspENk8cf.jpg","