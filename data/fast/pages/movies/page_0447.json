0cOjjtKziIE0k.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t6vT1RPpkOj6vjCRox3XGIPhGec.jpg","genres":["Документальный"],"overview":"Всей сушей правит одно скрытое от глаз царство. Царство грибов. Их можно встретить не только в лесу – они повсюду: на наших ногах, в наших легких, чего бы вы не коснулись и куда бы вы не пошли. Окунитесь в мир неизведанных и могучих древних организмов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"402109","ru":"ಗೋಧಿ ಬಣ್ಣ ಸಾಧಾರಣ ಮೈಕಟ್ಟು","en":"ಗೋಧಿ ಬಣ್ಣ ಸಾಧಾರಣ ಮೈಕಟ್ಟು","year":"2016","type":"Фильм","rating":8.3,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/4dImTMse7PPFGHPG6GQuwDng9fB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3TYRiNp9OasTVzueGzwUhng0MdJ.jpg","genres":["Семейный","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1208850","ru":"Битва за Лахад-Дату","en":"Takluk: Lahad Datu","year":"2024","type":"Фильм","rating":8.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/pfYm24JuLhrkwXVqzKVRrSIPBRv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aabJPWLPBPnKQguAsCTpw6lloGx.jpg","genres":["Военный","История","Триллер","Боевик","Криминал","Драма"],"overview":"Фильм снят на основе реальных событий, произошедших в деревне Кампунге Тандуо, Лахад-Дату, когда террористы захватили мирных жителей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1542995","ru":"বনলতা এক্সপ্রেস","en":"বনলতা এক্সপ্রেস","year":"2026","type":"Фильм","rating":8.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/h6nITbbSobZ0EwU6Dcw6LGZOZYA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wUlvM4v5FUjM2omyld9ULVHONZA.jpg","genres":["Драма","Комедия","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1580253","ru":"Hazbin Hotel: Live on Broadway","en":"Hazbin Hotel: Live on Broadway","year":"2025","type":"Фильм","rating":8.3,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/