:"","studio":"","country":"","ageRating":""},{"id":"633490","ru":"Safeguard","en":"Safeguard","year":"2020","type":"Фильм","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/yvtSmxGSqBjfSqDEMvgHDlPoLQD.jpg","genres":["боевик","триллер","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"746800","ru":"زنزانة ٧","en":"زنزانة ٧","year":"2020","type":"Фильм","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/uyKtesW2lPI8zN5mS5TQd5dIRcv.jpg","genres":["боевик","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"530707","ru":"День счастья","en":"День счастья","year":"1964","type":"Фильм","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/v17aIu7CvlcBAYxOQHQeBDrsFrI.jpg","genres":["драма","мелодрама"],"overview":"Как правило, жизнь человека — это череда дней, плавно перетекающих из одного в другой. Но иногда случается, что один — самый обычный день кардинально изменяет направление этого размеренного течения. Врач «скорой помощи» ехал в автобусе и встретил прекрасную незнакомку. Под надуманным предлогом познакомился с ней, (они оказались полными тезками: она — Александра Николаевна, он — Александр Николаевич), потерял в толпе, и с тех пор всегда искал встречи с ней… Выдающийся геофизик, муж Александры Николаевны, не поехал в очередную экспедицию, остался дома с женой, устроив себе «день счастья», и потерял работу…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"874930","ru":"封神·托塔天王","en":"封神·托塔天王","year":"2021","type":"Фильм","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/iA5wDhduS8Kk790fYxyO4KEm2ZA.jpg","genres":["боевик","фэнтези","приключения"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"347091","ru":"Тайна тёмной комнаты","en":"Тайна темной комнаты","year":"2014","type":"Фильм","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/fr4sH1bIpmvRSYD5EJbtgemOCFj.jpg","genres":["приключения","семейный","фэнтези"],"overview":"Два школьника решают исследовать таинственное окно, появляющееся на стене их дома в полночь во время полнолуния. Проникнув туда и оказавшись в тёмной комнате, они и не подозревают, какие приключения ждут их впереди…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"888009","ru":"地下鉄連続レイプ ＯＬ狩り","en":"地下鉄連続レイプ ＯＬ狩り","year":"1986","type":"Фильм","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/aMg4eM8dXZF7a5bNUSIMh8nV2z4.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"267188","ru":"Ветры пустыни","en":"Desert Winds","year":"1994","type":"Фильм","rating":5.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/vvceS641s5Sh4ec660nhnMXHnh2.jpg","genres":["драма","детектив","мелодрама"],"overview":"Спустя годы герой возвращается на родину законченным скептиком. Встреча с прошлым и прежней возлюбленной заставляет вновь поверить в себя. Но хватит ли у героя сил удержать любовь и не остановиться на полпути...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}