ps://image.tmdb.org/t/p/w342/u31gTcLUmEhZj9ER2c6U2VkplqQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/23iAtUYR3e6GQS2wjO3u6N9WroT.jpg","genres":["триллер","криминал","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"248384","ru":"Drunktown's Finest","en":"Drunktown's Finest","year":"2014","type":"Фильм","rating":6.1,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/oiLQSsu36GARJcj9eNcJgwPMLK5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8xH6vRtrtobCRipaFxQrXvNmBZM.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1127839","ru":"Раптус","en":"Raptus","year":"2025","type":"Фильм","rating":6.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/smQ8S7lvbBR8as0vE7XK5Aj6C5H.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9x19wAV50yJ0J80jf1xHtju7O9o.jpg","genres":["триллер","фантастика","ужасы"],"overview":"Однажды утром Сара становится жертвой нападения во время своей обычной пробежки. Прошел год, но ужасные воспоминания не отпускают ее. По совету психотерапевта она соглашается на необычный метод лечения — специальный «комфортный» робот должен помочь ей постепенно избавиться от неконтролируемых флэшбеков. Так в жизни Сары появляется андроид по имени Раптус. Сначала он становится для неё поддержкой и надёжным компаньоном, но со временем терапия перестаёт давать ожидаемый результат. В стремлении преодолеть собственный страх Сара начинает испытывать границы отношений с Раптусом. Но игра с границами перерастает в опасную спираль, и теперь ей придётся собрать все внутренние силы, чтобы выжить…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1302865","ru":"Девушка, запертая наверху: История Тани Кач","en":"The Girl Locked Upstairs: The Tanya Kach Story","year":"2024","type":"Фильм","rating":6.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/o7AkATnfNOzuDgdpH2BVazCT1VM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1vy6QObLvcjnr6aTBHzWgIC3PbV.jpg","genres":["криминал","драма","телевизионный фильм"],"overview":"Одинокая 14-летняя Таня Кач знакомится с охранником школы Томом Хоузом, которому удается заманить Таню к себе домой и удерживать ее в плену более десяти лет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"731169","ru":"Очень большая любовь","en":"月半爱丽丝","year":"2020","type":"Фильм","rating":6.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/1VZ4RE0nVojlMbPgn0CQ9g3AsFy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iQz2BAh9QsVIo5e43aRYU6pbtlP.jpg","genres":["мелодрама","комедия"],"overview":"Линь Сяоси управляет фотостудией и в свободное время следит за жизнью звёзд. Всё в жизни девушки идёт хорошо, кроме одного факта — она очень любит покушать. В целом ей это не мешало, пока ее любимый актер не сказал, что будь она худее, он бы даже мог обратить на нее внимание. Вскоре Сяоси находит волшебный эликсир, способный творить чудеса. С помощью него девушка меняет свое тело и решает покорить сердце звездного актера, но вместо этого оказывается в центре любовного треугольника.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1200049","ru":"Доктор Кто: Далеки (в цвете)","en":"Doctor Who: The Daleks in Colour","year":"2023","type":"Фильм","rating":6.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/p8nWWfFSAwiWURm1UpphtZbCB5U.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ecBGu4lwQ6ogcNqJkXELlZRyN3m.jpg","genres":["фантастика","драма","приключения","телевизионный фильм"],"overview":"Самая первая команда ТАРДИС приземляется в окаменелом лесу на чужой планете. Будучи преисполнен решимости исследовать, Доктор ведет своих товарищей в металлический город, где они обнаруживают опасность на каждом шагу и то, что станет его самым смертельным врагом... мутантами-далеками. Пришло время снова встретиться с далеками, но на этот раз такими, какими вы их никогда раньше не видели. Семь оригинальных эпизодов первой истории далеков, первоначально транслировавшиеся с декабря 1963 года по февраль 1964 года, получили космический облик, стали ослепительно красочными и сплелись вместе в 75-минутный блокбастер с совершенно новым звуком и совершенно новой музыкой, созданной Марком Эйресом. . Далеки были великолепно обновлены, при этом оригинальная история остается такой же захватывающей, как и в 1963 году.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1329189","ru":"Leo & Lou","en":"Leo & Lou","year":"2025","type":"Фильм","rating":6.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/xCvaBdv8f9fDMNoBhm0hbQ2nZan.jpg","backdrop":"https://image.tmdb.org/t/p/w780/66Pg2wfKvnKYR9akKoA5RlOKHyf.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"934039","ru":"Tag min hånd","en":"Tag min hånd","year":"2022","type":"Фильм","rating":6.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/yQcag8x0CaUJLFqbt1lGFvD0Rcm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wHzDWM70NGfKdtamwLkPqECqJ3A.jpg","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1499082","ru":"निशानची","en":"निशानची","year":"2025","type":"Фильм","rating":6.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/aDI8pTr7QDs1QnDKCKsAoEampZj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/asjK0Ot5ocLt7ZErj9wwA17BPsr.jpg","genres":["криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1337636","ru":"Autos, Mota y Rocanrol","en":"Autos, Mota y Rocanrol","year":"2025","type":"Фильм","rating":6.1,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/hAasOVaSrKDqnPoOkExRQ5pcDVy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/reKEqs6nT2zQxI7la8YakPsKLOk.jpg","genres":["музыка","комедия","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"