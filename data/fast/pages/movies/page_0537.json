кс и говорит Джеймсу, что он прибыл из будущего, чтобы помешать злому профессору Апокалипсису захватить мир вместе со своим коварным роботом-разрушителем РобоКотом. Теперь с помощью Рекса и РобоРекса Джеймс отправляется в героическое и душераздирающее приключение, чтобы спасти будущее!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"409387","ru":"Секс: отношения, а не брак","en":"정사: 결혼 말고 연애","year":"2016","type":"Фильм","rating":6.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/j3gFifMCgyIF63AI69HzDW6Cj9X.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6zto711okJGIL9a7hZw4efJslZC.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"410200","ru":"Hello Destroyer","en":"Hello Destroyer","year":"2016","type":"Фильм","rating":6.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/rJtISVqMN10eIkX3jUaPuoDG7wV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fhE90m1nBtFc0GuwYpEqE08Z4R1.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"588775","ru":"Mommy Group Murder","en":"Mommy Group Murder","year":"2018","type":"Фильм","rating":6.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/bcKc8PoskX2B1i7siYL4bVo9QQO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7imqKK2zBaMt89APTrhxu6JOgSa.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"503352","ru":"#TemanTapiMenikah","en":"#TemanTapiMenikah","year":"2018","type":"Фильм","rating":6.6,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/x1jX50Hd3r1zWnLrKLXTYOxYkZO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bpxvhn6WgO9qjQpWXqwx8yDeZdf.jpg","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"355518","ru":"We Are Blood","en":"We Are Blood","year":"2015","type":"Фильм","rating":6.6,