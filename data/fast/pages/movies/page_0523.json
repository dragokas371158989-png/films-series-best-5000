{"tab":"movies","page":523,"pages":899,"count":53936,"pageSize":60,"items":[{"id":"862435","ru":"Цветы и мёд","en":"Flowers & Honey","year":"2021","type":"Фильм","rating":6.8,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/zjvlqVj9Jqx9aOcD3y2BQIC52Y7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zV9A6nlvSS8rDJrxMRmZAk8qQY1.jpg","genres":["телевизионный фильм","мелодрама"],"overview":"Сара работает флористом и очень любит своё занятие, но её жизнь кардинально меняется, когда тётя оставляет ей после смерти загородное ранчо. Сначала девушка не уверена, как хочет поступить с наследством, но с каждым днём, проведённым в этом райском месте, она всё больше влюбляется в него.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1241693","ru":"दो दीवाने शहर में","en":"दो दीवाने शहर में","year":"2026","type":"Фильм","rating":6.8,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/pJu9oL6ElIaajAjwgoKyUCM319H.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tAh0dkZiOSICkRlv9wXOsvcNl4s.jpg","genres":["мелодрама","драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"957492","ru":"Cypress Hill: Insane in the Brain","en":"Cypress Hill: Insane in the Brain","year":"2022","type":"Фильм","rating":6.8,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/cW4knlnZ9vvfGznMBI1mIvZQDan.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aN31B2SGbxfn1JdyFPj732er8kd.jpg","genres":["документальный","музыка","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1320917","ru":"Subsuelo","en":"Subsuelo","year":"2025","type":"Фильм","rating":6.8,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/vnC4Ld6QOzxyO5FFzdGPjs5Czb0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bmfmhhmPUMCJjVttB7dsSlRgcYg.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1319738","ru":"向阳·花","en":"向阳·花","year":