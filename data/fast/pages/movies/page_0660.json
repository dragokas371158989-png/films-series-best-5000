42/hHtJhevKKC3ZNPslcojfLMecYjo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hPdyCICjKcTC7k78YoFQIW5Jlr9.jpg","genres":["комедия","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"267458","ru":"Час призраков 2","en":"ตีสาม คืนสาม 3D","year":"2014","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/jIRjsy7mJCfXTUqQ4ONdQJgHFPP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vJ9OyASAuR5ignYp8ILS05sa59E.jpg","genres":["триллер","ужасы"],"overview":"«Третья ночь». Он был крутым парнем, который держал в страхе весь район. После его гибели, кто-то начал клеиться к его красавице жене. Какое безрассудство! Ведь он был так ревнив при жизни. На третью ночь после смерти он вернулся!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"400252","ru":"Доказательства правды","en":"Evidence of Truth","year":"2016","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/fLxa6227CBx78nNGdn5gleSt5u1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hgaPrjMyqHQHaXxLwPq1k5Tpz24.jpg","genres":["детектив","криминал","триллер","драма","телевизионный фильм"],"overview":"Эксперт-криминалист начинает подозревать, что её муж — серийный убийца, которого разыскивает полиция. Она и её бывший парень, а также детектив полиции, начинают идти по следу, но оказываются в смертельной опасности...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"313755","ru":"Черный принц","en":"The Black Prince","year":"2017","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/ulrxkxWFvBN2QnFxmypVAXBOOVj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Ab42TXkZ0kFC6gaamVhVN6vp10S.jpg","genres":["история","драма"],"overview":"Это история отношений королевы Виктории и последнего короля Пенджаба, Махараджи Далипа Сингха. Когда умер его отец, мальчик принял христианство и переехал в Англию. Однако спустя много лет перед ним встал вопрос - продолжать жить на чужбине, или попробовать поднять сикхов на восстание и вернуть себе трон. Он верит в то, что пророчество великого гуру ему поможет, но вера иногда подводит даже королей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"514222","ru":"Surprise Me!","en":"Surprise Me!","year":"2019","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/yf4ki6seKF9qoLCboCUfa0ntjO8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s0Xo5cgrQ3PNI0sSQci0nm6OaQf.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"339077","ru":"Lovemilla","en":"Lovemilla","year":"2015","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/vzvF2Xm1sekqYu0hwfYgYBtWn8d.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bD1rkZeJl2KsOYpSFhpaRAfa76i.jpg","genres":["фантастика","комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"295111","ru":"Chrieg","en":"Chrieg","year":"2014","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/z2ZLuyj2O3npj2lxBUmzP7uxr10.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kEGjm0BC9SLleWHdLVFV3A9UsE3.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"411041","ru":"ID2: Shadwell Army","en":"ID2: Shadwell Army","year":"2016","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/qVMdkwgBuZt6bDiEYhyRNm471LZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/d5cRtquyDgvEKcV0uD8qsXsxNpD.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"263487","ru":"வடகறி","en":"வடகறி","year":"2014","type":"Фильм","rating":5.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/n59O292K35Q5WAuqwaVwv7BkWm7.jpg","backdrop":"","genres":["мелодрама","комедия","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1150478","ru":"Орел","en":"ఈగల్","year":"2024","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/mjQN27x0Dfkmsi3SRRkAIatOr2p.jpg","backdrop":"https://image.tmdb.org/t/p/w780/njSqJRgV4U9J7u73saYjSbiQ60V.jpg","genres":["боевик","триллер"],"overview":"Сахадев Варма по прозвищу Орел, известный профессиональный убийца, отправляется на задание по пресечению незаконной торговли оружием, выдавая себя за хлопковода в Талаконе и перехватывая все незаконные сделки с оружием оттуда. Журналистка Налини пишет новостной репортаж о Сахадеве, чей редкий хлопок пользуется устойчивым спросом в зарубежных странах. Из-за новостного репортажа ее допрашивают агенты RAW, и она узнает о личности Сахадева, что побуждает ее начать журналистское расследование.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"764842","ru":"Мыслить как убийца","en":"스트리밍","year":"2025","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/yyFYasuBuHqS4EoaNmbLhGdvr80.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9Ifb7kDdMH1yCg81oMoYsK7kDj3.jpg","genres":["триллер","детектив","криминал"],"overview":"Самый рейтинговый стример начинает терять популярность. Чтобы спасти положение, он решает в прямом эфире устроить расследование серии нераскрытых убийств. Собирая улики, парень приближается к раскрытию личности убийцы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"677176","ru":"За чертой закона","en":"Broken Law","year":"2020","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/4x2ewZDsvTxLAnVlhBqvkjx2MwC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4DZxDTZMgmIrqywg7wzvjSv1GAw.jpg","genres":["драма"],"overview":"Дэйв Конноли – уважаемый полицейский, но его верность закону проходит серьёзную проверку, когда его брат Джо, бывший заключенный, попадает в отчаянное положение и нуждается в его помощи.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"817772","ru":"Lust: A Seven Deadly Sins Story","en":"Lust: A Seven Deadly Sins Story","year":"2021","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/pP2sMNwaMrrMSfOuRh9CkUgQmGG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oj9OTuLs0us0R7VmgcqjDPtTdme.jpg","genres":["драма","телевизионный фильм","мелодрама","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1195394","ru":"ടർബോ","en":"ടർബോ","year":"2024","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/CBRqel4Yzm8BS4fTMScYA1fQLD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nn2HYaPRiOytno9pxC652ULRzfU.jpg","genres":["боевик","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"982465","ru":"The Stepmother","en":"The Stepmother","year":"2022","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/mEcNaefZjrPaRYkx6LKwTpUGUEy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8lzZqCOAuwNORVMVH6iVU7QiiYx.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1126094","ru":"Festival of the Living Dead","en":"Festival of the Living Dead","year":"2024","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/85iZ4LWNcsAOZhVxf8xYscDKIQe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ppq8X97QSTUZg7dHKPJL5Xi6wOI.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"420637","ru":"Malibu Horror Story","en":"Malibu Horror Story","year":"2023","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/avx0jbk0DeXkvoD0KXyOSYR1bxE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3eM5Qfvi56y9mVRLUm7x6B90TdE.jpg","genres":["ужасы","триллер"],"overview":""