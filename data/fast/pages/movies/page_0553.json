лок.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"797109","ru":"말할 수 없는 비밀","en":"말할 수 없는 비밀","year":"2025","type":"Фильм","rating":6.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/lxqqFS3W1NsyeAcUVULAxT2jld2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6oNBrQAoGVdP9IeiqYRxSwaTs7c.jpg","genres":["Мелодрама","Фэнтези","Драма","Музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1029475","ru":"1秒先の彼","en":"1秒先の彼","year":"2023","type":"Фильм","rating":6.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/wSzoNNXFTXJ9Jqv59b8YNdqZNh6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/u1lthZLMXuVpkV2mvKV7cNg2TKm.jpg","genres":["Мелодрама","Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"751519","ru":"キネマの神様","en":"キネマの神様","year":"2021","type":"Фильм","rating":6.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/53Tw4usRzHYn9sldE4o1HKpQJMS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kQzTAzS72Itv2NkKsPwnjozrpw9.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1252539","ru":"Chris Rock Total Blackout: The Tamborine Extended Cut","en":"Chris Rock Total Blackout: The Tamborine Extended Cut","year":"2021","type":"Фильм","rating":6.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/25bbEUTfMA79ZL1XSQ9yORuMNoZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l2P0Zt2USv4YSVOC5nvixyIpFEX.jpg","genres":["Комедия","Телевизионный фильм","Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"513146","ru":"Каждый поступок в жизни","en":"Every Act of Life","year":"2018","type":"Фильм","rating":6.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/pYevHgCUAT66xxiEWKjyTr9qdj9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AoRZkszhOFnlG25OV4IySXHaAF6.jpg","genres":["Документальный"],"overview":"Жиз