:"https://image.tmdb.org/t/p/w342/j97EPjQj6APoWbLxDkykN2m78wK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nWUjEWytw4mr9BEkiPhIxof4034.jpg","genres":["Комедия","Мелодрама"],"overview":"Жаркое лето и ласковое море — в Керчи строится Крымский мост. У Димы — молодого и дерзкого строителя — есть хобби: из каждой смены студенток-археологов выбрать самую красивую и именно ее завоевать. И в этот раз случилось бы так же, если бы не московский пиарщик. Он привез на стройку телевизионщиков из Америки, и, конечно, именно он — роскошный карьерист на белом кабриолете — покорит сердце Вари. Или нет? Пока два соперника наперегонки очаровывают её, горячий кавказец Берик (по паспорту Бернард!) пытается реализовать свою мечту — жениться на американке и уехать в Голливуд.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1225048","ru":"Sağ Salim 3: Ölü ya da Diri","en":"Sağ Salim 3: Ölü ya da Diri","year":"2023","type":"Фильм","rating":2.2,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/jeLgDRs67kCsmNcRC5mOqQtW1qI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wFXlMaudoW0XmNwZ5OmTT0xSHHe.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"952733","ru":"Quartz Vein","en":"Quartz Vein","year":"2021","type":"Фильм","rating":2.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/pjBgYNsHpREvBQ1tFcyj976QDiq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sMtFvcLT7eaNC2dNyG0LpXg2y0H.jpg","genres":["Ужасы","Комедия","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1135718","ru":"Bugaw","en":"Bugaw","year":"2023","type":"Фильм","rating":2.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/7pzJmpV56FiNtIFbUq73ytIfutq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qB4Xmelj1mm0rJ9rlNi3o4tvnEV.jpg","genres":["Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1049075","ru"