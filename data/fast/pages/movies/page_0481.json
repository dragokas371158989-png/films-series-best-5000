":7.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/e96r43e8rANqpjJSGTKCFfIDWZq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/31C5zvCAJMbsoAwOFjT43Jlm7px.jpg","genres":["комедия","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"921728","ru":"Аттенборо и Кладбище Мамонтов","en":"Attenborough and the Mammoth Graveyard","year":"2021","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/zJK70Jxl3kkwrAXRKOioSZrloWC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zqXpEGGR6dEFez7RnYV9H71tOS.jpg","genres":["документальный","телевизионный фильм"],"overview":"Сэр Дэвид Аттенборо присоединяется к археологическим раскопкам, раскрывающим крупнейшую находку мамонта в Великобритании почти за 20 лет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"968022","ru":"Marokkaanse bruiloft","en":"Marokkaanse bruiloft","year":"2022","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/bBPsreYOW85GMW5zldguLqR9e2n.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w1J3OLjZSGipcN6z7Plb2X4gahg.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1631346","ru":"Roman Frayssinet : Ô delà","en":"Roman Frayssinet : Ô delà","year":"2026","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/jeFY9hrchhHwZ8cvenu2H0FIvUC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cCyPeisTrGlcsFTjeRJE4XV03iM.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"332995","ru":"Космонавты: как Россия выиграла космическую гонку","en":"Cosmonauts: How Russia Won the Space Race","year":"2014","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/imM8pUcLJimpQySjY5sneJRSJU3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xbKnpXvQ9lavr1q2aq5lNDb63ao.jpg","genres":["документальный"],"overview":"Все мы (британцы) думаем, что знаем историю космоса, что он был покорён американцами. Но это неправда. Настоящими завоевателями космоса была группа отважных мужчин и женщин с другой стороны Железного занавеса. После десятилетий секретности они, наконец, могут поделиться удивительными историями о том, как рисковали всем, чтобы совершить первые шаги в космос. Сокровищница ранее неизвестных видеоматериалов из русских архивов открывает, как снова и снова Советский союз отодвигает более сложную американскую программу на второе место. Но наряду с триумфами, были также трагедии и катастрофы, которые продолжались до настоящего времени. Это - замечательная, и порой пугающая, история космонавтов...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"632701","ru":"The True Don Quixote","en":"The True Don Quixote","year":"2019","type":"Фильм","rating":7.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/oZy6daiVmB8uiOHh0O9w3IsCEUG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l3i81FWQs2OExzXRpIfrZXNFIYC.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1588860","ru":"Happy Ending","en":"Happy Ending","year":"2025","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/wpYoYJ4kWLGhSfS3ofn4xEPJbun.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tRz8qS7zyP5F77zx6X9TY3k6PVE.jpg","genres":["драма","мелодрама"],"overview":"«Я люблю тебя» - именно этих трёх страшных слов боится вечный холостяк Юди. Самые идеальные отношения для него – это ни к чему не ведущие и ни к чему не обязывающие. Но у его девушки Вишакхи, присосавшейся к нему, как пиявка и по пятам преследующей его, совсем иное мнение об этом. Её Юдик-Чудик, должен 24 часа в сутки находится только рядом с ней. Пытаясь избежать чрезмерной навязчивости ненормальной подружки, Юди берётся за первую попавшуюся работу, в которой он должен написать сценарий для помешанного на ромкомах Армана-джи. Ко всему вдобавок, в писательской индустрии у Юди появляется обаятельная конкурентка Ачал, которая путём афёры, начинает наперебой отбивать у него контракты.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1600513","ru":"Терри Джо: миссионерка в Майами","en":"Terri Joe: Missionary in Miami","year":"2026","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/zLBz0HPcial4opOnThYmfW6piOu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dl0pL20Fnk1QpnZI0PCkC8EjEkd.jpg","genres":["комедия"],"overview":"В этом диком фарсе красавица с Юга Терри Джо отправляется в Майами, чтобы сбежать от сумасшедших преступников и найти новую церковь, где она сможет искупить свои грехи.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"621735","ru":"Сын-мать","en":"مادر-پسر","year":"2020","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1QtW4ihEFYDGuFvrPKTm353ftpf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2zCr8aobYIZwMISFC03cdyimvZ2.jpg","genres":["драма"],"overview":"Вдова Лейла работает на старой иранской фабрике, которая скоро закроется. Женщина одна растит двух детей и едва сводит концы с концами. Спасти Лейлу от финансовых проблем может брак с Каземом, но мужчина ставит условие — 10-летний сын Лейлы должен уйти, потому что по местным законам мальчик не может жить в одном доме с дочерью Казема.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1510769","ru":"29","en":"29","year":"2026","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/aQZ4OxzaYTN7cRN7fALi9BhPucp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gzOamXAMuBpWFcCitMdEoAVAjCf.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1466120","ru":"데드 어게인","en":"데드 어게인","year":"2025","type":"Фильм","rating":7.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w34