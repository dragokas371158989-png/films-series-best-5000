ого жениха. У Базарбая есть и младшая дочь, Бегимай, которая дружит с Эсеном, младшим сыном вдовы Дарийки. Но после того, как Базарбай приказывает срубить священное дерево, наступает период раздоров и хаоса. После убийства старшего сына Дарийки, Асана, Эсен вынужден покинуть родину. Случайная встреча с одиноким охотником становится для него поворотной.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"700979","ru":"친구 엄마들","en":"친구 엄마들","year":"2018","type":"Фильм","rating":5.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/cG1hXEWGepEqKSRe2HLL33vvPn8.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"380436","ru":"Von glücklichen Schafen","en":"Von glücklichen Schafen","year":"2015","type":"Фильм","rating":5.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/tp3CJvlEExRU2wgNDV5IBq2zpvU.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"522062","ru":"深夜食堂","en":"深夜食堂","year":"2019","type":"Фильм","rating":5.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/8BPVEbnezgZjnMXPSRnfduvYQNU.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"454917","ru":"كلب بلدي","en":"كلب بلدي","year":"2016","type":"Фильм","rating":5.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/yiK9F5kisD7XGWL1tSe7s77MWUo.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"469885","ru":"시인의 사랑","en":"시인의 사랑","year":"2017","type":"Фильм","rating":5.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/wlrhHRpeMR0GJe1A4G6ddvnniIn.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"461707"