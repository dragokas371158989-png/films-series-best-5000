летний ребёнок, Ти-рекс будет воссоздан как живой — снаружи и изнутри. Используя самые современные техники спецэффектов и прибегнув к помощи почитаемых ветеринарных хирургов, анатомов и палеонтологов, эта передача прольёт свет на последние исследования и открытия о тираннозавре.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1212657","ru":"Antrenamentul de noapte","en":"Antrenamentul de noapte","year":"2023","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1x5X5XdFPJfwF4k3VKhNuYg5hln.jpg","genres":["драма","фэнтези","ужасы","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"685230","ru":"Disturbing the Peace: A Small Town Standoff","en":"Disturbing the Peace: A Small Town Standoff","year":"2020","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1vEJtsACLFSABvaZlBU4wgzBmQL.jpg","genres":["документальный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1613889","ru":"Odonata","en":"Odonata","year":"2026","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hTrBfWDjjNhGU35gjC5mrcNNghx.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1268987","ru":"Mode Avion","en":"Mode Avion","year":"2024","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hgP5CwlsX3Tr5hFGckziPLTNoNw.jpg","genres":["детектив","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1242801","ru":"プロミスト・ランド","en":"プロミスト・ランド","year":"2024","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/gunSxVOfndx92NoYEchPylLr4Vh.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1026579","ru":"Show Business Is My Life (But I Can't Prove It)","en":"Show Business Is My 