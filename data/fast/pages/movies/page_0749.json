льным. С этого момента Эмпар делает всё возможное, чтобы обеспечить покой своей корове, даже если для этого придётся пойти против всей деревни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1604825","ru":"Pocong Merah","en":"Pocong Merah","year":"2026","type":"Фильм","rating":2.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/iENPhqNzsSndVL1M22fGQSEaXHl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5DMEKkNPFzkhbES7j2xtnz0KgwS.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1094482","ru":"わたくしどもは。","en":"わたくしどもは。","year":"2024","type":"Фильм","rating":2.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lmKpwEPdtUnkmoJ1r2mwZ5DMXkQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uUu1TucCAEdvEBVqK9TudahNJwX.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"926577","ru":"바람이 분다","en":"바람이 분다","year":"2021","type":"Фильм","rating":2.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/j3NMUOAoSFvptcmgO2RcypBJF6m.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sn71fgEPZ1qR7KGZ4un7GWrcXsy.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1315794","ru":"ફક્ત પુરુષો માટે","en":"ફક્ત પુરુષો માટે","year":"2024","type":"Фильм","rating":2.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/iJSduZnfkVQwCCfJcVj12RKhmVU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4mKjbOyYxWW7Rwsc8P4vubP6H4F.jpg","genres":["комедия","драма","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1372942","ru":"Chuck Zito: An American Story","en":"Chuck Zito: An American Story","year":"2024","type":"Фильм","rating":2.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/y1EyWmcNGNT4scbUzxssbx2YX6l.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9d8ceZs9nEmQEwr3TdurDLLCM1X.jpg","genres":["