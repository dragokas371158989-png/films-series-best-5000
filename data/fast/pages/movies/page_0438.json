":2,"poster":"https://image.tmdb.org/t/p/w342/rv3FPNcZLp091IAFM4cT4lq0EQu.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1089625","ru":"The Making of the Last Duel","en":"The Making of the Last Duel","year":"2021","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8sJhjZFNwuX18yieuNSAjUwPs9J.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448513","ru":"Цветочная битва","en":"花戦さ","year":"2017","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/6vUL74JoBrj2axu8gAxT4t1uDyp.jpg","genres":["комедия","драма"],"overview":"Фильм снят по одноимённому роману писателя Тадаси Оницука, изданному в 2011 году. Конец XVI века. Япония. После смерти полководца Ода Нобунага люди искусства из Киото были уверены, что в стране наконец наступил мир. К сожалению, правление нового сёгуна Тоётоми Хидэёси показало, что они изрядно поспешили с выводами. После того, как новый правитель велел сделать харакири своему советнику и величайшему мастеру чайной церемонии Сэн-но Рикю, его товарищ — наследник самой известной школы икэбаны Сэнко Икэнобо — решил бросить сёгуну вызов. Он вызвал его на «цветочный» поединок.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"295883","ru":"Camouflage","en":"Camouflage","year":"2014","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/fNjSagpVVvVla395CPQRUimreYV.jpg","genres":["драма"],"overview":"В комедии «Камуфляж» герой Нильсена — частный детектив. Обращаться к нему следует лишь уважительно — мистер Поттер. Если он будет к Вам особенно расположен, то, может быть, позволит называть себя просто Джеком. Удивить его непросто: человек он бывалый и повидал всякое. В его карманной фляге вместо старого доброго виски давно плещется «Пепси», и он всерьез подумывает о том, чтобы «завязать» с частным сыском. Старик Поттер уже собрался навсегда запереть свою контору, когда его начинающий напарник, Марти, расследовавший пустяковое дело в захолустном городке Бивер Ридж, стал невольным свидетелем убийства. Теперь торжественный выход на пенсию придется отложить, чтобы еще раз, как в старые добрые времена, поучаствовать в расследовании с погонями и стрельбой!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"926479","ru":"Tranche de nuit","en":"Tranche de nuit","year":"2020","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/udyrXr6HJQvqT8l1BYFdfM0e6QJ.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"609626","ru":"Голос моря","en":"Голос моря","year":"2018","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/s1XcYosTSVQOw5GpPYuqrJ1eAVO.jpg","genres":["мелодрама"],"overview":"Трогательная история любви глухого рыбака и певицы из прибрежного кафе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"698265","ru":"The Big Night In","en":"The Big Night In","year":"2020","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/9S43Zlp8w1bP1lWk40L8n5apC0K.jpg","genres":["комедия","документальный","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"610761","ru":"The Answer","en":"The Answer","year":"2018","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4kOteG6khbCvzoLGjxKs99XLSTB.jpg","genres":["история","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"491834","ru":"Unbelievable - Credere è complicato","en":"Unbelievable - Credere è complicato","year":"2015","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/t14zqIjAIcnPiXoalIbsgPeaeuB.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studi