ster":"https://image.tmdb.org/t/p/w342/jQbsiPA50F2TRQLYWBIehG3aeuw.jpg","backdrop":"","genres":["вестерн","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"390587","ru":"Tiger Raid","en":"Tiger Raid","year":"2016","type":"Фильм","rating":4.5,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/V61ycPJYjdYadFVVK51xaWYvr8.jpg","backdrop":"","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"271955","ru":"Kadın İşi Banka Soygunu","en":"Kadın İşi Banka Soygunu","year":"2014","type":"Фильм","rating":4.5,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/6YaIw2X5UwHZlQgObCFsLJNQkIZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ncSsbqT6sCpX9d9d5qNaVV8WES0.jpg","genres":["боевик","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"720018","ru":"Колдовство Уиджи","en":"Ouija Craft","year":"2020","type":"Фильм","rating":4.5,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/4BwPmBSmj2cuYxyihOxXc4DFFXC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kUSt5wzCUsmNioHPV24cXoGfpVF.jpg","genres":["фэнтези","ужасы"],"overview":"Потеряв подругу-ведьму в результате несчастного случая, Джесс и Рори решают воскресить девушку с помощью доски Уиджи. После заклинания ожившая Эбби становится чрезвычайно сильной, и теперь хочет навсегда вернуться в реальный мир, даже если для этого придется убить одну из подруг.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"226674","ru":"Подросток","en":"L'Adolescente","year":"1979","type":"Фильм","rating":4.5,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/v7yCEzF9BCF82lbp42X5ZLjIieo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dqmeFUrf6Hs2ejcGGGfv69vtbbR.jpg","genres":["драма"],"overview":"Лето 1939 года. Мари в 13 лет едет со своими родителями навестить свою бабушку в небольшой город недалеко от Авиньона, хотя слухи о войне достигли уже и этого идеалистического места. Родители Мари постоянно заняты друг другом со своей любовью. Окруженная сексуальной откровенностью девочка воображает себя женщиной и сердится, когда молодой еврейский врач Александр относится к ней как к ребенку. Когда отец девочки уезжает из дому к родственникам, Мари замечает, что Александр с ее матерью часто уединяются, и начинает шпионить за ними.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"759917","ru":"요가학원: 죽음의 쿤달리니","en":"요가학원: 죽음의 쿤달리니","year":"2020","type":"Фильм","rating":4.5,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/9lWDGJwLRQv5mzbN9MGvHrpHxJB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oRSOnwDJdGAdxmCiRZ58CALjbuB.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1015381","ru":"Frankie Meets Jack","en":"Frankie Meets Jack","year":"2023","type":"Фильм","rating":4.5,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/h0ya6VyGxtGhl0zx8jN8QiU6X8q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/555P7jpSaasCRjxXdLUFxN9iu7.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}