g":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/pXQyw9MdOu6xO6wAiO0hErVUqge.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1491213","ru":"Wisteria","en":"Wisteria","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/vJpqV4qctkiZ5bhdu2f43EMJhcL.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1361782","ru":"Late Night Lift","en":"Late Night Lift","year":"2024","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/k8oV5LN3ulqo3b9kamEvicLfeVb.jpg","genres":["ужасы","триллер","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1564374","ru":"In The Blink Of An Eye","en":"In The Blink Of An Eye","year":"2005","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/5Wvsc3EUa6XvzcyEj6Z3uJfdBjs.jpg","genres":["драма"],"overview":"Три сюжетные линии, охватывающие тысячи лет, переплетаются и исследуют темы надежды, связи и круговорота жизни.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1484996","ru":"100 Things to Do Before High School","en":"100 Things to Do Before High School","year":"2014","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4yvsG2b5cv9T06UvKUEIUsDvizd.jpg","genres":["семейный","комедия","телевизионный фильм"],"overview":"Си Джей Мартин - необычная девочка, и мечтает она о необычных вещах. Когда её старший брат рассказывает обо всех тяготах старшей школы, Си Джей понимает, что самое важное для неё сейчас – не потерять своих лучших друзей, Фенвика и Кристиана. Ведь кто знает, как изменится их жизнь с поступлением в старшие классы? Друзья решают составить список самых важных дел, которые они обязательно должны сделать в средней школе.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1442569","ru":"дайверы пустыни","en":"Les Plongeurs Du Désert","year":"1952","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/nbt1EIDfHqxlDWYY10xtq5q4ipw.jpg","genres":["драма"],"overview":"Фильм «дайверы пустыни», снятый Тахаром Ханнашем в 1952 году, считается первым полностью алжирским художественным фильмом. Он рассказывает историю жителей оазиса, чей колодец пересох. Старейшина деревни, шейх Мессауд, призывает известных ныряльщиков в пустыне, мастеров, специализирующихся на очистке колодцев от песка и ила, восстановить доступ к жизненно важной воде для общины. После их вмешательства вода снова начинает течь, принося облегчение оазису и его жителям. Фильм показывает контраст между традиционными методами ныряльщиков, олицетворяемыми шейхом Али и его сыном Мансуром, и приходом современности, представленной машинами, которые в конечном итоге вытесняют их ремесло. Эта история символизирует маргинализацию местных знаний перед лицом технического прогресса и социальной несправедливости колониальной эпохи.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1694942","ru":"Acrophobia?","en":"Acrophobia?","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3Juz2SEYQcixs89GHyCM52e99dY.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1653459","ru":"شباب البومب 3","en":"شباب البومب 3","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/vbQ3ikGeeL6A2bVsfbTra1magYI.jpg","genres":["приключения","комедия","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1551580","ru":"Take It Off","en":"Take It Off",