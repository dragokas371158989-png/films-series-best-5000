pisodes":"","studio":"","country":"","ageRating":""},{"id":"635690","ru":"Я дома","en":"집 이야기","year":"2019","type":"Фильм","rating":7.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/346jRgAcT3N03pBwNYI1dGlWRdw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pyjM7LgTSqb6X1SAMYqQJh43pFf.jpg","genres":["драма"],"overview":"Ын Со живет одна, и не очень хорошо общается со своей семьей. Ее родители давно развелись, и никто из родственников не связывается с отцом. Однажды срок ее договора аренды квартиры начал истекать, и Ын Со занялась поиском новой. Вот только она объездила уже больше десятка квартир и ни одна ей не понравилась. И тогда, чтобы хоть где-то остановиться она решила приехать к отцу в город, в котором росла. И именно там она осознала, что она наконец-то дома…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"552500","ru":"PRINCE OF LEGEND","en":"PRINCE OF LEGEND","year":"2019","type":"Фильм","rating":7.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/tSlWOAoRiXKKDjEuxNzFlhLcOCY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1xTs0mSFphv9gTolZaLzFsbQNza.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"603459","ru":"The Long Way Home: Making 'The Martian'","en":"The Long Way Home: Making 'The Martian'","year":"2016","type":"Фильм","rating":7.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/jo4bpujR5acfcJrLkH0TZ3MumjG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nionfsRokOX4CGXN1o8iNlz3EQg.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"452312","ru":"Stayin' Alive: A Grammy Salute to the Music of the Bee Gees","en":"Stayin' Alive: A Grammy Salute to the Music of the Bee Gees","year":"2017","type":"Фильм","rating":7.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2Ik11exkZ9PXSrcZ1nU9q7cgVTs.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pIm9foBNg0v2