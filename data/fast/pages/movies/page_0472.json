ntry":"","ageRating":""},{"id":"338127","ru":"A Nuclear Story","en":"A Nuclear Story","year":"2015","type":"Фильм","rating":7.5,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/a1XYdco19dquOYKZTRtaK1TP6cD.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"373587","ru":"தர்மதுரை","en":"தர்மதுரை","year":"2016","type":"Фильм","rating":7.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/cmSUOVaaaZsQRjSYpkSuWGbDStT.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1417941","ru":"Право на истину","en":"हक़","year":"2025","type":"Фильм","rating":7.5,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/tO7OI5MyzPSiVmlXXnlBKlAJH92.jpg","genres":["драма"],"overview":"Индия, 1980-е годы. После того как муж оставляет Шазию Бано без финансовой поддержки и женится вновь, она решается бросить вызов устоявшимся традициям и системе, в которой голос женщины почти не слышен. Использование тройного талака становится не только личной трагедией, но и искрой, разжигающей масштабные общественные споры о справедливости, религии и правах женщин.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1050281","ru":"Elton John Live: Farewell from Dodger Stadium","en":"Elton John Live: Farewell from Dodger Stadium","year":"2022","type":"Фильм","rating":7.5,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/dbV1dyczIIGHbQIb1IeGTzm5D6a.jpg","genres":["музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"452196","ru":"Невозможно не влюбиться","en":"Can't Help Falling in Love","year":"2017","type":"Фильм","rating":7.5,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/bWTG8X1rd4b4UEhQkWx8WXtmGEd.jpg","genres":["комедия","мелодрама"],"overview":"Главной героине по имени Габ наконец-то делает предложение руки и сердца ее молодой человек Джейсон. Она с радостью соглашается стать его спутницей жизни, и казалось бы, уже ничто не может помешать предстоящим предсвадебным хлопотам и будущей совместной жизни. Но именно сейчас она узнает, что состоит в браке за неким Досом. Габ решает все исправить до своей назначенной свадьбы и поскорее развестись с ним. Однако она и представить не могла, чем все может обернуться.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"859981","ru":"Автобиография","en":"Autobiography","year":"2023","type":"Фильм","rating":7.5,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/3Tczqn7ihj0S8OmyLgFQcRYswnN.jpg","genres":["драма","триллер","криминал"],"overview":"Ракиб приглядывает за пустым особняком. Когда возвращается владелец дома, Пурнавинате, чтобы начать свою предвыборную кампанию на пост мэра, Ракиб соглашается выполнять его задания, в результате чего запускает цепную реакцию насилия.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1424217","ru":"కోర్ట్: State vs. A Nobody","en":"కోర్ట్: State vs. A Nobody","year":"2025","type":"Фильм","rating":7.5,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/4pEX67LJd7ZIqYWtksBtOgQEGcQ.jpg","genres":["драма","мелодрама","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"838145","ru":"कुछ भी न जानने की एक रात","en":"कुछ भी न जानने की एक रात","year":"2022","type":"Фильм","rating":7.5,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/34tv7dVLl1arMD1ZB4v07GYqsAb.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1372028","ru":"Рождество под софитами","en":"Christmas in the Spotlight","year":"2024","type":"Фильм","rating":7.5,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/tMpg5vyBPcMSZqanll4PCdwmmhH.jpg","genres":["мелодрама","телевизионный фильм"],"overview":"Известная певица и звезда футбола начинают встречаться, но их роман подвергается пристальному вниманию СМИ, которы