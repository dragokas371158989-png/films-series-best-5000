ружбу в секрете, о котором однажды узнает заезжий браконьер Седой со своими подельниками. Обманув Тайкэ, они похищают маму Умки, чтобы продать белую медведицу в частный зоопарк. Но храбрый Тайкэ, к которому на помощь придет его семья, сделают все, чтобы спасти и вернуть Умке его маму.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1567149","ru":"仮面ライダーカブト20th 天を継ぐもの","en":"仮面ライダーカブト20th 天を継ぐもの","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/dsFF9fAARz1UlHbtRjlqup356FO.jpg","genres":["фантастика","боевик","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1353077","ru":"Your's Sincerely RAAM","en":"Your's Sincerely RAAM","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/yEDMnig9v99da7eucmX96dcckdz.jpg","genres":["военный","мелодрама","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1422612","ru":"The Giaccomo","en":"The Giaccomo","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/31DK5LclGlYLyO6FFkwBLY5Q39V.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1704309","ru":"Top Cop","en":"Top Cop","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/iG8ngSJgIki4bvlEi5XeBRiXBfW.jpg","genres":["триллер","детектив","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1462060","ru":"إذما","en":"إذما","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/DNIz9Zqg3fOtrzJVcacrMpQoKX.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1516175","ru":"Party USA","en":"Party USA","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://