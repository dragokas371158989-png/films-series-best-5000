нажает перед зрителем душу, не стесняясь интимных и неприятных ситуаций. Он высказывает свои страхи и опасения, делится воспоминаниями, мыслями, фантазиями. Противостояние интеллектуальной мощи и физической хрупкости всю жизнь оставалась отличительной чертой его карьеры.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1255418","ru":"Любопытный ресторатор: Сорванный замысел","en":"Curious Caterer: Foiled Plans","year":"2024","type":"Фильм","rating":7.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/6IEgcgga7LiYBPDohxd07ookmU9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mfkyc9RK72MB5ZLzwqdahNd1Oex.jpg","genres":["телевизионный фильм","криминал","драма","детектив"],"overview":"Средневековый праздник Голди Берри в замке Хайд прерывается убийством. Она объединяется с детективом Шульцем, чтобы раскрыть тайну до того, как убийца нанесет новый удар.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"868578","ru":"龍虎武師","en":"龍虎武師","year":"2021","type":"Фильм","rating":7.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/Yf9qo58jIYxRI32uIZ22RUjUx6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/b37uMr1hvzkcVFcPOfs8D5UypMp.jpg","genres":["документальный","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1602727","ru":"夜王","en":"夜王","year":"2026","type":"Фильм","rating":7.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/yZ8wttKTt6oq8Vc02erb7qBCK5u.jpg","backdrop":"https://image.tmdb.org/t/p/w780/i9ptnJUIQkMqAe2XBDiFYDYEHn7.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1106720","ru":"The Jane Mysteries: Inheritance Lost","en":"The Jane Mysteries: Inheritance Lost","year":"2023","type":"Фильм","rating":7.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/zNOeqjt1mSEdTGB4dI7yw0CiRIZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8U8uaR5t53EVJVfHErIqK1xKGwe.jpg","ge