тся общественная полемика: к сторонникам реформ подключаются Гасан-бек Зардаби, Алимардан-бек Топчибашев, Ахмед-бек Агаев и прогрессивное духовенство во главе с ахундом Мирзой Абутурабом. Конфликт обостряется до нападений на учителей в Баку. Гаджи меняет тактику и отправляет моллу Мирзу Мухаммед-оглы в поездку по семи пунктам назначения.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1672950","ru":"Sebelum Garis Terbentuk","en":"Sebelum Garis Terbentuk","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/2Ko9Ebdp0afMsb9UoV31SQfVYgc.jpg","genres":["история","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1661007","ru":"관리처분계획—미아리 텍사스 편","en":"관리처분계획—미아리 텍사스 편","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/6E5UAFryZaeZJDUCUHHM5V3D50Y.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1705053","ru":"Ancient Land","en":"Ancient Land","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/r9mSmH583g4djwjUyJ5fTIIk8cp.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1702483","ru":"A MINHA HISTÓRIA JÁ FALA POR MIM","en":"A MINHA HISTÓRIA JÁ FALA POR MIM","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/4EYK9kpQYzZMO4TyQJfwBw0CfBd.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1681439","ru":"If I Can't Have U, No1 Can","en":"If I Can't Have U, No1 Can","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/Anv15OCr6Z6ZAtauBTkg6uc047Q.jpg","genres":["триллер","мелодрама","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id"