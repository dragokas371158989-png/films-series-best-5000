я и открывая маршруты чрезвычайной сложности, которые и сегодня считаются абсолютными: восточная стена Гранд-Жорасс (вместе со своим другом Боккалаттом), северо-восточный отрог Эгюий-Нуар-де-Пётере, северная стена Гранд-Жорасс, маршрут Джервасутти на Гульермине, восточная стена Монблана-дю-Такуль (где он погиб в 1946 году), а также невероятный список восхождений. Фильм, снятый к столетию со дня рождения Джусто Джервасутти, изображает одинокого и измученного горца, обладающего безупречным чувством морали, сторонника легкого и этичного альпинизма, всегда стремящегося к недостижимому счастью.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"430782","ru":"A Venture in Faith: The History and Philosophy of the Calvary Chapel Movement","en":"A Venture in Faith: The History and Philosophy of the Calvary Chapel Movement","year":"2007","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/dlFlLqbVFx3SYFOtPMrBT9w4KVd.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"417909","ru":"铠甲勇士之雅塔莱斯","en":"铠甲勇士之雅塔莱斯","year":"2014","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/2OFDCSSjjLm8AZ6hluwFtyNPuNK.jpg","genres":["приключения","боевик","драма","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"545451","ru":"女人永遠是對的","en":"女人永遠是對的","year":"2017","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/kwOig66eB4wV5XECfpDCIJmtKI8.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"338601","ru":"Tadaima","en":"Tadaima","year":"2015","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/kBOm1XXODboyem2wUEEHWy5RNN8.jpg","genres":["драма","семейный"