io":"","country":"","ageRating":""},{"id":"977156","ru":"Астрал. Кошмар в «Спринг Гарден»","en":"늘봄가든","year":"2024","type":"Фильм","rating":4.5,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/61RPfZBQGVYEzFwTvLfzoRggFNR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hf368DJjkostZg2EjxiHu10jUE5.jpg","genres":["Ужасы","Триллер","Драма"],"overview":"После трагической гибели мужа Со-хи переезжает в особняк «Спринг Гарден», который хранит память о ее супруге. Женщина обнаруживает в доме фотографию незнакомки и решает ее найти. Но все, кто знал таинственную девушку, начинают умирать при загадочных обстоятельствах. Полиция подозревает Со-хи, а та, в свою очередь, понемногу приоткрывает завесу окружающей дом тайны.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"998282","ru":"Tahan","en":"Tahan","year":"2022","type":"Фильм","rating":4.5,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/1Sw6z9G2dDomgYx5J3clcwZ7TMi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e82006WGClYA5JYK4BmubqAoHYT.jpg","genres":["Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"751163","ru":"Magnezja","en":"Magnezja","year":"2021","type":"Фильм","rating":4.5,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/bZhJ6JzDToJ4RVtsqj6yHuiz6Mp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/liC36sgu7k6PYAJA5BLGtpAgWc9.jpg","genres":["Криминал","Боевик","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1199206","ru":"Among Wolves","en":"Among Wolves","year":"2023","type":"Фильм","rating":4.5,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/yY8AWqYyPPmm1HhF80xaQ9ILSUU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7VO1gcN8zbyXsQN2DSyuib3btjW.jpg","genres":["Вестерн"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"967549","ru":"La Nuit du verre d’eau","en":"La Nuit du verre d’eau","year":"2023","type":"Ф