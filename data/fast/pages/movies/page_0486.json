rt Films","en":"Modern/Love in 7 Short Films","year":"2019","type":"Фильм","rating":7.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/faxiYuaoVS6f5Zsu293tV0beeWW.jpg","backdrop":"","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"292140","ru":"అనుక్షణం","en":"అనుక్షణం","year":"2014","type":"Фильм","rating":7.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/hqmQddsROslZHobPG9vIp51pf4j.jpg","backdrop":"","genres":["Криминал","Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"538947","ru":"犯罪資料館 緋色冴子シリーズ『赤い博物館』","en":"犯罪資料館 緋色冴子シリーズ『赤い博物館』","year":"2016","type":"Фильм","rating":7.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/8ZmqphE2Ab0QCW21dX8bLX2InDa.jpg","backdrop":"","genres":["Детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"827276","ru":"Private Screenings: Robert Osborne","en":"Private Screenings: Robert Osborne","year":"2014","type":"Фильм","rating":7.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/vqqyOERUtjtXy8zFWZAYe9mYNSc.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1035573","ru":"Volshebniki","en":"Волшебники","year":"2022","type":"Фильм","rating":7.3,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gqboRZX1i51qvFQEiVeDYuVH6rX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pwZ6KeiIU7p4259okFYm814vCvj.jpg","genres":["Семейный","Фэнтези"],"overview":"13-летний московский школьник Артем обнаруживает в школьном шкафчике таинственный коробок спичек, которые, как выясняется, способны исполнять любые желания. Выдумщик Артем не упускает шанс стать настоящим волшебником и дает волю своей безудержной фантазии. Ломается спичка, - и по московскому бульвару шествует слон. Ломается другая, - и вся улица против своей воли отплясывает безумный танец. Позже Тема знакомится с загадочной Девочкой-волшебницей, которая и подбросила ему коробок. Вместе они парят в усеянном звездами небе, без акваланга спускаются на морское дно, путешествуют по мирам фантазий и воспоминаний… Теме открываются поистине бескрайние возможности спичек. Однако у всего есть своя цена.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1250852","ru":"గీతాంజలి మళ్లీ వచ్చింది","en":"గీతాంజలి మళ్లీ వచ్చింది","year":"2024","type":"Фильм","rating":7.3,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/d7qcKJjVyEKKIFuwAAqhjb9RASQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tjinNF7YNzXMUjCXu5tG4XNHstW.jpg","genres":["Комедия","Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"346662","ru":"Treurgrond","en":"Treurgrond","year":"2015","type":"Фильм","rating":7.3,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gxkudIFn1rC4FI2lQ70xgi3BoTz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7uGTOcf857kI9lj3bpQpbAxTr59.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1255065","ru":"談判專家","en":"談判專家","year":"2024","type":"Фильм","rating":7.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/lIc7ESSLGNIgaJc3vcPCTUv8oVf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6NDYDhszKSHdAXDY2IG3nBXSQp8.jpg","genres":["Боевик","Криминал","Детектив","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}