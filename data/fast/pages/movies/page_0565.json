ce":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"806495","ru":"Fellinopolis","en":"Fellinopolis","year":"2021","type":"Фильм","rating":6.2,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/qA3WQU0sE5lCKsKS2O8hwmillOX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sFgiwjr70n4L0SCBVv8I8NBZ5nA.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"882995","ru":"A Furry Little Christmas","en":"A Furry Little Christmas","year":"2021","type":"Фильм","rating":6.2,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/zNp1gPczg56bfzrwkZhhe6uf30U.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fX6dK4rm6T6mCugnSDheo4il45n.jpg","genres":["Телевизионный фильм","Комедия","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"457847","ru":"Жги!","en":"Жги!","year":"2017","type":"Фильм","rating":6.2,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/lFLizroEAVuUm6ps5obmdZciO8y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lDTjlBr4QqeXkEIQt54grMwuUHs.jpg","genres":["Драма"],"overview":"Алевтина Романова служит надсмотрщицей в женской колонии. Из образа строгой надзирательницы выбивается лишь одно — ее голос, которому позавидовала бы самая знатная оперная звезда. Но от карьеры певицы она отказалась еще в далеком детстве и теперь, лишь изредка, когда никого нет рядом, поет для самой себя. Но как бы Ромашка, как ее шутливо называют друзья, не старалась оставаться незаметной, одна из заключенных тайно записывает ее на телефон и выкладывает видео в интернет. Запись моментально становится сенсацией. Алевтину приглашают в Москву для участия, в главном песенном шоу страны. В героине просыпается искреннее желание изменить свою жизнь, но она совершенно не готова к конкурсу. Единственным человеком, способным помочь ей подготовиться к выступлению становится та самая заключенная, в прошлом певица.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"175983","ru":"Finishing School","en":"Finishing School","year":"1934","type":"Фильм","rating":6.2,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/6mTMbv2A60vQtFY0YqEX9olS78o.jpg","backdrop":"https://image.tmdb.org/t/p/w780/h0BZHoel88oviWWCf9yGRRJPpbT.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"403667","ru":"Adios Amigos","en":"Adios Amigos","year":"2016","type":"Фильм","rating":6.2,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/euoh5XsnHr4trQVsFprCGSnsrRQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1gbSjMn5pCdanQmSGwX5lmzJzfu.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"551634","ru":"你好，之华","en":"你好，之华","year":"2018","type":"Фильм","rating":6.2,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/cK7eDvsclO3rgCFAnusORRknlS8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lZgwEoxr0y9ZyT1ilOsgvexQe6Z.jpg","genres":["Мелодрама","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"717088","ru":"Неспящие в Сеуле","en":"싱글 인 서울","year":"2023","type":"Фильм","rating":6.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/pZX0A8RIWyM2o9oKnK39updMmL7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vuzeJRtnz1MCmMgCwHXURtmw1CW.jpg","genres":["Мелодрама","Комедия"],"overview":"Пак Ён-хо — популярный лектор и инфлюэнсер, и он обожает жить один. Однажды судьба сводит его со знакомой по университету, которая работает редактором издательства, и ей нужен автор для книги «Одинокие в Сеуле».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"964851","ru":"Ракета","en":"Ohjus","year":"2024","type":"Фильм","rating":6.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/d3polwgyZUDY216HY5W729bXnRV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kQ2W8Llc3gPM0WBXDxXCvNnDEDD.jpg","genres":["Драма","Комедия"],"overview":"В декабре 1984 года в Финляндии посреди глуши приземлилась советская крылатая ракета, однако финское правительство не спешило разглашать подробности инцидента. Ниина, репортёр небольшой газеты, оказывается втянута в расследование падения ракеты. Но ей придётся постараться, чтобы привлечь внимание местных жителей к случившемуся, ведь даже угроза ядерной войны их едва ли волнует.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1056740","ru":"Снежный роман","en":"Love in Glacier National: A National Park Romance","year":"2023","type":"Фильм","rating":6.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/xXVMsrsPwvRcyRZiYuTtZ9PAflc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jeRWmDZeYqnIkKDycN6B5kzHbVb.jpg","genres":["Телевизионный фильм","Комедия","Мелодрама"],"overview":"Эксперт по прогнозам лавинной опасности приезжает с новой программой в Национальный парк Глейшер, но директор горноспасательной службы отрицает технологии, доверяя лишь своей интуиции.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"511424","ru":"Мой моряк, моя любовь","en":"My Sailor, My Love","year":"2022","type":"Фильм","rating":6.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/lzwxc18l44kcUTIfd0XyWRSqiZN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pcwvKDQWBxoKScRDoe6DHtecOcC.jpg","genres":["Драма","Мелодрама"],"overview":"Говард — отставной моряк и вдовец, живущий в доме у моря. Его взрослая дочь Грейс нанимает пожилую женщину Энни, чтобы она присматривала за отцом. Однако закрытый и упрямый Говард сначала отвергает компанию Энни, но в конце концов открывает свое сердце и дает шанс своей последней любви. У Грейс есть свои проблемы, с которыми нужно справиться, и роман ее отца оказывается для нее трудным. Новая любовь ее отца напоминает Грейс о привязанности, которой ей не хватало в детстве, а теперь снова во взрослой жизни. Теперь Энни предстоит разобраться с непростыми отношениями отца и дочери, а Говарду и Грейс придется смириться со своими недостатками.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"920095","ru":"L'Invitation","en":"L'Invitation","year":"2021","type":"Фильм","rating":6.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/UG6sSMfopwlc0L33uyDwVA6EHU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/biiX0DqVwUfk1cdMOM8ZqAy62lv.jpg","genres":["Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"573801","ru":"Международное расследование","en":"국제수사","year":"2020","type":"Фильм","rating":6.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/7IuoL7QmVgomokCpwmgUz3VmL7w.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yONHElKUF5pLEJFtQX0TUiT4sZy.jpg","genres":["Криминал","Комедия","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"967937","ru":"عمهم","en":"عمهم","year":"2022","type":"Фильм","rating":6.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/uM7cL5jnXvKMHtDploJu30Gfu27.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dHQBsnPOx7eX75cpiNezI7276Om.jpg","genres":["Боевик","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"553469","ru":"Helene","en":"Helene","year":"2020","type":"Фильм","rating":6.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/bX0fGWEKoKOamu1ektyuIxLvyQh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ebuNlSHXHXc8EM26CpPeEYeoniG.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1129123","ru":"High & Low – John Galliano","en":"High & Low – John Galliano","year":"2024","type":"Фильм","rating":6.2,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/x9wmCRczb3iGrWGqnxyIPdJDQfp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/puH2BKhG0bPzK3Oxg4QB93C0i8Y.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","cou