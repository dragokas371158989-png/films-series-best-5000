у и Субару дали обещание стать знаменитыми. Теперь Сидзуку работает моделью, Субару стал актёром, а Ёри - всё ещё обычный старшеклассник в очках. Он решает достичь своей мечты и переводится в школу, где учится Сидзуку, к которой парень неровно дышит.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"452251","ru":"미용실: 특별한 서비스","en":"미용실: 특별한 서비스","year":"2016","type":"Фильм","rating":6.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/z3Vse8jRnmKJyZFK6VSw1G6jHnY.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"338797","ru":"Spanish Western","en":"Spanish Western","year":"2015","type":"Фильм","rating":6.2,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/kAhNXNrUinvxvijxZnHtTXwWhDh.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}