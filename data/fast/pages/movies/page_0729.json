ge.tmdb.org/t/p/w342/bvxLjrgxScuy2oTdAeBsL9n6cpU.jpg","genres":["комедия"],"overview":"Росс и Харпер - молодая пара, живущая в США, но их недолгий роман рушится, когда Харпер депортируют обратно на родину в Канаду. Не желая вступать в брак, Росс решает найти фиктивного мужа, чтобы Харпер смогла снова вернуться в страну.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1181692","ru":"War of the Worlds: Extinction","en":"War of the Worlds: Extinction","year":"2024","type":"Фильм","rating":3.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/tRLTw0bWIoHmgaEMk3UxoUTp5w.jpg","genres":["фантастика","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"671474","ru":"Bone Breaker","en":"Bone Breaker","year":"2020","type":"Фильм","rating":3.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/ycEeSBcV4jmT0Yf8ERPLtcD58RJ.jpg","genres":["ужасы","триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1075316","ru":"Vacation Home Nightmare","en":"Vacation Home Nightmare","year":"2023","type":"Фильм","rating":3.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/o7w9tDt8kRsI4QvCrjuMnrkRMgp.jpg","genres":["телевизионный фильм","триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"898774","ru":"Amityville Uprising","en":"Amityville Uprising","year":"2022","type":"Фильм","rating":3.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/RrzMH1EOUeuAogTZr1JPHsTAAg.jpg","genres":["ужасы","боевик","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"252728","ru":"Охота за призраком","en":"Охота за призраком","year":"2014","type":"Фильм","rating":3.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/Amt659uWYqbLCZ23BVrbDK9T1K0.jpg","genres":["боевик","фантастика","триллер"],"overview":"Действие истории разворачивается в недалеком будущем. Гениальное изобретение глобальной корпорации, под кодовым названием «GS код» гарантирует искоренение преступности и безопасность во всем мире. Весь мир использует единую систему безопасности GS. Но это только видимая сторона «GS кода»: зловещий план корпорации кроется в установлении тотального контроля над разумом людей, посредством внедрения следующей системы «Фантом». Фантом ключевое звено в цепи событий, достаточно только подключить егок Глобальной сети безопасности GS. Цель корпорации изменить ход истории — получить общество послушных марионеток, которые никогда не узнают, что их разумом управляют. «Фантом» постепенно ломает судьбы людей, но никто не может понять что происходит. До тех пор пока «Фантом» не разрушил жизнь двух влюбленных — Тимура и Киры. Она обвиняется в убийстве, а он должен преступить закон, чтобы спасти ей жизнь. Человек, которого он считал преступником, американский хакер Зак, неожиданно помогает ему","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}