rg/t/p/w342/qoJIySfGDdSzj8JE2NU67Pgx64M.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6TevRjFV0tGusMEZD8IyBNOuaO9.jpg","genres":["ужасы","триллер","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"786303","ru":"മോഹൻ കുമാർ ഫാൻസ്‌","en":"മോഹൻ കുമാർ ഫാൻസ്‌","year":"2021","type":"Фильм","rating":5.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/as5iOtNAxzxqZclt6hNUITrN2qX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9zcZuV4P7wCn5pibLUQFtemSaxA.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"943533","ru":"Stalked by a Prince","en":"Stalked by a Prince","year":"2022","type":"Фильм","rating":5.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/jcw1gEC3b2u54cwIxf5xGdDxntX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sWSs1caDijTgqOmfjKE18AkJZsI.jpg","genres":["триллер","телевизионный фильм","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"470687","ru":"Парижская жизнь","en":"La Vie de Château","year":"2017","type":"Фильм","rating":5.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/kSfcgKBlcefISxt37XqxkkQlnM8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s2tSH8B0FdWFCX5FNqaDA4vsBV7.jpg","genres":["драма"],"overview":"Жизнь у станции метро \"Водонапорная башня\" в рабочем районе Парижа глазами сотрудников и клиентов расположенных там африканских парикмахерских. Шарль по прозвищу \"Принц\" бесспорный лидер среди зазывал потенциальных клиентов. У него есть мечта: когда-нибудь стать владельцем собственной парикмахерской. Но появление в районе новичка с агрессивной политикой по переманиванию клиентов ставит под удар монополию Шарля...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"254155","ru":"Сладкие оправдания","en":"甜蜜殺機","year":"2014","type":"Фильм","rating":5.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6VF1fy7Kb5XTI93OerG8fCgIXgm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dJCXWWCjFS89zRH7XpL7gRG4U9M.jpg","genres":["комедия","триллер","криминал","боевик"],"overview":"Чи-У, долгие годы служащий в полиции, ценит свою безопасность превыше всего, и потому печально известен своей трусостью, мешающей ему нормально выполнять его профессиональные обязанности. И-Пин, напротив, только что закончила полицейскую академию и стремится показать себя на службе с лучшей стороны. Ради этого она готов пойти на любой риск. Отец И-Пин, стремясь уберечь её от опасностей, назначает ей в напарники Чи-У. Кто же мог знать, что взявшись за расследование нелепого несчастного случая, парочка неожиданно получит ключ к разгадке серии загадочных смертей?!..","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"492104","ru":"新金瓶梅 第二集","en":"新金瓶梅 第二集","year":"1996","type":"Фильм","rating":5.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/hxiU4cplEUYqgTTkSjPccpOKlbR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kQBIdDt5SLX3HqUtnqOybWXnCSQ.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"716586","ru":"국가 성생활 관리위원회","en":"국가 성생활 관리위원회","year":"2018","type":"Фильм","rating":5.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/lYbwhNgyhVaBrUT2e0qeytHhy1a.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bARtpEEZh5G84WltH2VdXrYqVYQ.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"418243","ru":"Отдых на дикой природе","en":"Lost Wilderness","year":"2015","type":"Фильм","rating":5.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/AkEeJOPUtmvTghrwPmLEgPAglPa.jpg","backdrop":"","genres":["приключения","семейный"],"overview":"Будущая семейная пара едет на отдых на дикую природу со своими детьми, чтобы у них, наконец, получилось поладить между собой. Четверо подростков отправляются на поиски семейной реликвии на своих квадроциклах. В лесу они сбиваются с пути, и им приходится бороться не только с дикой природой, но и искать общий язык друг с другом. Это история о надежде и борьбе, рассказанная интересно и с юмором. Она понравится не только детям, но и взрослым.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}