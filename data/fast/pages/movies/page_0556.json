избавился от Светланы, но понимает, что найти ей замену не так–то просто. Светлана в этот Новый год собирается, наконец, устроить свою личную жизнь. В коллективе решено провести вручение подарков от \"Тайного Санты\", и Светлана запланировала поездку на базу отдыха для себя и Стаса – сотрудника, который ей нравится, но все никак не сделает первый шаг. Однако все идет не по плану и приглашение достается… Максиму. Светлана и хотела бы сбежать, но Максим намерен как следует отдохнуть, а она, в свою очередь, принимает решение испортить ему праздник.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1404155","ru":"パリピ孔明 THE MOVIE","en":"パリピ孔明 THE MOVIE","year":"2025","type":"Фильм","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/esxaA0t1WYuNibobLWVf2Iy7Zi8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2tyy6oMYznZiG3c829PiE6liEt7.jpg","genres":["музыка","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"777637","ru":"Dirty Hari","en":"Dirty Hari","year":"2020","type":"Фильм","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/b2kXPr1plUHacLbFkel7hsjTPPn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hdQGXnd9BwzFuqWDI6PUayt6eHx.jpg","genres":["триллер","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"752927","ru":"小説の神様 君としか描けない物語","en":"小説の神様 君としか描けない物語","year":"2020","type":"Фильм","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/nrNFioW9JJNwwwB55W8rQHm2NrA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zmH0vuUnI5hffyQWVswQJzSwgpZ.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"222761","ru":"Tropic of Desire","en":"Tropic of Desire","year":"1979","type":"Фильм","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/d6lmgCZJdvZEduAlLba33TZAJRT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4DPMKNKY0gI0ZKnBg