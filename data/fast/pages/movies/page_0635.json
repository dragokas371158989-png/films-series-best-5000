иях. Мама записала ее на курсы по плаванию, где Хён Хо чувствует себя очень неловко, да и ещё тренер придумал ей кличку тунец и всячески к ней придирается. И тут она увидела его, молодого красивого Чо У Чжина, для неё он как дельфин. При помощи друзей, Хён Хо смогла пригласить его поужинать. Вроде у них все идёт неплохо, пока тренер не вмешивается в их отношения, ведь у него тоже возникли чувства к Хён Хо.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"270473","ru":"ฟัด จัง โตะ","en":"ฟัด จัง โตะ","year":"2013","type":"Фильм","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4x32HOq15WeTxNcda6oJaWmbNxp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/48dwB4axAbZUOlIz5dCJ9Li1T7W.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278986","ru":"গাঙ্গর","en":"গাঙ্গর","year":"2011","type":"Фильм","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/jf3Wa4ZIpHDhDkjUQ0PaUW7gyJM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vBTRaVlbBIwENXW0HC2qNbu4chL.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"288414","ru":"나는 야한 여자가 좋다","en":"나는 야한 여자가 좋다","year":"2014","type":"Фильм","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vTRmYhnMHTkLcZc6dRBbM6LHERj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/52AYvFDUuw59AScSWE0aQF7c8a8.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"622905","ru":"Golf!","en":"Golf!","year":"2019","type":"Фильм","rating":5.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/xVabWgg4C6GVWIhwpQFQGJGuOeg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cGQHo6Zvv7be1GZTt6kM0szEOFR.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"627909","ru":"Caterina","en":"Caterina","year":"2019","type":"Фильм",