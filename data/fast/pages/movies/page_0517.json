3CVUolobqNeK8o68RH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3YdKGZHLsjEgjlwDIxyrtKciK5v.jpg","genres":["документальный","музыка"],"overview":"В 1948 году французский певец Шарль Азнавур получает свой первый фотоаппарат Paillard Bolex и начинает снимать всю свою жизнь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"504903","ru":"불륜 동창회","en":"불륜 동창회","year":"2018","type":"Фильм","rating":6.9,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/oRcwpgqV7Wjt1xok8SztZWHcgn4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iCcDTzw0tOH9XYUlrrTfGu9LzJ5.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"456422","ru":"Critical Eleven","en":"Critical Eleven","year":"2017","type":"Фильм","rating":6.9,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/9rFFCia3wCpCFnymu94xTMho9Mu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/76XyEWROdAUxJ5i4tNneOwUkdJ8.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"501145","ru":"America","en":"America","year":"2018","type":"Фильм","rating":6.9,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/xIDI9gFC86fp7AZv0MuSkXHmaZ4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oGc98AANkGOG24hjCNjL5olM8gM.jpg","genres":["документальный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"441751","ru":"इरादा","en":"इरादा","year":"2017","type":"Фильм","rating":6.9,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/p7D7sc1cqY1CullErh55wuw5Bwx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fITlwbBGKpnAnL1bocK29yw8nbh.jpg","genres":["триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"637997","ru":"Ром","en":"Ròm","year":"2020","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/ta7x5lTDmzxxz3HScDyGoUucBGH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/usoBlCf6PKEpv9ypUdYfXQGYSB8.jpg","genres":["драма","боевик"],"overview":"Ром, молодой букмекер из шумного Сайгона, старается изо всех сил помочь жителям старого жилого комплекса сохранить свои дома и осуществить свою мечту — найти своих родителей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1402481","ru":"Возвращение Хромого Героя","en":"毕正明的证明","year":"2025","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/vP2tCUDhvgqTShBNdtfuGtqJH9R.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j4u6f31uHpePtmbejx3d4JbI4v7.jpg","genres":["криминал","драма"],"overview":"В Китае 1990-х годов на фоне повальных краж в поездах молодой полицейский Би Чжэнмин мечтает стать настоящим защитником закона. Получив травму ахиллова сухожилия в первый же день службы, он становится хромым и прослыл «полицейским-однодневкой». Несмотря на трудности и протесты матери, герой проходит реабилитацию и почти избавляется от хромоты. В качестве агента под прикрытием он проникает в банду «Жунмэнь», чтобы раскрыть дела опасного клана «Ронг» и поймать преступника по прозвищу «Теневая Рука», который его искалечил. Помогая раненой воровке Пич, Би становится участником «Собрания героев», где планируются массовые аресты. На пути к цели полицейский учится на своих ошибках и совершенствуется под руководством заместителя капитана Да Чжоу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1103812","ru":"Я всегда рядом","en":"Take My Hand","year":"2024","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/gHdjLtqNeT0n9xlkSVJhY2Ic64j.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uKRT0fsr9JQj3lriEJjmTr3GWkL.jpg","genres":["мелодрама","драма"],"overview":"Лора и Майкл полюбили друг друга еще в школе. Всего за несколько месяцев они стали друг другу очень дороги, но девушка приняла сложное решение и уехала из Австралии учиться в Англию. Спустя двадцать два года Лора замужем, у нее трое сыновей и прекрасная карьера. Но идиллию внезапно рушит диагноз: у женщины находят рассеянный склероз. Она хочет вернуться домой, но муж злится и не готов улетать в Австралию. После сильной ссоры он попадает в смертельную аварию, и Лора внезапно становится вдовой. Она бежит с сыновьями домой к родителям, где неожиданно встречает Майкла.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1154265","ru":"Lies We Tell","en":"Lies We Tell","year":"2023","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/82Q9dbJPLXE58IWDQvLgfh8wcMG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y7wQmV5lJeytievqX5zGPau8Gt9.jpg","genres":["драма","детектив"],"overview":"Водитель связывается с любовницей своего бывшего нанимателя, чье темное прошлое втягивает его в опасную историю.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"854663","ru":"O형수박가슴가정부","en":"O형수박가슴가정부","year":"2021","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/1xdJWTn5Tuqy7yWTywC9WBPyicW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2hUbwcGfmGZ0zAnJ7ZeqvImDUPK.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"360552","ru":"Хищник: фильм","en":"劇場版 MOZU","year":"2015","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/gXpWkSUDU4gRCtrVK9bh3IAyCS8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/khRYVpMSXwDTaVyBJ0Yck99lcGy.jpg","genres":["триллер","криминал"],"overview":"Прошло полгода с тех пор, как упрямый инспектор Кураки докопался до правды, скрытой за смертью его жены.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"514464","ru":"Товарищ ребёнок","en":"Seltsimees laps","year":"2018","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/fXFeMKj656yDuQ8b4ldtDxZzAgF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l9FnNdxLVduyQFWVmvyxPawJOBc.jpg","genres":["драма","семейный"],"overview":"События происходят в 1950 году. На глазах шестилетней Леэло вооруженные люди уводят мать. Она обещает вернуться, если Леэло будет хорошо вести себя. Но как девочка ни старается, мама не возвращается. Сомнения и страхи того мрачного времени в фильме рассматриваются как бы глазами ребенка, которому сложно понять происходящее.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"473924","ru":"동창회의 목적: 더 비기닝","en":"동창회의 목적: 더 비기닝","year":"2017","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/pStoby0ssYiKRizkPJUaA8FGz3U.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ji6mDx6xUAEsl65AZRrW6pWKxs4.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"431988","ru":"ひだまりが聴こえる","en":"ひだまりが聴こえる","year":"2017","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/dnMpJ0JoN9vW1gwOgVXmn00iM6J.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AtMgSnoIOwljyJVU3V8XBEZOwBf.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"507034","ru":"人魚の眠る家","en":"人魚の眠る家","year":"2018","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/xk6x4cIh16DKNOsk6VSZ8qzGhnY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/x5NFTQx7BL1Qu8qLnxqhvjJBVsk.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"419242","ru":"幸運是我","en":"幸運是我","year":"2016","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/AclhYC5njOXFcAwECCyQsfXlegi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/asqHkxLxp5C3cbpj6Ue23KLEusV.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"320589","ru":"Mavis!","en":"Mavis!","year":"2015","type":"Фильм","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/9LtoXEhZTIkZoyqjLAQCg9MHhga.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3B7kSRHs27yPYtg2HlAebPRKjhl.jpg","genres":["документальный","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1310502","ru":"Июньский жук","en":"Junebug","year":"2024","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/yDvimZHKqHTFQpQ7b1Xr801bHQi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s6ApUG3O7Fx0KRTiyjYLQvFmlZp.jpg","genres":["телевизионный фильм","мелодрама"],"overview":"Джунипер, редактор книг, которой вот-вот исполнится 40 лет, внезапно начинает видеть восьмилетнюю версию себя, которая подвергает сомнению ее жизненный выбор, включая мечту писать собственные истории.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"835963","ru":"Обязательство Хасана","en":"Bağlılık Hasan","year":"2021","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/5WnyMHip6zWOEAW5ba6GYwlNG3B.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jJpxldd2cml0D1fnK0TZRPeiX47.jpg","genres":["драма"],"overview":"История Хасана, всю жизнь посвятившего земле, которая досталась ему в наследство от его отца. Сражаясь против установки на его участке столба линии электропередачи, Хасан отправляется в паломничество в Мекку в ... ... Сюжет фильма: История Хасана, всю жизнь посвятившего земле, которая досталась ему в наследство от его отца. Сражаясь против установки на его участке столба линии электропередачи, Хасан отправляется в паломничество в Мекку в поисках справедливости и правды, но сталкивается со своим прошлым.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1418524","ru":"Доверенное лицо","en":"Confidente","year":"2025","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/7RZpeesHAv3izFv6FfAsPXb4dzR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oZWODXBCs9yEjobD2U1TGWtJT0O.jpg","genres":["драма"],"overview":"В 1999-ом году в Анкаре оператор секс-услуг по телефону получает звонок от отчаявшегося молодого человека, оказавшегося под завалами после землетрясения в Стамбуле. Она должна решить, как отреагировать на его срочный призыв о помощи.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"656279","ru":"Пари","en":"Pari","year":"2020","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/fwPzS9kdIis5NTcFUukHIY7rMiB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o2ZGPBQYniVQrxL72XV1RaulgYG.jpg","genres":["драма"],"overview":"Набожные супруги-мусульмане Пари и ее муж прилетают в Афины из Ирана, чтобы навестить своего сына-студента Бабака. Но он не встречает родителей в аэропорту, и они вынуждены отправиться в город на его поиски. В центре Афин родители попадают в самую гущу уличных митингов и беспорядков. Пари, в отличие от своего мужа, знает английский язык и берет дело в свои руки. Впервые она чувствует себя главой семьи, решающей проблемы самостоятельно. Эта новая роль вдохновляет Пари: она встречается с незнакомцами, узнает новые детали и постепенно продвигается по следам своего блудного сына.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1076011","ru":"แมนสรวง","en":"แมนสรวง","year":"2023","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/kj4qVhsA4pPQsn7TKG7ZaYqTpFg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/otwAm9hRE7KHRBeRbuPBOmpMtOb.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"726657","ru":"ブレイブ -群青戦記-","en":"ブレイブ -群青戦記-","year":"2021","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/dZHbJ2cbPZfumKLoh1NShIevZKk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g9fvWmUK6cuZNawImNTNRuhTBFj.jpg","genres":["боевик","история","детектив","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"833804","ru":"This Is GWAR","en":"This Is GWAR","year":"2021","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/ijkaSJOBqAru3b7XYViYFOGHNbG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mmjmbVfrFE0asJ0JCwbHxeA4ANW.jpg","genres":["документальный","музыка","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"344791","ru":"Райские поездки","en":"Paradise Trips","year":"2015","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/mk3hKbPVMbSaYeNgGzhv3UwWKGn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iTk42LrFnCkt5xYmPZCJvZqJlP8.jpg","genres":["комедия","драма"],"overview":"Марио — водитель автобуса в туристической компании «Райские поездки», перевозящей пенсионеров на солнечный юг. Настал день его последней поездки и собственного выхода на пенсию. Что принесет ему это путешествие?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"431251","ru":"Роман, опасный для жизни","en":"목숨 건 연애","year":"2016","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/wd2HYn9uYZPVORnjwMv0QwiFBZZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4DyfQSRxVuY2avz6Bm7zzDYsMmy.jpg","genres":["мелодрама","триллер","комедия"],"overview":"Несколько лет назад роман «Психология убийцы» за авторством Джейн Хан стал бестселлером. Но сейчас писательница в кризисе и ради поиска идеи для нового романа шарит по округе и подозревает всех и каждого, сразу же сообщая об этом в полицию. И для этого имеется серьёзный повод - в городе уже произошла серия идентичных убийств, но даже друг-полицейский Джейн уже не воспринимает её подозрения всерьёз. И тут девушка сталкивается с красавцем, будто сошедшим со страниц её романа идеальным мужчиной. Но что-то в нём кажется ей подозрительным.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"578211","ru":"Отбитый боксёр","en":"판소리 복서","year":"2019","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/7HCywDeVq3VIklnS5c3YlXPLspk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ttrd2GDw4ULDukbSJOAAhG5AZf1.jpg","genres":["комедия","драма"],"overview":"Когда-то Пён-гу был многообещающим профессиональным боксёром, но совершил ошибку, что положило его карьере конец. Теперь парень страдает от так называемой боксёрской деменции, работает на подхвате в небольшом спортзале и мечтает вернуться на ринг, чтобы продемонстрировать в действии разработанный им бокс пхансори. В зале клиентов не густо, поэтому большую часть времени он занимается расклейкой рекламных листовок, а владелец спортзала и бывший тренер Пён-гу и слышать не хочет о возвращении на ринг. Однажды, чтобы похудеть, на бокс записывается милая позитивная девушка Мин-джи и начинает дружить с Пён-гу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"185885","ru":"拳擊","en":"拳擊","year":"1971","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/gYNT7S5xD7lzNArQ49soEiu0Yjr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/v7xn74t1MqOKtpTG5b58HBmkqho.jpg","genres":["боевик","драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"425094","ru":"Echo Torch","en":"Echo Torch","year":"2016","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/5VHaxWVhF8WlGRn93IqjrdmkUia.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ktDdPixJSWhSyMzhyrfOLtQwaHR.jpg","genres":["ужасы","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"376808","ru":"Los Domirriqueños","en":"Los Domirriqueños","year":"2015","type":"Фильм","rating":6.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/nSGzqDdDxfJ8ZbWeHUHKg3cV2d0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fvk2hKFhGPOR6mWtVKBnDwccODf.jpg","genres":["комедия"],"overview":"","source":"tmdb