42/t5m7PPJBGvfNAT5vsnHzPsFBBLa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mbmkJSZzGu2FN1FC1zOdLgAaAmZ.jpg","genres":["драма","семейный"],"overview":"После смерти матери 17-летняя Джесси переезжает к своим дяде и тете в западную Монтану. В новой школе девушкой интересуется местный наездник, занимающийся булл-райдингом. Скачки – единственная вещь, связывающая Джесси с матерью, и она изо всех сил идет к своей мечте, хотя у нее и нет собственной лошади. Вскоре ее дядя Мик выкупает для Джесси лошадь, и она начинает заниматься любимым делом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1337397","ru":"Pilya","en":"Pilya","year":"2024","type":"Фильм","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/aQCJba6669KSTHrreNlrZuLPwWQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yqcH0p18LDMeyMgcnrvTBHwz8PF.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"950082","ru":"പാൽതു ജാൻവർ","en":"പാൽതു ജാൻവർ","year":"2022","type":"Фильм","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/b581PJG9dLh7zJVn8uUkl1pFkkm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1hQPLvspkx97V3617TMWBOzZgY4.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1082213","ru":"Sleep Call","en":"Sleep Call","year":"2023","type":"Фильм","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/gIUd4ZU2xakeKx5NFPdaEa45oPY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3m0wolcebLQ4wpd2c9LkItyNyDS.jpg","genres":["триллер","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1013126","ru":"The Fence","en":"The Fence","year":"2022","type":"Фильм","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/uYD3ohshnoMBvcgXuEahec1JgLM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7bBpOs05a0Q7WLYD6NE1oxRuv5R.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"413784","ru":"Синий бархат: Пересмотренный","en":"Blue Velvet Revisited","year":"2016","type":"Фильм","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/hw7ndlc5j6oao3thNPnrIPcLnLp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jFI3RfIoXT3gaRu20j8Ej6H6Mrg.jpg","genres":["документальный"],"overview":"Когда Дэвид Линч снимал свой фильм «Синий бархат», немецкий кинематографист Петер Братц также находился на съемочной площадке и снимал документальные кадры на пленочную камеру Super 8. Теперь, в 30-ю годовщину «Синего бархата», Братц представляет свои кадры вместе с фотографиями как «медитацию» на работу Линча","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"525831","ru":"HiGH&LOW THE MOVIE 3 FINAL MISSION","en":"HiGH&LOW THE MOVIE 3 FINAL MISSION","year":"2017","type":"Фильм","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/jheFieSlLfM5RUrr1MgjcWJwea4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xSR9PxtM1jjHavfJ3IVWwTnEa1R.jpg","genres":["боевик","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"437067","ru":"Hjertestart","en":"Hjertestart","year":"2017","type":"Фильм","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/vWf0IExBYKUfttXefG6nGOWDhsA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fhHGhMIQ0wXIvWJgHv0i9EOo6Lt.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"587217","ru":"ブルーアワーにぶっ飛ばす","en":"ブルーアワーにぶっ飛ばす","year":"2019","type":"Фильм","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/gf8GnwlXiC8zqeVsA7AdDUgSKqa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/67HnHNDB772gClrTXPHkEJNoMb4.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"560766","ru":"The Prayer