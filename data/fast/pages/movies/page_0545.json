юми, она узнает, как сильно и искренне та её любит.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"449253","ru":"Гори, ублюдок, гори!","en":"Burn Motherfucker, Burn!","year":"2017","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/nEFxVTf28wgGiI2kaPd0gyXA2kz.jpg","genres":["документальный","драма"],"overview":"Глубокий и провокационный взгляд на волнения в Лос-Анджелесе 1992 года, исследующий корни гражданских беспорядков в Калифорнии и отношения между афроамериканцами и полицией Лос-Анджелеса.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"489038","ru":"Le Scandale Clouzot","en":"Le Scandale Clouzot","year":"2017","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/ta6R8UZk6oH1MjYNkQLVELm3xLE.jpg","genres":["документальный","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"404851","ru":"The 3 Tails : A Mermaid Adventure","en":"The 3 Tails : A Mermaid Adventure","year":"2015","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/tjLgbRafhj60sqSqBnIStfeFeHT.jpg","genres":["семейный","приключения","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"422956","ru":"聖の青春","en":"聖の青春","year":"2016","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/lmGq94kQr2mOPZHPdWuzoZTXovA.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"601879","ru":"チア男子!!","en":"チア男子!!","year":"2019","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/bl9wpBFS5ks9e7q7pnLa2gU0MFC.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRati