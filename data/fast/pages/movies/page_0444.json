ританцами, японцами, американцами и китайцами. Фильм исследует любовь и человечность в контексте войны, увековечивая память о забытых военнопленных.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1384789","ru":"An Evening with Dua Lipa","en":"An Evening with Dua Lipa","year":"2024","type":"Фильм","rating":8.5,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/p96w68xvPhy74sdrnrrHtJHeX0q.jpg","genres":["музыка","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"591265","ru":"ТАЙМЛАПС БУДУЩЕГО: Путешествие к концу времён","en":"Timelapse of the Future: A Journey to the End of Time","year":"2019","type":"Фильм","rating":8.5,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/ApbpSs3hah8O8YcBWGNDVmpFzbE.jpg","genres":["документальный"],"overview":"С помощью этой короткометражки, мы оказываемся в 2019 году и отправляемся в увлекательное путешествие во времени. Нам предстоит увидеть будущее планеты Земля, смерть Солнца, конец всех звёзд, распад протонов, галактики-зомби, будущие цивилизации, взрывающиеся чёрные дыры, сущность тёмной энергии, альтернативные Вселенные и саму судьбу Космоса.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"371603","ru":"Nickelodeon's Ho Ho Holiday Special","en":"Nickelodeon's Ho Ho Holiday Special","year":"2015","type":"Фильм","rating":8.5,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/cA5dp3g4o2piLZAuAileAsMybmO.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"485114","ru":"Чихаяфуру. Финал","en":"ちはやふる 結び","year":"2018","type":"Фильм","rating":8.5,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/rQew6IX92T2z5WA8zOXyzGvYh3X.jpg","genres":["драма","мелодрама","комедия"],"overview":"Два года прошло с тех, пор как Чихая впервые встретилась с королевой каруты на всеяпонском чемпионате. Теперь девушка и её друзья – старшеклассники. Им предстоит найти себе преемников, чтобы кружок каруты школы Мидзусава не закрылся. Одновременно с подготовкой нерадивых новичков Чихая и её команда сталкиваются с обычными заботами выпускников: экзамены, выбор университета, мысли о будущем.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"605928","ru":"The Power of the Present","en":"The Power of the Present","year":"2017","type":"Фильм","rating":8.5,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/935rKaSrvVvjjmdL0a1fnyVSg1W.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1101179","ru":"片思い世界","en":"片思い世界","year":"2025","type":"Фильм","rating":8.5,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/cDhsDnxBZQ9aajmcobBPj7veMQu.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"829707","ru":"Catwoman: The Feline Femme Fatale","en":"Catwoman: The Feline Femme Fatale","year":"2021","type":"Фильм","rating":8.5,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/ord8gdBUFitBHccX1S5RpatulA7.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"646173","ru":"ये साली आशिकी","en":"ये साली आशिकी","year":"2019","type":"Фильм","rating":8.5,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/z83KrUMwgXPZM442lhl0Mth0pPk.jpg","genres":["триллер","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}