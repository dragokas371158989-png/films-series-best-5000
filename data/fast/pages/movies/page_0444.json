зывает истории пяти зданий - символов социалистической эпохи, свидетелей истории Восточной Европы второй половины XX века. Национальный дворец культуры в Софии, Московский государственный университет, Дворец Парламента в Бухаресте, Дворец Сербии в Белграде, Дворец Республики в Берлине - уникальные архитектурные объекты, которые были призваны напомнить людям о том, что есть высшая власть и светлое будущее. Каждое из них - самое высокое или самое большое, или с самыми большими часами на планете, или построено по самой передовой технологии. Но режим, при котором они были построены, кончился, и настало время раскрыть их секреты.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"712591","ru":"On Broadway","en":"On Broadway","year":"2019","type":"Фильм","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/7RE0dLC6cTI3eujvVEUHERIeYqf.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"274049","ru":"宇宙刑事シャリバン NEXT GENERATION","en":"宇宙刑事シャリバン NEXT GENERATION","year":"2014","type":"Фильм","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/8d7upKEsFZHrNh5UP27ppXhDQFc.jpg","genres":["боевик","приключения","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"490379","ru":"しゃぼん玉","en":"しゃぼん玉","year":"2017","type":"Фильм","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/6ZaoKxGt37FMvcmONI4JGmpy3Pg.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"608782","ru":"砂の器","en":"砂の器","year":"2019","type":"Фильм","rating":8.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/7UEBrs06H33hzZZUgSjPNniAFei.jpg","genres":["драма","криминал","детектив","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":""