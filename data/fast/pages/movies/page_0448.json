ь, семейные разногласия, чтобы ссориться и трагедии преодолеть. Сезон спаривания приносит конкуренцию женщинам, так как дни растут короче и холоднее в спешке к зиме. Но с их теперь уверенным лидером, чтобы вести их и их семьи, чтобы укрыться и ухаживать за ними, этот отряд снежных обезьян готов встретить мир.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"342857","ru":"Inhabit: A Permaculture Perspective","en":"Inhabit: A Permaculture Perspective","year":"2015","type":"Фильм","rating":8.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xFUVoeOkTi0kH0Ow3QvBiQwzZKn.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"397405","ru":"愛を積むひと","en":"愛を積むひと","year":"2015","type":"Фильм","rating":8.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/mnGVplcrOzpomggBYcCp4TuWXif.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"498955","ru":"비밥바룰라","en":"비밥바룰라","year":"2018","type":"Фильм","rating":8.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/hiZA8TWHjgF4NEX6CYbwagGgV4d.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1060042","ru":"Sin Clock","en":"Sin Clock","year":"2023","type":"Фильм","rating":8.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/3QPjvfi3AOQPcMtawMKdEAxB8Qn.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1549551","ru":"Dehşet Bey","en":"Dehşet Bey","year":"2025","type":"Фильм","rating":8.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/9Mg9q8hsv7aaUspAW2taRHXNkmC.jpg","genres":["боевик","криминал","мелодрама","приключения","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1484620","ru":"Everybody to Kenmure Street","en":"Everybody to Kenmure Street","year":"2026","type