":"2021","type":"Фильм","rating":5.3,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/nOFBVKFtXfWUx3ZMPAEp05QD5eD.jpg","genres":["детектив","триллер","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"686919","ru":"Maska","en":"Maska","year":"2020","type":"Фильм","rating":5.3,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/4tYTGLcsuxhmBtiKq57yGqh0xQO.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"460100","ru":"Anything","en":"Anything","year":"2018","type":"Фильм","rating":5.3,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/lGpEEaVvJl2y9MTASee8fgRVBTn.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"428378","ru":"எனை நோக்கி பாயும் தோட்டா","en":"எனை நோக்கி பாயும் தோட்டா","year":"2019","type":"Фильм","rating":5.3,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/sFs2upNXyv3tbYyVpJX1AVUpMjJ.jpg","genres":["боевик","драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"346667","ru":"த்ரிஷா இல்லனா நயந்தாரா","en":"த்ரிஷா இல்லனா நயந்தாரா","year":"2015","type":"Фильм","rating":5.3,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/dxfph7ywFeqWEx5MMhj505567Iy.jpg","genres":["мелодрама","боевик","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"457497","ru":"Lahoriye","en":"Lahoriye","year":"2017","type":"Фильм","rating":5.3,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/nWRhVSejbIV708nOBwgRAVi50wA.jpg","genres":["комедия","драма","история","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"945801","ru":"Ассасин: Смертельная битва","en":"刺杀小说家2","year":"2025","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/qRPwniTK5UZMvgaXIohDMB4PWno.jpg","genres":["боевик","фэнтези"],"overview":"Писатель ставшего популярным фэнтези-романа прозябает в безвестности, так как всю его славу присвоил мошенник-выскочка. Тем временем бог смерти и разрушения Рэдмейн из его книги восстает из мертвых и набирает силу, забирая суперспособности убитых им великих воинов. Он попадает в нашу реальность, и только автор с его персонажами могут спасти наш мир от гибели.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"978006","ru":"Ничто","en":"Intet","year":"2022","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/g5KDSBw2q5eCDzXMdkqb4lJJ2Bl.jpg","genres":["триллер","драма"],"overview":"В центре истории оказывается группа восьмиклассников, которые противостоят бессмысленности жизни и оставляют позади невинность детства.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"839564","ru":"Maximum Truth","en":"Maximum Truth","year":"2023","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/4qwuV254WkvpShctB9rn0gCYBkY.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1025067","ru":"ड्रीम गर्ल 2","en":"ड्रीम गर्ल 2","year":"2023","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/spiHFvHk7vqsIF4wAU7S6wcTzek.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"771622","ru":"Beck 40 - Utom rimligt tvivel","en":"Beck 40 - Utom rimligt tvivel","year":"2020","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/9A0dQwVVIxC5CUqbKLgd037ux1v.jpg","genres":["криминал","драма","триллер","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1123342","ru":"Missed Connections","en":"Missed Connections","year":"2023","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/8cZqpybrhUdxP64nEm2ReYiUPUn.jpg","genres":["мелодрама","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"405796","ru":"Скрытая правда","en":"Hidden Truth","year":"2016","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/p8bPLFAtqHmxKUDgricUU2ia1DV.jpg","genres":["триллер","криминал","телевизионный фильм"],"overview":"После того как в калифорнийском городке находят труп девочки-подростка, молодой женщине приходится доказывать невинность её брата, обвиняемого в этом преступлении. В процессе она не только узнаёт о тёмной стороне окружающих её людей, но и о том кто реально является убийцей, так тщательно скрывающим свою личность.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"357708","ru":"Песочные часы","en":"இஞ்சி இடுப்பழகி","year":"2015","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/rZwIlkdSXEJnuUhZ6mfem5Wyi5Z.jpg","genres":["мелодрама","комедия","драма"],"overview":"Свити мечтает найти шикарного жениха и выйти за него замуж. Однако у девушки никак не получается познакомиться с достойным молодым человеком. Свити разочаровывается и принимает решение больше не пытаться найти любовь всей своей жизни. И сразу же после этого она знакомится с парнем по имени Абхи, который занимается съёмками документального фильма. Главная героиня влюбляется в него с первого взгляда, однако он не проявляет к ней никакого интереса. Тогда Свити понимает, что мужчины не обращают на неё внимания из-за её лишнего веса. Девушка начинает работать над своим телом, изучая программу «Size Zero». Сможет ли она достичь своей цели и стать привлекательной?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"575333","ru":"Коридор бессмертия","en":"Коридор бессмертия","year":"2019","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/gc0BD0Cn4MmEQOaM4kV27Gm9HLz.jpg","genres":["военный","драма"],"overview":"Вчерашняя ленинградская школьница Маша Яблочкина после лютой блокадной зимы 1941-1942 года приходит на железнодорожные курсы в надежде выжить и набраться сил. Оттуда девушку отправляют на строительство Шлиссельбургской магистрали, соединяющей город с Большой землей и находящейся в прямой видимости немецкой артиллерии. Так героиня попадает в 48-ю паровозную колонну особого резерва НКПС, которой ценой смертельного риска предстоит доставить в Ленинград 75% всех грузов и военного снаряжения.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"608613","ru":"Прелюдия","en":"Prélude","year":"2019","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/lxsSUhxvOwrg3U98vntOq6Y2GOs.jpg","genres":["драма"],"overview":"Это история о студенте-пианисте, который погружается в мир музыки и испытывает свою первую любовь. Полный жизненной энергии, но под нарастающим давлением, он вскоре начинает терять контроль над собой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"430977","ru":"Уединение","en":"Seklusyon","year":"2016","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/kfBFJyfw3q7hfnzV2ApPpDpDLCd.jpg","genres":["ужасы"],"overview":"В 1947 году молодые священники отправляются в удаленный монастырь, чтобы жить в изоляции семь дней перед посвящением. Их служение, это защита мира от зла. Когда маленькая девочка, творящая чудеса, случайно попадает в монастырь, возникает вопрос, является ли она рукой Божьей или происками Дьявола. Для каждого из священников наступает сложный выбор.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"21603","ru":"Секс 24 кадра в секунду","en":"Sex at 24 Frames Per Second","year":"2003","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/gkuhA2aoPCiohSwMoLOMf72r4L2.jpg","genres":["документальный","история"],"overview":"Этот фильм — документальное исследование, в котором о «предмете» рассуждают режиссеры и артисты, рассказывается, как секс пришел в Голливуд, каковы причины появления откровенных сцен в фильмах. Все это сопровождается соответствующей «нарезкой» фильмов американского кинематографа.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"509563","ru":"Bad Tutor","en":"Bad Tutor","year":"2018","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/3q0J9Gwj8sjxPggIsrvHnZvBVxX.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"571984","ru":"Stalked by My Patient","en":"Stalked by My Patient","year":"2018","type":"Фильм","rating":5.3,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/1bjkwPoAt2HA5RYuRaNBiARCwvj.jpg","genres":["телевизионный фильм","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"839727","ru":"Тайны содержанки-убийцы","en":"Secrets of a Gold Digger Killer","year":"2021","type":"Фильм","rating":5.3,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/ldOV6UCkAJXKRlD6qH2Xszg4gPM.jpg","genres":["криминал","драма","телевизионный фильм"],"overview":"Мультимиллионер Стивен Бирд, влюбился в Селесту , привлекательную официантку, которая обслуживала его в местном загородном клубе в Остине.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"616214","ru":"Двенадцать тысяч","en":"Douze mille","year":"2020","type":"Фильм","rating":5.3,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/1scWvsbbKZmFjVOhHfe2VcAVVAy.jpg","genres":["драма"],"overview":"Франка прогоняют из автомастерской, в которой он работал нелегально. Ему приходится оставить жизнь со своей девушкой Марусей и найти новую работу вдали от дома. Франк и Маруся договариваются о том, что он должен заработать 12 000 евро перед тем, как вернуться обратно. Сможет ли Франк заработать такую сумму? И вернётся ли он с такими деньгами просто так?","source":"tmdb","episodes":"