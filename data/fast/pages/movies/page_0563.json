pisodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"642657","ru":"Милея: Голос Дилана","en":"Milea: Suara dari Dilan","year":"2020","type":"Фильм","rating":6.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/pihwEdQV7sHlSU2sFj5miwiENPd.jpg","genres":["драма","мелодрама"],"overview":"Перед великим воссоединением Дилан решил написать и пересказать свою историю любви с Милеей. Это его способ ещё раз прочувствовать всё, что они вместе пережили.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"713598","ru":"Psycho Yoga Instructor","en":"Psycho Yoga Instructor","year":"2020","type":"Фильм","rating":6.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/1TWRfinccNiQS61r49PTfNEs2vz.jpg","genres":["драма","триллер","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"294991","ru":"День расплаты гангстера","en":"大茶飯","year":"2014","type":"Фильм","rating":6.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/63bPZim5zscR4dlvdPHkZefW9gi.jpg","genres":["криминал","боевик","комедия"],"overview":"Стареющий гангстер хочеть отойти отдел и решает инвестировать чайную. Однако чайная стоит на пути проекта, который собралась развивать конкурирующая банда и гангстер вынужден призвать старых друзей, чтобы спасти не только чайную, но и девушку своей мечты.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"548784","ru":"地獄少女","en":"地獄少女","year":"2019","type":"Фильм","rating":6.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/ejR46fMxskeUvAwvybmO5KwPQjq.jpg","genres":["ужасы","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"652786","ru":"A Very British Christmas","en":"A Very British Christmas","year":"2019","type":"Фильм","rating":6.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/cCzUccS5ncBGd8obnNrkNjpgHN0.jpg","genres":["мелодрама","комедия","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"292035","ru":"Aanmodderfakker","en":"Aanmodderfakker","year":"2014","type":"Фильм","rating":6.2,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/yHEbqYMAm0KDMWYSnJvr5TVQZjT.jpg","genres":["комедия","мелодрама","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1442776","ru":"Ящер","en":"狂暴巨蜥","year":"2024","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/9TFaFsSXedaALXTzba349euDeoY.jpg","genres":["боевик","триллер","ужасы"],"overview":"Однажды вечером недалеко от деревни Баду падает космическое тело. Девушка по имени Сяо Мэй вместе со своим парнем отправляется исследовать место происшествия, надеясь найти там что-то ценное. Вместо этого они встречают огромного плотоядного ящера. Сяо Мэй чудом удается спастись, но монстр остается на свободе. На следующий день ученая Чжао Сяое обнаруживает следы гигантской рептилии в лесу. Монстры стремительно увеличиваются в размерах и начинают уничтожать все вокруг.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"656850","ru":"Дивная романтика зимы","en":"Amazing Winter Romance","year":"2020","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/6WCT88z4TZOK1JXjXHc6jSORLVd.jpg","genres":["телевизионный фильм","мелодрама"],"overview":"Когда журналистка Джулия возвращается домой в поисках вдохновения, она узнает, что ее друг детства построил гигантский снежный лабиринт, который поможет ей найти свой путь к истинной любви.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1180665","ru":"Рождество на Черри Лейн","en":"Christmas on Cherry Lane","year":"2023","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/ggZsX97GTu47mhQ7jz04gAFcxAG.jpg","genres":["телевизионный фильм","комедия","мелодрама","драма"],"overview":"Три пары в разные периоды времени проводят этот волшебный праздник, Рождество, в доме по адресу Черри Лейн, дом 7","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"944410","ru":"जलसा","en":"जलसा","year":"2022","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/2vHD8SLW5fG5D4vy5IrVAVO0jnW.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"492317","ru":"Красавец и чудовище","en":"二代妖精之今生有幸","year":"2017","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/x5FZFEMpkWZuAEk9Upw81Liqico.jpg","genres":["комедия","фэнтези"],"overview":"Когда-то Юань Шуай вложился в кинопроизводство, но прогорел и залез в долги. Его отец заболел и отправился в дом сумасшедших, а сам парень работает уборщиком слоновьего навоза в зоопарке и ходит на свидания вслепую, чтобы найти богатую жену. Однажды к нему прицепляется странная девушка, которая утверждает, что она — лиса. Оказывается, Юань ещё в детстве спас маленькую лису от хулиганов, и теперь она, когда наконец-то нашла своего героя, непременно хочет выйти за него замуж.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"533274","ru":"Преследуемая своим доктором: Месть пациентки","en":"Stalked by My Doctor: Patient's Revenge","year":"2018","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/gUoTgAGg2zLW6aDItatY9h0x7xx.jpg","genres":["триллер","телевизионный фильм","ужасы"],"overview":"2 года назад доктор Альберт Бек пытался похитить свою пациентку Софи Грин и инсценировать её смерть. Но суд оправдал его. Жизнь продолжается, доктор Бек, любитель женщин помоложе, находит симпатичную студентку Мелиссу, которая отвечает его чувствам взаимностью, и доктор влюбляется в неё. Но останется ли безнаказанным то, что он сделал с Софи Грин?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"340912","ru":"위험한 상견례 2","en":"위험한 상견례 2","year":"2015","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/fo7qyo4jO4SoaL7VLx4X79m8ZKK.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"301339","ru":"Coming Through the Rye","en":"Coming Through the Rye","year":"2016","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/dMelhngzbDJk1HSk35W8FFtnRrw.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"283711","ru":"闯入者","en":"闯入者","year":"2015","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/pOh65Btb6o61gZObgl6DAiXhren.jpg","genres":["криминал","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"404279","ru":"Green Is Gold","en":"Green Is Gold","year":"2016","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/x9p86hPU0cxaab7LnYNyQvpZ1sk.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"323666","ru":"La Résurrection des natures mortes (Living Still Life)","en":"La Résurrection des natures mortes (Living Still Life)","year":"2014","type":"Фильм","rating":6.2,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/z7WEXFcNtloTLRCtQf9EXiIPUzZ.jpg","genres":["фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1013406","ru":"Моди: Три дня на крыльях безумия","en":"Modi, Three Days on the Wing of Madness","year":"2024","type":"Фильм","rating":6.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/6uNVDN6MdwuXky6TfbnzyMlh10L.jpg","genres":["драма","история"],"overview":"Париж, 1916 год. Обаятельный хулиган Модильяни, завсегдатай модных ресторанов и любимец женщин, окунается в пучину богемной жизни в попытках понравиться критикам и продать свои работы, но из раза в раз терпит неудачу. Почти отчаявшись, он собирается бросить все, как вдруг приходит весть о прибытии в город видного коллекционера. Моди получает шанс изменить свою жизнь и превратиться из неизвестного художника в звезду мировой величины.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"744945","ru":"Все внимание на рождество","en":"Spotlight on Christmas","year":"2020","type":"Фильм","rating":6.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/n7VOErjeOwTz0YMiODDBUU74bTw.jpg","genres":["телевизионный фильм","мелодрама"],"overview":"Брошенная своим парнем перед Рождеством голливудская актриса втайне едет в родной город, чтобы поесть маминых угощений и убежать от внимания прессы. В итоге там она находит роль всей своей жизни и понимает, что именно там может обрести себя.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"627336","ru":"L2: എമ്പുരാൻ","en":"L2: എമ്പുരാൻ","year":"2025","type":"Фильм","rating":6.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/dfaZipN3Aw5BK85nEvfr2FNg4EW.jpg","genres":["боевик","криминал","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1132390","ru":"Where Are You, Christmas?","en":"Where Are You, Christmas?","year":"2023","type":"Фильм","rating":6.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/6j3A3Rnm0SyMuGmROAsUaGb4Klx.jpg","genres":["телевизионный фильм","драма","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"339944","ru":"Тайное общество Супилинна","en":"Supilinna salaselts","year":"2015","type":"Фильм","rating":6.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/pTJ5CUFHuO8wTaGRzyULBqwZ4ad.jpg","genres":["детектив","семейный","приключения","фэнтези"],"overview":"В очередные летние каникулы четверо детей — Мари, Саду, Олав и Антон — решили организовать команду. Чтобы дети не болтались без дела по городу, дедушка Мари придумал для них интересную игру. Они должны разыскивать в определенных местах предметы, которые он указывал на карте. Но в эту игру вмешалось одно обстоятельство. Кто-то в городе стал распространять странное вещество, от которого взрослые своим поведением стали напоминать детей. Теперь эта четверка должна остановить злодея и найти противоядие, чтобы спасти своих родственников и знакомых.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"481899","ru":"劇場版 屍囚獄 結ノ篇","en":"劇場版 屍囚獄 結ノ篇","year":"2017","type":"Фильм","rating":6.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/myA8zddhOJpeQyKPdt61XyuorJr.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"264450","ru":"7th ഡേ","en":"7th ഡേ","year":"2014","type":"Фильм","rating":6.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/A5gnTlftMu15Tu6JcZRfwI76sWh.jpg","genres":["боевик","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"615322","ru":"O Amor Dá Trabalho","en":"O Amor Dá Trabalho","year":"2019","type":"Фильм","rating":6.2,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/nFYmSbOQ1MqnNmKwggTfdm0Rdjc.jpg","genres":["комедия","мелодрама","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"618229","ru":"Риалто","en":"Rialto","year":"2020","type":"Фильм","rating":6.2,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/3N74fTMOI74GuLvK0TkXZtQrfde.jpg","genres":["драма"],"overview":"Колм ведёт спокойную размеренную жизнь: ему слегка за 40, есть жена, двое детей и должность менеджера в доках. После смерти отца, который весьма деструктивно влиял на Колма, его жизнь начинает идти под откос, а внезапное увольнение только усугубляет ситуацию. Однажды, сильно перебрав в баре, он встречает 19-летнего парня, к которому начинает испытывать влечение. Их редкие встречи, сопровождающиеся сексом и разговорами, становятся для Колма настоящей отдушиной, однако ставят под угрозу благополучие его семейной жизни.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1260820","ru":"Stream","en":"Stream","year":"2024","type":"Фильм","rating":6.2,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/aqLBOmJ59FdEMXARmpDnwHrcfV2.jpg","genres":["ужасы"],"overview":"Семейная пара с дочерью-подростком и сыном помладше приезжает в отель, который вскоре захватывают четверо психопатов в масках и начинают убивать гостей всевозможными извращёнными способами.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"685051","ru":"Into the Arms of Danger","en":"Into the Arms of Danger","year":"2020","type":"Фильм","rating":6.2,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/U1yqjQnFO3Lk8n5dUrzCAonDBs.jpg","genres":["телевизионный фильм","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1045385","ru":"Miss. Shetty Mr. Polishetty","en":"Miss. Shetty Mr. Polishetty","year":"2023","type":"Фильм","rating":6.2,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/wjpVC925RTLCJRlLKkMoHxomVJd.jpg","genres":["комедия","драма","мелодрама","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"294483","ru":"Мы Были Королями","en":"Wir waren Könige","year":"2014","type":"Фильм","rating":6.2,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/ehtoBRjvBl96x0ZkK4l9liF0Jr6.jpg","genres":["драма","криминал","триллер"],"overview":"Группа быстрого реагирования немецкой полиции попадает в сложную ситуацию: при штурме наркопритона убиты двое наркодилеров и ранен их товарищ. Позже при загадочных обстоятельствах погибают еще двое сотрудников группы. На свой страх и риск они начинают охоту за убийцей их товарищей ...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"816711","ru":"Lust for Gold: A Race Against Time","en":"Lust for Gold: A Race Against Time","year":"2021","type":"Фильм","rating":6.2,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/wqrKavooKU8atYzlsgfozdaQrDR.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}