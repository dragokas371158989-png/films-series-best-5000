оме посреди глухого леса. Семья переживает нелегкие времена, и надежда только на отца, который всё никак не вернется из морского похода. Когда они уже теряют надежду увидеть его вновь, он возвращается, но совсем другим. Руна пытается разобраться, что с ним произошло, и как с этим связаны странные существа, периодически появляющиеся в лесу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"861818","ru":"பூமிகா","en":"பூமிகா","year":"2021","type":"Фильм","rating":5.3,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/nOFBVKFtXfWUx3ZMPAEp05QD5eD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nhy6HWcF9CDrmtZnigvVElEKZpk.jpg","genres":["Детектив","Триллер","Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"686919","ru":"Maska","en":"Maska","year":"2020","type":"Фильм","rating":5.3,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/4tYTGLcsuxhmBtiKq57yGqh0xQO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/awqM5h2Z9O6ZUA3evPES7akLRNX.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}