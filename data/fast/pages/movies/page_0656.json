"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1107526","ru":"Desde la última vez que nos vimos","en":"Desde la última vez que nos vimos","year":"2023","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/8cbd0UHxtPHMWPjB3t4fFVtBIrE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xM69RojvHZOIZMnKt7vq45pFwTU.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1270762","ru":"Visher","en":"Visher","year":"2024","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/aXbAr70lXLkB2efvE0kIoYMd1KB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8dO6bSabQsJ93XzGHGfTfv0nq24.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"681940","ru":"The Dark Divide","en":"The Dark Divide","year":"2020","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/A9aw7NKg1K7gsA4Vhvn7W0lrRZf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qhESBlsUWDuwXJl4X20M0TOGJ72.jpg","genres":["приключения","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"762951","ru":"Dr. Seuss' The Grinch Musical","en":"Dr. Seuss' The Grinch Musical","year":"2020","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/rHJlD4ElNBZmejPATAjkuLUooSB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6ClzcSlJLYKsAK1MJ1EhgKvWd3O.jpg","genres":["семейный","музыка","телевизионный фильм","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1217410","ru":"Prepare to Die","en":"Prepare to Die","year":"2024","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/wnbTmTHDIaWAxyssARrl3ziygmP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lYowRTpGaN45cVtkCfEI6zrnOhb.jpg","genres":["боевик","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"505201","ru":"Deadly Attraction","en":"Deadly Attraction","year":"2016","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/ds5Dv3bgRyIb1fuWbOcNoifiLpL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sSANL5Gc5Y6BfSrRAzTdWwLlYuL.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"382204","ru":"無伴奏","en":"無伴奏","year":"2016","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/7PqTP8ApI3T2rTV1Lbt46W3Onhn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wTRZ2iMvAORvqM1AqKMLRfRnGQd.jpg","genres":["мелодрама","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"380856","ru":"A Stand Up Guy","en":"A Stand Up Guy","year":"2016","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/141aFvHTqRXQMgUYvKGDhfNa35C.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5k0XfSrXscd2dt6NpGyUAt2Kxjw.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"449342","ru":"അലമാര","en":"അലമാര","year":"2017","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/x6xV6vd8KiFBgW8CbY786MNylh6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hC5ikmeQd7G9X5vZLHs75HF9ovm.jpg","genres":["комедия","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315057","ru":"Päin seinää","en":"Päin seinää","year":"2014","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/fGGa6c9lUz1b9KkLvbED4ESZqEY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hNsSSX8JYYgWHM7o2SWuWBYN0zn.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"336111","ru":"Bir Varmış Bir Yokmuş","en":"Bir Varmış Bir Yokmuş","year":"2015","type":"Фильм","rating":5.1,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/mbI3K7LTRm2m2PukeboHlNQ65VO.jpg","backdrop":"","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1656061","ru":"Битва бессмертных","en":"Immortal Combat","year":"2026","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/mhRAgvQ04DTE4zQN3OSyc9Lonj3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/p1zXv0HSKKfdMPfeUwYrCjk2gea.jpg","genres":["боевик","приключения","фантастика"],"overview":"Самые известные воины в истории, включая Жанну Д’Арк и Чингис Хана, оказываются под контролем влиятельной организации, которая призывает их участвовать в смертельной схватке на смерть. Руководители рассчитывают на зрелищное сражение, не зная, что участники знакомы друг с другом и вынашивают план мести.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"722799","ru":"Лена и львёнок","en":"Lena and Snowball","year":"2021","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/1pzzX6I3Uj1AJDKBsgGxbICOXyV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/u8lF8zrCPhwT6QKRlkBElxn6PND.jpg","genres":["семейный","приключения"],"overview":"Двое не самых успешных контрабандистов пытаются передать белого львенка в руки богатого коллекционера экзотических зверей. Но все идет не по плану, и животное убегает. Судьба сводит львенка с девочкой Леной, которая недавно переехала и пока не нашла друзей. Она забирает животное домой и дает ему кличку Снежок. Однако в скором времени обозленные преследователи львенка нападают на след и приезжают в город, где живет Лена.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"915867","ru":"Судмедэкспертиза","en":"Forensic","year":"2022","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/bn2sQizEJ0qsntJRvjULsd5vk44.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1vTCTFc3j2Y3wR3VbFveyOZYrfY.jpg","genres":["криминал","триллер"],"overview":"Мегха Шарма помощник инспектора в Массури. Она живет со своей матерью и Аанией . Аанья — дочь покойной сестры Меги Дивьи. Она была замужем за Абхаем Кханной и была матерью Ааньи, а также ее сестры-близнеца Адьи. 5 лет назад Адия погибла в результате несчастного случая в Ришикеше, когда вся семья приехала на ярмарку. Дивья не смогла справиться с травмой и покончила жизнь самоубийством. Мегха обвинил Абхая в этих смертях. Она насильно взяла Аню с собой. Это событие усилило стресс Абхая, и он впал в депрессию. После этого инцидента Мегха также рассталась с Джонни Кханной, братом Абхая. В наши дни в свой день рождения из школы пропадает молодая девушка Дженнифер. Ее мертвое тело находят на следующий день. Мегхе поручено разобраться с этим делом. Ей соперник Ведом Пракаш Матхур остается не удел, поскольку руководство считает, что она может более деликатно справиться с этим делом, чем он. Начальство также сообщает ей, что Джонни Ханна будет проводить судебно-медицинские расследования.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1337133","ru":"Ghosts of Red Ridge","en":"Ghosts of Red Ridge","year":"2024","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/eNyj1J1GMasLYzss61o2rXz8Lpi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3IrF1QxYEl4GMlzgW7OhgWOld8X.jpg","genres":["вестерн","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"738057","ru":"616 Wilford Lane","en":"616 Wilford Lane","year":"2021","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/rugsj14joeOgy08WpHr3AvjCYSv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4UCpzkYv2J3IeIH2kb2eA20eDBb.jpg","genres":["ужасы","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"733322","ru":"Зло пускает корни","en":"Evil Takes Root","year":"2020","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/9QYSAwRO18um5jL8OlEUJzFQJ4K.jpg","backdrop":"","genres":["ужасы","триллер"],"overview":"Медиум Феликс приезжает в маленький городок Огайо расследовать таинственную смерть своей бывшей любви Аманды. Он узнает, что та пала жертвой древнего демона Батибата, который проследовал за ней с самых Филлипин.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"253259","ru":"Дикие канарейки","en":"Wild Canaries","year":"2014","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/6EcXTvoZOZ9OwVDcekXAu1pL5ne.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8Z8ZhOAbOPV5lCbmfP9Vj4qXSvu.jpg","genres":["комедия","детектив","мелодрама"],"overview":"Пару из Бруклина начинают подозревать в мошенничестве после того, как их сосед по квартире, который был абсолютно здоров, неожиданно умер.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"619189","ru":"Резня семьи Мэнсона","en":"The Manson Family Massacre","year":"2019","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/r1jzT5lb6kb3LSD80ElJl8vsN44.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tQvnXzhr3FV5pvzCsm8WAFJ73HN.jpg","genres":["ужасы","криминал"],"overview":"В 1969 году психопат и глава культа Семья Чарльз Мэнсон вместе со своими последователями вламывается в дом на 10050 Сьело Драйв, чтобы устроить кровавую бойню и убить всех его обитателей. В том кошмаре погибает беременная актриса Шэрон Тейт, а ужасная история, равно как и адрес дома, становятся печально известны на всю страну.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"629442","ru":"Три дня с папой","en":"3 Days with Dad","year":"2019","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/r8h7ynYesfalE2ruj2f4pqeAe3I.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nkh0pNTsFj5VDxYE1WSXWARxMgO.jpg","genres":["комедия"],"overview":"Меньше всего Эдди Миллс (Ларри Кларк) хочет пойти домой, чтобы разобраться со своим умирающим отцом (Брайан Деннехи). Но чувство вины католика гложет его, и он возвращается домой к своей сумасшедшей семье, властной мачехе (Лесли Энн Уоррен) и своему медведю-отцу. Тогда-то, Эдди сталкивается с откровением, которое заставляет его иметь дело с прошлым, которого он всегда избегал.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"300375","ru":"Borley Rectory","en":"Borley Rectory","year":"2017","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/486FoDLYeLF3WiTHxTlcnn3VGQv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mSxcV9hHUwtjLWBRQRO8qtGE0C0.jpg","genres":["документальный","ужасы","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"565277","ru":"కవచం","en":"కవచం","year":"2018","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/lZaJhafKDFKGNf42rPU0CMMO55d.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m2EdaTZW45ZiW3pVDvLBqrXdHGN.jpg","genres":["боевик","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"444973","ru":"Sisterhood","en":"骨妹","year":"2017","type":"Фильм","rating":5.1,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/cABxMvX0BuHLFVWfXGzr4wpNAfT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t3vEXFDU6HSAaHqPuh3aanQSNL3.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}