mdb.org/t/p/w342/oAyQUFJuB7XikP6Qx4SzV87doKs.jpg","genres":["триллер","боевик","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"295339","ru":"The Haunting of Alice D","en":"The Haunting of Alice D","year":"2017","type":"Фильм","rating":5.1,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/1jQBqXdKT4wTgM6QvJTJSAkwGhN.jpg","genres":["триллер","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1145531","ru":"Безликие после наступления темноты","en":"Faceless After Dark","year":"2023","type":"Фильм","rating":5.1,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/5AAKvVGrYMqHOR55tYZMZUO46e3.jpg","genres":["ужасы","триллер"],"overview":"После того как Боуи стала звездой благодаря ужастику про клоуна-убийцу, её берет в заложники безумный фанат, который хочет воплотить сценарий фильма в реальность.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"381052","ru":"Выходные в кругу семьи","en":"Familieweekend","year":"2016","type":"Фильм","rating":5.1,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/txOGdXkK9WEmFqvHPWjdbqD381G.jpg","genres":["комедия"],"overview":"Престарелый человек, который прожил не легкую жизнь, но при этом умудрился заработать миллионное состояние, собирает своих детей и членов большой родни в своем замке, чтобы объявить им неожиданную новость: он намерен жениться. Все в шоке от этой затеи, особенно дети, невеста-красавица, которая моложе его на полвека, похоже хочет урвать свою часть огромного состояния. Никто не поверил в искренность чувств девушки, дети решают доказать, что она настоящая шарлатанка. Сорвать свадьбу — это единственный способ уберечь свое наследство, в ход идут все доступные способы…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"571028","ru":"Деньги не пахнут","en":"Kaviar","year":"2019","type":"Фильм","rating":5.1,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/jAyWTsNmpwMLuMns6vCjqhd1PtI.jpg","genres":["комедия"],"overview":"Русский олигарх Игорь хочет построить себе виллу прямо в центре Вены, на знаменитом Вы- соком мосту. Для осуществления задуманно- го ему нужно подкупить множество политиков и чиновников - для этого он использует услуги переводчицы Нади. У которой есть свои идеи о том, на что потратить эти деньги.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"531615","ru":"Сомнения Томаса","en":"Doubting Thomas","year":"2018","type":"Фильм","rating":5.1,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/f13Vk6GrMFiMKOcd3KjKL3bu6BZ.jpg","genres":["драма"],"overview":"У белой пары рождается темнокожий ребенок. Джен предлагает пройти тест на отцовство, чтобы успокоить Тома.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"358206","ru":"Колесо","en":"La Volante","year":"2015","type":"Фильм","rating":5.1,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/vYy0hsgyuuNgrJi5za4XGl7OXWj.jpg","genres":["триллер"],"overview":"Тома везёт свою жену в роддом и насмерть сбивает молодого человека. Его мать не может смириться с утратой; через несколько лет она становится ассистенткой Тома и начинает вмешиваться в его жизнь с одной лишь целью — добраться до его сына.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"376438","ru":"La casa del piacere","en":"La casa del piacere","year":"1994","type":"Фильм","rating":5.1,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/cDm7ojiipBwkGkEYPOsjORdshjm.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"438376","ru":"미스 푸줏간","en":"미스 푸줏간","year":"2017","type":"Фильм","rating":5.1,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/lMDijw34tZszRRDuUqJDJRD2HSS.jpg","genres":["комедия","мелодрама","триллер","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"454854","ru":"Rodney King