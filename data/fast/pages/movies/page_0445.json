db.org/t/p/w342/hP4NKNk80w3fbu70OjZ2Rb8cPCO.jpg","genres":["боевик","криминал","драма","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"463814","ru":"A Mindful Choice","en":"A Mindful Choice","year":"2016","type":"Фильм","rating":8.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/vl05vc6qzq869NhMzTTM4AlAmoj.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1025477","ru":"Steve Vai - His First 30 Years: The Documentary","en":"Steve Vai - His First 30 Years: The Documentary","year":"2022","type":"Фильм","rating":8.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/rdIFY2PNs5Kqw98KE8rWSRUuKdP.jpg","genres":["документальный","музыка"],"overview":"Документальный фильм рассказывает о жизни легендарного гитариста Стива Вая с 1960 по 1990 год, охватывая его детство, юность, учёбу в колледже Беркли и ключевые этапы карьеры. Это первая такая лента, соавторством самого Вая, с сотнями неизвестных фактов, архивными материалами и фирменным юмором музыканта.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1159470","ru":"大いなる不在","en":"大いなる不在","year":"2024","type":"Фильм","rating":8.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/68IG8OXKlvAEDRZwH3xn5SUlucl.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1329671","ru":"私にふさわしいホテル","en":"私にふさわしいホテル","year":"2024","type":"Фильм","rating":8.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/ey2fzSJehm1vFgnfmkUXzozxV8S.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1246058","ru":"Becoming Nawalny — Putins Staatsfeind Nr. 1","en":"Becoming Nawalny — Putins Staatsfeind Nr. 1","year":"2024","type":"Фильм","rating":8.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/gm2uEpNCSnRosH8utVwRLpK1Edg.jpg","genres":["документальный","история","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"586342","ru":"Роман","en":"로망","year":"2019","type":"Фильм","rating":8.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/9InB0qJsI8kKdrUwVXgkqmKZzSl.jpg","genres":["мелодрама","драма"],"overview":"75-летний Нам-бон и 71-летняя Мэ-джа женаты уже 45 лет. За эти годы они во многом стали похожи друг на друга, и теперь у обоих развивается деменция. С каждым днём воспоминания для супругов становятся всё более расплывчатыми, но роман, который они забыли когда-то давно, наоборот, возвращается и начинает играть новыми красками.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"614406","ru":"Вдох-выдох","en":"ჩაისუნთქე-ამოისუნთქე","year":"2019","type":"Фильм","rating":8.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/iDcvgfhJTynFKuZ3NfBzD23UwDI.jpg","genres":["драма"],"overview":"43-летняя Ирина возвращается домой из тюрьмы. После длительного срока заключения воссоединение с семьей оказывается совсем не таким, как она ожидала. Ей придется постепенно завоевывать доверие родных – дочери, сына и свекрови.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"776291","ru":"Ресторан «Токийский дракон»","en":"TOKYOドラゴン飯店","year":"2020","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/2UmkghOoTbql2tMRJqrRCmqQyQU.jpg","genres":["боевик","комедия","криминал"],"overview":"Два якудза на пенсии открывают лапшичную и становятся знаменитыми. Но внезапные обстоятельства вынуждают их снова вернуться в преступный мир.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1058644","ru":"Deep Rising","en":"Deep Rising","year":"2023","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ovyuMgPV4mI8BCBBzs9XCnrBGbs.jpg","genres":["документальный"],"overview":"Банда наемников отправляется на перехват океанского пассажирского лайнера с целью захвата драгоценностей и денег. Вооруженные до зубов, они рассчитывают на успех этой тщательно спланированной операции.Но боевая уверенность захватчиков сменяется ужасом перед небывалыми чудовищами, устроившими пир на корабле! У этих монстров здесь не было противников! И кровь тысяч людей не смогла утолить их жажду!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1160039","ru":"Миман","en":"미망","year":"2024","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8qxPynnRVj764yOE0CPA3TcTLKV.jpg","genres":["драма","мелодрама"],"overview":"Это история о мужчине и женщине, идущих вместе сквозь годы по меняющимся улицам Сеула. У корейского слова «миман» есть три значения: потерянный, сбитый с толку; неспособный забыть; видящий вещи общим взглядом, издалека. «Миман» снимался на протяжении четырех лет. Фильм наблюдает за небольшими трансформациями, за следами времени на телах актеров и теле города. Как Трюффо и Линклейтер, Ким Тхэяннапоминает нам, что кино – самая совершенная машина времени.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"645560","ru":"Quezon","en":"Quezon","year":"2025","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cdjr6ZAAm1rxdP1jR0tXdRqU7KO.jpg","genres":["драма","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1624564","ru":"Libang Libu","en":"Libang Libu","year":"2026","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/jM6ET38Xa0OECB3fIWMdYvQlJo5.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"903278","ru":"처제길들이기 오리진","en":"처제길들이기 오리진","year":"2021","type":"Фильм","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/uvqc36S9kqEPRbWbQC4tKeCUE1C.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""