ting":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/fBXGVnO9QCbFhJFXLZUWlO3aWLw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iAZxbaTMFJRido8cgVbl1JvSEEp.jpg","genres":["Боевик","Драма"],"overview":"В хаосе мира принц Ци узурпировал власть и тайно казнил наследного принца. В эту ситуацию непреднамеренно ввязался продавец древесного угля Тиан Анье. В смертельной борьбе были раскрыты тайны истории Тянь Анье и правда о людях города Лян.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1275585","ru":"Late Bloomer","en":"Late Bloomer","year":"2024","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/tuXnHiQkdINIFVio0DkIqSX2zNO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9XusP4gjv7VttiEjLVuzj0wAZqm.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"870932","ru":"For the Love of Money","en":"For the Love of Money","year":"2021","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/kEgIfSpuXkyNYT20TwH9HYkhkHE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/la14a9PiLEwixOR9MoCrLO1EUd3.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"953052","ru":"தேஜாவு","en":"தேஜாவு","year":"2022","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/un228GFGzr1ZLG0VvqeSP4P1C8P.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4k4nmZYyLX5fbFcO8kNDM05ZQXN.jpg","genres":["Детектив","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"894095","ru":"മ്യാവൂ","en":"മ്യാവൂ","year":"2021","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/mZCp9z5LCrMCTSnjmHuyBQ8k8aW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bS4EmS7z2wiWal3eutYI5mUUhWk.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"333854","ru":"Конец чудесного мира","en":"ワンダフルワールドエンド","year":"2015","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/b1q6QxJAIqVdMJUR745Dc12OU5A.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pvTB9tlyRvyeBLC8wvgg5InRHap.jpg","genres":["Драма"],"overview":"Семнадцатилетняя Сиори мечтает стать моделью и культивирует образ «готической Лолиты». Она ведет видео-блог и общается в нем со своими немногочисленными фанатами. Одна из ее поклонниц – тринадцатилетняя Аюми – убегает из дома, чтобы быть рядом с Сиори и начинает жить вместе с ней и ее бойфрендом, режиссером-неудачником Кавасимой. Сиори тяготится таким совместным житьем и после ссоры с Кавасимой уходит из дома. Обнаружив в сети блог-дневник Аюми, она узнает, как сильно и искренне та её любит.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"449253","ru":"Гори, ублюдок, гори!","en":"Burn Motherfucker, Burn!","year":"2017","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/nEFxVTf28wgGiI2kaPd0gyXA2kz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2AUkDmAp3faSww2K4Qvbw03UswO.jpg","genres":["Документальный","Драма"],"overview":"Глубокий и провокационный взгляд на волнения в Лос-Анджелесе 1992 года, исследующий корни гражданских беспорядков в Калифорнии и отношения между афроамериканцами и полицией Лос-Анджелеса.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"489038","ru":"Le Scandale Clouzot","en":"Le Scandale Clouzot","year":"2017","type":"Фильм","rating":6.5,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/ta6R8UZk6oH1MjYNkQLVELm3xLE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zF5XLEQuoHUrYUY6kJaFwV4rZPE.jpg","genres":["Документальный","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"404851","ru":"The 3 Tails : A Mermaid Adventure","en":"The 3 Tails : A Mermaid Adventure","year":"2015","type":"Фильм","rating":6.5,"votes