","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"401909","ru":"レインツリーの国","en":"レインツリーの国","year":"2015","type":"Фильм","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/cy4PefoTCDVnNPkcS8PY4qVuctE.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"480048","ru":"Instrument of War","en":"Instrument of War","year":"2017","type":"Фильм","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/eI4ZZCC1oDjszKJ5RH3BPCbkVca.jpg","genres":["военный","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"523997","ru":"Foster","en":"Foster","year":"2018","type":"Фильм","rating":6.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/oX7dOKsJTuS5Aaj6gywxs1XhyB3.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1201210","ru":"Колдун 0","en":"陰陽師0","year":"2024","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/lnXPR9I0EtLPbnX2slhzxQFFaIp.jpg","genres":["фэнтези","история","детектив"],"overview":"События разворачиваются в период Хэйан. Абэ Сэймэй – молодой студент Онмёрё. Школа воспитывает учеников, чтобы они стали онмёдзи, защищающими город от проклятий и злых духов. Сэймэй известен как гений в области магии, но в отличии от своих сокурсников, которые все стремятся стать онмёдзи, он не стремится пойти именно по этому пути. Однажды благородный Минамото Хиромаса просит его раскрыть странное явление, поразившее члена королевской семьи Ёсико. Сэймэй Абэ и Хиромаса Минамото работают вместе, чтобы разгадать странное явление.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1237266","ru":"Мой любимый двортерьер","en":"Runt","year":"2024","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/hBG0kI2qpcwMFHl6eCwWqp483sN.jpg","genres":["семейный","приключения","комедия","драма"],"overview":"Активная и предприимчивая девочка Энни подбирает на улице очень умного и сообразительного пса. Энни придумывает «двортерьеру» кличку Коротышка, и они быстро становятся лучшими друзьями. Чтобы помочь родителям выкупить дом, Энни решает принять участие в международном дог-шоу и выиграть крупный денежный приз. Вот только есть одна проблема: Коротышка боится выступать на публике, а все участники чемпионата - породистые собаки с большим опытом и хотят помешать успеху безродного новичка.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"606813","ru":"Огги","en":"Auggie","year":"2021","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/nOEjuCKjY03CgvozgDekcezJuVo.jpg","genres":["драма","фантастика"],"overview":"Феликс Грейстоун, уйдя на пенсию против своей воли, влюбляется в голограмму, что постепенно начинает разрушать его отношения с женой и дочерью.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1077297","ru":"Я весь внимание","en":"不虚此行","year":"2023","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/trTG5CH0RlsDtyuC0nTPLjn4DzU.jpg","genres":["драма"],"overview":"Вэнь Шань – неудачливый сценарист, пытающийся заработать на жизнь в Пекине. Он ведет унылое существование в быстроразвивающемся мегаполисе. По воле случая он начинает зарабатывать написанием надгробных речей: встречается с семьями усопших, внимательно наблюдает за ними, слушает их истории и тщательно записывает. Воссоздавая на бумаге жизнь других, он обретает себя в большом городе и начинает понимать, что и обычные люди могут оказаться в центре внимания.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"575072","ru":"Бег","en":"Бег","year":"2020","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/tacTMsV4ameSkiEBEdTit8iiIgT.jpg","genres":["триллер","драма","фантастика"],"overview":"Чемпион Европы по легкой атлетике Сергей Бороздин попадает в автокатастрофу. О большом спорте можно забыть, однако пережитый стресс дарует бегуну уникальную способность – на скорости он видит события из прошлого. В это время в городе орудует жестокий маньяк, нападающий на женщин. Каждая из его жертв как-то связана с Сергеем. Следователь полиции Настя, расследуя дело, подозревает Бороздина в этих преступлениях. Используя свои новые способности, Сергей решает остановить убийцу, не задумываясь о том, какую цену может за это заплатить.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1468057","ru":"角頭－鬥陣欸","en":"角頭－鬥陣欸","year":"2025","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/eoUcppppVNj8BkgBDkZTv82x3tx.jpg","genres":["криминал","боевик"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1279914","ru":"Sekawan Limo","en":"Sekawan Limo","year":"2024","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/4UI2gFUfdQsgZODb9axwse49Uhq.jpg","genres":["приключения","комедия","ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"716326","ru":"30 Rock: A One-Time Special","en":"30 Rock: A One-Time Special","year":"2020","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/1QteIDPXZeM6xQZPDfaqbLwfv8P.jpg","genres":["комедия","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1076497","ru":"Journey of Love 18+","en":"Journey of Love 18+","year":"2023","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/6CDgkXPMQfMt3Kity3VHtYQNTao.jpg","genres":["комедия","драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1062907","ru":"Guns & Moses","en":"Guns & Moses","year":"2025","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/xT88rTDQzZ1TOsiSpSY2jbvXVGM.jpg","genres":["криминал","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"735409","ru":"ファーストラヴ","en":"ファーストラヴ","year":"2021","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/asCwu9fihvw6tCwgNsXsKKEXm9v.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1181865","ru":"二手杰作","en":"二手杰作","year":"2023","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/4nnaovllxETxPv88w1MgCmHMRbJ.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"790233","ru":"Trafficked: A Parent's Worst Nightmare","en":"Trafficked: A Parent's Worst Nightmare","year":"2021","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/zu6oJbB8cjA25vnlNKrq7QPJqSv.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"258456","ru":"Без корней","en":"Köksüz","year":"2013","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/wNBwJNRkg3UnhyxHu26MxXNdyVA.jpg","genres":["драма"],"overview":"В семье случается несчастье. Отец внезапно умирает. Роль его должна взять на себя старшая дочь Фериде, поскольку мать Нурджан находится в беспомощном состоянии. Еще у Фериде есть младший брат Илькер и совсем маленькая сестра Озге, которых тоже надо кормить, одевать и воспитывать. По истечении некоторого времени, вся семья уже воспринимает Фериде в роли отца. Отношения в семье постепенно начинают рушиться для каждого члена семьи. Брат Фериде начинает постепенно отдаляться от семьи. В связи с этим, младшая сестренка чувствует себя очень одиноко. Мать относится к Фериде так, как-будто она потеряла не мужа, а дочь. Тогда Фериде решается на отчаянный поступок, который должен сделать жизнь каждого значительно лучше","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"351217","ru":"Шальные пули","en":"Stray Bullets","year":"2017","type":"Фильм","rating":6.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/rPfUyf0IuHJnbDfLtIPtWfNvTRe.jpg","genres":["криминал","драма","триллер"],"overview":"В пригороде Нью-Йорка пара подростков планирует посвятить день уборке в трейлере отца. Но когда мальчики оказываются в трейлере, то понимают, что в нём пытаются скрыться три беглых преступника.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}