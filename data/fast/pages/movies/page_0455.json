 на пенсию, и Юмико предложила ему заняться работой по дому. К тому же Мититаро с удивлением узнаёт, что у Юмико есть возлюбленный и они собираются пожениться. Мититаро не знает, куда девать внезапно образовавшееся свободное время и решает посетить занятия по художественной гимнастике в местном клубе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"445094","ru":"Une Nuit en Amérique","en":"Une Nuit en Amérique","year":"1975","type":"Фильм","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1cSruCYnxqf71em8WVyThGrh7Qx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gOD4BuwlOaM1WrdbQpOzkuqdheA.jpg","genres":["Детектив","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1088615","ru":"அநாகரிகம்","en":"அநாகரிகம்","year":"2011","type":"Фильм","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/jIgp8rJNMcISZfXmeIKjn0qf0Nr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hGBLhNvq5nDknULwhgsIrFyVeDR.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"696026","ru":"착한처제 2019","en":"착한처제 2019","year":"2019","type":"Фильм","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vnCyIfkkvfR4gPeaEZ7LQem5Bd7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nOhfvM24EBhHUFpGenyZIXX9ZHy.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"239241","ru":"くノ一忍法帖II 聖少女の秘宝","en":"くノ一忍法帖II 聖少女の秘宝","year":"1992","type":"Фильм","rating":8.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/i44fYoj4YqNFajpkPfRAqfuLW8k.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eUdlxiHayKITpb1fkC3Qg1G9NWh.jpg","genres":["Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"445177","ru":"È l'amor che mi rovina","en":"È l'amor che mi rovina","year":"1951","type":"Фильм","rating":8.0,"votes