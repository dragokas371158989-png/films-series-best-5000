y":"","ageRating":""},{"id":"1410189","ru":"Континенталь 25","en":"Kontinental '25","year":"2025","type":"Фильм","rating":6.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/9NMekIITIoYAHmyYA0iPEQYNZ7e.jpg","genres":["комедия","драма"],"overview":"Орсоля работает судебным приставом в Клуже, главном городе Трансильвании. Однажды ей приходится выселить бездомного из подвала, что приводит к трагическим последствиям и вызывает моральный кризис, который Орсоля пытается пройти как можно лучше.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"947166","ru":"ハケンアニメ！","en":"ハケンアニメ！","year":"2022","type":"Фильм","rating":6.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/hlom3uDLj2ZM2cHdcA8HWbGm4Sz.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"750587","ru":"Леди Ашер","en":"Lady Usher","year":"2021","type":"Фильм","rating":6.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/99yWXiMWoVFriv4Gyulc6cngOAW.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"517543","ru":"Как я стал русским","en":"Как я стал русским","year":"2019","type":"Фильм","rating":6.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/lrcnYE0lucH4LVYEBFEh9fS30Cs.jpg","genres":["комедия"],"overview":"Понравиться отцу своей невесты - задача не из лёгких. С этой проблемой сталкивается и китайский парень Пен, когда отправляется в Москву за своей любовью - Ирой, даже не подозревая, какой кошмар его ждет. Ведь её отец Анатолий совсем не готов отдавать свою дочь первому встречному, и у него на этот случай припасен свой план по избавлению... Однако, отцу невесты и жениху придется научиться уважать друг друга, если они хотят сохранить рядом с собой девушку, которую любят больше всего на свете.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"489327","ru":"Девушка брата","en":"Stella's Last Weekend","year":"2018","type":"Фильм","rating":6.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/oqsFCqfx5pngD5ZdZt7USbRGDwM.jpg","genres":["комедия"],"overview":"Джек уезжает учиться в колледж с разбитым сердцем, так как Вайолет бросила его, не назвав причины. Его младшему брату Оливеру повезло немного больше: он влюблён в девушку своей мечты и старается всеми силами добиться её расположения. Когда Джек возвращается домой на праздник, устроенный для любимца семьи старой собаки Стеллы, он обнаруживает, что Вайолет — и есть та самая девушка, в которую влюблён Оливер.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"278717","ru":"Испытание","en":"Испытание","year":"2014","type":"Фильм","rating":6.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/2dw04QwefGdYf1CVE2tAOfcRRnL.jpg","genres":["драма"],"overview":"Они живут в степи. Отец и дочь. Ничто не может нарушить вечный порядок. Завтра наступает всегда. И каждое утро отец уезжает работать. И она остается одна. Ждать отца. И чувствовать. Двое любят ее. Она любит каждого. Любовь нельзя поделить. Однажды решение приходит само. Оттуда, где солнце.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"407171","ru":"Подписано, запечатано, доставлено: Один шанс на миллион","en":"Signed, Sealed, Delivered: One in a Million","year":"2016","type":"Фильм","rating":6.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/jsXUbL2kn6tiBZK23Nm8CPH36Wg.jpg","genres":["мелодрама","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"334682","ru":"A Ballerina's Tale","en":"A Ballerina's Tale","year":"2015","type":"Фильм","rating":6.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/hC3NSqb2dwypTaZLQU2HxJUQuwE.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"360408","ru":"Jeff Dunham: Unhinged in Hollywood","en":"Jeff Dunham: Unhinged in Hollywood","year":"2015","type":"Фильм","rating":6.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/yBlrWOgFpmOZADx2mnM521z8p8H.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"781456","ru":"Форсаж. Китайский дрифт","en":"叱咤風雲","year":"2021","type":"Фильм","rating":6.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/5qbL6IhEpQjlzKtYD4Pvq4bcpoN.jpg","genres":["боевик","драма"],"overview":"Чтобы выиграть в чемпионате, гонщики берут в свою команду геймера, который мастерски играет в симулятор гонок...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"677053","ru":"Между двумя рассветами","en":"İki Şafak Arasında","year":"2021","type":"Фильм","rating":6.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/cgOSxbpsixBDDIRhu74BbLlORJ9.jpg","genres":["драма"],"overview":"Кадир - управляющий льняной фабрикой, принадлежащей его отцу. Вскоре он должен встретится с родителями своей невесты Эсмы, хотя его собственный отец еще не знает об их свадебных планах. Кадиру часто приходится находить баланс между тем, чтобы жить своей жизнью и удовлетворять желания своей семьи. Когда работник получает серьезную травму на производстве, ему приходится принять решение, которое повлияет на его мечты, его семью и жизнь жены пострадавшего работника.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"978024","ru":"Petites","en":"Petites","year":"2023","type":"Фильм","rating":6.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/iD6IsYagKnAWeYWmSyMAdlDJMmi.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"689927","ru":"JL Family Ranch: The Wedding Gift","en":"JL Family Ranch: The Wedding Gift","year":"2020","type":"Фильм","rating":6.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/CMUAwaNAnLEyployKEH16GBLU4.jpg","genres":["телевизионный фильм","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"323052","ru":"Рождественское обещание","en":"A Horse Tale","year":"2015","type":"Фильм","rating":6.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/iyVFjdvG4CFHV7mwxREx3npOr3V.jpg","genres":["драма","семейный","мелодрама"],"overview":"Отец-одиночка Майкл вместе с мятежной дочерью Хлоей приезжает на семейное ранчо накануне Рождества. Он встречает здесь новую любовь, а Хлоя – нового друга: прекрасную лошадь Холли. Патрик Малдун («Звёздный десант») и Харизма Карпентер («Баффи – истребительница вампиров») в легком душевном фильме для всей семьи «Рождественское обещание».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"593911","ru":"Sunrise in Heaven","en":"Sunrise in Heaven","year":"2019","type":"Фильм","rating":6.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/a8cOgXD0v1RHP9g4ODYIHX0slOY.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"254304","ru":"女子ーズ","en":"女子ーズ","year":"2014","type":"Фильм","rating":6.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/a5A5SffM4m2wQWHXXRm1b4OqMml.jpg","genres":["фантастика","боевик","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"274110","ru":"Ciudad delirio","en":"Ciudad delirio","year":"2014","type":"Фильм","rating":6.4,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/8NA0PfeVy5WDPBqbOcmD63jrHgB.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1581099","ru":"Кевин Харт: Соответственно возрасту","en":"Kevin Hart: Acting My Age","year":"2025","type":"Фильм","rating":6.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/89HPieER8jX9sGKKzhagGIGkMxi.jpg","genres":["комедия"],"overview":"Он стал старше и мудрее, но остался таким же смешным. Кевин Харт рассказывает о неудачах, поджидающих в середине жизни: от таблеток для интима до неожиданных травм.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"883876","ru":"Рождественская звезда","en":"A Christmas Star","year":"2021","type":"Фильм","rating":6.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/4asmX8Kku5IWw6STWVcztUrp0EF.jpg","genres":["комедия","мелодрама","телевизионный фильм"],"overview":"Мэделин, женщина-астроном, узнаёт, что незадолго до Рождества над небольшим городком в небе будет виден метеоритный дождь. Она отправляется в путь, чтобы стать свидетельницей своего открытия. По пути у нее спускает колесо, и Мэделин знакомится с обаятельным рейнджером Райаном. Новому знакомому она объясняет: чтобы увидеть звёздной небо, жители городка должны ненадолго выключить все рождественнские огни. Но как убедить людей отказаться от традиций и атмосферы всеобщего праздника?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"910768","ru":"Влюблённые дворецкие","en":"Butlers in Love","year":"2022","type":"Фильм","rating":6.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/dfNuyNMva5DJ9E2mM5t5ZDwYZjI.jpg","genres":["мелодрама","телевизионный фильм","комедия","драма"],"overview":"В детстве у Эммы было любимое телешоу «Пламшир Мэнор», благодаря которому она стала мечтать о том, чтобы стать дворецким. Сейчас она уже взрослая, получила два высших образования и выучила несколько иностранных языков, но школа дворецких всё равно её не приняла. Внезапно Эмме позвонил Чарльз Уиллоуби, декан Американской академии дворецких. Он сообщил, что один из студентов бросил учёбу, и поэтому освободилось место для неё. Эмма с радостью согласилась. По приезду она стала пытаться произвести на всех позитивное впечатление, в том числе и на свою соседку по комнате в общаге Лизу. Впрочем, довольно быстро у неё появился и враг - Генри. Весьма надменный, наглый парень, что без всякой причины вредит ей, при этом ведя себя не так, как полагается вести прислуге.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"728699","ru":"Secrets in the Snow","en":"Secrets in the Snow","year":"2020","type":"Фильм","rating":6.4,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/xCBq7j42ewyYGTqS31Srnfb6Mm3.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"761226","ru":"Welcome Home","en":"Welcome Home","year":"2020","type":"Фильм","rating":6.4,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/1DGxRaBMIQFzeyHGHBhwrXGLlxE.jpg","genres":["драма","ужасы","триллер"],"overview":"Молодая пара отправляется на отдых в тихий уголок Италии, чтобы спасти свои отношения. Но у владельца дома, где они поселились, есть зловещие планы на новых гостей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"287859","ru":"Раджа Натварлал","en":"Raja Natwarlal","year":"2014","type":"Фильм","rating":6.4,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/zhg3DSZjgRhUrO28U8n7QJLPpCl.jpg","genres":["триллер","драма","детектив","криминал"],"overview":"Раджа - мелкий мошенник, Натварлала наших дней, и его подельник Рагхав живут в Мумбаи, промышляя карманными кражами. Во время одной из таких операций, Рагхава убивают. Жизнь Раджи кардинально меняется. Он решает отомстить крикетному фанатику миллионеру Варду, чьи подручные убили его друга. Варда могущественный и влиятельный, справиться с ним нелегко. Вот поэтому Раджа решает объединиться с Йоги, старым и опытным мошенником.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"463752","ru":"بنك الحظ","en":"بنك الحظ","year":"2017","type":"Фильм","rating":6.4,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/p27n1OtvvHKIJLWFXAnAUoNUFqD.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"461809","ru":"बाबूमोशाय बन्दूकबाज़","en":"बाबूमोशाय बन्दूकबाज़","year":"2017","type":"Фильм","rating":6.4,"votes":26,"poster":"https: