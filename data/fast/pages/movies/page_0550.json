ating":""},{"id":"1032412","ru":"Snow Day","en":"Snow Day","year":"2022","type":"Фильм","rating":6.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/dnwf2DyI41EkWvJnOLfWV6DFRNW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sGCvCVGf7VGs2JHvEIpm001U4H5.jpg","genres":["телевизионный фильм","семейный","комедия","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"505204","ru":"Маленькая мисс Дулиттл","en":"Liliane Susewind - Ein tierisches Abenteuer","year":"2018","type":"Фильм","rating":6.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/lXVTVUOiZgXLAxVOZXhFwwfpv7j.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Z6qsRVE80MMLOVLZKEQ3vtslS9.jpg","genres":["комедия","семейный","фэнтези","криминал"],"overview":"Рыжеволосая Лилиан не просто обожает животных, но и умеет понимать их язык и отвечать им. О ее невероятной способности знают только члены семьи, и они всячески оберегают тайну. Но любым тайнам в свое время всегда приходит конец, особенно если на кону стоит спасение животных.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"478426","ru":"Вествуд: Панк, икона, активист","en":"Westwood: Punk, Icon, Activist","year":"2018","type":"Фильм","rating":6.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/orlVKGNSyYSbsifv4oaO2tzUNpS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t098nulsb7y0yHPw1SiROWu3fuA.jpg","genres":["документальный"],"overview":"Вивьен Вествуд — легенда лондонского стиля, его создатель и разрушитель. Дизайнер одежды, она с самого начала заявила о себе как явлении культуры. Сегодня Вествуд — гранд-дама, кавалер ордена Британской империи, бунтарь и активист — по-прежнему живет и работает в Лондоне, где издавна уживаются королевская корона и панковская булавка.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"267310","ru":"Самый порядочный","en":"Der Anständige","year":"2014","type":"Фильм","rating":6.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/op3ALriHNf0mHXHo7STgZG07bJH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tCOZXkXlLHrxPwjIo0yH42NBP9d.jpg","genres":["документальный","военный"],"overview":"Документальный фильм о неизвестной стороне жизни одного из главарей третьего рейха Генриха Гиммлера. В основу ленты положена переписка рейхсфюрера СС со своими родными и близкими, свидетельствующая, что нацисты вовсе не были монстрами, а были обычными, психически нормальными людьми, но, поставленные в особые обстоятельства, сделали роковой выбор в пользу зла.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"485336","ru":"Urban Country","en":"Urban Country","year":"2018","type":"Фильм","rating":6.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/4j5XVlw856u9K5NS3XgKRs92ei7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iSZaoeDOdNmRuiDeovhXeUS3rd2.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"295099","ru":"The Go-Go Boys: The Inside Story of Cannon Films","en":"The Go-Go Boys: The Inside Story of Cannon Films","year":"2014","type":"Фильм","rating":6.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/o8jvcs3XryykNaymmL2cMQtVvCd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Rbz276DvQ1l0ung6HvJ7xfrBeB.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"876444","ru":"Одна декабрьская ночь","en":"One December Night","year":"2021","type":"Фильм","rating":6.4,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/jtzju1ZyZOEC6Vr29zqYaxfJAhr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qHPd5T4huGl8FZqBNq7Ljk7lE0z.jpg","genres":["телевизионный фильм","комедия","мелодрама","семейный"],"overview":"Майк и Стив - выступавшие в дуэте легендарные в прошлом певцы. Два музыкальных менеджера, которые по стечению обстоятельств являются их детьми, должны сделать всё, чтобы их отцы помирились и снова выступили вместе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"695951","ru":"चेहरे","en":"चेहरे","year":"2021","type":"Фильм","rating":6.4,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/egpv58u11MxepnNwXtzdMOagRdg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ooRitBGGEalBFmnPFQCcQpehkBC.jpg","genres":["триллер","детектив","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"756727","ru":"Heart of the Holidays","en":"Heart of the Holidays","year":"2020","type":"Фильм","rating":6.4,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/c6gsHd757ghfcZHpR9RjzYz2vBp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/phMbsc8EvcW6nuQ3K0WBwno1MYk.jpg","genres":["телевизионный фильм","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"338353","ru":"Большая игра Денниса Родмана в Пхеньяне","en":"Dennis Rodman's Big Bang in PyongYang","year":"2015","type":"Фильм","rating":6.4,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/qQLs7mDSDhbcxVpZbgC7etgu9Rn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k9bY2L8mwdIujudB2cz68i7S6yH.jpg","genres":["документальный"],"overview":"В феврале 2013 года знаменитый баскетболист Деннис Родман впервые посетил Северную Корею. Там он лично познакомился с Ким Чен-ыном и они стали друзьями. Тогда-то Родман и задумал провести матч между национальной сборной КНДР и ветеранами НБА.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"265602","ru":"Zoe Gone","en":"Zoe Gone","year":"2014","type":"Фильм","rating":6.4,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/gsUOzybvOsr4GqGcZFQQotOgGtH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wzT9WNfr9BKoBfdihyKpp6m3cku.jpg","genres":["криминал","детектив","драма","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"361358","ru":"信長協奏曲","en":"信長協奏曲","year":"2016","type":"Фильм","rating":6.4,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/7m7NfEha4TllaCrtq9Sq22rPhhk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1TobPAXfduZtJ91j280pGZPGJWM.jpg","genres":["боевик","комедия","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"256108","ru":"Zwischen Welten","en":"Zwischen Welten","year":"2014","type":"Фильм","rating":6.4,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/iJaUEVUtSfvoPyltfBCTkgHezXb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sbWifqkLBEkVtqQ9JksQUoLzBbE.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1000780","ru":"Кровоточащая любовь","en":"Bleeding Love","year":"2024","type":"Фильм","rating":6.4,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/u0kooo5MQ2BSoVcUJvAWJ4flE2Q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AlLUCXfvxs1jVC2VEcBt7U7YY7d.jpg","genres":["драма"],"overview":"На старенькой машине отец везёт 20-летнюю дочку-наркоманку, недавно пережившую передозировку, к приятелю в художественную студию в надежде, что дочь снова начнёт рисовать. В пути они встречают разных людей, вспоминают прошлое и пытаются наладить отношения.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}