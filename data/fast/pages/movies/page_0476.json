.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/AlhSsA8Uqp4OVEZ2IXs1Ac6nlXw.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"380174","ru":"La queue","en":"La queue","year":"2014","type":"Фильм","rating":7.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/Ah4e5DBcWhLsufkpwVTuFiUnaEP.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"282377","ru":"The Lord of Catan","en":"The Lord of Catan","year":"2014","type":"Фильм","rating":7.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/fiz2vB7h0K87h8YVXM2xQOpwaic.jpg","genres":["комедия","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1431071","ru":"Система","en":"सिस्टम","year":"2026","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ddSTqsxOoXs77xnKpP7XBPqiero.jpg","genres":["триллер"],"overview":"Прокурор Неха из влиятельной семьи юристов и простая стенографистка Сарика сталкиваются в суровой судебной системе. В мире, где влиятельные люди диктуют свою правду, двум непохожим героиням придется переосмыслить свои убеждения и выяснить, что такое истинное правосудие.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1372178","ru":"Плохие соседи","en":"Grannfejden","year":"2026","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/2HJ9Q9fygrbin9HYQ0iXkKhazj5.jpg","genres":["драма","комедия"],"overview":"После скандала в соцсетях инфлюэнсер Ханна возвращается в родную деревушку, где ей приходится выбирать сторону в противостоянии бывшего премьер-министра и его эксцентричного соседа.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1516884","ru":"Ресторанчик Ки Нам","en":"Quán Kỳ Nam","year":"2025","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/yNdB4HKfOXPaQLzUlRq81DbTKnh.jpg","genres":["мелодрама"],"overview":"Сайгон, 1985 год. Кханг, молодой переводчик, делающий карьеру при новом вьетнамском режиме, получает задание перевести сказочную повесть «Маленький принц». Его жизнь кажется благополучной, но всё меняется, когда он знакомится со своей соседкой, замкнутой вдовой Ки Нам. Пережиток побеждённого Юга, она тихо живет рядом, зарабатывает приготовлением еды и мучается от невысказанной скорби. Когда из-за несчастного случая она временно лишается возможности работать, Кханг предлагает ей помощь. То, что начиналось как добрый поступок, постепенно перерастает в нечто гораздо более значимое. Но в мире, где правит диктатура, страсть может оказаться роковой, а любая связь – недолговечной.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1233708","ru":"Манюня: Новогодние приключения","en":"Манюня: Новогодние приключения","year":"2023","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/sj0pbCAWzDbwA2S9qziLk4D4Hqr.jpg","genres":["драма"],"overview":"Новый год для Манюни, Наринэ и Каринэ может пойти не по плану: синоптики обещают аномально теплую зиму, а это значит, что приход Деда Мороза оказывается под угрозой! Их семьи экстренно принимают решение — отправиться в горы. Полная приключений дорога приводит героев в заветный дом, который становится разочарованием: грязь, сырость, сломанная мебель, а главное — непрошенные гости. Удастся ли им подружиться, найти праздничное настроение и встретить Новый год по-настоящему волшебно?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1416699","ru":"(Не)искусственный интеллект","en":"(Не)искусственный интеллект","year":"2025","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/opIF0jyfWv3u28DckTVD0ZECsvR.jpg","genres":["приключения","комедия","семейный","фантастика"],"overview":"Во время экскурсии в научно-исследовательском центре 17-летний студент- первокурсник Женя случайно попадает в испытательный образец новой модели робота «Апостол» (A.P.O100L), обладающего собственной волей и разумом. Получив случайного пилота, машина берет управление на себя и принимает решение сбежать из лаборатории. Теперь, чтобы вернуться домой, Жене придется найти с искусственным интеллектом общий язык.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1324379","ru":"Втроём","en":"Втроём","year":"2024","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/fCqexcPtOGdTZEeLZeLIuJvtng2.jpg","genres":["комедия","мелодрама"],"overview":"У Даши, на первый взгляд, не жизнь, а сказка. Она занимает высокий пост в Министерстве культуры, в неё влюблен молодой человек, который купил квартиру для их будущей семьи. Но на самом деле – на работе не все гладко, новая квартира – с видом на пустырь, а возлюбленного больше интересует мнение мамы. Даша решается на побег – в командировку по Пермскому краю. Её внезапным попутчиком становится молодой владелец бара Сергей. Теперь чужим друг для друга людям придется проехать по пермским городам и селам, встретиться с людьми, которым чужды амбиции и суета мегаполиса.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"776785","ru":"Мы есть. Мы рядом","en":"Ми є. Ми поруч","year":"2021","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/t6y1RnsXGxfJIqByGuBkvd91rTL.jpg","genres":["драма"],"overview":"Внезапная встреча хирурга и загадочной девушки переворачивает их жизни, наполняя их глубокими чувствами. Они становятся друг для друга смыслом и готовы бороться за свое счастье против всего мира.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"655830","ru":"Лайла и Маджнун","en":"Layla Majnun","year":"2021","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cYpL6ewMXU3V4SQdYHsKTdZSYC8.jpg","genres":["драма","мелодрама"],"overview":"В Азербайджане индонезийская ученая Лейла влюбляется в Самира, поклонника ее работ, но ее брак по договоренности встает у них на пути.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"759241","ru":"Легендарная морская рыба","en":"海大鱼","year":"2020","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/er4QPGvd8xqwV2Jol3UGtTErskM.jpg","genres":["драма","фэнтези","триллер","история"],"overview":"Легенда гласит, что в Северном море живёт дух Хайру - Бог Моря. Раз в 100 лет одна выбранная девушка должна стать его женой. Али живет в деревушке на берегу моря и мечтает однажды выйти замуж за своего возлюбленного Вэнью. Но этому не суждено сбыться: морские пучины вновь требуют невесту для Бога Моря. Али противится выбору сельчан, но смиряется судьбе, когда понимает, что Вэнью предал её. Что ждет Али за туманом, скрывающим остров, где живет Хайру? Сможет ли она принять уготованную ей участь или же отыщет обратный путь домой? Или, возможно, она обретёт своё истинное счастье.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"911835","ru":"숙모","en":"숙모","year":"2021","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/zTZqwdxVPs0Qmx4gVejnWWdmudD.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1589713","ru":"Badut Gendong","en":"Badut Gendong","year":"2026","type":"Фильм","rating":7.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/kIAltyOVZFIRFFFgBUBABb0HyF7.jpg","genres":["боевик","драма","ужасы","фэнтези","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1211185","ru"