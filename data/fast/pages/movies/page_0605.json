у она внедряется в семью в качестве няни и не останавливается ни перед чем, чтобы заполнить темную пустоту, которая жаждет справедливости.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"458759","ru":"Интерлюдия в Праге","en":"Interlude in Prague","year":"2017","type":"Фильм","rating":5.8,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/ezr5CpZMAQiy1T8GHNtcLxNaKG9.jpg","genres":["драма","музыка"],"overview":"Премьра оперы Вольфганга Амадея Моцарта «Свадьба Фигаро» имела огромный успех в Праге, и известный композитор был приглашён в город, чтобы лично дирижировать оркестром в Сословном театре. Там он начинает работу над своей новой оперой «Дон Жуан». Однако пребывание в Праге приводит к ряду драматических и трагических событий в жизни великого композитора.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"427433","ru":"冲天火","en":"冲天火","year":"2016","type":"Фильм","rating":5.8,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/lHvZUgSD7qRokJCZV500PLuD9Os.jpg","genres":["боевик","криминал","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"450248","ru":"Av. Larco","en":"Av. Larco","year":"2017","type":"Фильм","rating":5.8,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/ozG4f0FLr0yPJtU3clFBJVdsNaw.jpg","genres":["история","музыка","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448090","ru":"Mommy's Little Boy","en":"Mommy's Little Boy","year":"2017","type":"Фильм","rating":5.8,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/dvoqYQEk4SSXTuT7PQ4z3NE2QAK.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"472722","ru":"Party Boat","en":"Party Boat","year":"2017","type":"Фильм","rating":5.8,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/kWk9NJvlEqIcl98wK3nQDYTFmys.jpg","genres":["комедия"],"overview":""