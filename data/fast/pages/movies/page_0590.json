ajTXgMuMwgmxam5GKrGH.jpg","genres":["музыка","документальный","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"463337","ru":"Dear Albania","en":"Dear Albania","year":"2015","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/jlWGtZ1Y139ITw4DUKeYNmKrWOQ.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1212403","ru":"Haircut","en":"Haircut","year":"2014","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/zesdO9WRj0w8NFHKFjmZ2IfcUcn.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"639453","ru":"77 согретых сердец","en":"感動她77次","year":"2021","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/aqcsd3kiWQFZbaCo7iB7P1FVDN.jpg","genres":["мелодрама","драма"],"overview":"10-летние отношения Евы и Адама закончились. Тем не менее, они немного скучают друг по другу. Встреча с новым мужчиной и неожиданная болезнь матери Евы приводят к тому, что Адам решает вернуть Еву.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1057888","ru":"Сухой лист","en":"ხმელი ფოთოლი","year":"2026","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fCbXztJ5vAmVB6gXue2aN1cOLhz.jpg","genres":["драма","фэнтези"],"overview":"Отец разыскивает свою дочь Лизу — спортивного фотографа, которая исчезла, снимая сельские футбольные поля по всей Грузии. В поисках ему помогает её загадочная лучшая подруга.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1517069","ru":"Марк глазами Софии","en":"Marc by Sofia","year":"2026","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/Qi9HQXNK7W9zrPm4fAnD5RvqMr.jpg","genres":["документальный"],"overview":"Портрет Марка Джейкобса — одного из ключевых американских дизайнеров современности, прошедшего путь от гранжевой революции до работы в Louis Vuitton и создания собственного бренда. Джейкобс оказывается в объективе давней подруги Софии Копполы, которая превращает закулисье показа весна-лето 2024, архивные съемки Нью‑Йорка 1970-1990‑х и доверительные разговоры в рассказ о дружбе, вдохновении и моде.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1545976","ru":"Картины дружеских связей","en":"Картины дружеских связей","year":"2026","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/uJ0Pg27kEOXWUzbvbNFnnxAFAvF.jpg","genres":["драма"],"overview":"Один зимний день и одна ночь из жизни тридцатилетних друзей, бывших однокурсников. Им нужно преодолеть бытовые трудности, чтобы встретиться и проводить Сашу, надолго покидающего Москву.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1538316","ru":"Дополнительное время","en":"Дополнительное время","year":"2026","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/zPfxIHCtea9pSmrCb9BTPcLSd2E.jpg","genres":["семейный","приключения"],"overview":"Сводные братья Женька и Тёма недолюбливают друг друга, несмотря на игру в одной хоккейной команде и жизнь под одной крышей. Профессор Максим Муромцев, он же отец Тёмы, работает над машиной времени. Оказавшись в его лаборатории, ребята случайно переносятся в 1999 год, где встречают 12-летнего Вадима Шипачёва — будущего звёздного хоккеиста и главного кумира Женьки. Теперь ребята должны успеть помочь Вадиму поверить в себя и следовать мечте до того, как они смогут вернуться в настоящее, чтобы привести свою команду к победе.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1315477","ru":"Халлан","en":"한란","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/mSnjSyBA1JLakusxZ2Hryzpw1ee.jpg","genres":["драма"],"overview":"Молодая мать с маленькой дочерью выживает как может в нелёгкое время на острове Чеджу.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1083665","ru":"Чудовище глубин","en":"深海大鱼","year":"2023","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/cqo0hVifRmsSwHg6tAP1nF3f9eB.jpg","genres":["боевик","фантастика","триллер","ужасы"],"overview":"Жена Чжан Яна погибла в автокатастрофе, а дочь сильно болеет, поэтому Чжану срочно нужны деньги. Поэтому он поддался уговорам шурина и согласился участвовать в одном сомнительном деле. Однако на корабле, куда они планировали попасть, оказался морской монстр, вырвавшийся из секретной лаборатории.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1507796","ru":"На море","en":"On the Sea","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hP4JpQe7F7rcs5lOH97fM7kaSFs.jpg","genres":["драма","мелодрама"],"overview":"Джек женат на Мэгги уже больше половины своей жизни. Он работает на плантациях мидий в Северном Уэльсе вместе со своим младшим братом Дайфаном и тремя его сыновьями. Джек всегда считал, что его собственный сын Том после окончания школы продолжит семейное дело, но нежелание Тома идти по его стопам приводит к напряжённости в семье. Ситуация накаляется ещё больше с появлением странствующего матроса Дэниела, который не скрывает своих чувств к Джеку. В этой отдалённой сельской общине, где жизнь вращается вокруг церкви и рыболовства, Джек сталкивается с неразрешимой дилеммой.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1411301","ru":"Цвет под подозрением: документальный фильм","en":"To Dye For: The Documentary","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/8vPfPIBpW3jP7rZkZeaw8GImgIN.jpg","genres":["документальный"],"overview":"После того как родители обнаруживают у своего ребёнка тяжёлую чувствительность к синтетическим красителям в пище и других продуктах, они отправляются в личное расследовательское путешествие и снимают документальный фильм о последствиях таких добавок для здоровья. По ходу фильма они встречаются с ведущими мировыми специалистами по синтетическим красителям — учёными, токсикологами и исследователями, а также общаются с другими семьями, столкнувшимися с подобной проблемой. История сочетает влоговые элементы, интервью и личные семейные моменты, постепенно раскрывая шокирующие факты и неожиданные открытия о влиянии красителей на детей и взрослых.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1523445","ru":"День рождения Сидни Люмета","en":"День рождения Сидни Люмета","year":"2026","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4Hy5qwC37COYSEkZA76ieo1HT2E.jpg","genres":["драма"],"overview":"Семнадцатилетний грузин Дато и его бабушка пытаются найти общий язык на руинах когда-то большой семьи. Все идет по плану, пока внезапно после долгих лет отсутствия на пороге не возникает мать Дато.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1577602","ru":"Рождественский билет","en":"The Christmas Ticket","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/dvFrgNuGm41wLNQAsQHRzDzVfbn.jpg","genres":["мелодрама"],"overview":"За неделю до Рождества Алана получает в наследство от дедушки загородный дом. Вскоре она выясняет, что где-то в доме он, вероятно, спрятал лотерейный билет с крупным выигрышем.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"693845","ru":"ДАУ. Нора Сын","en":"ДАУ. Нора Cын","year":"2020","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/bvPdCuiJhtJCllDjZbyGGynEEFI.jpg","genres":["драма"],"overview":"Чуждые всему научному институту, в котором живут, одинокая домохозяйка и ее сын-подросток нарушают последнее табу. Тайну знают только они двое и их покорная горничная.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"845788","ru":"Необычные истории. Специальный летний выпуск","en":"世にも奇妙な物語 '21夏の特別編","year":"2021","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rB0V4Pc5meRdPTXysiJGH4nnaqV.jpg","genres":["драма","фэнтези"],"overview":"\"Я умру через 15 секунд\" Посреди ночи фармацевту Миками Мегуми (Митико Йошисе) выстрелили в сердце сзади, и время внезапно остановилось. Осталось жить еще 15 секунд, и она может начать останавливаться в любое время в течение этих 15 секунд, и ей интересно посмотреть, как она их потратит. Миками предпочел ясно видеть лицо убийцы, и всего за несколько секунд спроектировал ситуацию, когда убийца вырыл бы себе могилу, но почему убийца хотел убить убийцу?Это все просто чистая обида?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"579731","ru":"Печень, или История одного стартапа","en":"Печень, или История одного стартапа","year":"2021","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3wKYcY2cJanKxo8lMQy2AA9puHh.jpg","genres":["комедия","криминал"],"overview":"1990-е. Три друга Вова, Мамед и Лёха учатся в школе и мечтают, как и все в России в это время, открыть собственный бизнес. Но для начала нужны деньги. Всё, вроде бы, складывалось хорошо, но их не допустили до выпускных экзаменов. Его величество случай в образе районного полукриминального авторитета Костика приходит на помощь начинающим предпринимателям. У Костика сгнила печень - нужна новая. Юные бизнесмены достают вожделенный орган, но только с ним, с этим органом, не все так просто.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1500148","ru":"Цинтун и Куйхуа","en":"青銅葵花","year":"2026","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/tQB9biQwL1blSHkT9sJhQxnUS4P.jpg","genres":["драма","мелодрама"],"overview":"Потеряв в жизни всё, главная героиня фильма обретает семью.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"663971","ru":"Русские грузины. Фильм первый","en":"Русские грузины. Фильм первый","year":"2020","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/gRWIao0KW8ae72X1NcFzqvEBF0Y.jpg","genres":["документальный"],"overview":"Фильм об исторической роли грузин в российской, а позже — советской политике, культуре и науке. Герои фильма — Багратион и Шеварднадзе, Пиросмани и Данелия, Баланчин и Андроников.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1193774","ru":"Hijo, amo tu boca","en":"Hijo, amo tu boca","year":"2023","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/bU5PA9DmgEjgQVhm1dNrRpBcJZ5.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"701469","ru":"Robbers: A The 1975 Documentary","en":"Robbers: A The 1975 Documentary","year":"2020","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/8yNylFBfU3NEb7GVKrQNMnu64KR.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1443374","ru":"森中有林","en":"森中有林","year":"2026","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/2lCe3wAq9KpyHwRZo28PeRMZgFm.jpg","genres":["драма","мелодрама","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},