е тайны.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1371643","ru":"In My Dreams","en":"In My Dreams","year":"2019","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/on12ckYyJZoF0jfdbq1eTtJolRw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7pnm2yxYKYoQkoiDJCwMPISbPRL.jpg","genres":["мелодрама","детектив","ужасы","фэнтези"],"overview":"Ник и Натали являются идеальной парой, только они в действительности никогда не встречались. Однажды бросив монетки в фонтан Хэйвард, они стали грезить друг о друге. По легенде фонтана, у них есть ровно семь дней, чтобы превратить свои грёзы в реальность.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1710089","ru":"A normal lunch","en":"A normal lunch","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/usyweRSmmtVIoarzAKxS9iKp5bL.jpg","backdrop":"","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1669302","ru":"the road where i go to die","en":"the road where i go to die","year":"2026","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7njNJEmwi8ukxDmz9OwDq0fEict.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1669028","ru":"Yellow Mellow","en":"Yellow Mellow","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/iSqtpJn2XelHIdHVEQvf9AQXHV8.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1646687","ru":"El Payaso Vinagre","en":"El Payaso Vinagre","year":"2023","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lwo9Ahi5DPMENPtdoUb3NnFhbrB.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1645836","r