:"","country":"","ageRating":""},{"id":"491020","ru":"Flashburn","en":"Flashburn","year":"2017","type":"Фильм","rating":3.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/v8j9xPt4t5QvuDbc0Hsn1pM1Cb6.jpg","genres":["фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"356631","ru":"Les trois soeurs","en":"Les trois soeurs","year":"2015","type":"Фильм","rating":3.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/lVu5C3g9tcU6F8KhPwvab9cQcNs.jpg","genres":["драма","телевизионный фильм"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"594958","ru":"Ключ времени","en":"Ключ времени","year":"2020","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/jkKOr6Jj078T5FzUUb4ETjNlFGM.jpg","genres":["фэнтези"],"overview":"Бездетные супруги писатель Андрей и художница Ольга удочеряют восьмилетнюю Ксюшу. Директором детского дома, где воспитывалась девочка, оказывается бывшая подруга Андрея Ирена. Она до сих пор страстно любит Андрея и намерена вернуть его любой ценой, пускай для этого придётся разрушить его семейное счастье. Тем временем Андрей сочиняет фантастический роман о темной стороне Петербурга. На страницах его книги город на Неве превращается в фантасмагорический мир, где само время остановилось, а улицы населяют бездушные твари. Внезапно Ксюша попадает в мир «темного Петербурга» из романа Андрея, где встречает таинственного друга Парамона. Героев ждёт немало опасных приключений…","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"750602","ru":"Estándar","en":"Estándar","year":"2020","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/yDJCYI9A4Kl6uURwy5ysgave25F.jpg","genres":["комедия","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"737759","ru":"Camp Murder","en":"Camp Murder","year":"2020","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/5cPXVvgucgjj6CifYOair35YDOY.jpg","genres":["драма","ужасы","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"435038","ru":"ചായം പൂശിയ വീട്","en":"ചായം പൂശിയ വീട്","year":"2015","type":"Фильм","rating":3.6,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/milQQcApBicb9x4ishCMA5zYz8c.jpg","genres":["драма","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1047622","ru":"Laruan","en":"Laruan","year":"2022","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/qYRXXpUPnAQ38yGc0uz0PTl5nNj.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1082791","ru":"Wolf Hollow","en":"Wolf Hollow","year":"2023","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/ghhJNi3UkvRdZUwtghzqF0fcuwo.jpg","genres":["ужасы","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"676372","ru":"Lie Exposed","en":"Lie Exposed","year":"2020","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6kN5cRip4IMGWxPIJ2RzlUAZNW7.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1060057","ru":"An Affair to Forget","en":"An Affair to Forget","year":"2022","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/cpFf6LRdlOCrmWgEhilCicD2j6d.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"259712","ru":"Саймон","en":"Simon","year":"2016","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/iJgbUKHZGT6VrCMV05aojPJmCfk.jpg","genres":["триллер","ужасы","драма"],"overview":"Журналистка криминальной хроники проникает в дом убийцы, чтобы добыть доказательства его вины. Но он возвращается раньше и начинается игра в кошки-мышки со смертельным исходом.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"583247","ru":"Хорошая игра","en":"İyi Oyun","year":"2018","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/dPrX8RB8ZU7kksJdXZICQRlOzGl.jpg","genres":["комедия"],"overview":"Кибертурниры пользуются огромной популярностью среди многомиллионной аудитории геймеров всего мира. Главный герой Дженк, после окончания учёбы устраивается работать в интернет-кафе, где играет за другие команды, зарабатывая на этом. Так он помогает больной сестре. Менеджер команды геймеров замечает талантливого парня и предлагает ему стать членом команды и принять участие в большом турнире.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"699351","ru":"5G Zombies","en":"5G Zombies","year":"2020","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/9NIsRwHdojUsAqPGPAyZmtgF49u.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"340551","ru":"Ралука","en":"Raluca","year":"2014","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/2iwG0HRBf3kYKnPm1Atl68IrLde.jpg","genres":["триллер","криминал","драма"],"overview":"Послужной список Филипа Маролда в полиции подпорчен, и теперь он перебивается частным сыском, выслеживая неверных мужей и жен. Во время очередного (на первый взгляд ординарного) дела, он встречает в баре красивую румынку. Слишком большой любитель женщин, чтобы даже задуматься над случайностью такой встречи, он очертя голову бросается в новую интрижку. Даже не подозревая при этом, куда она его заведет. К сожалению, три превосходных эротических сцены вырезаны из этого эротического триллера и детектива (они есть в допах). Непонятно, чем они жестче тех, которые оставлены. Похоже, Чехия хочет утвердиться в списке стран с тупой цензурой. Замечательна главная героиня. Одна из безусловно «плотских» актрис, типа Вицы Керекеш.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"290725","ru":"Lazarus: Apocalypse","en":"Lazarus: Apocalypse","year":"2014","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/8OIdlTc4kEpjdjE9Br3b8Zi8Kkf.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"382569","ru":"奔爱","en":"奔爱","year":"2016","type":"Фильм","rating":3.6,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/28jo0AfPjW4vW0pAdmzsLgtbWdC.jpg","genres":["комедия","мелодрама","драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}