mdb.org/t/p/w342/nIIUpF9EaSGsrXyuPBGxifSCgNe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s1Dn3ZNld1Z8jJOHRA05nR1dvAF.jpg","genres":["Фэнтези","Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1036921","ru":"Миссис и …","en":"And Mrs.","year":"2024","type":"Фильм","rating":5.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/xhgwgQ67dxKFy1hntUpivu8URY9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dqkxPQPH6jceI9zwnNaXlG8Vuqd.jpg","genres":["Комедия","Драма"],"overview":"Джемма не очень-то хочет замуж, но когда ее жених внезапно умирает, она настаивает на проведении торжества во что бы то ни стало. Он готова бросить вызов общественному мнению, закону и возражениям своих близких.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"932738","ru":"Каспер. Легенда возвращается","en":"Ghoster","year":"2023","type":"Фильм","rating":5.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/7YkxLDUJKEVN3RZwDUzAhQy5V1k.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n71ugz5LeBHKosGM681LlGfYAGA.jpg","genres":["Семейный","Приключения","Фэнтези","Драма"],"overview":"Элизабет и ее отец отправляются разгадать секреты загадочного поместья Эховиль. По прибытию на место они знакомятся с самым добрым в мире привидением, которое обитает в стенах замка 50 лет. Теперь их ждут новые приключения и битва со злым драконом-призраком Юто...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1091862","ru":"Черный бриллиант","en":"Black Diamond","year":"2025","type":"Фильм","rating":5.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/fRrDGqTZzBH1RU1ucPp4ULHWfxK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zjPOZtbAZPjF70dLUN2NWT3Tl1J.jpg","genres":["Триллер"],"overview":"История повествует о молодой женщине, чья идиллическая жизнь со своим молодым человеком превращается в смертельный треугольник похоти, одержимости и убийства после встречи с местным ковбоем-мастером на все руки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"576543","ru":"Прощай, Советский Союз","en":"Hüvasti, NSVL","year":"2020","type":"Фильм","rating":5.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/lqJdOyaUSuZOdzviTYIz5a4YLxR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/evetH8RnVSPkbQEo8IunfhniOMc.jpg","genres":["Комедия","Драма"],"overview":"Йоханнес родился в Эстонии. Когда его мать уезжает работать в Финляндию, мальчик останется на попечении бабушки и дедушки. Он влюбляется в одноклассницу, влезает в драки, в общем — живет жизнью обычного подростка. А на заднем плане рушится Советский союз, считавшийся вечным. Исчезают Ленины - их место занимают Барби, крокодилы Гены и Москвичи уходят в прошлое, уступая свое место новым ценностям.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"698410","ru":"Руфус: Хроники волшебной страны","en":"Adventures of Rufus: The Fantastic Pet","year":"2021","type":"Фильм","rating":5.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/wW1AFGMDPXViL42kdJA26Oya8s4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y6TQaKyaIJnWUjnvvQX9mD5LK2R.jpg","genres":["Семейный","Приключения","Фэнтези"],"overview":"В доме своей бабушки Скотт и его подруга Эмили встречаются с Руфусом, отважным пушистым существом. Он умоляет их помочь восстановить его исчезающее королевство. Книга заклинаний волшебника Эбботта содержит магическую формулу исцеления. Наши герои отправляются на поиски книги и фантастических ингредиентов, чтобы спасти волшебную страну Руфуса!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1202235","ru":"డాకు మహారాజ్‌","en":"డాకు మహారాజ్‌","year":"2025","type":"Фильм","rating":5.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/mu6K5ABJot3YKHJQQLIJUwMxi1P.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fWLfoaen7tv3mUT65KWHg7zCFYn.jpg","genres":["Боевик","Криминал","Драма","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1254754","ru":"¿Quién quiere casarse con un astronauta?","en":"¿Quién quiere casarse con un astronauta?","year":"2025","type":"Фильм","rating":5.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/5SBePVhGosxVnyfSURUahiR1bGI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q2tUReeNgsYTs7tIJ98I4450QeM.jpg","genres":["Комедия","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"414690","ru":"Мастер-шпион","en":"MeesterSpion","year":"2016","type":"Фильм","rating":5.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/h03rWZR4BooAcmxvD8IwJEEI3EF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y7sH06LLOnevMbNzTeerL6Cf49V.jpg","genres":["Приключения","Семейный"],"overview":"Семья Тима переезжает из большого города на побережье, где родители решили начать свой бизнес, купив заброшенную гостиницу. В тайном отделении подвала Тим обнаруживает криогенную камеру, а в ней замороженного человека. Когда тот приходит в себя, оказывается, что это супершпион по имени Симон, который расследовал сложное дело в 1974-м году. Симон с трудом приспосабливается к новой действительности, но он должен завершить свое расследование. Тим решает ему помочь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}