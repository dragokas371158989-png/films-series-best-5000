и погибла под колёсами автобуса. Точно так же, как его друг и напарник по планированию преступлений. Ён-иль убеждён, что подобных совпадений не бывает и эти смерти — дело рук конкурирующей организации, которая рано или поздно придёт и за ним.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1173559","ru":"Insidious Inferno","en":"Insidious Inferno","year":"2024","type":"Фильм","rating":5.4,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/8kljUAovBatZRYp2ye2RZr239hU.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"479924","ru":"Окончательный приговор","en":"Ultimate Justice","year":"2017","type":"Фильм","rating":5.4,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/xZ9rLbCawWvm06OuLnr9hJqg5hD.jpg","genres":["боевик"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"967940","ru":"Диорама","en":"Diorama","year":"2022","type":"Фильм","rating":5.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/nYZm5OYaTSkledhRE3lZFMgn5gx.jpg","genres":["мелодрама","драма","комедия"],"overview":"В серии остроумных диорам рассказывается о том, как недоразумения и искушения постепенно разрушают некогда счастливый, полный любви брак.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1300963","ru":"Нечто из унитаза","en":"Scared Shitless","year":"2024","type":"Фильм","rating":5.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/bTYCQcbitzUfBYVzq1eKGDNOgNS.jpg","genres":["комедия","ужасы"],"overview":"Сантехник и его сын, страдающий гермофобией, вынуждены спасать жителей многоквартирного дома от некоего кровожадного существа, которое пробралось в водопроводную систему.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"913792","ru":"Meet Me in the Bathroom","en":"Meet Me in the Bathroom","year":"2022","type":"Фильм","rating":5.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/3XNYt5zo3B8urZLiSXNavuHgmVC.jpg","genres":["документальный","музыка","история"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"365372","ru":"Сломанная Жизнь","en":"Breakable You","year":"2017","type":"Фильм","rating":5.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/w1lyYsIAAU2aE4uW37brIVhacJS.jpg","genres":["комедия","драма"],"overview":"Бродвейский драматург неожиданно находит потерянную рукопись своего мёртвого друга. Не долго думая, он решает выдать его работу за свою.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"441868","ru":"Саркар 3","en":"सर्कार ३","year":"2017","type":"Фильм","rating":5.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/yn08el0RDkRkFxZn9ZMoG2bDOMl.jpg","genres":["криминал"],"overview":"Продолжение знаменитой истории, рассказывающей о Саркаре Радже, который продолжает бороться со своими политическими соперниками. Он неустанно сражается со всё новыми и новыми противниками, большая часть из которых не может нанести серьёзный удар по его репутации. Саркар Радж продолжает помогать всем тем, кто обращается к нему за помощью. На этот раз могущественный политический деятель столкнётся с ещё более серьёзными вызовами, и Саркару очень пригодится тот бесценный опыт, который был наработан им за долгие годы успешной карьеры. Но сможет ли он и на этот раз выиграть очередную войну?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"416906","ru":"Лицемеры","en":"Teesklejad","year":"2016","type":"Фильм","rating":5.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/buS0QosSspQpEllSDWe16cm1DLq.jpg","genres":["драма"],"overview":"нна и Юхан получили шанс попробовать наладить отношения, отдыхая в загородном доме своих состоятельных друзей. В разыгравшуюся непогоду они пускают переночевать пару, которая принимает их за хозяев дома. Анна и Юхан быстро осваивают новую роль и начинают игру, которая ведёт их на грань краха.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"457265","ru":"День Австралии","en":"Australia Day","year":"2017","type":"Фильм","rating":5.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/1e0kE8LVQ9WIxXj0fsMP8VYMG3c.jpg","genres":["драма","криминал"],"overview":"26 января в Австралии отмечается государственный праздник — День Австралии. Но, несмотря на значимость этого праздника для всех австралийцев, в этот день территория зелёного континента стала ареной противостояния людей, имеющих свои взгляды на расовую и национальную идентичность.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"386861","ru":"P.S. 걸","en":"P.S. 걸","year":"2016","type":"Фильм","rating":5.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/d9SpdMsuwSNyiubh3xtLOMPkRSX.jpg","genres":["мелодрама","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"274902","ru":"Keeping Rosy","en":"Keeping Rosy","year":"2014","type":"Фильм","rating":5.4,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/caT4Cg1yeZZ9RgGV8RzmmQYgwNG.jpg","genres":["триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}