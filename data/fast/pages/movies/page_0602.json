5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/9fockXg6Svg6XiEpZ1JPsC5BJhC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xkHxETLuoQCAdvATkE5f5efkjTL.jpg","genres":["Криминал","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"660632","ru":"Смертельные отражения","en":"Shattered Memories","year":"2020","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/tdBWEvPgwjZCGn1FFphlVRNG1T6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/97QQawNhdTBByPjKWZ7EYindgF0.jpg","genres":["Триллер","Телевизионный фильм","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"537867","ru":"Пригородные птицы","en":"郊区的鸟","year":"2019","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/oWiuPvTHk2J2Grf25Cy3esIV9k0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nsvaFZJiZtylGX21gGJEBVFlKUQ.jpg","genres":["Драма"],"overview":"В одном из районов произошло крушение здания. Команда молодых инженеров отправляется на расследование происшествия. Через некоторое Хао случайно набредает на здание начальной школы, где находит дневник.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}