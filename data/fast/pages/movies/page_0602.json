b.org/t/p/w342/dw8FoMu1pk0XKJWn6il6kWLIdzu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iyHxqhdOhscWsEFTcbwPMBw4EzV.jpg","genres":["Документальный"],"overview":"О телеведущей и экстрасенсе мисс Клео, популярной в 90-е. Юри Делл Харрис (настоящее имя ясновидящей) работала на специальной горячей линии, где оказывала магически-психологическую помощь: например, раскладывала карты Таро. Продюсеры придумали ей псевдоним и образ шаманки, однако со временем эффектную женщину стали подозревать в мошенничестве. Фильм исследует этот многослойный феномен, расспрашивая знаменитостей того времени и тех, кто был близок к харизматичной гадалке.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1213906","ru":"द साबरमती रिपोर्ट","en":"द साबरमती रिपोर्ट","year":"2024","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/zd3CBwv04BRyH4WJuM5xFsZkgjX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s6WQSGAuZsYZ354VpA7HbQDmesA.jpg","genres":["Драма","Триллер","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"994740","ru":"愛してる！","en":"愛してる！","year":"2022","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/yhJeLjCRRIssKjCNwHe15kKtc64.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9Em3GNoNIuFXUwZpu5IVQKHRLI7.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1303517","ru":"Kahar: Kapla High Council","en":"Kahar: Kapla High Council","year":"2024","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/x4ucff9T7582SM9SAW5FpY9jemT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oAPqXRP3g66TcxBGCdM9rPhx8VU.jpg","genres":["Боевик","Криминал","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"833005","ru":"Okupace","en":"Okupace","year":"2021","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/zHJGropXL51ncFHczcPkduhQLhe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yWiBiOslq48X9TLyn1th00mZTV0.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"935160","ru":"The Wrong High School Sweetheart","en":"The Wrong High School Sweetheart","year":"2022","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/5W2RHWQZCgBMLmFHhvnoxhsVWDD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/r2vR7uKYAHvqwaPac6u4nkIazci.jpg","genres":["Триллер","Телевизионный фильм","Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"314062","ru":"Die Schneekönigin","en":"Die Schneekönigin","year":"2014","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/4F3uiz6CD2Rp7HFoqHvVAS4jMOA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n9hA9O5F6JEER1h17oBZmmQJVWJ.jpg","genres":["Семейный","Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"622601","ru":"Your Family or Your Life","en":"Your Family or Your Life","year":"2019","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/TAzufg2SJtF0hlJ9zYSrlrRoEH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9Npv4HkG2wBIvAyJWQ1XXguFvg4.jpg","genres":["Телевизионный фильм","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"309804","ru":"Paper Angels","en":"Paper Angels","year":"2014","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/swIQbbxQra1UNM3cyvUbAnrgsZw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m2V9Wc1aTootMbKR5JWgtMdrEpi.jpg","genres":["Драма","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1693002","ru":"Убийство Рэйчел Никелл","en":"The Murder of Rachel Nickell","year":"2026","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/db9nxdSqZ8Mh6RDRreF1HFsz9hx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yKeYZOmBMQUMKpMlJJF8q4riYpl.jpg","genres":["Документальный","Криминал"],"overview":"В лондонском парке Уимблдон-Коммон на глазах у маленького ребенка убивают молодую мать. Этот документальный фильм посвящен многолетнему расследованию убийства.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1044768","ru":"Рыбалка для миллионера","en":"Looking Through Water","year":"2025","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/aDYzLJTmsZiblTttRrgrKqQN8tZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a9ahrHWZuITygjBqHmsN9sQuoPF.jpg","genres":["Драма"],"overview":"Уильям Маккей – влиятельный и циничный бизнесмен, чей мир неожиданно рушится после публичного предательства. Скандал ставит под сомнение его репутацию, а его компания сталкивается с риском поглощения. В этот непростой момент Уильяму звонит отец Лео, с которым они много лет не общались, и приглашает на рыболовный турнир для отцов и сыновей. Проводя время на залитых солнцем водах, Уильям и Лео осваивают рыбалку и пытаются разобраться в сложностях своих отношений.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1002082","ru":"Бабли Вышибала","en":"बबली बाउंसर","year":"2022","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/iX2vylrLdiiDBGaA3xhPobJp7dW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2yCvBerA21XiF52be0IYknw5a7z.jpg","genres":["Комедия","Драма"],"overview":"Единственная в своем роде история женщины-вышибалы, фильм следует за Бабли Вышибалой (Таманна Бхатия). В нем исследуются различные грани профессии, в которой обычно преобладают мужчины.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1592019","ru":"Судьбоносное опоздание","en":"Missing the Boat","year":"2026","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/8ZZgSTNMAnXB7TzZeO9mmf0xI5V.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xDs9Dt8jS574vFgN78utMohSInA.jpg","genres":["Мелодрама","Драма","Телевизионный фильм"],"overview":"Незнакомцы Келли и Паркер оказываются на одном круизном лайнере в Италии. Но одна ошибка — и они остаются на берегу, глядя вслед уплывающему кораблю. Теперь, чтобы догнать лайнер, этим полным противоположностям придётся стать напарниками в безумной гонке через весь юг Италии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"795587","ru":"Социальная гигиена","en":"Hygiène sociale","year":"2021","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/8TFvoSmQxzsPuoToIPvay5SYzUz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bSHf3DuxsR3RrM88Xk7DE9S1Wy2.jpg","genres":["Комедия"],"overview":"Мелкий вор, писатель и несостоявшийся кинорежиссер Антонен, живущий в машине друга, пытается разобраться в себе, встречаясь с пятью женщинами — сестрой Сольвейг, женой Эглантиной, дамой сердца Кассиопеей, налоговой инспекторшей Розой и студенткой теологии Авророй, у которой он украл ноутбук.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"952478","ru":"Агрессор","en":"Assailant","year":"2022","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/j9W0BXji6imD417q4soQ6JjoSAj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mNVV7XvGpxo1KV03EpBL1ZGRHpz.jpg","genres":["Триллер"],"overview":"Британская пара, чей брак находится на грани срыва, плывёт в Карибское море в надежде спасти свой брак. После, казалось бы, безобидной драки в баре между мужем и таинственным бродягой ситуация превращается в опасную игру в кошки-мышки. Пара должна сражаться вместе, чтобы спастись от нападавшего.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1119203","ru":"Глобальный катаклизм","en":"Jälkeemme vedenpaisumus","year":"2024","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/pyj3xkA8QX1W0RBT312Oy9yDieq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zeov6eQWlgCoTzX2WuP0PYMOEoV.jpg","genres":["Фантастика","Драма"],"overview":"В 2064 году мир буквально окажется на пороге полного разрушения после того, как климат достигнет своей предельной точки кипения. Еще в 2025 году люди возлагали большие надежды, когда была изобретена термоядерная реакция, которая сделает всю энергетику экологически чистой… пока он не был продан с огромной прибылью, и все это не оказалось одной большой аферой. Но Организация Объединенных Наций разработала своего рода устройство для путешествий во времени, чтобы исправить все недоразумения, предложив Хенрику, изобретателю знаменитого реактора, возможность вернуться в прошлое и уничтожить его собственное творение.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1292662","ru":"Slaughterhouse On The Hill","en":"Slaughterhouse On The Hill","year":"2024","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/f6C2ckdAXELXbzyY8AoH4lj6udg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8UP9H8x6CsSzRZ96Ajy5rEUxkqg.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1196942","ru":"मेरे हज़्बन्ड की बीवी","en":"मेरे हज़्बन्ड की बीवी","year":"2025","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/fQMBYG4JOD6WN8QzViPYqxuIsru.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s4CHQ8m27TPBji3ZQAzgEEg0X8U.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"770492","ru":"Break Even","en":"Break Even","year":"2020","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/ijwUja8ignGUEQKvdAg9TpqO8ei.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zmGdLKwPyUIgoq2TYBw3Eim5mNr.jpg","genres":["Боевик","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRat