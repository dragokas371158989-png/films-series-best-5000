.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1179604","ru":"Grumpy Old Santa","en":"Grumpy Old Santa","year":"2023","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/e57nuVIGgYkV5NZjpVfkykFxkfR.jpg","genres":["комедия","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"500855","ru":"Сяо Мэй","en":"小美","year":"2018","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/5b1eVxkWlXnpPPHvmKeK3pxOoue.jpg","genres":["детектив","драма"],"overview":"Девушка по имени Сяо Мэй внезапно исчезает. Без следа и объяснения. Девять людей из ее жизни пытаются сопоставить свои воспоминания и странные домыслы о пропавшей, найдется место и неожиданным откровениям, что напускает еще больше туману на личность Сяо Мэй.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"549567","ru":"Пчёлка","en":"Honey Bee","year":"2018","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/sh0hO4bl2DzGi0lRnXNAdBxHwlj.jpg","genres":["драма"],"overview":"История Натали Соренсон, или Пчёлки, несовершеннолетней проститутки, которая застряла в секс-торговле. Но все меняется, когда ее отправляют в новую приемную семью на севере Онтарио, где ей приходится раз и навсегда решить, кем она является на самом деле.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"493621","ru":"Арена","en":"Blood Circus","year":"2017","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/lY53rExaZyCuZ6h5LbffYVtisaf.jpg","genres":["боевик","триллер"],"overview":"Звезда ММА Шон Диллон решает бросить бои ради самого ценного в его жизни – жены и сына. Но жизнь складывается не так хорошо, как он бы хотел. Отношения с женой накаляются, и после разрыва Шон скитается по барам, пьет, затевает драки и в итоге остается должен много денег серьезным парням. Чтобы выбраться из этой ситуации, он вынужден драться в подпольном бойцовском клубе “Арена”, где единственное правило – убей или будь убитым.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"391907","ru":"동거의 목적","en":"동거의 목적","year":"2016","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/2XrA9pyHNoxuxNHQmSX3VCtZ7Ev.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"544581","ru":"어린이모","en":"어린이모","year":"2018","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/wSsyYVPKlfEaAHq3xNCpI6TkLjb.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"417407","ru":"Meridian","en":"Meridian","year":"2016","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/iluWXdeutaRpRmk7CYDXo8wYXdn.jpg","genres":["детектив","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"652836","ru":"채팅앱 - 누나의 맛","en":"채팅앱 - 누나의 맛","year":"2019","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/qLXTb41e9CNzXhvOkKArdWU5Jno.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"547777","ru":"母さんがどんなに僕を嫌いでも","en":"母さんがどんなに僕を嫌いでも","year":"2018","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/yix1gbcPbqD3VPuIIHQ4UWjTCB8.jpg","genres":["семейный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"658488","ru":"ホームジャック ペンタグラム","en":"ホームジャック ペンタグラム","year":"2019","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/v6rXvjw2uZg3X2U8ka2VR79l3ds.jpg","genres":["драма","криминал","триллер","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"479211","ru":