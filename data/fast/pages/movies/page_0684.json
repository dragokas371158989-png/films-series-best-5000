граммного обеспечения крупнейшей торговой платформы, надеясь использовать высокие технологии для поиска улик. В ходе расследования Лок вскрывает масштабные махинации в одном из крупных банков и ввязывается в рискованную игру, поставив на карту свою жизнь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"893525","ru":"Свидание с Диего","en":"Rendez-vous avec Diego","year":"2021","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/26KZ1ovbdpPwCkACTc2L0FiCI1B.jpg","genres":["мелодрама","драма"],"overview":"Восемнадцатилетний наивный Ной знакомится с неким Диего через сайт гей-знакомств и они договариваются о встрече. Но не всё так хорошо как кажется...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"921711","ru":"தமிழ் ராக்கர்ஸ்","en":"தமிழ் ராக்கர்ஸ்","year":"2021","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/hOoMQIANxXhRUPkrtSYHYuZaFSm.jpg","genres":["комедия","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1312867","ru":"Backrider","en":"Backrider","year":"2024","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/cHKcJvYF99YQPCHAJ0RLuX5E1HW.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1388877","ru":"Silip","en":"Silip","year":"2024","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bvvJBhSKA8znIMGf8gdFKxBZbU0.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1458894","ru":"Bangkera","en":"Bangkera","year":"2025","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ctW36O4SZh08TWrEo7ewPDypfB2.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1274748","ru":"Serbidoras","en":"Serbidoras"