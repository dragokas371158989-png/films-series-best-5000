Rating":""},{"id":"105185","ru":"Ted Sieger's Wildlife","en":"Ted Sieger's Wildlife","year":"1999","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/pSiyhQuqvlVDXAZFFs7MOujWIib.jpg","genres":["мультфильм","Детский","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"6029","ru":"Hot Wheels AcceleRacers - Shorts","en":"Hot Wheels AcceleRacers - Shorts","year":"2005","type":"Аниме","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/bnP13nx6bgJ5fzqZSlknIaztvQd.jpg","genres":["НФ и Фэнтези","Боевик и Приключения","мультфильм","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"221470","ru":"Lance Dur","en":"Lance Dur","year":"2023","type":"Аниме","rating":9.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xchFybT21gPXGRT88u3JQU15okA.jpg","genres":["мультфильм","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"236032","ru":"Shasha & Milo","en":"Shasha & Milo","year":"2023","type":"Аниме","rating":9.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/jKnk6dCT0nf4XCfKRZ0EgiKr4ck.jpg","genres":["мультфильм","Детский","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_46344","ru":"Кобато","en":"こばと。","year":"2009","type":"Аниме","rating":9.4,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/bzE0eksp2MpZh6UWjBBoSxW1Cth.jpg","genres":["мультфильм","драма","НФ и Фэнтези","Аниме"],"overview":"Милая и наивная девушка по имени Кобато отправляется на Землю с целью исполнить своё заветное желание. Для этого ей предстоит исцелять людские сердца, наполняя волшебную бутылочку «осколками» их страданий. Проводником и куратором Кобато в мире людей выступает Иорёги – могущественное магическое существо в образе синего плюшевого пса. Разумеется, прибыв на Землю, Кобато оказывается в затруднительном положении. Ведь она не имеет никакого представления ни о людях, ни о жизни в их мире, а все её знания опираются на информацию, почерпнутую из манги. Но несмотря на все свои странности, выясняется, что Кобато прекрасно подготовлена к миссии: обладая добрым и сострадательным сердцем, она искренна в стремлении помогать людям. Кобато быстро завоёвывает любовь и восхищение всех, кому помогает, однако самой ей не позволено проявлять чувства к тем, чьи сердца она исцеляет.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"135531","ru":"Леди Баг и Супер-Кот чиби","en":"Miraculous Chibi","year":"2018","type":"Аниме","rating":9.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/2kCc6AoJWF5hfqg25zFj5W2kr3b.jpg","genres":["мультфильм","комедия","Детский","Аниме"],"overview":"Согласно легендам, в Деревне Огня, которая расположена в горах Фиоре, хранится реликвия, известная как Камень Феникса. Говорят, что теперь камень охраняет загадочная женщина по имени Эклер, которая бродит с ним по земле и не помнит, почему он был оставлен ей на хранение. Члены гильдии волшебников «Хвост Феи» предлагают Эклер помочь раскрыть тайну реликвии, но в разгар путешествия неизвестные нападают на хранительницу и забирают камень. Эклер и «Хвост Феи» отправляются на поиски пропажи, ведь Камень Феникса обладает мощной магической силой, что может привести к катастрофе, а мир окажется на грани гибели.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"42670","ru":"Девочка-волшебница Красотка Самми","en":"魔法少女プリティサミー","year":"1995","type":"Аниме","rating":9.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/zZO95DnTGSIdNzsOVdE70TaAykI.jpg","genres":["мультфильм","НФ и Фэнтези","Аниме"],"overview":"Сасами впитала в себя здоровую дозу магии, с помощью которой она собирается исправлять плохие вещи на Земле, и, конечно, помочь её брату Тенчи избавиться от проблем.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"285479","ru":"凡人修仙传","en":"凡人修仙传","year":"2020","type":"Аниме","rating":9.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/sZJssMWcejxx2k8i0JPIr4t2tMY.jpg","genres":["мультфильм","Боевик и Приключения","драма","Аниме"],"overview":"Обычный деревенский мальчишка случайно становится учеником небольшой секты. Несмотря на поджидающие трудности, он сразится с демонами и древними небожителями, чтобы найти свой собственный путь к бессмертию.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"237015","ru":"Women Wearing Shoulder Pads","en":"Women Wearing Shoulder Pads","year":"2025","type":"Аниме","rating":9.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/osET9RSyPGwdUQMQEW4tTCnmNBV.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"104000","ru":"Transformers: Titans Return","en":"Transformers: Titans Return","year":"2017","type":"Аниме","rating":9.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/q4x5zMj03vlZ8zEyGs57U0aXbDZ.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"77776","ru":"За гранью миров","en":"疯味英雄","year":"2015","type":"Аниме","rating":9.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/gncg85dp9w30gejGLEbc6KYldvP.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","Аниме"],"overview":"Независимый анимационный проект от китайцев, доказавшей всем, что можно делать круто и весело. Пародия на все игровые и киберфэнтезийные тайтлы. Где-то далеко, за границами Вселенной, существует мир героев и их реинкарнаций. Они вечно сражаются за контроль над этим миром хаоса. И вот в одном таком сражении, один неприметный бот обретает волю и разум...","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"51512","ru":"Battlefield Friends","en":"Battlefield Friends","year":"2012","type":"Аниме","rating":9.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/wk0hdkWwhsFHrtEo4lpbh1hDOuk.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"88319","ru":"罗小黑战记","en":"罗小黑战记","year":"2011","type":"Аниме","rating":9.3,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/bDhBjhFknuPx3mcCInuTa3XaQmw.jpg","genres":["мультфильм","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"100363","ru":"我的三体","en":"我的三体","year":"2014","type":"Аниме","rating":9.3,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/wZUio8U3OwiNOAE33naAFmeHRUQ.jpg","genres":["мультфильм","НФ и Фэнтези","детектив","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"128963","ru":"崩坏3 动画短片集","en":"崩坏3 动画短片集","year":"2018","type":"Аниме","rating":9.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/bDARErIbfAj9ycE4mMxKHakjSYD.jpg","genres":["мультфильм","Боевик и Приключения","драма","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"129599","ru":"Ваття ПриМаги!","en":"ワッチャプリマジ！","year":"2021","type":"Аниме","rating":9.3,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/vBkzs9ZT409UMIKIlpVREe2U8Ho.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"235808","ru":"Воинственный Бог Асура","en":"修罗武神","year":"2023","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/oQJMf333GTeKJl5dbOIFNE02gtK.jpg","genres":["мультфильм","Боевик и Приключения","драма","НФ и Фэнтези","Аниме"],"overview":"В мире, разделенном на девять отдельных провинций, каждая из которых управляется древними и загадочными силами, течение жизни внезапно прерывается в одну роковую ночь. Таинственное и необъяснимое явление проносится по земле, оставляя ее жителей в недоумении и охваченном страхом. Эта ночь хаоса знаменует начало необыкновенной истории. Перенесемся на пять лет вперед, и мы встречаем Чу Фэна, скромного жителя, который служит внешним учеником в престижной Школе Лазурного Дракона. Когда он погружается в потаенные уголки мистического леса, его путь пересекается с событием, которое навсегда изменит его судьбу. Чу Фэн пробуждает одного из легендарных Девяти Молниеносных Зверей, демонстрируя удивительную силу. Однако что действительно удивляет Чу Фэна, так это обнаружение запечатанного яйца со спрятанным внутри зверем.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"217857","ru":"もっと！まじめにふまじめ かいけつゾロリ","en":"もっと！まじめにふまじめ かいけつゾロリ","year":"2020","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/1zmj9kQ3FWtczVrhDQz4Yy9cZKR.jpg","genres":["мультфильм","Детский","комедия","драма","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"261647","ru":"Sofia the First: Royal Magic","en":"Sofia the First: Royal Magic","year":"2026","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/btMAULyx0ecn7slCxJYQ1aNX7yx.jpg","genres":["Детский","мультфильм","семейный","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"282136","ru":"将夜","en":"将夜","year":"2026","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/xS1jaBgymz4Smc3IUNDwh9uYxhX.jpg","genres":["мультфильм","Боевик и Приключения","драма","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"153832","ru":"Mechamato","en":"Mechamato","year":"2021","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/1rkM4tLoNKC33sLVyAWgogZGo3B.jpg","genres":["Детский","мультфильм","Боевик и Приключения","комедия","семейный","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"82519","ru":"Belle et Sébastien","en":"Belle et Sébastien","year":"2017","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/fpLzE8qfaPcJ8siA7dAsPdQzUim.jpg","genres":["мультфильм","Детский","драма","Аниме"],"overview":"Небольшая идиллическая горная деревушка во Франции перед приходом немцев в годы второй мировой войны. Жители деревни видят в большой пиренейской горной собаке Белль только угрозу и врага, на которого начинают охоту. Лишь маленький мальчик сирота Себастьян оказывается способен взглянуть на животное другими глазами. Вместе они становятся неразлучными друзьями, но эта игра в прятки становится только началом большого приключения, которое им придётся вдвоём пережить.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"41216","ru":"TOM & das Erdbeermarmeladebrot mit Honig","en":"TOM & das Erdbeermarmeladebrot mit Honig","year":"2005","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/vju3XDzLvlm2DZGobIKPUHYY7CB.jpg","genres":["Детский","мультфильм","Аниме"],"overview":"Миром, в котором уже не осталось людей, правят совы… добрые… злые… как и всегда! В волшебном лесу — королевстве сов Тито — на Великом Дереве Га`Хуул, где разумные совы живут в гармонии, наступают мрачные времена. Королевство подвергается страшной опасности со стороны соседних жестоких правителей, и эта опасность грозит уничтожить привычное мироздание.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"8653","ru":"The War that Made America","en":"The War that Made America","year":"2006","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/urz6HMMBhnwyomNzIYZ5CXL9UF0.jpg","genres":["документальный","Аниме"],"overview":"По безмятежной глади озера дрейфуют плавучие рыбацкие домики, их хозяйка, загадочная и молчаливая Хи-джин, днем продает рыбакам еду, а ночью – свое тело. Она покорно терпит издевательства своих гостей, не подозревающих, что их жизнь целиком зависит от ее воли и капризов. Но когда в одном из домиков поселяется бывший полицейский, убивший свою подругу, между ним и Хи-джин возникает странная связь, непреодолимое влечение, которое можно удовлетворить лишь жестоким сексом на грани безумия.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"20796","ru":"快傑蒸気探偵団","en":"快傑蒸気探偵団","year":"1998","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/d6rkp3vJ8lDJgfo7EiH2JJroyps.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","детектив","криминал","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"19260","ru":"Рыцари коллекции монстров","en":"六門天外モンコレナイト","year":"2000","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/1HZGKL0nOzrMlJOvvJvg22Qr4Nq.jpg","genres":["мультфильм","НФ и Фэнтези","Боевик и Приключения","Детский","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"34200","ru":"Серебреные доспехи Адиана","en":"銀装騎攻オーディアン","year":"2000","type":"Аниме","rating":9.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/uAQeNeO2C42vljqlAlZgFcqvvDg.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","драма","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"",