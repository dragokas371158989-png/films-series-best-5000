ges. [Written by MAL Rewrite]","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"238688","ru":"Doraleous and Associates","en":"Doraleous and Associates","year":"2012","type":"Аниме","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cod7ZPQmS86T1h9kyIK7mDOOqOo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5i53Au7oXRlO0h0VdpUXbSyEEII.jpg","genres":["мультфильм","комедия","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"100027","ru":"Mega Man: Fully Charged","en":"Mega Man: Fully Charged","year":"2018","type":"Аниме","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ue354a9MYmEDIurUKCXIJFk0nJX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vfFNmYVtUcG7XI0gwSwsWT1ra8y.jpg","genres":["Боевик и Приключения","мультфильм","Детский","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"105834","ru":"Alix","en":"Alix","year":"1999","type":"Аниме","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/Nj5vDUf5xLMPPsYr3UWF1FSe2V.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iZzkFuMSWCMQphOi4w7EvXvG62a.jpg","genres":["мультфильм","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"96514","ru":"Lupo Alberto","en":"Lupo Alberto","year":"1997","type":"Аниме","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/zIRQvTdX5mHOUgcuYHP90BSOBau.jpg","backdrop":"https://image.tmdb.org/t/p/w780/i0y0OA3aKIfcUmNlCDWSjE87q7x.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"73571","ru":"StarStarSpace","en":"StarStarSpace","year":"2016","type":"Аниме","rating":10.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cBbapPFBVZGPpM5TyZmTENx6D2H.jpg","backdrop":"https://image.tmdb.org/t/p/w780/loV1tLbo6KzHxmpHOSPUr1aMyLP.jpg","genr