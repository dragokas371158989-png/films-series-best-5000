://image.tmdb.org/t/p/w342/q8uXXkISDzuJ8FgldENg3wmWPMt.jpg","genres":["мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1587722","ru":"CMA Country Christmas 2025","en":"CMA Country Christmas 2025","year":"2025","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/owWpFf6jkoyXe03Mqga0kwtFK17.jpg","genres":["музыка","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"225303","ru":"BE@RBRICK","en":"BE@RBRICK","year":"2025","type":"Аниме","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/8QNmKKMhmjmSlQRtXQ0g1gIu7cM.jpg","genres":["Детский","мультфильм","комедия","семейный","Аниме"],"overview":"В городе, где роли каждого предопределены, амбициозная исполнительница и автор песен с товарищами по группе смело решаются осуществить свои мечты и вдохновить на это остальных.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"293703","ru":"Dr. Seuss's Red Fish, Blue Fish","en":"Dr. Seuss's Red Fish, Blue Fish","year":"2025","type":"Аниме","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fhtkX44A4cTYMNKNcosEFYX7zfq.jpg","genres":["мультфильм","Детский","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"238685","ru":"Тайны книги гор и морей","en":"山海经密码","year":"2025","type":"Аниме","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/8EuGPfbPdcDheVp3utW7vx5CBGZ.jpg","genres":["мультфильм","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"281626","ru":"Одинокий герой","en":"孤雄","year":"2025","type":"Аниме","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9z4Uz1mqTKUA6gI1gxFhaiSi0IH.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1315477","ru":"Халлан","en":"한란","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/mSnjSyBA1JLakusxZ2Hryzpw1ee.jpg","genres":["драма"],"overview":"Молодая мать с маленькой дочерью выживает как может в нелёгкое время на острове Чеджу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"307006","ru":"Линия пальмы","en":"La linea della palma","year":"2025","type":"Сериал","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xIzPZ91sXbNVeDmHUXnZOqpBlQZ.jpg","genres":["криминал","драма"],"overview":"Расследование журналистки об украденном шедевре Караваджо и смерти её отца приводит к шокирующим открытиям о тёмных связях её семьи с сицилийским криминальным подпольем.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1507796","ru":"На море","en":"On the Sea","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/hP4JpQe7F7rcs5lOH97fM7kaSFs.jpg","genres":["драма","мелодрама"],"overview":"Джек женат на Мэгги уже больше половины своей жизни. Он работает на плантациях мидий в Северном Уэльсе вместе со своим младшим братом Дайфаном и тремя его сыновьями. Джек всегда считал, что его собственный сын Том после окончания школы продолжит семейное дело, но нежелание Тома идти по его стопам приводит к напряжённости в семье. Ситуация накаляется ещё больше с появлением странствующего матроса Дэниела, который не скрывает своих чувств к Джеку. В этой отдалённой сельской общине, где жизнь вращается вокруг церкви и рыболовства, Джек сталкивается с неразрешимой дилеммой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1411301","ru":"Цвет под подозрением: документальный фильм","en":"To Dye For: The Documentary","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/8vPfPIBpW3jP7rZkZeaw8GImgIN.jpg","genres":["документальный"],"overview":"После того как родители обнаруживают у своего ребёнка тяжёлую чувствительность к синтетическим красителям в пище и других продуктах, они отправляются в личное расследовательское путешествие и снимают документальный фильм о последствиях таких добавок для здоровья. По ходу фильма они встречаются с ведущими мировыми специалистами по синтетическим красителям — учёными, токсикологами и исследователями, а также общаются с другими семьями, столкнувшимися с подобной проблемой. История сочетает влоговые элементы, интервью и личные семейные моменты, постепенно раскрывая шокирующие факты и неожиданные открытия о влиянии красителей на детей и взрослых.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"307041","ru":"Шальной отдел","en":"Шальной отдел","year":"2025","type":"Сериал","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9Ue37JprF1xud5rG67dxq2s7gIT.jpg","genres":["детектив","драма"],"overview":"Оперативник Кирилл Шальной живет и действует в полном соответствии со своей фамилией, которую ему дали в детдоме. Это и помогает ему, и в то же время мешает. Тяга к экстриму определила выбор профессии. Став взрослым, Кирилл пошел работать в полицию, где дослужился до замначальника ОУР одного из центральных УМВД. В личной жизни Шального всё не так радужно. Несколько лет назад ему улыбнулась удача, и первая красавица отдела полиции — дознаватель Елизавета ответила «да» на его предложение руки и сердца. Но спустя время отношения между ними остыли. К тому же новый начальник УМВД стал назойливо ухаживать за Елизаветой. Кирилл не стерпел такого удара по самолюбию и на корпоративе дал начальнику по физиономии. Начальник пообещал, что этого просто так не оставит, и слово свое сдержал. Успешного опера перевели на службу в захудалый спальный район. Кирилла на новом месте ждет самый неласковый прием.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1577602","ru":"Рождественский билет","en":"The Christmas Ticket","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/dvFrgNuGm41wLNQAsQHRzDzVfbn.jpg","genres":["мелодрама"],"overview":"За неделю до Рождества Алана получает в наследство от дедушки загородный дом. Вскоре она выясняет, что где-то в доме он, вероятно, спрятал лотерейный билет с крупным выигрышем.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"322518","ru":"一起穿书后，我和炮灰闺蜜一路躺赢","en":"一起穿书后，我和炮灰闺蜜一路躺赢","year":"2025","type":"Сериал","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rbmrSWHJoNpnynuZfuBmW6tExhK.jpg","genres":[],"overview":"После трагической потери матери, девочка-подросток, пытается раскрыть темные тайны ее нового дома, несмотря на то, что отец не верит ей...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"283765","ru":"我们的爸爸","en":"我们的爸爸","year":"2025","type":"Сериал","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/gqL3kE2KohZPakjsIymWySuiRCt.jpg","genres":["Реалити-шоу","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315924","ru":"딱! 한 번만 해보자","en":"딱! 한 번만 해보자","year":"2025","type":"Сериал","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7AVJNEyldVMjzHAe1CkVRz21d2t.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1564937","ru":"Mamasan","en":"Mamasan","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/denXd5zWlcwhMy7XHUlgeTzrfjX.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1433071","ru":"제로베이스원 더 퍼스트 투어 [타임리스 월드] 인 시네마","en":"제로베이스원 더 퍼스트 투어 [타임리스 월드] 인 시네마","year":"2025","type":"Фильм","rating":6.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/uaL3Wug4YsZnMH0UAaIwwt1473C.jpg","genres":["музыка","документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"306293","ru":"以下犯上","en