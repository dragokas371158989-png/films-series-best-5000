енов и живет вполне обыкновенной жизнью, не считая того, что с рождения имеет дар — видеть призраков умерших людей и общаться с ними. После загадочной пропажи своей одноклассницы Алиса начинает использовать способности, чтобы помогать следствию, и попадает в круговорот событий, приоткрывающих тайну ее семейного прошлого.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1312990","ru":"Álbum de familia","en":"Álbum de familia","year":"2024","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/i6slmGOVL29nrXl6KlJ9GIeHXK0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rMwMZ7siUhgRD2J5PKFw5zkL8k4.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1306177","ru":"Todas as Coisas que Ela disse","en":"Todas as Coisas que Ela disse","year":"2024","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/ucrodsuqEZ3hSh02zDoGhduYa1a.jpg","backdrop":"https://image.tmdb.org/t/p/w780/76p0yjNIazc37FH9QT63RW3pCj6.jpg","genres":["детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1380755","ru":"The Making of Gladiator II","en":"The Making of Gladiator II","year":"2024","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xbfAfaXZhw5fK3qQWRImlxb1HHi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/u5sTwTgRlpf9ou7BBWRjVj6f3EP.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1306649","ru":"Richard et la boucle du temps","en":"Richard et la boucle du temps","year":"2024","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fXAxvOmHbqCEKFu9fW5up4clHN9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6IBxJtfIj8hlOtLJqy5yIDiPZTL.jpg","genres":["комедия","фэнтези","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":