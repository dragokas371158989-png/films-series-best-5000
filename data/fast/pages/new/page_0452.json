ящей суперзвездой. Ее любили все: от мала до велика, от крестьян до высоких партийных чиновников. Среди поклонников ее таланта был и товарищ Сталин. Фильмы и спектакли с ее участием собирали полные залы. А потом наступили 40-е, пришла война, и мир вокруг навсегда изменился.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1325230","ru":"Paluwagan","en":"Paluwagan","year":"2024","type":"Фильм","rating":5.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fRitRV90rkSlGQICZO7xUMjnVx7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kEbwy1H1Xyo35vhIsB74z2yLuAc.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1276674","ru":"夏目アラタの結婚","en":"夏目アラタの結婚","year":"2024","type":"Фильм","rating":5.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/n0JcesG4imWkVrz19mRiLF2mU40.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tnPf8K6li0tAQajKmUidnBeG452.jpg","genres":["драма","криминал","триллер","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1249439","ru":"Kaka Boss","en":"Kaka Boss","year":"2024","type":"Фильм","rating":5.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/t3JbHRCGwWJe7y85qV2nnXxHXli.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wT55hlUdO8fK0JuTLyCUjuVkNa5.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"241628","ru":"Рамэнная рыжего кота","en":"ラーメン赤猫","year":"2024","type":"Аниме","rating":5.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/g1cIGDAdqN0Pm5KGqWzjgxbYORH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fnsH3q7ciHITgHJaGioIZaIqK0n.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Представьте изумление главной героини, когда она, придя устраиваться на работу в кафешку, узнала, что там всем заведуют милые котики! Это её настолько ошарашило, что на вопрос управляющего, нравятся ли ей кошки, она честно ответила, что больше предпочитает собак... за что её тут же приняли на работу! Чем обычно занимается работник кафе? Сервирует блюда, подаёт напитки, убирает посуду, умиляется котиками, играет с котиками, расчёсывает котиков... Так, минуточку! А это всё точно было в должностной инструкции?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"261471","ru":"脱口秀和Ta的朋友们","en":"脱口秀和Ta的朋友们","year":"2024","type":"Сериал","rating":5.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/mm1qozQUbRZajcGhOkOI4gH4dm8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zYG6LAL1V1EewjjFp3iffhmw5ET.jpg","genres":["Ток-шоу","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1397352","ru":"Forbidden Desire","en":"Forbidden Desire","year":"2024","type":"Фильм","rating":5.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/x0IwIYvKzYWraEpKM8yMTQMiFKF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kuprUyEGK3qtxSuYLkMVWIek7nO.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1304367","ru":"Andrea Bocelli 30: The Celebration","en":"Andrea Bocelli 30: The Celebration","year":"2024","type":"Фильм","rating":5.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/yGqLvqN1Vw0FkPL54uT48w8Ob50.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3PjDjOjiuF39hFDGeCBBDUywUe4.jpg","genres":["музыка","документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1323046","ru":"धर्मवीर २","en":"धर्मवीर २","year":"2024","type":"Фильм","rating":5.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/m4SHtLoSfatigDMZxpsX8E7NuVH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fF1FKpw9xtixmMIoNNbNeyxP5TE.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1297651","ru":"מזל חתולה","en":"מזל חתולה","year":"2024","type":"Фильм","rating":5.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/lGn9qr2IM8kzPr7yL5ZoqtFgV52.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7PMuXIfRh2c0ZlBMs2eK8KNjEgj.jpg","genres":["комедия","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1358823","ru":"Донька","en":"Донька","year":"2024","type":"Фильм","rating":5.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/iq9I3CCFvyQyPQsMLlqtAC6Y2V0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2tvI4VlW8mE7UOGQ7JtIKqjj8Ti.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1373510","ru":"黄飞鸿之铁血十三姨","en":"黄飞鸿之铁血十三姨","year":"2024","type":"Фильм","rating":5.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cDxZON2cI4cMUpRsnxmNEv1Zvzk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ykRvuZnf2tsYBgHPpySbXvEtbtw.jpg","genres":["боевик","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"937086","ru":"Заведи меня","en":"Turn Me On","year":"2024","type":"Фильм","rating":5.7,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/wHCxBB307J2YU9ySnYo6c3NBNUg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sBiobcx5DaKlLs6wK6jlAEVmQb.jpg","genres":["фантастика","мелодрама","драма"],"overview":"В мире, где неудобства, связанные с человеческими эмоциями, устраняются одним ежедневным приёмом витамина, одна молодая пара пропускает приём своей дозы и открывает для себя любовь, радость, секс и весь сопутствующий им багаж.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1130410","ru":"37: Тень и добыча","en":"37 : L'Ombre et la Proie","year":"2024","type":"Фильм","rating":5.7,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/sOFLKstJwTr9QSKI6KdmDG5vRsv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nF8r2UoS05ltpLRHbKa4a5os9gC.jpg","genres":["триллер","драма"],"overview":"Винсент, водитель грузовика, подбирает молодую женщину, которая утверждает, что ее зовут Тридцать седьмая. Ее странное поведение вскоре вызывает у водителя подозрения. Но и сам Винсент может оказаться не таким уж невинным, как кажется... Между водителем и его пассажиркой начинается дьявольская игра, которая вскоре выходит из-под контроля.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"989909","ru":"Таможенная война","en":"海關戰線","year":"2024","type":"Фильм","rating":5.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/aOYCcRScQNsOZcJ1blB2yHLL9YL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e3JZk9wU0NugSIKnLh9SU9iZcyD.jpg","genres":["боевик","драма"],"overview":"Сотрудникам гонконгской таможни — начальнику следственного отдела Чоу и командиру Чуну — приходится противостоять главе международного синдиката, который решил превратить порт Гонконга в перевалочный пункт для торговли оружием с двумя враждующими африканскими государствами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1208491","ru":"Пушистое превращение","en":"Zak & Wowo, la légende de Lendarys","year":"2024","type":"Мультфильм","rating":5.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/uR70IF8Xiw3fnM2j5KBmDKyyP2o.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6PAkwvDjaSS9vN6RXTAcCbUoDxA.jpg","genres":["мультфильм","приключения","фэнтези"],"overview":"Братья-близнецы Кайл и Зак живут в фантастическом мире, бок о бок с невероятными магическими существами. Но всё меняется с появлением таинственных зандаров. Чтобы спасти свой волшебный мир, подростки и их пушистые друзья отправляются в увлекательное приключение, полное захватывающих чудес.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1225862","ru":"末路狂花钱","en":"末路狂花钱","year":"2024","type":"Фильм","rating":5.7,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/jkyYQ1G47kUGL1JNsuS26d6p93I.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1j7Sm4OTcaZcGJdGbdNxi46d9py.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"242101","ru":"Какао","en":"Cacau","year":"2024","type":"Сериал","rating":5.7,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/nNCFBKZ68fmr008moWSzLdu2mUP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3xVmBU66Ukp79BBKAbHMySSAqq3.jpg","genres":["Мыльная опера"],"overview":"Девушка по имени Какао узнаёт тайну своего рождения. С этой минуты она попадает водоворот семейных перипетий, загадочного наследства и любви, подслащенной неотразимым вкусом шоколада местных плантаций.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1219522","ru":"Синистер. Обитель зла","en":"អ្នកស្នងអគារ","year":"2024","type":"Фильм","rating":5.7,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/mVBIRtbFPso5iR7ErdUt48S7ZRN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ew8Y4Jf1wx4BFmNTWOWpdw3p7HP.jpg","genres":["драма","ужасы","триллер"],"overview":"После смерти матери мангака Сория отправляется в дом своих предков в Пномпене в надежде воссоединиться с дальними родственниками и использовать этот визит в качестве вдохновения. Она снимает квартиру в старом и ветхом жилом комплексе эпохи Красных кхмеров и позже приезжает на встречу с роднёй по материнской линии. Вскоре часы спокойствия в съёмном жилье сменяются ужасающими и кровавыми видениями.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1377505","ru":"Намордник","en":"Spithood","year":"2024","type":"Фильм","rating":5.7,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/loH2BJPC7dlCw8e8QNEZCz9kTc2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/h4YdTMJ6h0Poyo5XHn8vk4wTczT.jpg","genres":["ужасы","триллер"],"overview":"Когда опасный пациент сбегает из психиатрической лечебницы и начинает безудержно убивать, сотрудники ночной смены сталкиваются с самым страшным кошмаром, борясь за выживание.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1341012","ru":"Amanece en Samaná","en":"Amanece en Samaná","year":"2024","type":"Фильм","rating":5.7,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/jLJlN27YGDKZNpR0RRxlgLIfoLP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2Zmw9yg2RF8VqXyEpbES9wyWjPK.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1228803","ru":"Заговоренная","en":"Believer","year":"2024","type":"Фильм","rating":5.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/pLURHWSMtzZEU9bHbkDIRu3V8Bi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zoWoweJ25O4KLrIznTJLL5L0O8G.jpg","genres":["ужасы","триллер","детектив"],"overview":"Кейт работает над книгой об идейном серийном убийце Маршалле Грейсоне, на счету которого 53 жертвы. Ими стали те, кто, по его мнению, приближает конец света. Кейт присутствует на заседании суда, где неожиданно Грейсон набрасывается на нее и пытается что-то сказать. Девушка приходит в себя в больнице и не помнит ни нападения, ни того, что ей сказал Маршалл. После этого дня с ней начинают происходить странные и необъяснимые вещи.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1126475","ru":"Виски Артура","en":"Arthur's Whisky","year":"2024","type":"Фильм","rating":5.7,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/aLInRxGU9kp1o2djoS2xK75Ilmk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6z6ZNNZT39hqnOq1e490wCttcUY.jpg","genres":["комедия","фэнтези"],"overview":"Три пожилые дамы пьют виски, которое делает их моложе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"243117","ru":"Plus belle la vie, encore plus belle","en":"Plus belle la vie, encore plus belle","year":"2024","type":"Сериал","rating":5.7,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/ps0WuyL384MahVCxysxOfF1fhgq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3Jolb6Ky31IhEwyS8QhRykKo79J.jpg","genres":["Мыльная опера","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1182222","ru":"15 Jahre","en":"15 Jahre","year":"2024","type":"Фильм","rating":5.7,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/3PYXD2XMfkNjSiN3J5ijUAyOz9u.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iIeeccG9vZfGZ5fHIOYddzgIIFw.jpg","genres":["драма","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1269108","ru":"Santet Segoro Pitu","en":"Santet Segoro Pitu","year":"2024","type":"Фильм","rating":5.7,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/Aocg0wAqM3XEwRPpL4L4rjkOYJJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AorubnsLNfPEx136uxxFQAqrF0g.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1140191","ru":"Saýara","en":"Saýara","year":"2024","type":"Фильм","rating":5.7,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/57TRtrbIUspdxvMx0HhZE6ogfrd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nAFu4JjX0cr1T6HtfWeEUUBdjqY.jpg","genres":["боевик","триллер","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"837763","ru":"Schirkoa: In Lies We Trust","en":"Schirkoa: In Lies We Trust","year":"2024","type":"Мультфильм","rating":5.7,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/6QQ01q9a2669QCZVdPS4GWR7MMD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/waZDTwfXX8e4AuOWp8r6JtfXCfk.jpg","genres":["мультфильм","фэнтези","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1043870","ru":"Снять проклятие","en":"Reverse the Curse","year":"2024","type":"Фильм","rating":5.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/xNZ6CMIs53kBietV1abO33ObLLz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uyOJv1xmC4zN3arAPhU4EXPWpU4.jpg","genres":["комедия","драма"],"overview":"33-летний писатель-неудачник Тед, давно переставший преследовать всякие жизненные цели, узнает, что его отец Марти серьезно болен. Парень переезжает к нему и вскоре замечает, что состояние отца ухудшается всякий раз, как проигрывает его любимая бейсбольная команда «Ред Сокс». Чтобы избавить старика от лишних переживаний, Тед решает сфальсифицировать итоги матчей с помощью отцовских приятелей. Между тем, он знакомится с очаровательной Марианной, которая возрождает в нем тягу к писательству.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1187107","ru":"Love's Fast Lane","en":"Love's Fast Lane","year":"2024","type":"Фильм","rating":5.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/gleL1hFIZFnMXRFDow95iona08F.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oVe5cvKMG8fCbPT0YBjuG6yTUwh.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1380126","ru":"Pin/Ya","en":"Pin/Ya","year":"2024","type":"Фильм","rating":5.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/xnEMcNzXd7HC2aUxBdT6Urr6OWQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aI78JFBTG8M44HtytLdM73M5yRo.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"964978","ru":"Хорошая девочка Джейн","en":"Good Girl Jane","year":"2024","type":"Фильм","rating":5.7,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/132TUizBnUEfs2hUQM5QXdIy0Q3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aspmwgx8hIVvCdonXgxKxGtttY.jpg","genres":["драма","мелодрама","криминал"],"overview":"Джейн скоро 18. Недавно её выгнали из частной школы, вдобавок она совершенно не ладит со своими разведёнными родителями. Героиня попадает в серьёзные неприятности, когда влюбляется в наркодилера Джейми.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"257161","ru":"喜人奇妙夜","en":"喜人奇妙夜","year":"2024","type":"Сериал","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/nQFCp0Tlfqq3NhF2kiNAGwXLfnX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2l2KlVJAmGrnnhURaMfESslMVh3.jpg","genres":["Реалити-шоу","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1080658","ru":"Отравленный газом","en":"Gassed Up","year":"2024","type":"Фильм","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/v4AvXUj2WD1r9sSXg3BJsW8IVXf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eTU8MEsQBUKMAimUF1hKcdZ6qLb.jpg","genres":["драма","криминал","триллер"],"overview":"Эш, пытаясь заработать денег, чтобы поднять на ноги свою четырнадцатилетнюю сестру и отправить мать на реабилитацию, попадает в банду организованной преступности, возглавляемой молодым и харизматичным албанским иммигрантом Дабзом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"945771","ru":"Ночь убийства","en":"黄雀在后！","year":"2024","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/tWFjbB0DccKgnZH4f0ajqNVh0hD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nRSZMiyqurJUgvEYJ4yDuI0mwK9.jpg","genres":["детектив","драма"],"overview":"Полиция расследует убийство женщины возле загородного ресторана. В деле много свидетелей, и детективы быстро вычисляют виновного — наркомана с игровой зависимостью. Но из-за падения с крыши тот впадает в кому, и также выясняется, что все опрошенные что-то недоговаривают.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1300396","ru":"制暴","en":"制暴","year":"2024","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/fWCgVvtdnqygEK3V8RmlmfATyL0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lgSvnqPRru3EpvVIQ8sWiXQgsYh.jpg","genres":["боевик","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1262485","ru":"भैया जी","en":"भैया जी","year":"2024","type":"Фильм","rating":5.7,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/1wwhDksbyNEAnA3Z7zinozC8VS6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/r5w8gRcrTwPlk25dOTIckltOSiT.jpg","genres":["боевик","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1001054","ru":"Бездельницы","en":"Fainéant.es","year":"2024","type":"Фильм","rating":5.7,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fEyTHwEtU7sLow0stZQ6YVGXgEW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7WGVzGXyQe3YVTuz5MpcOg3OY35.jpg","genres":["драма","комедия"],"overview":"Две молодые подруги — Нина и Джул — вынуждены покинуть землю, на которой они жили в сквоте. Не отчаявшись, они садятся в старый грузовичок и отправляются в путешествие по Франции навстречу приключениям и новым знакомствам. Их дорога полна взлётов и падений, разногласий и перемирий, но главное — крепкой дружбы, которая помогает справляться с трудностями мира, где многие выбирают свободу, альтернативный образ жизни и поддержку друг друга, а не корпоративную рутину.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1328402","ru":"The People in the Walls","en":"The People in the Walls","year":"2024","type":"Фильм","rating":5.7,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/3NyL99rcDr5S4qQ8FXDwWiLujEE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dHoRIZJgwA26zE5WKyEazKUoZAZ.jpg","genres":["ужасы","триллер","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1226835","ru":"Позывной «Пассажир»","en":"Позывной «Пассажир»","year":"2024","type":"Фильм","rating":5.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/xTE0anVU58lVpfdieJCm1C4pWfN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o5XoHyAMJlBZVWk15aEZDb2NpFv.jpg","genres":["военный","драма"],"overview":"2015 год. Молодой писатель Николай Рябинин живет в столице, проводит вечера в модных заведениях и не особо интересуется повесткой дня, пока не узнает от родителей, что его брат, с которым он давно рассорился, пропал без вести на Донбассе. Николай отправляется на поиски, не подозревая, что эта миссия навсегда изменит его жизнь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1332372","ru":"終りに見た街","en":"終りに見た街","year":"2024","type":"Фильм","rating":5.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/pFgZxXOWnGi2UikIaVcHjKlCrLy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yZypYoL3z5g5V150VdcH9UfscAc.jpg","genres":["телевизионный фильм","военный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1357414","ru":"మా నాన్న సూపర్ హీరో","en":"మా నాన్న సూపర్ హీరో","year":"2024","type":"Фильм","rating":5.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/4qmZCDBJwT6UDjCatzzpTFOR4Jy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Aup9YSKFyVtDSu0qlf81xGe1htP.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1331474","ru":"BLACKPINK & The K-Pop Takeover","en":"BLACKPINK & The K-Pop Takeover","year":"2024","type":"Фильм","rating":5.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/kAXrux1L2imYe20g7PRgp7acw2m.jpg","backdrop":"","genres":["документальный","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1053008","ru":"Fight Another Day","en":"Fight Another Day","year":"2024","type":"Фильм","rating":5.6,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/fKnLt1xQV0RdpN6RViowEiD1dFW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/znMUHotZRTcyIFWFz2bvcpSx6YP.jpg","genres":["боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1327649","ru":"Давай создадим культ","en":"Let's Start a Cult","year":"2024","type":"Фильм","rating":5.6,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/kPb27onkJijmlKyEnFIufRL4mlI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a1LUaXJSJfW6NbobLRftFpZdRw3.jpg","genres":["комедия"],"overview":"Пропустив долгожданное массовое самоубийство, отвратительный член культа объединяется со своим бывшим лидером, чтобы обрести новых последователей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1053348","ru":"The Buckingham Murders","en":"The Buckingham Murders","year":"2024","type":"Фильм","rating":5.6,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/opWu2Qf1g5OfAWP4HdmH4ildwuV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lCLU5qZIbqduKQ3jMGWEeTrAiOV.jpg","genres":["криминал","детектив","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1286218","ru":"Mira Mira","en":"Mira Mira","year":"2024","type":"Фильм","rating":5.6,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/ek7Rs8z8MofDUBrHo8Do5Q4ABGO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kAUfcbjPAHcchj69r4GTZO7r1FD.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}