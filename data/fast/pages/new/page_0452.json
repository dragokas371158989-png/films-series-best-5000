{"tab":"new","page":452,"pages":471,"count":28232,"pageSize":60,"items":[{"id":"1077120","ru":"Суперпташки. Улётная миссия","en":"Johnny Puff: Secret Mission","year":"2024","type":"Мультфильм","rating":5.8,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/1l3ifR6QvdipDKp9rjZBvfMrtQn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tM1EkmRn5dA8RF9jW9ZJxyIMizh.jpg","genres":["мультфильм","семейный"],"overview":"Птичка Джонни и его пернатые друзья обладают суперспособностями. Однажды они отправляются на секретную миссию, в ходе которой им предстоит спасти родной город от коварных планов злодея Отто фон Моржа.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1078374","ru":"愛的噩夢","en":"愛的噩夢","year":"2024","type":"Фильм","rating":5.8,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/nQoHELbtAH09g39btZgrjMAocrS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/18FKoiJ2RCJ10pnZLdpKaZViEw4.jpg","genres":["мелодрама","фэнтези","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1122715","ru":"仮面ライダー555 20th パラダイス・リゲインド","en":"仮面ライダー555 20th パラダイス・リゲインド","year":"2024","type":"Фильм","rating":5.8,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/7UG7IexpoJyApmYswqTwZ7qVWtc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/95lNPUVW4axWlr0hdMxxCJmIKgJ.jpg","genres":["боевик","драма","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1393143","ru":"Adopted","en":"Adopted","year":"2024","type":"Фильм","rating":5.8,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/1Lcpx4rXxnmc82DpjkUurZTIZ3z.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3QX5oB89oK5tyuRkKre2EAg2BZa.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1266002","ru":"The Real Bros of Simi Valley: The Movie","en":"The Real Bros of Simi Valley: The Movie","year":"2024","type":"Фильм","rating