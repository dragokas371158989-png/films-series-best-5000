,"poster":"https://image.tmdb.org/t/p/w342/ur4mwFsYT35umPV50w73SuyNzYe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wFGHUIknCUdxRoWMoJKSHOUAVCL.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1288455","ru":"Gelin Takımı","en":"Gelin Takımı","year":"2024","type":"Фильм","rating":5.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1zdd12EhiMeyoqSaKYGvbeH7FKh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ihElDfjHdoMzgcaXp5vuv2r1bvi.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1181701","ru":"Continental Split","en":"Continental Split","year":"2024","type":"Фильм","rating":5.0,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/pWfX0rQlsEIbvKL1HQVCvPvV9jd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/suR1B6HjoIHQ2d8L0auT24DAwkl.jpg","genres":["боевик","триллер","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1139937","ru":"Фрогмен","en":"Frogman","year":"2024","type":"Фильм","rating":5.0,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/ahYG2YIgeKlQd69DFMVUHLK2ftO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/99XoA625Gl9Q5tBKGX1nf2g11yJ.jpg","genres":["ужасы"],"overview":"Будучи 10-летним, во время семейной поездки Даллас поймал на камеру фрогмена — загадочное существо, реальность которого подвергается сомнению. 20 лет спустя парень решает посрамить посмеявшегося над ним видеоблогера и в компании трёх друзей отправляется снимать документалку про фрогмена.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1150478","ru":"Орел","en":"ఈగల్","year":"2024","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/mjQN27x0Dfkmsi3SRRkAIatOr2p.jpg","backdrop":"https://image.tmdb.org/t/p/w780/njSqJRgV4U9J7u73saYjSbiQ60V.jpg","genres":["боевик","триллер"],"overview":"Сахадев Варма по прозвищу Орел, известный профессиональный убийца, отправляется на задание по пресечению незаконной торговли оружием, выдавая себя за хлопковода в Талаконе и перехватывая все незаконные сделки с оружием оттуда. Журналистка Налини пишет новостной репортаж о Сахадеве, чей редкий хлопок пользуется устойчивым спросом в зарубежных странах. Из-за новостного репортажа ее допрашивают агенты RAW, и она узнает о личности Сахадева, что побуждает ее начать журналистское расследование.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1195394","ru":"ടർബോ","en":"ടർബോ","year":"2024","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/CBRqel4Yzm8BS4fTMScYA1fQLD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nn2HYaPRiOytno9pxC652ULRzfU.jpg","genres":["боевик","комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1126094","ru":"Festival of the Living Dead","en":"Festival of the Living Dead","year":"2024","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/85iZ4LWNcsAOZhVxf8xYscDKIQe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ppq8X97QSTUZg7dHKPJL5Xi6wOI.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"743203","ru":"Летучий корабль","en":"Летучий корабль","year":"2024","type":"Фильм","rating":5.0,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/zFCaDgBQkJcHfjLMRPpINhUkqnI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dleaJjgOzdZt7SX59SRI2UWmeb0.jpg","genres":["комедия","музыка","семейный","фэнтези"],"overview":"Царь собирается выдать свою дочь Забаву за красавца Поля, единственного наследника богача Полкана. Вот только царевна хочет выйти замуж по любви. Её неожиданное знакомство с простым, но честным и обаятельным матросом Иваном вносит смуту в планы хитреца Поля заполучить корону. И если в руках злодея тёмная магия и богатство, то на стороне Ивана — волшебные существа, любовь и мечта.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1260982","ru":"Влюбленная Элли","en":"恋わずらいのエリー","year":"2024","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/udQmpEgdBFQmiF0rKaLDmrpwpT5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cMglZNvKTURF8NjDjvCqEvUP7N7.jpg","genres":["мелодрама","комедия"],"overview":"Неприметная школьница Эрико Ичимура находит убежище в социальных сетях. Здесь она перевоплощается в Элли и становится предметом воздыханий многих парней. В мечтах девушка видит себя рядом с Акиро Оуми - признанным красавцем и звездой школы. Однако реальная встреча с ним разрушает ее иллюзии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"925293","ru":"Мир растений","en":"草木人间","year":"2024","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/yx6MStAY5UUdOakkvZsRV9sKptr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sFeFWK3SI662yC2sx4clmWttWVj.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"236000","ru":"Человек-мускул","en":"キン肉マン 完璧超人始祖編","year":"2024","type":"Аниме","rating":5.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/8kXDyWBKwXlZjTP4EVueZYzhBPc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gZwfx7zDthxboj4rk2hIToobnHF.jpg","genres":["мультфильм","комедия","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1145807","ru":"തുണ്ട്","en":"തുണ്ട്","year":"2024","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/lAmO3qw7k4bARLVgIHJMNMEtnmT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qMBiVlm7tWaAzwcxijQXlwUgnHq.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"504503","ru":"Остров возрождения","en":"Остров возрождения","year":"2024","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/ztV8U2dQbVKHyQFSK4c1ehiYnKT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wluLnG6pH63XdFKJZdlPfSIhDxj.jpg","genres":["боевик","триллер"],"overview":"Лето 1992-го, засекреченный полигон «Бархан» в Аральском море. Полковник Даутов, рискуя жизнью, спасает загадочную женщину с терпящего бедствие судна и оказывается втянут в опасную игру, где прошлое советской науки, перемены новой эпохи и тайны самого острова сливаются в единое целое. Чем дальше он идёт в своём расследовании происходящего, тем ближе к грани между реальностью и тем, что её искажает.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1163953","ru":"Мункар","en":"Munkar","year":"2024","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/8YPpgi8Nc1PBMbi24M9GTzNgowD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1PotRgZuBDi6yEGqOSdBtSvl1zS.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1287557","ru":"Space Command Redemption","en":"Space Command Redemption","year":"2024","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2d84IKS2gOQc1V4Ha2AapnlIQRQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aUzIUy7QgUh155iOK4505OdA7Pg.jpg","genres":["фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"744409","ru":"El aroma del pasto recién cortado","en":"El aroma del pasto recién cortado","year":"2024","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/jhuG8p6f1UjGytuFiGs9Pk4Puu4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/v1d7HZqhLjxzxNcbelzlOH38oXr.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1322813","ru":"殊死一搏","en":"殊死一搏","year":"2024","type":"Фильм","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bhFurHAxVXS0vPYIPwU2fNGOUHk.jpg","backdrop":"https:/