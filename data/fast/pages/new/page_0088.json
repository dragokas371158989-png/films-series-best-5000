es":0,"poster":"https://image.tmdb.org/t/p/w342/rk4eMJdaWKDALEiviswL7DFuXBA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9GWI1B0xXMJ2rtTOTjGK4fmvKac.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1494142","ru":"Богатыри","en":"Богатыри","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/cSPEwmixROARNSRlvMFHBdS5KVh.jpg","backdrop":"","genres":["комедия","фэнтези","семейный"],"overview":"Древняя Русь. Богатырь Святогор победил злого Колдуна, который хотел захватить Русь — для этого он с помощью магии превратился в Дракона. Святогор спрятал три артефакта (коготь, глаз и жилу Дракона) в современном мире, чтобы зло никогда не вернулось. Но из-за школьника Вани в наше время проникает возлюбленная Колдуна. Она хочет найти эти артефакты, воскресить Дракона и вернуть своего суженого к жизни. Вместе с двумя богатырями из древней Руси Ваня должен отыскать злодейку и не дать ей осуществить задуманное.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"322458","ru":"Natalie Cassidy: Caring Together","en":"Natalie Cassidy: Caring Together","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/nXz7mCJxfwOako1e4Mv6XYcHjZS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1caCkJ7NnfpzWAo6SITY9glbNOL.jpg","genres":["документальный","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"322126","ru":"World Wide Mafia, 'Ndrangheta","en":"World Wide Mafia, 'Ndrangheta","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/on88qvkBtZH3YUELMNW0MYc9XwF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qZ9lDrqdK4yHCyFrW0AzaRPujes.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"320416","ru":"A Menina que Morava no Colégio","en":"A Men