ьному роботу с искусственным интеллектом. Тот следит за ее расписанием, запрещает сладкое и контролирует каждый шаг. Вместе с другом Никитой Злата разрабатывает план, как вернуть себе свободу, но ситуация выходит из-под контроля.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1698209","ru":"Monument","en":"Monument","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/bgrH6fU5RHDXRDobTAdBecml4YT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k6itH3iCWRnNRiWuQ0flP10FYXT.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1208270","ru":"새벽의 Tango","en":"새벽의 Tango","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/pSPv9MaIHHV5RkZNcvvJxOFDMiy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kc6cVpMxhjupLifRjwJcAuUFjWr.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"889330","ru":"Humboldt USA","en":"Humboldt USA","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/fIQdtFjPmynBpOlrrPtspGigWJP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8ZWecMcCa4iLyq3pRD6Ogp9QqKh.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"324043","ru":"Big Girls Wanted: Escaping Pearadise","en":"Big Girls Wanted: Escaping Pearadise","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/M4T0ColVoLCGnxdyNsSEBOuMji.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a4I08bxeepepOewrhZ4lAZSdoAl.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"321436","ru":"Bad Boys DR","en":"Bad Boys DR","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/t02gRcYzIOd1SAhhTjVG26WA