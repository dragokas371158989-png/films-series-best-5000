image.tmdb.org/t/p/w342/ci2TWjr5hE6kamB8NrKzfN7gSSz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ndhPmyrDvdf1rZvl26goxPmBuPv.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"283884","ru":"Губы замужней женщины на вкус как тюхай в жестяной банке","en":"人妻の唇は缶チューハイの味がして","year":"2025","type":"Аниме","rating":5.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/zdW66E4S2JKTrkh4K2BU5b2kwQX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3eyEpB3ppPQiuuoXTj1zWCEjc35.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Когда студент колледжа Цуеси возвращается в свою квартиру из круглосуточного магазина, он с удивлением видит на пороге Юи Коорияму. Отправленная матерью проведать его, Юи вторгается в его личное жилое пространство. Несмотря на то, что Юи уже замужем, казалось бы, обычный визит принимает неожиданный оборот, когда они напиваются и проводят ночь вместе. Когда другие замужние женщины приглашают его выпить еще, Цуеси обнаруживает, что делится с ними всевозможными интимными моментами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1137438","ru":"Messy","en":"Messy","year":"2025","type":"Фильм","rating":5.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/ztwYrF53qPcZP1naQHh7lF0XDLI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yElJ8VVIcMGtzsm97zvbd5ntHk6.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"311254","ru":"EVO","en":"EVO","year":"2025","type":"Сериал","rating":5.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dNXOoOHP6v8XfpUWjYc3kWR6a9J.jpg","backdrop":"https://image.tmdb.org/t/p/w780/u55eoKux5TZxSfWUl3EQfqWKYRM.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1274837","ru":"Миллион","en":"Le Million","year":"2025","type":"Фильм","rating":5.5,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/u9OdrWDhUUod0v9eqrVszAEpMl0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hJZi4BNyejM0BtBlWsMhGx7dUoq.jpg","genres":["комедия","криминал"],"overview":"Главный герой — менеджер строительства, которого несправедливо уволил тиран-генеральный директор. Он решает украсть 1 млн евро из сейфа компании. Но когда узнает, что на самом деле ему готовили повышение, приходится исправлять свою ошибку.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1289893","ru":"Сомния: Обитель кошмаров","en":"Somnium","year":"2025","type":"Фильм","rating":5.5,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/8Wb2YwsCIE612htEcBJ91UoqveG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xM2dUqkpaSHOR87ojZ538DGQqcD.jpg","genres":["фантастика","ужасы","триллер","драма"],"overview":"В экспериментальной клинике сна \"Сомния\" сны становятся реальностью. Побочные эффекты могут включать галлюцинации, спутанность сознания, паранойю, сонный паралич, отрешённость от реальности, потерю самоощущения, постоянные ночные кошмары.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1403327","ru":"Coartadas","en":"Coartadas","year":"2025","type":"Фильм","rating":5.5,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/nllCLiirEjiF78efF9pk8XSTm2Z.jpg","backdrop":"https://image.tmdb.org/t/p/w780/drMidAxpR0IN9rUAu3Cv2moV5BW.jpg","genres":["комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1484267","ru":"Полный провал: мамы-детективы","en":"Trainwreck: P.I. Moms","year":"2025","type":"Фильм","rating":5.5,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/gACBkTDNDP2GGspeFkn7AhCpiL3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/z8HgoAXiJgMGegIyynsAJ4No1Dw.jpg","genres":["документальный"],"overview":"Откровенный документальный сериал о реалити-шоу начала 2000-х про мам-частных детективов и о наркотическом скандале, который стал причиной краха проекта и его звезд.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1169210","ru":"The Mannequin","en":"The Mannequin","year":"2025","type":"Фильм","rating":5.5,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/oFTpB1gzS02LtrsenTWxOKbsMpM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/z6Pi72HrGhc50GDhDdREUTEh2xm.jpg","genres":["ужасы","триллер","криминал","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1026542","ru":"Проклятие. Паранормальное видео","en":"Baby Blue","year":"2025","type":"Фильм","rating":5.5,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/hSby2WRKinP4CCWrdXJTQDv1x2P.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rXHw864JjVLaPis7e7YW6LHfpag.jpg","genres":["ужасы","комедия"],"overview":"Группа начинающих блогеров решает снять расследование загадочной истории серийного убийцы Малыша Блума. По городской легенде он продолжает охоту с того света: все дело в проклятом видео, посмотрев которое, жертва чувствует непреодолимое желание покончить с собой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1012180","ru":"ഐഡന്റിറ്റി","en":"ഐഡന്റിറ്റി","year":"2025","type":"Фильм","rating":5.5,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/hrusjWrcRuClY6PNooSZiKL6gqv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/d8fgJIUyvJa0NGkZ7VQBlgJADIK.jpg","genres":["боевик","триллер","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1539746","ru":"President Down","en":"President Down","year":"2025","type":"Фильм","rating":5.5,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/fGhd4DurS1rhmNOb7b9EeobQTPe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mDjsakfVVKMPJyMmxbA9dddFIjQ.jpg","genres":["боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1418305","ru":"Заклятие. Последний ритуал","en":"สุสานคนเป็น","year":"2025","type":"Фильм","rating":5.5,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/rcwRnold723gIjFPya1hRQ61ccs.jpg","backdrop":"https://image.tmdb.org/t/p/w780/DdsdqgPJaiTJ8dJ39aJtQTUksE.jpg","genres":["драма","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"279116","ru":"Смерть Банни Манро","en":"The Death of Bunny Munro","year":"2025","type":"Сериал","rating":5.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/enarhiECET5jXpvdzq7tweeP7FW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ogi8uZCaW17tmz5uOQkUoxXKVSX.jpg","genres":["драма"],"overview":"Банни Манро - продавец косметики, сексоголик и женоненавистник - после самоубийства жены остается один с 9-летним сыном. Их посещают дамы из опеки и пытаются забрать мальчика. Отец с сыном сбегают и отправляются в безумное автомобильное путешествие по Южной Англии, где орудует серийный убийца… «Смерть Банни Манро» снята по одноименному роману, который написал музыкант и лидер группы Bad Seeds Ник Кейв","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1008445","ru":"Пророк. История Александра Пушкина","en":"Пророк. История Александра Пушкина","year":"2025","type":"Фильм","rating":5.5,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/u1c7hlPdCFMUOe77Ttee3UVLjRD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mdFrkufYmXcoohvFxvoALidSqJ1.jpg","genres":["мелодрама","музыка"],"overview":"Пушкин молод, дерзок и любим публикой: он звезда любого бала, поклонники носят его на руках, а девушки мечтают о его внимании. Но ни высокие покровители, ни верные друзья, ни известность не могут отвести от него злой рок — ссылки, дуэли, безденежье. Пока однажды он не встречает ту самую, единственную, кто осветит его жизнь и станет его судьбой. Судьбой гения, которого нам только предстоит по-настоящему узнать.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"945836","ru":"ഓടും കുതിര ചാടും കുതിര","en":"ഓടും കുതിര ചാടും കുതിര","year":"2025","type":"Фильм","rating":5.5,"votes":11