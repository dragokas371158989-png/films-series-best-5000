ается с места аварии, но муки совести её не отпускают. Терзаемая чувством вины, Настя устраивается врачом в больницу, где лежит Дмитрий, и делаёт всё возможное для его выздоровления: оплачивает VIP-палату и находит редкие препараты. Тем временем бывший жених узнаёт о её тайне и начинает шантажировать Настю и её отца.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"316343","ru":"Une Femme à Kosyam","en":"Une Femme à Kosyam","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/qgKsCvtL6wYlQB3Fs3kWOJpTJnB.jpg","genres":["драма","Война и Политика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"316167","ru":"Bodiel L'héritière","en":"Bodiel L'héritière","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/vdnp1iTy5EbKDygKwWtzpYCr3RJ.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"315773","ru":"Skok na głęboką wodę","en":"Skok na głęboką wodę","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/d4LxwC3XaWezkpkyc6Pn0MN3Pu5.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"318640","ru":"Mtl Man","en":"Mtl Man","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/3T72CzLOmJf64mktBMv3JGwyBvd.jpg","genres":["комедия","НФ и Фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"316093","ru":"Way To You","en":"Way To You","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/8XiDS0EIhfESwk2dA9nSYWqiTDH.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","tmdbId":"","episodes":"