ype":"Сериал","rating":4.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/u5WZQoem6xq8VDdyefWb1P10MZL.jpg","genres":["драма"],"overview":"Сериал рассказывает о разведённом дайвере Винсе и его дочери-подростке Зои. Они отправляются в отпуск на остров Терсхеллинг. Винс хочет восстановить отношения с дочерью, но сталкивается с трудностями из-за местных жителей, которые презрительно называют туристов «курортниками». Ситуацию осложняют взаимные секреты и ложь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1523071","ru":"Over De Grens","en":"Over De Grens","year":"2025","type":"Фильм","rating":4.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/2cC2MwN0KVNvo57mw2XSGegSpyo.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1636603","ru":"Daggers Inn","en":"Daggers Inn","year":"2025","type":"Фильм","rating":4.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/sjpN0pwRV12MmVHc1oFDkbyc4cu.jpg","genres":["триллер","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1318642","ru":"ดีว่า..ราวี","en":"ดีว่า..ราวี","year":"2025","type":"Фильм","rating":4.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/lw9hl7SKlrfsCc7XkiMD659yTAT.jpg","genres":["комедия","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1005156","ru":"निकिता रॉय","en":"निकिता रॉय","year":"2025","type":"Фильм","rating":4.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/p40CvbEkeQtDShKgM8G4DRWtZKw.jpg","genres":["детектив","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1433114","ru":"Tarot Curse","en":"Tarot Curse","year":"2025","type":"Фильм","rating":4.7,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/gAUyxtELzgi1HrcGTHMyqgMkErK.jpg","genres":["ужасы","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","countr