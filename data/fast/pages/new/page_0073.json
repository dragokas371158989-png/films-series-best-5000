лжёт, а мифические существа — вовсе не те, кем их считают. Теперь ей предстоит сделать выбор, который решит судьбу обоих миров, пока всё живое окончательно не превратилось в лёд.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"299962","ru":"ねずみくんのチョッキ","en":"ねずみくんのチョッキ","year":"2026","type":"Аниме","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/jci1UzaAZeT38UpakXIGvE9lGlC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/d6sITUCgpGm6TOZvqZvldAcBxJd.jpg","genres":["мультфильм","Детский","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"324319","ru":"Grand Banda","en":"Grand Banda","year":"2026","type":"Аниме","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/qku2eaK1PbxG3f6EMPwhCnG8Tjv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eFaVBdGJCXbKPn0IsROQwya7KUG.jpg","genres":["мультфильм","семейный","комедия","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"324630","ru":"Геймовёрс","en":"Gameoverse","year":"2026","type":"Аниме","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/vKxoVHTazpHH0BJLoeLTRuKznkH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qhLASJCC7aLxWkvgzTBecCZJEC3.jpg","genres":["мультфильм","Боевик и Приключения","драма","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315187","ru":"O Mundo [Sem Filtro] de Any Malu","en":"O Mundo [Sem Filtro] de Any Malu","year":"2026","type":"Аниме","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/zku7w9RL6rpE1Dp3OuKioDVSZAC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/msXQCQjk5haw0SbJ8ZjA30PuJVz.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"307325","ru":"The Eyes","en":"The Eyes","year":"2026","type":"Аниме","rating":0.0,"v