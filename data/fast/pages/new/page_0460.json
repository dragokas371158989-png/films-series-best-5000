b.org/t/p/w342/56d5qx6nxjPXoN4ftsAAmq79ZkK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bTonah7ZVdrTrnnI9daCwH4KJIL.jpg","genres":["ужасы"],"overview":"Доктор Кемаль скрывается с семьёй в загородном доме, спасаясь от мафии и пытаясь вылечить больную дочь. Однако в особняке начинают происходить странные и пугающие явления. Его мать с деменцией всё чаще ведёт себя одержимо, а таинственная женщина предлагает помощь, за которой скрывается тёмный замысел. Когда наступает ночь Черной луны, прошлое оживает, и древнее зло выходит на свободу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1217300","ru":"Arctic Armageddon","en":"Arctic Armageddon","year":"2024","type":"Фильм","rating":3.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/uBPqCP5kuQ3Nzhf0KornLbhQFHK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sPMR3tsZ7qFHna5dLus3eFjDipG.jpg","genres":["фантастика","боевик","приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1288104","ru":"Road Wars: Max Fury","en":"Road Wars: Max Fury","year":"2024","type":"Фильм","rating":3.3,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/2Zeoj60KpLlGDn4VEyvypsB3GUW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pTynPlndooLBf2ysBkwtCeLQuWb.jpg","genres":["боевик","приключения","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1045467","ru":"Not Another Church Movie","en":"Not Another Church Movie","year":"2024","type":"Фильм","rating":3.3,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/hLEWhuLToCrSCs3viyM6E4ztOHj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t1uSzpjK03WY53LntehNdnjyLxY.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1405185","ru":"Mama's Boy","en":"Mama's Boy","year":"2024","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/1zW70wqJWSsDakL0iDt80UyR9z7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vrFq9PbfeR5Jhis2Mr0zMh8ghIo.jpg","genres":["драма"],"overview":"О жизни и творчестве оскароносного сценариста Дастина Лэнса Блэка, который рос в строгой религиозной семье. Опираясь на мемуары самого Блэка, фильм рассказывает о нелегком детстве сценариста, его пути к признанию, а также глубоких и трогательных отношениях с матерью; раскрывает Дастина не только как успешного и интересного сценариста, но и как активиста, который всегда черпал вдохновение в любви.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"947595","ru":"Rock Bottom","en":"Rock Bottom","year":"2024","type":"Мультфильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/6ZDzGsPZEGsLwDeBQBb8omTQyDk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bp6WIKSLHCwxj44xCYYieWi7Spm.jpg","genres":["мультфильм","драма","музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1281979","ru":"The Pastor","en":"The Pastor","year":"2024","type":"Фильм","rating":3.3,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/leVgXva9F9SbmzHSTjJCSeDafsb.jpg","backdrop":"","genres":["боевик","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1281732","ru":"Последнее местоположение","en":"Last Known Location","year":"2024","type":"Фильм","rating":3.2,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/pmz3HMKOXFQbZX0KYA9GNVtv7OZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/i6CPwhjxhL8rCJfru3cYzPcOKiN.jpg","genres":["триллер"],"overview":"Когда трёх женщин из разных слоёв общества похищают, детективы пытаются найти что-то общее между ними. Со временем женщины образуют невероятную связь, борясь за выживание со своим жестоким похитителем. Найдут ли их детективы, пока не станет слишком поздно?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1385524","ru":"Pukpok","en":"Pukpok","year":"2024","type":"Фильм","ratin