.tmdb.org/t/p/w342/AjReoMquyIuNBLeR5iL8IPQQPY3.jpg","genres":["комедия","ужасы","фантастика"],"overview":"1957 год. Небольшая группа местных жителей пытается сорвать космический план Дракулы по превращению населения их маленького городка в армию вампиров-зомби.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"261675","ru":"家事法庭","en":"家事法庭","year":"2026","type":"Сериал","rating":6.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/8sxttf1E82L6A7FxCAP4PQ1gc9s.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"304820","ru":"Рыба, которую я упустила, большая, но я поймала другую, которая ещё больше","en":"逃がした魚は大きかったが釣りあげた魚が大きすぎた件","year":"2026","type":"Аниме","rating":6.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/o5Gw2Wcd8saEpzQgzpUBwiqJ3WG.jpg","genres":["мультфильм","комедия","НФ и Фэнтези","Аниме"],"overview":"Когда принц внезапно расторгает помолвку, по столице разлетаются сочные слухи: бедняжка принцесса упустила \"золотую рыбку\"! Но пока сплетники жалеют «неудачницу», сама героиня едва сдерживает радостную улыбку. Прощай, скучный протокол и навязанный брак — здравствуй, долгожданная свобода! Кто же знал, что судьба решит подыграть ей настолько эффектно? Не успела она насладиться одиночеством, как в её сети заплывает \"улов\" поистине королевского масштаба — парень куда статуснее, сильнее, да и симпатичнее бывшего. Теперь злопыхателям остаётся только кусать локти, глядя, как мастерски героиня управляется с добычей, которая всем остальным явно не по зубам.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1337592","ru":"Erupcja","en":"Erupcja","year":"2026","type":"Фильм","rating":6.4,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/1OMiyrpkZvu5YmWbPBtwDQHZsu1.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1661439","ru":"Yiya Murano: Muerte a la hora del té","en":"Yiya Murano: Muerte a la hora del té","year":"2026","type":"Фильм","rating":6.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ma7BCNDfvndKg2mVRJqGJ83T9bp.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1359005","ru":"Через тернии к звёздам","en":"星河入梦","year":"2026","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dKT6A7yQWxvRhZwX5uudHofvpja.jpg","genres":["драма","фантастика","приключения"],"overview":"В будущем межзвёздные полёты стали обыденностью. На время долгого путешествия экипаж погружают в анабиоз, а чтобы нейроны мозга не деградировали, людей подключают к инновационной системе виртуальных сновидений. На космическом корабле, направляющемся к далёкой планете с колонизаторской миссией, для выполнения плановой проверки выходит из анабиоза техник Сюй Тяньбяо и становится свидетелем аварии и глобального сбоя. Пока система не сделала идиотами весь экипаж, ему нужно разбудить капитана, но сделать это можно только проникнув в её сон.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1628522","ru":"Чай на двоих","en":"Two for Tee","year":"2026","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/bEHc7cpqNAG6HhD24hHB1qltcy5.jpg","genres":["мелодрама","драма"],"overview":"Ти - художница и американка китайского происхождения, которая занимается гончарным искусством и через творчество всё глубже открывает для себя традиции собственной семьи. В общественном центре она знакомится с разнорабочим Уиллом, и эта встреча постепенно меняет их обоих. Пока Ти ищет связь с корнями и пытается понять себя через искусство, им вместе с Уиллом приходится бороться за судьбу центра, которому грозит закрытие. Но смогут ли они сохранить это место, пока оно не исчезло вместе со всем, что для них стало важным?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1610840","ru":"Godari Gattupaina","en":"Godari Gattupaina","year":"2026","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/jVENga0uWeOM3vc7KtLhieBwNRy.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1608620","ru":"Romance at Hope Ranch","en":"Romance at Hope Ranch","year":"2026","type":"Фильм","rating":6.4,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/arwU50Da8nL7xgPQHAwZjV4aQMo.jpg","genres":["мелодрама","телевизионный фильм","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"299365","ru":"신입사원 강회장","en":"신입사원 강회장","year":"2026","type":"Сериал","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ryoklqf5Xi76b1Cqb0h4I7zL6qa.jpg","genres":["драма","НФ и Фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"278868","ru":"方圆八百米","en":"方圆八百米","year":"2026","type":"Сериал","rating":6.4,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/oj688ZRAnYQrcqk59euex7laL10.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1433117","ru":"கர","en":"கர","year":"2026","type":"Фильм","rating":6.3,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/uIrFdMWlJFdc1jPBP9bxeaISCDj.jpg","genres":["криминал","драма","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1466123","ru":"L'Objet du délit","en":"L'Objet du délit","year":"2026","type":"Фильм","rating":6.3,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/AdM7jQOEdRZ0DW6nfizLwxhSmVI.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb",