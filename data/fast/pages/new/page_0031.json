s":3,"poster":"https://image.tmdb.org/t/p/w342/yuE0bg57lHJ6f3CT0GZU1YBu9L1.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1247729","ru":"Amityvillenado","en":"Amityvillenado","year":"2026","type":"Фильм","rating":9.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/gG6fPTz1Dg2KnVNBv6PwdLC152z.jpg","genres":["ужасы","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"308098","ru":"The Cult of the Real Housewife","en":"The Cult of the Real Housewife","year":"2026","type":"Сериал","rating":9.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/xa3gp2ivjjXK31Y9Zj9tgXihalU.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"313357","ru":"Убежище","en":"Asylum","year":"2026","type":"Аниме","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/b1vOavreFfqGOEs3HUAMBsphXq0.jpg","genres":["драма","Аниме"],"overview":"Семья, бежавшая из родной страны из-за войны, отправляется в Европу на машине. Однако их путь прерывается, и они оказываются в плену на загадочном острове. Сюда свозят беженцев со всего мира, каждый из которых надеется на новую жизнь. На острове их ждут смертельные испытания. Камеры, установленные повсюду, транслируют происходящее через Deep Web. За этим жестоким шоу следит международная организация, которая делает ставки на исход. Правила просты: те, кто выживет, получат шанс на новую жизнь в выбранной стране. Остальные погибнут.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"313395","ru":"大賢者リドルの時間逆行","en":"大賢者リドルの時間逆行","year":"2026","type":"Аниме","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/nI42iJ6GAWN6U4MkJgLq75vGNmx.jpg","genres":["мультфильм","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"320988","ru":"283 Production XXXX Performance XXX= S/N-GUL4R1TY","en":"283 Production XXXX Performance XXX= S/N-GUL4R1TY","year":"2026","type":"Аниме","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/6VbAilTVsGwMiXkfveHVHLgsRgi.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"287009","ru":"Стойкий доктор","en":"닥터 섬보이","year":"2026","type":"Сериал","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gBMouxOXSMyV7FIroOh9pfaB2JA.jpg","genres":["комедия","драма"],"overview":"Лучшие выпускники медицинских вузов Южной Кореи проходят обязательную военную службу в качестве врачей системы здравоохранения. Пластический хирург То Джиый получает назначение на изолированный остров Пхёндондо, где с самого первого дня начинают происходить странные события. Удастся ли ему пережить этот год?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"311650","ru":"Сельская жизнь в Ëннири","en":"심우면 연리리","year":"2026","type":"Сериал","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qddUSO6quUv6forSwHU84Pon09N.jpg","genres":["комедия","семейный","драма"],"overview":"Однажды в деревню Ёнрири, которую местные называют «чистой, но суровой зоной», можно сказать, ссылают главного героя Сон Тхэ Хуна. Он менеджер в крупной компании, а его отправляют в местный филиал разбираться с урожайностью капусты. По сути, это понижение, но главный герой решает перетерпеть, думая, что один как-нибудь перебьётся и найдёт способ вернуться в Сеул. Только в деревню неожиданно заявляется вся его семья - жена Чо Ми Рё, которая ведёт блог и тащила на себе троих сыновей в Канаде, и все три парня, включая старшего, который тайком бросил мединститут.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"281965","ru":"Как стать домовладельцем в Корее","en":"대한민국에서 건물주 되는 법","year":"2026","type":"Сериал","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/h9xNeUT8Yw7FR0t7i9OaW5dsgA4.jpg","genres":["криминал","комедия","драма"],"overview":"Су Чжону грозит продажа его здания с аукциона. Хваль Сон предлагает инсценировать похищение. Но план выходит из-под контроля, когда обман превращается в реальность, что приводит к экстремальной ситуации.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"308136","ru":"Долина Надежды: 1874","en":"Hope Valley: 1874","year":"2026","type":"Сериал","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/eeLjXfVcjfVyMOQueM9ODMnc2On.jpg","genres":["драма"],"overview":"Возвращение к самым ранним дням общины, которой однажды суждено было стать любимой Долиной Надежды, — история о вере, мужестве и радости строить жизнь вместе с самого начала.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"313665","ru":"Макс Ферстаппен: Новый путь","en":"Max Verstappen - New Ground","year":"2026","type":"Сериал","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/waZCdF7Dh56GNJLEfIwrRNMmpYD.jpg","genres":["документальный"],"overview":"Следите за Максом в его новом испытании: превращении виртуального гонщика Криса Лулхама в профессионального гонщика. Вне Формулы-1 Макс расширяет границы возможного и направляет свою страсть на развитие талантов, от гонок на выносливость на 24 часах Спа до легендарной Нордшляйфе.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1212952","ru":"Боксёр","en":"Heavyweight","year":"2026","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/mWWx9HNNvsLxWfg7jhA9bZcbeyD.jpg","genres":["драма"],"overview":"Дерек «Даймонд» Дуглас — боксёр с невероятным потенциалом, но хаотичной, нестабильной манерой боя. Судьба даёт ему шанс: титульный поединок, который может навсегда изменить его жизнь. Дорога к чемпионскому поясу превращается в испытание на прочность. Внутри команды нарастают конфликты, спонсоры требуют шоу, соперник начинает играть по-грязному, а тени прошлого не отпускают Дерека. Боксеру предстоит выйти на ринг, чтобы победить не только соперника, но и собственных демонов.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"289271","ru":"翘楚","en":"翘楚","year":"2026","type":"Сериал","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vcU56Dw1aKxTTlhrVr0qvPnljDV.jpg","genres":["драма","НФ и Фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1480790","ru":"追恶","en":"追恶","year":"2026","type":"Фильм","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gar7WVDgFo7EIlr0MZf4w7dckk1.jpg","genres":["криминал","боевик","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"313406","ru":"Chernobyl: Inside the Meltdown","en":"Chernobyl: Inside the Meltdown","year":"2026","type":"Сериал","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/h6pIX1Q7TgqoKt4Gg4APDJtc8D1.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"274641","ru":"九尾藏不住","en":"九尾藏不住","year":"2026","type":"Сериал","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/uhMgwSTupwkVMOkaAHIzmgVpcpC.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"310097","ru":"Uniformen","en":"Uniformen","year":"2026","type":"Сериал","rating":9.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/AlYabXOCqxI5Lj0HxcC8sNUgUyw.jpg","genres":["драма","криминал"],"overview":"","source":"tmdb","tmdbId":