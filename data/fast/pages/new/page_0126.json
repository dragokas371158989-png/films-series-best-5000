ек отправляется на затерянный в океане остров, чтобы научиться кайтсерфингу. Они мечтают летать над водой, как их инструкторы, странные грубоватые ребята, одержимые страстью к волнам и ветру. Парни не очень рады необходимости кого-то обучать, но им нужны деньги для поездки на Кабо-Верде. Что же такое настоящий кайтсерфинг – радость полета или боль и унижения? И что такое свобода островных жителей – принятие своего пути или бегство от большого мира?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1689267","ru":"Peuple de Loire","en":"Peuple de Loire","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/9j1vKGP1Lj6nCbnG5shFe8SA10L.jpg","genres":["документальный","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1606423","ru":"Spirits Talk","en":"Spirits Talk","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/rJ2suFnNTOaz9bacO78diQ4OIJ6.jpg","genres":["драма","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1550899","ru":"Gestern war noch Sommer","en":"Gestern war noch Sommer","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/oMzJQfWE2Vt9t3uspK7QFJAUchx.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1697907","ru":"Bullet Brain","en":"Bullet Brain","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/1qYj6ZIfiQ6qlqSbRqnJynxyPgP.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1685485","ru":"रोल नं १","en":"रोल नं १","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/tkq2a2WHkOWmruRxFRIAzu9NStF.jpg","genres":["драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":""