езвычайно талантлива: её предложения идут на пользу бизнесу. Со временем деловые отношения между героями перерастают в романтические, но обстоятельства играют против них. Смогут ли влюблённые выдержать испытания, не потерять друг друга и построить своё «Близкое счастье»?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1455360","ru":"ノモの国","en":"ノモの国","year":"2025","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/dwAiFiR8pvU7Y61r5yeBjYqd8w6.jpg","genres":["мультфильм","драма","приключения","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1564672","ru":"கொம்புசீவி","en":"கொம்புசீவி","year":"2025","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/dHopJETvP974dxkowWbmrr42EKD.jpg","genres":["боевик","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1424966","ru":"Алдан","en":"Алдан","year":"2025","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/cz1iOfj3GKdVd2DEtITkiDyFT4k.jpg","genres":["драма","военный"],"overview":"После гибели дочери в результате теракта Спиридон Дьяконов решает найти преступников и становится военным врачом на передовой, сталкиваясь с непростыми моральными дилеммами.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1091227","ru":"Hurricanna","en":"Hurricanna","year":"2025","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/wkfNtCE2ozSgmUWHk1uUnXUv6nn.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1473330","ru":"তোমার জন্য মন","en":"তোমার জন্য মন","year":"2025","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/tjoMDdT6NCAkcNTn8LQvfTWlOCB.jpg","gen