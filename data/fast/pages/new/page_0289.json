м","rating":8.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/AicPTKoKJh1sNOgOhlE3LQT3NUw.jpg","genres":["драма","фэнтези","ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}