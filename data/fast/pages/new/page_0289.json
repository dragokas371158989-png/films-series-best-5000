нимают решение объединить свои силы. Их цель — восстановить равновесие и возродить Альянс Единства, некогда поддерживавший мир и гармонию. В седьмой день седьмого месяца они встречаются в Бамбуковом павильоне у реки Хуай, еще не ведая, что эта встреча навеки свяжет их судьбы неразрывными узами.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1422008","ru":"Fucktoys","en":"Fucktoys","year":"2025","type":"Фильм","rating":8.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/hYDSzen6p8wkhkskWzwgr5dz5EN.jpg","genres":["комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1411564","ru":"新・暴れん坊将軍","en":"新・暴れん坊将軍","year":"2025","type":"Фильм","rating":8.9,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/c6RAhSbRgNuJA7hSHvsmlyID4Z.jpg","genres":["телевизионный фильм","боевик","история"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"285049","ru":"Désenchantées","en":"Désenchantées","year":"2025","type":"Сериал","rating":8.9,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/t5aa9matQKtqDWCJiMBuBczFi30.jpg","genres":["драма","детектив","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_282662","ru":"Пересечение стен любви с тобой","en":"キミと越えて恋になる","year":"2025","type":"Аниме","rating":8.8,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/yFrS0rolrieTX8xMbsnANwqpUvG.jpg","genres":["мультфильм","драма","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"223896","ru":"Прикоснуться к душе","en":"스피릿 핑거스","year":"2025","type":"Сериал","rating":8.8,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/5o3UW021gh5u2CefyD0WV2aPyFv.jpg","genres":["комедия","драма"],"overview":"У-ен - обычная старшеклассница, привыкшая быть незаметной в семье, где все внимание достается братьям. Однажды на улице к ней подходит юноша и предлагает попозировать для скетч-клуба «Прикоснуться к душе». У-ен видит ярких и эксцентричных участников этого сообщества, соглашается и впервые чувствует себя принятой, после чего вступает в клуб. Новые знакомые поддерживают девушку и делают ей комплименты, благодаря чему она постепенно раскрывает свой талант, учится выражать эмоции и перестает бояться быть собой. Но вместе с новым окружением приходит и новое испытание - понимание того, кем она хочет стать и за что готова бороться.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1443184","ru":"উৎসব","en":"উৎসব","year":"2025","type":"Фильм","rating":8.8,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/oA3mmn4fqiNVbspRsON1gVEHOzG.jpg","genres":["комедия","драма","семейный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"261600","ru":"Всегда дома","en":"树下有片红房子","year":"2025","type":"Сериал","rating":8.8,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/swTfQ5TTEtkKvlop3MzegnZPVZf.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"281705","ru":"絕命法官","en":"絕命法官","year":"2025","type":"Сериал","rating":8.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/iF9m52dnMGWNNn2kclbEgSKTeDF.jpg","genres":["криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"274162","ru":"كارثة طبيعية","en":"كارثة طبيعية","year":"2025","type":"Сериал","rating":8.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/xFrGCYgp3JfluOGRi8nhlZdN6xN.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"296202","ru":"地球超新鲜","en":"地球超新鲜","year":"2025","type":"Сериал"