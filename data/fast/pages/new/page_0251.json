ния научно-исследовательской агломерации в подмосковной деревне. В результате несчастного случая – взрыва, обернувшегося потерей части руки, – главный герой Дмитрий Калинин решает создать протез собственной разработки. Решение этой задачи перерастает в глобальный проект по созданию инженерно -технического хаба. Дмитрий привлекает инженеров-самоучек со всей страны. Так пережитая главным героем трагедия превращается из деструктивного события в созидательное. Начинается рождение его личной малой инженерной вселенной.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1658267","ru":"Pinwydd","en":"Pinwydd","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/3m8bWF6uFQSaltE97e6uPSuuvGL.jpg","genres":["ужасы","фэнтези","фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1651438","ru":"Sticks","en":"Sticks","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/pf7aF1Sr3QKPUxgCljt96Kbaelw.jpg","genres":["приключения","боевик"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1641894","ru":"Color Print as Reversal","en":"Color Print as Reversal","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wgfl3RxiaJ0yGT3Lzcr8LnxKqY1.jpg","genres":["детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1603086","ru":"Joelma - Isso É Calypso Tour Brasil: Ao Vivo em Vitória","en":"Joelma - Isso É Calypso Tour Brasil: Ao Vivo em Vitória","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/13Ben9cxEeMe1qqqq6LGO0op8nh.jpg","genres":["музыка"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1