1580651","ru":"The Shuffle","en":"The Shuffle","year":"2025","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/jJzjKLeRBuKw8XzngFZFuqHeDq4.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"233295","ru":"仙剑奇侠传叁","en":"仙剑奇侠传叁","year":"2025","type":"Аниме","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/gorGXNaHiFIBn7EEafx5uh7VzhT.jpg","genres":["мультфильм","Боевик и Приключения","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"301043","ru":"天相","en":"天相","year":"2025","type":"Аниме","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/5eX2letlL8kIRKjUaiuMsO6tW5e.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"281599","ru":"Я собираю мусор Небесного двора","en":"我在天庭收废品","year":"2025","type":"Аниме","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/xd6f5O3aRb6hPeXKP9ZtyrsM8Mn.jpg","genres":["мультфильм","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1571594","ru":"La fotógrafa","en":"La fotógrafa","year":"2025","type":"Фильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/95pZ9yB5SABddzaINITvZd7SvER.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"276510","ru":"Марокканская мафия: Тоннано","en":"Tonnano","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/w9E2V0gNOsWvoWvZ3NNB5tVXXcW.jpg","genres":["драма","криминал","Боевик и Приключения"],"overview":"После рождения сына Тоннано хочет оставить свое криминальное прошлое позади и начать честную жизнь в районе Ахтерхук, где живет его подруга Амани со своей семьей. Его приезд вызывает волнения в печально известной наркосемье Айсинков. Выясняется, что дядя Амани в долгу перед семьей, и Тоннано снова оказывается втянутым в преступный мир.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"287677","ru":"Нейровася","en":"Нейровася","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8XIcuH6QMhFixR2IgKIP55zvws6.jpg","genres":["комедия","детектив"],"overview":"Вася Фролов — полицейский старой закалки, привыкший действовать по интуиции и не доверяющий технологиям. Пережив развод и череду рабочих проблем, он получает необычного напарника — нейросеть Свету, установленную прямо в его мозг. Вместе они раскрывают запутанные преступления, от мелких краж до серьёзных дел, постоянно попадая в забавные ситуации. Света помогает Васе анализировать улики, вмешивается в его личную жизнь и спорит с ним о морали и чувствах. Постепенно грубый и упрямый следователь начинает понимать, что искусственный интеллект способен быть ближе к человеку, чем многие люди.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"304336","ru":"Константинополь","en":"Константинополь","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/xd3nMCl7gzwJxz8MKIcc9zJXfIB.jpg","genres":["детектив","драма"],"overview":"Ноябрь 1920-го года. Белогвардейский офицер Сергей Нератов прибывает из Крыма в Константинополь вместе с остатками разбитой армии Врангеля и гражданскими беженцами. Одинокий и сломленный, потерявший в революцию и Гражданскую войну абсолютно всё – армия разгромлена, жена и дети погибли – Нератов становится во главе русской эмиграции. В Константинополе, с которым русские беженцы связывали надежды на спасение и свободу, их ждет холодный прием. Сергей Нератов – принципиальный русский офицер, ставящий долг и честь выше личной выгоды. Он оказывается в совершенно чуждом мире, где беженцев из России воспринимают людьми «второго сорта» – изгоями, обреченными на нищету и гибель. Но Нератов оказывается способным отстоять право своих соотечественников на достойную жизнь. Он сможет защитить от произвола русский мир.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"305119","ru":"Мрачные хроники Древней Греции","en":"Ancient Greece: The Dark Chronicles","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qHEfzdWg9zwkeuvcsOy38KrKtwX.jpg","genres":[],"overview":"Древняя Греция известна как родина демократии, науки и архитектуры, но за блестящим мраморным фасадом скрывается более мрачная реальность. Этот документальный сериал раскрывает другую сторону греческой истории - зловещих богов, гнетущие законы и жестокие войны. Каждая серия освещает отдельную эпоху: морские традиции бронзового века, агрессивный экспансионизм архаического периода, величие классического времени и Пелопоннесскую войну, поставившую греческий мир на грань разрушения. В финале рассказывается история Александра Великого и хаос, который последовал после его смерти.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"305301","ru":"Знаменитые гангстеры с Шоном Бином","en":"Original Gangsters with Sean Bean","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/bqKG67StiHuGzijD3DEqn0yOh9X.jpg","genres":["документальный"],"overview":"Документальный сериал, в котором актёр Шон Бин рассказывает о самых известных фигурах организованной преступности прошлого. В каждом эпизоде он разбирает реальные истории Аль Капоне, Острых козырьков, близнецов Крей, «Королевы Гарлема» и других персонажей, чтобы понять, где в их биографиях правда, а где мифы. Сериал показывает, кем эти люди были на самом деле, чем они прославились и почему до сих пор остаются частью массовой культуры. В программе используются исторические реконструкции, архивные материалы и интервью с историками, криминологами и людьми, которые изучали этих преступников или знали их лично.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"287267","ru":"여왕의 집","en":"여왕의 집","year":"2025","type":"Сериал","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/a7f0oIcDl471jQf7AiAc2JamfzN.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1544335","ru":"Foreign Exchange","en":"Foreign Exchange","year":"2025","type":"Фильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/e4hLPRBRB3NY7WVwsPUVDPsMkKe.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1025011","ru":"राजागंज","en":"राजागंज","year":"2025","type":"Фильм","rating":7.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/fmM6eEVJksrmzrvRg3jCrnLuxCD.jpg","genres":["криминал","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}