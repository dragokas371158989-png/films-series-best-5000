ом и теряет сознание, а когда приходит в себя, понимает, что потеряла ещё и память. Выяснив, что они с пропавшей похожи как две капли воды, Кэй решает разыскать людей, которые видели Барбару и могут что-нибудь знать о том загадочном лесном существе.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"811944","ru":"గేమ్‌ ఛేంజర్‌","en":"గేమ్‌ ఛేంజర్‌","year":"2025","type":"Фильм","rating":5.0,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/qtOGsZoLW7QceqKmsOy5nSM6Aik.jpg","genres":["боевик","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1331349","ru":"Deux Pianos","en":"Deux Pianos","year":"2025","type":"Фильм","rating":5.0,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/cdLe3CLD3Q4uJXkDsjzJSd6CYSj.jpg","genres":["драма","мелодрама","музыка"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1383519","ru":"Playa de lobos","en":"Playa de lobos","year":"2025","type":"Фильм","rating":5.0,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/kvUDtcqsDX9uqnHd74h7doAzlKd.jpg","genres":["комедия","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1409850","ru":"The Death of Snow White","en":"The Death of Snow White","year":"2025","type":"Фильм","rating":5.0,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/sWTh1m8HtnV5glbUtL6syfiym9b.jpg","genres":["фэнтези","ужасы","боевик"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"764842","ru":"Мыслить как убийца","en":"스트리밍","year":"2025","type":"Фильм","rating":5.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/yyFYasuBuHqS4EoaNmbLhGdvr80.jpg","genres":["триллер","детектив","криминал"],"overview":"Самый рейтинговый стример начинает терять популярность. Чтобы спасти положение, он решает в прямом эфире устроить расследование серии нераскрытых убийств. Собирая улики, парень приближается к раскрытию личности убийцы.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1323049","ru":"Bone Face","en":"Bone Face","year":"2025","type":"Фильм","rating":5.0,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/xky2SGq9Oz4pdD1J9T3yt3deU9U.jpg","genres":["детектив","ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1339952","ru":"किस किस को प्यार करूँ 2","en":"किस किस को प्यार करूँ 2","year":"2025","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/sqCgEMxOKvb949xbxn35Wcfn50S.jpg","genres":["комедия","мелодрама","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1318308","ru":"ஆர்யன்","en":"ஆர்யன்","year":"2025","type":"Фильм","rating":5.0,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/rRjh3zumdW89fNMe4tdjmALB1xG.jpg","genres":["боевик","триллер","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"248488","ru":"Dime tu nombre","en":"Dime tu nombre","year":"2025","type":"Сериал","rating":5.0,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/vAmcxOxKX1n4njoj5i5w9atZj4c.jpg","genres":["НФ и Фэнтези","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"587370","ru":"Pohádky po babičce","en":"Pohádky po babičce","year":"2025","type":"Мультфильм","rating":5.0,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/6LZJKktqh9jTL27vMU6oxzdvB3W.jpg","genres":["мультфильм","драма","семейный","фэнтези"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1426083","ru":"Эскобанк","en":"אסקובנק","year":"2025","type":"Фильм","rating":5.0,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/bfgvVz0iR9G9fnnHNR1koGaQaEP.jpg","genres":["боевик","военный"],"overview":"Печально известная банда, каждый участник которой имеет свое тяжёлое прошлое, остро нуждается в наличных для собственных целей. Во главе стоит Ави Хаддад - криминальный авторитет из Майами, собравший команду для рискованной экспедиции в Колумбию: по карте сокровищ, спрятанных Эскобаром, они направляются в джунгли вокруг Медельина, к мрачному месту, которое местные нарекли «деревней наследников».","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1493663","ru":"Одно Чокнутое Лето","en":"脱缰者也","year":"2025","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/g5Pvbjn5S6KwXlz2nDGMcMF8lOQ.jpg","genres":["комедия","криминал"],"overview":"Лето 1999 года. Ма Фэй - не самый благополучный молодой человек, в прошлом имевший проблемы с законом, а ныне имеющий проблемы, связанные с наличием больших долгов, не смог придумать лучшего решения своих финансовых проблем, чем похищение сына собственной сестры с целью получения выкупа. Подруга Ма Фэя и его старый приятель по ходу действия становятся невольными участниками «банды похитителей». Далее всё усложняется с появлением одного безбашенного бандита-одиночки, который тоже не прочь поживиться выкупом, а также криминальных элементов, которым Ма Фэй должен деньги и у которых иссякло терпение. Конечно, сестра Ма Фэя и остальные родственники не готовы отдавать деньги горе-похитителю и пытаются всё решить мирно. Но в итоге ситуация совсем выходит из-под контроля, превращаясь в трагикомичный абсурд.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1249421","ru":"即兴谋杀","en":"即兴谋杀","year":"2025","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ckz0MSMog9RClCL4DsMaEYtO3jO.jpg","genres":["детектив","триллер","криминал"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1554565","ru":"Evil Nun","en":"Evil Nun","year":"2025","type":"Фильм","rating":5.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/nTB8j4LhL2HG9aezru58f9h4GYN.jpg","genres":["ужасы"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"296851","ru":"SI-VIS: The Sound of Heroes","en":"SI-VIS: The Sound of Heroes","year":"2025","type":"Аниме","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/fbssiB7q1Ek7pcG2W6AWi2UIJdk.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1545652","ru":"Красная маска. Настольная книга супергероя","en":"Handbok för superhjältar","year":"2025","type":"Мультфильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/ujB2hBfgLrALnTHFlON2OcuutbM.jpg","genres":["мультфильм","приключения","семейный"],"overview":"Десятилетняя Лиза переезжает в новый город и сталкивается с травлей одноклассников. Однажды, спасаясь от обидчиков в библиотеке, она находит самую необычную книгу в своей жизни — «Настольную книгу супергероя». В ней говорится, что у каждого есть потенциал и 101 суперспособность можно развить самостоятельно. Воодушевлённая Лиза начинает упорно тренироваться и достигает впечатляющих результатов. Теперь девушка может помогать тем, кто попал в беду. Надев Красную маску, она встаёт на защиту города.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1059007","ru":"Agra","en":"Agra","year":"2025","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/biX8D3kSh4HuZzf1r0ynRgaEJte.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1246595","ru":"الست","en":"الست","year":"2025","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/rRBB5LOq7RBeIocv7HMh1kPCSBL.jpg","genres":["драма","история","музыка"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1329271","ru":"ஓஹோ எந்தன் பேபி","en":"ஓஹோ எந்தன் பேபி","year":"2025","type":"Фильм","rating":5.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/ffnBY54B4Etmu0UCpMXiJNNTlRV.jpg","genres":["мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"299743","ru":"陛下わたしを忘れてください","en":"陛下わたしを忘れてください","year":"2025","type":"Аниме","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/y0VrJnFQXmMXF4ASTI7tkU0IoOc.jpg","genres":["мультфильм","драма","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"238346","ru":"Эна","en":"ENA. La reina Victoria Eugenia","year":"2025","type":"Сериал","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/edOf3B2ObfI8F6XZTeTHsUcFd0l.jpg","genres":["драма"],"overview":"Эна - это история королевы, а также женщины. О молодой англичанке, которая никогда не мечтала стать королевой Испании. Альфонс XIII, девятнадцатилетний король Испании с 1902 года, остановился на ней, и этот выбор вызвал недовольство его матери Марии Кристины. Она оставила свою семью, свои обычаи, свою культуру и была вынуждена отказаться от своей религии, чтобы жить в чужой стране, где первое, от чего она пострадала, было нападение в день свадьбы, во время парада на Главной улице. Эна никогда не чувствовала себя ни принятой, ни любимой, но всегда боролась за то и другое. Хотя в Испании её больше знают как Викторию Евгению, в британской королевской семье и в кругу их друзей её всегда ласково называли Эна.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1054626","ru":"The Bhootnii","en":"The Bhootnii","year":"2025","type":"Фильм","rating":5.0,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/l92cbxp7GIOQnKjMsSd2HLm10rE.jpg","genres":["комедия","ужасы","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}