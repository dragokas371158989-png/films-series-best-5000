42/sBANlmgOdrCEYMeXJLyh3qJ6URn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o3cZVhlZw3fAj1jJ5LM6bOQuKyY.jpg","genres":["драма","история","военный","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_263034","ru":"Путешествие за горы и моря","en":"赴山海","year":"2025","type":"Сериал","rating":7.0,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/jOEKN1yCpbTwuVCN4RxLCVHEn8c.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7dH63uoQDQu6pfYJLNKQYLXJ38m.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_261663","ru":"Легенда о Тёмной реке","en":"暗河传","year":"2025","type":"Сериал","rating":7.0,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/r9xXATAuqybQtidyTYSNwVfLt5Q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ftVwJEKXCgCKGCb75e3MXwEBWBV.jpg","genres":["драма","Боевик и Приключения","НФ и Фэнтези"],"overview":"Наёмная организация «Тёмная река», состоящая из семей Су, Се и Му, погружена в борьбу за власть. Верховный глава «Тёмной реки» находится при смерти, и каждый из глав семей стремится занять его место, посылая убийц для устранения соперников. Это становится началом смертельной гонки со временем, исход которой решит судьбу всей организации. Су Муюй, известный как «Призрак» и глава отряда «Паучья Тень», который подчиняется Верховному главе, против своей воли оказывается втянут в эту кровавую борьбу. Ради защиты своих принципов он вынужден поднять меч против своего лучшего друга.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1449951","ru":"Snow White","en":"Snow White","year":"2025","type":"Мультфильм","rating":7.0,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/ilFLHU1OxUS1YDvUMCr8K3hW28r.jpg","backdrop":"https://image.tmdb.org/t/p/w780/78mfMIC7itMnefZnS5ff4djAmnC.jpg","genres":["мультфильм","семейный","фэнтези"],"overview":"Злобная длинноволосая королева спрашивает у зеркальца в руке, кто прекрасней всех на свете, и зеркало отвечает, что это она. Но в пещеру королевы с песней о мачехе приходит Белоснежка, и теперь зеркальце самой прекрасной называет Белоснежку. Королева приказывает отрубить Белоснежке голову, но Коко и Бимбо не могут заставить себя выполнить указ. Белоснежку помещают в глыбу льда, а семь гномов, думая, что она умерла, приносят её в таинственную пещеру. Туда же приходят Коко и Бимбо, а также королева, превратившаяся в ведьму. Клоун с голосом Кэба Келлоуэя поет песню, а в пещере полно летающих скелетов и блуждающих привидений. Теперь только чудо сможет спасти Белоснежку и двух героев.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1308618","ru":"Те, кто творят чудеса","en":"Qui brille au combat","year":"2025","type":"Фильм","rating":7.0,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/kpUkx4nxuH9ssoTi4NLunlRcXgu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s2jfSL3O1tmDV4FiruB48LWr0ul.jpg","genres":["драма"],"overview":"13-летняя Бертиль страдает от редкого генетического заболевания — синдрома Фелана-МакДермида. Семья девочки живёт в тени её болезни в хрупком равновесии, где она центр вселенной. Родители Бертиль и её 17-летняя сестра Марион вынуждены подстраиваться под этот изматывающий ритм, где жизнь девочки может оборваться в любой момент. А тем временем юная Марион, приблизившись к порогу взрослой жизни, разрывается между безусловной любовью к сестре и потребностью в независимости. Сможет ли семья, обременённая непосильной ответственностью, справиться с этой непростой ситуацией?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1305653","ru":"Остров Дунцзи","en":"东极岛","year":"2025","type":"Фильм","rating":7.0,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/srqflGIWm1qRHsBQSjdIHWF4E4N.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eBPynEM4bzqUqRPezWLmnK8LBOi.jpg","genres":["драма","история","военный"],"overview":"1 октября 1942 года. Китайские рыбаки самоотверженно спасают британских военнопленных, выбравшихся из тонущего японского грузового лайнера Lisbon Maru.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1243006","ru":"Я — значит Ястреб","en":"H Is for Hawk","year":"2025","type":"Фильм","rating":7.0,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/5PF5KJdO6AJW5WzqoJoDK8qOhBh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2nMCDgLekQA2mumJLXJvGY4RUx0.jpg","genres":["драма"],"overview":"После внезапной смерти отца Хелен уходит от своей прежней академической и светской жизни и полностью отдаёт себя тренировке ястреба-тетеревятника Мейбл. Постепенно одиночество превращается в дружбу с Мейбл, которая позволяет женщине преодолеть горе и найти способ жить дальше.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1477914","ru":"Вечнозелёный","en":"Forevergreen","year":"2025","type":"Мультфильм","rating":7.0,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/SBy93aI7HlUv8R1ir0C7jVJW5a.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cAMtdKwUax2js8nkZtwWxIONLsr.jpg","genres":["мультфильм","семейный"],"overview":"Осиротевший медвежонок находит пристанище рядом с вечнозелёным деревом, но со-временем его отношение к мусору становится проблемой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"240442","ru":"Лиса-сваха: Меч и возлюбленная","en":"天地剑心","year":"2025","type":"Сериал","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/sSUsKG6hKCWadKSeT825ullCL60.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kSx7TUpI5uJUqgPMtu5R7Q3VZRe.jpg","genres":["драма"],"overview":"Ванцюань Фугуй, сын Ванцюаня Хунъе и Дунфан Хуайчжу (героев «Лисьи свахи: Чжу Е»), известен как самый сильный воин семьи Ванцюань. Мастерски владеющий воинским искусством, он стал «совершенным оружием войны» и более не имел свободы в жизни, поэтому был полон тоски по внешнему миру. Однажды он встречает Цинтун и с ее помощью обретает свободу, не зная, что она – вражеский шпион, подосланный в его дом, чтобы выведать информацию. На основе одноименной маньхуа То Сяосиня.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1446358","ru":"Жених и две невесты","en":"عريس وعروستين","year":"2025","type":"Фильм","rating":7.0,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/pofgUZkETInWRlyzFz82Kf6jOEZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vWMt9uu77fJP5PU6MfYXANSH4Cs.jpg","genres":["мелодрама","комедия"],"overview":"Адам комично лавирует между свадьбой с дочерью босса и внезапным возобновлением отношений с давней возлюбленной, что приводит к неожиданным открытиям о природе любви.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1171101","ru":"కుబేర","en":"కుబేర","year":"2025","type":"Фильм","rating":7.0,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/xjLC5DeA4FQTBv4xe8r3wYqh8lu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nbyTX77u3qELm9DYPgYfva7vAwj.jpg","genres":["криминал","триллер","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1213777","ru":"Стук сердца 2","en":"धड़क २","year":"2025","type":"Фильм","rating":7.0,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/yPcZel2pOb2CweJ4V70uqmMCrkQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t2lCQMpEIpXKRAFksNEQzAPIF4r.jpg","genres":["мелодрама","драма"],"overview":"Студент первого курса элитного колледжа, выбранный мишенью из-за своей касты, борется с жестокими хулиганами и смертельными угрозами, чтобы защитить своё достоинство и запретную любовь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1572017","ru":"Любовь и вино","en":"Love and Wine","year":"2025","type":"Фильм","rating":7.0,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/aRJrEffxIoplzUwzVsWvFDTQgvK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/teRLn0uy7Ttggbi7ll5kipPrynv.jpg","genres":["мелодрама","комедия"],"overview":"Наследник престижной винодельческой фермы, попадает в ловушку лжи, влюбившись в трудолюбивую студентку, и пытается убедить её, что он, как и она, родился в более скромной семье. Далее следует комический вихрь хаоса и душевных откровений.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1235880","ru":"挡马夺刀","en":"挡马夺刀","year":"2025","type":"Фильм","rating":7.0,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/9Z5v6cZKISLgAdvlwnL7v0DDWue.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8Xcm1TIyrGv5ebdK1K89YDisd6c.jpg","genres":["боевик","приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"661568","ru":"Мектуб, моя любовь: Песнь вторая","en":"Mektoub, My Love: Canto Due","year":"2025","type":"Фильм","rating":7.0,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/Ag0gzbjcdUu8t0eeFks2USP9a5V.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cNRYvkHKoRw8AuZxf7XecRfSuvM.jpg","genres":["мелодрама","драма","комедия"],"overview":"Амин возвращается в родной Сет, всё еще одержимый мечтой о большом кино. И, кажется, удача на его стороне: влиятельный голливудский продюсер готов запустить его проект. Условие лишь одно — главную роль должна сыграть жена продюсера, Джесс. Перед Амином открываются блестящие перспективы, но под палящим солнцем юга Франции всё идет не по сценарию. В дело вмешиваются случайные встречи и непредсказуемые чувства, ведь у капризной судьбы свои виды на этот фильм.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1280525","ru":"Школа магических зверей. Хранители чуда","en":"Die Schule der magischen Tiere 4","year":"2025","type":"Фильм","rating":7.0,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/2Pe4IsQV725dl5pj1j0VuixMROp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yFvkS9tjLfZ8cwY9GsbsDKNElpZ.jpg","genres":["семейный","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1211726","ru":"Красный шёлк","en":"Красный шёлк","year":"2025","type":"Фильм","rating":7.0,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/g45NVaq0o72UcKWzZxZ0EUnylH9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xxKihlvCkmG6j4v2a4gWGPBnzjr.jpg","genres":["боевик","приключения","детектив"],"overview":"1927 год. Транссибирский экспресс. Через всю Россию перевозят секретные документы, которые определят будущее СССР и Китая. Под видом обычных пассажиров скрываются иностранные разведчики и настоящие головорезы, готовые на всё ради документов. Молодому красноармейцу и бывшему царскому агенту приходится объединиться, чтобы раскрыть общего врага.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1566269","ru":"Гора Фрэгглов: первый снег","en":"The First Snow of Fraggle Rock","year":"2025","type":"Фильм","rating":7.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/zOUhbkzHDA02UEgOkJkZnuJaJKT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/h5hCdU9KvcCbBihSNfn3vtML7tV.jpg","genres":["семейный","комедия","музыка"],"overview":"Когда праздники полны неожиданных приключений и испытаний, Фрэгглы учатся ценить каждый день за то, что он уникальный и особенный, как снежинка.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"258962","ru":"Pubertat","en":"Pubertat","year":"2025","type":"Сериал","rating":7.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/3G1FWFOcFs9G7AwCTg9P3fFP0Gi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/h7XkMvq6w1Xo1iC7AunNPgX1rFN.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"304936","ru":"Terrazza Sentimento","en":"Terrazza Sentimento","year":"2025","type":"Сериал","rating":7.0,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/uxntXFQ6SqY4celQejnUC9y6TQ3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6BHxT63TTKmlG6rds4b844d1kVV.jpg","genres":["документальный","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_286388","ru":"Безэмоциональная Кашивада и эмоциональный Ота","en":"顔に出ない柏田さんと顔に出る太田君","year":"2025","type":"Аниме","rating":7.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/wNrET9PH06CQ4DW52KsqyrkyTgm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iPHdO30TG4XRourcAVwGXjbwi87.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"247207","ru":"Тсс, король спит","en":"嘘，国王在冬眠","year":"2025","type":"Сериал","rating":7.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/fcHgoay80TMredHk31FofnQ1fqK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iZLtHdy8supE79NsAXERN5Vju1K.jpg","genres":["драма"],"overview":"Художница манги Вэй Чжи (актриса Юй Шу Синь) потеряла авторские права из-за скандала. Чтобы все забыть она начинает кататься на лыжах. Вэй Чжи встречает тренера Шань Чуна (актер Линь И) на снежном курорте Бэйшань. Решительная практика катания на лыжах Вэй Чжи и ее связь с Шань Чуном приводят к взаимным чувствам. Шань Чун, вдохновленный Вэй Чжи, возвращается к тренировкам, стремясь вернуть свою любовь к сноуборду. По вэб-роману “Тсс, король впадает в спячку” автора Цин Мэй","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1414272","ru":"Belyas","en":"Belyas","year":"2025","type":"Фильм","rating":7.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/5oJ6eMfI7B73cWh0VXaa5MzhfBW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jbjolEshVFBZiOrCjSMi7EHiYz2.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302726","ru":"海市蜃楼","en":"海市蜃楼","year":"2025","type":"Сериал","rating":7.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/tE7rm2kTKy0QsdL2p6lzvsVMvGX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l0vi8Gc2vGQ5CiFULe0Mj6yhCE8.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1298547","ru":"Pay