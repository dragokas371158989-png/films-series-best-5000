","rating":6.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/1SAaWEJiRmGOzLtsnckb9WcQJNH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kocsFhAZnnpCLuiJ6fGbPVjB2Gx.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1018990","ru":"Continente","en":"Continente","year":"2024","type":"Фильм","rating":6.0,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/iZLWNFNtCsq6a2rA0uRb1XG03Ga.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n1xUohOqxYYWrweSJvD4rvWiw3n.jpg","genres":["ужасы","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"249891","ru":"Ночная жизнь!","en":"よあそびぐらしっ！","year":"2024","type":"Аниме","rating":6.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/wxvosl1gwbJ80uXChRojZs3RP6I.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iGNDdqA2XFieVUmWpbGL05nYNes.jpg","genres":["мультфильм","Аниме"],"overview":"Когда двум друзьям-барменам отказывают в кредите на открытие собственного ночного клуба, они пытаются найти другие способы достать деньги. После одной такой неудачной попытки местная мафия ставит им условие: вернуть кругленькую сумму к полудню следующего дня или они покойники. По стечению обстоятельств именно на этот вечер у одного из друзей назначено свидание. И это свидание с девушкой его мечты, которое он никак не может отменить. Теперь два друга должны придумать, как не оставить девушку без внимания, и остаться в живых к полудню следующего дня.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1275536","ru":"三叉戟","en":"三叉戟","year":"2024","type":"Фильм","rating":6.0,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/u4c1EUPk8EEX9mMG7hs7VzZ8EtF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cM8dGWhiiEz1w4wrTtZt9D0FZbo.jpg","genres":["криминал","триллер","боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1356045","ru":"Shadowland","en":"Shadowland","ye