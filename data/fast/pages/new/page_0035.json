":"https://image.tmdb.org/t/p/w342/8jjJckdxilbkIP2Lf4aK4ttORe6.jpg","backdrop":"","genres":["фэнтези","комедия","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1496532","ru":"Prank Night","en":"Prank Night","year":"2026","type":"Фильм","rating":8.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/jshVDBxDsyWGpwWqZUtct3Ba1E7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kr9JA7ZmHuAmE6vOBu7ERDaZWcC.jpg","genres":["триллер","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1541612","ru":"Perto do Sol é Mais Claro","en":"Perto do Sol é Mais Claro","year":"2026","type":"Фильм","rating":8.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rziHxZaSXC4cqQrTsVwL5w9OEAL.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_294280","ru":"Дочь владыки демонов слишком добрая!","en":"魔王の娘は優しすぎる!!","year":"2026","type":"Аниме","rating":8.4,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/8q3n6YZxFkzZ0vpTWsX6ZUsBGab.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7BDhqdsznowpcEDMQ334WAaCPcK.jpg","genres":["мультфильм","комедия","НФ и Фэнтези","Аниме"],"overview":"Несмотря на то, что Доу родилась демоном, её доброта не знает границ. Одним лишь своим присутствием она способна помирить ужасных демонов, укротить жестоких монстров, утешить людей-рабов и даже расположить к себе ангелов, заклятых врагов своего вида. Из-за этого её отец, Король демонов, был постоянно занят заботой о ней, и отказывался возглавлять рейды и военные походы. Видя беспомощность своего правителя, помощник короля Джахи решает провести с его дочкой целую серию испытаний, чтобы она заматерела, озлобилась и зачерствела — в общем, превратилась в достойного демона. Он ещё не подозревает, что все эти испытания лишь усилят доброту Доу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"285636","ru":"Time Flies","en":"El tiempo de las moscas","year":"2026","type":"Сериал","rating":8.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/9n2HM0guy6Wn95EshDj7Uw6XWd2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qUrVqmzdoRbFQpfbPnYXQQP2Zzl.jpg","genres":["драма","комедия","криминал"],"overview":"Выйдя из тюрьмы и оказавшись в безвыходном положении, две женщины открывают бизнес по дезинфекции помещений — до тех пор, пока сомнительный клиент не втягивает их обратно в жизнь, от которой они пытались сбежать.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"258063","ru":"ソウルメイト","en":"ソウルメイト","year":"2026","type":"Сериал","rating":8.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/8ppPFQJhrc6fD6s2roCL7PTRDzX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dW8Gpg3XhumcGUOGC2lVepM9rHy.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"321597","ru":"Carísima","en":"Carísima","year":"2026","type":"Сериал","rating":8.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/6e4ivA7v8vlzardz4IXPXzqxRrE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/70CPFXIDYgpj6Q5q4l7bVk0iUcU.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"297438","ru":"Сказание об Аканэ","en":"あかね噺","year":"2026","type":"Аниме","rating":8.4,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/4BI0Ji8N8VKgvG2phjceCddIfXu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6QwDoRZ7tiRXeMlsYtNto5sSMUg.jpg","genres":["мультфильм","драма","Аниме"],"overview":"Аракава Шинта мечтает лишь об одном — сдать экзамен на ранг синъюти и стать признанным мастером ракуго, традиционного японского искусства рассказа. Его главная фанатка — маленькая дочь Аканэ, которая даже пытается подражать отцу, наблюдая за ним из-за закрытой двери кабинета. Однако в день самого теста происходит необъяснимое: мастер Аракава Иссо выгоняет всех, включая Аракаву, безо всяких объяснений. Видя сокрушенного отца, в Аканэ разгорается настоящая злость. Отныне у неё лишь одна цель — ворваться в мир ракуго, отомстить за несправедливость и доказать всему миру, что её отец достоин звания синъюти!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"316470","ru":"Valentina Valiente","en":"Valentina Valiente","year":"2026","type":"Сериал","rating":8.4,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/acpPFrmD92AmJeaXQ8i6ZNLS3VZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/70lPP92EoiKa8CS4499Y1RZDiDw.jpg","genres":["Мыльная опера","драма","семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1645551","ru":"Tavaszi szél - az ébredés","en":"Tavaszi szél - az ébredés","year":"2026","type":"Фильм","rating":8.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/md6t7Hn2Nn5GreuhNKwkNVBnr39.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o7WlgJCVD1bUN2Ig4a8Y4hWZB1n.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1576369","ru":"ഭരതനാട്യം 2 മോഹിനിയാട്ടം","en":"ഭരതനാട്യം 2 മോഹിനിയാട്ടം","year":"2026","type":"Фильм","rating":8.4,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/lsg0IxNQCUxKqs63YjturEuY0qQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g7y8EDiXvlZYrIKDLlhtbcAPnxS.jpg","genres":["комедия","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}