mdb.org/t/p/w780/sOD3UBuOYPNh8keNJ4XvK6zHcIq.jpg","genres":["драма"],"overview":"Две женщины из разных социальных слоёв знакомятся в тюремной комнате для свиданий, когда они посещают своих мужей, отбывающих наказание. Альма, живущая в одиночестве в своём большом городском доме, и Мина, молодая мать из дальнего пригорода, неожиданно находят между собой много общего и завязывают дружбу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1314369","ru":"Разборки в Бангкоке","en":"Bangkok Dog","year":"2024","type":"Фильм","rating":5.9,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/9N0wRpjRsKZBZuBHaTPwIRyIvgQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dez48MfvRrMvTu5H47c5qaE0IPm.jpg","genres":["боевик","криминал","триллер"],"overview":"Агент Эндрю Кан отправляется в Таиланд с тайной миссией: он должен внедриться в преступную сеть торговцев людьми, которую возглавляет садист Доминик Месиас, и уничтожить её. Эндрю знает уличные законы, владеет боевыми искусствами и вскоре завоёвывает авторитет среди местных гангстеров. Но чем ближе он к раскрытию дела, тем больше он рискует.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1151560","ru":"വർഷങ്ങൾക്ക് ശേഷം","en":"വർഷങ്ങൾക്ക് ശേഷം","year":"2024","type":"Фильм","rating":5.9,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/7ME6H72R6c3fUJeKhD9InnTYDId.jpg","backdrop":"https://image.tmdb.org/t/p/w780/d2LcfSjPO0L8esuRXqhQU10JzpQ.jpg","genres":["драма","комедия","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1285660","ru":"Холоп. Великолепный век","en":"Şımarık","year":"2024","type":"Фильм","rating":5.9,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/99JkHMGszMBbNecENpajg05CFKS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/f0vnkxDdPoBiM66WJVrwBshTT3y.jpg","genres":["комедия","мелодрама","боевик"],"overview":"Мете — избалованный стамбульский мажор, жизнь которого состоит из бесконечных вечеринок, траты денег отца и абсолютно безответственного поведения. После очередной выходки терпение отца иссякает, и он обращается к психологу, практикующему шоковые методы воздействия на пациентов. Вместо русской деревни XIX века Мете попадет в османский XVI век и очнется конюхом в замке вельможи времен султана Сулеймана.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1043758","ru":"Семейный приговор","en":"The Problem with People","year":"2024","type":"Фильм","rating":5.9,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/A6wdGCdQ32bEhBprnwt9830WG7x.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wSuTMSFoy1hbOUszLrSWbvw9KS6.jpg","genres":["комедия"],"overview":"Уважая последнюю волю своего отца воссоединиться с американской стороной своей семьи, ирландец Киаран неожиданно звонит своему кузену Барри с предложением посетить Ирландию. Барри надоела нью-йоркская рутина, и он соглашается. Вскоре после теплого приема выясняется, что Барри унаследовал половину денег из завещания отца Киарана. Отношения братьев начинают стремительно ухудшаться.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1005860","ru":"Seeds","en":"Seeds","year":"2024","type":"Фильм","rating":5.9,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/A0oZJp3CCqKSeNLhkXEtHUqDJmx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g2Eb4cY8roTA6oAaVUti9Bph8IO.jpg","genres":["триллер","ужасы","детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"838206","ru":"드라이브","en":"드라이브","year":"2024","type":"Фильм","rating":5.9,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/1t1O0tXv0hECLdkCwT8EW1mAlkV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vVvX9JHYswQoGqwCMTyUNi2k9XH.jpg","genres":["боевик","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1406000","ru":"Небриллиантовая Рука","en":"Небриллиантовая Рука","year":"2024","type":"Фильм","rating":5.9,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/zBrv8dHCobnx8AeSBrGEdNGOHE1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wIS4UUPJuEwTKmEPeXbr32PAP4u.jpg","genres":["комедия","музыка","приключения"],"overview":"Семён Семёнович Горбунков едет в круиз и останавливается в старом Дубае. Контрабандисты накладывают ему гипс, но не с бриллиантами, а с новыми смартфонами, фенами Dyson и прочими товарами, ввозимыми в страну путём «параллельного импорта». По заданию Шефа контрабандисты пытаются снять гипс с Горбункова, а сам он из скромного экономиста превращается в настоящего спецагента под кодовым именем «007-ён Семёнович».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"901315","ru":"मिस्टर एंड मिसेज माही","en":"मिस्टर एंड मिसेज माही","year":"2024","type":"Фильм","rating":5.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/x1v8Qzvp46WEpxoBFlqaGfSsAxw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/efq4fpiyO31vGDHijeMNHGMkBYB.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1075365","ru":"Kiddo","en":"Kiddo","year":"2024","type":"Фильм","rating":5.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/zIA4dbWC0AaXJeK8MJnEuzaZ3Md.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wIF94ffZuo37DZfjkYHWK5J022n.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1322488","ru":"Cérémonie de clôture des Jeux Olympiques de Paris 2024","en":"Cérémonie de clôture des Jeux Olympiques de Paris 2024","year":"2024","type":"Фильм","rating":5.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/5Kb7DTk4cxo8rlr7bhcOPZFNzHW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4zeKxGtxRX2Sk1vEH8Sm67DXY4G.jpg","genres":["документальный","семейный","история"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_248086","ru":"Идолмастер: Блестящие цвета","en":"アイドルマスター シャイニーカラーズ","year":"2024","type":"Аниме","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/plv79G8KMsN4U8keajQKva3aSCy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mApkcnnacTfFHlmEc6nJspqiAB1.jpg","genres":["мультфильм","драма","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1359236","ru":"Украсьте залы на Черри Лейн","en":"Deck the Halls on Cherry Lane","year":"2024","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/hlhoZwNZgq9L1Jip9BVvLtGDbdw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eEyksp6kYgn7fW1emdhtiEKgOx3.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"В 1966 году Дэвид мечтал провести тихое и незаметное Рождество, но его планы летят к чертям, когда соседка Стефани внезапно объявляет, что выиграла конкурс и будет вести прямую трансляцию рождественского шоу Томми Сондерса… из его дома. В 1981 году на Черри Лейн разворачивается новая история: Джон и Лиззи готовятся к своему последнему Рождеству в этом уютном месте. В 2000 году на Черри Лейн Мэтт и Ребекка — лучшие друзья с детства — вдруг начинают видеть друг друга в новом свете. Три эпохи, три истории и одно волшебство Рождества на Черри Лейн, где каждый находит то, что по-настоящему ценно.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1241476","ru":"来福大酒店","en":"来福大酒店","year":"2024","type":"Фильм","rating":5.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/yywxMg2eP6S2YBMFct3Af8frVrO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ikQ1joxQcJXUQkgQESzcybW9dq.jpg","genres":["семейный","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1213906","ru":"द साबरमती रिपोर्ट","en":"द साबरमती रिपोर्ट","year":"2024","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/zd3CBwv04BRyH4WJuM5xFsZkgjX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s6WQSGAuZsYZ354VpA7HbQDmesA.jpg","genres":["драма","триллер","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1303517","ru":"Kahar: Kapla High Council","en":"Kahar: Kapla High Council","year":"2024","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/x4ucff9T7582SM9SAW5FpY9jemT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oAPqXRP3g66TcxBGCdM9rPhx8VU.jpg","genres":["боевик","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1119203","ru":"Глобальный катаклизм","en":"Jälkeemme vedenpaisumus","year":"2024","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/pyj3xkA8QX1W0RBT312Oy9yDieq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zeov6eQWlgCoTzX2WuP0PYMOEoV.jpg","genres":["фантастика","драма"],"overview":"В 2064 году мир буквально окажется на пороге полного разрушения после того, как климат достигнет своей предельной точки кипения. Еще в 2025 году люди возлагали большие надежды, когда была изобретена термоядерная реакция, которая сделает всю энергетику экологически чистой… пока он не был продан с огромной прибылью, и все это не оказалось одной большой аферой. Но Организация Объединенных Наций разработала своего рода устройство для путешествий во времени, чтобы исправить все недоразумения, предложив Хенрику, изобретателю знаменитого реактора, возможность вернуться в прошлое и уничтожить его собственное творение.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1292662","ru":"Slaughterhouse On The Hill","en":"Slaughterhouse On The Hill","year":"2024","type":"Фильм","rating":5.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/f6C2ckdAXELXbzyY8AoH4lj6udg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8UP9H8x6CsSzRZ96Ajy5rEUxkqg.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1184222","ru":"老枪","en":"老枪","year":"2024","type":"Фи