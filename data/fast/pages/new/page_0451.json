/p/w780/aBqSgZITTNtaPjRBBXAyl6zqhrl.jpg","genres":["драма","мелодрама","семейный","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1283793","ru":"雨の中の慾情","en":"雨の中の慾情","year":"2024","type":"Фильм","rating":5.9,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/9PjkZTu2xBBcSHgb1msIDSu7X4d.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2fL1kJynAY4iewAW4MsAom6XoVR.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1086726","ru":"एलएसडी 2: लव, सेक्स और धोखा 2","en":"एलएसडी 2: लव, सेक्स और धोखा 2","year":"2024","type":"Фильм","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ywUtbLJngSqykpxiIHIqJNA06EX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dmhNtB9HvZq4IPNuw7bRF2G4GX1.jpg","genres":["драма","комедия","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"680027","ru":"Изменённая реальность","en":"Altered Reality","year":"2024","type":"Фильм","rating":5.9,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/agvfvfoF96sEHHkfCXLLJ93ZZ4V.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kBHBPB6xs4PaXDvUE9XAo8rZmFV.jpg","genres":["триллер","фантастика"],"overview":"Жизнь Оливера Кука меняется, когда он встречает старого сторожа из своего прошлого Джека. Жизнь Оливера меняется благодаря чудодейственному лекарству, отмеченному инопланетными символами. Снадобье приносит ему богатство и исцеление, но обостряет семейные узы. Когда его дочь исчезает, богатство Оливера вовсе не утешает. Главный герой отправляется в путешествие, чтобы разгадать тайну исчезновения, сталкиваясь с моральными дилеммами и сверхъестественными силами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1239306","ru":"Mommy Meanest","en":"Mommy Meanest","year":"2024","type":"Фильм","rating":5.9,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/zEsMoyfx8LJLCniLpTm99tiKGUt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xQSjwKKkRv1Th113qCAJRTIf6Xy.jpg","genres":["драма","телевизионный фильм","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1229901","ru":"Plastic People","en":"Plastic People","year":"2024","type":"Фильм","rating":5.9,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/mqzSnCTd49TcG3nSYQIRStkFWqy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3gzvzg16vCcHwmBVWRKRWABViGb.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1329912","ru":"Игры кунг-фу","en":"Kung Fu Games","year":"2024","type":"Фильм","rating":5.8,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/sFYtWXR0wf67Fgg6jHH2Drr3c2j.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wYMQAzkG8HVSDwJLMQcnCV4g5DV.jpg","genres":["боевик"],"overview":"Знаменитые бойцы попадают в смертельную ловушку, устроенную магнатом-садистом. Вооруженные только своими боевыми навыками, они вступают в жестокую борьбу за выживание в смертельном противостоянии «убей или будь убит».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"961082","ru":"Чужие секреты","en":"Les Gens d'à côté","year":"2024","type":"Фильм","rating":5.8,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/hUvkrlzCUCOCCogbFLkNlrHFQFF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lHxitIJyXobdpJRTSrv9PwvrvXW.jpg","genres":["драма"],"overview":"Отстранённая от службы полицейская Люси находит утешение в общении с новыми соседями — молодой парой и их ребёнком. Но её едва обретённый жизненный баланс рушится, когда она узнаёт, что глава семьи Ян — бывший преступник с опасным прошлым. Теперь Люси предстоит мучительный выбор между профессиональным долгом и привязанностью к тем, кто стал её единственной семьёй.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"988512","ru":"Running on Empty","en":"Running on Empty","year":"2024","type":"Фильм","rating":5.8,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/fEbJku8PDizV2P5IQmHA0dcyf50.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gkxsg3RjopFzr1Stvoht2cRVl0Y.jpg","genres":["мелодрама","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1062276","ru":"Dark Match","en":"Dark Match","year":"2024","type":"Фильм","rating":5.8,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/6E6fBED3ix7FmrWUWZdeYG4vqK8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7q5RVohE85yuQ9uZWXEXlHmfUOE.jpg","genres":["боевик","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1321952","ru":"Заклятие. Новое поколение","en":"Tu Sangre","year":"2024","type":"Фильм","rating":5.8,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/zavwSwdJ1tOaL57wlWmuFu3uLqT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/QNo0appKGKLAsBXVkU64fXwOtj.jpg","genres":["ужасы"],"overview":"В надежде понять, что случилось с ее пропавшей матерью, Софи решается провести спиритический сеанс. Явившийся ей призрак матери подсказывает, что разгадку ее трагической смерти надо искать в закрытой школе для девочек, где она работала. Девушка отправляется в интернат и обнаруживает, что в этом заклятом месте не только пропадают люди, но и обитают призраки. Софи понимает, что поступление сюда было роковой ошибкой, но желание найти ответы оказывается сильнее страха за свою жизнь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1068518","ru":"Что скрывает любовь","en":"Haunted Heart","year":"2024","type":"Фильм","rating":5.8,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/qfGdLc319g3AxssvtKA5OMzvCmA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j9klQLnHuhZbxlTJeqUp4Le7PDF.jpg","genres":["мелодрама","триллер"],"overview":"Привлекательная девушка приезжает работать хостес в небольшой ресторан на живописный остров средиземноморья. Влюбившись в загадочного хозяина заведения, она теряет голову и не замечает исходящей от него опасности.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1146246","ru":"The Deep Web: Murdershow","en":"The Deep Web: Murdershow","year":"2024","type":"Фильм","rating":5.8,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/3TZsNLYUi2qGVS9NNy5XBUm6VON.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t86SkVd35W9COtCGtbxxb3UoQpW.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1309770","ru":"Чёткий разрез","en":"Clear Cut","year":"2024","type":"Фильм","rating":5.8,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/xQE8Hz8OraOg1r5d0fibIjVpQPF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4IRzdPLmYsSs9fvjWNxJ5nPaEBm.jpg","genres":["триллер","боевик"],"overview":"Команда лесорубов обнаруживает посреди леса место приготовления метамфетамина и вынуждена бороться за свою жизнь, пока на них охотится наркокартель.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1024592","ru":"God's Not Dead: In God We Trust","en":"God's Not Dead: In God We Trust","year":"2024","type":"Фильм","rating":5.8,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/hMLnHK0DuMciSHWkXQz6V4xg9Of.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7RY5uiuM97FqS5qvPHG2XW2ZruY.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1252896","ru":"Леди-скорпионы","en":"Lady Scorpions","year":"2024","type":"Фильм","rating":5.8,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/tf7dAQJ6188hnf9TtAipnsDOQj0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jxpKLdNZjUWS53uWBqd6DOmAJ56.jpg","genres":["боевик","криминал"],"overview":"Агент по борьбе с наркотиками объединяется со своей дочерью, чтобы спасти похищенную внучку от могущественного главы преступного синдиката.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1148486","ru":"Веда","en":"वेदा: संविधान के रक्षक","year":"2024","type":"Фильм","rating":5.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/lOqxIxX6tSjEB7J5mqktFxPhUZy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qMneo4vk6e42lS8UqYIfG9xf7ol.jpg","genres":["боевик","драма","триллер"],"overview":"История молодой женщины, которая борется за свои права и свободу против всей системы. Она находит неожиданного союзника в лице мужчины, который ее спас. Вдвоем они пытаются сражаются за справедливость против всего мира.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1109946","ru":"Я буду рядом","en":"I'll Be Right There","year":"2024","type":"Фильм","rating":5.8,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/jHbn6gQqEGFZXExp7oxuA84JsRe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4isT4XhFePeyeevlfLiYfQKZffw.jpg","genres":["комедия","драма"],"overview":"Ванда хочет заботиться обо всех в своей жизни. У нее едва хватает времени на себя, но она все равно не знает, что с ним делать.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1136721","ru":"Записи из Гленорма","en":"The Glenarma Tapes","year":"2024","type":"Фильм","rating":5.8,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/pyKjQ1NUMguwvagJipaqcWIOmmN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nyZjhvcmeXcr8H2Xx6JzKEAxPph.jpg","genres":["ужасы"],"overview":"Весной 2020 года пять студентов и два преподавателя Колледжа искусств Среднего Ольстера, таинственным образом пропадают в лесу на северной части побережье Ирландии. Что же произошло в день их исчезновения, до сих пор остается неразгаданной загадкой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1139467","ru":"Близко к тебе","en":"Close to You","year":"2024","type":"Фильм","rating":5.8,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/jdpTB1s5xeDpklb6JdOBpk2peMf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1NRdvblC1cGu9gkd4R0almqZ1F.jpg","genres":["драма","мелодрама"],"o