91","ru":"怎敌她动人","en":"怎敌她动人","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/f4Z1HO838u4lDq1hiKULrSIYMrO.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"301552","ru":"O home perfecto","en":"O home perfecto","year":"2025","type":"Сериал","rating":8.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/8zb6nOBJzqEbEvpXrqkLnpjxYG9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fgwhkfxbq6KCgFPrQon974v9onx.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_280100","ru":"垂涎","en":"垂涎","year":"2025","type":"Сериал","rating":8.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/kd1GNYlujxKwUrtQWx2ECEosYeW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s2GQUEJApbOVZL3vASbm5FWGdYN.jpg","genres":["драма","НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"281671","ru":"WWE Superstar Profiles","en":"WWE Superstar Profiles","year":"2025","type":"Сериал","rating":8.4,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/wTOC5twk3sWIX2JEM99aeJHBuaK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uR75laUljquG2D9bKjEawvZoY0L.jpg","genres":["Боевик и Приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"262929","ru":"Апокалипсис: Отель","en":"アポカリプスホテル","year":"2025","type":"Аниме","rating":8.4,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/ipJV6gE0yjef7cbN1JNRXS653z0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cSTqAOPhuApXcAzn2SoBo2Ffral.jpg","genres":["мультфильм","комедия","драма","НФ и Фэнтези","Аниме"],"overview":"После краха цивилизации среди руин Гиндзы, района Токио, стоит грандиозный отель. Природа постепенно захватывает город, и лишь этот одинокий отель продолжает отрицать исчезновение человечества. Текущее число гостей: ноль. Запланировано прибытий на сегодня: ноль. Число посещений сайта за вчера: ноль. Погрузитесь в загадочную историю жизни в мире, где от людей осталось лишь угасающее воспоминание…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"217810","ru":"ข้ามฟ้าเคียงเธอ","en":"ข้ามฟ้าเคียงเธอ","year":"2025","type":"Сериал","rating":8.4,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/iW3MypZDwti1Kp84sqcHod9xT0Z.jpg","backdrop":"https://image.tmdb.org/t/p/w780/r1uscUpxBMMTzDwzVlbjoRBSNeE.jpg","genres":["драма","Боевик и Приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"271889","ru":"백번의 추억","en":"백번의 추억","year":"2025","type":"Сериал","rating":8.4,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/os7TvyWMSdlNQ2ItGY3YrtZkNCS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k46AmUVAj6BCIBu074uLuvi1w70.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}