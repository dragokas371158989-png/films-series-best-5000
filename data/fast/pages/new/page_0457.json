tdi3Dfz1DRjJ477VDyiKmrd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8vNrR5BmTOm0B6HgoraQCY2zP2F.jpg","genres":["драма","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1077263","ru":"നടന്ന സംഭവം","en":"നടന്ന സംഭവം","year":"2024","type":"Фильм","rating":4.8,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/qbL2hGERpXe5Tm84z66RPIzTNA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AVH6dYTp9wAD0KKC4uGgaGfNdo.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1324495","ru":"Bad Fish","en":"Bad Fish","year":"2024","type":"Фильм","rating":4.8,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/t50tvosFJKPM6UCAaH6Q0hORXcJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jghhG5l8kDuVZahG02ogPZc9Gs8.jpg","genres":["триллер","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1273470","ru":"Безумный криминал","en":"窗前明月，咣！","year":"2024","type":"Фильм","rating":4.8,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/2hPFJFirwvSuXJadT6li8LdF9Bz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rp9MmFVHfe8C4XKQEeQ69qLQSeq.jpg","genres":["комедия"],"overview":"Ху Гун Пин - блестящий адвокат, не проигравший ни одного дела. Во время перерыва в судебном заседании он тайно встречается в отеле со своей любовницей, и в самый разгар их свидания из окна падает оконная рама, под которой оказывается тело неизвестного мужчины. Любой звонок в полицию может разрушить адвокату карьеру и семью, поэтому он решает замести следы любой ценой. Но одна ложь провоцирует другую, и ситуация выходит из-под контроля.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1246037","ru":"She's Obsessed With My Husband","en":"She's Obsessed With My Husband","year":"2024","type":"Фильм","rating":4.8,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/dH6566vTum7Ia1BIX6wJ9T5F4JL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wwao7yKtnyEAlOhkX2GuxulPH66.jpg","genres":["триллер","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1370711","ru":"Kabitan","en":"Kabitan","year":"2024","type":"Фильм","rating":4.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/bw4cJcLpNStJ9UFCfkRtf3YmtgV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/obbAJj7srMmk6aQiqhZwX2nf3wi.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1274880","ru":"Linya","en":"Linya","year":"2024","type":"Фильм","rating":4.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2d8qvm4SCIZRzNiNqiPYm2gSkbw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uLitHKUHKpY54sh9WmpIJ3Ci479.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1005026","ru":"어게인 1997","en":"어게인 1997","year":"2024","type":"Фильм","rating":4.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/iu3G5wHqZvozoOLAxZdEqXLt6Ft.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sxy0jfoJNeEo8R8QnEpRXL0eL1o.jpg","genres":["фэнтези","драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1248698","ru":"Украденная личность: Последняя игра","en":"スマホを落としただけなのに ～最終章～ ファイナル ハッキング ゲーム","year":"2024","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bPUqhG4OXosNKMg5siqaSEGDXQE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e0i2MYsDVX55NYRb3c4gEHB7HqI.jpg","genres":["детектив","триллер","криминал"],"overview":"Гениальный хакер и серийный убийца сбегает в Южную Корею и присоединяется к радикалам, планирующим сорвать корейско-японский саммит. Сумин, которой поручено следить за ним, сталкивается с его непредсказуемым поведением, но со временем их отношения меняются.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1228545","ru":"Крипто шторм","en":"反貪風暴之加密危機","year":"2024","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/7b7LRWmf6G6Tb8a9sj3WVmNCfsO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cUrVoWzVAnoxQxNwSxFoTEO7ESn.jpg","genres":["боевик","криминал","триллер"],"overview":"Начальник отдела по борьбе с коррупцией Лок создаёт специальную группу для расследования дела об аферах на рынке криптовалют и в банковской сфере. Он обращается за помощью к разработчику программного обеспечения крупнейшей торговой платформы, надеясь использовать высокие технологии для поиска улик. В ходе расследования Лок вскрывает масштабные махинации в одном из крупных банков и ввязывается в рискованную игру, поставив на карту свою жизнь.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1312867","ru":"Backrider","en":"Backrider","year":"2024","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/cHKcJvYF99YQPCHAJ0RLuX5E1HW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sZgDOCBQk54ZW0y81TZM9QX9XYj.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1388877","ru":"Silip","en":"Silip","year":"2024","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bvvJBhSKA8znIMGf8gdFKxBZbU0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uEXYMXjSdzQn27t5qyNNERYUGck.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1274748","ru":"Serbidoras","en":"Serbidoras","year":"2024","type":"Фильм","rating":4.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/awBtioxEtzkcNFanet3QKceAJj1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eiFNBPy4LMb6se4Z0CkgsaXSz3D.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1244570","ru":"Midnight Mission","en":"Midnight Mission","year":"2024","type":"Мультфильм","rating":4.8,"votes":4,"poster":"https