XbAQNv4NVvYTGs.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"953713","ru":"Парашют","en":"Parachute","year":"2024","type":"Фильм","rating":6.6,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/aGwFRwsqkCX1eMsMZCD0tgGA8Fr.jpg","genres":["драма","мелодрама"],"overview":"Райли недавно завершила программу в реабилитационном центре, где работала над своими проблемами в отношении еды и принятия себя. После этого она встречает Итана. Вопрос стоит: станут ли эти отношения источником любви для Райли или же она окажется вновь в плену своей зависимости?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"948184","ru":"默視錄","en":"默視錄","year":"2024","type":"Фильм","rating":6.6,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/6ohJCscMK2GWyR03eg1pccqrxBp.jpg","genres":["криминал","детектив","триллер","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"tv_222784","ru":"Выходной злодея","en":"休日のわるものさん","year":"2024","type":"Аниме","rating":6.6,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/thKhPuHjsd6DEC4eiDnlIU0Tt22.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Знакомьтесь, полководец Армии зла, цель которого — поработить Землю. Все будни он самоотверженно сражается с защитниками справедливости, могучими рейнджерами. Но сегодня у него выходной, который он твёрдо намерен провести за любованием пандами, поеданием вкусного мороженого и ничегонеделанием.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"244978","ru":"Возвращение в рай","en":"Return to Paradise","year":"2024","type":"Сериал","rating":6.6,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/7Hx7H3MndGK4c4joXKeEW9GIeqs.jpg","genres":["криминал","детектив","драма"],"overview":"Детектив-инспектор Маккензи Кларк, оказавшись под обвинением в подделке доказательств в Лондоне и разорвав помолвку, вынужденно возвращается в родной австралийский город Дельфин-Коув. Однако отдыхать там ей не приходится. Кларк сталкивается с расследованием убийства, которое становится для неё настоящим испытанием. Но на этом трудности не заканчиваются — прошлое вновь даёт о себе знать, и Маккензи предстоит исправить старые ошибки, которые она совершила много лет назад.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1170000","ru":"Маленькое крылышко","en":"Little Wing","year":"2024","type":"Фильм","rating":6.6,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/s6Nf6jccJhd1rJ3D8QXGcEuuMKK.jpg","genres":["драма"],"overview":"История рассказывает о 13-летней девочке, которая втягивается в мир голубиных гонок, переживая развод родителей и надвигающуюся потерю дома.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1361240","ru":"Причина Рождества","en":"A Reason for the Season","year":"2024","type":"Фильм","rating":6.6,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/9HFQsvBPCra3P8vIzBB5I0Vuce8.jpg","genres":["мелодрама","телевизионный фильм"],"overview":"Иви возвращается в городок, где когда-то родилась, чтобы отблагодарить людей, которые однажды спасли ей жизнь.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1189518","ru":"വാഴ","en":"വാഴ","year":"2024","type":"Фильм","rating":6.6,"votes":25,"poster":"https://image.tmdb.org/t/p/w342/6SFL0Z5x4FQTNYoDCp6SbbyydQm.jpg","genres":["комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1243650","ru":"Caída libre","en":"Caída libre","year":"2024","type":"Фильм","rating":6.6,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/9EdGBz7SWudhGMlvucVebiczLrq.jpg","genres":["триллер","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1002398","ru":"Donselya","en":"Donselya","year":"2024","type":"Фильм","rating":6.6,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/iVS3ZiPsKy8Hhc5Dipqgrjmoj2b.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1180390","ru":"Бетти не везёт в любви","en":"Betty's Bad Luck In Love","year":"2024","type":"Фильм","rating":6.6,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/inAybmYPu9WJwjSTgNWmqr3qzqB.jpg","genres":["телевизионный фильм","комедия","мелодрама"],"overview":"Ещё в школе одноклассница прокляла Бетти на неудачи в любви, и с тех пор девушке катастрофически не везёт в личной жизни. Но встретив Алекса, Бетти решает рискнуть. Сможет ли истинная любовь снять страшное проклятие?","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1190836","ru":"Ба","en":"The G","year":"2024","type":"Фильм","rating":6.6,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/5gh0WZN4D4p8bnkcdClNftlMj52.jpg","genres":["триллер","криминал"],"overview":"Таинственная пожилая женщина жаждет отомстить коррумпированному опекуну, разрушившему её жизнь.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1266909","ru":"Romance on the Ranch","en":"Romance on the Ranch","year":"2024","type":"Фильм","rating":6.6,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/tCuWdSSwth4m0RIdin9z4Nz8Il9.jpg","genres":["телевизионный фильм","комедия","мелодрама","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1298727","ru":"志愿军：存亡之战","en":"志愿军：存亡之战","year":"2024","type":"Фильм","rating":6.6,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/s6iSPGkpEHwcztNmNIMr21M6inK.jpg","genres":["драма","военный","история"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1223799","ru":"Астрал. Проклятие мёртвых","en":"Pemandi Jenazah","year":"2024","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/hBYZRtOA8pR0w0qpgGZ3XHrzvk.jpg","genres":["ужасы","драма","триллер"],"overview":"В городе происходит череда загадочных смертей: на телах жертв остаются странные следы. Во время древнего обряда омовения девушка начинает подозревать, что убийца совершает загадочный ритуал, не дающий душам погибших обрести вечный покой и призывающий могущественную потустороннюю силу.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1363916","ru":"Тайны Авроры Тигарден: Урок убийства","en":"Aurora Teagarden Mysteries: A Lesson in Murder","year":"2024","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/m5w7oPvKxtCFDHqmkEZ1kq8impf.jpg","genres":["детектив","телевизионный фильм"],"overview":"Когда одного из учеников курса Авроры по криминальной литературе находят убитым возле закусочной, где она подрабатывает, Аврора решает самостоятельно заняться расследованием. Не доверяя официальной версии событий, она берёт на себя задачу найти настоящего преступника, используя свои знания о криминалистике и детективной литературе.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1255130","ru":"Смерть в отпуске","en":"Moartea în vacanță","year":"2024","type":"Фильм","rating":6.6,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/ja9aqdAajtDbUfsXsmik1viruyA.jpg","genres":["комедия","боевик"],"overview":"Фильм повествует о трёх авантюристах, которые внезапно становятся товарищами по несчастью. Каждый из них отчаянно пытается завоевать доверие одинокой и состоятельной старушки Родики, надеясь получить в наследство её внушительное состояние.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":"