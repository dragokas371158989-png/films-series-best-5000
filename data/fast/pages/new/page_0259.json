суговой деятельности Нели и ее напарника Гены. Вместе они пытаются привести библиотеку в божеский вид, привлечь читателей и заставить работать тех, кто привык бездельничать.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"292009","ru":"Far lever stadig","en":"Far lever stadig","year":"2025","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/tA2bw5XVgwQ9urcUtvSJIO4jlS1.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1704218","ru":"La terrorífica posesión maliciosa de un fantasma con el pelo guarro que persigue a la rubia de siempre en el templo Ketemato. The final last dance of the world","en":"La terrorífica posesión maliciosa de un fantasma con el pelo guarro que persigue a la rubia de siempre en el templo Ketemato. The final last dance of the world","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/bxpIFMh9DGALbqNwMa9Eu71pGAg.jpg","genres":["комедия","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1703110","ru":"'Reverse' – Ferox Hall Taskmaster 2025","en":"'Reverse' – Ferox Hall Taskmaster 2025","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/oOPTNcVplmLAn1vjkXQhvsTV5xU.jpg","genres":["ужасы","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1693715","ru":"Greyford","en":"Greyford","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/jaQttN6klwOUiZ46BhnLICaryij.jpg","genres":["боевик","криминал","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1692285","ru":"Bem Que Me Avisaram","en":"Bem Que Me Avisaram","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/a3oXDtFvsaAnlXeYDMDLcMyOyaq.jpg","genres":