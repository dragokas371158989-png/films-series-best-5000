увство. Вместе Ивану и Вике удается восстановить справедливость и вернуть девушке ее законное имущество, а Ивану – его настоящее прошлое. И, наконец, эти двое могут себе позволить признаться друг другу в любви.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315654","ru":"Congresso Bitcoin","en":"Congresso Bitcoin","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/vMqQX10ZjwGTKF2sb3ncwOBQfe4.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"322931","ru":"聲的築城者","en":"聲的築城者","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/v7iZogmXWMCDSiW4ycGnyHUn7O5.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"321008","ru":"Step-Friend","en":"Step-Friend","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/rAzOmAl4AA6CJpkPiCDzLsJcvnS.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315469","ru":"Todd Sampson's Why?","en":"Todd Sampson's Why?","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/4f2WnBkngvfhCN87DTge7AFruBd.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"314101","ru":"الحصة الأخيرة","en":"الحصة الأخيرة","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/wvZCRrh5WVKT734ZcbSWpsupszX.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"319153","ru":"설특집 설빔 Soul Beam","en":"설특집 설빔 Soul Beam","year":"2026","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/x5NZnbjSktNoySCQ2wUtEcSTFnC.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studi