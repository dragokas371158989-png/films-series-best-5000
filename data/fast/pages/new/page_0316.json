780/3x5FyDjNb61cZMET8pqhoKygHau.jpg","genres":["драма","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1401502","ru":"无名之辈：否极泰来","en":"无名之辈：否极泰来","year":"2025","type":"Фильм","rating":6.2,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/iNOkivce2JAlyK2rOdQlHe0xkDc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/diRS2bfX9KZG4ijX50G4FTNeQy9.jpg","genres":["комедия","криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1101284","ru":"The Wrecker","en":"The Wrecker","year":"2025","type":"Фильм","rating":6.2,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/5JHPHQxcE1b0W2Spbncq5uJKW7i.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8XhHjzvfkwVvUL5QpDqzlkvuk9M.jpg","genres":["боевик","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"258000","ru":"Плохая девочка","en":"ばっどがーる","year":"2025","type":"Аниме","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ovE3txsuLdvpIPWpG4WodlkWXGi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ohMsI1lElhVEWL481s8QMggc6ON.jpg","genres":["мультфильм","комедия","Аниме"],"overview":"Глава крупной компании, привыкшая управлять людьми, становится игрушкой молодого интерна. Правила просты. Она подчиняется всем его приказам, а он хранит ее тайну. Но вырвавшаяся за пределы офиса страсть грозит уничтожить их обоих.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1273698","ru":"Первый на Олимпе","en":"Первый на Олимпе","year":"2025","type":"Фильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/xy4RfTcjf5yLXIdtac7a25Nubri.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rL11o4OcstQVcg0QJtNbzIpFTYk.jpg","genres":["драма"],"overview":"Юный блокадник Юра Тюкалов пришел в спорт после войны, когда у него, казалось, не было сил жить, не то что вести изнурительные тренировки по академической гребле. Но после встречи с тренерами Михаилом и Верой Савримович у Юры открывается второе дыхание, и он начинает жизнь заново. Судьбы, обожженные войной, соединились в команде, где все поддерживают и вдохновляют друг друга. Победы даются нелегко, но у Юры есть любовь, талант и родная команда, которую не остановить: их цель — Олимпиада в Хельсинки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1499744","ru":"A Chuck E. Cheese Christmas","en":"A Chuck E. Cheese Christmas","year":"2025","type":"Мультфильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/osuxNst45U4d7CT02uYHBI1B9nK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/h0bffxi9OL8XN7CEdCZW1pV5OzA.jpg","genres":["мультфильм","семейный","комедия","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1416501","ru":"டி என் ஏ","en":"டி என் ஏ","year":"2025","type":"Фильм","rating":6.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/82eWyEvVP01sV5DvBer9QyNgCh2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mDynWzuxyljITFYq4r3IsT9K2JZ.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"292554","ru":"Брак до беременности","en":"デキちゃうまで婚","year":"2025","type":"Аниме","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/4KouLBIT2W1aacqMx9sxuHCwYEY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nwzPP53GpK3ZvKh191GJyLXbLvA.jpg","genres":["мультфильм","Аниме"],"overview":"Опытный врач Аяно может унаследовать больницу, принадлежащую родителям. Но есть обязательное условие — родить внуков. С этой целью она приходит на вечер знакомств, но потенциальный кавалер почему-то сбегает. На следующий день в одном из пациентов девушка узнаёт сбежавшего парня. Его зовут Тайка Инаба. А сбежал он потому, что переживает по поводу эректильной дисфункции. Сможет ли сексуальная докторша помочь страдальцу?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1309129","ru":"Дьявольщина","en":"Diabolisch","year":"2025","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/gm0e0W7QRTpima3aIGz2ZLU9pgm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dbUUasPx24MR0JHWbREwKy0CgvU.jpg","genres":["ужасы","детектив"],"overview":"Джессика выросла с матерью, которую мучили странные психологические проблемы. Спустя годы Джессика сама начинает сталкиваться с такими же пугающими симптомами и подозревает, что причина - вовсе не психика, а нечто по-настоящему злое.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"303173","ru":"Морские пехотинцы","en":"MARINES","year":"2025","type":"Сериал","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/JLaOhI1bYUjYSxB0E1JeBaNzeB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kCf0Ydkeue3vnRljYxMRhigU2nx.jpg","genres":["документальный"],"overview":"Увлекательный военный документальный сериал о 31-м экспедиционном отряде морской пехоты, который принимает участие в напряжённых боевых учениях в Тихоокеанском регионе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"276548","ru":"仁心俱乐部","en":"仁心俱乐部","year":"2025","type":"Сериал","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/7gUlJJUcVBsZZtqeGHfQF4SA3jC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9SxPnCtZaWR81n4m0hA5VlEFlQq.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"281548","ru":"金昭玉醉","en":"金昭玉醉","year":"2025","type":"Сериал","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/8CdV6EQST79aYlRKUg58hQCMBR9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fQ7grsqh1BE2oGk3JoWpj5o8WpS.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1537715","ru":"Banduan","en":"Banduan","year":"2025","type":"Фильм","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/5P8mDRh7IV4b10QBa1jasg3g3FA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zVErlNqgiAaegmD1m4D3g9qzDr2.jpg","genres":["боевик","криминал","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"114826","ru":"Romi","en":"Romi","year":"2025","type":"Сериал","rating":6.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/3EjcmpGFVJ9tAIVEM0mqVGTLdEH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e1XOv2zMB4RbXgrZ8u2dGsRdqL0.jpg","genres":["Боевик и Приключения","детектив","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"244812","ru":"Любовь и Гордость","en":"Aşk ve Gurur","year":"2025","type":"Сериал","rating":6.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/gBDmgxljJGE7t1tzXdAxZaXSdVM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5Rcg6I6z64HMddM7PAS3EhpqM8K.jpg","genres":["драма"],"overview":"Драматичный сериал о чувствах, выборе и тайнах, скрытых за выгодным браком. В старинном особняке, передающемся из поколения в поколение, живёт семья Кексой — когда-то влиятельная и обеспеченная, а теперь оказавшаяся на грани банкротства. Кредиторы поджимают, счета пустеют, и близится момент, когда придётся расстаться с фамильным домом — символом чести и прошлого величия рода. На помощь неожиданно приходит Толгу — наследник богатой семьи. Он предлагает сделку: если одна из дочерей Кексой станет его женой, он покроет долги и вернёт семье прежний статус. По традиции, выбор падает на старшую — гордую и независимую Меркан. Их первая встреча искрит эмоциями: между ними вспыхивает притяжение, но столкновение характеров грозит разрушить хрупкую надежду на спасение.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1369010","ru":"Чёрный шоумен","en":"ブラック・ショーマン","year":"2025","type":"Фильм","rating":6.2,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/bE0oMAmJg1YUZWQVSn2nRKavMcv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/A7XyTpUdzj5A3WGBLNyc1TJQPSS.jpg","genres":["детектив"],"overview":"После убийства бывшего школьного учителя Эйити Камио его дочь Майо, готовящаяся к свадьбе, возвращается в родной город, переживающий упадок после пандемии. Пытаясь понять, кто и зачем лишил жизни человека, которого уважали все вокруг, она погружается в цепочку тайн, скрытых за внешне спокойной жизнью провинциального городка.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}