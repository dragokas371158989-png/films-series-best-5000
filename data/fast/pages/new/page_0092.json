ильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/9yYzeBFtoya9Jhz9SJiNwmImG7c.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1raRsCPsyezbDdKSnWlMiU0JHpV.jpg","genres":["драма","комедия","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1567787","ru":"しびれ","en":"しびれ","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/ae0hP0xSEhPM6eVpAtCfjhWPKVu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dgj1drC2yeBa8If4CrBEfpgVPpL.jpg","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1652306","ru":"Капитан Невельской и земли Чёрного дракона","en":"Капитан Невельской и земли Чёрного дракона","year":"2026","type":"Мультфильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/rNufjR9rmql0PFRAjtZTQhW1krG.jpg","backdrop":"","genres":["мультфильм","приключения","фэнтези"],"overview":"Капитан Геннадий Невельской, отличник Военно-морской академии, из-за своего таланта вместо покорения дальних морей вынужден преподавать морскую науку Цесаревичу, наблюдая, как чужие мечты подменяют его собственные. 14-летней Надежде, юной воспитаннице института благородных девиц, так и не удалось найти своё место в столице. В душе она знает, что её настоящий дом затерян где-то в землях Дальнего Востока, и ей нужно вернуться туда. Встретив друг друга, Геннадий и Надежда отправляются в великое и опасное приключение — на поиски себя и своего места в мире.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1444084","ru":"Herança de Narcisa","en":"Herança de Narcisa","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/kmeGpWrYy679EzRJvu04Sn91j6w.jpg","backdrop":"https://image.tmdb.org/t/p/w780/u4u57qkAW1yKWJsA3YIW8UYoXif.jpg","genres":["ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1418582","