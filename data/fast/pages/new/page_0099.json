ание. Постепенно все начинают терять контроль над собой. Это происшествие раскрывает секреты, ранее неизвестные Хулии, и самые жуткие стороны её личности.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1632198","ru":"Voodoo Party","en":"Voodoo Party","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/wIdE0OZ3YaSvTq8RcU9PnMXQrnx.jpg","genres":["ужасы","детектив"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1590933","ru":"汝、星のごとく","en":"汝、星のごとく","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/Ar5PyREFNhsius7ndEAnUxtHRvM.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1453479","ru":"Blood Lines","en":"Blood Lines","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/pvbjC0cVMybV5RusvXVQprcp77k.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1393929","ru":"Hallowarrior","en":"Hallowarrior","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/eaVuQsTofgodi76nXkYoWtN9afH.jpg","genres":["ужасы","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1476532","ru":"The End of It","en":"The End of It","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/4bqOzG5whbPO2ekS2DwPIEr2a87.jpg","genres":["фантастика"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1694254","ru":"Caravelle 114","en":"Caravelle 114","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/tAM5D7TENYeZf2