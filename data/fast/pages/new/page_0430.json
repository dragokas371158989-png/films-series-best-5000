.tmdb.org/t/p/w342/9TUxGkRhcr4uVBDTPwd3S2wlW3G.jpg","genres":["документальный"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1226743","ru":"Ненормальный","en":"Ненормальный","year":"2024","type":"Фильм","rating":9.2,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/sCgjy9WlV9i33HtGH2gVloQl7Vz.jpg","genres":["драма","комедия"],"overview":"8-летний Коля не такой, как все. Мама мальчика Татьяна вслед за врачами уже не верит, что врожденная болезнь отступит, и ребенок когда-нибудь станет «нормальным». Но ее новый знакомый Юрий твердо намерен поставить Колю на ноги с помощью своей уникальной системы гимнастики. А когда во время занятий случайно выясняется, что у мальчика талант к музыке, обучение игре на фортепиано становится еще одним этапом на пути к выздоровлению. Впереди у Коли — престижный конкурс пианистов в Китае и масса препятствий, преодолеть которые ему помогут целительная сила музыки и отцовской любви.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"237338","ru":"Заклятые друзья старшей школы","en":"มิตรภาพคราบศัตรู","year":"2024","type":"Сериал","rating":9.2,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/cmZ4xACYSZnVA8sqc5OBKDuW8Y7.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"228076","ru":"Ангелы тоже падают","en":"谢谢你温暖我","year":"2024","type":"Сериал","rating":9.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/x78k1Det2ICmb3pJUkZVQP4eWyd.jpg","genres":["драма"],"overview":"Студенческая жизнь полна ярких встреч и новых знакомств. Однако что делать, если среди всех этих встреч ты вдруг находишь свою настоящую любовь? Выпускники одного университета, Линь Туо и Ань Чжи Цюэ, случайно встречаются на рынке, а затем судьба снова сводит их на летней стажировке. Вместе они решают найти подработку. Линь Туо и Ань Чжи Цюэ поддерживают друг друга, быстро влюбляются и начинают встречаться. Когда кажется, что все идет хорошо, Линь Туо ставят диагноз БАС (боковой амиотрофический склероз), который навсегда меняет его жизнь. Но вместе с тем он получает много поддержки от близких людей и своей возлюбленной.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1168426","ru":"گێلگامێش لە کوێیە؟","en":"گێلگامێش لە کوێیە؟","year":"2024","type":"Фильм","rating":9.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/nxQWdkWUwd2b6TweZ7swwxbSFqr.jpg","genres":["боевик","криминал","триллер"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"252396","ru":"Следуй за своим сердцем","en":"颜心记","year":"2024","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/6TXKEuHtIE2J4ROWYrxAGGMcaSV.jpg","genres":["детектив","комедия","драма"],"overview":"Цзян Синьбай (Ло Юньси) несколько высокомерен и у него плохая память на лица из-за былой травмы головы, полученной во время спасения девушки. Цзян Синьбай - констебль, \"охотник за головами\". Его отца убили, когда юноше было 18 лет, и теперь он надеется открыть правду о тех событиях. Во время тайного расследования он знакомится с милой и добросердечной девушкой Янь Наньсин (Сун И), которая прекрасно разбирается в лекарственных средствах и владеет боевыми искусствами. В детстве она была похищена. К счастью, какой-то юноша спас ее, но с тех пор Янь Наньсин страдает от странного \"синдрома трансформации\", каждый месяц на несколько дней превращаясь в кого-то другого. Однако Цзян Синьбай с его \"слепотой на лица\" всегда может интуитивно узнать её. Этим двум героям предстоит пройти долгий путь вместе, трижды вступить в брак и раскрыть, наконец, кто же стоит за всеми заговорами и запутанными делами.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"278887","ru":"外道の歌","en":"外道の歌","year":"2024","type":"Сериал","rating":9.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/f1Xl7nbCQzTbwdFJEHhHfDPTpvy.jpg","genres":[],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""}]}