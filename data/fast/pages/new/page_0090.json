y":"","ageRating":""},{"id":"1207936","ru":"Der Schimmelreiter","en":"Der Schimmelreiter","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/5XBqrbrjcchS3pJCWQVYMbk0g7r.jpg","genres":["драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1533842","ru":"Умка","en":"Умка","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/lbuaR3gDXMnWofiaOHWc4ohFQje.jpg","genres":["семейный","приключения","фэнтези"],"overview":"В новогоднюю ночь Тайкэ и Умка одновременно загадывают сокровенное желание — найти настоящего друга. Чудесная встреча маленького мальчика и белого медвежонка происходит уже на следующее утро, и они становятся лучшими друзьями. Тайкэ и Умка хранят свою дружбу в секрете, о котором однажды узнает заезжий браконьер Седой со своими подельниками. Обманув Тайкэ, они похищают маму Умки, чтобы продать белую медведицу в частный зоопарк. Но храбрый Тайкэ, к которому на помощь придет его семья, сделают все, чтобы спасти и вернуть Умке его маму.","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1567149","ru":"仮面ライダーカブト20th 天を継ぐもの","en":"仮面ライダーカブト20th 天を継ぐもの","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/dsFF9fAARz1UlHbtRjlqup356FO.jpg","genres":["фантастика","боевик","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1353077","ru":"Your's Sincerely RAAM","en":"Your's Sincerely RAAM","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/yEDMnig9v99da7eucmX96dcckdz.jpg","genres":["военный","мелодрама","комедия","драма"],"overview":"","source":"tmdb","tmdbId":"","episodes":"","status":"","studio":"","country":"","ageRating":""},{"id":"1422612","ru":"The Giaccomo","en":"The Giaccomo","year":"2026","type":"Фильм",