s":["ужасы","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1456070","ru":"Gar kein Geld macht auch nicht glücklich","en":"Gar kein Geld macht auch nicht glücklich","year":"2025","type":"Фильм","rating":5.8,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/1wBgYgevV0v3nwUAWLjt2pR9da2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/h7FppvAJiMWDUWKY9co68BZtd6q.jpg","genres":["телевизионный фильм","комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1483874","ru":"Ozora: Penganiayaan Brutal Penguasa Jaksel","en":"Ozora: Penganiayaan Brutal Penguasa Jaksel","year":"2025","type":"Фильм","rating":5.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1DtJp2CjUDlD4ZM2KMRMNFmKG0p.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1I9xmMWkiC1wBjhvqGGKwLDMErI.jpg","genres":["криминал","драма","детектив","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1001288","ru":"Vade Retro","en":"Vade Retro","year":"2025","type":"Фильм","rating":5.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/1D2Hn8HD9tpU9j901vNRmn4Oz3J.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kUge2oMADWkJazaGUzMn6iePwKw.jpg","genres":["фэнтези","комедия","ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1476470","ru":"Hagen Benz - Das Böse in dir","en":"Hagen Benz - Das Böse in dir","year":"2025","type":"Фильм","rating":5.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/agAGqGlN9ugjosuE1Worp41wGS5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ts2XrI7n5HknB1Z74zBobD0w5R7.jpg","genres":["криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"962626","ru":"Warkop DKI Kartun","en":"Warkop DKI Kartun","year":"2025","type":"Мультфильм","rating":5.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/9214WrQcG5aVvZe4zNj8ybY66qf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/RUlKr0zgJj5OLElnVgTFhgsJ9d.jpg","genres":["мультфильм","комедия","фантастика","фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1291829","ru":"& Sons","en":"& Sons","year":"2025","type":"Фильм","rating":5.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/jMZ4icOHtj0y0kG1fJQjPq05nvz.jpg","backdrop":"","genres":["драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1484640","ru":"Плыви ко мне","en":"Limpia","year":"2025","type":"Фильм","rating":5.7,"votes":27,"poster":"https://image.tmdb.org/t/p/w342/wHK4R14rjhoDIBwmk9uwTNpopFz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oVph5mMhp0UxVYeSpIfUfll0kcF.jpg","genres":["драма"],"overview":"Молодая женщина Эстела оставляет свой родной провинциальный городок и переезжает в Сантьяго. Там она устраивается домработницей в состоятельную семью. Фильм повествует о её жизни в новом окружении.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1261555","ru":"Setetes Embun Cinta Niyala","en":"Setetes Embun Cinta Niyala","year":"2025","type":"Фильм","rating":5.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/iolOzpZILKFf2Ve88VnaKwU4DEg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wk0vWuxCNKmFWHhaqEAtBVRhUkY.jpg","genres":["драма","мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1226354","ru":"Парам и Сундари","en":"परम सुंदरी","year":"2025","type":"Фильм","rating":5.7,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/uLPUsH3Fwe6mAU7n6WpMSDLdYCm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/A5FkracCv0UeQuRPtM0dcXlUzz2.jpg","genres":["мелодрама","драма","комедия"],"overview":"Сундари — девушка из традиционной семьи в Керале, утончённая, сдержанная и увлечённая живописью. Её размеренный мир рушится, когда она знакомится с Парамом — напористым, харизматичным бизнесменом из Дели. Между ними вспыхивает притяжение, но и столь же сильное отторжение: их разность — это не только культурный конфликт, но и столкновение двух жизней, мировоззрений, характеров.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1522126","ru":"1000 Men and Me: The Bonnie Blue Story","en":"1000 Men and Me: The Bonnie Blue Story","year":"2025","type":"Фильм","rating":5.7,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/5dcgoyf8nt6Xt4VSR6Nrn6nwhuz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/62a8bMDftwD9aU0dkXr4eN6Q5q2.jpg","genres":["документальный","телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1001249","ru":"Секреты Виктории","en":"Le Système Victoria","year":"2025","type":"Фильм","rating":5.7,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/jecs6kdzEyks717OJtARIitZAQ6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kZzPH4NHBHUuHHWKpaonmG70pwX.jpg","genres":["драма","мелодрама","комедия"],"overview":"Амбициозный архитектор Давид берет на себя ответственность за строительство самого высокого небоскреба Франции. Погруженный в водоворот жестких дедлайнов и бесконечного стресса, он встречает Викторию — женщину с железной хваткой и магнетическим обаянием, которая управляет людьми с холодной расчетливостью. Очарованный её харизмой, Давид постепенно погружается в её идеально отлаженную, но пугающую систему, где человеческая воля становится лишь винтиком в безжалостном механизме власти.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1142921","ru":"Именем твоей любви","en":"तेरे इश्क़ में","year":"2025","type":"Фильм","rating":5.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/7FsHlW9z7gDhDE4EXAE2WcXUVQj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3FgFKX1gW21LzjT0Yniflaqmhpr.jpg","genres":["мелодрама","драма"],"overview":"Шанкар, лучший летчик-истребитель ВВС Индии, спустя много лет после расставания, волею судьбы снова встречает свою бывшую возлюбленную Мукти, которая выбрала другого мужчину. Вспоминая прошлое в своих отношениях, они вновь переживают те чувства, включая ярость Шанкара от неразделённой любви.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1310086","ru":"Сбиться с пути 2","en":"Ute och cyklar","year":"2025","type":"Фильм","rating":5.7,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/gMZL6l30kSuE79v8hHhkpyHNNvt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kgzDl3kp37StXuy7M6IJxSmc8Fx.jpg","genres":["комедия","драма"],"overview":"Брат и сестра — Даниель и Лиза — готовятся к велосипедной гонке «Веттернрундан», на которой препятствиями будут неожиданные повороты, страсть из прошлого и семейные проблемы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1239288","ru":"Атропия","en":"Atropia","year":"2025","type":"Фильм","rating":5.7,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/a0KAyTinqkckfBQKEPCIGpkr1A8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/af7mgiKiFRdlsv01F18AP5rHEz6.jpg","genres":["комедия","драма"],"overview":"2000-е годы. Файруз, американская актриса иракского происхождения, работает в военном тренировочном городке на юге Калифорнии, где проходят подготовку американские военные перед отправкой на Ближний Восток. Файруз приходится играть разные роли: от простой местной жительницы до специалиста по химическому оружию. Когда она влюбляется в солдата, который играет роль повстанца, реконструкция оказывается под угрозой срыва.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1559760","ru":"Thoughts & Prayers","en":"Thoughts & Prayers","year":"2025","type":"Фильм","rating":5.7,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/y9GzO4jCjpurBWvgGp6clqdSK1G.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sjw0g6dSpKSnLMeLe2VoKG8WLpC.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1272121","ru":"മരണമാസ്സ്‌","en":"മരണമാസ്സ്‌","year":"2025","type":"Фильм","rating":5.7,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/erU6DGyYGEFrnE4reiGX3pytU2e.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hzUZ7MQjLhI3ucx33gPSgV9mMW1.jpg","genres":["комедия","криминал","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1470424","ru":"Голосовой помощник","en":"Голосовой помощник","year":"2025","type":"Фильм","rating":5.7,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/AsvgohgYkRxYNWt5ovOth6x57Vm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1W58j6ZOt1saJU4LsNOqpDdhVBW.jpg","genres":["триллер","детектив","ужасы"],"overview":"Компания друзей арендует на выходные дизайнерский загородный дом. Там есть всё для комфортного и весёлого отдыха, включая умную колонку Алёна. Она умеет развлекать гостей и управлять домом, а ещё ей известны секреты, которые скрывают друзья. Устройство вынуждает компанию играть в игру «Найди убийцу», чтобы выяснить обстоятельства смерти их подруги, которая погибла менее года назад.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"423881","ru":"Санаторий под знаком песочных часов","en":"Sanatorium pod Klepsydrą","year":"2025","type":"Мультфильм","rating":5.7,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/a6LnWxHit0ZtGAbJjid2nnCa7KK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dlGlWZYvsmo1d4unwd9QL3St8Gn.jpg","genres":["мультфильм","фэнтези","драма","ужасы"],"overview":"Йозеф отправляется в путешествие на призрачном поезде, чтобы навестить умирающего отца в отдалённом галисийском санатории. По прибытии он обнаруживает, что санаторий находится в пространстве, где движение времени искажено: смерть отца ещё не наступила, поскольку время здесь отстаёт от внешнего мира на неопределённый промежуток времени. Переживания Йозефа становятся всё более фрагментарными и похожими на сон по мере того, как он сталкивается с различными проявлениями отца, каждое из которых отражает разные аспекты их отношений и его собственной психики.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1037925","ru":"Как стать миллиардером","en":"Bull Run","year":"2025","type":"Фильм","rating":5.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/tAdwhsbUZGKkenCauIj7NTkvx5h.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oylRawElar6jIpDjpIGIzxjTkvt.jpg","genres":["комедия"],"overview":"Бобби работает на побегушках у своего босса в крупной инвестиционной компании на Уолл-Стрит. Однажды он решает, что теперь кофе будут носить ему и начинает воплощать свой хитроумный план обогащения и устранения конкурентов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"900838","ru":"The Bengal Files","en":"The Bengal Files","year":"2025","type":"Фильм","rating":5.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/3gbZh1S735CLz7NwFRb7bycUWkP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ncvfuh7OZG46Ohiw73RQfKVNecO.jpg","genres":["драма","история","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1400501","ru":"윗집 사람들","en":"윗집 사람들","year":"2025","type":"Фильм","rating":5.7,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/7FJTNAJEC8Y41RhlLtbJ5xeFKSO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1o41rCxC1MQQtoclUgf6tsgSDas.jpg","genres":["комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1591822","ru":"Пандора. Огонь и лёд","en":"Pandora: Fire and Ice","year":"2025","type":"Фильм","rating":5.7,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/vtpUX5OPRzc6vjYOAAg7MQ1SzNV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/quQeahjlVgqIxL3WjNFwRaKQcNX.jpg","genres":["фантастика","боевик","приключения"],"overview":"Человечество, истощив ресурсы Земли, отправляет новую экспедицию на Пандору, чтобы вывезти всё, что осталось. Но аборигены, которых люди когда-то считали примитивными, за прошедшие годы не только выжили, но и создали технологию, способную уничтожить целую планету. Их цель - Земля, и они готовы нанести удар. У человечества теперь есть лишь один шанс - остановить их сейчас.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"258578","ru":"魔法使いの約束","en":"魔法使いの約束","year":"2025","type":"Аниме","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/qmRgfyEwafV0qpPDh1PfUDigG5T.jpg","backdrop":"https://image.tmdb.org/t/p/w780/quHLmheViYmmvSp6QnCLn9Q4L0.jpg","genres":["мультфильм","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1530787","ru":"匿杀","en":"匿杀","year":"2025","type":"Фильм","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/wz7DchRv3sXIH87LyjhhxJdrVGk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/CZUyZdTBeOhr29KFjcsVjexEFE.jpg","genres":["криминал","детектив","триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1466747","ru":"Portal in the Pines","en":"Portal in the Pines","year":"2025","type":"Фильм","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/iB73OJ3smvKdPDSy1ieTW1BVaJo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Q8m7qKrvlLRqbpnIqMzgBv4v7g.jpg","genres":["ужасы","фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1601000","ru":"Critical Incident: Death at the Border","en":"Critical Incident: Death at the Border","year":"2025","type":"Фильм","rating":5.7,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/gThb7GuqTZ19EHgcvX3GSDdNBqJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/t2p67zRXn00bUrw94HReWdTp7Q0.jpg","genres":["документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}