: будучи уроженкой Гвендалавира, она унаследовала невероятный талант к конструированию. Это оказывается решающим оружием в борьбе её народа с ужасными тс’личами. Появление Эвилан даёт новую надежду на спасение мира, оказавшегося в опасности. Единственным ограничением для неё станет воображение.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"283119","ru":"深空彼岸","en":"深空彼岸","year":"2026","type":"Аниме","rating":9.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/bi3HXIWAzeXzs8ns9f1FVRwF1Zc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n0oinZsZqtZ7ug8jtfS4J7Bt52L.jpg","genres":["мультфильм","Боевик и Приключения","НФ и Фэнтези","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"289147","ru":"10-летие Паромщика","en":"灵魂摆渡·十年","year":"2026","type":"Сериал","rating":9.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/r1EHwuOLdQ396YOlpmBoFEeOit3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a84FbktGASmCKmbvEVBD3U0x3LH.jpg","genres":["Боевик и Приключения","НФ и Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"256568","ru":"Quelqu’un devrait interdire les dimanches après-midi","en":"Quelqu’un devrait interdire les dimanches après-midi","year":"2026","type":"Сериал","rating":9.5,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/rxvipwaaBnZmMR6GtwbbuZjzEJ6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/buGQfSRPsx34iQqhwPoyTP0FVo.jpg","genres":["комедия","Мыльная опера","драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"321559","ru":"거짓말이 사는 집","en":"거짓말이 사는 집","year":"2026","type":"Сериал","rating":9.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/8GaDUt2mY7L2fZeawEbhjxO1Vc2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xiCfjMXdxVXxizYSgDNH84BZcbt.jpg","genres":["драма","Боевик и Приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageR