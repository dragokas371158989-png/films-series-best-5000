[{"id":"kp_12835173","kinopoiskId":12835173,"ru":"Расстрел","en":"Расстрел","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["детектив"],"overview":"Ленинград, 1977 год. Группа преступников совершает налёт на инкассаторов возле универмага на Петроградской. Один из бандитов ― Набис ― под видом милиционера похищает уникальное колье прямо во время съёмок для модного журнала. В это же время его сообщники расстреливают инкассаторов из немецкого оружия времён войны. Свидетелем готовящегося преступления становится опытный преступник Вахрушев, а случайной участницей трагических событий ― манекенщица Полина. За расследование берётся московский следователь Павел Никандров. Однако вскоре расследование приобретает для него личный характер: Полина ― его жена, с которой они фактически расстались после потери ребёнка. В Ленинграде помощниками Никандрова становятся оперативник Илзе Круминя и следователь Вадим Жаринов. Тем временем внутри банды нарастает конфликт: каждый готов пойти на самые жестокие меры, чтобы добиться желаемого.","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T21:46:24Z"},{"id":"kp_8802873","kinopoiskId":8802873,"ru":"Балабол 10","en":"Балабол 10","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["детектив","комедия"],"overview":"Балабин становится наставником молодого судмедэксперта Эдуарда Путилина, мечтающего стать сотрудником убойного отдела. Вместе они берутся за расследование убийства отца Путилина.","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T21:46:24Z"},{"id":"kp_665068","kinopoiskId":665068,"ru":"Catalina Cache","en":"Catalina Cache","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["комедия","приключения"],"country":["США"],"status":"UNKNOWN","source":"kinopoisk_auto_v339","updated_at":"2026-07-14T21:46:01Z"},{"id":"kp_279903","kinopoiskId":279903,"ru":"Муж и жена","en":"Man and Wife","type":"Фильм","category":"Фильм","rating":0,"votes":0,"gen