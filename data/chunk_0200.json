ns Show","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия"],"country":["США"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_12648050","kinopoiskId":12648050,"ru":"В ловушке","en":"В ловушке","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["криминал","драма"],"overview":"Следователь Иван Красовский работает в районной полиции и занимается делами, связанными с запрещёнными веществами. В молодости он был полон надежд, однако его жизнь давно превратилась в рутину. Единственной радостью осталась только любимая дочь Арина, которая перешла на попечение отца после переезда матери за границу. По стечению обстоятельств девочка дружит с Настей — дочерью недавно вышедшего из тюрьмы бандита Дмитрия Птицына. Тот всеми силами пытается наладить жизнь и восстановить отношения с девушкой, ведь для него семья — самое ценное.","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_756115","kinopoiskId":756115,"ru":"Taj","en":"Taj","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма"],"country":["США"],"status":"UNKNOWN","source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_4401642","kinopoiskId":4401642,"ru":"Guardian Asshole","en":"Guardian Asshole","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия"],"country":["США"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_8552285","kinopoiskId":8552285,"ru":"Хозяин Москвы","en":"Хозяин Москвы","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма","история"],"overview":"Крепостной крестьянин Иван Никишин приезжает вместе с семьей в Москву в 1811 году. Впереди любовь, карьера, свобода и новая жизнь.","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_5070687","kinopoiskId":5070687,"ru":"Schneekind - ein Schwarzwaldkrimi","en":"Schneekind - ein Schwarzwaldkrimi","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["криминал"],"country":["Германия"],"status":"completed","source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_1314549","kinopoiskId":1314549,"ru":"Felson and Company","en":"Felson and Company","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия"],"country":["США"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_9349320","kinopoiskId":9349320,"ru":"Stowaway","en":"Stowaway","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма","криминал"],"country":["США"],"status":"pre-production","source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_1247903","kinopoiskId":1247903,"ru":"The Holy Bible Kid Style","en":"The Holy Bible Kid Style","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма","комедия","приключения","семейный","история"],"country":["США"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_1257638","kinopoiskId":1257638,"ru":"Ghost Lights: Reclaiming Theater in the Age of AIDS","en":"Ghost Lights: Reclaiming Theater in the Age of AIDS","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["документальный"],"country":["США"],"status":"filming","source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_7508457","kinopoiskId":7508457,"ru":"Champions","en":"Champions","type":"Сериал","category":"Сериал","rating":0,"votes":0,"country":["Великобритания"],"status":"pre-production","source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_1306333","kinopoiskId":1306333,"ru":"Electric Love","en":"Electric Love","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма"],"country":["Великобритания"],"status":"pre-production","source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_5916285","kinopoiskId":5916285,"ru":"Хрущёвский синдром: Пора взрослеть","en":"Хрущёвский синдром: Пора взрослеть","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма","комедия"],"overview":"Максиму двадцать три года, он живет в престижном районе столицы в роскошной квартире. Парень никогда ни в чем не знал нужды и не намерен покидать собственную зону комфорта. А вот родители «золотого мальчика» всерьез обеспокоены его инфантильностью и мечтают, чтобы он как можно скорее возмужал. С этой целью предки «ссылают» наследника в Балашиху. Парень временно переезжает в опустевшую после смерти бабушки квартиру. Он не собирается надолго там задерживаться — наведя в жилище порядок, Макс планирует вернуться в родные пенаты. В дальнейших его планах — продажа этих апартаментов и покупка собственного жилья неподалеку от родителей. Разумеется, юноша намерен увеличить свою платежеспособность за счет ипотеки. Однако пребывание в доме бабушки приводит к неожиданному эффекту: чем дольше Максим там остается, тем более явно у него проявляется «хрущевский синдром».","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/9784475/5aa097b1-aa60-4985-9a84-6114677ad1eb/600x900","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_4544751","kinopoiskId":4544751,"ru":"Foolproof","en":"Foolproof","type":"Сериал","category":"Сериал","rating":0,"votes":0,"country":["США"],"status":"filming","source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_4472419","kinopoiskId":4472419,"ru":"Pandemic Pillow Talk","en":"Pandemic Pillow Talk","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_4553766","kinopoiskId":4553766,"ru":"Urban Animals","en":"Urban Animals","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия"],"country":["Австралия"],"status":"UNKNOWN","source":"kinopoisk_auto_v339","updated_at":"2026-07-14T20:18:00Z"},{"id":"kp_1340021","kinopois