_v339","updated_at":"2026-07-15T05:44:43Z","aliases":["Декабрь"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1233147","kinopoiskId":1233147,"ru":"Малыш на драйве 2","en":"Baby Driver 2","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["боевик","триллер","драма","комедия","криминал","приключения","музыка"],"country":["Великобритания"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"Baby Driver 2","aliases":["Малыш на драйве 2","Baby Driver 2"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1202050","kinopoiskId":1202050,"ru":"Безумно богатые азиаты 2","en":"Crazy Rich Asians 2","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["драма","мелодрама","комедия"],"country":["США"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"Crazy Rich Asians 2","aliases":["Безумно богатые азиаты 2","Crazy Rich Asians 2"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1200006","kinopoiskId":1200006,"ru":"Творение богов. Часть 3","en":"Feng shen di san bu","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["фэнтези","боевик"],"poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10893610/9fbafdeb-19ec-4f7b-9ebf-bbf037386844/600x900","country":["Китай"],"status":"пост-продуктион","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"Feng shen di san bu","aliases":["Творение богов. Часть 3","Feng shen di san bu"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1183597","kinopoiskId":1183597,"ru":"Жених 2: На Берлин!","en":"Жених 2: На Берлин!","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["комедия","приключения"],"overview":"Проиграв битву за сердце местной красавицы, Гельмут находит новую любовь и уже спустя полгода готовится к свадьбе. Пришло время его русским друзьям нанести ему ответный визит – в Берлин!","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","aliases":["Жених 2: На Берлин!"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1176186","kinopoiskId":1176186,"ru":"В мире животных 2","en":"Dong wu shi jie 2","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["драма","боевик"],"poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/1946459/29bb0f28-54be-4d12-94bb-c781e8490dc3/600x900","country":["Китай"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"Dong wu shi jie 2","aliases":["В мире животных 2","Dong wu shi jie 2"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1100317","kinopoiskId":1100317,"ru":"Назови меня своим именем 2","en":"Untitled Call Me by Your Name Sequel","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["драма","мелодрама"],"country":["Италия"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"Untitled Call Me by Your Name Sequel","aliases":["Назови меня своим именем 2","Untitled Call Me by Your Name Sequel"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_679612","kinopoiskId":679612,"ru":"Ван Хельсинг","en":"Van Helsing","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["фэнтези","боевик","приключения"],"country":["США"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"Van Helsing","aliases":["Ван Хельсинг","Van Helsing"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_652479","kinopoiskId":652479,"ru":"В саду чудовищ","en":"In the Garden of Beasts","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["драма"],"overview":"Уильям Додд, тихий преподаватель истории из Чикагского университета, в 1933 году стал первым послом США в гитлеровской Германии. Вместе со своей супругой, сыном и эксцентричной дочерью Мартой Додд обосновался в Берлине, где Марта начала активно вести светскую жизнь. Уже вскоре после переезда дочь посла закрутила роман с главой гестапо Рудольфом Дильсом. Уильям с тревогой наблюдал за растущими гонениями на евреев, смертью независимой прессы и постепенным воцарением новых порядков.","country":["США"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"In the Garden of Beasts","aliases":["В саду чудовищ","In the Garden of Beasts"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_573924","kinopoiskId":573924,"ru":"Свидание с Рамой","en":"Rendezvous with Rama","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["фантастика","детектив","приключения"],"overview":"Экспедиция отправляется исследовать неопознанный космический корабль, который влетает в солнечную систему. По прибытии на космолет астронавты обнаруживают на нем массы чудных и поражающих воображение вещей.","poster":"https://image.tmdb.org/t/p/w500/3qlAMD0dVvalYPubvEUNRkV6y7s.jpg","country":["США","Чехия","Великобритания"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"Rendezvous with Rama","aliases":["Свидание с Рамой","Rendezvous with Rama"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_446138","kinopoiskId":446138,"ru":"20 000 лье под водой: Капитан Немо","en":"20,000 Leagues Under the Sea: Captain Nemo","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["фантастика","боевик","драма","приключения"],"country":["США"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"20,000 Leagues Under the Sea: Captain Nemo","aliases":["20 000 лье под водой: Капитан Немо","20,000 Leagues Under the Sea: Captain Nemo"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_10644520","kinopoiskId":10644520,"ru":"Честная игра","en":"Честная игра","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["комедия","спорт"],"overview":"Импульсивная бунтарка Ангелина и одарённая теннисистка Надя приезжают в Москву ради участия в крупном турнире с внушительным призовым фондом. Для одной спорт становится шансом доказать себе и окружающим, что она способна на большее, для другой — возможностью сбежать от прошлых проблем. Однако соперничество на корте быстро выходит за его пределы: вмешательство взрослых игроков меняет правила игры и превращает турнир в испытание на характер, честность и верность собственным принципам.","country":["Россия"],"ageRating":"12+","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","aliases":["Честная игра"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_10433690","kinopoiskId":10433690,"ru":"Весельчак У","en":"Весельчак У","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["приключения","фантастика","семейный"],"overview":"Космический пират Весельчак У застрял на Земле в нашем времени после стычки с Алисой Селезневой, ее мамой и старшеклассниками одной московской школы. Больше всего на свете он хочет завладеть космионом, вернуться в свое время и, наконец, возглавить Пиратский альянс. Поиски артефакта приводят его к мальчику Юре и его маме Кате, которые загадочным образом связаны с космионом. А когда охоту за ними начинает могущественный космический воин Тео, Весельчаку приходится встать на защиту Юры и Кати — ведь он благородный пират. Вместе они отправляются в полное опасных приключений путешествие, чтобы раскрыть все тайны своего прошлого и будущего.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10953618/e9977cdf-d319-4ec9-bea7-eaf42615da01/600x900","country":["Россия"],"ageRating":"6+","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","aliases":["Весельчак У"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1057245","kinopoiskId":1057245,"ru":"Рузвельт","en":"Roosevelt","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["драма","биография","история"],"country":["США"],"status":"предварительное производство","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"Roosevelt","aliases":["Рузвельт","Roosevelt"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1048242","kinopoiskId":1048242,"ru":"Атака титанов","en":"Attack on Titan","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["фантастика","фэнтези","боевик","драма"],"country":["США"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","originalTitle":"Attack on Titan","aliases":["Атака титанов","Attack on Titan"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1046056","kinopoiskId":1046056,"ru":"Как дети","en":"Как дети","type":"Фильм","category":"Фильм","rating":0,"votes":0,"overview":"1982 год. В одном из московских театров заносчивый актер-звезда оскорбляет актрису, карьера которой складывается куда менее успешно, чем у него самого. Девушка начинает мстить обидчику, но в итоге оказывается, что «от ненависти до любви — один шаг».","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:43Z","aliases":["Как дети"],"titleLocalizationSource":"Existing Russian","genres":[]},{"id":"kp_5284746","kinopoiskId":5284746,"ru":"Голливудск","en":"Голливудск","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия"],"overview":"Чтобы отдать долг самому влиятельному бизнесмену Сочи, владелец региональной сети кинотеатров снимает блокбастер с двойниками знаменитых голливудских актеров.","shortDescription":"Владелец кинотеатров снимает зомби-хит с двойниками звёзд Голливуда. Комедия режиссёра «Оливье и роботов»","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/4486454/80c561f7-769e-4ec7-8375-bdc90c9de67a/600x900","country":["Россия"],"ageRating":"16+","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:46Z","aliases":["Голливудск"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_8752480","kinopoiskId":8752480,"ru":"Хакеры","en":"Хакеры","type":"Сериал","category":"Сериал","rating":0,"votes":0,"overview":"В самых тёмных уголках интернета каждый день так называемые «белые хакеры» ведут противостояние с киберпреступниками. Их задача — раскрыть любую, даже самую мелкую уязвимость, чтобы защитить IT-инфраструктуры многомиллиардных компаний, а иногда и целых государств. Главный герой оказывается перед сложным выбором, где каждый его шаг будет влиять на жизни миллионов людей, ежедневно пользующихся современными благами общества и ничего не подозревающих о происходящем.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/4486362/5e1c873d-95f8-46ff-9e9d-54987339ecde/600x900","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:46Z","aliases":["Хакеры"],"titleLocalizationSource":"Existing Russian","genres":[]},{"id":"kp_1235255","kinopoiskId":1235255,"ru":"Лего Фильм: Бэтмен 2","en":"The Lego Batman Movie 2","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","боевик","комедия","приключения","семейный"],"country":["США"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"The Lego Batman Movie 2","aliases":["Лего Фильм: Бэтмен 2","The Lego Batman Movie 2"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1044145","kinopoiskId":1044145,"ru":"Тхе Плантс вс Зомбиес Мовие","en":"The Plants vs Zombies Movie","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","фэнтези","комедия","приключения","семейный"],"status":"объявленный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"The Plants vs Zombies Movie","aliases":["The Plants vs Zombies Movie","Тхе Плантс вс Зомбиес Мовие"],"titleLocalizationSource":"Argos V3453"},{"id":"kp_470222","kinopoiskId":470222,"ru":"Мёртвый космос","en":"Dead Space","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","ужасы","фантастика"],"country":["США"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"Dead Space","aliases":["Мёртвый космос","Dead Space"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_7178239","kinopoiskId":7178239,"ru":"Нэчжа 3","en":"Ne zha 3","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","фэнтези"],"poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/4483445/a5e38340-7766-4d8b-a7e1-6ed2870adbfc/600x900","country":["Китай"],"status":"предварительное производство","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"Ne zha 3","aliases":["Нэчжа 3","Ne zha 3"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_5511937","kinopoiskId":5511937,"ru":"Астрочел в Кино","en":"Astrodude The Movie","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","фантастика","комедия"],"overview":"Астрочел получает предупреждение от своего сына, путешествующего во времени: следующая миссия станет для него последней. Вместе они отправляются в путешествие, чтобы разгадать тайну его исчезновения.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10893610/df0fc6b4-2cff-4786-853c-0d03fba90a4e/600x900","country":["Россия","США","Великобритания"],"ageRating":"12+","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:20Z","originalTitle":"Astrodude The Movie","aliases":["Астрочел в Кино","Astrodude The Movie"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_5366079","kinopoiskId":5366079,"ru":"Фиксики и инопланетяне","en":"Фиксики и инопланетяне","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм"],"country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","aliases":["Фиксики и инопланетяне"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_4489895","kinopoiskId":4489895,"ru":"Ходжа Насреддин","en":"Hodja Nasreddin","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","комедия","приключения"],"overview":"Ходжа Насреддин спасает ишака от жары. Теперь тот находится в услужении Ходжи, с чего и начинаются все его приключения. Ишак живет, трудится, не может поднять голову, но встреча с Ходжой перевернет его мир.","poster":"https://avatars.mds.yandex.net/get-ott/1648503/2a000001955b87fce32bed34e68b1a91c047/600x900","country":["Россия","Турция","Казахстан","Узбекистан"],"ageRating":"6+","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"Hodja Nasreddin","aliases":["Ходжа Насреддин","Hodja Nasreddin"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_4409861","kinopoiskId":4409861,"ru":"Волшебный дракон 2","en":"Wish Dragon 2","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","фэнтези","комедия","приключения","семейный"],"poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/1600647/c604a7a3-2cd0-442e-9b6c-bfd76cf7873a/600x900","country":["Китай","США","Гонконг"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"Wish Dragon 2","aliases":["Волшебный дракон 2","Wish Dragon 2"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_719888","kinopoiskId":719888,"ru":"Гриффины","en":"Family Guy","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","мюзикл","триллер","комедия","криминал","детектив","приключения"],"country":["США"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"Family Guy","aliases":["Гриффины","Family Guy"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_408880","kinopoiskId":408880,"ru":"Тинтин 3","en":"Untitled Third Tintin Film","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","комедия","детектив","приключения","семейный"],"country":["США"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"Untitled Third Tintin Film","aliases":["Тинтин 3","Untitled Third Tintin Film"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_1347030","kinopoiskId":1347030,"ru":"Тхе Картоон Тоукх","en":"The Cartoon Touch","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","семейный"],"country":["США"],"status":"объявленный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"The Cartoon Touch","aliases":["The Cartoon Touch","Тхе Картоон Тоукх"],"titleLocalizationSource":"Argos V3453"},{"id":"kp_1193406","kinopoiskId":1193406,"ru":"Пете","en":"Pete","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","короткометражка"],"country":["США"],"status":"предварительное производство","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:52Z","originalTitle":"Pete","aliases":["Pete","Пете"],"titleLocalizationSource":"Argos V3453"},{"id":"kp_1151966","kinopoiskId":1151966,"ru":"Мйконос Блуе","en":"Mykonos Blue","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм"],"country":["США"],"status":"завершенный","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:55Z","originalTitle":"Mykonos Blue","aliases":["Mykonos Blue","Мйконос Блуе"],"titleLocalizationSource":"Argos V3453"},{"id":"kp_1176900","kinopoiskId":1176900,"ru":"Тхе Пластик Пест","en":"The Plastic Pest","type":"Мультфильм","category":"Мультфильм","rating":0,"votes":0,"genres":["мультфильм","короткометражка","семейный"],"country":["США"],"status":"пост-продуктион","source":"kinopoisk_auto_v339","updated_at":"2026-07-15T05:44:55Z","originalTitle":"The Plastic Pest","aliases":["The Plastic Pest","Тхе Пластик Пест"],"titleLocalizationSource":"Argos V3453"},{"id":"kp_6388965","kinopoiskId":6388965,"ru":"Солнце за облаками","en":"Солнце за облаками","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["мелодрама"],"overview":"Стоматолог Вика счастлива в браке с Максимом. Вскоре у женщины начинаются проблемы: карьера оказывается под угрозой из-за влиятельной пациентки, а семейную жизнь разрушает измена мужа.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10592371/71a57d98-a93c-49cc-b010-a4bf0473e115/600x900","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-22T22:43:33Z","aliases":["Солнце за облаками"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_8357994","kinopoiskId":8357994,"ru":"Царевна Несмеяна","en":"Царевна Несмеяна","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["приключения","фэнтези","семейный"],"overview":"Прагматичный Ерёма накануне повышения на работе случайно попадает в волшебное Тридевятое царство вместе с младшей сестрой. Чтобы вернуться домой, ему нужно рассмешить хмурую Царевну Несмеяну. Но сделать это будет непросто, ведь на самом деле девушка лишь притворяется — она мечтает о настоящей любви. Ерёма завоевывает доверие Царства и сердце Царевны, но, добившись цели, признается в обмане и возвращается в реальный мир. В награду он получает все, о чем только мечтал, но ощущает, что потерял главное. Тем временем Несмеяну похищает Водяной, а сказочный мир погружается в уныние. Ерема решает вернуться в Тридевятое царство и спасти Несмеяну, не зная, удастся ли ему снова пройти путь героя, только уже не ради награды, а ради любви.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10703859/e570a32e-8103-486c-ae4b-71dda288f043/600x900","country":["Россия"],"ageRating":"6+","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:12:59Z","aliases":["Царевна Несмеяна"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_8075518","kinopoiskId":8075518,"ru":"Домовенок Кузя 3","en":"Домовенок Кузя 3","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["комедия","семейный","фэнтези"],"poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/1898899/966a89f5-8fd2-4615-8cba-f46255221f1b/600x900","country":["Россия"],"ageRating":"6+","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:12:59Z","aliases":["Домовенок Кузя 3"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_6359275","kinopoiskId":6359275,"ru":"Ип Ман 5","en":"Yip Man 5","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["биография","боевик","драма"],"poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10900341/c8067bf4-7446-4b8b-8c62-e2dc737789fb/600x900","country":["Гонконг","Китай"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:12:59Z","originalTitle":"Yip Man 5","aliases":["Ип Ман 5","Yip Man 5"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_4538190","kinopoiskId":4538190,"ru":"Шум времени","en":"Шум времени","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["драма","биография","история"],"overview":"XX век. История о гении: шумные джазовые вечеринки и нарастающая тревога, блеск парадов и публичные покаяния, мировое признание и объятия партии.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/9784475/35f3330a-9b4b-47a7-bfb0-7915205db9c4/600x900","country":["Россия"],"ageRating":"12+","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:12:59Z","aliases":["Шум времени"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_4291584","kinopoiskId":4291584,"ru":"Отель «У погибшего альпиниста»","en":"Отель «У погибшего альпиниста»","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["детектив","фантастика","драма"],"overview":"Полицейский инспектор Петер Глебски приезжает по анонимке в небольшой горный отель «У Погибшего Альпиниста» — письмо предостерегает, что в отеле будет совершено убийство. Сошедшая вечером лавина перекрывает единственный выход из ущелья, а ночью Глебски обнаруживает труп одного из гостей.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10592371/32f9728c-447d-4ece-b995-2fdb05767b86/600x900","country":["Россия"],"ageRating":"16+","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:12:59Z","aliases":["Отель «У погибшего альпиниста»"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_839861","kinopoiskId":839861,"ru":"Коловрат. Восхождение","en":"Коловрат. Восхождение","type":"Фильм","category":"Фильм","rating":0,"votes":0,"genres":["история","боевик","драма"],"poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/1600647/b81d28a2-3d2a-42e7-8633-76b979034c77/600x900","country":["Россия"],"status":"Неизвестный","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:12:59Z","aliases":["Коловрат. Восхождение"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_7283766","kinopoiskId":7283766,"ru":"Айда!","en":"Айда!","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["криминал","драма"],"overview":"Гриша, подросток из привилегированной семьи, переезжает из Волгограда в Казань и оказывается в эпицентре войны уличных банд. Он чужой в этом мире, но, чтобы выжить, вынужден учиться его жестоким правилам. Неожиданным наставником для него становится идеолог банды «Тяп-Ляп» Захаревич — умный, образованный и амбициозный манипулятор, создавший систему втягивания подростков в организованную преступность. Единственный, кто осознает надвигающуюся угрозу — начальник уголовного розыска Никонов. Ему потребуется время, чтобы понять, что это не просто криминальный всплеск, за которыми стоят нерядовые фигуры, а начало масштабных процессов, способных разрушить страну.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10835644/283c4516-ef1b-4ca9-816a-01a96a3cde3c/600x900","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Айда!"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_12432917","kinopoiskId":12432917,"ru":"Клятва Гиппократа","en":"Клятва Гиппократа","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия"],"overview":"Виктор Живых — молодой талантливый хирург с самомнением, которое не пробить даже скальпелем, привык действовать импульсивно, не думая о последствиях. Спасая пациента, он нарушает все правила и, несмотря на субординацию, вмешивается в операцию Главврача. Наказание за такую самовольную выходку хуже выговора: Виктора отправляют на скорую помощь.","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Клятва Гиппократа"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_8738133","kinopoiskId":8738133,"ru":"Почти настоящий детектив","en":"Почти настоящий детектив","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия","детектив"],"overview":"Харизматичный и самовлюблённый артист и шоумен приезжает в небольшой городок, чтобы стать лицом рекламной кампании банка своего друга, самого влиятельного человека города Аркадия Шмакова. Его встречают фанфары и громкие речи, но пышный праздник оборачивается громким криминальным делом: банк захватывают, хозяина ранят, а артиста объявляют главным подозреваемым. Расследование берёт в свои руки Надежда — майор полиции и, по совместительству, будущая мать. Она приступает к делу на девятом месяце беременности. Начальник местной полиции не очень рад возвращению Надежды в строй и всячески пытается отстранить её от расследования. Чтобы докопаться до правды, артисту и Надежде придётся объединить усилия, невзирая на личные страхи и обстоятельства.","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Почти настоящий детектив"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_9182933","kinopoiskId":9182933,"ru":"Околоточный","en":"Околоточный","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["детектив"],"overview":"Конец XIX века. Иван Хватов — бывший военный с суровым характером, знающий цену человеческой жизни. Он работает околоточным надзирателем и уже думает оставить службу, когда его маленький город потрясает зверское убийство целой семьи Охапкиных. Распутывая дело, он выходит на след местного аристократа Добужинского, известного своими карточными долгами. Однако его сестра, графиня Ольга, не верит в виновность брата и сама решает найти убийцу. Вначале Добружинскую заботит лишь честь семьи, но вскоре любопытство и внутренняя тяга к приключениям увлекают ее все дальше, приводя к неожиданному союзу с Хватовым. Вместе им предстоит не только докопаться до истины, но и столкнуться с тайнами, которые скрывают другие влиятельные горожане.","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Околоточный"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_7991630","kinopoiskId":7991630,"ru":"Игра в прятки","en":"Игра в прятки","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["триллер","детектив","боевик"],"overview":"Следователь Андрей Скуратов расследует серию загадочных смертей: жертвы погибают от своих же фобий, а на лицах застывает одинаково жуткая улыбка. Единственная зацепка — препарат «Гуру» в их крови. Когда след приводит к его собственной жене, практикующему психологу, Андрей нарушает все служебные правила, чтобы докопаться до правды. Но чем глубже он копает, тем больше понимает — кто-то ведет эту игру, прекрасно зная все его слабые места.","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Игра в прятки"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_5284735","kinopoiskId":5284735,"ru":"Неспящие в Сосновке","en":"Неспящие в Сосновке","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия"],"overview":"Трое школьных товарищей, по роковому стечению обстоятельств, остаются без работы и становятся изгоями в поселке. Чтобы прокормить себя и свои семьи они решают открыть собственный бизнес и занять самую прибыльную нишу с полным отсутствием конкуренции — стать гейшами. Для этого друзья отправляются в Сосновку, настоящий «город невест», где практически нет мужчин.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10893610/307fdc6d-3a8f-46c9-b818-d267bc34d689/600x900","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Неспящие в Сосновке"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_5138504","kinopoiskId":5138504,"ru":"Гангс оф Нев Йорк","en":"Gangs of New York","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма"],"country":["США"],"status":"предварительное производство","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","originalTitle":"Gangs of New York","aliases":["Gangs of New York","Гангс оф Нев Йорк"],"titleLocalizationSource":"Argos V3453"},{"id":"kp_8545317","kinopoiskId":8545317,"ru":"Полдень","en":"Полдень","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["фантастика","триллер"],"overview":"Земля превратилась в воплощение гуманистической утопии. Глава Комиссии по контактам с внеземными цивилизациями Рудольф Сикорски поручает Максиму Каммереру найти Льва Абалкина — прогрессора, таинственно исчезнувшего после контакта со сверхцивилизацией Странников. Группа Абалкина исследовала планету Надежда, которая погибла вследствие чудовищного эксперимента, проводимого там Странниками. После контакта с ними Абалкин убивает напарника и летит на Землю, чтобы запустить процесс, подобный тому, что уничтожил Надежду. Каммереру удается выйти на след Абалкина, но тот всегда опережает его на шаг.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10671298/db3ea048-2d57-4d57-9947-aebed8dfc86f/600x900","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Полдень"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_6144216","kinopoiskId":6144216,"ru":"Нам кранты","en":"Нам кранты","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["комедия","криминал"],"overview":"Буслай, Сержант и Мансур дружат с детства и постоянно влипают в неприятности. Правда, на этот раз они попали по-крупному. Решив быстро заработать, парни отправляются на заброшенную стройку, чтобы разрезать и сдать на металл старый кран. Но всё идёт не по плану, и башня крана обрушивается на машину местного авторитета. Случайная авария запускает цепочку нелепых событий.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10893610/df2008fc-030f-42d1-9155-d10a22e7417e/600x900","country":["Россия"],"ageRating":"18+","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Нам кранты"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_13131488","kinopoiskId":13131488,"ru":"Открытки из Италии","en":"Postais na Itália","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма","мелодрама","комедия"],"poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10671298/e1dcce42-5b4d-4c5a-a5b1-192c7531f102/600x900","country":["Италия"],"status":"завершенный","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","originalTitle":"Postais na Itália","aliases":["Открытки из Италии","Postais na Itália"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_5212978","kinopoiskId":5212978,"ru":"Летние каникулы","en":"Yeoreumbanghak","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма"],"country":["Корея Южная"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","originalTitle":"Yeoreumbanghak","aliases":["Летние каникулы","Yeoreumbanghak"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_8802066","kinopoiskId":8802066,"ru":"Полураспад","en":"Полураспад","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма"],"overview":"Перестройка. Дочь легендарного журналиста Надежда узнаёт о смерти отца. Во время похорон девушка обращает внимание, что многие его земляки умерли молодыми. Местные ссылаются на учения со взрывом атомной бомбы. Надя понимает, что от людей скрывают правду, и она обязана продолжить расследование отца.","poster":"https://avatars.mds.yandex.net/get-kinopoisk-image/10592371/541a332e-0380-4664-8e34-b215d2189f66/600x900","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Полураспад"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_8489946","kinopoiskId":8489946,"ru":"Враги","en":"Враги","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма"],"overview":"Семья Телегиных закончила стройку мечты — в глухой деревне недалеко от Ельца на месте старой родительской дачи возведен модный барнхаус. Ради этого Игорю, специалисту в сфере IT, и его жене Дарье, практикующему психологу, пришлось влезть в долги, но другого выхода не было — врачи рекомендовали их сыну с иммунным заболеванием жить в экологически чистой местности. Сначала новый дом кажется Телегиным раем земным, но есть и минусы. Часто отключают свет, скорую можно ждать часами, а главная проблема — соседи Кулешовы. Тамара Кулешова — матриарх семейства, тянет на себе умирающее хозяйство, полусумасшедшего деда, старшего сына, отбывающего третий срок, и младшего, который перебивается подработками. Москвичи, построившие рядом со старым деревенским домом Кулешовых свою выпендрёжную дачу, сразу разозлили местных. Бытовое хамство перерастает в скрытую вражду, а потом и в открытое противостояние.","country":["Россия"],"source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","aliases":["Враги"],"titleLocalizationSource":"Existing Russian"},{"id":"kp_7652378","kinopoiskId":7652378,"ru":"Гордость и предубеждение","en":"Pride and Prejudice","type":"Сериал","category":"Сериал","rating":0,"votes":0,"genres":["драма","мелодрама"],"country":["Великобритания"],"status":"съемка","source":"kinopoisk_auto_v339","updated_at":"2026-07-23T06:13:03Z","originalTitle":"Pride and Prejudice","aliases":["Гордость и предубеждение","Pride and Prejudice"],"titleLocalizationSource":"Existing Russian"}]