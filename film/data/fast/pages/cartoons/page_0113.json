s":2,"poster":"https://image.tmdb.org/t/p/w342/9oQg7bEgIjVoD360CARByd0FCDl.jpg","backdrop":"","genres":["Мультфильм","Фантастика"],"overview":"Чудом оставшись в живых после разрушительной атаки на родную деревню, парящую в бескрайних небесах далекой неведомой планеты, отважный мальчик Джошуа спасается на борту летающей крепости. Здесь его новыми друзьями становятся бесстрашные рейнджеры и гениальные ученые, странствующие по удивительному миру магических облаков и небесных озер, миру, свободному от земного притяжения. Сражаясь с безжалостными пиратами, охотясь на невиданных зверей и смело вступая в бой с врагами, Джошуа постигает нелегкую науку воздушного кадета, мечтая стать небесным рейнджером и отомстить загадочному и коварному врагу...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1274278","ru":"宇宙戦艦ヤマト2199 第六章「到達！大マゼラン」","en":"宇宙戦艦ヤマト2199 第六章「到達！大マゼラン」","year":"2013","type":"Мультфильм","rating":5.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/reyZJfMHfAYIY6ZMF6mwL1yT0ll.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xPbOyocSKgvqyZfVNSYv8SQy0Pi.jpg","genres":["Мультфильм","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"443269","ru":"ファントム勇者伝説","en":"ファントム勇者伝説","year":"1991","type":"Мультфильм","rating":5.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/rylNTdjuS8xG7p2TOIKKdFZOLjp.jpg","backdrop":"","genres":["Военный","Мультфильм","Боевик","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"470693","ru":"Sin in the Rain","en":"Sin in the Rain","year":"2006","type":"Мультфильм","rating":5.8,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/v5Qc2FWXH5rMdE2Vr4pp5S64bx9.jpg","backdrop":"","genres":["Детектив","Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"287095","ru":"Light and Heavy","en":"Light and Heavy","year":"1991","type":"Мультфильм","rating":5.7,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/kC9tqPE3dqwBBp2sEL7xBgPP4yQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zjO1MfRvNyZUWYW11IUPxlWfqK.jpg","genres":["Мультфильм","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"139231","ru":"Стрекоза и муравей","en":"Стрекоза и муравей","year":"1913","type":"Мультфильм","rating":5.7,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/bOEcipXdJpLN3ku8d69wrWbw2aR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5Du0O3KgfTQ3KL7Iz1Ff0rFc0jY.jpg","genres":["Мультфильм","Фэнтези"],"overview":"Экранизация одноимённой басни Крылова.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"448450","ru":"Gunter Babysits","en":"Gunter Babysits","year":"2017","type":"Мультфильм","rating":5.7,"votes":26,"poster":"https://image.tmdb.org/t/p/w342/3yYYIBgKIfdApvntbkD47YuIanY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zkLp7HH9J6Zq7SUSbCs734MySt8.jpg","genres":["Мультфильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"947507","ru":"Просто супер","en":"Helt super","year":"2022","type":"Мультфильм","rating":5.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/qFgmiuePQrrcS9Ri9wT9i5yJHWJ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w66mT7g0cA7lcHcdJ9SGRIONdo8.jpg","genres":["Мультфильм","Семейный","Фэнтези"],"overview":"11-летняя Хедвиг мечтает быть похожей на своего знаменитого отца-супергероя и совершать отчаянные поступки. Но в жизни она неуклюжий и нерасторопный подросток, над которым посмеиваются одноклассники. Даже отец не верит в ее способности. Своим преемником он хочет сделать ловкого и спортивного племянника Адриана. Сама же Хедвиг не сдается. С помощью эксцентричной бабушки, но втайне от отца она примеряет волшебный костюм. В нем заключена суперсила, справиться с которой не так-то просто.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1208491","ru":"Пушистое превращение","en":"Zak & Wowo, la légende de Lendarys","year":"2024","type":"Мультфильм","rating":5.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/uR70IF8Xiw3fnM2j5KBmDKyyP2o.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6PAkwvDjaSS9vN6RXTAcCbUoDxA.jpg","genres":["Мультфильм","Приключения","Фэнтези"],"overview":"Братья-близнецы Кайл и Зак живут в фантастическом мире, бок о бок с невероятными магическими существами. Но всё меняется с появлением таинственных зандаров. Чтобы спасти свой волшебный мир, подростки и их пушистые друзья отправляются в увлекательное приключение, полное захватывающих чудес.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"824184","ru":"Три богатыря и Конь на троне","en":"Три богатыря и Конь на троне","year":"2021","type":"Мультфильм","rating":5.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/wQqEh8BqiTRFhp50c8jGD6A8gpx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3AP6umJzswdgPZMiAHmOvnQL8nt.jpg","genres":["Мультфильм","Комедия","Приключения"],"overview":"Как всегда, конь Юлий вляпался в историю. А заодно и Князю удружил — они случайно поменялись телами, конечно, не без помощи старой знакомой — Бабы Яги и небольшого колдовства. Теперь Юлий заседает во дворце и благоустраивает Киев, а Князь пашет поле. Вот такие игры престолов. Но долго так продолжаться не может, отечество в опасности! И как всегда, за дело берутся три богатыря.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"148950","ru":"Одна история","en":"A Story","year":"1987","type":"Мультфильм","rating":5.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/48L35oaTTXQrwVPdRs0St6bZ5Ql.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5mNa6TxBzxB2lN7p4NyUYFjmMFm.jpg","genres":["Мультфильм","Приключения"],"overview":"Иcтopия о мaлeнькoм мaльчике пo имeни Meлвин.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"56631","ru":"Дональд Дак: Волшебное око","en":"The Eyes Have It","year":"1945","type":"Мультфильм","rating":5.7,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/nBiFBgSlnhmJkFfEmm2FEP15xVX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nb1q6mXLVh90v04VoGxkqnxXefX.jpg","genres":["Мультфильм","Комедия"],"overview":"Дональд изучает гипнотизм из книги и использует его на Плуто.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"605829","ru":"Принцесса Лебедь: Царство Музыки","en":"The Swan Princess: Kingdom of Music","year":"2019","type":"Мультфильм","rating":5.7,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/er8Cuc1topORWT2PI6latNQhSi8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q2JvhPl9WSUy02ZcnEIPhcrJi7u.jpg","genres":["Семейный","Мультфильм","Фэнтези","Музыка"],"overview":"Прекрасное королевство ждёт великий праздник с приближением дня рождения принцессы Алисы. По такому радостному случают принцесса Одетт решает провести музыкальный конкурс, победить которого получить возможность выступить на грандиозном праздничном балу в честь Алисы. На предстоящее мероприятие съезжаются лучшие таланты из разных уголков мира и каждый участник подготовил яркое выступление, способное в полной мере раскрыть всю красоту культуры своей родины.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"268689","ru":"Оз: Нашествие летающих обезьян","en":"Wicked Flying Monkeys","year":"2015","type":"Мультфильм","rating":5.7,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/jFXjoiype6DvaKZhQTbvh8mlmzI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9AHoyKsBKaQKIjR60ETU4xBceSI.jpg","genres":["Фэнтези","Мультфильм","Приключения"],"overview":"Вы помните, как все начиналось? Давным-давно в страну Оз прилетела юная героиня, ее звали Дороти, она смогла победить Коварную Ведьму Запада и добрая волшебница Глинда помогла ей вернуться домой. А друзья Дороти — Страшила, Железный Дровосек и Смелый Лев — стали правителями страны Оз. И все в волшебной стране было хорошо, пока Глинда по своей доброте не решила дать Коварной Ведьме Запада еще один шанс. Чары Злодейки поместили в метлу, а метлу передали Правителям. Но злая ведьма — есть злая ведьма, даже без своих чар… Знакомая с детства история, продолжение которой рассказывает маленькая летающая обезьянка, которая на самом деле не умеет летать и не хочет служить Коварной Ведьме Запада.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"129631","ru":"Entre deux soeurs","en":"Entre deux soeurs","year":"1991","type":"Мультфильм","rating":5.7,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/dn3fxBbgTuOUesB6vNFPnvvEUYe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gaOlDQ97AAHflcwXl2ufj5lR480.jpg","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"435995","ru":"Bunyan and Babe","en":"Bunyan and Babe","year":"2017","type":"Мультфильм","rating":5.7,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/1r3aKyYbIWZwzIRdMNO9EJFFUek.jpg","backdrop":"https://image.tmdb.org/t/p/w780/BiDHVlIs5Pm2uSqd2e2n7yT582.jpg","genres":["Приключения","Мультфильм","Комедия","Семейный","Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"152948","ru":"Новый Гулливер","en":"Новый Гулливер","year":"1935","type":"Мультфильм","rating":5.7,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/3PEVkNPqxWYDhdrYK6MeKHfH1EY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qH4Xtos5TFJOz7MGkqLLkIZ7fy1.jpg","genres":["Семейный","Фэнтези","Мультфильм"],"overview":"Школьника Петю в пионерском лагере «Артек» премировали книгой о путешествиях Гулливера. Зачитавшись, мальчик засыпает и видит себя на месте «великана», попавшего в страну лилипутов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"166556","ru":"Dizzy Dishes","en":"Dizzy Dishes","year":"1930","type":"Мультфильм","rating":5.7,"votes":19,"poster":"https://image.tmdb.org/t/p/w342/q9UY6Zo5ZffCNK2LqO0p9OUl9vD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8BIy6wvG5xKjbb0BOl9EguPSD43.jpg","genres":["Мультфильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"677561","ru":"Les Légendaires","en":"Les Légendaires","year":"2026","type":"Мультфильм","rating":5.7,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/AlfndBQucnWC7igEIG2L0sk6tiF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cjXBAjZodM1aVQm7wM9L8hOb88Y.jpg","genres":["Мультфильм","Боевик","Приключения","Комедия","Семейный","Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"221029","ru":"Томас и его друзья: Король железной дороги","en":"Thomas & Friends: King of the Railway","year":"2013","type":"Мультфильм","rating":5.7,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/jN7iYhjJSHy1aYVbkrCrdvSIBFA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qomFs72LTEojzuawZ9ZYKN71kLX.jpg","genres":["Мультфильм","Семейный"],"overview":"Новое незабываемое приключение бесстрашного паровозика Томаса! Томас и его друзья узнают, что сэр Роберт Норрэмби, граф Содора, возвращается на остров с большим сюрпризом. Все паровозы очень взволнованы из-за этого известия. А тем временем Томасу и его команде предстоит совершить множество подвигов — разгадать загадки прошлого, помочь новому другу, спасти старинный разрушенный замок и, возможно, даже отыскать сокровища!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"254187","ru":"Могучая Семёрка Стэна Ли","en":"Stan Lee's Mighty 7","year":"2014","type":"Мультфильм","rating":5.7,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/z73jtY4LhUyxovJR34GukSfzYa4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sw9pLTpbbevTr0Fo23c0BmQOPE2.jpg","genres":["Фантастика","Мультфильм","Семейный"],"overview":"Нанятому для создания комикса о новых супергероях Стэну Ли несказанно повезло: он встречает группу пришельцев с невероятными способностями. Теперь он учит их основам супергеройского ремесла, попутно укрывая от военных и пришельцев.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"595503","ru":"Супермонстры и пушистые друзья","en":"Super Monsters Furever Friends","year":"2019","type":"Мультфильм","rating":5.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/zOfUVqk9ZoVdpz6fhoYB9zcvaIi.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8p308NEIzAqTWHEdcuSFrA9RDHy.jpg","genres":["Фэнтези","Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"255518","ru":"The Life of Larry","en":"The Life of Larry","year":"1995","type":"Мультфильм","rating":5.7,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/7VJ4UvwQ72bBn3VKInxYoCzq6Sg.jpg","backdrop":"","genres":["Мультфильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"619954","ru":"4 сапога и барсук","en":"Knutsen & Ludvigsen 2 - Det store dyret","year":"2020","type":"Мультфильм","rating":5.7,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/dTR2qJ7fEBy7k23vVyfDLHbQxhH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3Ylixsn7UYajpPBnStk3GhEvPbN.jpg","genres":["Семейный","Приключения","Мультфильм"],"overview":"Знакомьтесь с самой веселой парочкой друзей на свете! Они привыкли уютно жить под землей, но однажды их выгоняют из собственного дома. Друзья не привыкли унывать и решают, что им точно смогут помочь… пираты! И как хорошо, что они знают одного! Веселый дуэт отправляется в незабываемое путешествие по тропическим пустыням, самым высоким в мире горам и доходят даже до Северного полюса, чтобы отыскать старого бандита и вместе с ним вернуть любимое жилище.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"150347","ru":"Месть снежной королевы","en":"The Snow Queen's Revenge","year":"1996","type":"Мультфильм","rating":5.7,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/pkAW8geq6L9ZrQLzIaTi9fDgfLz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/p3UK0GVQXIqMJj0MBlshjA7W0Hp.jpg","genres":["Семейный","Мультфильм"],"overview":"Снежная королева мечтает отомстить. Чтобы, наконец, избавиться от злой волшебницы, девочка опять отправляется в царство холода. В пути ей помогают огромная птица, маленький воробей и сказочный талисман, а в конце даже сама природа восстает против ледяной колдуньи...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"193650","ru":"Heathcliff: The Movie","en":"Heathcliff: The Movie","year":"1986","type":"Мультфильм","rating":5.7,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/vpLVLOPsJWbulXizq1GWVw5UuW6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6YQoaMlD0Ozx8YqzB9d48F2bNEB.jpg","genres":["Комедия","Семейный","Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"325589","ru":"The Blinkins: The Bear and the Blizzard","en":"The Blinkins: The Bear and the Blizzard","year":"1986","type":"Мультфильм","rating":5.7,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/rBCKANftlT0v7FT3g8Z2uTofdEZ.jpg","backdrop":"","genres":["Фэнтези","Мультфильм","Семейный","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"162702","ru":"Bosko Shipwrecked!","en":"Bosko Shipwrecked!","year":"1931","type":"Мультфильм","rating":5.7,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/s56JVzcz1BaeJUdNpBiCwPzrEeN.jpg","backdrop":"","genres":["Мультфильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"162581","ru":"Silly Scandals","en":"Silly Scandals","year":"1931","type":"Мультфильм","rating":5.7,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/lQNngDwFUiuP9gteKB0UQpfNkDO.jpg","backdrop":"","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"837763","ru":"Schirkoa: In Lies We Trust","en":"Schirkoa: In Lies We