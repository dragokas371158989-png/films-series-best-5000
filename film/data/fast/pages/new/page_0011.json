],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1684246","ru":"Нерассказанное: Великобритания. Винни Джонс","en":"Untold UK: Vinnie Jones","year":"2026","type":"Фильм","rating":6.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/AilC78z0a3wg0mBpBpurqjWCTxZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/29NF9iyZw2dztiKgV8r4dvHuTSx.jpg","genres":["История","Документальный"],"overview":"Это история взлета, падения и возвращения Винни Джонса вопреки всему –и красным карточкам– от одного из самых известных крутых парней футбола до обладателя Кубка Англии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1002109","ru":"Police Flash 80","en":"Police Flash 80","year":"2026","type":"Фильм","rating":6.8,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/2HD9MuSt5Fk6i7uAgI3m75VATjk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/83YBWW1sAtliSyejJ6880FJp1FI.jpg","genres":["Комедия","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1641962","ru":"Untold: Chess Mates","en":"Untold: Chess Mates","year":"2026","type":"Фильм","rating":6.8,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/oC68KgbyFiraKJRdUedQI9aXBF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8SEs6yUgrE5shU8tqXuR2MQIdlc.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1362786","ru":"Velhos Bandidos","en":"Velhos Bandidos","year":"2026","type":"Фильм","rating":6.8,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/eYZUzJMumKoUPX5Q40xBsgFs6dY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nqYTmfzyOSDVihUDnW0skBIFytp.jpg","genres":["Комедия","Боевик","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1376412","ru":"La Guerre des Prix","en":"La Guerre des Prix","year":"2026","type":"Фильм","rating":6.8,"votes":16,"poster":"https://image.tmdb.org/