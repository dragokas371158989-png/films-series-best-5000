/p/w342/8vVKTMM69CJkbxQUX6Iyyn9p1qL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k9czPrQB2r0n6x0yWuY1YAOe0NU.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"4341","ru":"Hey Hey It's Saturday","en":"Hey Hey It's Saturday","year":"1971","type":"Сериал","rating":8.2,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/bCbqPGcWm8Brz4s7rPJOXWduz9A.jpg","backdrop":"","genres":["Комедия","Семейный","Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"272715","ru":"Пара, созданная на небесах","en":"佳偶天成","year":"2026","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/vx4qAH1kt7WzqLoy5sGCZ7j0yEr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/caMAXpi8r9nc5aPkn0qkOBSMzn6.jpg","genres":["Драма","Фантастика"],"overview":"В эпоху Шэньинь глава клана Цзиньу, Цзинь Линь, распространил ложный божественный указ об истреблении демонов, и на них началась охота со стороны сект бессмертных. Весь демонический народ стал ждать появления Избранного, способного пройти через шесть великих испытаний и пробудить истинную силу своего рода. Спустя десять тысяч лет рождается Лу Цяньцяо, и у клана вновь появляется надежда. Синь Мэй, неопытная ученица главной секты бессмертных Тяньюань, случайно заключает духовный контракт с Лу Цяньцяо. Теперь им вместе предстоит пройти через шесть испытаний, преодолеть множество трудностей, раскрыть тайну духовного контракта, разоблачить коварный заговор и, в конце концов, восстановить равновесие между тремя мирами. На основе одноименного романа Ши Сы Лан.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"262339","ru":"あんぱん","en":"あんぱん","year":"2025","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/rhdmbSPCNCgSFLE0inOs8UWrpq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kcsp5iPAJyCsvWEpDpnulYK71FL.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"275586","ru":"อสงไขย","en":"อสงไขย","year":"2025","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/y01IGOl7RHZvr9LBiNFpI7IhhF6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2eTjUv1M4A01tJpHxcY40wHnUSu.jpg","genres":["Драма","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"2698","ru":"Tracey Takes On...","en":"Tracey Takes On...","year":"1996","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/e2WiBBPDS1vFeDdamFI34OMI9Bm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vDYBftnzYW6TBsbScigzS1pcDpq.jpg","genres":["Комедия"],"overview":"Эван Бакстер, которого всемогущий босс Брюс заставил лепетать всякую чушь во время прямого эфира новостей, уходит с работы на телевидении. Но жизнь его сразу же пошла в гору: он стал конгрессменом. И тут вновь появился Господь Бог, который открыл перед Эваном ужасы грядущего и попросил срочно приступить к строительству ковчега, беря пример с Ноя.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"72784","ru":"Живая вода","en":"Água Viva","year":"1980","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/rRV18bRXX1jOINBGnw4ivL2mvif.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7uPPoTExMdPy4QG149tnm9bdtQD.jpg","genres":["Мыльная опера","Драма"],"overview":"Действие происходит в Рио-де-Жанейро на стыке 70-80-х годов. В ней много солнца, моря, пляжей, она может служить прекрасным пособием по привычкам и модам той, уже далекой от нас эпохи. Среди основных линий сюжета — неустанный поиск родителей маленькой сиротки Марии Элены, попытки войти в высшее общество, которые предпринимает главная героиня, Лижия, финансовый упадок высокомерной злодейки Лурдес Мескита, эксцентричные выходки миллионерши Стеллы Симпсон, разлад в семье Эдира и Марсии, загадочное убийство Мигела Фрагонарда и история любви Маркоса и Жанет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"73048","ru":"SNL 코리아","en":"SNL 코리아","year":"2011","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/1feD9WnGOU19juCw79fACNmG7n4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6IRDbHm8eKNLDfPyAVyEzhLZgCn.jpg","genres":["Реалити-шоу","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"203125","ru":"甄嬛传(美版)","en":"甄嬛传(美版)","year":"2015","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dtofvlC0szN7r2xq8Dkb2csINn5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/55K62FLO1KM7xL9X5GunUbLWbPt.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"20885","ru":"Quatro por Quatro","en":"Quatro por Quatro","year":"1994","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/eF6rrVrGAfHSLgzAbiPqv7IzGPe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/Aa5UufGHmnxExspbocOWTW9IETN.jpg","genres":["Мыльная опера","Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"2147","ru":"The Torkelsons","en":"The Torkelsons","year":"1991","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/iJN1EczX0FiLy0H6JaWxbF1J7Uo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wRVB9wcaqdlNv3wuQGdPW0dF4j0.jpg","genres":["Комедия","Драма","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"34250","ru":"美味天王","en":"美味天王","year":"1997","type":"Сериал","rating":8.2,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/8VIe6FpoXh1kt0knKJMSEPihHkU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rLFx3POvj3ZuDMAlcMl8OGZ7VJ3.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"215508","ru":"Elas por Elas","en":"Elas por Elas",