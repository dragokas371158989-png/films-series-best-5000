2/7zWwsdY6BvB3jXDOOAKKQgY2VSF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eujU3vpBvZNOExepuL3ezTN9N5W.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"14555","ru":"Baantjer","en":"Baantjer","year":"1995","type":"Сериал","rating":6.9,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/5R9rzh0eaFWFCfVJt9JdLITpjKt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/itt9RwW7MLZpjeOVvbWT7PrcbcA.jpg","genres":["Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"4130","ru":"The Detectives","en":"The Detectives","year":"1993","type":"Сериал","rating":6.9,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/5JWALQsJZs23Tx36K8FGa1mnMfa.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dVo5MhmQ7XMcOOJN6s7oy0quxrE.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"15247","ru":"Κωνσταντίνου και Ελένης","en":"Κωνσταντίνου και Ελένης","year":"1998","type":"Сериал","rating":6.9,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/4mVrM70wTHEST7UmucdZBgoO6J8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tlsslmnPSJ73BluR9axcyObrkHM.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"4442","ru":"Братская любовь","en":"Brotherly Love","year":"1995","type":"Сериал","rating":6.9,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/6paGJlSIS1OX11LsmA1m6b4SbJt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j9w5Hq781dK2Y4QqwW65ivsAlEA.jpg","genres":["Комедия","Семейный"],"overview":"Давным-давно, жили-были два брата-авантюриста Уилл и Якоб Гримм, которые впоследствии стали знаменитыми сказочниками. Но до того они путешествовали по деревушкам, занимаясь собиранием фольклора и «прогоняя нечисть» за деньги… Приезжали в деревню, убеждали жителей, что на их мельнице поселилась ведьма, а потом — за вознаграждение — успешно «изгоняли» ее. В следующем селе это был тролль под мостом и так далее.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"11741","ru":"Темное правосудие","en":"Dark Justice","year":"1991","type":"Сериал","rating":6.9,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/iMJ86qVLmDMdTrGnvpdqnAJEzW0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g1J4Gogxz9LIBHxjOExlLdy3ipK.jpg","genres":["Криминал","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"3048","ru":"In the Night Garden","en":"In the Night Garden","year":"2007","type":"Сериал","rating":6.9,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/qD5xsX8aPNYHATq6f28WVQslpqq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wra1X7RoB9U51mQ4R5Ffg3hk1zx.jpg","genres":["Детский"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"95503","ru":"獣電戦隊キョウリュウジャー","en":"獣電戦隊キョウリュウジャー","year":"2013","type":"Сериал","rating":6.9,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/2MvXon7RIj3j2nO94ydGAXssdqZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1mkEozbN99hnd09ZgiIDbPFAfQD.jpg","genres":["Фантастика","Боевик","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1048","ru":"Час комедии от Колгейт","en":"The Colgate Comedy Hour","year":"1950","type":"Сериал","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/oWvIOn94vgsrius8HYTreQgJtjp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4QrmsUEZgIjzr64MpHprZYEChUN.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"4591","ru":"America's Test Kitchen","en":"America's Test Kitchen","year":"2001","type":"Сериал","rating":6.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/xfwzKRQSFTOjNeDHrPoyHxnSJDU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dXSZzDVE6bQ6Y8fwDRijYYaOrob.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"121876","ru":"花儿与少年","en":"花儿与少年","year":"2014","type":"Сериал","rating":6.9,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/s4WOcsEQ1pLjdKWEy7dcFDlWfI4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kIgzX0QdvK3vtaoHBpj9fUy7DP9.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"104716","ru":"乘风破浪的姐姐","en":"乘风破浪的姐姐","year":"2020","type":"Сериал","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/y3ZzkYM26UZ536SzQIhIcswtdGO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jfeLu7Mk2dy4nAsjS31qtH1N8Ki.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"35872","ru":"Die Pfefferkörner","en":"Die Pfefferkörner","year":"1999","type":"Сериал","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/7bOqE92Pef1cbnGARBYNns4bU7S.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tIsBePt0CmRD8FQwDxvaYUML89D.jpg","genres":["Боевик","Детский","Семейный","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"14955","ru":"POV","en":"POV","year":"1988","type":"Сериал","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/rJStW9J8LuB6alAA8t3YdRYkhkT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oYSwV11VTvtBJoaydKxqH9rGAwL.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"19416","ru":"医龍-Team Medical Dragon-","en":"医龍-Team Medical Dragon-","year":"2006","type":"Сериал","rating":6.9,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/aO20nHmTSXMwuQqFWVFlpPt3YiK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dZhRRU4qP3dia3p381QJ79sFKtt.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"131906","ru":"Первый и последний","en":"İlk ve Son","year":"2021","type":"Сериал","rating":6.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/8ClZtqwFnv5DWjeU47vA2gJ6V2q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uBQ21CAwrNQZQwzbGO161TJgVLx.jpg","genres":["Драма"],"overview":"Отношения Дениз и Барыша начались со страсти, которая, в итоге задушила обоих и привела к разрыву. Или же это рутина и быт погубили все? Анатомия отношений охватывает 14 лет жизни героев, препарируя и самые солнечные счастливые моменты, и самые мрачные и скучные.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"31372","ru":"Дом Анубиса","en":"Das Haus Anubis","year":"2009","type":"Сериал","rating":6.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/nywT1iwhgzO3U3110AnBgT37rkE.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6nhNTlSZvqbEifWtBmydqy34y3N.jpg","genres":["Детектив","Семейный","Драма"],"overview":"После того, как в пансионе Дом Анубиса происходят загадочные вещи, восемь подростков, которые там живут, пытаются докопаться до сути и со временем раскрывают темную тайну за стеной этого дома.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"15241","ru":"Дикая кошка","en":"Gata salvaje","year":"2002","type":"Сериал","rating":6.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/jxEDUPlaJJ20UzI0woepdfjdUBR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ccGzofFeU2C1Yer5REIV9kup82y.jpg","genres":["Драма","Мыльная опера"],"overview":"Луис Марио Арисменди, наследник семейного богатства, потерял жену в результате несчастного случая. В ее гибели было несколько странностей, которые не дают ему покоя. Он решает вернуться из Нью-Йорка на семейное ранчо, чтобы возродить бизнес, который терпит большие убытки. При посадке его самолет терпит крушение, и его спасает местная девушка — Росаура Риос. Она живет с отцом-алкоголиком и вынуждена работать целыми днями, чтобы прокормить семью. В знак благодарности за спасение Луис Марио целует девушку, но темпераментная Росаура царапает его лицо, получив прозвище Дикая Кошка.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"9279","ru":"ショムニ","en":"ショムニ","year":"1998","type":"Сериал","rating":6.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/esm94UBbjvR7HPZjFVQqlJsUUiY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7asHgfnYs757TSWftNwcQHI59BS.jpg","genres":["Комедия","Драма"],"overview":"Ужасно занятый на работе отец постоянно опаздывает на семейные мероприятия. После очередной неявки на выступление собственного сына по карате он обещает купить ему на Рождество суперигрушку — Турбомена и, естественно, в суете рождественских хлопот благополучно забывает об обещании. И вот начинается лихорадочная гонка за упомянутой игрушкой в самый последний день. Но уж больно много желающих, а игрушек осталось всего ничего.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"316296","ru":"Свободные женщины","en":"Le libere donne","year":"2026","type":"Сериал","rating":6.9,"votes":9,"poster":"https://image.tmdb.org/t/p/w342/6tHqAiAqadvSzXOoV9hpWDm45sb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o7TVX01ZfAJrJhpfbUFFfadh7Sr.jpg","genres":["Драма"],"overview":"Во время Второй мировой войны в женском психиатрическом госпитале Маггиано под Луккой работает неординарный врач-психиатр Марио Тобино. Только что вернувшись с фронта, он сталкивается с жестокой системой, где пациенток подавляют репрессивными методами вместо лечения, и решает бросить вызов этим порядкам, защищая достоинство и человечность женщин. Многие из них оказались за стенами клиники не из-за настоящей болезни, а за свободолюбие, непокорность мужьям или просто неудобство для общества того времени — и через их личные истории раскрывается тонкая грань между безумием и нормой, страстью и рассудком, конформизмом и жаждой свободы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"242722","ru":"श्रीमद् रामायण","en":"श्रीमद् रामायण","year":"2024","type":"Сериал","rating":6.9,"vot