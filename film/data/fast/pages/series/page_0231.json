/mjBfHS7YSi91EzVd0r2hgFlCF6K.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kdBDcLmlFfaEqyWw2BJxyjZDMMh.jpg","genres":["Драма"],"overview":"Студент медицинского университета Герберт Вест реанимирует мёртвых с помощью сыворотки, полученной в результате немыслимых экспериментов. Сосед Веста по комнате Дэн помогает приятелю в его страшном деле. Они начинают с кошки и добираются до трупов из университетского морга.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"320173","ru":"诱他失控","en":"诱他失控","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/4KcscById4tAHnBWqhCtaQGsnjH.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"290161","ru":"Charlotte Link - Einsame Nacht","en":"Charlotte Link - Einsame Nacht","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ju2kOGxrSoQxb2LlbatJP4Ay2Pq.jpg","backdrop":"","genres":["Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302591","ru":"怎敌她动人","en":"怎敌她动人","year":"2025","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/f4Z1HO838u4lDq1hiKULrSIYMrO.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"5822","ru":"SMAP×SMAP","en":"SMAP×SMAP","year":"1996","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/oXogyT6WvyLYVrxjJfiXKuBN1Ov.jpg","backdrop":"https://image.tmdb.org/t/p/w780/12OAXJqYazLGq70FJBv0IGjCHvY.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"99748","ru":"日向坂で会いましょう","en":"日向坂で会いましょう","year":"2019","type":"Сериал","rating":8.5,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/10JBHKcQkhO9upveCfrClhMEbeF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uSr2zmE9sMDiiLurYgp