rg/t/p/w780/uX843pVuqFIx1jHqJrMaHXYH6ax.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"32939","ru":"谢谢你曾经爱过我","en":"谢谢你曾经爱过我","year":"2007","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4BS6HTpRP66wodeIeMqqUdlYdPn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/de0ho9C9KhF8xqAAUGqe2Xo1BHQ.jpg","genres":["Драма","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"244710","ru":"Dixi","en":"Dixi","year":"2014","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rh446wIEhSEMwxzerBp3v8Yu8vD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kQ7pkULaEDPDfpjM6fcfPnT3GPl.jpg","genres":["Драма","Детский","Детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"218822","ru":"Судьба женщины","en":"Destino de mujer","year":"1997","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9zzevaCFn794ucrP7kPONLweIgs.jpg","backdrop":"","genres":["Мыльная опера","Драма"],"overview":"Будучи ребенком Виктор Мануэль Сантана пережил страшную трагедию. У него на глазах Альфредо Оропеза убил его отца и напал на Аврору, невесту его отца. Виктор Мануэль и его младший брат Луис Мигель тоже должны были погибнуть, но им удалось спастись. Виктора Мануэля усыновил и воспитал как своего сына коллега отца - Рамон Сантана, в Луиса Мигеля спасла служанка, спрятав малыша от жестокого ранчеро. Аврора, которую Альфредо изнасиловал, еле живая добралась до монастыря, где ее нашла старшая сестра, Лукресия. Сестра всю жизнь завидовала Авроре, а узнав, что Альфредо Оропеза возжелал ее, просто возненавидела - Лукресия сама мечтала стать женой богача. Лукресия убеждает несчастную Аврору, что она сама виновата в случившемся, помещает ее в психиатрическую лечебницу, а родившуюся через 9 месяцев девочку (дочь Альфредо) забирает и выдает за свою, вынуждая Альфредо женится на ней.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"152273","ru":"大世界","en":"大世界","year":"2016","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/ApMLjogoZFI8EHMEk8RwCyQzePT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fth53CSI8hLj1BpX6eDCYUi9sDu.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"130544","ru":"超級遊戲獎門人","en":"超級遊戲獎門人","year":"2010","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/avHVtYBNYu6xEMUmduSmEBx9uQ2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/h2IWbcStGeEXoDHW35vTCzzkwJz.jpg","genres":["Реалити-шоу","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"124312","ru":"父亲的身份","en":"父亲的身份","year":"2016","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xqcreuprxGh7v536SmF05YSqbjf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1s6XQn8Vq0mt4horoMsYHYLbxUb.jpg","genres":["Детектив","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"91910","ru":"レッドクロス～女たちの赤紙～","en":"レッドクロス～女たちの赤紙～","year":"2015","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/sxT2TN5ypzR3yXGQXhjZREdXG3B.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qzANwvc77oswx2MIeBkowfzWTWS.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"69554","ru":"แรงตะวัน","en":"แรงตะวัน","year":"2016","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/nWL3V7BBG7PDmTd6GsS1IRi5Uc5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/keRDO3ZIsycRU5XK8xK9UOlxYbS.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"133556","ru":"向世界出發 第二輯","en":"向世界出發 第二輯","year":"2007","type":"Сериал","rating":10.0,"votes":1,"