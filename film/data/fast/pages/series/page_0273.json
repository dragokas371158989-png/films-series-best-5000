g","backdrop":"https://image.tmdb.org/t/p/w780/lRLwQVesBiZ4Uk5HuslqyYWOcGA.jpg","genres":["Боевик","Криминал","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"39851","ru":"怒火街頭II","en":"怒火街頭II","year":"2012","type":"Сериал","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/nizDZcxFiAsU0K6QVg0a9B3LDcA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/CUid3bsKacOwyYYyMyICOoUNbb.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"18021","ru":"The DuPont Show with June Allyson","en":"The DuPont Show with June Allyson","year":"1959","type":"Сериал","rating":6.8,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/9ucAnc3yFX0zu4EKX4JMcq1Egzs.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"84134","ru":"Подруги моей жены","en":"ჩემი ცოლის დაქალები","year":"2012","type":"Сериал","rating":6.8,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/rnFIou3thkIg4VNRvMFgUFd5MEs.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hxaYFITblDSlDK6QGBXOszdKaj9.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"117910","ru":"Соединённые Штаты Ала","en":"United States of Al","year":"2021","type":"Сериал","rating":6.7,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/iE9STLu2DjxwM6TkOrszkfNS0hV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ghNrwkE0d8l2SaM8E3ASPLGr693.jpg","genres":["Комедия"],"overview":"Шоу рассказывает о дружбе между Райли, бывшим морским пехотинцем, ветераном боевых действий, изо всех сил пытающимся приспособиться к гражданской жизни в Огайо, и Авальмиром (Ал), афганским переводчиком, который служил со своим подразделением и только что прибыл, чтобы начать новую жизнь в Америке.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"120197","ru":"Канарейка","en":"Klangor","year":"2021","type":"Сериал","rating":6.7,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/O07VBa9xsa4Xuu8XvQJXHXw3QB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s6pOgJeKVPIdJL5PBw1LFbLcVI3.jpg","genres":["Драма","Детектив","Криминал"],"overview":"Таинственно исчезает подросток, дочь тюремного психолога. Отец в отчаянии начинает самостоятельные поиски. Драматическая ситуация, в которой оказалась его семья, углубляет кризис их взаимоотношений, непонимание, эмоциональную дистанцию и отсутствие связей. Тем временем вокруг этого дела нарастает заговор молчания.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"133358","ru":"Неспортивный интерес","en":"Bad Sport","year":"2021","type":"Сериал","rating":6.7,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/lst1t3sln5F7p2MsYwFevVNDOJV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qly4kClsaokKWiZYkSeWPZlw7Z.jpg","genres":["Документальный","Криминал"],"overview":"Шесть историй о крупномасштабных скандалах и реальных преступлениях в мире спорта, рассказанных спортсменами, тренерами и сотрудниками правоохранительных органов.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"224490","ru":"Los pacientes del doctor García","en":"Los pacientes del doctor García","year":"2023","type":"Сериал","rating":6.7,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/hk7hlsNxQUIgBF4qf442oUtVIk4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hYzfbfzsFRVtaCuumu0mFYtnZnE.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"66181","ru":"Не убей","en":"Non Uccidere","year":"2015","type":"Сериал","rating":6.7,"votes":29,"poster":"https://image.tmdb.org/t/p/w342/s0rQNhmb5mbpXpequlvOedDKubV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ufTDS6D4yYdOmKmHnYmRzagJ59.jpg","genres":["Драма","Детектив","Криминал"],"overview":"Валерия Ферро - инспектор отдела убийств полиции Турина. Вместе со своей верной командой она расследует сложные, запутанные, а порой и страшные преступления. Во всех делах женщина проявляет настойчивость, упорство и бесстрашие, желая докопаться до истинных мотивов и найти настоящих виновников, даже если кажется, что ответы на поверхности. Вместе с этим, её мучает прошлое - 17 лет назад её мать, Лючия, убила своего мужа и отца Валерии. Теперь Лючия выходит на свободу, и Валерия задаётся вопросом, а что же на самом деле случилось в тот злополучный день, когда её счастливая семья была навсегда разрушена?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"96161","ru":"Мы любили?","en":"우리, 사랑했을까","year":"2020","type":"Сериал","rating":6.7,"votes":28,"poster":"https://image.tmdb.org/t/p/w342/a0ftE8yyaWgqTAVlMu9TX0kMFVy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/j8O5jkzqo9zsL76ujJQqhoLsSjz.jpg","genres":["Комедия","Драма"],"overview":"Мать-одиночка и телепродюсер Но Э-джон последние 14 лет занималась ребёнком, делала карьеру и ни с кем не встречалась. Теперь она оказывается в запутанных отношениях с четырьмя мужчинами: загадочным писателем романов-бестселлеров, популярным актёром, бывшим бандитом, а ныне - топ-менеджером финансовой компании, и школьным учителем.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}