country":"","ageRating":""},{"id":"283119","ru":"深空彼岸","en":"深空彼岸","year":"2026","type":"Аниме","rating":9.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/bi3HXIWAzeXzs8ns9f1FVRwF1Zc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/n0oinZsZqtZ7ug8jtfS4J7Bt52L.jpg","genres":["Мультфильм","Боевик","Фантастика","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"115300","ru":"La Princesse du Nil","en":"La Princesse du Nil","year":"1999","type":"Аниме","rating":9.6,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/9xiAvfGHOHFsNYK4YG8nJlPdgGd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8PsBXHRXBHMQrxrZHK9PQuvvWbB.jpg","genres":["Боевик","Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"284760","ru":"Грёзы в бездне облаков","en":"云深不知梦","year":"2025","type":"Аниме","rating":9.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/jBxRPs5NKREMJca1KteUEt8Ohb1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2Gqh9N5fMOxbxe4Se4uuy3PUUzW.jpg","genres":["Мультфильм","Фантастика","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"242404","ru":"Baman Piderman","en":"Baman Piderman","year":"2009","type":"Аниме","rating":9.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/wrbqFg5sIkZBIrJihFxqflhinLw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8AVWO5kCgn8LmoAqqlUpVpfoO91.jpg","genres":["Комедия","Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"14149","ru":"Hot Wheels","en":"Hot Wheels","year":"1969","type":"Аниме","rating":9.5,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/n3m6S9qTAP1dICWRFm6lNXM4DUD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9is9bpVDtQ2pedEh1NX7dLqfr2O.jpg","genres":["Мультфильм","Боевик","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"265234","ru":"六样情——《黑神话：悟空》章节动画原版合集","en":"六样情——《黑神话：悟空》章节动画原版合集","year":"2024","type":"Аниме","rating":9.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/dxtaKRC7c8V09sme1XCoCUaQaWA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aWqvL2Y6rPtRRgb3S769ICic8N7.jpg","genres":["Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"124033","ru":"Scooby-Doo : Mission Environnement","en":"Scooby-Doo : Mission Environnement","year":"2021","type":"Аниме","rating":9.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/anBoHvBecPvSOCOIGZxckkZym8l.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fKNgd1imSzBQGPb6q4NTkkXtrCG.jpg","genres":["Мультфильм","Семейный","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"82216","ru":"La petite mort","en":"La petite mort","year":"2017","type":"Аниме","rating":9.5,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/9QhL0hOmJDbYtEEUU4VY29vJ9ke.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k0uN1wbpoEn6dOAGJguikS5S8pg.jpg","genres":["Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"66796","ru":"Uncovered","en":"Uncovered","year":"2016","type":"Аниме","rating":9.5,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/uErDstjtbJFmVdojch23zzzmsSv.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ocqm4sX70BjSQky61zfuMjNBEfi.jpg","genres":["Боевик","Мультфильм","Комедия","Драма","Детектив","Фантастика","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"122612","ru":"Владыка множества миров","en":"万界独尊","year":"2021","type":"Аниме","rating":9.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/l2Z8oW6lW4FhgWt2Uu2NQhaEVLK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jpTfQzXB7SpsiUrhL4hUbCZRrbu.jpg","genres":["Мультфильм","Драма","Боевик","Фантастика","Аниме"],"overview":"Для пробуждения высокоуровневого боевого духа меча он усердно совершенствовался целых восемь лет, но в тот день, когда королевский ранг боевого духа меча был пробуждён, Цзи Маньяо нанесла удар в спину, похитив боевой дух, из-за чего он едва не погиб, однако пробудил в своём теле родословную Феникса и стал хозяином Земли Захоронения Богов. Утратив боевой дух меча, он стал изгоем среди людей рода Линь и подвергся всяческим нападкам с их стороны, но, одолев Линь Юйхуна, он смог поменять отношение сородичей к себе, заставив их взглянуть на себя по-другому. Заручившись поддержкой младшей сестры Линь Сянэр и дедушки Линь Чжэньнаня, а также обретя новую силу Земли Захоронения Богов, Линь Фэн не пал духом и восстановил уверенность в себе. А впитав мощь сильнейших демонов и небожителей, захороненных в его новых владениях, Линь Фэн сумел возродить утраченный боевой дух меча, не только вернув свои былые силы, но и возвысив их на более высокий уровень.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"118651","ru":"枕刀歌","en":"枕刀歌","year":"2021","type":"Аниме","rating":9.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/oIidVveM86096NyrRUry3s2T2au.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8gimnNc75Hl0JIKTmeKyNvAMHj5.jpg","genres":["Мультфильм","Боевик","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"21268","ru":"Суперкукла Ликка-тян","en":"スーパードール★リカちゃん","year":"1998","type":"Аниме","rating":9.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/9W3DaZpUao0zRAblVXDb023GD53.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yxawooJ79SghD66O2kCcmbT1Dy7.jpg","genres":["Мультфильм","Комедия","Боевик","Драма","Семейный","Фантастика","Аниме"],"overview":"Ликка находится в серьезной опасности, как только она узнает, что она — принцесса Кукольного Королевства. Теперь, злой доктор Скарекроу крутится возле неё и её трона. Но бабушка Ликки призывает на помощь защитников королевского рода, известных как Куклы Рыцари.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"91613","ru":"Легенда о Серебряном Клыке","en":"銀牙伝説ウィード","year":"2005","type":"Аниме","rating":9.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/qRoO3GoLp3zuiBKjtFP1Sugg4KG.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fQs1GlpkJV9T17YlgIMPxzhZU7i.jpg","genres":["Мультфильм","Боевик","Аниме"],"overview":"14 лет назад отец Уида, Гин, основал Рай в Горах Уху, победив гигантского демонического медведя Акакабуто. Теперь и сам Уид должен спасти своего отца и вернуть Рай из лап злобного захватчика Хогена. Пока Уид путешествует в поисках союзников, он находит новых друзей. И пускай его армия намного меньше армии Хогена, она создана на дружбе и взаимопомощи, ведь её лидер — Уид, будущий Предводитель Гор Уху!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"99972","ru":"Домовёнок Кузя","en":"Домовёнок Кузя","year":"1984","type":"Аниме","rating":9.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/ooS48Efgz8G2wb5JC42Lk7XGBvt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vWoPMbW52Km06ZFARua6Ap3lPYp.jpg","genres":["Мультфильм","Детский","Комедия","Аниме"],"overview":"Серия мультфильмов о домовёнке Кузе. В нём рассказывается о вынужденном переезде Кузи из снесённого деревянного дома в городскую квартиру, куда переселилась семья девочки Наташи и дальнейших его приключениях. Сценарий написан по мотивам первой части сказки Татьяны Александровой «Кузька в новой квартире».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"42891","ru":"吉永さん家のガーゴイル","en":"吉永さん家のガーゴイル","year":"2006","type":"Аниме","rating":9.5,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/gcplxwfC69HDJ4mOHu2QBhpNdln.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7rqOiQ6S9pnU6SOIRNpwGxzyi0K.jpg","genres":["Мультфильм","Комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"105075","ru":"风灵玉秀","en":"风灵玉秀","year":"2017","type":"Аниме","rating":9.5,"votes":4,"