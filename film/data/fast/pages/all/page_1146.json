erview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"336045","ru":"Krüger aus Almanya","en":"Krüger aus Almanya","year":"2015","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/qhu5ipUTA6pj3UXK51f6zhXWc0z.jpg","backdrop":"","genres":["Телевизионный фильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"293443","ru":"Bota","en":"Bota","year":"2014","type":"Фильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/mblQ22hDZas0h2JLe1zk8ktCQq7.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"209894","ru":"The Secret of Mulan","en":"The Secret of Mulan","year":"1998","type":"Мультфильм","rating":6.1,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/mvxFWTRNnkQVcMwbCZpEdJGxVRK.jpg","backdrop":"","genres":["Семейный","Мультфильм","Приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1162337","ru":"Голубоглазая","en":"Blue Eyed Girl","year":"2025","type":"Фильм","rating":6.1,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/eznMwD1AyNK4fAqhKnAdQFoJWgm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hueKlPQoDeJ4hXlyDYD9fRktCzy.jpg","genres":["Драма","Комедия","Мелодрама"],"overview":"Джейн вынуждена бросить все дела и вернуться в родной город, потому что её отец попал в больницу. Вдали от семьи ей придётся переосмыслить свою жизнь, задуматься о том, как всё могло бы сложиться и сделать непростой выбор. Забавная и надрывная история о взрослении уже взрослых людей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"914383","ru":"Нова","en":"Nova","year":"2022","type":"Фильм","rating":6.1,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/i1N5oZWEzzxJooRUJ9k3WU6lcnx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iPY78XlZNsFzFPUq0Hx3EMH3x7Q.jpg","genres":["Фантастика","Драма"],"overview":"Во время полёта на космическом корабле к Марсу андроид Нова оказывается поставленной перед выбором между своими товарищами по команде, когда вспыхивает мятеж андроидов. Она вынуждена выбрать одну из сторон - людей или себе подобных.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1214077","ru":"Пираты галактики Барракуда","en":"Пираты галактики Барракуда","year":"2024","type":"Фильм","rating":6.1,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/sYOKMK0fjKSw9zfzyxqSdAkP2sc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9kkiPaSZ7kDzw2MhHcrOao6odPz.jpg","genres":["Приключения","Фантастика"],"overview":"Космический пират из далекой галактики Барракуда, сосланный на Землю, принимает облик земного школьника Мити и начинает осваивать незнакомую планету, поражая землян своими сверхспособностями. Митя-пришелец знакомится с девочкой Кристиной и ее одноклассником Колей. Он просит ребят о помощи, чтобы добраться до портала, из которого он мог бы послать сигнал своему экипажу. Кристина и Коля, охваченные любопытством, отправляются с Митей в необычное путешествие с фантастическими перемещениями в пространстве… Подросткам предстоит ненадолго побывать взрослыми, вступить в сражение с тремя зловещими старушками, которые оказываются на поверку Пиратами Теней, посетить замаскированный под деревенскую избу космический корабль и пройти еще немало испытаний, чтобы спасти Землю от катастрофы и понять, что такое настоящая дружба.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1282448","ru":"Kemah Terlarang: Kesurupan Massal","en":"Kemah Terlarang: Kesurupan Massal","year":"2024","type":"Фильм","rating":6.1,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/xsKvu7FPLcYUulsBPhBDYknlnRX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jKZSi2z0zbASvPG1N32MNROZ8Bd.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}