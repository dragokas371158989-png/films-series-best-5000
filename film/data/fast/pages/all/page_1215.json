ота Пету.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"360570","ru":"until You come to me.","en":"until You come to me.","year":"2014","type":"Аниме","rating":5.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/2hBErQVr6DElIrmZCLOZ7ZsG1Zy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mlvhCMnfczvAUnxtrFDdQQ58GYZ.jpg","genres":["Музыка","Фантастика","Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"870144","ru":"어쩌면 우린 헤어졌는지 모른다","en":"어쩌면 우린 헤어졌는지 모른다","year":"2023","type":"Фильм","rating":5.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/lWltivkNDGtZDrC1QANBkxe5M2a.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7OF6rGrUizVSCc0Tryk8FHOvQRQ.jpg","genres":["Мелодрама","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1021760","ru":"சொப்பன சுந்தரி","en":"சொப்பன சுந்தரி","year":"2023","type":"Фильм","rating":5.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/10gtxHmaHbalVVwCbQggJfK1V6F.jpg","backdrop":"https://image.tmdb.org/t/p/w780/c7jH1FT8cHWMT1W08xPgm7rKEs4.jpg","genres":["Комедия","Триллер","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"675791","ru":"പാപം ചെയ്യാത്തവർ കല്ലെറിയട്ടെ","en":"പാപം ചെയ്യാത്തവർ കല്ലെറിയട്ടെ","year":"2020","type":"Фильм","rating":5.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/uRCVYrnZjuSo1QDYmxxLSHC2Xq0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q1nNKaccGqYuqKNBUDElIibn3Bw.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1186680","ru":"Secrets in the Desert","en":"Secrets in the Desert","year":"2023","type":"Фильм","rating":5.6,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/wj4pbXWeZmWzKfcmxtpvjBrJo3x.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8hRdYk7sxPZ07Gpwjz9JABnSwnE.jpg","genres":["Триллер","Телевизионный фил