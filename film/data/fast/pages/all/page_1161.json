2/4HpwLXjfR6I1qizKjIgEPUuwHJy.jpg","backdrop":"","genres":["Мультфильм","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"271026","ru":"Брак по расчёту эпохи Тайсё: Невеста на замену и яростная любовь солдата","en":"大正偽りブラヰダル～身代わり花嫁と軍服の猛愛","year":"2024","type":"Аниме","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/adLuRUaIzy44nUExYjUix2ZKjqM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/qufxxfV9nETAPa115FhwNw9qn7w.jpg","genres":["Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"315816","ru":"茉莉花ちゃんの好感度はぶっ壊れている","en":"茉莉花ちゃんの好感度はぶっ壊れている","year":"2026","type":"Аниме","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/A8dwD5GUUGgCXjTxuSWWGM6g6u1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fxkcclraLCONUZEJLylKACAgRdt.jpg","genres":["Мультфильм","Комедия","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"243345","ru":"最強王図鑑","en":"最強王図鑑","year":"2024","type":"Аниме","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/oIGB3b02IBEyvmdufZcKeVSSKIW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5dHlcO08j6N4DRofVtVewqwnGcx.jpg","genres":["Мультфильм","Боевик","Детский","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"312395","ru":"史上最强炼体老祖","en":"史上最强炼体老祖","year":"2026","type":"Аниме","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/2gAQ6XDGAZC6AkbtBljKEVF1PNS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jFnCVHhiY4xuEIzJFt08ESR4Qdx.jpg","genres":["Мультфильм","Боевик","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"34069","ru":"Полифоника","en":"神曲奏界ポリフォニカ","year":"2007","type":"Аниме","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/fHfSrNasaR29VZUxJHxse70OkcS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q19Dtn3Ts55Z8Cjpa07bZQPrfnW.jpg","genres":["Мультфильм","Боевик","Фантастика","Аниме"],"overview":"Люди полагаются на чудеса духов, а духи, которые появились в этом мире, живут благодаря музыке, которую играют люди. Большинство духов обычно не могут появиться, но некоторые обладают достаточным количеством сил, чтобы материализоваться в образе людей или животных и жить в мире вместе с людьми. Силы духов направляют Дэнтисты (Не путать с Дантистами!=) ), играющие особую музыку, которая называется \"Коммандия\". С помощью этой музыки люди могут заключать контракты с духами, такие люди пользуются уважением. Это - история зарождающейся любви между духом Контикарте и начинающем Дэнтистом, Фороном, который живёт на континенте Полифоника - месте, где люди и духи живут вместе в гармонии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1665092","ru":"Пожиратель звёзд: Битва на Изначальной звезде","en":"吞噬星空剧场版：决战原始星","year":"2026","type":"Мультфильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/rS0kKvGiffJyMx8emO6sDiyxccj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tKHaRVudYbGlO78UrjkWUtguB8N.jpg","genres":["Мультфильм","Приключения","Фантастика"],"overview":"Во время обучения на Изначальной Звезде Ло Фэн сталкивается с алчностью и окружением инопланетных рас. Он использует свою мудрость и силу, чтобы поменяться ролями и поддержать достоинство человечества. \"У меня есть клинок, который может расколоть вселенную!\" Этот потрясающе красивый боевой клинок сопровождает Ло Фэна, когда он прокладывает себе путь по миру! Расы Демонов, Механиков и Насекомых появляются вновь, образуя альянс из трех рас. Лидеры трех рас вместе с 6000 почитателями Вселенной осаждают Ло Фэна. Ло Фэн высвобождает мощную силу \"Я есмь Вселенная\", чтобы уничтожить их одним махом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1066661","ru":"Овчарка Рой","en":"Susikoira Roi","year":"2023","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/wL5UfG3oyA6mZqc4HTjcMV9jFEV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uJmR40A9BgzL8kU3C7YOtcAkAKg.jpg","genres":["Приключения","Семейный"],"overview":"Недавно переехав в новый город, Вало подвергается издевательствам, а также страдает от одиночества. Все меняется, когда она спасает брошенную немецкую овчарку, оставленную умирать. Вало дружит с собакой и называет ее Рой. Когда пропадает соседский мальчик, друзья вместе с Роем отправляются на поиски разгадки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1061794","ru":"Шевели перьями!","en":"Orzełek Iggy","year":"2026","type":"Мультфильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/3HEFncI4ejN2OM4J7bDoT53Ya5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2A51MovXoi6atL6kmTVDv4bowQO.jpg","genres":["Мультфильм","Семейный","Приключения","Фантастика","Фэнтези"],"overview":"Каждую ночь юному орлу по имени Игги снится один и тот же сон — он парит в небе свободно и легко. Но наяву его мир совсем иной: это высокоразвитое общество птиц, настолько цивилизованное и благоустроенное, что его обитатели совсем разучились летать. Все меняется, когда Игги встречает свою новую одноклассницу Ив, без ума влюбленную в авиацию. Вдохновленный ее увлечением, он наконец обретает смелость взглянуть в глаза собственной мечте — и впервые в жизни расправить крылья.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1512207","ru":"Несси. Чудище из Лохх-Несс","en":"Ruffen: Sjøormen som ikke kunne svømme","year":"2025","type":"Мультфильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/aRABQZDGy1aM4HOs0su01BsbmQH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mH7bfSIQelApYiTlefB8rKNJ81J.jpg","genres":["Мультфильм","Семейный"],"overview":"На затерянном в океане острове живёт маленькое чудовище Руфус. Он мечтает о приключениях, но не умеет плавать, вызывая смех у сородичей. Главная забота обитателей водного оазиса — спрятаться от нежелательного внимания человека. Мудрый дядя Лудвиг, потомок китайского дракона, умеет выпускать туман из ноздрей, скрывая остров от проходящих судов. Однажды Лудвиг тяжело заболевает. Чтобы спасти остров, кто-то должен отправиться в Шотландию к тётушке Несси из Лох-Несса. Руфус вызывается выполнить миссию, которая поможет ему справиться со своими страхами и встретить новых друзей.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"705990","ru":"Забери меня домой","en":"담쟁이","year":"2020","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/qSvpuXySS85utsCaIUYngh3PYD5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8JKSzVjGewevLZKhQP4rNugr1Dt.jpg","genres":["Драма","Мелодрама"],"overview":"После потери памяти в результате автомобильной аварии Тан пытается вспомнить, кто он и откуда. В конце концов он находит данные, которые приводят его в родной дом. Но чем больше он узнает свою семью, тем больше секретов ему открывается.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1468698","ru":"Король и Шут. Навсегда","en":"Король и Шут. Навсегда","year":"2026","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/yIO2EOrFM1rV0o8JcBK1rMaq4OS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gidP1ptNth1Jcc9GaVlfhK9VHdC.jpg","genres":["Драма","Комедия","Фэнтези","Приключения"],"overview":"Панк-вселенной «Короля и Шута» грозит гибель. Сказочный мир рушится под поступью мертвецов, воскрешенных безумным Некромантом. Одолеть злодея не дано никому, кроме его создателей — друзей, разделенных смертью… Горшка и Князя.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1248881","ru":"Мама нестандартного мышления","en":"Mãe Fora da Caixa","year":"2025","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/5U7zOlb4nxt03c4rX8yhX9BQH38.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bNhPalCCDcphYByw3NaZ0pGTvAg.jpg","genres":["Драма","Комедия"],"overview":"Ману - успешная женщина, которая считает, что у нее все и всегда под контролем, но рождение дочки все меняет. Теперь ей и её мужу предстоит столкнуться с сомнениями и трудностями родительства в легкой, юмористической картине жизни молодой семьи.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1535434","ru":"Нет места лучше Рождества","en":"There's No Place Like Christmas","year":"2025","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/xAX9IcN1MaUS7aSTnAuqfC5juMj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eCcf4QaCyf9QlyFFyusnWQYBjgt.jpg","genres":["Телевизионный фильм","Комедия","Мелодрама"],"overview":"Успешная риелторша возвращается домой в пригород, чтобы поддержать семейный бизнес в разгар сезона. Её планы по возвращению в город осложняются, когда она встречает обворожительного фотографа, который заставляет её пересмотреть жизненные приоритеты.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1386052","ru":"Ограбление по-волшебному","en":"Magik Rompak","year":"2025","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cbTPVx1TtYpSGkaMBa5fnQC3utV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iH2RcQ5ODBH2iYYzPpYHBVpiiG0.jpg","genres":["Боевик","Криминал","Триллер"],"overview":"Опытный фокусник набирает команду из самых разношёстных людей для дерзкого ограбления, чтобы завладеть драгоценным камнем. Пока они разбираются в своих переплетенных историях и растущих ставках, им приходится справляться с обманом и противостоять уязвимостям.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"704235","ru":"Охотник на тигров","en":"伏虎武松","year":"2021","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/7cghkTg4TUef1dVwHH7aFHuFAEP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2EJ4gYFhBE2Nu8EJNgAlpEOuWd9.jpg","genres":["Боевик"],"overview":"70-е годы. Молодой человек из Индии переезжает в Чикаго в надежде стать инженером. Когда с работой все идет наперекосяк, он решает с помощью своих друзей-неудачников завоевать сердце девушки, в которую влюблен с самого детства.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"833033","ru":"Сказка о глухом и волшебной музыке","en":"Сказка о глухом и волшебной музыке","year":"2021","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/77nHi5ILTXzODwuMGPkCIWHNiQz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/84BgsUe2FnZ3k4u63xTKj2EeT1B.jpg","genres":["Ужасы"],"overview":"Однажды в убогий кабак заявляется загадочный шарманщик и начинает играть чарующую музыку. Даже слишком чарующую.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"869404","ru":"Косолапый агент","en":"贝肯熊2：金牌特工","year":"2021","type":"Мультфильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/oYfDu4bD5wMp3OgQtL41B0VbNox.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aarZWyq9OBTZ9XX2jnBzMopLh9I.jpg","genres":["Мультфильм"],"overview":"Бернард — обладатель суперчипа, который мечтает стать агентом высшего уровня. Но Секретная служба не решается поручать миссии косолапому белому медведю. Решив доказать свою состоятельность, Бернард отправляется на задание, но теряет свой чип и лишается сверхспособностей, став обычным белым медведем. Он встречает маленькую нерпу, они становятся друзьями и вместе отправляются в приключение, чтобы вернуть утрату. Однако всё складывается не так гладко, как надеялся Бернард. Вместе с нерпой они избегают преследования Секретной службы, проходят испытания и сталкиваются со злоумышленниками, завладевшими чипом. Пройдя через невзгоды, благодаря поддержке друга, Бернард обретает свои способности и понимает истинное значение профессии секретного агента.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"895542","ru":"Три кота и море приключений","en":"Три кота и море приключений","year":"2022","type":"Мультфильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/3D5ZI41evwNoFimaBQ9VPqBNHMr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aI7vu0lhoMii5j0Pq32yrbmHOP8.jpg","genres":["Мультфильм"],"overview":"Коржик, Карамелька и Компот вместе с родителями они отправляются отдыхать на морской курорт, где их ждут яркие события, полные весёлой суматохи и встреч с новыми друзьями.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"131895","ru":"灵魂摆渡之南洋传说","en":"灵魂摆渡之南洋传说","year":"2021","type":"Сериал","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cAcY5Sxo7rGSpKMiUWv1QqxJ6uu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mCAuSnkBKM9Glu1U1XsgnbM3anW.jpg","genres":["Детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1487604","ru":"La casaca de Dios","en":"La casaca de Dios","year":"2026","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/v56hSpcEnS0joV9lUn9bKpPdktl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ewUVE6exfcs1dqC6PGWApTV3oVl.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"927611","ru":"위험한 관계: 교수와 여대생","en":"위험한 관계: 교수와 여대생","year":"2021","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/3nkTc0zJlzB6oZoOGC89UFm2yW0.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7hpjuCnhkzfInT9INo8WDCLYq6s.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"878667","ru":"ਚਲ ਮੇਰਾ ਪੁੱਟ 3","en":"ਚਲ ਮੇਰਾ ਪੁੱਟ 3","year":"2021","type":"Фильм","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/vhlwENeB4bDPl1YeSiPLNfDAJnz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5IwrHiXMeKxOLZnkmMa116xGya4.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"320685","ru":"കസിൻസ് & കല്യാണംസ്","en":"കസിൻസ് & കല്യാണംസ്","year":"2026","type":"Сериал","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/cEfHZNS071Qa0ycrUhySEjRdXXB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cEfpO6QG5Ks5cTJ8bRrZJiDYKUH.jpg","genres":["Комедия","Семейный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"129236","ru":"나는 SOLO","en":"나는 SOLO","year":"2021","type":"Сериал","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/ee5oS2TMiImM4m1rYTn1GpnCLTZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yvbjXEtrlCDR112SYupgi2qOIvZ.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"294462","ru":"贤婿","en":"贤婿","year":"2025","type":"Сериал","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/j3JoXq5jdJZ7Dblb79l50KMK8Gk.jpg","backdrop":"https://image.tmdb.org/t/p/w780/l5aIu2D3uIMnoiMIUf3J3AfFaQq.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"131777","ru":"嗨放派","en":"嗨放派","year":"2021","type":"Сериал","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/wYUMn59dQH2caDhDeMhy4C7F3wQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3xwtEZ3zJYnCWHtVOJwFuevjg0H.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"218776","ru":"Juego de ilusiones","en":"Juego de ilusiones","year":"2023","type":"Сериал","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w342/9gvZrKujFwnF3DJzmIKT3BFxLb8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e2R0uOxllMoC316JaM8zPz6C4SV.jpg","genres":["Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"204201","ru":"오은영 리포트 - 결혼지옥","en":"오은영 리포트 - 결혼지옥","year":"2022","type":"Сериал","rating":6.0,"votes":2,"poster":"https://image.tmdb.org/t/p/w