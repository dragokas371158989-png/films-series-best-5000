слами. Однако, в бесконечной череде ее фаворитов встречались и незаурядные фигуры, страстные патриоты. Они дерзко вторгались в Большую Политику, управляя не только коронованной любовницей, но и всем российским государством. Среди таких людей первое место принадлежит князю Потёмкину. Фильм снят по мотивам знаменитого одноименного романа Валентина Пикуля.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1651570","ru":"15 Days: The Real Story of America's Pandemic School Closures","en":"15 Days: The Real Story of America's Pandemic School Closures","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/eMKf2NFZ00AJk4pxtjlEF8ajAUf.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1563788","ru":"LEGEND: The Complete Story of Larry Bird","en":"LEGEND: The Complete Story of Larry Bird","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/kVjApz78CLEndp7fMkt9a1TqnJn.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1515006","ru":"Love Left the Masquerade: Peter Medak's Cinema of Pretenders","en":"Love Left the Masquerade: Peter Medak's Cinema of Pretenders","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/txcaG74yXkARQ8QbMkHt2R58wbI.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1511836","ru":"W kałuży","en":"W kałuży","year":"2022","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/pXQyw9MdOu6xO6wAiO0hErVUqge.jpg","backdrop":"","genres":["Триллер","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1491213","ru":"Wisteria","en":"Wisteria","year":"2025","type":"Фильм","rating"