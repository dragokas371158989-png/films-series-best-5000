apdFeqeXvhBMQpteRvf550fBQ.jpg","backdrop":"","genres":["Мыльная опера"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"225683","ru":"위클위클 홀리데이","en":"위클위클 홀리데이","year":"2023","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lzWszm7XjbDmihyNwAv3UXBVwpw.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"215571","ru":"Jonas' Jul","en":"Jonas' Jul","year":"2022","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/rEOhnwfXppR2adNW8QkHfAsuGHr.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1151566","ru":"Earthquake Wars","en":"Earthquake Wars","year":"2022","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/robW2bmNBIUqPgz62HT8R0ALhZh.jpg","backdrop":"","genres":["Комедия","Боевик","Приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1444274","ru":"Аркадий Райкин","en":"Аркадий Райкин","year":"1975","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/bmSEY0oaOU6GoK6RhK3FdkeJF33.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cQt6z9BJ61K5GaCOVkhVbx7rTWS.jpg","genres":["Документальный"],"overview":"О творчестве советского актера и режиссера эстрады, народного артиста СССР Аркадия Исааковича Райкина.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"200713","ru":"我在市場待了一整天","en":"我在市場待了一整天","year":"2019","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/l6TRysbyDZx4AfWdB7Zrgrgo6QZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eJLJMHqbQXpqBiecEM35cpAZRpf.jpg","genres":["Документальный"],"overview":"Ариана — судья, трудоголик и блондинка с высокими моральными принципами. Никаких мужчин. Никакой семьи. Никаких детей. Только работа, только закон. Кошмарная новость — и конец идиллии — она беременна! «Этого не может быть!» — кричит Ариана, начиная расследование самого невероятного дела в своей жизни! Распутать его отчаянно мешают собственные принципы и знаменитый вор. Но нарушить закон Ариане все же придется. И лучше бы ей не знать, что же на самом деле произошло!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"90636","ru":"Амур: Амазонка Азии","en":"Amur: Asiens Amazonas","year":"2015","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/6fF4CEFkhwx2owEy2sfG2opvCOd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jWYwujMTWWSqG9X9CP3CAo75Eqt.jpg","genres":["Документальный"],"overview":"Эта серия из трех частей представляет собой эпическое путешествие, посвященное открытию мира богатой дикой природы вдоль Амура и его притоков, а также коренных жителей, населяющих величайшую из оставшихся на Земле диких территорий — удивительный и экзотический мир, формируемый и постоянно изменяемый экстремальными силами атмосферы и одной из самых активных тектонических зон Земли. В трех сериях представлены уникальные персонажи нижнего, среднего и верхнего течения Амура — отдельных миров, которые не могут быть более разными и разнообразными.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"79398","ru":"Один в поле воин","en":"Один в поле воин","year":"2018","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/gkp304xe9xrRotjAuVxCrhKiq1P.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pU6p7gc3zbRdep8tbXlb0IZ8C9u.jpg","genres":["Драма","Война и политика"],"overview":"В разгар войны группа красноармейцев попадает под трибунал. Их увозят из части, но по дороге солдаты попадают в засаду. В живых остается лишь Иван, осужденный за «самоволку». Парню удается незаметно сбежать и вернуться в свою часть, уже занятую противником. Досконально зная местность, он наносит немцам существенный урон, при этом не выдавая себя. Вскоре фашисты догадываются, что в расположении прячется диверсант. После неравной битвы Ивану удается скрыться, но немцы преследуют солдата, куда бы тот ни отправился. Бесстрашный боец еще не знает, что ему придется вступить в кровавую схватку с элитным отрядом SS, и помочь ему смогут лишь родные стены…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"14068","ru":"Jigsaw","en":"Jigsaw","year":"1979","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/o7IXdsiwtGJkkE0CdV2VUadHlLL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zn36HuKLCGEUNBUOLZTjx0E3VBQ.jpg","genres":["Комедия"],"overview":"В городе обнаруживают несколько тел, обладатели которых встретили определенно не лучший конец. Все улики указывают на одного человека: Джона Крамера. Но как это возможно? Человек, известный как Пила, мертв уже более десяти лет. Неужели все-таки нашелся тот, кто рискнул подобрать мантию жестокого маньяка?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1609393","ru":"『HUNTER×HUNTER』THE STAGE 3","en":"『HUNTER×HUNTER』THE STAGE 3","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/j2gnn0P2w9x6cFtQurIUdZrFGYN.jpg","backdrop":"","genres":["Боевик","Приключения","Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1599415","ru":"Tangled: Plus Est En Vous","en":"Tangled: Plus Est En Vous","year":"2020","type":"Мультфильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/tyK7Ve49enr9VMY1MHhJ2lNJ5j1.jpg","backdrop":"","genres":["Мультфильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1520583","ru":"백! 스테이지","en":"백! 스테이지","year":"2025","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/pLmEfJPjGrZXzzZfcHUtOMIm5DA.jpg","backdrop":"","genres":["Музыка","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country