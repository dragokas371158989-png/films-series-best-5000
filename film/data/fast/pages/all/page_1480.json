 поколению вот уже семьсот лет. Съемки проекта проходят в исторических местах, сохранивших наследие Андрея Рублева — от фресок во Владимире до икон Свято-Троицкой Сергиевой лавры.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"298660","ru":"Het Complot","en":"Het Complot","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/6b8SQVAnAhRQXlyGLShefUP2GtR.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ujaDj3DMVLEKosUgBp67EaNsH6l.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"301226","ru":"Le Club","en":"Le Club","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/9s7o67lnuMpHo1td2IUPCMxb6JS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/afrbNV5bDU5CgH1bXcDZpbdw350.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"302405","ru":"이영애의 추적 60분","en":"이영애의 추적 60분","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/cUOf5hbqt00Nd8oRCItjvoM2ZdC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7gKtIAOjEfz2dKteyyYfAPd9YVh.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"300614","ru":"LA question","en":"LA question","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/gc2hrIzMHhScxmFUsuSmuDLZD2U.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2YZ76WitxiYuskRiSxwKRy0UlC4.jpg","genres":["Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"300219","ru":"Tesoro O Cacharro","en":"Tesoro O Cacharro","year":"2025","type":"Сериал","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/eaDe5Hyxrc8l0aR1i2xiVnHnjW1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/d7IHfdjCRiTwFYzS9oBnzQpCcAA.jpg","genres":[],"overview":"