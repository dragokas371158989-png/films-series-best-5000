м, распущенность, безволие, утрата идеалов и неверие в будущее. Буфетчица Института Вика влюбляется в молодого коммуниста, хотя его увлечение евгеникой и склонность к насилию ее пугают. Вика надеется, что ее страсть и нежность смягчат Максима, в то время как сотрудники госбезопасности внимательно наблюдают за развитием их отношений.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1292645","ru":"Kuncen","en":"Kuncen","year":"2025","type":"Фильм","rating":2.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/8XFnCNU1SIa100lI3bM7QDLPTEZ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fYzx71N672tRYoXY7j0IRB3kbFG.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1269348","ru":"Himalaya","en":"Himalaya","year":"2024","type":"Фильм","rating":2.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/hz2k64LF7kr2bELAxwJNR5W94Q2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kprLXspGi9CPUZyXSuNI4b6MKkO.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"620036","ru":"La visita","en":"La visita","year":"2021","type":"Фильм","rating":2.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/w2Pv2KEtbGNkiPitDZrncQmdNzS.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s2kerlPQUQos4REFUZvdWqdQJW2.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1123521","ru":"Donyale Luna: Supermodel","en":"Donyale Luna: Supermodel","year":"2023","type":"Фильм","rating":2.8,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/31WMu6vpHqsUj7MqimCtzrvJepK.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ehdx05IoFvgZBjtfx3XzkYBXdp9.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"90648","ru":"Телевизионный сад ZDF","en":"ZDF-Fernsehgarten","year":"1986","type":"Сериал","rating":2.8,"votes":5,"poster":"