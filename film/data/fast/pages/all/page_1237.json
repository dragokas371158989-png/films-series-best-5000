дят в старом доме таинственное зеркало.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1255515","ru":"Не парковаться","en":"주차금지","year":"2025","type":"Фильм","rating":5.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/xSQi0BIomoftpAyEX9IWK51TJPf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6DG104qdL8OGuX4yEJyqbCwuom7.jpg","genres":["Криминал","Триллер","Ужасы"],"overview":"Из-за постоянного стресса на работе Ён Хи не выдерживает и вступает в перепалку со случайным гражданином на парковке, что приводит к непредсказуемым последствиям.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1302001","ru":"Top 1","en":"Top 1","year":"2024","type":"Фильм","rating":5.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/sZClSMTj4T2oAfwW1y5XGzjWMua.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xP628CfuH0JDQ2Zb8OaYjVwKBCj.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1058833","ru":"Khanzab","en":"Khanzab","year":"2023","type":"Фильм","rating":5.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/jsD9Xno9bCaDtGm6Av9yr4T5SUq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2RbqB3A9RLfdwP8sdKjKZWa4KiO.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1311379","ru":"Los futbolísimos 2 y el misterio del tesoro pirata","en":"Los futbolísimos 2 y el misterio del tesoro pirata","year":"2025","type":"Фильм","rating":5.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/8J6M4gMxvFiQUq2j8eRIfRzAoiN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m829vJABXj21CGIIiVhy74BWRim.jpg","genres":["Семейный","Детектив","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1099219","ru":"惡行之外","en":"惡行之外","year":"2025","type":"Фильм","rating":5.4,"votes":8,"poster":"https://image.tmdb.org/t/p/w342/cp96hNAPbfhLnwE4FV5XyDtBXHk.jpg","backdrop":"