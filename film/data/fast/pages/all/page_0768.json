ядерного оружия. Параллельно они пытаются пробудить могущественное древнее существо, воздействуя на коллективное сознание людей и используя энергию космоса как источник силы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"223230","ru":"Indietro Tutta","en":"Indietro Tutta","year":"1987","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/wIdaC3mnyRcqANLloZKik9uZVj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/478gsK7D4vHkUZIEe0opFHSRauP.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"77085","ru":"J.E.","en":"J.E.","year":"1993","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7h2dCbRyjqB85BEzLCO8dcH4jVu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eBzgKIFkGvRZnpyA7tNdoV9MxhZ.jpg","genres":["Документальный","Ток-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"28351","ru":"Rollin' On The River","en":"Rollin' On The River","year":"1971","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/ymHTShQfimYZCPRIak2SND6DDLW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3X7aqLzPo61bWZWLBXwLOnzjFPs.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"14501","ru":"Game for a Laugh","en":"Game for a Laugh","year":"1981","type":"Сериал","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/nkhfxvhDrtg6v6UNWZBAvBv28Yf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8Ey1QvuDNNoTBj0cEr3zfVkj9B0.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"830358","ru":"Dindon Sauvage (La dinde noire)","en":"Dindon Sauvage (La dinde noire)","year":"2016","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/oc0NGnt5oqcrvqA07f7m2ELtFY4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/A7rElZwr0Jyhb