y":"","ageRating":""},{"id":"220398","ru":"ราชาวิหค","en":"ราชาวิหค","year":"2023","type":"Сериал","rating":9.4,"votes":24,"poster":"https://image.tmdb.org/t/p/w342/dg2TlP2WnQsaM2ajz79ofiA0oRw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6J6N7atwqDHqrNrfGx5V5tBi2mz.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"237329","ru":"รักนี้ให้ \"นาย\"","en":"รักนี้ให้ \"นาย\"","year":"2025","type":"Сериал","rating":9.4,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/eanWcaon1thxevXUGFORVqkCym1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aWSYdrgyXOwZ1DYKbOq3HRX0h1A.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1339606","ru":"El gran aviso","en":"El gran aviso","year":"2024","type":"Фильм","rating":9.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/j2r1oPnf8BrPA6pawpFNURXBT43.jpg","backdrop":"https://image.tmdb.org/t/p/w780/m6wHsUmt83Gjgu1buHCbYSfOp1N.jpg","genres":["Документальный","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"79504","ru":"Предназначенные судьбой","en":"ลิขิตรัก","year":"2018","type":"Сериал","rating":9.4,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/xiD97qpHPljSdeNAUuN1aYJtQb8.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xPsVpCC1xi9PUfbClBhf0PoHRJp.jpg","genres":["Драма","Мыльная опера"],"overview":"Давин - моряк из Таиланда, который, несмотря на разбитое в прошлом сердце, верит в любовь. Судьбой ему предначертано встретить Алису - наследную принцессу небольшой живописной европейской страны Хрисот, которая после дворцового переворота вынуждена спасаться бегством в Таиланде. Алиса в возрасте двух лет лишилась родителей и стала первой на очереди к престолу. С тех пор её жизнь превратилась в постоянную борьбу на выживание, поэтому девушка выросла замкнутой и недоверчивой, не подпускающей никого к своему сердцу. Судьба это или совпадение, но Алиса и Давин постоянно сталкиваются. В итоге им приходится объединиться, заключив фиктивный брак. В ходе событий молодые люди поймут, что любят друг друга. Но возможна ли любовь принцессы и простого моряка?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"300325","ru":"Заклятие фараона","en":"Under Wraps","year":"2014","type":"Мультфильм","rating":9.4,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/2xEcoljNi79SaYVmBPxz9eqicD3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/wwB4p73mH4rzEfRfHag1lbE9kvw.jpg","genres":["Семейный","Мультфильм","Комедия","Детектив"],"overview":"Иногда маленькая шалость может стать началом невероятного приключения! В центре сюжета — история о том, как мальчик Дэнни случайно превратил своих родителей-археологов в мумии.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"212292","ru":"หอมกลิ่นความรัก","en":"หอมกลิ่นความรัก","year":"2023","type":"Сериал","rating":9.4,"votes":17,"poster":"https://image.tmdb.org/t/p/w342/i4I2YOWD8TbEfDYn7Xcs57ZxU83.jpg","backdrop":"https://image.tmdb.org/t/p/w780/71Sh73osH5294QYi3nLkRpv7i5k.jpg","genres":["Драма","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"237326","ru":"KIDNAP ลับ-จ้าง-รัก","en":"KIDNAP ลับ-จ้าง-รัก","year":"2024","type":"Сериал","rating":9.4,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/u2t0B8TJY5cgvZxbfreJXGnS1gp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xx9zQJfDXC8t2QiEE0FfoYRXzuW.jpg","genres":["Драма","Криминал","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1768","ru":"Animal Cops: Houston","en":"Animal Cops: Houston","year":"2003","type":"Сериал","rating":9.4,"votes":16,"poster":"https://image.tmdb.org/t/p/w342/pT5AqjPB7kxTDmaO5xsKpBpmD0U.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xEHIe2j60QMezFQLf2yvDYpnOab.jpg","genres":["Криминал","Документальный","Реалити-шоу","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"tv_46344","ru":"Кобато","en":"こばと。","year":"2009","type":"Аниме","rating":9.4,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/bzE0eksp2MpZh6UWjBBoSxW1Cth.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k4sRP3AuKIqPmjEpxfp5qCCBhxX.jpg","genres":["Мультфильм","Драма","Фантастика","Аниме"],"overview":"Милая и наивная девушка по имени Кобато отправляется на Землю с целью исполнить своё заветное желание. Для этого ей предстоит исцелять людские сердца, наполняя волшебную бутылочку «осколками» их страданий. Проводником и куратором Кобато в мире людей выступает Иорёги – могущественное магическое существо в образе синего плюшевого пса. Разумеется, прибыв на Землю, Кобато оказывается в затруднительном положении. Ведь она не имеет никакого представления ни о людях, ни о жизни в их мире, а все её знания опираются на информацию, почерпнутую из манги. Но несмотря на все свои странности, выясняется, что Кобато прекрасно подготовлена к миссии: обладая добрым и сострадательным сердцем, она искренна в стремлении помогать людям. Кобато быстро завоёвывает любовь и восхищение всех, кому помогает, однако самой ей не позволено проявлять чувства к тем, чьи сердца она исцеляет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"65968","ru":"Стратег Камбэй","en":"軍師官兵衛","year":"2014","type":"Сериал","rating":9.4,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/1zuQsomE0Op76BsMCyNeK3OobzP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e3fQuz6TE0UEj8GCwlkjXJqa61Q.jpg","genres":["Драма","Война и политика"],"overview":"Курода Камбэй считался одним из лучших стратегов своего времени. В возрасте 22 лет, благодаря женитьбе, он стал советником рода Кодэра. Камбэя привлекает неординарная личность Ода Нобунаги, и он поступает на службу роду Ода. Ему удается снискать доверие Тоётоми Хидэёси, будущего правителя Японии – тот даже считал его своим младшим братом. Жизнь Камбэя была полна приключений: он планировал военные кампании для Хидэёси и даже принял христианство. Этот фильм - рассказ о жизни этого замечательного человека.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"443086","ru":"Руф Культура Азия","en":"Roof Culture Asia","year":"2017","type":"Фильм","rating":9.4,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/aeAe6WOKXROmmXySeZN6dWccWPX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2N2IChZXvNYLKZAGjqXsJb9QckW.jpg","genres":["Документальный"],"overview":"Британская паркур команда STORROR отправляется в эпичное путешествие по высотным крышам трех азиатских мегаполисов - Гонконга, Токио и Сеула.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1639683","ru":"AEW Double or Nothing 2026","en":"AEW Double or Nothing 2026","year":"2026","type":"Фильм","rating":9.4,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/hrjKU3dqlOUQ0aEyDgmnl9WSiY7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/swzcHVmtGZf7pGa9BCqJeRzFNgC.jpg","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"41108","ru":"Neues aus Büttenwarder","en":"Neues aus Büttenwarder","year":"2001","type":"Сериал","rating":9.4,"votes":11,"poster":"https://image.tmdb.org/t/p/w342/nzpBr25LmEmUBkmndAPYh3IYDPF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q45wnJ5m3Bqckkv3f96GQMBuE2B.jpg","genres":["Комедия","Мыльная опера","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"119645","ru":"어쩌다 사장","en":"어쩌다 사장","year":"2021","type":"Сериал","rating":9.4,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/52HfpGpVVPN73PJcOkm7ym0OLKD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lmnwVdMb5BmejgE7IPULc42dUfm.jpg","genres":["Ток-шоу","Реалити-шоу"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1587195","ru":"Forgiveness Girl","en":"Forgiveness Girl","year":"2025","type":"Фи