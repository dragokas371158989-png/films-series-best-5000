ми общего тёмного прошлого.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"158852","ru":"Ahammok","en":"Ahammok","year":"2022","type":"Сериал","rating":9.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/5S8fLbhHI0tdblKPxNFvRkAjoDP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/udYOmbW1JEZjVd726PWHlmptxPi.jpg","genres":["Комедия","Драма"],"overview":"Связанные общей судьбой, талантливая девушка-подросток с невероятной тягой к новым знаниям и бывший гений-изобретатель, переживший разочарования и крах своих иллюзий, отправляются сквозь пространство и время в полную опасностей миссию, чтобы раскрыть секреты таинственного места, которое существует в их общей памяти под названием «Земля завтрашнего дня».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"286443","ru":"哪一天我們會紅","en":"哪一天我們會紅","year":"2025","type":"Сериал","rating":9.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7qeMarCYNyumzUsu6o6jn1dG79f.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hey6Gxun1UWyWYiu6r7XA1vUF37.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"224634","ru":"Quilos Mortais Brasil","en":"Quilos Mortais Brasil","year":"2024","type":"Сериал","rating":9.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/5Q3cS2f7fwZrE8WNfYyK0DbdYaj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/patV7a0KEie82VrjViBQlEBnJjn.jpg","genres":["Реалити-шоу","Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"732656","ru":"착한 형부","en":"착한 형부","year":"2020","type":"Фильм","rating":9.5,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/nAvW9V1SJaPDkeuINtmadN6l4xt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hsO09lTEkTQQ6aE4iQDSZT76C2B.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1536433","ru":"Chicas tristes","en":"Chicas tristes"