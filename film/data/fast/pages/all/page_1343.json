/w780/enAbyB85UvgFtyq2pbbdeWaKT4S.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"460992","ru":"Невероятные тачки","en":"CarGo: The City on 4 Wheels!","year":"2017","type":"Мультфильм","rating":3.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/qAQ9S51w5l3PBQ1PbjjeFa6x0fb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9TvNe7tThzeBjlGeJbQuqU4WlMG.jpg","genres":["Мультфильм","Приключения","Семейный"],"overview":"Где-то в мире существует удивительный город, всё население которого составляют машинки. У них есть семьи, они учатся в школе, ходят на работу, и у них полным полно вполне человеческих и не только проблем. И как люди, не все машинки понимают, насколько важна семья, поэтому когда отец Дэнни попадает на свалку - ему приходится пересмотреть свои взгляды и отправиться спасать угодившего в беду родителя.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"267428","ru":"Buttwhistle","en":"Buttwhistle","year":"2014","type":"Фильм","rating":3.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/jh74tX4SX5YoQjwmTpsA6ySp9M2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/g4MWXKfektzJo0MpQp46b3xWbls.jpg","genres":["Детектив","Мелодрама","Комедия","Криминал","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"400408","ru":"Highway to Havasu","en":"Highway to Havasu","year":"2017","type":"Фильм","rating":3.9,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/pNKVV7GyAEok7mG52tMEcs7T3SV.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9YDQc8ML2Wr0V1OdvK4sBmERoeF.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1030250","ru":"Freeze","en":"Freeze","year":"2022","type":"Фильм","rating":3.9,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/4f8XAdQ7DOXsX3xogURJryFi7H3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/FwmPjZuiEsBKPEBTrDb5wTnso3.jpg","genre