ильм","rating":7.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/za2OO6b8R5I7WLr9kUW9HHxAES9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/JSxsW46ipKye6VQamWt8Hk5h23.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1177154","ru":"Mein Falke","en":"Mein Falke","year":"2023","type":"Фильм","rating":7.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/dWQv8eZbIK1qu9MzbOGo5WWQeFp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gW0WVTJ6pYJyB1nkDW0tSwzbwFY.jpg","genres":["Телевизионный фильм","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"149612","ru":"Чёрная стрела","en":"The Black Arrow","year":"1988","type":"Мультфильм","rating":7.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/qPUvmpL1zm4a0EAE9esgakyHkmQ.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9nXcHVUObMyCleoo0XPTB1cwbhj.jpg","genres":["Мультфильм","Семейный","Приключения"],"overview":"Во второй половине пятнадцатого века Англия стала грызть себя изнутри, развернув неслыханную гражданскую войну. Два противоборствующих лагеря – с одной стороны Йорки, с другой – Ланкастеры не могли простить друг другу что-то. Война продолжалась около тридцати лет, не принося жителям Англии ничего, кроме страха, смерти и новых битв. Мульфильм расскажет о сражениях в ряде битв этой войны. Вы увидите приключения Ричарда Шелтона, которому пришлось пройти через предательство, горе от потери близких людей и невероятные испытания в шайке разбойников «Черной стрелы».","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"489414","ru":"Surat Cinta Untuk Starla the Movie","en":"Surat Cinta Untuk Starla the Movie","year":"2017","type":"Фильм","rating":7.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2XIc5h7XXRRxQVs9IjVR3sqLmdf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vB8vSEwaBOAdyxpm7bweEGXHOtL.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"417582","ru":"Robert Doisneau, le révolté du merveilleux","en":"Robert Doisneau, le révolté du merveilleux","year":"2017","type":"Фильм","rating":7.1,"votes":5,"poster":"https://image.tmdb.org/t/p/w342/2JYUAMPdaljQ1q39HalxTO9SoKy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7IeWgKlMTQveiRKd6Z3elB0FOfH.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}