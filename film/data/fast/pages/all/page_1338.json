.jpg","backdrop":"","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"944438","ru":"记忆迷宫","en":"记忆迷宫","year":"2022","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/A34gyZX0gydOwVKEkxa1VajIyNV.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1016117","ru":"첫경험의 날","en":"첫경험의 날","year":"2021","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/cXTt5tIinwYcwIiOwZVoZxBs5Qt.jpg","backdrop":"","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"931187","ru":"섹스의 세계","en":"섹스의 세계","year":"2020","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qbwWgkh9yLcp4qo2FI3pAB2ONTv.jpg","backdrop":"","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"334729","ru":"Бацу и Терри","en":"バツ＆テリー","year":"1987","type":"Мультфильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/oAldwYM7mvRFviXiRxG3E767CYq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/xZ6ABSgx7ZmwqEX4NSSlKm5tmn7.jpg","genres":["Мультфильм","Боевик","Драма"],"overview":"Бацу и Терри — два «чётких» пацана, которые никому ничего не спустят с рук, даже учителям. Если возникнет необходимость, они готовы пустить в ход кулаки, защищая незнакомцев от опасности, особенно если этот незнакомец — красивая девушка. Так что они хороши не только в том, чтобы задираться, но могут и вступиться. Кого-то они нещадно терроризируют, а у кого-то способны вызвать искреннюю симпатию. Однажды они избавляют от проблем настоящую красотку и вынуждены из-за неё вступить в бой с целой бандой. Полиция преследует их, но стражи порядка сами восхищены и благодарны этой парочке за разгром банды. Ах, да, самое главное! Они, звёздный дуэт школьной бейсбольной команды, — великолепные питчер и кэтчер!","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"642387","ru":"Сказка о попе и его работнике Балде","en":"Сказка о попе и его работнике Балде","year":"1933","type":"Мультфильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/fnF0iRkeIuOFilpyQWkd2de4JJw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nu00zOzuFhjz2ahHGEGmfR3gYzO.jpg","genres":["Мультфильм","Комедия","Музыка"],"overview":"Мультфильм «Сказка о попе и его работнике Балде» по сказке А. С. Пушкина должен был стать первым полнометражным фильмом Цехановского . В 1936 году Шостакович был вынужден остановить работу после появления статьи «Сумбур вместо музыки», критикующей «формализм» в работах композитора. Анимация к фильму была отснята почти полностью, и сдана на хранение в архив Ленфильма, где была уничтожена в пожаре, вызванном бомбардировкой Ленинграда в начале Великой отечественной войны в 1941 году. Из полнометражного фильма сохранился лишь шестиминутный фрагмент «Базар» со стихами Александра Введенского и недописанная и разрозненная партитура Шостаковича, восстановленная и дописанная учеником композитора Вадимом Биберганом в 2005 году.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"728114","ru":"여관발이","en":"여관발이","year":"2020","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/A5SXhcMN1yJynEqVnws2LTyqDyU.jpg","backdrop":"","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"944074","ru":"자꾸 나만 먹어","en":"자꾸 나만 먹어","year":"2021","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4KsrDC6Z9nUG0hSpRsqjk0PGId0.jpg","backdrop":"","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1299314","ru":"후배부부와 교환섹스 2","en":"후배부부와 교환섹스 2","year":"2020","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/4roZrvGt9cTjWroD8iquIvcBddJ.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"782541","ru":"えとたま ～猫客万来～","en":"えとたま ～猫客万来～","year":"2021","type":"Мультфильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/yIGXdS7f349poQkIkfwTvXYdAp0.jpg","backdrop":"","genres":["Мультфильм","Комедия","Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"618246","ru":"Он не может жить без космоса","en":"Он не может жить без космоса","year":"2019","type":"Мультфильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/1WQmkl9ku41hycukUk56rC2MwND.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7E7JdVGTN7BYoijkeY80rBdVC4H.jpg","genres":["Мультфильм"],"overview":"Это история о матери и её единственном сыне. А также — о судьбе и предназначении.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"662729","ru":"Кошачий рай: Обещания кошечек","en":"ネコぱらOVA 仔ネコの日の約束","year":"2018","type":"Мультфильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7pt9HMrsAFMYAI1vzZQLwrXZtxN.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zkgXzbAK6xrOSWoBOjaEQnWO0Em.jpg","genres":["Мультфильм","Фэнтези","Комедия","Семейный"],"overview":"ашо Миназуки живет вместе с младшей сестрой в то время, как их родители занимаются ресторанным бизнесом. Пока они проводят многие часы на работе, мальчик мечтает о том, чтобы пойти по стопам отца и матери, открыв собственное кафе. Однажды прогуливаясь под дождем, дети обнаруживают на дороге коробку, внутри которой находятся два милых котенка. Герои понимают, что животных бросил их прежний хозяин, а потому заносят находку в дом. Вырастив Ваниллу и Чоколу, юноша озадачивается вопросом относительно будущего, ведь для открытия кафе ему нужно переехать в другой город. Отправившись покорять столицу, парень начинает познавать все тонкости кулинарии и организации персонала, но случайно обнаруживает в новой квартире знакомые мордочки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1492127","ru":"Viper","en":"Viper","year":"2026","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/9gvhEF9MTpK4Fr6WAj079A92tLV.jpg","backdrop":"","genres":["Фантастика","Боевик","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"945828","ru":"今夜、わたしはカラダで恋をする。","en":"今夜、わたしはカラダで恋をする。","year":"2022","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/lXTVdS1NflVE9AI44LkNdiYTF3N.jpg","backdrop":"","genres":["Драма","Мелодрама","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1075020","ru":"ハクタカ白鷹雨音の捜査ファイル","en":"ハクタカ白鷹雨音の捜査ファイル","year":"2021","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/n61KDYR17SxXkhhRgvFVBLBmyCW.jpg","backdrop":"","genres":["Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"897125","ru":"성적은 크기순이 아니잖아","en":"성적은 크기순이 아니잖아","year":"2020","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/qeKbeuQwEV6RPkDdRgN6Te12iuo.jpg","backdrop":"","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1373987","ru":"하우치","en":"하우치","year":"2024","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/5ykDZxd5H2sPez7znXyLFN6Rztr.jpg","backdrop":"","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"910441","ru":"달콤한 그녀의 맛","en":"달콤한 그녀의 맛","year":"2021","type":"Фильм","rating":4.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/pToldvVu5coF8EO5NiZyeCQFKys.jpg","backdrop":"","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"10