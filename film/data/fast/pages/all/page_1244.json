g/t/p/w342/1ECgLX6i4rOoyx5lvjtDE5EI6wo.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hToIFmaFXATIMJ7fwiuWIFzrXU9.jpg","genres":["Драма","Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1208022","ru":"RATS!","en":"RATS!","year":"2025","type":"Фильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/eG5RsRJ0NJ26GmGU9617xtIhm44.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gTMi9yEtZeYdF8K5UZfPbITSsRg.jpg","genres":["Комедия","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1026255","ru":"Who Done It: The Clue Documentary","en":"Who Done It: The Clue Documentary","year":"2022","type":"Фильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/xQjFbRnCnSK6FExTkTWG4ypelKA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/hSqRgbLJ1Q9if534Azhp2eekKdl.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"257949","ru":"Олли и сокровища пиратов","en":"Dive Olly Dive and the Pirate Treasure","year":"2014","type":"Мультфильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/6JZf4CBDFK6vIW6KGdXVrzJz4c2.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w3iNJrnGLstMTh69fji8hlaHVHj.jpg","genres":["Мультфильм","Семейный"],"overview":"Герои сериала, симпатичные подводные лодки, а так же весь подводный мир, так понравились взрослым и детям, что продюсеры пошли дальше и сделали полный метр в 3D формате, включив в сюжет новых героев и написав новый сценарий, рассчитанный уже на семейный просмотр в кинотеатре и дома. Фильм о приключениях исследовательской подводной лодки по имени Олли и его лучшей подруги Бэт. Они тренируются под руководством их наставника Дага, чтобы однажды вырасти и стать настоящими исследовательскими подводными лодками. На их пути будет много подводных и очень красочных приключений, опасных и веселых…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"672271","ru":"Темная гавань","en":"Dark Harbor","year":"2019","type":"Фильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/1KRzTy52iHCsmWBFyfRlVb2UCOj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y4KVBDCePTiJCtCmLan0NrjKj8N.jpg","genres":["Триллер"],"overview":"За считанные дни до рождения первенца, Оливия возвращается на остров, где она провела свое детство, чтобы похоронить убитого отца и вновь встретиться с нарциссичной матерью. Но вскоре один за другим начинают открываться мрачные семейные секреты, и жизнь Оливии оказывается под угрозой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"298182","ru":"Черные птицы","en":"Black Fly","year":"2014","type":"Фильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/yVLJF5tBF6jedytF1xpUr5dplPY.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uhKjcmAlqd8jEJJYdlwAngS5GFo.jpg","genres":["Триллер"],"overview":"Давид желает провести с возлюбленной самый лучший в мире медовый месяц, после чего девушка отправится в криокамеру. Он строит домик их мечты, в котором оставшиеся дни пролетят незаметно. Анна погружается в сон, а Давид остается ждать. Дни идут за днями, надежда в сердце мужчины постепенно тает. А время и соленый морской ветер уже ласкают седые виски героя, ожидающего возвращение избранницы.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"316762","ru":"Семейное Рождество","en":"Familien Jul","year":"2014","type":"Фильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/7X0gZiJstyxurcyfYY9X7B1UuFq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/flwK9vKAFfbDCCUN7PdGMgfOgeV.jpg","genres":["Комедия","Семейный"],"overview":"Шестилетнему мальчику Хуго очень повезло: он получил самый удивительный подарок в своей жизни на Рождество. Он обнаружил в своем доме маленького эльфа Пикси. Теперь Хуго делает все возможное, чтобы его новый друг как можно дольше задержался у него в гостях. Однако Рождество проходит, и все остальные эльфы уже перенеслись на Северный Полюс. Теперь Пикси придется ждать целый год до наступления следующего Рождества, чтобы иметь возможность вернуться домой.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"762363","ru":"Dying for a Daughter","en":"Dying for a Daughter","year":"2020","type":"Фильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/lY8oNixnswXhQZMw3hyIIlZDFb0.jpg","backdrop":"","genres":["Триллер","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"382118","ru":"Кореец в Париже","en":"파리의 한국남자","year":"2016","type":"Фильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/9YcQ59Pky8mde9DMc1lc6fc1tIU.jpg","backdrop":"https://image.tmdb.org/t/p/w780/uWMs5OkcJCIt1f8Pf798Hm7kkO8.jpg","genres":["Драма"],"overview":"У мужчины во время его медового месяца исчезает жена. Он уверен, что она была похищена, и не оставляет попыток найти её.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"47644","ru":"Дух живого леса","en":"Espírito Do Bosque","year":"2008","type":"Мультфильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/wASofIHiWgzx10K71xcV5E1GCYI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gQ1kjMtWQhu9E61gMZIguSaGr2g.jpg","genres":["Фэнтези","Мультфильм"],"overview":"Влиятельный бизнесмен собирается строить автомагистраль, а злобная миссис Д’Абондо только и ждет повода, чтобы избавиться от Леса. Деревьям Живого леса и старому Дубу грозит опасность, и те советуют животным, обитающим в Лесу, спасаться бегством. Однако кроты Фури и Линда, а также мышонок Пьорно не собираются сдаваться. К ним присоединяется маленький пугливый крот Себоло, недавно переехавший из города в Лес. На помощь друзьям также приходит клан диких кошек под предводительством храброго Тигра. Даже назойливые мухи Хи-Хи и Хо-Хо решают помочь им. Когда друзья обнаруживают, что миссис Д’Абондо боится привидений, Фури в голову приходит отличная идея… пробудить Дух Живого Леса.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"399501","ru":"CLAMP в Стране чудес","en":"CLAMP IN WONDERLAND","year":"1994","type":"Мультфильм","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/993XrJpoFoX8cCvh721xMa674Oj.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mmtXr8gaL9FxJmc6RR0fsbxROvA.jpg","genres":["Мультфильм","Музыка"],"overview":"Короткий видеоряд, содержащий многих популярных аниме и манга персонажей CLAMP (которые были выпущены в то время). При музыкальном сопровождении в нем рассказывается о Волшебном мире, наполненном фантазией, магией и мечтами.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"13126","ru":"Дневной спектакль","en":"Matinee Theater","year":"1955","type":"Сериал","rating":5.3,"votes":7,"poster":"https://image.tmdb.org/t/p/w342/sL6FFh0JultfM2K7PJq4iDVu8AL.jpg","backdrop":"","genres":["Драма"],"overview":"Антологический сериал американского телеканала NBC, представлявший зрителям (как правило, в прямом эфире) постановки на основе оригинального материала, а также адаптации литературной классики.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}