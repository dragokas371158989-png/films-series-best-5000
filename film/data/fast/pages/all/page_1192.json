ating":""},{"id":"663610","ru":"Тридцать семь-надцать","en":"37 Teen","year":"2019","type":"Фильм","rating":5.8,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/sUPEZzoFarSwWWFaNQ45PRgEuAF.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q8wdspRRWYIQKQUdWPIGItoiop1.jpg","genres":["Комедия"],"overview":"У миллиардера Адама Пая есть всё кроме положительных воспоминаний о старших классах. Он неохотно идет на 20-ый вечер встречи выпускников и предлагает бывшим одноклассникам годовую зарплату за то, чтобы на месяц вернуться обратно в школу.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"90934","ru":"香港奇案之吸血貴利王","en":"香港奇案之吸血貴利王","year":"1994","type":"Фильм","rating":5.8,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/c0XAcWPlQpF6Y3a9f0klQ5RvG7t.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2F74qRanI2hKWJQNlSqX555d3WA.jpg","genres":["Криминал","Триллер","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"512082","ru":"Jahr des Tigers","en":"Jahr des Tigers","year":"2017","type":"Фильм","rating":5.8,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/IqxQ9X6zcTg79Tw7Dz4VNJpX4e.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cz7rj3Otz4vA7DxbCwQ6a0AlVEL.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"560095","ru":"Pauvre Georges!","en":"Pauvre Georges!","year":"2019","type":"Фильм","rating":5.8,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/h7ovr0Mmm3stHQR6wIDsAHk2XBw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/29wkp3yHgkHlBJeJiWz1McIsuqu.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"451003","ru":"花芯","en":"花芯","year":"2016","type":"Фильм","rating":5.8,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/4fHfSbtVo5eP8ei2in9bvpp1tUP.jpg","backdrop":"https://image.tmdb.org/t/p/w780/y4IMSTLTmH91XkhlFkpROBRhFZ4.jpg","genres":["Драма","Ме