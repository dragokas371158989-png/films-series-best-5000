age.tmdb.org/t/p/w342/1OahMHyOOEnDYmxnDJHzyFvegZA.jpg","backdrop":"https://image.tmdb.org/t/p/w780/8WQHrPJIOk7sdhGsG7TUhIj6N7u.jpg","genres":["Боевик","Драма","Приключения","Фантастика","Военный","Мультфильм","Аниме"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"663991","ru":"Разлучённые сёстры","en":"Im Feuer","year":"2021","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/ynuFG5RE32JiE7MAMLLjEe4EqUc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/a0flxcR8UtNgfPAgXHDHH9x0Ve6.jpg","genres":["Драма","Военный"],"overview":"Рожда, уроженка Иракского Курдистана и солдат немецкой армии, отправляется в лагерь беженцев в Греции, где ей удается встретиться со своей матерью, у которой есть плохие новости о ее сестре Дилан.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"656292","ru":"Рыба, плавающая брюхом вверх","en":"Ein Fisch, der auf dem Rücken schwimmt","year":"2020","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/a2vmhNcpzTbKA3GJwnLXR4hsNWH.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3EELAXQVOiMQB9h17lbbYFRobvq.jpg","genres":["Драма"],"overview":"Отец и сын влюбляются в одну женщину.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1055854","ru":"Позвоните мисс Клео","en":"Call Me Miss Cleo","year":"2022","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/dw8FoMu1pk0XKJWn6il6kWLIdzu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/iyHxqhdOhscWsEFTcbwPMBw4EzV.jpg","genres":["Документальный"],"overview":"О телеведущей и экстрасенсе мисс Клео, популярной в 90-е. Юри Делл Харрис (настоящее имя ясновидящей) работала на специальной горячей линии, где оказывала магически-психологическую помощь: например, раскладывала карты Таро. Продюсеры придумали ей псевдоним и образ шаманки, однако со временем эффектную женщину стали подозревать в мошенничестве. Фильм исследует этот многослойный феномен, расспрашивая знаменитостей того времени и тех, кто был близок к харизматичной гадалке.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1213906","ru":"द साबरमती रिपोर्ट","en":"द साबरमती रिपोर्ट","year":"2024","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/zd3CBwv04BRyH4WJuM5xFsZkgjX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/s6WQSGAuZsYZ354VpA7HbQDmesA.jpg","genres":["Драма","Триллер","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"994740","ru":"愛してる！","en":"愛してる！","year":"2022","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/yhJeLjCRRIssKjCNwHe15kKtc64.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9Em3GNoNIuFXUwZpu5IVQKHRLI7.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1303517","ru":"Kahar: Kapla High Council","en":"Kahar: Kapla High Council","year":"2024","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/x4ucff9T7582SM9SAW5FpY9jemT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oAPqXRP3g66TcxBGCdM9rPhx8VU.jpg","genres":["Боевик","Криминал","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"833005","ru":"Okupace","en":"Okupace","year":"2021","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/zHJGropXL51ncFHczcPkduhQLhe.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yWiBiOslq48X9TLyn1th00mZTV0.jpg","genres":["Драма","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"935160","ru":"The Wrong High School Sweetheart","en":"The Wrong High School Sweetheart","year":"2022","type":"Фильм","rating":5.9,"votes":10,"poster":"https://image.tmdb.org/t/p/w342/5W2RHWQZCgBMLmFHhvnoxhsVWDD.jpg","backdrop":"https://image.tmdb.org/t/p/w780/r2vR7uKYAHvqwaPac6u4nkIazci.jpg",