ся в Дракона. Святогор спрятал три артефакта (коготь, глаз и жилу Дракона) в современном мире, чтобы зло никогда не вернулось. Но из-за школьника Вани в наше время проникает возлюбленная Колдуна. Она хочет найти эти артефакты, воскресить Дракона и вернуть своего суженого к жизни. Вместе с двумя богатырями из древней Руси Ваня должен отыскать злодейку и не дать ей осуществить задуманное.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1616189","ru":"Douglas Gordon by Douglas Gordon","en":"Douglas Gordon by Douglas Gordon","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/f1ZtekbWTE1I4C40hVdu3mKhHwc.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rmPu8LIS0bQJAtsGe7SVGBplsHC.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1588586","ru":"Když se zhasne","en":"Když se zhasne","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/v1Fv9x8tkqeAmkDjc5YZJeLgv7b.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dfXRSgCmUbn5b0iM7CQNEktF12p.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1448266","ru":"The Catcher","en":"The Catcher","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/lxCDwXCy9v2rHS4tLzMVJ3kqIQM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aErhraCnJufHDcrC7hbhRvL3a40.jpg","genres":["Драма","Триллер","Детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1241052","ru":"Mouse","en":"Mouse","year":"2026","type":"Фильм","rating":0.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/iKBFfOCdeu21lxxLxWaSAXxkmJ5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1pR6uu0e9h4tJiSuYLuiRm7id6x.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"15324