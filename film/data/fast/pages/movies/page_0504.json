":"https://image.tmdb.org/t/p/w342/6hzs7kCSRUHhZFRcKDuyM2peRVu.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4Et5IrmuEdclGmKZrEy8rUZkW2H.jpg","genres":["Драма","Комедия"],"overview":"Три подруги Эш, Шеннон и Венди переживают непростые времена: у всех у них задержка. При этом девушки наслаждаются жизнью и вовсе не планируют становиться матерями. По мере того как растут их тревоги, справляться с ними в одиночку становится невозможно. Тогда девушки решают объединиться, посмотреть в лицо своим страхам и устроить странную вечеринку, гостями которой становятся все потенциальные отцы их потенциальных детей. При этом ни одна из подруг не уверена, что на самом деле беременна.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1475690","ru":"Винный заговор","en":"Eierkratz-Komplott - Ein Stinatz-Krimi","year":"2026","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/k2SLUdc0EeO997qcbMa3CMRr0gq.jpg","backdrop":"","genres":["Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"740832","ru":"殘影空間","en":"殘影空間","year":"2023","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/8v97c0JGNmpNbiAbgJWhD0Mhp4Z.jpg","backdrop":"","genres":["Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1580651","ru":"The Shuffle","en":"The Shuffle","year":"2025","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/jJzjKLeRBuKw8XzngFZFuqHeDq4.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"400885","ru":"Взрывное прошлое","en":"ふきげんな過去","year":"2016","type":"Фильм","rating":7.0,"votes":3,"poster":"https://image.tmdb.org/t/p/w342/3TqlxtDXFsunFuME8HYIvlllVhh.jpg","backdrop":"https://image.tmdb.org/t/p/w780/svPYgPsAoi41gMdEG2ffWoa7OVn.jpg","genres":["Комедия","Драма"],"overview":"Школьница Како проводит 