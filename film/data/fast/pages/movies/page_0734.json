/t/p/w342/1ZdNHoeNU1exgwUDiJvDcLGkvKy.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nhoXXnSYUnsM4XifSvSBy73H7vc.jpg","genres":["Боевик","Приключения","Фантастика"],"overview":"После того, как корабль пришельцев уничтожает Вашингтон, жителям небольшого города приходится отбиваться от инопланетян, которые ведут охоту на президента Соединенных Штатов и пытаются вернуть себе загадочное устройство, которое он носит с собой после крушения вертолёта.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"477278","ru":"Сломанный ключ","en":"The Broken Key","year":"2017","type":"Фильм","rating":3.2,"votes":23,"poster":"https://image.tmdb.org/t/p/w342/p0Tz0SswOPLSgAjvTtkeiUnfeZT.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zgArcZ6eVbf0sgq6Qp0i3b2iDS4.jpg","genres":["Фантастика","Триллер","История"],"overview":"В недалёком будущем бумага становится дефицитом, а библиотеки превращаются в закрытые музеи, которые не каждому доступны. Печать здесь запрещена и информация поступает только на цифровые носители. В этом цифровом городе неожиданно происходит серия ритуальных убийств. Главный герой Адам попытается настигнуть убийцу, следуя подсказкам, которые он оставляет.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"252053","ru":"यारियां","en":"यारियां","year":"2014","type":"Фильм","rating":3.2,"votes":18,"poster":"https://image.tmdb.org/t/p/w342/qmCFOtV3DoR7tL5XWVeE3jT6wf1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/9bRA3SYXadsYTJ5QDcMH3zVBRcN.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"412431","ru":"Списанный в резерв","en":"Decommissioned","year":"2016","type":"Фильм","rating":3.2,"votes":15,"poster":"https://image.tmdb.org/t/p/w342/9esPzvETVnmBgXLbUrA1psg9ag1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4Xm3sLS4Xmg6b8LVun5zITsBQ3l.jpg","genres":["Боевик","Триллер"],"overview":"Жизнь отставного агента переворачивается вверх дном, когда он обнаруживает, что его используют как козла отпущения в задуманном ЦРУ заговоре по убийству президента.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"288818","ru":"Правосудие бессильно","en":"Beyond Justice","year":"2014","type":"Фильм","rating":3.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/h9cuz9T0uDaD4NIggKB1Nt9wBHp.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1zUunNQv7IJZQyUSraWs5IFg4zY.jpg","genres":["Триллер","Боевик"],"overview":"Винсент Делакруз является успешным бизнесменом. Он желает одного — отомстить за убийство своего сына. Для этого он нанимает самого лучшего адвоката Джексона Стоуна. Приступив к делу, Джексон вскоре попадает в жестокий мир торговли людьми. Оказывается, что торговля процветает даже в такой развитой стране как США. Постепенно Джексон начинает осознавать насколько опасна история, в которую он ввязался, но профессиональная гордость не позволяет ему опустить руки.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"434758","ru":"Вызов мёртвых","en":"The Summoning","year":"2017","type":"Фильм","rating":3.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/q9zpI0hjuFFp08zInzwuvhcvglX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zoYeI8usTY9owpyHHj61rjuiQ8E.jpg","genres":["Триллер","Драма","Детектив"],"overview":"Студентка юридического факультета получает задание разобраться с делом об убийстве столетней давности и обнаруживает страшные тайны, из-за которых её жизнь находится в опасности. На помощь ей приходит серьёзный, но честный детектив. Смогут ли они разгадать все тайны и остаться в живых?","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"399421","ru":"Замечательная жизнь","en":"A Remarkable Life","year":"2016","type":"Фильм","rating":3.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/7TxYejdF3FI086otuCfcYnlzD9A.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4su773V5FHkcnTT6d3J9rD8LJ1o.jpg","genres":["Драма","Музыка","Мелодрама"],"overview":"У Ленни Баббитта была идеальная жизнь, красавица жена Трейси, прекрасные отношения с сыном-аутистом Исааком и развивающаяся карьера в дэнверской газете. Реальность Ленни рушится, когда его увольняют, состояние сына ухудшается, а жена оказывается в постели с другой женщиной. Не зная, куда податься, он переезжает к отцу, чтобы пересмотреть разлетевшуюся на осколки жизнь. Он начинает работать в отцовском ломбарде, где встречает юную и волевую Челси, способную вдохнуть в него новую жизнь и исцелить душу. И перед Ленни встает выбор: цепляться за прошлое или искать себя и признание в настоящем.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"295413","ru":"Театр страха","en":"The Midnight Horror Show","year":"2014","type":"Фильм","rating":3.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/3B2vVIessLg30GHt7kUCIhFkvM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/AlOFg6T8TLol9vh9mVschYISnr3.jpg","genres":["Ужасы"],"overview":"Семья Моро колесит по всей Великобритании со своим подпольным варьете, рассчитанным на взрослую аудиторию. Однако за занавесом происходит нечто более зловещее, нежели просто развлечение...","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"339709","ru":"My Trip Back to the Dark Side","en":"My Trip Back to the Dark Side","year":"2014","type":"Фильм","rating":3.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/hjwvGfIf92cQdqwCZLmQJycbmIX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/k4a7JGI2lHO3uuu0QHV1wQs96yj.jpg","genres":["Криминал","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"69932","ru":"Disarmed","en":"Disarmed","year":"2010","type":"Фильм","rating":3.2,"votes":14,"poster":"https://image.tmdb.org/t/p/w342/7qZSn5WQfjQ13tPCct5e3JmHNjA.jpg","backdrop":"","genres":["Боевик","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"962486","ru":"Тени пустыни","en":"Desert Shadows","year":"2022","type":"Фильм","rating":3.2,"votes":13,"poster":"https://image.tmdb.org/t/p/w342/s93lFCuJsHcum2h4TJaE42kgei1.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aYMq6Qfd4LOHU0VRWwL9wWz637P.jpg","genres":["Ужасы"],"overview":"Когда брат Донни пропадает без вести в пустыне Невада, а полиция отказывается помочь, он решает начать поиски самостоятельно. Поиски выводят его на легенду о загадочном существе из индейских легенд, которое высасывает жизненную силу из своих жертв.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"290006","ru":"Любовные грезы","en":"Love Dream","year":"1988","type":"Фильм","rating":3.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/vxX8onbwG1KM3G3MajlIfwZB6FM.jpg","backdrop":"https://image.tmdb.org/t/p/w780/d7otdmHVy6Sji9C1JfFAzVBsZky.jpg","genres":["Фэнтези","Драма","Мелодрама"],"overview":"Фантасмагорическая история о бывшем рок-певце, который стал обвиняемым в преступлении против собственного брата. На свою удачу музыкант находит волшебную лампу с джином женского пола, которая ему предлагает загадать три желания....","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"616229","ru":"The Male Gaze: The Heat of the Night","en":"The Male Gaze: The Heat of the Night","year":"2019","type":"Фильм","rating":3.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/e1gNLO829rkE73sBJ3aClZJHNXd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gRuTXpI1CWBGUxsWrpvn6u7A5wl.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"413647","ru":"Sharknado: Heart of Sharkness","en":"Sharknado: Heart of Sharkness","year":"2016","type":"Фильм","rating":3.2,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/mzLXk4LlSYTX6NekIB5bIr4HeCh.jpg","backdrop":"","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""}]}