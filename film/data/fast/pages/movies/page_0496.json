ountry":"","ageRating":""},{"id":"1026746","ru":"Новая раскрашенная кожа","en":"新画皮","year":"2022","type":"Фильм","rating":7.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/lzarUOe5V3wiv2e8NwUPRDQb3rg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nwtXREOvmAzQgbeFGuJfsNEk0W8.jpg","genres":["Боевик","Фэнтези","Мелодрама"],"overview":"Во время войны человеческой расы с демонами генерал Шоуян притворился, что сдался в плен королю демонов, чтобы в решающий момент нанести удар. Девушка-демон, владеющая кожевенной мастерской, по ошибке убивает невесту генерала и решает принять ее облик.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1437610","ru":"Whitetail","en":"Whitetail","year":"2026","type":"Фильм","rating":7.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/1qatuvU5qaBbJEnQ6emdUHr2Iiq.jpg","backdrop":"https://image.tmdb.org/t/p/w780/2MSb6s5rWtoAPj31DQVCnkNujta.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1649758","ru":"Meal Ticket","en":"Meal Ticket","year":"2026","type":"Фильм","rating":7.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/4E4WA3bfbq4mgDGrFJMNit9U1gz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zpOUQ7rpNfV4Tny8GDwEGKCLdmw.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"794717","ru":"明日の食卓","en":"明日の食卓","year":"2021","type":"Фильм","rating":7.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/kOA31RJUzIQN8ymPyPI1lz8CSFr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pnpKNHQ0P7MIOv5zh3oytZnvWcf.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1464976","ru":"الحياة بعد سهام","en":"الحياة بعد سهام","year":"2026","type":"Фильм","rating":7.1,"votes":4,"poster":"https://image.tmdb.org/t/p/w342/kWaGOYbGkcE2sv5pBgF4LoxLGZt.jpg","backdrop":"https://image.tmdb.org/t/p/w780/e0b5SUAg5cDqkbP8Vedts