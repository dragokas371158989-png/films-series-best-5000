uFEnl3q.jpg","backdrop":"https://image.tmdb.org/t/p/w780/cM8H3fsCrj6oJhmK9y0SQcpxyCl.jpg","genres":["Ужасы","Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1324990","ru":"Нерассказанное: Хоуп Соло против футбола США","en":"Untold: Hope Solo vs. U.S. Soccer","year":"2024","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/2vdEuZwQaEXFJ3Y73u7tS4eshsC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/sJ9mzTQ8s1rop6LnACel2M46Uuu.jpg","genres":["Документальный"],"overview":"Чемпионка мира Хоуп Соло рассказывает о бурном восхождении на вершину женского футбола на фоне публичных скандалов и напряженных отношений с другими членами команды.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1062198","ru":"Фреш Киллс","en":"Fresh Kills","year":"2024","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/iDdDnFvxAVTHQLgzWos03lcFDvd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/vc0sr2g7geu063cBcUQKl3kVDtE.jpg","genres":["Драма","Криминал"],"overview":"История Франсин и ее дочерей Роуз и Конни, которые живут в семье организованной преступности на Стейтен-Айленде в 1980-х годах. Семья Ларуссо, возглавляемая Джо, переезжает из Бруклина в поисках спокойной жизни, но по-прежнему опутана связями с мафией. Роуз, мечтающая о другом будущем, раскрывает мрачные тайны их мира, в то время как Конни принимает их мафиозный образ жизни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"778994","ru":"Деревенская любовь","en":"Love at the Ranch","year":"2021","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/cleLiTpYiSo4zYOeT7i954RwE0w.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7ElFuk6MXWM57V56mVEisbxFXtY.jpg","genres":["Телевизионный фильм","Мелодрама","Драма"],"overview":"Эллисон Сойер - репортер, известная своими громкими историями. Ее следующая история - написание очерка об одной из ее любимых писательниц Аннабель Харпер. Все свои романтические романы Аннабель создавала на бесконечно прекрасном ранчо Клейборн, вдали от городской жизни. Эллисон направляется на ранчо и встречает Хэнка и его очаровательную бабушку Стеллу, которые уже много лет управляют этим местом вместе. По мере того как Эллисон приближается к жизни Аннабель, она также становится намного ближе к Хэнку.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"713854","ru":"കപ്പേള","en":"കപ്പേള","year":"2020","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/5e6yMw6ipz7DvLbtKAvHjbQAjHr.jpg","backdrop":"https://image.tmdb.org/t/p/w780/nH41REzItDOt5WlB6fD7sOeslYl.jpg","genres":["Мелодрама","Детектив"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"879400","ru":"Les Meilleures","en":"Les Meilleures","year":"2022","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/k1jObMIsT8qmjn9oi2Lze2IsCih.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dioZNJfzCNF3yaAnM1Hv5i6xv5D.jpg","genres":["Драма","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"399220","ru":"Покидая Блэкпул","en":"Away","year":"2016","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/yJUqPWeenyvAz6nXCdHrCrClbGd.jpg","backdrop":"https://image.tmdb.org/t/p/w780/aK3JlVC0gmfLqzQ8WminN3aD1lx.jpg","genres":["Драма"],"overview":"Вдовец Джозеф приезжает в прибрежный городок Блэкпул. Здесь он вместе с женой пережил счастливейшие моменты в своей жизни и здесь же он собирается свести с этой жизнью счёты. Риа — сирота, у которой сложные отношения с ее бойфрендом Дексом: когда-то он спас её от улицы, но теперь стал излишне склонен к рукоприкладству. Случайное знакомство Джозефа и Риа внесет коррективы в жизни обоих.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"552161","ru":"Искусство убийства","en":"The Art of Murder","year":"2018","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/aFBG5IqTSoNXUeTVtSWUL2WUuuW.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6WwIVI5plUNGazTbJ3bKDBOI75H.jpg","genres":["Триллер"],"overview":"Ассистентка художественной галереи Кейт Миллер знакомится с наследником обветшалого поместья и находит потерянный шедевр Вермеера. Но в итоге она оказывается втянутой в заговор на несколько миллионов долларов, когда целостность и подлинность картины оказываются под вопросом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"569106","ru":"മാമാങ്കം","en":"മാമാങ്കം","year":"2019","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/7po3zyLyMYcR2r0UVWZ94sb1r4o.jpg","backdrop":"https://image.tmdb.org/t/p/w780/bdIEyO8IJAtCs0s4JD9n9b5f7L5.jpg","genres":["Боевик","Военный","Триллер","История","Приключения"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"627477","ru":"Christmas Unleashed","en":"Christmas Unleashed","year":"2019","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/yRZ5oRF8ocgYGZ5iVmhDw4xlKOb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eIJREuCtNTXvKMlANSVoH643jVt.jpg","genres":["Мелодрама","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"435033","ru":"Say You Will","en":"Say You Will","year":"2017","type":"Фильм","rating":6.2,"votes":22,"poster":"https://image.tmdb.org/t/p/w342/nVdd58VCbXD6qMnXaek3vUnw0wC.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rXslyNgsI0MEEmVPoq1d2DJ6YOa.jpg","genres":["Драма","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1222479","ru":"Мирай","en":"మిరాయి","year":"2025","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/gVzWHYThVODV5MgccDoyQxPFXve.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1Xw1Gh4XTWwrkIIISOGFBMPvO8.jpg","genres":["Боевик","Приключения","Фэнтези"],"overview":"Юному герою поручено защищать девять священных свитков, которые способны превратить смертного в божество. Эти артефакты становятся объектом охоты зловещей группировки «Чёрный Меч». Чтобы спасти мир, герою предстоит пройти путь от обычного человека до избранного воина.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1257388","ru":"Мой Бу","en":"อนงค์","year":"2024","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/iQDizDWsElDHS7ZdHj6UB9OKaic.jpg","backdrop":"https://image.tmdb.org/t/p/w780/fGQstXqugDEPNDBumZzAfZRaSNK.jpg","genres":["Мелодрама","Комедия","Ужасы"],"overview":"Трогательная история любви парня-стримера и девушки-призрака.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"929569","ru":"Лучший в мире","en":"World's Best","year":"2023","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/9xvEhZZMOmLIkqe4khrtF5TkOnO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/stMVkOzLeHqaz6cdd3BV6saKxcz.jpg","genres":["Музыка","Семейный","Комедия"],"overview":"Радж Патель, знаток математики, втайне одержимый мечтой своего покойного отца стать рэп-музыкантом, почти теряет все в своей попытке достичь нескольких целей в жизни.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"658895","ru":"Город у реки","en":"Piļsāta pī upis","year":"2020","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/9IhILJ6FB0kASxoRTvsRKWHYnB4.jpg","backdrop":"https://image.tmdb.org/t/p/w780/jxpj4BTgiX4PjcPfxg1mqGCslch.jpg","genres":["Драма","История","Мелодрама"],"overview":"У Ансиса невинная профессия художника, и его услуги требуются всем режимам, быстро сменяющим друг друга начиная с 30-х годов прошлого века и заканчивая Второй мировой войной. Полные пафоса времена Улманиса, коммунистический и нацистский режимы, война и холокост... выдержат ли все это идеалы молодости и невинная любовь? За столь короткий срок Ансис совершает невероятное экзистанциональное путешествие, превращаясь из неловкого молодого человека в мужчину, способного на поступок.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"959439","ru":"きさらぎ駅","en":"きさらぎ駅","year":"2022","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/fkH85I3onRvT2E2Fod4G3mjim4h.jpg","backdrop":"https://image.tmdb.org/t/p/w780/q2hP45VWmimdiJzkrS7NCgc4n3e.jpg","genres":["Ужасы"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1147351","ru":"Lousy Carter","en":"Lousy Carter","year":"2024","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/leL5Ri7CSaThIlY0U55Iu4KXxPn.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rOMGiDnuekPjGEdMmFur5AaAecB.jpg","genres":["Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"479272","ru":"Цвет игры","en":"黑白迷宮","year":"2017","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/6B2wWM8ePY5ZfiCyXWyqb4SBAuX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/r1JohLhkZDLEooSJugqMl9A9MZh.jpg","genres":["Боевик","Криминал","Триллер"],"overview":"Главные персонажи картины Да Хуа, А Чунь и другие неожиданно для себя стали частью серьезной и опасной переделки, к которой они не были готовы. Все началось с того, что в один прекрасный день они оказались в эпицентре разборки между китайской материковой полицией и опасной гонконгской бандой. Ситуация с первых минут дала понять героям, что их жизнь уже никогда не станет прежней, потому что они угодили в самую настоящую смертельную ловушку. Теперь героям предстоит проявить все свое мужество, чтобы выбраться из неприятностей и не погибнуть, но они еще не знают, что охота на них уже шла полным ходом.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"442033","ru":"Мечтай о большем: Свой мир строим сами","en":"Dream Big: Engineering Our World","year":"2017","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/9UpHHHzuVt4N1LxMeizQFCpyLvg.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5WBLcXadiHaAXqmtQSAC4o5hzkO.jpg","genres":["Документальный"],"overview":"Сегодня работа инженеров как никогда актуальна и важна для человечества. Она отражается на культуре и мышлении, благодаря чему новое поколение достигает колоссальных успехов. Именно молодые специалисты создают мир будущего — мир своей мечты. Фильм поведает зрителю, как инженеры могут изменить не только повседневную жизнь, но и целые социумы: от Римских Арок до Великой Китайской стены, от жизненно необходимого моста, соединяющего деревушки Гаити, — до МКС, от роботов-амфибий — до захватывающих дух американских горок, небоскрёбов и пневмотоннелей, транспорт в которых однажды сможет передвигаться со скоростью 1200 км/ч.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"627487","ru":"Christmas Hotel","en":"Christmas Hotel","year":"2019","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/bymxXnIPPD85984wwo2S8djfIR7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/mkQmSEt7GKdPzedzMsQWtlRaSra.jpg","genres":["Мелодрама","Телевизионный фильм"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"469922","ru":"Pup Star: Better 2Gether","en":"Pup Star: Better 2Gether","year":"2017","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/wrnOybv78MO1SjABBX2LGPFY956.jpg","backdrop":"https://image.tmdb.org/t/p/w780/4mAFrZF0cHJ7ZUMrrdwczuPCkFQ.jpg","genres":["Семейный","Комедия","Музыка"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"450608","ru":"Saturday Church","en":"Saturday Church","year":"2018","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/kKRNAOOyRMIcO8ZMLg74YeaeyTB.jpg","backdrop":"https://image.tmdb.org/t/p/w780/lpxMzlCGGtFbfxlbcoWH43UhIu8.jpg","genres":["Мелодрама","Драма","Музыка","Фэнтези"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"240865","ru":"நான் சிகப்பு மனிதன்","en":"நான் சிகப்பு மனிதன்","year":"2014","type":"Фильм","rating":6.2,"votes":21,"poster":"https://image.tmdb.org/t/p/w342/t6W70wsZADJHqxubahw4Je4RV29.jpg","backdrop":"https://image.tmdb.org/t/p/w780/yUEUZpyYUXbJVTbg3gPgG1wam1U.jpg","genres":["Боевик","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"586384","ru":"Кто-нибудь видел мою девчонку?","en":"Кто-нибудь видел мою девчонку?","year":"2021","type":"Фильм","rating":6.2,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/wFCGuBcZI4aUz4p5LHjuP02SU1e.jpg","backdrop":"https://image.tmdb.org/t/p/w780/3OS7xKgTHQUxSJpiMMZ2HCddxQl.jpg","genres":["Мелодрама","Драма"],"overview":"Сергей и Кира считались самой красивой парой богемного Петербурга начала девяностых. Это были интеллектуалы, влюбленные в кинематограф. Но счастливая романтическая история обернулась жесткой драмой. Она сбежала в другой город, в другую жизнь, в другую любовь. А он остался в Петербурге и умер вскоре после развода. И только спустя семнадцать лет красивая и успешная Кира осознает, что нет у нее больше шансов на счастье, так как ее сердце навеки отдано Сергею.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"858054","ru":"Скотт Линдгрен: покорить поток","en":"The River Runner","year":"2021","type":"Фильм","rating":6.2,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/qbc7Xq8vNdaYE0pacobmxBdxz6T.jpg","backdrop":"https://image.tmdb.org/t/p/w780/o3yvz85NSGWkE9lontF9yYl27nJ.jpg","genres":["Документальный","Приключения"],"overview":"Герой этого документального фильма хочет стать первым, кто сплавится на каяке по четырем великим рекам, берущим начало на священной тибетской горе Кайлас.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"743048","ru":"Блуждающее сердце","en":"Errante corazón","year":"2021","type":"Фильм","rating":6.2,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/elpPt87ULQvaERjZ5DFYRQD7wOl.jpg","backdrop":"https://image.tmdb.org/t/p/w780/eZUQoZNCfX1xT2oztBLjo2Yw2Oc.jpg","genres":["Драма"],"overview":"Гей-отец-одиночка Сантьяго достиг переломного момента в своей жизни. Находясь в стадии горького разрыва, Сантьяго также сталкивается с неизбежным отъездом своей дочери Лайлы, с которой его связывают близкие, но эмоционально напряженные отношения. Поскольку страх остаться в одиночестве грозит поглотить его целиком, его поведение становится все более беспорядочным. В течение хаотичного лета, разделенного между Аргентиной и Бразилией, Сантьяго должен научиться отпускать Лайлу, чтобы каждый мог найти свою свободу. Эта эмоционально волнующая драма с участием сложных, чутких персонажей и непринужденных диалогов рассказывает о сильном желании любить и быть любимым.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"646071","ru":"Лисья нора","en":"Foxhole","year":"2021","type":"Фильм","rating":6.2,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/unrKxjsplxSOXENhmLncOGSmZbf.jpg","backdrop":"https://image.tmdb.org/t/p/w780/69bPRjaUYt4ZnhIXiTXRBjhvWhA.jpg","genres":["Драма","Военный","Боевик","История"],"overview":"События фильма разворачиваются в течение 36 часов в трёх параллельных реальностях — на фронтах Гражданской войны в США, Первой Мировой войны и в Ираке. Пятеро солдат, сидящих в окопе, сражаются со страхами, моральной ответственностью и бессмысленностью войн.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1235303","ru":"Baise-en-ville","en":"Baise-en-ville","year":"2026","type":"Фильм","rating":6.2,"votes":20,"poster":"https://image.tmdb.org/t/p/w342/ucbCT3Nr5BOzPDS50JdaLSTHty5.jpg","backdrop":"https://image.tmdb.org/t/p/w780/1v1tmwxXwq