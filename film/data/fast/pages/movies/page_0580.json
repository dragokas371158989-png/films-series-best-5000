r":"2023","type":"Фильм","rating":6.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/cZ92KhByoK5MckAQMpWQuKfSLcz.jpg","backdrop":"https://image.tmdb.org/t/p/w780/5TH3noYhB6wQXGKkgHHw7Rktuz8.jpg","genres":["Ужасы","Комедия"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"943845","ru":"僕もアイツも新郎です。","en":"僕もアイツも新郎です。","year":"2022","type":"Фильм","rating":6.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/wIVNWIjh9EBJwtQH0Kuv9KYyt6Y.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dTXC8agyVxvh5fb0NcquiLRvWzp.jpg","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"415781","ru":"Эверест — вершина богов","en":"エヴェレスト 神々の山嶺","year":"2016","type":"Фильм","rating":6.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/mUmz9Qb7d1VExrRgOzvhXxuI2K9.jpg","backdrop":"https://image.tmdb.org/t/p/w780/pc1Wy0rdqKiF1QplQBS6ay23Y0J.jpg","genres":["Приключения","Драма","Детектив"],"overview":"Экранизация одноименного японского романа-бестселлера, посвященная истории самого первого удачного покорения смертельно опасного Эвереста, совершенного Ирвингом и Мэллори, чье первенство так и осталось недоказанным, так как оба альпиниста пропали без вести. Но вот, уже в 21 веке профессиональный фотограф-альпинист выходит на след камеры Мэллори, которая может стать сенсационной находкой столетия, полностью изменив представления об истории покорения Эвереста. Как бы то ни было, камера оказывается в руках шерпа Гадюки, который поразительно похож на одного из лучших альпинистов Японии, до того считавшимся погибшим во время восхождения на самый трудный склон Эвереста во время жесточайшей зимней бури.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"576422","ru":"Мисс Стерва","en":"恭喜八婆","year":"2019","type":"Фильм","rating":6.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/fWkMiD9ebwqm9Yj5A5fvAc3LwdL.jpg","backdrop":"https://image.tmdb.org/t/p/w780/6jNUA9koyhpzTvreap2KZYb1yAB.jpg","genres":["Комедия"],"overview":"Шесть девочек и два мальчика часто общаются друг с другом в своем групповом чате \"Пэт По\" Но из-за конфликтов, их дружба становится напряженной, и в конце концов, они покидают группу. Но когда один из них попадает в беду, они снова собираются вместе.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"36304","ru":"絵の中のぼくの村","en":"絵の中のぼくの村","year":"1996","type":"Фильм","rating":6.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/pXir2xJB8wSpwI9fqNBEUKhkBwI.jpg","backdrop":"https://image.tmdb.org/t/p/w780/gOw24tKE9xvKBo7tPauS1jRETxW.jpg","genres":["Семейный","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"282855","ru":"París norðursins","en":"París norðursins","year":"2014","type":"Фильм","rating":6.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/9DrpTWlf8ASVroIdDQdibOVt3w3.jpg","backdrop":"https://image.tmdb.org/t/p/w780/oAqo4XeNqeNNlRPqCLZ0B5Fcd4p.jpg","genres":["Комедия","Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"424647","ru":"Paranormal Sexperiments","en":"Paranormal Sexperiments","year":"2016","type":"Фильм","rating":6.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/xCTsGCABgxgMwQ0cV7B9sHQCFIw.jpg","backdrop":"https://image.tmdb.org/t/p/w780/87VRIC4JkmZJgXj3tXArFAI3YfA.jpg","genres":["Ужасы","Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"456226","ru":"கருப்பன்","en":"கருப்பன்","year":"2017","type":"Фильм","rating":6.0,"votes":12,"poster":"https://image.tmdb.org/t/p/w342/kGRe3SRj1mu2qyXxIl36qaDmh3C.jpg","backdrop":"https://image.tmdb.org/t/p/w780/7j5AR0Ls8qKgMTyffyjGaH9quq6.jpg","genres":["Боевик","Мелодрама","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"520372","ru":"Paradise Lost?","en":"Paradise Lost?","year":"2015","type":