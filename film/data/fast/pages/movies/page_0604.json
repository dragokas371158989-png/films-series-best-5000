я только трое, включая девочку, и с ней явно что-то не так. За этими событиями наблюдает повзрослевший Ади, который 20 лет назад потерял друга и теперь решил во что бы то ни стало уничтожить виновную в этом злую сущность.","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1086726","ru":"एलएसडी 2: लव, सेक्स और धोखा 2","en":"एलएसडी 2: लव, सेक्स और धोखा 2","year":"2024","type":"Фильм","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/ywUtbLJngSqykpxiIHIqJNA06EX.jpg","backdrop":"https://image.tmdb.org/t/p/w780/dmhNtB9HvZq4IPNuw7bRF2G4GX1.jpg","genres":["Драма","Комедия","Криминал"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"795838","ru":"บอสฉันขยันเชือด","en":"บอสฉันขยันเชือด","year":"2021","type":"Фильм","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/gkZjoJcroaUrbjK0TE49ysLCGf6.jpg","backdrop":"https://image.tmdb.org/t/p/w780/kSUdHE8eWcQydK0P6q9kQB4dK1M.jpg","genres":["Комедия","Детектив","Триллер"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"486590","ru":"Polański, Horowitz. Hometown","en":"Polański, Horowitz. Hometown","year":"2021","type":"Фильм","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/qxteWaJcb7p8ocquRcBT1CW6IXm.jpg","backdrop":"https://image.tmdb.org/t/p/w780/rmbxXHYv8B9o5kRIc5cYNFTRQlt.jpg","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"565885","ru":"வந்தா ராஜாவாதான் வருவேன்","en":"வந்தா ராஜாவாதான் வருவேன்","year":"2019","type":"Фильм","rating":5.9,"votes":6,"poster":"https://image.tmdb.org/t/p/w342/iZew5hsN6zKyOkBl2a0U5oqlkEO.jpg","backdrop":"https://image.tmdb.org/t/p/w780/ck7jY0CnSzQqTm1pjTtwt8AruI0.jpg","genres":["Драма","Боевик"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"622343","ru":"Open","en":"Open","year":"2019","type":"Фильм","rating":5.9,"votes":6,"pos