10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/xTviwx0EIqE8tO11mGWQiRLLply.jpg","backdrop":"https://image.tmdb.org/t/p/w780/tTfEzf0sUZpasmnDax2Zq1fD3FU.jpg","genres":["Комедия","Фантастика"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"664799","ru":"가슴 큰 처제","en":"가슴 큰 처제","year":"2019","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/5DOKPieSKSCNog3ZSTkKJkQOsSx.jpg","backdrop":"https://image.tmdb.org/t/p/w780/zwX16Ps1ZEJJSEQoAlSeGbZOtXR.jpg","genres":["Мелодрама"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"331445","ru":"Bambanti","en":"Bambanti","year":"2015","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/7o9eA3y9bGydWsQsC5x9JOV8Es7.jpg","backdrop":"https://image.tmdb.org/t/p/w780/w48nl8t2a9Xgzdc6uedLPH3vuk7.jpg","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1488370","ru":"Холигардс","en":"Holiguards Saga: The Portal of Force","year":"","type":"Фильм","rating":10.0,"votes":1,"poster":"https://image.tmdb.org/t/p/w342/eFSmDDprCYqgwXk46syDKFBq0lk.jpg","backdrop":"","genres":["Боевик","Фэнтези","Фантастика","Триллер"],"overview":"Holiguards — научно-фантастический экшен с напряженной атмосферой и элементами психологического триллера. Картина станет новой работой режиссера Кевина Спейси, а также первым его проектом за последние семь лет. Авторская концепция и сюжетная основа были разработаны Сергеем Торчилиным и Ладо Охотниковым. Сюжет переносит зрителя в ближайшее будущее, где тайное противостояние между древними силами выходит за пределы скрытой войны. Орден Holiguards и их противники Statiguards веками ведут борьбу за влияние, оставаясь невидимыми для человечества. В центре истории — девушка, связанная с обоими лагерями происхождением, чья роль может определить исход конфликта. Пока судьба мира висит на волоске, Statiguards готовят ма