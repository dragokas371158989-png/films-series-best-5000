ак всегда: вместе они взяли банк и рванули к мексиканской границе, хотя на хвосте у них сидят не только полицейские, но и боевики мафии…","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1630455","ru":"Buradayam","en":"Buradayam","year":"2025","type":"Фильм","rating":10.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/7nUR4ulig4lSXGhi0aTCbwPvxMc.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1556522","ru":"To the Moon and back","en":"To the Moon and back","year":"2021","type":"Фильм","rating":10.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/mFimykzdcnOnVMwqhp63y7o5hoB.jpg","backdrop":"","genres":[],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1484127","ru":"Goteras","en":"Goteras","year":"2025","type":"Фильм","rating":10.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/nGUk9dBJh27YfUz7HE1eOXmDFvv.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1400114","ru":"Waves","en":"Waves","year":"2024","type":"Фильм","rating":10.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/s30iRpeOEyrM1dvWmoVpBDSqWU4.jpg","backdrop":"","genres":["Драма"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1667917","ru":"And My Soul Shall Be Healed","en":"And My Soul Shall Be Healed","year":"2025","type":"Фильм","rating":10.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/p5zpXMtim44imzONfZXX4jssU9N.jpg","backdrop":"","genres":["Документальный"],"overview":"","source":"tmdb","episodes":"","studio":"","country":"","ageRating":""},{"id":"1398550","ru":"When buying a Fine Murder","en":"When buying a Fine Murder","year":"","type":"Фильм","rating":10.0,"votes":0,"poster":"https://image.tmdb.org/t/p/w342/nCMWb7MvqfE3ubcCPXdWEtyELcb.jpg","backdrop":"https://image.tmdb.org/t/p/w780/UuBy