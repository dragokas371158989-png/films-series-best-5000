        changed += enrich_file(path)
    top = build_studio_top(search_items)
    save_json(FAST/'anime_studios_top.json', top)
    # copy into sub-sites if they exist
    for sub in ('film','downloads'):
        subfast = ROOT/sub/'data'/'fast'
        if subfast.exists():
            save_json(subfast/'anime_studios_top.json', top)
    meta = load_json(FAST/'meta.json') or {}
    if isinstance(meta, dict):
        meta['animeStudiosVersion'] = VERSION
        meta['animeStudiosKnown'] = top['knownStudioAnime']
        meta['animeStudiosUnknown'] = top['unknownStudioAnime']
        save_json(FAST/'meta.json', meta)
    print(f'GKM V132 anime studios: changed={changed} known={top["knownStudioAnime"]} unknown={top["unknownStudioAnime"]} studios={len(top["studios"])}')

if __name__ == '__main__':
    main()
