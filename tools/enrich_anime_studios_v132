def norm(s: object) -> str:
    return re.sub(r'[^a-zа-я0-9]+', ' ', str(s or '').lower().replace('ё','е')).strip()

def is_anime(x: dict) -> bool:
    return str(x.get('type','')).lower() in ('аниме','anime') or any(str(g).lower() == 'аниме' for g in x.get('genres') or [])

def title(x: dict) -> str:
    return str(x.get('ru') or x.get('title_ru') or x.get('name') or x.get('title') or x.get('en') or 'Без названия')

def rating(x: dict) -> float:
    try: return float(x.get('rating') or 0)
    except Exception: return 0.0

def votes(x: dict) -> int:
    try: return int(float(x.get('votes') or 0))
    except Exception: return 0

def infer_studio(x: dict) -> str:
    existing = x.get('studio') or x.get('studios')
    if isinstance(existing, list): existing = ' / '.join(map(str, existing))
    if existing: return str(existing)
    text = norm(' '.join(str(x.get(k,'')) for k in ('ru','en','title','name','search')))
    for pattern, studio in RULES:
        for part in pattern.split('|'):
            p = norm(part)
            if p and p in text:
                return studio
    return ''

def load_json(path: Path):
    if not path.exists(): return None
    return json.loads(path.read_text(encoding='utf-8'))

def save_json(path: Path, obj) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, ensure_ascii=False, separators=(',', ':')), encoding='utf-8')

def iter_items_container(obj):
    if isinstance(obj, list): return obj
    if isinstance(obj, dict):
        for key in ('items','popular','top','new','anime','movies','series','cartoons'):
            if isinstance(obj.get(key), list):
                yield from obj[key]
    return []

def enrich_item(x: dict) -> bool:
    if not isinstance(x, dict) or not is_anime(x): return False
    changed = False
    st = infer_studio(x)
    if st and not x.get('studio'):
        x['studio'] = st; changed = True
    if not x.get('country'):
        x['country'] = 'Япония'; changed = True
    return changed

def enrich_file(path: Path) -> int:
    obj = load_json(path)
    if obj is None: return 0
    changed = 0
    targets = obj if isinstance(obj, list) else None
    if targets is not None:
        for x in targets: changed += int(enrich_item(x))
    elif isinstance(obj, dict):
        for key, val in obj.items():
            if isinstance(val, list):
                for x in val: changed += int(enrich_item(x))
    if changed:
        save_json(path, obj)
    return changed

def build_studio_top(items: list[dict]):
    groups = {}
    anime_total = known = unknown = 0
    for x in items:
        if not is_anime(x): continue
        anime_total += 1
        st = infer_studio(x)
        if not st:
            unknown += 1
            continue
        known += 1
        for studio in [s.strip() for s in re.split(r'/|,|;', st) if s.strip()]:
            g = groups.setdefault(studio, {'studio': studio, 'count':0, 'votes':0, 'ratingSum':0.0, 'items':[]})
            g['count'] += 1
            g['votes'] += votes(x)
            g['ratingSum'] += rating(x)
            if votes(x) > 10000 or rating(x) >= 8:
                g['items'].append({'title': title(x), 'votes': votes(x), 'rating': rating(x), 'year': x.get('year')})
    rows = []
    for g in groups.values():
        g['items'].sort(key=lambda i: (i['votes'], i['rating']), reverse=True)
        rows.append({
            'studio': g['studio'], 'count': g['count'], 'votes': g['votes'],
            'avgRating': round(g['ratingSum']/g['count'], 2) if g['count'] else 0,
            'topTitles': [i['title'] for i in g['items'][:8]]
        })
    rows.sort(key=lambda r: (r['votes'], r['count'], r['avgRating']), reverse=True)
    return {'version': VERSION, 'animeTotal': anime_total, 'knownStudioAnime': known, 'unknownStudioAnime': unknown, 'studios': rows[:50]}

